+		deco(
+			shellFolder,
+			"FacadeLanternPlate",
+			V3(0.9, 1.4, 0.12),
+			CFrame.new(wall + V3(0, 0, 0.06)),
+			IRON,
+			Enum.Material.Metal
+		)
+		deco(
+			shellFolder,
+			"FacadeLanternArm",
+			V3(0.16, 0.16, 1.1),
+			CFrame.new(wall + V3(0, 0, 0.6)),
+			IRON,
+			Enum.Material.Metal
+		)
+		if not Props.place(shellFolder, "Lantern", wall + V3(0, -0.85, 1.15), Vector3.zAxis, 1.55, "floor") then
+			deco(
