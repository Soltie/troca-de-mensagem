From 8e2562f37bd5c9cef3e5c0f670a4a7f6f23feec9 Mon Sep 17 00:00:00 2001
From: fashionultraaura <fashionultraaura@gmail.com>
Date: Sun, 18 Oct 2026 21:13:30 -0300
Subject: [PATCH 10/10] design(env): luminarias eletricas aparecem apagadas sem
 energia

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ServerScriptService/Server/World/HouseLights.luau | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/ServerScriptService/Server/World/HouseLights.luau b/src/ServerScriptService/Server/World/HouseLights.luau
index 9b5a966..831871c 100644
--- a/src/ServerScriptService/Server/World/HouseLights.luau
+++ b/src/ServerScriptService/Server/World/HouseLights.luau
@@ -12,6 +12,7 @@
 local CollectionService = game:GetService("CollectionService")
 
 local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
+local Palette = require("./Palette")
 
 local Lights = {}
 
@@ -91,6 +92,10 @@ function Lights.build(root: Instance)
 			light_.Range = math.min(light_.Range, ELECTRIC_RANGE)
 			light_.Brightness = math.min(light_.Brightness, ELECTRIC_BRIGHTNESS)
 			light_.Enabled = false -- a casa começa sem energia; WorldService.setPower religa
+			if holder.Transparency < 0.99 then
+				-- Luminária visível com cara de apagada (o setPower troca para neon quando a energia volta).
+				holder.Material, holder.Color = Enum.Material.SmoothPlastic, Palette.LampOff
+			end
 			holder:SetAttribute(Tags.Attr.LightKind, "Lamp")
 			holder:SetAttribute(Tags.Attr.Flicker, true)
 			holder:SetAttribute("BaseBrightness", light_.Brightness)
-- 
