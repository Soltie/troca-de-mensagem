        <Item class="ModuleScript" referent="519">
          <Properties>
            <string name="Name">CampaignPerks</string>
            <string name="Source"><![CDATA[--!strict
-- Ganchos da campanha usados pelas vantagens pagas (Segunda Chance, Continuação) e pela bateria por nível.
local BatteryModel = require("@game/ReplicatedStorage/Shared/Game/BatteryModel")
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local TestKit = require("../TestKit")

local function party(count: number, stage: number?): Session.State
	local state = Session.new(9009, { minPlayers = 3, maxPlayers = 8, downedSeconds = 45, relayWindow = 12 })
	for id = 1, count do
		Session.join(state, id)
	end
	state.stage = (stage or 1) - 1
	Session.beginStage(state)
	return state
end

local spec: TestKit.Spec = {
	name = "CampaignPerks",
	run = function(t)
		t.it("second chance revives only a downed member, before the timer ends", function()
			local s = party(3)
			t.expect((Session.selfRevive(s, 1, 10))).toBe(false)
			Session.capture(s, 1, 10)
			t.expect(s.members[1].status).toBe("Downed")
			t.expect((Session.selfRevive(s, 1, 10 + 60))).toBe(false)
			t.expect((Session.selfRevive(s, 1, 13))).toBe(true)
			t.expect(s.members[1].status).toBe("Active")
			t.expect((Session.selfRevive(s, 1, 14))).toBe(false)
		end)
		t.it("the last survivor with a second chance does not end the run", function()
			local s = party(3)
			Session.capture(s, 1, 10)
			Session.capture(s, 2, 10)
			Session.capture(s, 3, 10, 5)
			t.expect(s.phase).toBe("Playing")
			Session.tick(s, 12)
			t.expect(s.phase).toBe("Playing")
			t.expect((Session.selfRevive(s, 3, 13))).toBe(true)
			t.expect(s.members[3].risingUntil).toBeNil()
			t.expect(s.phase).toBe("Playing")
		end)
		t.it("an expired second-chance window lets the defeat happen", function()
			local s = party(3)
			Session.capture(s, 1, 10)
			Session.capture(s, 2, 10)
			Session.capture(s, 3, 10, 5)
			Session.tick(s, 16)
			t.expect(s.phase).toBe("Lost")
		end)
		t.it("continue repeats the lost stage with the whole team", function()
			local s = party(3, 2)
			t.expect(s.stage).toBe(2)
			t.expect((Session.retryStage(s))).toBe(false)
			for id = 1, 3 do
				Session.capture(s, id, 10)
			end
			Session.tick(s, 100)
			t.expect(s.phase).toBe("Lost")
			local ok = Session.retryStage(s)
			t.expect(ok).toBe(true)
			t.expect(s.phase).toBe("Intermission")
			t.expect(s.stage).toBe(1)
			t.expect((Session.beginStage(s))).toBe(true)
			t.expect(s.stage).toBe(2)
			for id = 1, 3 do
				t.expect(s.members[id].status).toBe("Active")
			end
		end)
		t.it("lithium battery drains slower, never faster", function()
			local normal = BatteryModel.new(1)
			local lithium = BatteryModel.new(1)
			BatteryModel.setOn(normal, true)
			BatteryModel.setOn(lithium, true)
			BatteryModel.step(normal, 10)
			BatteryModel.step(lithium, 10, 1 / 1.75)
			t.expect(lithium.charge > normal.charge).toBe(true)
			local abuse = BatteryModel.new(1)
			BatteryModel.setOn(abuse, true)
			BatteryModel.step(abuse, 10, 5)
			t.expect(abuse.charge).toBeCloseTo(normal.charge)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="520">
          <Properties>
            <string name="Name">CharacterPose</string>
            <string name="Source"><![CDATA[--!strict
local CharacterPose = require("@game/ReplicatedStorage/Shared/Game/CharacterPose")
local TestKit = require("../TestKit")

local testSpec: TestKit.Spec = {
	name = "CharacterPose",
	run = function(t)
		t.it("quantizes pitch to the network step and clamps it", function()
			t.expect(CharacterPose.quantizePitch(0)).toBe(0)
			t.expect(CharacterPose.quantizePitch(4.9)).toBe(4)
			t.expect(CharacterPose.quantizePitch(-5.2)).toBe(-6)
			t.expect(CharacterPose.quantizePitch(500)).toBe(CharacterPose.MAX_PITCH)
			t.expect(CharacterPose.quantizePitch(-500)).toBe(-CharacterPose.MAX_PITCH)
			t.expect(CharacterPose.quantizePitch(0 / 0)).toBe(0)
		end)
		t.it("sends only on change, never faster than the interval", function()
			t.expect(CharacterPose.shouldSend(nil, 0, 0)).toBe(false)
			t.expect(CharacterPose.shouldSend(nil, 0, 0.2)).toBe(true)
			t.expect(CharacterPose.shouldSend(9, 9, 0.5)).toBe(false)
			t.expect(CharacterPose.shouldSend(9, 12, 0.05)).toBe(false)
			t.expect(CharacterPose.shouldSend(9, 12, 0.2)).toBe(true)
			-- Batimento: reenvia o mesmo valor depois de HEARTBEAT segundos.
			t.expect(CharacterPose.shouldSend(9, 9, CharacterPose.HEARTBEAT)).toBe(true)
		end)
		t.it("crouch bends just enough, then lifts the visible body", function()
			local angle, lift = CharacterPose.crouch(2, 0)
			t.expect(angle).toBe(0)
			t.expect(lift).toBe(0)
			-- Queda pequena: dobra sem levantar e as pernas encurtam exatamente a queda.
			angle, lift = CharacterPose.crouch(2, 0.4)
			t.expect(lift).toBeCloseTo(0)
			t.expect(2 * (1 - math.cos(angle))).toBeCloseTo(0.4)
			-- Queda grande: para na dobra máxima e o resto vira lift.
			angle, lift = CharacterPose.crouch(1.7, 1.6)
			t.expect(angle).toBeCloseTo(CharacterPose.MAX_CROUCH)
			t.expect(lift).toBeCloseTo(1.6 - 1.7 * (1 - math.cos(CharacterPose.MAX_CROUCH)))
			t.expect(lift > 0).toBe(true)
		end)
		t.it("leans only above walking speed", function()
			t.expect(CharacterPose.lean(8, 10, 18)).toBe(0)
			t.expect(CharacterPose.lean(14, 10, 18)).toBeCloseTo(6)
			t.expect(CharacterPose.lean(40, 10, 18)).toBeCloseTo(12)
			t.expect(CharacterPose.lean(40, 10, 10)).toBe(0)
		end)
		t.it("splits pitch between neck and waist and approaches smoothly", function()
			local neck, waist = CharacterPose.split(40)
			t.expect(neck + waist).toBeCloseTo(40)
			t.expect(neck > waist).toBe(true)
			local value = CharacterPose.approach(0, 10, 8, 1 / 60)
			t.expect(value > 0 and value < 10).toBe(true)
			t.expect(CharacterPose.approach(0, 10, 8, 10)).toBeCloseTo(10)
			t.expect(CharacterPose.approach(3, 10, 8, 0)).toBe(3)
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="521">
          <Properties>
            <string name="Name">Checkpoint</string>
            <string name="Source"><![CDATA[--!strict
local Checkpoint = require("@game/ServerScriptService/Server/Game/Checkpoint")
local Objectives = require("@game/ServerScriptService/Server/Game/Objectives")
local TestKit = require("../TestKit")

local function powered(): Objectives.State
	local s = Objectives.new(1)
	s.enteredBuilding = true
	Objectives.takeKey(s)
	Objectives.useKey(s, "door_storage")
	Objectives.collect(s, "fuse")
	Objectives.insert(s)
	Objectives.solveBreakers(s)
	Objectives.powerOn(s)
	return s
end

local function input(objectives: Objectives.State, overrides: { [string]: any }?): Checkpoint.Snapshot
	local i: { [string]: any } = {
		objectives = objectives,
		doors = {},
		locked = {},
		battery = 1,
		breakerOrder = { 1 },
		taken = {},
	}
	if overrides then
		for key, value in overrides do
			i[key] = value
		end
	end
	return i :: any
end

local spec: TestKit.Spec = {
	name = "Checkpoint",
	run = function(t)
		t.it("captures an independent copy of the round", function()
			local s = powered()
			local doors: { [string]: Checkpoint.DoorState } = { door_office = "open", door_storage = "crack" }
			local taken = { battery_1 = true }
			local snap = Checkpoint.capture(input(s, {
				doors = doors,
				locked = { door_storage = false },
				battery = 0.4,
				breakerOrder = { 3, 1, 2 },
				taken = taken,
			}))
			-- O jogo continua mudando depois do checkpoint...
			s.gateOpen = true
			s.collected.extra = true
			doors.door_office = "closed"
			taken.battery_2 = true
			-- ...e o snapshot não muda.
			t.expect(snap.objectives.gateOpen).toBe(false)
			t.expect(snap.objectives.collected.extra).toBeNil()
			t.expect(snap.doors.door_office).toBe("open")
			t.expect(snap.battery).toBe(0.4)
			t.expect(snap.breakerOrder).toEqual({ 3, 1, 2 })
			t.expect(snap.taken.battery_2).toBeNil()
			t.expect(snap.taken.battery_1).toBe(true)
		end)

		t.it("restores progress, inventory and doors as a fresh copy each time", function()
			local snap = Checkpoint.capture(input(powered(), { doors = { door_office = "crack" }, battery = 2 }))
			t.expect(snap.battery).toBe(1)
			local first = Checkpoint.restore(snap)
			first.objectives.gateOpen = true
			local second = Checkpoint.restore(snap)
			t.expect(second.objectives.gateOpen).toBe(false)
			t.expect(second.objectives.powerOn).toBe(true)
			t.expect(second.objectives.inserted).toBe(1)
			t.expect(second.objectives.unlocked.door_storage).toBe(true)
			t.expect(second.doors.door_office).toBe("crack")
		end)

		t.it("is only usable with power on and the gate still closed", function()
			t.expect(Checkpoint.isUsable(nil)).toBe(false)
			t.expect(Checkpoint.isUsable(Checkpoint.capture(input(Objectives.new(1))))).toBe(false)
			t.expect(Checkpoint.isUsable(Checkpoint.capture(input(powered())))).toBe(true)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="522">
          <Properties>
            <string name="Name">CinematicShots</string>
            <string name="Source"><![CDATA[--!strict
local CinematicShots = require("@game/ReplicatedStorage/Shared/Game/CinematicShots")
local TestKit = require("../TestKit")

local SEQUENCES = { CinematicShots.Opening, CinematicShots.Stage, CinematicShots.Escape, CinematicShots.Attract }

local testSpec: TestKit.Spec = {
	name = "CinematicShots",
	run = function(t)
		t.it("lobby cameras frame the porch instead of looking through the locked house", function()
			for _, s in CinematicShots.Attract.shots do
				t.expect(s.from.z >= 80 and s.to.z >= 80).toBe(true)
				t.expect(s.lookFrom.z >= 64 and s.lookTo.z >= 64).toBe(true)
			end
			t.expect(CinematicShots.Opening.shots[1].from.z >= 110).toBe(true)
		end)
		t.it("easing curves start at 0, end at 1 and clamp outside", function()
			local eases: { CinematicShots.Ease } = { "linear", "inOut", "out", "in" }
			for _, kind in eases do
				t.expect(CinematicShots.ease(kind :: CinematicShots.Ease, 0)).toBeCloseTo(0)
				t.expect(CinematicShots.ease(kind :: CinematicShots.Ease, 1)).toBeCloseTo(1)
				t.expect(CinematicShots.ease(kind :: CinematicShots.Ease, -3)).toBeCloseTo(0)
				t.expect(CinematicShots.ease(kind :: CinematicShots.Ease, 7)).toBeCloseTo(1)
				local previous = -1
				for i = 0, 10 do
					local value = CinematicShots.ease(kind :: CinematicShots.Ease, i / 10)
					t.expect(value >= previous).toBe(true)
					previous = value
				end
			end
		end)
		t.it("sample hits both ends of each shot", function()
			for _, sequence in SEQUENCES do
				for _, s in sequence.shots do
					local p0, l0 = CinematicShots.sample(s, 0)
					local p1, l1 = CinematicShots.sample(s, 1)
					t.expect(p0.x).toBeCloseTo(s.from.x)
					t.expect(p0.z).toBeCloseTo(s.from.z)
					t.expect(l0.y).toBeCloseTo(s.lookFrom.y)
					t.expect(p1.y).toBeCloseTo(s.to.y)
					t.expect(l1.x).toBeCloseTo(s.lookTo.x)
				end
			end
		end)
		t.it("locate walks through shots and reports the end", function()
			local seq = CinematicShots.Opening
			local first = seq.shots[1].duration
			local index, alpha, done = CinematicShots.locate(seq, 0)
			t.expect(index).toBe(1)
			t.expect(alpha).toBeCloseTo(0)
			t.expect(done).toBe(false)
			index, alpha, done = CinematicShots.locate(seq, first + 0.5)
			t.expect(index).toBe(2)
			t.expect(alpha).toBeCloseTo(0.5 / seq.shots[2].duration)
			t.expect(done).toBe(false)
			index, alpha, done = CinematicShots.locate(seq, CinematicShots.duration(seq) + 1)
			t.expect(index).toBe(#seq.shots)
			t.expect(alpha).toBe(1)
			t.expect(done).toBe(true)
		end)
		t.it("sequences fit the windows the game gives them", function()
			-- Abertura cabe na cartela solo (9 s, com folga de 1 s); etapa cabe no congelamento (>= 3 s).
			t.expect(math.abs(CinematicShots.duration(CinematicShots.Opening) - 9) <= 1).toBe(true)
			t.expect(CinematicShots.duration(CinematicShots.Stage) <= 4).toBe(true)
			t.expect(CinematicShots.duration(CinematicShots.Escape) <= 12).toBe(true)
		end)
		t.it("cameras stay outside the building and above the ground", function()
			-- Núcleo do prédio: x -68..72, z <= 0 (o interior é sorteado e não pode aparecer).
			for _, sequence in SEQUENCES do
				for _, s in sequence.shots do
					for _, p in { s.from, s.to } do
						t.expect(p.z > 2).toBe(true)
						t.expect(p.y > 2).toBe(true)
					end
					local dx, dy, dz = s.lookFrom.x - s.from.x, s.lookFrom.y - s.from.y, s.lookFrom.z - s.from.z
					t.expect(dx * dx + dy * dy + dz * dz > 4).toBe(true)
					t.expect(#s.label > 0).toBe(true)
				end
			end
		end)
		t.it("security cameras step on a 12 fps grid; handheld shots do not", function()
			for _, s in CinematicShots.Attract.shots do
				t.expect(CinematicShots.isCctv(s)).toBe(true)
			end
			t.expect(CinematicShots.isCctv(CinematicShots.Opening.shots[1])).toBe(false)
			for _, s in CinematicShots.Escape.shots do
				t.expect(CinematicShots.isCctv(s)).toBe(false)
				t.expect(CinematicShots.lens(s, 0)).toBe(s.fov)
				t.expect(CinematicShots.lens(s, 1)).toBe(s.fovTo)
			end
			t.expect(CinematicShots.quantize(0, 5, 12)).toBe(0)
			t.expect(CinematicShots.quantize(1, 5, 12)).toBe(1)
			-- 60 quadros em 5 s: 0.0101 ainda está no quadro 0; 0.0167 já é o quadro 1.
			t.expect(CinematicShots.quantize(0.0101, 5, 12)).toBe(0)
			t.expect(CinematicShots.quantize(1 / 60, 5, 12)).toBeCloseTo(1 / 60)
			t.expect(CinematicShots.quantize(7, 5, 12)).toBe(1)
		end)
		t.it("attract loops forever and captions split the running time", function()
			local total = CinematicShots.duration(CinematicShots.Attract)
			t.expect(CinematicShots.wrap(CinematicShots.Attract, total + 1.5)).toBeCloseTo(1.5)
			t.expect(CinematicShots.wrap(CinematicShots.Attract, -3)).toBe(0)
			local lines = { "a", "b", "c" }
			t.expect(CinematicShots.caption(lines, 0, 9)).toBe("a")
			t.expect(CinematicShots.caption(lines, 3.1, 9)).toBe("b")
			t.expect(CinematicShots.caption(lines, 9, 9)).toBe("c")
			t.expect(CinematicShots.caption(lines, 50, 9)).toBe("c")
			t.expect(CinematicShots.caption(nil, 1, 9)).toBeNil()
			t.expect(CinematicShots.caption({}, 1, 9)).toBeNil()
			t.expect(#(CinematicShots.Opening.captions or {}) > 0).toBe(true)
		end)
		t.it("tape clock formats and wraps at midnight", function()
			t.expect(CinematicShots.clock(CinematicShots.TAPE_START)).toBe("03:12:00")
			t.expect(CinematicShots.clock(CinematicShots.TAPE_START + 75.9)).toBe("03:13:15")
			t.expect(CinematicShots.clock(86400 + 5)).toBe("00:00:05")
			t.expect(CinematicShots.clock(-10)).toBe("00:00:00")
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="523">
          <Properties>
            <string name="Name">CoinPlan</string>
            <string name="Source"><![CDATA[--!strict
local CoinPlan = require("@game/ServerScriptService/Server/Game/CoinPlan")
local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local TestKit = require("../TestKit")

local function roomCount(): number
	local count = 0
	for _, room in House.Rooms do
		if room.id ~= "Exterior" and room.id ~= "Hall" then
			count += 1
		end
	end
	return count
end

local testSpec: TestKit.Spec = {
	name = "CoinPlan",
	run = function(t)
		t.it("is deterministic per seed and varies between chapters", function()
			local a = CoinPlan.create(90312, 2, 8)
			local b = CoinPlan.create(90312, 2, 8)
			t.expect(a).toEqual(b)
			local c = CoinPlan.create(90313, 2, 8)
			local same = true
			for index, coin in a do
				if coin.x ~= c[index].x or coin.z ~= c[index].z then
					same = false
				end
			end
			t.expect(same).toBe(false)
		end)
		t.it("places the expected amount with exactly one gem and unique ids", function()
			local coins = CoinPlan.create(7, 2, 8)
			t.expect(#coins).toBe(roomCount() * 2 + #CoinPlan.Levels * #CoinPlan.HallSpots + 8)
			local gems, ids = 0, {}
			for _, coin in coins do
				if coin.gem then
					gems += 1
				end
				t.expect(ids[coin.id]).toBe(nil)
				ids[coin.id] = true
			end
			t.expect(gems).toBe(1)
		end)
		t.it("keeps room coins inside their room and away from the facade furniture strip", function()
			for seed = 1, 20 do
				for _, coin in CoinPlan.create(seed, 2, 0) do
					local id = string.match(coin.id, "^coin_(%a+)_")
					for _, room in House.Rooms do
						if room.id == id then
							local side = if room.x < 0 then -1 else 1
							local out = (coin.x - room.x) * side
							t.expect(math.abs(coin.x - room.x) <= 16).toBe(true)
							t.expect(math.abs(coin.z - room.z) <= 15).toBe(true)
							t.expect(out <= 9).toBe(true)
							t.expect(coin.y - room.y).toBeCloseTo(CoinPlan.Height)
						end
					end
				end
			end
		end)
		t.it("puts yard coins beside the trail, outside the house", function()
			for _, coin in CoinPlan.create(3, 0, 12) do
				if string.find(coin.id, "yard", 1, true) then
					t.expect(math.abs(coin.x) >= 20).toBe(true)
					t.expect(coin.z >= 72 and coin.z <= 124).toBe(true)
				end
			end
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="524">
          <Properties>
            <string name="Name">CoopSession</string>
            <string name="Source"><![CDATA[--!strict
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local TestKit = require("../TestKit")
local LegacyPolicy = table.clone(Config.Campaign)
LegacyPolicy.minPlayers, LegacyPolicy.maxPlayers = 2, 8

local function party(count: number, stage: number?): Session.State
	local state = Session.new(9009, LegacyPolicy)
	for id = 1, count do
		Session.join(state, id)
	end
	state.stage = (stage or 1) - 1
	Session.beginStage(state)
	return state
end

local function complete(state: Session.State)
	local plan = state.plan
	assert(plan, "Expected a stage plan")
	for _, spec in plan.activities do
		if spec.kind == "sequence" then
			for _, button in spec.order do
				Session.act(state, 1, spec.id, button, 1)
			end
		elseif spec.kind == "relay" then
			Session.act(state, 1, spec.id, 1, 1)
			Session.act(state, 2, spec.id, 1, 2)
		else
			while not state.tasks[spec.id].solved do
				Session.act(state, 1, spec.id, state.tasks[spec.id].progress + 1, 1)
			end
		end
	end
end

local spec: TestKit.Spec = {
	name = "CoopSession",
	run = function(t)
		t.it("waits for a partner, starts with two players and refuses a ninth member", function()
			local s = party(1)
			t.expect(s.phase).toBe("Lobby")
			Session.join(s, 2)
			t.expect((Session.beginStage(s))).toBe(true)
			for id = 3, 8 do
				t.expect((Session.join(s, id))).toBe(true)
			end
			t.expect((Session.join(s, 9))).toBe(false)
		end)
		t.it("downing one person does not end another person's game", function()
			local s = party(3)
			t.expect((Session.capture(s, 1, 0))).toBe(true)
			t.expect(s.phase).toBe("Playing")
			t.expect(s.members[2].status).toBe("Active")
			t.expect((Session.capture(s, 1, 0))).toBe(false)
		end)
		t.it("allows a different active member to rescue before the deadline", function()
			local s = party(3)
			Session.capture(s, 1, 0)
			t.expect((Session.revive(s, 1, 1, 1))).toBe(false)
			t.expect((Session.revive(s, 2, 1, 5))).toBe(true)
			t.expect(s.members[1].status).toBe("Active")
			t.expect((Session.revive(s, 2, 1, 6))).toBe(false)
		end)
		t.it("rejects expired rescue and returns eliminated members next stage", function()
			local s = party(3)
			Session.capture(s, 3, 0)
			t.expect((Session.revive(s, 2, 3, 45))).toBe(false)
			Session.tick(s, 45)
			t.expect(s.members[3].status).toBe("Waiting")
			complete(s)
			t.expect((Session.beginStage(s))).toBe(true)
			t.expect(s.members[3].status).toBe("Active")
		end)
		t.it("requires two distinct members at a relay when the team can cooperate", function()
			local s = party(3, 2)
			local plan = s.plan :: any
			local id = plan.activities[1].id
			t.expect((Session.act(s, 1, id, 1, 0))).toBe(true)
			t.expect((Session.act(s, 1, id, 1, 1))).toBe(false)
			t.expect((Session.act(s, 2, id, 1, 2))).toBe(true)
			t.expect(s.tasks[id].solved).toBe(true)
			t.expect((Session.act(s, 3, id, 1, 3))).toBe(false)
			Session.capture(s, 1, 4)
			t.expect(s.tasks[id].progress).toBe(3)
			Session.leave(s, 1)
			t.expect(s.tasks[id].progress).toBe(3)
		end)
		t.it("expires relay approvals and clears approvals on disconnect", function()
			local s = party(3, 2)
			local id = (s.plan :: any).activities[1].id
			Session.act(s, 1, id, 1, 0)
			Session.act(s, 2, id, 1, 20)
			t.expect(s.tasks[id].solved).toBe(false)
			Session.leave(s, 2)
			t.expect(s.tasks[id].relayBy).toBeNil()
		end)
		t.it("allows a last survivor to finish relays after teammates disconnect", function()
			local s = party(3, 2)
			local id = (s.plan :: any).activities[1].id
			Session.leave(s, 2)
			Session.leave(s, 3)
			Session.act(s, 1, id, 1, 0)
			t.expect((Session.act(s, 1, id, 1, 1))).toBe(true)
			t.expect(s.tasks[id].solved).toBe(true)
		end)
		t.it("preserves correct sequence steps after a mistake and rejects invalid actions", function()
			local s = party(3)
			local activity = (s.plan :: any).activities[2]
			Session.act(s, 1, activity.id, activity.order[1], 0)
			local wrong = activity.order[1]
			t.expect((Session.act(s, 1, activity.id, wrong, 1))).toBe(false)
			t.expect(s.tasks[activity.id].progress).toBe(1)
			t.expect((Session.act(s, 1, activity.id, 0 / 0, 1))).toBe(false)
			t.expect((Session.act(s, 1, activity.id, 1, math.huge))).toBe(false)
		end)
		t.it("repairs named components in order and keeps the technician shortcut", function()
			local s = party(3)
			local id = (s.plan :: any).activities[1].id
			t.expect((Session.act(s, 2, id, 3, 0))).toBe(false)
			t.expect(s.tasks[id].progress).toBe(0)
			t.expect((Session.act(s, 2, id, 1, 1))).toBe(true)
			t.expect((Session.act(s, 2, id, 1, 2))).toBe(false)
			t.expect((Session.act(s, 2, id, 2, 3))).toBe(true)
			t.expect((Session.act(s, 2, id, 3, 4))).toBe(true)
			t.expect(s.members[2].contributions).toBe(1)
			local tech = party(3)
			Session.act(tech, 1, id, 1, 0)
			t.expect(tech.tasks[id].progress).toBe(2)
			Session.act(tech, 1, id, 3, 1)
			t.expect(tech.tasks[id].solved).toBe(true)
			t.expect(tech.members[1].contributions).toBe(1)
			local shared = party(3)
			Session.act(shared, 2, id, 1, 0)
			Session.act(shared, 1, id, 2, 1)
			t.expect(shared.tasks[id].solved).toBe(false)
			t.expect(shared.tasks[id].progress).toBe(2)
			Session.act(shared, 2, id, 3, 2)
			t.expect(shared.tasks[id].solved).toBe(true)
		end)
		t.it("credits collaborators once per station and does not farm expired relay attempts", function()
			local s = party(3, 2)
			local id = (s.plan :: any).activities[1].id
			Session.act(s, 1, id, 1, 0)
			Session.tick(s, s.tasks[id].relayUntil)
			t.expect(s.tasks[id].progress).toBe(0)
			t.expect(s.tasks[id].relayBy).toBeNil()
			Session.act(s, 1, id, 1, 30)
			Session.act(s, 2, id, 1, 31)
			t.expect(s.members[1].contributions).toBe(1)
			t.expect(s.members[2].contributions).toBe(1)
			t.expect(s.tasks[id].contributors[1]).toBe(true)
			t.expect(s.tasks[id].contributors[2]).toBe(true)
		end)
		t.it("clears an armed relay when its owner is captured", function()
			local s = party(3, 2)
			local id = (s.plan :: any).activities[1].id
			Session.act(s, 1, id, 1, 0)
			Session.capture(s, 1, 1)
			t.expect(s.tasks[id].progress).toBe(0)
			t.expect(s.tasks[id].relayBy).toBeNil()
		end)
		t.it("keeps late joins waiting without changing the current puzzle plan", function()
			local s = party(3)
			local plan = s.plan
			Session.join(s, 4)
			t.expect(s.plan).toBe(plan)
			t.expect(s.members[4].status).toBe("Waiting")
			t.expect((Session.act(s, 4, "task_1", 1, 1))).toBe(false)
		end)
		t.it("requires all active survivors to escape, then completes the campaign", function()
			local s = party(3, 3)
			complete(s)
			t.expect(s.phase).toBe("Extracting")
			Session.escape(s, 1)
			t.expect(s.phase).toBe("Extracting")
			Session.escape(s, 2)
			t.expect(s.phase).toBe("Extracting")
			Session.escape(s, 3)
			t.expect(s.phase).toBe("Won")
		end)
		t.it("does not silently discard a downed teammate on the first escape", function()
			local s = party(3, 3)
			complete(s)
			Session.capture(s, 3, 0)
			Session.escape(s, 1)
			Session.escape(s, 2)
			t.expect(s.phase).toBe("Extracting")
			Session.tick(s, 45)
			t.expect(s.phase).toBe("Won")
		end)
		t.it("ends on a team wipe and requires a majority restart vote", function()
			local s = party(3)
			for id = 1, 3 do
				Session.capture(s, id, 0)
			end
			t.expect(s.phase).toBe("Lost")
			t.expect((Session.voteRestart(s, 1))).toBe(false)
			t.expect((Session.voteRestart(s, 1))).toBe(false)
			t.expect((Session.voteRestart(s, 2))).toBe(true)
		end)
		t.it("runs all stages for each party size from 2 to 8", function()
			for size = 2, 8 do
				local s = party(size)
				for stage = 1, 3 do
					t.expect(s.stage).toBe(stage)
					complete(s)
					if stage < 3 then
						t.expect((Session.beginStage(s))).toBe(true)
					end
				end
				for id = 1, size do
					Session.escape(s, id)
				end
				t.expect(s.phase).toBe("Won")
			end
		end)
		t.it("returns an empty party to a fresh lobby instead of a completed stage", function()
			local s = party(3, 3)
			for id = 1, 3 do
				Session.leave(s, id)
			end
			t.expect(s.phase).toBe("Lobby")
			t.expect(s.stage).toBe(0)
			t.expect(s.plan).toBeNil()
			for id = 4, 6 do
				Session.join(s, id)
			end
			t.expect((Session.beginStage(s))).toBe(true)
			t.expect(s.stage).toBe(1)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="525">
          <Properties>
            <string name="Name">CreatureBrain</string>
            <string name="Source"><![CDATA[--!strict
local Config = require("@game/ReplicatedStorage/Shared/Config")
local CreatureBrain = require("@game/ServerScriptService/Server/Game/CreatureBrain")
local TestKit = require("../TestKit")

local C = Config.Creature
local PLAYER = { name = "player-pos" }
local NOISE = { name = "noise-pos" }

local function perception(overrides: { [string]: any }): CreatureBrain.Perception
	local p: { [string]: any } = {
		now = 0,
		canSee = false,
		lineOfSight = false,
		distance = 40,
		targetPos = PLAYER,
		noisePos = nil,
		hunt = false,
		arrived = false,
	}
	for key, value in overrides do
		p[key] = value
	end
	return p :: any
end

local function awake(): CreatureBrain.Brain
	local brain = CreatureBrain.new()
	CreatureBrain.activate(brain)
	return brain
end

local spec: TestKit.Spec = {
	name = "CreatureBrain",
	run = function(t)
		t.it("stays still while dormant", function()
			local brain = CreatureBrain.new()
			local cmd = CreatureBrain.step(brain, perception({ canSee = true, lineOfSight = true, distance = 2 }))
			t.expect(cmd.mode).toBe("Dormant")
			t.expect(cmd.speed).toBe(0)
		end)

		t.it("patrols after waking up", function()
			local cmd = CreatureBrain.step(awake(), perception({}))
			t.expect(cmd.mode).toBe("Patrol")
			t.expect(cmd.target).toBeNil()
			t.expect(cmd.speed).toBe(C.PatrolSpeed)
		end)

		t.it("chases on sight and reports 'spotted' once", function()
			local brain = awake()
			local first = CreatureBrain.step(brain, perception({ canSee = true, lineOfSight = true, now = 1 }))
			t.expect(first.mode).toBe("Chase")
			t.expect(first.event).toBe("spotted")
			t.expect(first.target).toBe(PLAYER)
			t.expect(first.speed).toBe(C.ChaseSpeed)
			local second = CreatureBrain.step(brain, perception({ canSee = true, lineOfSight = true, now = 1.2 }))
			t.expect(second.event).toBeNil()
		end)

		t.it("keeps tracking briefly, then goes to the last seen spot, then searches", function()
			local brain = awake()
			CreatureBrain.step(brain, perception({ canSee = true, lineOfSight = true, now = 10 }))
			local grace = CreatureBrain.step(brain, perception({ now = 10 + C.GraceTime * 0.5, targetPos = NOISE }))
			t.expect(grace.mode).toBe("Chase")
			t.expect(grace.target).toBe(PLAYER) -- segue somente a memória de visão válida
			local memory = CreatureBrain.step(brain, perception({ now = 10 + C.GraceTime + 0.5 }))
			t.expect(memory.mode).toBe("Chase")
			t.expect(memory.target).toBe(PLAYER) -- último lugar visto
			local lost = CreatureBrain.step(brain, perception({ now = 10 + C.LoseSightTime + 0.1 }))
			t.expect(lost.mode).toBe("Search")
			t.expect(lost.event).toBe("lost")
			local back = CreatureBrain.step(brain, perception({ now = 10 + C.LoseSightTime + C.SearchTime + 0.2 }))
			t.expect(back.mode).toBe("Patrol")
		end)

		t.it("investigates noise, then searches on arrival", function()
			local brain = awake()
			local cmd = CreatureBrain.step(brain, perception({ noisePos = NOISE }))
			t.expect(cmd.mode).toBe("Investigate")
			t.expect(cmd.target).toBe(NOISE)
			t.expect(cmd.speed).toBe(C.InvestigateSpeed)
			local going = CreatureBrain.step(brain, perception({ now = 1 }))
			t.expect(going.target).toBe(NOISE)
			local arrived = CreatureBrain.step(brain, perception({ now = 2, arrived = true }))
			t.expect(arrived.mode).toBe("Search")
		end)

		t.it("captures only when close AND with line of sight", function()
			local brain = awake()
			local blocked = CreatureBrain.step(brain, perception({ distance = 2, lineOfSight = false }))
			t.expect(blocked.mode ~= "Capture").toBe(true)
			t.expect(blocked.event).toBeNil()
			local caught =
				CreatureBrain.step(brain, perception({ distance = C.CaptureRange - 0.1, lineOfSight = true }))
			t.expect(caught.mode).toBe("Capture")
			t.expect(caught.event).toBe("capture")
			local after = CreatureBrain.step(brain, perception({ canSee = true, lineOfSight = true, distance = 1 }))
			t.expect(after.mode).toBe("Capture")
			t.expect(after.event).toBeNil() -- não dispara a captura de novo
			t.expect(after.speed).toBe(0)
		end)

		t.it("hunts without seeing once the power is back", function()
			local brain = awake()
			local cmd = CreatureBrain.step(brain, perception({ hunt = true }))
			t.expect(cmd.mode).toBe("Chase")
			t.expect(cmd.speed).toBe(C.HuntSpeed)
			t.expect(cmd.event).toBeNil()
		end)

		t.it("gets faster with each fuse", function()
			t.expect(CreatureBrain.speedFor("Patrol", 2, false)).toBeCloseTo(C.PatrolSpeed + 2 * C.PatrolSpeedPerFuse)
			t.expect(CreatureBrain.speedFor("Chase", 3, false)).toBeCloseTo(C.ChaseSpeed + 3 * C.ChaseSpeedPerFuse)
			t.expect(CreatureBrain.speedFor("Search", 3, false)).toBe(0)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="526">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local PlayerDataSchema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local TestKit = require("../TestKit")

local function fixed(...: number): () -> number
	local values = { ... }
	local index = 0
	return function()
		index = index % #values + 1
		return values[index]
	end
end

local function summary(overrides: { [string]: any }?): Economy.RunSummary
	local s: { [string]: any } =
		{ won = false, escaped = false, stages = 0, fuses = 0, breakers = false, contributions = 0 }
	if overrides then
		for key, value in overrides do
			s[key] = value
		end
	end
	return s :: any
end

local spec: TestKit.Spec = {
	name = "Economy",
	run = function(t)
		t.it("levels follow the published curve", function()
			t.expect((Economy.levelInfo(0))).toBe(1)
			local level, into, need = Economy.levelInfo(StoreCatalog.LevelBase)
			t.expect(level).toBe(2)
			t.expect(into).toBe(0)
			t.expect(need).toBe(Economy.xpToNext(2))
			t.expect((Economy.levelInfo(10 ^ 9))).toBe(StoreCatalog.LevelCap)
		end)

		t.it("xp grants each level reward exactly once, with milestones", function()
			local data = PlayerDataSchema.template()
			local granted = Economy.applyReward(data, { xp = 10000 })
			t.expect(#granted.levels > 3).toBe(true)
			t.expect(data.owned.filtro_sepia).toBe(true) -- marco do nível 3
			local before = data.wallet.fichas
			Economy.applyReward(data, { xp = 0 })
			t.expect(data.wallet.fichas).toBe(before)
			t.expect(data.rewardedLevel).toBe((Economy.levelInfo(data.xp)))
		end)

		t.it("buys store items once, with the right currency", function()
			local data = PlayerDataSchema.template()
			local ok, err = Economy.buyItem(data, "lanterna_militar", "fichas")
			t.expect(ok).toBe(false)
			t.expect(err).toBe("store_poor")
			data.wallet.fichas = 1000
			t.expect((Economy.buyItem(data, "lanterna_militar", "fichas"))).toBe(true)
			t.expect(data.wallet.fichas).toBe(600)
			local _, again = Economy.buyItem(data, "lanterna_militar", "fichas")
			t.expect(again).toBe("store_owned")
			local _, noPrice = Economy.buyItem(data, "lanterna_neon", "fichas")
			t.expect(noPrice).toBe("store_no_price")
			local _, notSold = Economy.buyItem(data, "titulo_lenda", "fichas")
			t.expect(notSold).toBe("store_unknown")
		end)

		t.it("opens chests by the published odds; duplicates become fichas", function()
			local data = PlayerDataSchema.template()
			local chest = StoreCatalog.ChestById.bau_ferramentas
			data.wallet.fichas = chest.price * 2
			-- random() = 0 -> primeira raridade (comum), primeiro item comum da lista ordenada.
			local ok, _, result = Economy.openChest(data, chest.id, fixed(0))
			t.expect(ok).toBe(true)
			assert(result, "result")
			t.expect(result.rarity).toBe("common")
			t.expect(result.duplicate).toBe(false)
			t.expect(data.owned[result.item]).toBe(true)
			t.expect(data.wallet.fichas).toBe(chest.price)
			local _, _, again = Economy.openChest(data, chest.id, fixed(0))
			assert(again, "again")
			t.expect(again.duplicate).toBe(true)
			t.expect(again.refund).toBe(StoreCatalog.Rarities.common.refund)
			t.expect(data.wallet.fichas).toBe(StoreCatalog.Rarities.common.refund)
			t.expect(data.stats.chests).toBe(2)
		end)

		t.it("the highest roll lands on the rarest tier", function()
			local data = PlayerDataSchema.template()
			data.wallet.creditos = 1000
			local _, _, result = Economy.openChest(data, "bau_lacrado", fixed(0.9999))
			assert(result, "result")
			t.expect(result.rarity).toBe("legendary")
		end)

		t.it("paid random chest is blocked for restricted players; free chest is not", function()
			local data = PlayerDataSchema.template()
			data.wallet.creditos = 1000
			data.wallet.fichas = 1000
			local ok, err = Economy.openChest(data, "bau_lacrado", fixed(0), true)
			t.expect(ok).toBe(false)
			t.expect(err).toBe("store_restricted")
			t.expect(data.wallet.creditos).toBe(1000)
			t.expect((Economy.openChest(data, "bau_ferramentas", fixed(0), true))).toBe(true)
		end)

		t.it("daily calendar: streak grows on consecutive days and resets after a gap", function()
			local data = PlayerDataSchema.template()
			local ok, _, day1 = Economy.claimDaily(data, 100)
			t.expect(ok).toBe(true)
			t.expect(day1).toBe(1)
			local again, why = Economy.claimDaily(data, 100)
			t.expect(again).toBe(false)
			t.expect(why).toBe("daily_claimed")
			local _, _, day2 = Economy.claimDaily(data, 101)
			t.expect(day2).toBe(2)
			local _, _, reset = Economy.claimDaily(data, 105)
			t.expect(reset).toBe(1)
		end)

		t.it("daily calendar wraps after day 7", function()
			local data = PlayerDataSchema.template()
			for day = 1, 7 do
				Economy.claimDaily(data, 200 + day)
			end
			t.expect(data.daily.streak).toBe(7)
			t.expect(data.wallet.creditos).toBe(StoreCatalog.Daily[7].creditos)
			local _, _, eighth = Economy.claimDaily(data, 208)
			t.expect(eighth).toBe(1)
		end)

		t.it("one free spin per day (two with VIP)", function()
			local data = PlayerDataSchema.template()
			t.expect((Economy.spin(data, 10, false, fixed(0)))).toBe(true)
			local again, err = Economy.spin(data, 10, false, fixed(0))
			t.expect(again).toBe(false)
			t.expect(err).toBe("spin_used")
			t.expect(Economy.spinsLeft(data, 10, true)).toBe(1)
			t.expect((Economy.spin(data, 10, true, fixed(0)))).toBe(true)
			t.expect(Economy.spinsLeft(data, 11, false)).toBe(1)
		end)

		t.it("run rewards scale with progress, contributions are capped, VIP multiplies", function()
			local base = Economy.runReward(summary())
			local better = Economy.runReward(summary({ stages = 2, contributions = 5, escaped = true }))
			t.expect((better.fichas :: number) > (base.fichas :: number)).toBe(true)
			local capped = Economy.runReward(summary({ contributions = 999 }))
			local cap = Economy.runReward(summary({ contributions = StoreCatalog.RunRewards.contributionCap }))
			t.expect(capped.fichas).toBe(cap.fichas)
			local vip = Economy.runReward(summary(), true)
			t.expect(vip.fichas).toBe(math.floor((base.fichas :: number) * StoreCatalog.VipMultiplier + 0.5))
		end)

		t.it("first escape grants the survivor title once", function()
			local data = PlayerDataSchema.template()
			Economy.recordRun(data, summary({ escaped = true }))
			t.expect(data.owned[StoreCatalog.FirstEscapeItem]).toBe(true)
			t.expect(data.stats.escapes).toBe(1)
			Economy.recordRun(data, summary())
			t.expect(data.stats.captures).toBe(1)
			t.expect(data.stats.runs).toBe(2)
		end)

		t.it("tapes: only new tapes reward; milestones unlock items", function()
			local data = PlayerDataSchema.template()
			t.expect((Economy.addTape(data, "fita_01", 1))).toBe(true)
			t.expect((Economy.addTape(data, "fita_01", 2))).toBe(false)
			t.expect((Economy.addTape(data, "nope", 3))).toBe(false)
			for i = 2, 8 do
				Economy.addTape(data, string.format("fita_%02d", i), i)
			end
			t.expect(Economy.tapeCount(data)).toBe(8)
			t.expect(data.owned.lanterna_vigia).toBe(true)
		end)

		t.it("equips only owned items; VIP items depend on the pass", function()
			local data = PlayerDataSchema.template()
			local _, err = Economy.equip(data, "lanterna_ouro")
			t.expect(err).toBe("store_locked")
			t.expect((Economy.equip(data, "lanterna_supervisor", true))).toBe(true)
			-- Perdeu o VIP: volta ao padrão.
			t.expect(Economy.equipped(data, "flashlight", false)).toBe(StoreCatalog.Defaults.flashlight)
			t.expect(Economy.equipped(data, "flashlight", true)).toBe("lanterna_supervisor")
		end)

		t.it("Robux purchases are idempotent per receipt and starter pack is once", function()
			local data = PlayerDataSchema.template()
			local pack = StoreCatalog.ProductByKey.creditos_100
			t.expect((Economy.grantProduct(data, pack, "r1", 1))).toBe(true)
			t.expect((Economy.grantProduct(data, pack, "r1", 2))).toBe(false)
			t.expect(data.wallet.creditos).toBe(100)
			local starter = StoreCatalog.ProductByKey.pacote_inicial
			t.expect((Economy.grantProduct(data, starter, "r2", 3))).toBe(true)
			t.expect(data.owned.lanterna_retro).toBe(true)
			t.expect(data.owned.farda_noturna).toBe(true)
			local ok, note = Economy.grantProduct(data, starter, "r3", 4)
			t.expect(ok).toBe(true)
			t.expect(note).toBe("once_converted")
			t.expect(data.wallet.creditos).toBe(100 + 300 + 300)
		end)

		t.it("keeps only the newest receipts", function()
			local data = PlayerDataSchema.template()
			for i = 1, 10 do
				data.purchases[`r{i}`] = i
			end
			Economy.trimPurchases(data, 4)
			local count = 0
			for _ in data.purchases do
				count += 1
			end
			t.expect(count).toBe(4)
			t.expect(data.purchases.r10).toBe(10)
			t.expect(data.purchases.r1).toBeNil()
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="527">
          <Properties>
            <string name="Name">EconomyEvents</string>
            <string name="Source"><![CDATA[--!strict
local Events = require("@game/ServerScriptService/Server/Game/EconomyEvents")
local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local Schema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local TestKit = require("../TestKit")
local spec: TestKit.Spec = {
	name = "EconomyEvents",
	run = function(t)
		t.it("records gross chest spend before duplicate refund", function()
			local events = Events.build({ fichas = 150, creditos = 0 }, {
				{
					transaction = "Shop",
					sku = "chest",
					spend = { currency = "fichas", amount = 250 },
					granted = { fichas = 50, creditos = 0, xp = 0, items = {}, refunds = { item = 50 }, levels = {} },
				},
			})
			t.expect(#events).toBe(2)
			t.expect(events[1].flow).toBe("Sink")
			t.expect(events[1].amount).toBe(250)
			t.expect(events[1].balance).toBe(100)
			t.expect(events[2].sku).toBe("duplicate_refund")
			t.expect(events[2].balance).toBe(150)
		end)
		t.it("partitions account levels and multiple rewards without double counting", function()
			local data = Schema.template()
			local granted = Economy.applyReward(data, { fichas = 100, creditos = 20, xp = 1000 })
			local season = Economy.applyReward(data, { fichas = 50 })
			local events = Events.build(data.wallet, {
				{ transaction = "Gameplay", sku = "run", granted = granted },
				{ transaction = "SeasonPass", sku = "season_free", granted = season },
			})
			local totals = { fichas = 0, creditos = 0 }
			for _, event in events do
				totals[event.currency] += event.amount
			end
			t.expect(totals.fichas).toBe(data.wallet.fichas)
			t.expect(totals.creditos).toBe(data.wallet.creditos)
			t.expect(events[#events].balance).toBe(data.wallet.fichas)
		end)
	end,
}
return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="528">
          <Properties>
            <string name="Name">EstateGround</string>
            <string name="Source"><![CDATA[--!strict
local TestKit = require("../TestKit")
return {
	name = "EstateGround",
	robloxOnly = true,
	run = function(t: TestKit.Context)
		t.it("the entire garden and foyer recess have solid ground before and after seeded estate rebuilds", function()
			local House = require("@game/ServerScriptService/Server/World/HouseBuilder")
			local Estate = require("@game/ServerScriptService/Server/World/HouseLevelBuilder")
			local Level = require("@game/ServerScriptService/Server/Campaign/HouseLevelPlan")
			local fixture = Instance.new("Folder")
			fixture.Name, fixture.Parent = "EstateGroundFixture", workspace
			local ok, reason = pcall(function()
				local world = House.build(fixture)
				local offset = Vector3.new(-6000, 0, 0)
				local rays = RaycastParams.new()
				rays.FilterType, rays.FilterDescendantsInstances = Enum.RaycastFilterType.Include, { world.root }
				rays.RespectCanCollide = true
				for seed = 0, 3 do
					if seed > 0 then
						-- Reposiciona a fixture só depois da construção que usa coordenadas locais.
						for _, part in world.root:GetDescendants() do
							if part:IsA("BasePart") then
								part.CFrame -= offset
							end
						end
						Estate.build(world.root, Level.create(seed * 79, 3, "Standard"))
					end
					for _, part in world.root:GetDescendants() do
						if part:IsA("BasePart") then
							part.CFrame += offset
						end
					end
					for x = -107, 107, 2 do
						for z = -117, 131, 2 do
							local exterior = x < -44.5 or x > 45.5 or z < -85.5 or z > 64.5 or (x < -24.5 and z > 12.5)
							if exterior then
								local hit =
									workspace:Raycast(Vector3.new(x, 0.6, z) + offset, Vector3.new(0, -1.2, 0), rays)
								assert(hit, `Garden void at {x}/{z}, seed={seed}`)
							end
						end
						if x % 17 == 0 then
							task.wait()
						end
					end
					for _, p in { Vector3.new(-45.2, 0.6, -30), Vector3.new(45.8, 0.6, 8), Vector3.new(-34, 0.6, 38) } do
						assert(workspace:Raycast(p + offset, Vector3.new(0, -1.2, 0), rays), "Foundation seam is open")
					end
					-- O conserto não preenche o volume dos cômodos subterrâneos.
					local soil = world.root.ProgressionBarriers
					local filter = RaycastParams.new()
					filter.FilterType, filter.FilterDescendantsInstances = Enum.RaycastFilterType.Include, { soil }
					t.expect(workspace:Raycast(Vector3.new(-26, -12, -4) + offset, Vector3.new(0, 5, 0), filter))
						.toBe(nil)
				end
			end)
			fixture:Destroy()
			assert(ok, tostring(reason))
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="529">
          <Properties>
            <string name="Name">FearModel</string>
            <string name="Source"><![CDATA[--!strict
local Config = require("@game/ReplicatedStorage/Shared/Config")
local FearModel = require("@game/ReplicatedStorage/Shared/Game/FearModel")
local TestKit = require("../TestKit")

local F = Config.Fear

local function inputs(overrides: { [string]: any }): FearModel.Inputs
	local i: { [string]: any } = {
		creatureDistance = math.huge,
		creatureVisible = false,
		chasing = false,
		darkness = 0,
		hidden = false,
		safe = false,
	}
	for key, value in overrides do
		i[key] = value
	end
	return i :: any
end

local function run(state: FearModel.State, i: FearModel.Inputs, seconds: number)
	local dt = 0.1
	for _ = 1, math.floor(seconds / dt) do
		FearModel.step(state, i, dt)
	end
end

local spec: TestKit.Spec = {
	name = "FearModel",
	run = function(t)
		t.it("stays calm with no threat and light", function()
			local s = FearModel.new()
			run(s, inputs({}), 10)
			t.expect(s.value).toBe(0)
			t.expect(s.level).toBe(0)
		end)

		t.it("rises with proximity, more when visible, floor during chase", function()
			local far = FearModel.target(inputs({ creatureDistance = 40 }))
			local near = FearModel.target(inputs({ creatureDistance = 8 }))
			local seen = FearModel.target(inputs({ creatureDistance = 8, creatureVisible = true }))
			t.expect(near > far).toBe(true)
			t.expect(seen > near).toBe(true)
			t.expect(FearModel.target(inputs({ chasing = true, creatureDistance = 60 })) >= F.ChaseFloor).toBe(true)
		end)

		t.it("is always clamped to 0..1", function()
			local maxed = inputs({ creatureDistance = 0, creatureVisible = true, chasing = true, darkness = 5 })
			t.expect(FearModel.target(maxed) <= 1).toBe(true)
			local s = FearModel.new()
			FearModel.spike(s, 10)
			run(s, maxed, 5)
			t.expect(s.value <= 1 and s.value >= 0).toBe(true)
		end)

		t.it("rises fast and decays slowly", function()
			local s = FearModel.new()
			run(s, inputs({ chasing = true }), 2)
			local peak = s.value
			t.expect(peak > 0.6).toBe(true)
			run(s, inputs({}), 2)
			t.expect(s.value > peak * 0.6).toBe(true) -- 2 s depois ainda está alto
			run(s, inputs({ safe = true }), 40)
			t.expect(s.value < 0.05).toBe(true)
		end)

		t.it("safe places cap the target", function()
			local capped = FearModel.target(inputs({ creatureDistance = 10, darkness = 1, safe = true }))
			t.expect(capped <= F.SafeCeiling).toBe(true)
		end)

		t.it("spikes add on top and wear off", function()
			local s = FearModel.new()
			FearModel.spike(s, 0.4)
			t.expect(s.value).toBeCloseTo(0.4)
			run(s, inputs({}), 10)
			t.expect(s.spike < 0.4).toBe(true)
			run(s, inputs({}), 20)
			t.expect(s.spike).toBe(0)
		end)

		t.it("uses hysteresis between levels", function()
			local first = F.Levels[1]
			t.expect(FearModel.levelFor(first.enter + 0.01, 0)).toBe(1)
			-- Entre exit e enter: mantém o nível em que estava.
			local between = (first.enter + first.exit) / 2
			t.expect(FearModel.levelFor(between, 1)).toBe(1)
			t.expect(FearModel.levelFor(between, 0)).toBe(0)
			t.expect(FearModel.levelFor(first.exit - 0.01, 1)).toBe(0)
			t.expect(FearModel.levelFor(1, 0)).toBe(FearModel.MAX_LEVEL)
		end)

		t.it("reports level changes and resets", function()
			local s = FearModel.new()
			local changed = false
			for _ = 1, 30 do
				changed = FearModel.step(s, inputs({ chasing = true }), 0.1) or changed
			end
			t.expect(changed).toBe(true)
			t.expect(s.level >= 2).toBe(true)
			FearModel.reset(s)
			t.expect(s.value).toBe(0)
			t.expect(s.level).toBe(0)
		end)
	end,
}

return spec
]]></string>
