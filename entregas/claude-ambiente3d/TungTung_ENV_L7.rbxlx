          <string name="Name">Specs</string>
        </Properties>
        <Item class="ModuleScript" referent="516">
          <Properties>
            <string name="Name">BatteryModel</string>
            <string name="Source"><![CDATA[--!strict
local BatteryModel = require("@game/ReplicatedStorage/Shared/Game/BatteryModel")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local TestKit = require("../TestKit")

local B = Config.Battery

local function run(state: BatteryModel.State, seconds: number): boolean
	local died = false
	local dt = 0.2
	for _ = 1, math.floor(seconds / dt + 0.5) do
		died = BatteryModel.step(state, dt) or died
	end
	return died
end

local spec: TestKit.Spec = {
	name = "BatteryModel",
	run = function(t)
		t.it("drains while on and turns itself off at zero", function()
			local s = BatteryModel.new(1)
			BatteryModel.setOn(s, true)
			run(s, 10)
			t.expect(s.charge).toBeCloseTo(1 - 10 * B.DrainPerSecond, 1e-4)
			local died = false
			for _ = 1, 100000 do
				died = BatteryModel.step(s, 0.2)
				if died then
					break
				end
			end
			t.expect(died).toBe(true)
			t.expect(s.charge).toBe(0)
			t.expect(s.on).toBe(false)
			-- Apagada, volta a descansar (recupera aos poucos).
			BatteryModel.step(s, 1)
			t.expect(s.charge > 0).toBe(true)
		end)

		t.it("refuses to turn on when empty", function()
			local s = BatteryModel.new(0)
			t.expect(BatteryModel.setOn(s, true)).toBe(false)
			t.expect(s.on).toBe(false)
		end)

		t.it("never blocks the mission: resting recovers to the cap", function()
			local s = BatteryModel.new(0)
			local seconds = BatteryModel.secondsToRecover(0)
			t.expect(seconds < 30).toBe(true)
			run(s, seconds + 1)
			t.expect(s.charge).toBeCloseTo(B.RechargeCap, 1e-6)
			t.expect(BatteryModel.setOn(s, true)).toBe(true)
			-- Descanso não passa do teto.
			local full = BatteryModel.new(0.9)
			run(full, 60)
			t.expect(full.charge).toBeCloseTo(0.9, 1e-6)
		end)

		t.it("pickups add charge up to 100%", function()
			local s = BatteryModel.new(0.2)
			BatteryModel.addPickup(s)
			t.expect(s.charge).toBeCloseTo(0.2 + B.PickupAmount, 1e-6)
			BatteryModel.addPickup(s)
			t.expect(s.charge).toBe(1)
		end)

		t.it("maps charge to LEDs and dims when low", function()
			t.expect(BatteryModel.leds(0)).toBe(0)
			t.expect(BatteryModel.leds(0.01)).toBe(1)
			t.expect(BatteryModel.leds(0.5)).toBe(2)
			t.expect(BatteryModel.leds(0.51)).toBe(3)
			t.expect(BatteryModel.leds(1)).toBe(4)
			t.expect(BatteryModel.brightness(1)).toBe(1)
			t.expect(BatteryModel.brightness(0) < BatteryModel.brightness(B.LowLevel * 0.5)).toBe(true)
			t.expect(BatteryModel.isLow(B.LowLevel)).toBe(true)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="517">
          <Properties>
            <string name="Name">BreakerPuzzle</string>
            <string name="Source"><![CDATA[--!strict
local BreakerPuzzle = require("@game/ServerScriptService/Server/Game/BreakerPuzzle")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "BreakerPuzzle",
	run = function(t)
		t.it("solves only in the diagram order", function()
			local s = BreakerPuzzle.new({ 2, 3, 1 })
			t.expect(BreakerPuzzle.press(s, 2)).toBe("progress")
			t.expect(BreakerPuzzle.isUp(s, 2)).toBe(true)
			t.expect(BreakerPuzzle.press(s, 2)).toBe("already")
			t.expect(BreakerPuzzle.press(s, 3)).toBe("progress")
			t.expect(BreakerPuzzle.press(s, 1)).toBe("solved")
			t.expect(s.solved).toBe(true)
			t.expect(BreakerPuzzle.press(s, 1)).toBe("already")
		end)

		t.it("a wrong lever drops all of them", function()
			local s = BreakerPuzzle.new({ 2, 3, 1 })
			BreakerPuzzle.press(s, 2)
			t.expect(BreakerPuzzle.press(s, 1)).toBe("wrong")
			t.expect(s.progress).toBe(0)
			t.expect(BreakerPuzzle.isUp(s, 2)).toBe(false)
		end)

		t.it("shuffles a permutation and describes it", function()
			local calls = 0
			local order = BreakerPuzzle.shuffle(3, function(a: number, _b: number): number
				calls += 1
				return a
			end)
			t.expect(calls).toBe(2)
			table.sort(order)
			t.expect(order).toEqual({ 1, 2, 3 })
			t.expect(BreakerPuzzle.describe({ 2, 3, 1 })).toBe("B - C - A")
		end)

		t.it("rejects invalid orders", function()
			t.expect(function()
				BreakerPuzzle.new({})
			end).toThrow("empty")
			t.expect(function()
				BreakerPuzzle.new({ 1, 1 })
			end).toThrow("repeated")
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="518">
          <Properties>
            <string name="Name">CampaignGenerator</string>
            <string name="Source"><![CDATA[--!strict
local Generator = require("@game/ServerScriptService/Server/Campaign/CampaignGenerator")
local SeededRandom = require("@game/ServerScriptService/Server/Campaign/SeededRandom")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "CampaignGenerator",
	run = function(t)
		t.it("reproduces the complete plan from seed, stage and party size", function()
			t.expect(Generator.create(9182, 2, 8)).toEqual(Generator.create(9182, 2, 8))
		end)
		t.it("varies activities, sequences and routes across seeds", function()
			local signatures: { [string]: boolean } = {}
			for seed = 1, 64 do
				local plan = Generator.create(seed, 2, 5)
				local parts = table.clone(plan.closedLinks)
				for _, activity in plan.activities do
					table.insert(parts, activity.slot .. activity.kind .. table.concat(activity.order, ""))
				end
				signatures[table.concat(parts, ":")] = true
			end
			local count = 0
			for _ in signatures do
				count += 1
			end
			t.expect(count >= 60).toBe(true)
		end)
		t.it("keeps 3600 generated plans valid for every target party size and stage", function()
			for seed = 1, 200 do
				for players = 3, 8 do
					for stage = 1, 3 do
						local plan = Generator.create(seed, stage, players)
						local valid, reason = Generator.validate(plan)
						if not valid then
							error(`seed={seed} players={players} stage={stage}: {reason}`)
						end
						t.expect(#plan.activities >= players).toBe(true)
					end
				end
			end
		end)
		t.it("rejects a closure on the permanent circulation spine", function()
			local plan = Generator.create(9, 1, 3)
			plan.closedLinks = { "entry" }
			t.expect((Generator.validate(plan))).toBe(false)
		end)
		t.it("rejects duplicate stations and unknown coordinates", function()
			local plan = Generator.create(9, 1, 3)
			plan.activities[2].slot = plan.activities[1].slot
			t.expect((Generator.validate(plan))).toBe(false)
			plan = Generator.create(9, 1, 3)
			plan.activities[1].x = 10000
			t.expect((Generator.validate(plan))).toBe(false)
		end)
		t.it("rejects impossible party/stage parameters and non-finite seeds", function()
			t.expect(function()
				Generator.create(9, 0, 3)
			end).toThrow()
			t.expect(function()
				Generator.create(9, 1, 9)
			end).toThrow()
			t.expect(function()
				SeededRandom.new(math.huge)
			end).toThrow()
			t.expect(function()
				SeededRandom.new(0 / 0)
			end).toThrow()
		end)
		t.it("shuffles without changing the source array or its elements", function()
			local source = { 1, 2, 3, 4, 5 }
			local a = SeededRandom.new(55).shuffle(source)
			local b = SeededRandom.new(55).shuffle(source)
			t.expect(a).toEqual(b)
			t.expect(source).toEqual({ 1, 2, 3, 4, 5 })
			table.sort(a)
			t.expect(a).toEqual(source)
		end)
	end,
}

return spec
]]></string>
          </Properties>
