        <Item class="ModuleScript" referent="530">
          <Properties>
            <string name="Name">ForestCampaign</string>
            <string name="Source"><![CDATA[--!strict
local Plan = require("@game/ServerScriptService/Server/Campaign/ForestPlan")
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local TestKit = require("../TestKit")
return {
	name = "ForestCampaign",
	run = function(t: TestKit.Context)
		t.it("forest seeds are reproducible, reject displaced objectives and keep every repair step", function()
			for seed = 1, 30 do
				for chapter = 6, 8 do
					for _, mode in { "Story", "Standard" } do
						local plan = Plan.create(seed, chapter, 2, mode)
						t.expect((Plan.validate(plan))).toBe(true)
						t.expect(plan).toEqual(Plan.create(seed, chapter, 2, mode))
						for _, spec in plan.activities do
							t.expect(math.abs(spec.x) < 70 and spec.z >= 600 and spec.z < 880).toBe(true)
							if spec.kind == "repair" then
								t.expect(spec.order).toEqual({ 1, 2, 3 })
							end
						end
						plan.activities[1].z = 0
						t.expect((Plan.validate(plan))).toBe(false)
					end
				end
			end
		end)
		t.it("house evacuation waits for downed teammates and leads to forest instead of victory", function()
			local state = Session.new(42, Config.Campaign, "Story", true)
			Session.join(state, 1)
			Session.join(state, 2)
			state.stage, state.phase = 5, "Extracting"
			state.members[1].status, state.members[2].status = "Active", "Active"
			Session.capture(state, 2, 0)
			Session.escape(state, 1)
			t.expect(state.phase).toBe("Extracting")
			Session.tick(state, Config.Campaign.downedSeconds + 1)
			t.expect(state.phase).toBe("Intermission")
			t.expect((Session.beginStage(state))).toBe(true)
			t.expect(state.stage).toBe(6)
			t.expect(Session.count(state, "Active")).toBe(2)
		end)
		t.it("forest defeat restores its checkpoint and final rescue needs a real extraction", function()
			local state = Session.new(42, Config.Campaign, "Story", true)
			Session.join(state, 1)
			state.stage, state.phase = 6, "Intermission"
			Session.beginStage(state)
			Session.act(state, 1, "task_1", 1, 0)
			Session.eliminate(state, 1)
			t.expect(state.phase).toBe("Lost")
			Session.retryStage(state)
			Session.beginStage(state)
			t.expect(state.stage).toBe(7)
			t.expect(state.inventory.forest_fuse).toBe(nil)
			state.stage, state.phase = 7, "Intermission"
			Session.beginStage(state)
			assert(state.plan, "Expected forest plan")
			for _, spec in state.plan.activities do
				for _, button in spec.order do
					t.expect((Session.act(state, 1, spec.id, button, 0))).toBe(true)
				end
			end
			t.expect(state.phase).toBe("Extracting")
			Session.escape(state, 1)
			t.expect(state.phase).toBe("Won")
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="531">
          <Properties>
            <string name="Name">ForestHorror</string>
            <string name="Source"><![CDATA[--!strict
local Threat = require("@game/ReplicatedStorage/Shared/Game/ForestThreat")
local Forest = require("@game/ReplicatedStorage/Shared/Game/ForestCatalog")
local Layout = require("@game/ServerScriptService/Server/World/ForestLayout")
local Plan = require("@game/ServerScriptService/Server/Campaign/ForestPlan")
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Cinema = require("@game/ReplicatedStorage/Shared/Game/ForestCinema")
local Shots = require("@game/ReplicatedStorage/Shared/Game/CinematicShots")
local TestKit = require("../TestKit")
return {
	name = "ForestHorror",
	run = function(t: TestKit.Context)
		t.it("forest pressure escalates without changing the house or moving a stationary creature", function()
			t.expect(Threat.speed(5, "Chase", 18)).toBe(18)
			t.expect(Threat.speed(8, "Search", 0)).toBe(0)
			t.expect(Threat.speed(8, "Chase", 18) < Config.Player.SprintSpeed).toBe(true)
			t.expect(Threat.speed(8, "Patrol", 8) > Threat.speed(6, "Patrol", 8)).toBe(true)
			for chapter = 6, 8 do
				t.expect(Threat.dark(0, chapter)).toBe(true)
				t.expect(Threat.dark(7, chapter)).toBe(false)
			end
		end)
		t.it("dense tree pockets coexist with every objective approach and six shelter entrances", function()
			for seed = 1, 20 do
				local clear = Layout.clearings(seed)
				for chapter = 6, 8 do
					for _, mode in { "Story", "Standard" } do
						for _, spec in Plan.create(seed, chapter, 6, mode).activities do
							t.expect(Layout.reserved(spec.x, spec.z + 5, clear)).toBe(true)
						end
					end
				end
				for _, hide in Forest.Hides do
					t.expect(Layout.reserved(hide.x, hide.z + 6, clear)).toBe(true)
				end
				local pockets = 0
				for x = -65, 65, 5 do
					for z = 550, 850, 5 do
						if not Layout.reserved(x, z, clear) then
							pockets += 1
						end
					end
				end
				t.expect(pockets > 150).toBe(true)
			end
		end)
		t.it(
			"new forest tasks reject skipped dependencies, retain puzzle progress and still reach extraction",
			function()
				for _, mode in { "Story", "Standard" } do
					for _, players in { 1, 2, 6 } do
						local state = Session.new(42, Config.Campaign, mode, true)
						for id = 1, players do
							Session.join(state, id)
						end
						state.stage, state.phase = 5, "Intermission"
						for chapter = 6, 8 do
							Session.beginStage(state)
							t.expect(state.stage).toBe(chapter)
							local plan = state.plan
							assert(plan, "Missing plan")
							t.expect(#plan.activities >= 8).toBe(true)
							t.expect((Session.act(state, 1, plan.activities[#plan.activities].id, 1, 0))).toBe(false)
							for _, spec in plan.activities do
								if spec.kind == "puzzle" then
									t.expect(#spec.order).toBe(4)
									Session.act(state, 1, spec.id, spec.order[1], 0)
									Session.act(state, 1, spec.id, spec.order[1], 1)
									t.expect(state.tasks[spec.id].progress).toBe(1)
									for step = 2, 4 do
										Session.act(state, 1, spec.id, spec.order[step], step)
									end
								else
									for _, button in spec.order do
										t.expect((Session.act(state, 1, spec.id, button, 0))).toBe(true)
									end
								end
							end
						end
						t.expect(state.phase).toBe("Extracting")
						for id = 1, players do
							Session.escape(state, id)
						end
						t.expect(state.phase).toBe("Won")
					end
				end
			end
		)
		t.it("the complete two-pursuer epilogue fits before the automatic lobby return", function()
			local captions = Cinema.captions
			assert(captions, "Epilogue captions missing")
			t.expect(#Cinema.shots).toBe(4)
			t.expect(Shots.duration(Cinema) + 8 < Config.Campaign.EndingSeconds).toBe(true)
			t.expect(string.find(captions[3], "Crocodilo Armadilho", 1, true) ~= nil).toBe(true)
			t.expect(string.find(captions[4], "A MANSÃO DO ARMADILHO", 1, true) ~= nil).toBe(true)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="532">
          <Properties>
            <string name="Name">ForestNavigation</string>
            <string name="Source"><![CDATA[--!strict
local TestKit = require("../TestKit")
return {
	name = "ForestNavigation",
	robloxOnly = true,
	run = function(t: TestKit.Context)
		t.it("forest objectives, shelters and rescue have walkable player and creature routes", function()
			local Builder = require("@game/ServerScriptService/Server/World/ForestBuilder")
			local HouseBuilder = require("@game/ServerScriptService/Server/World/HouseBuilder")
			local Plan = require("@game/ServerScriptService/Server/Campaign/ForestPlan")
			local fixture = Instance.new("Folder")
			fixture.Name, fixture.Parent = "ForestNavigationFixture", workspace
			local ok, failure = pcall(function()
				local world, features = HouseBuilder.build(fixture)
				local forest = Builder.build(world.root, 8, 42, features)
				local near, inner = 0, 0
				for _, tree in forest:GetDescendants() do
					if tree:IsA("BasePart") and tree:GetAttribute("NearTrail") == true then
						near += 1
						if math.abs(tree.Position.X) < 65 then
							inner += 1
						end
					end
				end
				t.expect(near >= 200).toBe(true)
				t.expect(inner >= 40).toBe(true)
				Builder.pressure(world.root, 0, 8, true)
				t.expect(world.root:GetAttribute("ForestBlackout")).toBe(true)
				for _, part in forest:GetChildren() do
					if part.Name == "TrailLantern" then
						local light = part:FindFirstChildWhichIsA("PointLight")
						assert(light and not light.Enabled, "Trail lamp ignores blackout")
					end
				end
				Builder.pressure(world.root, 7, 8, true)
				t.expect(world.root:GetAttribute("ForestBlackout")).toBe(false)
				local offset = Vector3.new(6000, 0, 0)
				for _, part in world.root:GetDescendants() do
					if part:IsA("BasePart") then
						part.CFrame += offset
					end
				end
				task.wait(2)
				local count = 0
				for id in features.lockers do
					if string.sub(id, 1, 12) == "hide_Forest_" then
						count += 1
					end
				end
				t.expect(count).toBe(6)
				for _, radius in { 1.2, 2 } do
					local function route(a: Vector3, b: Vector3)
						local path = game:GetService("PathfindingService")
							:CreatePath({ AgentRadius = radius, AgentHeight = 6, AgentCanJump = false })
						path:ComputeAsync(a + offset, b + offset)
						assert(
							path.Status == Enum.PathStatus.Success,
							`Forest route blocked: {a} -> {b}, radius={radius}`
						)
					end
					for chapter = 6, 8 do
						for _, spec in Plan.create(42, chapter, 2, "Story").activities do
							route(Vector3.new(0, 3, 580), Vector3.new(spec.x, 3, spec.z + 5))
						end
					end
					for id, locker in features.lockers do
						if string.sub(id, 1, 12) == "hide_Forest_" then
							route(Vector3.new(0, 3, 580), locker.front + Vector3.new(0, 3, 0))
						end
					end
					route(Vector3.new(0, 3, 580), Vector3.new(0, 3, 870))
				end
				t.expect(forest:FindFirstChild("RescueVan") ~= nil).toBe(true)
				Builder.clear(world.root, features)
				t.expect(world.root:FindFirstChild("Forest")).toBe(nil)
				t.expect(features.lockers.hide_Forest_1).toBe(nil)
			end)
			fixture:Destroy()
			if not ok then
				error(tostring(failure), 0)
			end
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="533">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local TestKit = require("../TestKit")

local function accepts(validator: Guard.Validator, value: any): boolean
	local ok = validator(value)
	return ok
end

local spec: TestKit.Spec = {
	name = "Guard",
	run = function(t)
		t.describe("number", function()
			t.it("accepts finite numbers", function()
				t.expect(accepts(Guard.number(), 1.5)).toBe(true)
			end)

			t.it("rejects non-numbers, NaN and infinity", function()
				t.expect(accepts(Guard.number(), "1")).toBe(false)
				t.expect(accepts(Guard.number(), 0 / 0)).toBe(false)
				t.expect(accepts(Guard.number(), math.huge)).toBe(false)
				t.expect(accepts(Guard.number(), -math.huge)).toBe(false)
			end)

			t.it("enforces min, max and integer", function()
				local validator = Guard.integer({ min = 1, max = 10 })
				t.expect(accepts(validator, 5)).toBe(true)
				t.expect(accepts(validator, 0)).toBe(false)
				t.expect(accepts(validator, 11)).toBe(false)
				t.expect(accepts(validator, 2.5)).toBe(false)
			end)
		end)

		t.describe("string", function()
			t.it("rejects invalid UTF-8", function()
				t.expect(accepts(Guard.string(), "\255")).toBe(false)
			end)

			t.it("applies a default max length", function()
				t.expect(accepts(Guard.string(), string.rep("a", 200))).toBe(true)
				t.expect(accepts(Guard.string(), string.rep("a", 201))).toBe(false)
			end)

			t.it("counts characters, not bytes", function()
				t.expect(accepts(Guard.string({ maxLength = 3 }), "ção")).toBe(true)
			end)

			t.it("enforces minLength and pattern", function()
				local validator = Guard.string({ minLength = 2, pattern = "%a+" })
				t.expect(accepts(validator, "ab")).toBe(true)
				t.expect(accepts(validator, "a")).toBe(false)
				t.expect(accepts(validator, "ab1")).toBe(false)
			end)
		end)

		t.describe("literal / optional / boolean", function()
			t.it("accepts only listed literals", function()
				local validator = Guard.literal("red", "blue")
				t.expect(accepts(validator, "red")).toBe(true)
				t.expect(accepts(validator, "green")).toBe(false)
			end)

			t.it("optional accepts nil", function()
				local validator = Guard.optional(Guard.boolean())
				t.expect(accepts(validator, nil)).toBe(true)
				t.expect(accepts(validator, true)).toBe(true)
				t.expect(accepts(validator, 1)).toBe(false)
			end)
		end)

		t.describe("array", function()
			t.it("accepts dense arrays of valid items", function()
				t.expect(accepts(Guard.array(Guard.number()), { 1, 2, 3 })).toBe(true)
			end)

			t.it("rejects holes, string keys, metatables, bad items and long arrays", function()
				local validator = Guard.array(Guard.number(), 2)
				local withHole: { any } = {}
				withHole[1] = 1
				withHole[3] = 3
				local mixed: { any } = { 1, "x" }
				t.expect(accepts(validator, withHole)).toBe(false)
				t.expect(accepts(validator, { a = 1 })).toBe(false)
				t.expect(accepts(validator, setmetatable({ 1 }, {}))).toBe(false)
				t.expect(accepts(validator, mixed)).toBe(false)
				t.expect(accepts(validator, { 1, 2, 3 })).toBe(false)
			end)
		end)

		t.describe("args", function()
			local validate = Guard.args({ Guard.string(), Guard.optional(Guard.number()) })

			t.it("accepts valid argument lists", function()
				t.expect((validate(table.pack("hi")))).toBe(true)
				t.expect((validate(table.pack("hi", 2)))).toBe(true)
			end)

			t.it("rejects extra arguments", function()
				local ok, reason = validate(table.pack("hi", 2, "extra"))
				t.expect(ok).toBe(false)
				t.expect(string.find(reason or "", "too many arguments", 1, true) ~= nil).toBe(true)
			end)

			t.it("reports which argument failed", function()
				local ok, reason = validate(table.pack(123))
				t.expect(ok).toBe(false)
				t.expect(string.find(reason or "", "arg #1", 1, true) ~= nil).toBe(true)
			end)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="534">
          <Properties>
            <string name="Name">HideRules</string>
            <string name="Source"><![CDATA[--!strict
local Config = require("@game/ReplicatedStorage/Shared/Config")
local HideRules = require("@game/ServerScriptService/Server/Game/HideRules")
local TestKit = require("../TestKit")

local H = Config.Hide

local function enter(overrides: { [string]: any }): HideRules.EnterContext
	local c: { [string]: any } = {
		playing = true,
		alive = true,
		occupied = false,
		alreadyHidden = false,
		sinceExit = math.huge,
	}
	for key, value in overrides do
		c[key] = value
	end
	return c :: any
end

local function found(overrides: { [string]: any }): HideRules.FoundContext
	local c: { [string]: any } = {
		sawEntry = false,
		creatureActive = true,
		distance = 30,
		holdingBreath = false,
		exposedTime = 0,
		captureRange = Config.Creature.CaptureRange,
	}
	for key, value in overrides do
		c[key] = value
	end
	return c :: any
end

local spec: TestKit.Spec = {
	name = "HideRules",
	run = function(t)
		t.it("validates entering", function()
			t.expect((HideRules.canEnter(enter({})))).toBe(true)
			local _, a = HideRules.canEnter(enter({ playing = false }))
			t.expect(a).toBe("not_playing")
			local _, b = HideRules.canEnter(enter({ occupied = true }))
			t.expect(b).toBe("hide_occupied")
			local _, c = HideRules.canEnter(enter({ alreadyHidden = true }))
			t.expect(c).toBe("not_available")
			local _, d = HideRules.canEnter(enter({ sinceExit = H.ExitCooldown * 0.5 }))
			t.expect(d).toBe("not_available")
		end)

		t.it("knows when the creature saw you enter", function()
			t.expect(HideRules.sawEntry(0.2, true)).toBe(true)
			t.expect(HideRules.sawEntry(H.SawEntryWindow + 0.1, true)).toBe(false)
			t.expect(HideRules.sawEntry(0, false)).toBe(false)
		end)

		t.it("seen entering = caught when it reaches the locker", function()
			t.expect(HideRules.found(found({ sawEntry = true, distance = 20 }))).toBe(false)
			t.expect(HideRules.found(found({ sawEntry = true, distance = 3 }))).toBe(true)
		end)

		t.it("not seen: safe while holding breath, found if breathing near for too long", function()
			t.expect(HideRules.found(found({ distance = 3, exposedTime = 0.5 }))).toBe(false)
			t.expect(HideRules.found(found({ distance = 3, exposedTime = H.NoticeTime }))).toBe(true)
			t.expect(HideRules.found(found({ distance = 3, exposedTime = 99, holdingBreath = true }))).toBe(false)
			t.expect(HideRules.found(found({ distance = 3, exposedTime = 99, creatureActive = false }))).toBe(false)
		end)

		t.it("exposure accumulates only when near and breathing", function()
			t.expect(HideRules.exposure(1, 3, false, 0.5)).toBe(1.5)
			t.expect(HideRules.exposure(1, 3, true, 0.5)).toBe(1)
			t.expect(HideRules.exposure(1, H.NoticeRange + 1, false, 0.5)).toBe(0)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="535">
          <Properties>
            <string name="Name">HouseAccess</string>
            <string name="Source"><![CDATA[--!strict
local TestKit = require("../TestKit")
return {
	name = "HouseAccess",
	robloxOnly = true,
	run = function(t: TestKit.Context)
		t.it("sealed routes cannot be bypassed through rooms, stairs or the garden", function()
			local fixture = Instance.new("Folder")
			fixture.Parent = workspace
			fixture.Name = "AccessFixture"
			local ok, failure = pcall(function()
				local Builder = require("@game/ServerScriptService/Server/World/HouseBuilder")
				local Access = require("@game/ServerScriptService/Server/World/HouseAccess")
				local Estate = require("@game/ServerScriptService/Server/World/HouseLevelBuilder")
				local Level = require("@game/ServerScriptService/Server/Campaign/HouseLevelPlan")
				local world = Builder.build(fixture)
				Estate.build(world.root, Level.create(42, 1, "Standard"))
				local offset = Vector3.new(1800, 0, 0)
				for _, part in world.root:GetDescendants() do
					if part:IsA("BasePart") then
						part.CFrame += offset
					end
				end
				task.wait(1)
				local function route(a: Vector3, b: Vector3): boolean
					local path = game:GetService("PathfindingService")
						:CreatePath({ AgentRadius = 1.2, AgentHeight = 5, AgentCanJump = false })
					path:ComputeAsync(a + offset, b + offset)
					return path.Status == Enum.PathStatus.Success
				end
				t.expect(route(Vector3.new(0, 0, 2), Vector3.new(-26, 0, -68))).toBe(false)
				t.expect(route(Vector3.new(0, 0, 2), Vector3.new(0, 16, 2))).toBe(false)
				t.expect(route(Vector3.new(0, 0, 2), Vector3.new(0, -16, 2))).toBe(false)
				t.expect(route(Vector3.new(0, -16, 2), Vector3.new(-26, -16, -68))).toBe(false)
				t.expect(route(Vector3.new(58, 0, 77), Vector3.new(0, 0, 110))).toBe(false)
				local gates = world.root:FindFirstChild("MissionGates")
				assert(gates, "Missing gates")
				for _, gate in gates:GetChildren() do
					if gate:IsA("BasePart") then
						gate.CanCollide, gate.CanQuery = false, false
					end
				end
				Access.refresh(world.root)
				world.gate.model:PivotTo(world.gate.openPivot + offset)
				task.wait(1)
				t.expect(route(Vector3.new(0, 0, 2), Vector3.new(-26, 0, -68))).toBe(true)
				t.expect(route(Vector3.new(0, 0, 2), Vector3.new(0, 16, 2))).toBe(true)
				t.expect(route(Vector3.new(0, 0, 2), Vector3.new(0, -16, 2))).toBe(true)
				t.expect(route(Vector3.new(0, -16, 2), Vector3.new(-26, -16, -68))).toBe(true)
				t.expect(route(Vector3.new(58, 0, 77), Vector3.new(0, 0, 110))).toBe(true)
				local rays = RaycastParams.new()
				rays.FilterType = Enum.RaycastFilterType.Include
				rays.FilterDescendantsInstances = { world.root }
				rays.RespectCanCollide = true
				for _, x in { -102, -78, -54, -30, 0, 30, 54, 78, 102 } do
					for _, z in { 84, 92, 106, 124 } do
						assert(
							workspace:Raycast(Vector3.new(x, 1, z) + offset, Vector3.new(0, -2, 0), rays),
							`Missing forecourt floor {x}/{z}`
						)
					end
				end
				for _, y in { -12, 4, 20, 36 } do
					for _, z in { -80, -48, -16 } do
						for _, side in { -1, 1 } do
							assert(
								workspace:Raycast(
									Vector3.new(side * 42, y, z) + offset,
									Vector3.new(side * 6, 0, 0),
									rays
								),
								"Missing side wall"
							)
						end
					end
				end
			end)
			fixture:Destroy()
			assert(ok, tostring(failure))
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="536">
          <Properties>
            <string name="Name">HouseLayout</string>
            <string name="Source"><![CDATA[--!strict
local Layout = require("@game/ReplicatedStorage/Shared/Game/HouseLayout")
local Story = require("@game/ReplicatedStorage/Shared/Game/StoryCatalog")
local Broadcast = require("@game/ReplicatedStorage/Shared/Game/HouseBroadcast")
local Shots = require("@game/ReplicatedStorage/Shared/Game/CinematicShots")
local TestKit = require("../TestKit")
return {
	name = "HouseLayout",
	run = function(t: TestKit.Context)
		t.it("every traversable landing point has one slab; stairs have no intersecting slab", function()
			for _, y in Layout.Floors do
				local hole = Layout.opening(y)
				for x = -23.5, 44.5, 1 do
					for z = 12.5, 63.5, 1 do
						local hits = 0
						for _, rect in Layout.decks(y) do
							if x > rect.x0 and x < rect.x1 and z > rect.z0 and z < rect.z1 then
								hits += 1
							end
						end
						local opening = hole and x > hole.x0 and x < hole.x1 and z > hole.z0 and z < hole.z1
						t.expect(hits).toBe(if opening then 0 else 1)
					end
				end
			end
		end)
		t.it("all chapter captions fit their server window and have distinct camera beats", function()
			t.expect(#Broadcast).toBe(#Story.Chapters)
			for _, scene in Story.Scenes do
				t.expect(#scene.shots >= 2).toBe(true)
				t.expect(Shots.duration(scene)).toBe(Story.SceneSeconds)
			end
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="537">
          <Properties>
            <string name="Name">HouseLevelNavigation</string>
            <string name="Source"><![CDATA[--!strict
local TestKit = require("../TestKit")
return {
	name = "HouseLevelNavigation",
	robloxOnly = true,
	run = function(t: TestKit.Context)
		local Levels = require("@game/ServerScriptService/Server/Campaign/HouseLevelPlan")
		local Builder = require("@game/ServerScriptService/Server/World/HouseBuilder")
		local Estate = require("@game/ServerScriptService/Server/World/HouseLevelBuilder")
		local Plans = require("@game/ServerScriptService/Server/Campaign/HousePlan")
		local Activities = require("@game/ServerScriptService/Server/Campaign/HouseActivities")
		local Config = require("@game/ReplicatedStorage/Shared/Config")
		t.it("player and creature reach all outdoor tasks including the elevated lookout without jumping", function()
			local fixture = Instance.new("Folder")
			fixture.Name, fixture.Parent = "EstateNavigationFixture", workspace
			local ok, failure = pcall(function()
				local world = Builder.build(fixture)
				local offset = Vector3.new(1200, 0, 0)
				for _, seed in { 1, 2, 42 } do
					local level = Levels.create(seed, 3, "Standard")
					Estate.build(world.root, level)
					local built = Activities.build(world.root, Plans.create(seed, 3, 2, "Standard"), 8)
					-- Mantém a fixture afastada do mapa real e retorna antes da próxima reconstrução.
					for _, part in world.root:GetDescendants() do
						if part:IsA("BasePart") then
							part.CFrame += offset
						end
					end
					task.wait(1)
					for _, agent in
						{
							{ AgentRadius = 1.2, AgentHeight = 5, AgentCanJump = false },
							{
								AgentRadius = Config.Creature.AgentRadius,
								AgentHeight = Config.Creature.AgentHeight,
								AgentCanJump = false,
							},
						}
					do
						local stairsPath = game:GetService("PathfindingService"):CreatePath(agent)
						stairsPath:ComputeAsync(
							Vector3.new(level.stairSide * 26, 16, -80) + offset,
							Vector3.new(level.stairSide * 26, 32, -38) + offset
						)
						assert(stairsPath.Status == Enum.PathStatus.Success, "Blocked internal service stair")
						local usedStair = false
						for _, waypoint in stairsPath:GetWaypoints() do
							if waypoint.Position.Y > 21 and waypoint.Position.Y < 28 and waypoint.Position.Z < -50 then
								usedStair = true
							end
						end
						assert(usedStair, "Internal service stair was not traversed")
						for _, spot in level.spots do
							local path = game:GetService("PathfindingService"):CreatePath(agent)
							path:ComputeAsync(
								Vector3.new(0, 0, 80) + offset,
								Vector3.new(spot.x, spot.y, spot.z + 5) + offset
							)
							assert(
								path.Status == Enum.PathStatus.Success,
								`Blocked estate seed={seed} room={spot.room} height={agent.AgentHeight}`
							)
						end
					end
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Include
					params.FilterDescendantsInstances = { world.root }
					params.RespectCanCollide = true
					for _, spot in level.spots do
						local p = Vector3.new(spot.x, spot.y + 1, spot.z + 5) + offset
						assert(workspace:Raycast(p, -Vector3.yAxis * 2, params), `Missing estate floor: {spot.room}`)
					end
					for _, target in built.targets do
						t.expect(target.focus.CanQuery).toBe(true)
					end
					for _, part in world.root:GetDescendants() do
						if part:IsA("BasePart") then
							part.CFrame -= offset
						end
					end
				end
				Estate.build(world.root, Levels.create(42, 3, "Story"))
				local architecture = world.root:FindFirstChild("Architecture")
				assert(architecture, "Missing architecture")
				for _, wall in architecture:GetChildren() do
					if
						wall:IsA("BasePart")
						and (wall.Name == "RoomPartition" or wall:GetAttribute("LevelOriginalTransparency") ~= nil)
					then
						t.expect(wall.CanCollide and wall.CanQuery and wall.Transparency == 0).toBe(true)
					end
				end
				t.expect(world.root:GetAttribute("LevelEnvironment")).toBe("Interior")
				t.expect(#world.root:GetDescendants() < 4500).toBe(true)
			end)
			fixture:Destroy()
			assert(ok, tostring(failure))
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="538">
          <Properties>
            <string name="Name">HouseLevels</string>
            <string name="Source"><![CDATA[--!strict
local Levels = require("@game/ServerScriptService/Server/Campaign/HouseLevelPlan")
local Plan = require("@game/ServerScriptService/Server/Campaign/HousePlan")
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local TestKit = require("../TestKit")
return {
	name = "HouseLevels",
	run = function(t: TestKit.Context)
		t.it("story keeps all interior objectives and no randomized passages", function()
			for chapter = 1, 5 do
				local a, b = Levels.create(42, chapter, "Story"), Plan.create(42, chapter, 1, "Story")
				t.expect(a.outdoor).toBe(false)
				t.expect(a.serviceStair).toBe(false)
				t.expect(#a.passages).toBe(0)
				for _, spec in b.activities do
					t.expect(math.abs(spec.x) < 44).toBe(true)
				end
			end
		end)
		t.it("many seeds include a guaranteed outdoor level and reproducible passages/lookout", function()
			local variants: { [string]: boolean } = {}
			for seed = 1, 120 do
				local level = Levels.create(seed, 3, "Standard")
				t.expect(level).toEqual(Levels.create(seed, 3, "Standard"))
				t.expect(level.outdoor).toBe(true)
				t.expect(#level.passages >= 2 and #level.passages <= 16).toBe(true)
				variants[level.theme] = true
				for _, passage in level.passages do
					t.expect(passage.width >= 10 and passage.width <= 24).toBe(true)
				end
				local plan = Plan.create(seed, 3, 2, "Standard")
				t.expect((Plan.validate(plan))).toBe(true)
				plan.activities[1].x += 1
				t.expect((Plan.validate(plan))).toBe(false)
			end
			local count = 0
			for _ in variants do
				count += 1
			end
			t.expect(count).toBe(3)
		end)
		t.it("energy repair requires three ordered server actions and preserves completed steps", function()
			local s = Session.new(42, Config.Campaign, "Standard", true)
			Session.join(s, 1)
			s.stage = 1
			Session.beginStage(s)
			local plan = s.plan
			assert(plan, "Missing plan")
			for i = 1, 3 do
				Session.act(s, 1, plan.activities[i].id, 1, 0)
			end
			local repair = plan.activities[4]
			t.expect(repair.kind).toBe("repair")
			t.expect((Session.act(s, 1, repair.id, 3, 1))).toBe(false)
			Session.act(s, 1, repair.id, 1, 2)
			t.expect(s.tasks[repair.id].solved).toBe(false)
			t.expect((Session.act(s, 1, repair.id, 3, 3))).toBe(false)
			t.expect(s.tasks[repair.id].progress).toBe(1)
			Session.act(s, 1, repair.id, 2, 4)
			Session.act(s, 1, repair.id, 3, 5)
			t.expect(s.tasks[repair.id].solved).toBe(true)
			t.expect((Session.act(s, 1, repair.id, 3, 6))).toBe(false)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="539">
          <Properties>
            <string name="Name">HouseNavigation</string>
            <string name="Source"><![CDATA[--!strict
-- Rotas reais em fixture isolada; não muda o mapa da campanha em andamento.
local TestKit = require("../TestKit")
return {
	name = "HouseNavigation",
	robloxOnly = true,
	run = function(t: TestKit.Context)
		local Pathfinding = game:GetService("PathfindingService")
		local Builder = require("@game/ServerScriptService/Server/World/HouseBuilder")
		local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
		local Config = require("@game/ReplicatedStorage/Shared/Config")
		t.it("world exposes house contracts before any creature spawn", function()
			local World = require("@game/ServerScriptService/Server/Services/WorldService")
			t.expect(type(World.setHouseStage)).toBe("function")
			t.expect(type(World.houseEvent)).toBe("function")
		end)
		t.it("player and creature reach all floors rooms hiding exits and forest without jumping", function()
			local fixture = Instance.new("Folder")
			fixture.Name = "HouseNavigationFixture"
			fixture.Parent = workspace
			local ok, failure = pcall(function()
				local world, features = Builder.build(fixture)
				for _, door in world.doors do
					t.expect(math.abs(door.panel.Position.X) > 8).toBe(true)
				end
				local offset = Vector3.new(600, 0, 0)
				for _, part in world.root:GetDescendants() do
					if part:IsA("BasePart") then
						part.CFrame += offset
					end
				end
				local gates = world.root:FindFirstChild("MissionGates")
				assert(gates, "Missing house gates")
				for _, gate in gates:GetChildren() do
					if gate:IsA("BasePart") then
						gate.CanCollide, gate.CanQuery = false, false
					end
				end
				world.gate.model:PivotTo(world.gate.openPivot + offset)
				require("@game/ServerScriptService/Server/World/HouseAccess").refresh(world.root)
				-- Pathfinding não detecta uma casa visualmente aberta: medimos também a geometria física.
				local rays = RaycastParams.new()
				rays.FilterType = Enum.RaycastFilterType.Include
				rays.FilterDescendantsInstances = { world.root.Architecture }
				for _, y in { -16, 0, 16, 32 } do
					for _, x in { -7, 0, 7, 23, 42 } do
						for _, z in { 12.8, 17, 57, 62 } do
							local origin = Vector3.new(x, y + 0.6, z) + offset
							local floor = workspace:Raycast(origin, Vector3.new(0, -1.7, 0), rays)
							assert(floor, `Missing landing floor at {x}/{y}/{z}`)
						end
					end
					for _, z in { 18, 38, 61 } do
						for _, side in { -1, 1 } do
							for _, height in { 6, 15.6 } do
								local wall = workspace:Raycast(
									Vector3.new(side * 55, y + height, z) + offset,
									Vector3.new(-side * 55, 0, 0),
									rays
								)
								assert(wall, `Open stair facade at {y}/{z}/{height}`)
								local boundary = if side < 0 then -24 else 45
								assert(math.abs(wall.Position.X - offset.X - boundary) < 0.8, "Recessed exterior seam")
							end
						end
						local roof = workspace:Raycast(Vector3.new(0, y + 10, z) + offset, Vector3.new(0, 45, 0), rays)
						assert(roof, `Missing stair roof at {y}/{z}`)
					end
				end
				local Plans = require("@game/ServerScriptService/Server/Campaign/HousePlan")
				local overlap = OverlapParams.new()
				overlap.RespectCanCollide = true
				overlap.FilterType = Enum.RaycastFilterType.Include
				overlap.FilterDescendantsInstances = { world.root }
				for seed = 1, 20 do
					for chapter = 1, 5 do
						-- Exteriores têm piso/escada próprios, medidos na fixture HouseLevelNavigation.
						local Levels = require("@game/ServerScriptService/Server/Campaign/HouseLevelPlan")
						if Levels.create(seed, chapter, "Standard").outdoor then
							continue
						end
						local plan = Plans.create(seed, chapter, 1, "Standard")
						for _, spec in plan.activities do
							if spec.kind == "hide" or spec.kind == "breath" or spec.kind == "explore" then
								continue
							end
							local point = Vector3.new(spec.x, (spec.y or 0) + 3, spec.z) + offset
							local hits =
								workspace:GetPartBoundsInBox(CFrame.new(point), Vector3.new(1.4, 1, 1), overlap)
							assert(#hits == 0, `Obstructed item: seed={seed} chapter={chapter} task={spec.id}`)
							local approach = workspace:GetPartBoundsInBox(
								CFrame.new(point + Vector3.new(0, 0, 5)),
								Vector3.new(2.4, 5, 2.4),
								overlap
							)
							assert(#approach == 0, `Obstructed approach: seed={seed} chapter={chapter} task={spec.id}`)
						end
					end
				end
				task.wait(2)
				for _, agent in
					{
						{ AgentRadius = 1.2, AgentHeight = 5, AgentCanJump = false },
						{
							AgentRadius = Config.Creature.AgentRadius,
							AgentHeight = Config.Creature.AgentHeight,
							AgentCanJump = false,
						},
					}
				do
					for _, room in House.Rooms do
						local path = Pathfinding:CreatePath(agent)
						path:ComputeAsync(Vector3.new(0, 0, 70) + offset, Vector3.new(room.x, room.y, room.z) + offset)
						assert(
							path.Status == Enum.PathStatus.Success,
							`Blocked room {room.id} agentHeight={agent.AgentHeight}`
						)
					end
					for _, locker in features.lockers do
						local path = Pathfinding:CreatePath(agent)
						path:ComputeAsync(Vector3.new(0, 0, 2) + offset, locker.front + offset)
						assert(path.Status == Enum.PathStatus.Success, `Blocked hide exit {locker.id}`)
					end
					local escape = Pathfinding:CreatePath(agent)
					escape:ComputeAsync(Vector3.new(-26, -16, -68) + offset, Vector3.new(0, 0, 106) + offset)
					assert(escape.Status == Enum.PathStatus.Success, "Ritual to forest route blocked")
				end
				t.expect(#world.root:GetDescendants() < 4000).toBe(true)
			end)
			fixture:Destroy()
			assert(ok, tostring(failure))
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="540">
          <Properties>
            <string name="Name">HouseProgression</string>
            <string name="Source"><![CDATA[--!strict
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local TestKit = require("../TestKit")
return {
	name = "HouseProgression",
	run = function(t: TestKit.Context)
		t.it("checkpoint transition never evaluates the previous plan as chapter zero", function()
			local s = Session.new(42, Config.Campaign, "Standard", true)
			Session.join(s, 1)
			Session.beginStage(s)
			Session.eliminate(s, 1)
			t.expect(s.phase).toBe("Lost")
			Session.retryStage(s)
			t.expect(s.stage).toBe(0)
			t.expect(Session.taskReady(s, "task_1")).toBe(false)
			Session.beginStage(s)
			t.expect(Session.taskReady(s, "task_1")).toBe(true)
		end)
		t.it("challenge allows teammates to collect in parallel but never bypass prerequisites", function()
			local s = Session.new(42, Config.Campaign, "Standard", true)
			Session.join(s, 1)
			Session.join(s, 2)
			s.stage = 1
			Session.beginStage(s)
			t.expect(Session.taskReady(s, "task_3")).toBe(true)
			t.expect((Session.act(s, 2, "task_3", 1, 1))).toBe(true)
			t.expect((Session.act(s, 1, "task_4", 1, 2))).toBe(false)
			Session.act(s, 1, "task_1", 1, 3)
			Session.act(s, 2, "task_2", 1, 4)
			t.expect(Session.taskReady(s, "task_4")).toBe(true)
		end)
		t.it("story retains the authored order when the same objects are reachable", function()
			local s = Session.new(42, Config.Campaign, "Story", true)
			Session.join(s, 1)
			s.stage = 1
			Session.beginStage(s)
			t.expect(Session.taskReady(s, "task_3")).toBe(false)
			t.expect((Session.act(s, 1, "task_3", 1, 1))).toBe(false)
			Session.act(s, 1, "task_1", 1, 2)
			t.expect(Session.taskReady(s, "task_2")).toBe(true)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="541">
          <Properties>
            <string name="Name">InteractionPresentation</string>
            <string name="Source"><![CDATA[--!strict
local Rules = require("@game/ReplicatedStorage/Shared/Game/InteractionPresentation")
local TestKit = require("../TestKit")
return {
	name = "InteractionPresentation",
	run = function(t)
		t.it("inactive players cannot target or send gameplay requests", function()
			t.expect(Rules.allowed("Playing", nil)).toBe(true)
			t.expect(Rules.allowed("Playing", "Active")).toBe(true)
			for _, status in { "Downed", "Waiting", "Escaped" } do
				t.expect(Rules.allowed("Playing", status)).toBe(false)
			end
			t.expect(Rules.allowed("Lost", "Active")).toBe(false)
		end)
		t.it("solo locks use the key and alternative actions stay unavailable in coop", function()
			t.expect(Rules.prompt("ABRIR", "ENTREABRIR", true, false, false)).toBe("[E] TRANCADA")
			t.expect(Rules.prompt("ABRIR", "ENTREABRIR", true, true, false)).toBe("[E] DESTRANCAR")
			t.expect(Rules.prompt("ABRIR", "ENTREABRIR", false, false, false)).toBe("[E] ABRIR\n[Q] ENTREABRIR")
			t.expect(Rules.prompt("ABRIR", "ENTREABRIR", true, true, true)).toBe("[E] ABRIR")
		end)
		t.it("only approved item kinds receive pickup animation", function()
			for _, kind in { "Fuse", "Battery", "Key", "Tape" } do
				t.expect(Rules.pickup(kind)).toBe(true)
			end
			t.expect(Rules.pickup("BreakerWrong")).toBe(false)
			t.expect(Rules.pickup(nil)).toBe(false)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="542">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[--!strict
-- Sanidade da planta: pontos importantes dentro das salas, portas batendo com aberturas, saída além do portão.
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Layout = require("@game/ServerScriptService/Server/World/Layout")
local TestKit = require("../TestKit")
local WallMath = require("@game/ServerScriptService/Server/World/WallMath")

local function inside(p: Layout.Point): boolean
	return Layout.roomAt(p.x, p.z) ~= nil
end

local spec: TestKit.Spec = {
	name = "Layout",
	run = function(t)
		t.it("puts every fuse spot, note, patrol node and spawn inside a room", function()
			for id, spots in Layout.FuseSpots do
				t.expect(#spots >= 1).toBe(true)
				for index, p in spots do
					if not inside(p) then
						error(`fuse spot {id}#{index} is outside the building`)
					end
				end
			end
			for id, p in Layout.Notes do
				if not inside(p) then
					error(`note {id} is outside the building`)
				end
			end
			for index, p in Layout.PatrolNodes do
				if not inside(p) then
					error(`patrol node #{index} is outside the building`)
				end
			end
			for index, p in Layout.CreatureSpawns do
				if not inside(p) then
					error(`creature spawn #{index} is outside the building`)
				end
			end
		end)

		t.it("has a reachable standing point for every fuse spot, within interaction range", function()
			for id, spots in Layout.FuseSpots do
				local stands = Layout.FuseStands[id]
				t.expect(stands ~= nil and #stands == #spots).toBe(true)
				for index, spot in spots do
					local stand = stands[index]
					local dx, dz = spot.x - stand.x, spot.z - stand.z
					local eyeDy = spot.y - 4.5
					local distance = math.sqrt(dx * dx + dz * dz + eyeDy * eyeDy)
					if distance > Config.Game.InteractDistance or not inside(stand) then
						error(`stand {id}#{index} is {distance} studs away or outside`)
					end
				end
			end
			for id, stand in Layout.Stands do
				if id ~= "gate" and not inside(stand) then
					error(`stand {id} is outside the building`)
				end
			end
		end)

		t.it("has one fuse spot list per fuse (3 fuses)", function()
			local count = 0
			for _ in Layout.FuseSpots do
				count += 1
			end
			t.expect(count).toBe(3)
		end)

		t.it("recognizes covered annex entries without treating the technical yard as indoors", function()
			t.expect(Layout.isIndoor(-54, -4)).toBe(true)
			t.expect(Layout.isIndoor(-54, -64)).toBe(true)
			t.expect(Layout.isIndoor(-20, -64)).toBe(true)
			t.expect(Layout.isIndoor(24, -64)).toBe(true)
			t.expect(Layout.isIndoor(-4, -9)).toBe(true)
			t.expect(Layout.isIndoor(56, -22)).toBe(false)
			t.expect(Layout.isIndoor(14, 34)).toBe(false)
			t.expect(Layout.isIndoor(-80, -64)).toBe(false)
		end)

		t.it("keeps all rooms within the compound without overlapping floor areas", function()
			for i, room in Layout.Rooms do
				t.expect(room.x1 > room.x0 and room.z1 > room.z0).toBe(true)
				t.expect(Layout.inRect(Layout.Compound, room.x0, room.z0)).toBe(true)
				t.expect(Layout.inRect(Layout.Compound, room.x1, room.z1)).toBe(true)
				for j = i + 1, #Layout.Rooms do
					local other = Layout.Rooms[j]
					local overlaps = math.min(room.x1, other.x1) > math.max(room.x0, other.x0)
						and math.min(room.z1, other.z1) > math.max(room.z0, other.z0)
					if overlaps then
						error(`overlapping rooms: {room.id}, {other.id}`)
					end
				end
			end
		end)

		t.it("gives every expansion area a patrol node and full-height access", function()
			for _, id in { "Maintenance", "CableGallery", "Control", "Archive", "Switchyard" } do
				local visited = false
				for _, p in Layout.PatrolNodes do
					local room = Layout.roomAt(p.x, p.z)
					visited = visited or (room ~= nil and room.id == id)
				end
				if not visited then
					error(`no patrol node in {id}`)
				end
			end
			for _, id in { "annexSouth", "gallerySouth", "controlWest", "archiveWest", "archiveEast" } do
				local wall = Layout.wallById(id) :: Layout.Wall
				local opening = wall.openings[1]
				t.expect(opening.bottom).toBe(0)
				t.expect(opening.top >= Config.Creature.AgentHeight).toBe(true)
				t.expect(opening.width >= Config.Creature.AgentRadius * 2 + 2).toBe(true)
			end
		end)

		t.it("keeps wall openings within the wall", function()
			for _, wall in Layout.Walls do
				for _, opening in wall.openings do
					local a = opening.center - opening.width / 2
					local b = opening.center + opening.width / 2
					if a < wall.from or b > wall.to then
						error(`opening at {opening.center} leaves wall {wall.id}`)
					end
				end
			end
		end)

		t.it("matches every door to a full-height opening on its wall", function()
			for _, door in Layout.Doors do
				local wall = Layout.wallById(door.wall)
				t.expect(wall).toBeTruthy()
				local found = false
				for _, opening in (wall :: Layout.Wall).openings do
					if opening.center == door.center and opening.bottom == 0 and opening.width == door.width then
						found = true
					end
				end
				if not found then
					error(`door {door.id} has no matching opening`)
				end
			end
		end)

		t.it("starts in the courtyard and exits beyond the gate", function()
			local s = Layout.Spawn.position
			t.expect(Layout.inRect(Layout.Courtyard, s.x, s.z)).toBe(true)
			t.expect(Layout.ExitZone.z0 > Layout.Gate.z).toBe(true)
			t.expect(Layout.ExitZone.x0 >= Layout.Gate.x - Layout.Gate.width / 2).toBe(true)
			t.expect(Layout.ExitZone.x1 <= Layout.Gate.x + Layout.Gate.width / 2).toBe(true)
		end)

		t.describe("WallMath", function()
			local openings = {
				{ center = 0, width = 6, bottom = 0, top = 9 },
				{ center = 10, width = 4, bottom = 3, top = 7 },
			}

			t.it("solid area + openings = whole wall", function()
				local segments = WallMath.solidSegments(-20, 20, 0, 11, openings)
				local holes = 6 * 9 + 4 * 4
				t.expect(WallMath.area(segments) + holes).toBeCloseTo(40 * 11)
			end)

			t.it("splitting into bands keeps the area", function()
				local segments = WallMath.solidSegments(-20, 20, 0, 11, openings)
				local lower, upper = WallMath.splitBands(segments, 3.2)
				t.expect(WallMath.area(lower) + WallMath.area(upper)).toBeCloseTo(WallMath.area(segments))
				for _, s in lower do
					t.expect(s.y1 <= 3.2 + 1e-6).toBe(true)
				end
			end)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="543">
          <Properties>
            <string name="Name">LightingProfile</string>
            <string name="Source"><![CDATA[--!strict
local P = require("@game/ReplicatedStorage/Shared/Game/LightingProfile")
local TestKit = require("../TestKit")
return {
	name = "LightingProfile",
	run = function(t)
		t.it("contains decorative fill without dimming clues or mission effects", function()
			local night, reach = P.fixture("NightLight", 0.75, 26)
			t.expect(night > 0 and night < 0.75).toBe(true)
			t.expect(reach).toBe(18)
			local _, short = P.fixture("NightLight", 0.75, 8)
			t.expect(short).toBe(8)
			local clue, clueRange = P.fixture("ObjectiveGlow", 2, 30)
			t.expect(clue).toBe(2)
			t.expect(clueRange).toBe(30)
		end)
		t.it("preserves bounded grade and visibility across interior/power blends", function()
			for i = -1, 11 do
				for j = -1, 11 do
					local grade = P.grade(i / 10, j / 10)
					for _, channel in grade.tint do
						t.expect(channel >= 0 and channel <= 255).toBe(true)
					end
					t.expect(grade.contrast >= 0 and grade.contrast <= 0.12).toBe(true)
					t.expect(P.exposure(i / 10, j / 10) >= 0.08).toBe(true)
				end
			end
		end)
		t.it("interiors get a warm fill without brightening the night or the forest", function()
			local outside = P.ambient(0, 0, 0)
			local inside = P.ambient(1, 0, 0)
			local forest = P.ambient(1, 1, 1)
			for i = 1, 3 do
				t.expect(inside[i] >= outside[i]).toBe(true)
				t.expect(forest[i]).toBeCloseTo(P.Forest.ambient[i])
				t.expect(inside[i] <= 64).toBe(true)
			end
			-- Quente: vermelho acima do azul dentro de casa.
			t.expect(inside[1] > inside[3]).toBe(true)
			t.expect(P.ambient(0, 0, 0)[3]).toBe(P.World.ambient[3])
		end)
		t.it("fog recovers fully and never extends a shorter existing visibility cap", function()
			t.expect(P.fogEnd(142, 0)).toBe(142)
			t.expect(P.fogEnd(142, 1)).toBe(64)
			t.expect(P.fogEnd(40, 1)).toBe(40)
			t.expect(P.fogEnd(142, -3)).toBe(142)
			t.expect(P.fogEnd(142, 3)).toBe(64)
		end)
		t.it("adaptation does not depend on frame rate or overshoot", function()
			local fast, slow = 0, 0
			for _ = 1, 120 do
				fast = P.approach(fast, 1, 1 / 120)
			end
			for _ = 1, 12 do
				slow = P.approach(slow, 1, 1 / 12)
			end
			t.expect(fast).toBeCloseTo(slow)
			t.expect(P.approach(0.4, 1, -1)).toBe(0.4)
			t.expect(P.approach(0, 1, 100) <= 1).toBe(true)
		end)
		t.it("shadow budget excludes disabled, distant and out-of-range lights", function()
			local chosen = P.selectShadows({
				{ id = "off", enabled = false, distance = 0, range = 20 },
				{ id = "far", enabled = true, distance = 70, range = 80 },
				{ id = "range", enabled = true, distance = 40, range = 5 },
				{ id = "a", enabled = true, distance = 5, range = 20 },
				{ id = "b", enabled = true, distance = 8, range = 20 },
				{ id = "c", enabled = true, distance = 9, range = 20 },
			}, 2)
			t.expect(chosen).toEqual({ a = true, b = true })
			t.expect(P.selectShadows({}, 2)).toEqual({})
			t.expect(P.shadowBudget(2)).toBe(0)
			t.expect(P.shadowBudget(0)).toBe(2)
		end)
		t.it("comfort mode keeps every fixture steady", function()
			for tick = 0, 100 do
				t.expect(P.flicker(tick / 10, 4, true, false)).toBe(1)
				local value = P.flicker(tick / 10, 4, true, true)
				t.expect(value >= 0.48 and value <= 1).toBe(true)
			end
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="544">
          <Properties>
            <string name="Name">Loader</string>
            <string name="Source"><![CDATA[--!strict
local Loader = require("@game/ReplicatedStorage/Shared/Loader")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "Loader",
	run = function(t)
		t.it("runs every Init before any Start, in list order", function()
			local calls: { string } = {}
			local function module(name: string)
				return {
					Name = name,
					Init = function()
						table.insert(calls, name .. ".Init")
					end,
					Start = function()
						table.insert(calls, name .. ".Start")
					end,
				}
			end
			local count = Loader.boot({ module("A"), module("B"), { Name = "C" } }, { label = "Test" })
			t.expect(count).toBe(3)
			t.expect(calls).toEqual({ "A.Init", "B.Init", "A.Start", "B.Start" })
		end)

		t.it("fails with a clear message naming the phase and module", function()
			t.expect(function()
				Loader.boot({
					{
						Name = "Broken",
						Init = function()
							error("kaboom")
						end,
					},
				}, { label = "Test" })
			end).toThrow("[Test] Init failed in Broken")
		end)

		t.it("does not Start anything if an Init fails", function()
			local started = false
			local modules: { any } = {
				{
					Name = "Ok",
					Start = function()
						started = true
					end,
				},
				{
					Name = "Bad",
					Init = function()
						error("nope")
					end,
				},
			}
			pcall(Loader.boot, modules, { label = "Test" })
			t.expect(started).toBe(false)
		end)

		t.it("validates names and hooks", function()
			t.expect(function()
				Loader.boot({ { Init = function() end } }, { label = "Test" })
			end).toThrow('missing a non-empty string "Name"')
			t.expect(function()
				Loader.boot({ { Name = "X" }, { Name = "X" } }, { label = "Test" })
			end).toThrow('duplicate module name "X"')
			t.expect(function()
				Loader.boot({ { Name = "X", Start = 1 } }, { label = "Test" })
			end).toThrow("X.Start must be a function")
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="545">
          <Properties>
            <string name="Name">Logger</string>
            <string name="Source"><![CDATA[--!strict
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local TestKit = require("../TestKit")
local Types = require("@game/ReplicatedStorage/Shared/Types")

type Entry = { level: Types.LogLevel, line: string }

-- Captura a saída do Logger durante `body` e SEMPRE restaura o estado global
-- (no Studio o Logger é compartilhado com o jogo em execução).
local function capture(level: Types.LogLevel, body: () -> ()): { Entry }
	local entries: { Entry } = {}
	local previousLevel: Types.LogLevel = Logger.getLevel()
	Logger.setLevel(level)
	Logger.setSink(function(entryLevel: Types.LogLevel, line: string)
		table.insert(entries, { level = entryLevel, line = line })
	end)
	local ok, err = pcall(body :: () -> any)
	Logger.setSink(nil)
	Logger.setLevel(previousLevel)
	if not ok then
		error(err, 0)
	end
	return entries
end

local spec: TestKit.Spec = {
	name = "Logger",
	run = function(t)
		t.it("prefixes lines with the scope and formats arguments", function()
			local entries = capture("Debug", function()
				Logger.new("Server").info("boot OK (%d services)", 2)
			end)
			t.expect(#entries).toBe(1)
			t.expect(entries[1].line).toBe("[Server] boot OK (2 services)")
			t.expect(entries[1].level).toBe("Info")
		end)

		t.it("does not format when there are no extra arguments", function()
			local entries = capture("Debug", function()
				Logger.new("X").info("100% literal")
			end)
			t.expect(entries[1].line).toBe("[X] 100% literal")
		end)

		t.it("filters by minimum level", function()
			local entries = capture("Warn", function()
				local log = Logger.new("X")
				log.debug("hidden")
				log.info("hidden")
				log.warn("shown")
				log.error("shown too")
			end)
			t.expect(#entries).toBe(2)
			t.expect(entries[2].line).toBe("[X] ERROR: shown too")
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="546">
          <Properties>
            <string name="Name">MenuUi</string>
            <string name="Source"><![CDATA[--!strict
local Icons = require("@game/ReplicatedStorage/Client/UI/Icons")
local MenuLayout = require("@game/ReplicatedStorage/Client/UI/MenuLayout")
local TestKit = require("../TestKit")

-- Ícones que o menu remasterizado desenha; um nome faltando quebraria a tela em runtime.
local MENU_ICONS = {
	"Play",
	"Perks",
	"Store",
	"Season",
	"Daily",
	"Servers",
	"Friends",
	"Settings",
	"More",
	"Coin",
	"Gem",
	"Backpack",
	"House",
	"Tree",
	"Lock",
	"Check",
	"Star",
	"Plus",
	"Close",
	"Drum",
	"Chest",
	"Tape",
	"Battery",
	"Lungs",
	"Medkit",
	"Steps",
	"Heart",
	"Replay",
	"Key",
	"Fuse",
	"Pointer",
}

return {
	name = "MenuUi",
	run = function(t)
		t.it("every menu icon exists and stays inside the 12x12 grid", function()
			local known = {}
			for _, kind in Icons.kinds() do
				known[kind] = true
			end
			for _, kind in MENU_ICONS do
				t.expect(known[kind]).toBe(true)
				local runs = Icons.runs(kind)
				t.expect(#runs > 0).toBe(true)
				for _, run in runs do
					t.expect(run[1] >= 0 and run[1] + run[3] <= 12).toBe(true)
					t.expect(run[2] >= 0 and run[2] < 12).toBe(true)
					t.expect(run[3] >= 1).toBe(true)
				end
			end
		end)
		t.it("runs merge contiguous pixels into one segment", function()
			-- Linha 6 do "More": ".##..##..##." vira três trechos de 2 px.
			local row = {}
			for _, run in Icons.runs("More") do
				if run[2] == 5 then
					table.insert(row, run)
				end
			end
			t.expect(#row).toBe(3)
			t.expect(row[1][1]).toBe(1)
			t.expect(row[1][3]).toBe(2)
		end)
		t.it("desktop scales from 1280x720 and touch is always compact", function()
			local desktop = MenuLayout.mode(1920, 1080, false)
			t.expect(desktop.compact).toBe(false)
			t.expect(desktop.scale).toBe(1.5)
			t.expect(desktop.key).toBe("desktop")
			local phone = MenuLayout.mode(844, 390, true)
			t.expect(phone.compact).toBe(true)
			t.expect(phone.short).toBe(true)
			t.expect(phone.scale).toBe(1)
			local tablet = MenuLayout.mode(1024, 768, true)
			t.expect(tablet.compact).toBe(true)
			t.expect(tablet.short).toBe(false)
			t.expect(MenuLayout.mode(1366, 768, false).compact).toBe(false)
			t.expect(MenuLayout.mode(900, 700, false).compact).toBe(true)
		end)
		t.it("cards use two columns only when they fit", function()
			t.expect(MenuLayout.columns(900)).toBe(2)
			t.expect(MenuLayout.columns(619)).toBe(1)
		end)
		t.it("compact rail keeps four destinations plus MAIS", function()
			local items = { "play", "perks", "store", "season", "daily", "servers", "friends", "settings" }
			local visible, overflow = MenuLayout.split(items, true)
			t.expect(#visible).toBe(4)
			t.expect(#overflow).toBe(4)
			t.expect(visible[1]).toBe("play")
			t.expect(overflow[1]).toBe("daily")
			local all, none = MenuLayout.split(items, false)
			t.expect(#all).toBe(8)
			t.expect(#none).toBe(0)
		end)
		t.it("chapter states mark flawless, cleared and exactly one next", function()
			local states = MenuLayout.chapters({ [1] = true, [2] = true, [4] = true }, { [2] = true }, 8)
			t.expect(states[1]).toBe("cleared")
			t.expect(states[2]).toBe("flawless")
			t.expect(states[3]).toBe("next")
			t.expect(states[4]).toBe("cleared")
			t.expect(states[5]).toBe("open")
			local nexts = 0
			for _, state in states do
				if state == "next" then
					nexts += 1
				end
			end
			t.expect(nexts).toBe(1)
			local done = MenuLayout.chapters({ [1] = true, [2] = true }, {}, 2)
			t.expect(done[1]).toBe("cleared")
			t.expect(done[2]).toBe("cleared")
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="547">
          <Properties>
            <string name="Name">Objectives</string>
            <string name="Source"><![CDATA[--!strict
local Objectives = require("@game/ServerScriptService/Server/Game/Objectives")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "Objectives",
	run = function(t)
		t.it("starts at 'enter' and moves to 'fuses' after entering", function()
			local s = Objectives.new(3)
			t.expect(Objectives.objectiveKey(s)).toBe("enter")
			s.enteredBuilding = true
			t.expect(Objectives.objectiveKey(s)).toBe("fuses")
		end)

		t.it("collects each fuse only once", function()
			local s = Objectives.new(3)
			t.expect((Objectives.collect(s, "a"))).toBe(true)
			local again, reason = Objectives.collect(s, "a")
			t.expect(again).toBe(false)
			t.expect(reason).toBe("not_available")
			t.expect(Objectives.collectedCount(s)).toBe(1)
			t.expect(s.held).toBe(1)
		end)

		t.it("never collects more than the total", function()
			local s = Objectives.new(2)
			Objectives.collect(s, "a")
			Objectives.collect(s, "b")
			t.expect((Objectives.collect(s, "c"))).toBe(false)
			t.expect(Objectives.collectedCount(s)).toBe(2)
		end)

		t.it("panel requires held fuses and inserts all of them", function()
			local s = Objectives.new(3)
			local none, reason = Objectives.insert(s)
			t.expect(none).toBe(0)
			t.expect(reason).toBe("no_fuses")
			Objectives.collect(s, "a")
			Objectives.collect(s, "b")
			t.expect((Objectives.insert(s))).toBe(2)
			t.expect(s.held).toBe(0)
			t.expect(s.inserted).toBe(2)
			t.expect(Objectives.isPanelComplete(s)).toBe(false)
		end)

		t.it("power only turns on with a complete panel and the breakers, once", function()
			local s = Objectives.new(1)
			t.expect(Objectives.powerOn(s)).toBe(false)
			Objectives.collect(s, "a")
			Objectives.insert(s)
			-- Mudança intencional (polish): sem os disjuntores a energia não volta.
			t.expect(Objectives.powerOn(s)).toBe(false)
			t.expect(Objectives.solveBreakers(s)).toBe(true)
			t.expect(Objectives.powerOn(s)).toBe(true)
			t.expect(Objectives.powerOn(s)).toBe(false)
			t.expect(Objectives.objectiveKey(s)).toBe("escape")
			local again, reason = Objectives.insert(s)
			t.expect(again).toBe(0)
			t.expect(reason).toBe("already_powered")
		end)

		t.it("gate needs power, opens once, then the round can be won", function()
			local s = Objectives.new(1)
			local denied, reason = Objectives.openGate(s)
			t.expect(denied).toBe(false)
			t.expect(reason).toBe("no_power")
			Objectives.collect(s, "a")
			Objectives.insert(s)
			Objectives.solveBreakers(s)
			Objectives.powerOn(s)
			t.expect(Objectives.canWin(s)).toBe(false)
			t.expect((Objectives.openGate(s))).toBe(true)
			local twice, why = Objectives.openGate(s)
			t.expect(twice).toBe(false)
			t.expect(why).toBe("already_open")
			t.expect(Objectives.canWin(s)).toBe(true)
			t.expect(Objectives.objectiveKey(s)).toBe("run")
		end)

		t.it("asks to insert when all fuses are collected", function()
			local s = Objectives.new(2)
			s.enteredBuilding = true
			Objectives.collect(s, "a")
			Objectives.collect(s, "b")
			t.expect(Objectives.objectiveKey(s)).toBe("insert")
		end)

		t.it("asks for the breakers once the panel is full; they need all fuses", function()
			local s = Objectives.new(2)
			s.enteredBuilding = true
			local early, reason = Objectives.canUseBreakers(s)
			t.expect(early).toBe(false)
			t.expect(reason).toBe("need_fuses")
			t.expect(Objectives.solveBreakers(s)).toBe(false)
			Objectives.collect(s, "a")
			Objectives.collect(s, "b")
			Objectives.insert(s)
			t.expect(Objectives.objectiveKey(s)).toBe("breakers")
			t.expect(Objectives.solveBreakers(s)).toBe(true)
			t.expect(Objectives.solveBreakers(s)).toBe(false)
			local _, again = Objectives.canUseBreakers(s)
			t.expect(again).toBe("already_powered")
		end)

		t.it("key: taken once, opens exactly one locked door", function()
			local s = Objectives.new(1)
			local locked, reason = Objectives.useKey(s, "door_storage")
			t.expect(locked).toBe(false)
			t.expect(reason).toBe("door_locked")
			t.expect((Objectives.takeKey(s))).toBe(true)
			t.expect((Objectives.takeKey(s))).toBe(false)
			t.expect((Objectives.useKey(s, "door_storage"))).toBe(true)
			t.expect(s.hasKey).toBe(false)
			local _, why = Objectives.useKey(s, "door_storage")
			t.expect(why).toBe("already_unlocked")
			local _, other = Objectives.useKey(s, "door_office")
			t.expect(other).toBe("door_locked")
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="548">
          <Properties>
            <string name="Name">Perks</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local Schema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local TestKit = require("../TestKit")

local testSpec: TestKit.Spec = {
	name = "Perks",
	run = function(t)
		t.it("factors grow with level and never cross the design limits", function()
			t.expect(Perks.factor("bateria", 0)).toBeCloseTo(1)
			t.expect(Perks.factor("bateria", 5)).toBeCloseTo(1.75)
			t.expect(Perks.factor("folego", 5)).toBeCloseTo(1.75)
			t.expect(Perks.factor("socorro", 5)).toBeCloseTo(0.5)
			t.expect(Perks.factor("silencio", 5)).toBeCloseTo(0.6)
			t.expect(Perks.factor("bateria", 99)).toBeCloseTo(1.75)
			t.expect(Perks.factor("nada", 3)).toBe(1)
			for _, perk in Perks.List do
				t.expect(#perk.fichas).toBe(Perks.MAX_LEVEL)
				t.expect(#perk.creditos).toBe(Perks.MAX_LEVEL)
				-- Nenhum nível zera o resgate ou o barulho: o Vigia continua no jogo.
				t.expect(Perks.factor(perk.id, Perks.MAX_LEVEL) > 0.3).toBe(true)
			end
		end)
		t.it("upgrades charge the next level price and stop at max", function()
			local data = Schema.template()
			data.wallet.fichas = 10000
			local ok, err, level = Perks.upgrade(data, "bateria", "fichas")
			t.expect(ok).toBe(true)
			t.expect(err).toBeNil()
			t.expect(level).toBe(1)
			t.expect(data.wallet.fichas).toBe(10000 - 300)
			for _ = 2, 5 do
				t.expect((Perks.upgrade(data, "bateria", "fichas"))).toBe(true)
			end
			t.expect(Perks.level(data, "bateria")).toBe(5)
			local again, reason = Perks.upgrade(data, "bateria", "fichas")
			t.expect(again).toBe(false)
			t.expect(reason).toBe("perk_max")
			t.expect(Perks.nextCost("bateria", 5, "fichas")).toBeNil()
		end)
		t.it("refuses upgrades without money or unknown perks", function()
			local data = Schema.template()
			data.wallet.creditos = 10
			local ok, reason = Perks.upgrade(data, "folego", "creditos")
			t.expect(ok).toBe(false)
			t.expect(reason).toBe("store_poor")
			t.expect(data.wallet.creditos).toBe(10)
			t.expect((Perks.upgrade(data, "voar", "creditos"))).toBe(false)
		end)
		t.it("consumables: bundles, stock cap, consume and loadout", function()
			local data = Schema.template()
			data.wallet.fichas = 5000
			t.expect((Perks.buyConsumable(data, "pilha_extra", "fichas"))).toBe(true)
			t.expect(Perks.count(data, "pilha_extra")).toBe(3)
			-- Continuação só sai por Créditos/Robux.
			local ok, reason = Perks.buyConsumable(data, "continuar", "fichas")
			t.expect(ok).toBe(false)
			t.expect(reason).toBe("store_no_price")
			t.expect(Perks.inLoadout(data, "pilha_extra")).toBe(false)
			t.expect((Perks.setLoadout(data, "pilha_extra", true))).toBe(true)
			t.expect(Perks.inLoadout(data, "pilha_extra")).toBe(true)
			t.expect((Perks.setLoadout(data, "continuar", true))).toBe(false)
			t.expect(Perks.consume(data, "pilha_extra")).toBe(true)
			t.expect(Perks.count(data, "pilha_extra")).toBe(2)
			t.expect(Perks.consume(data, "segunda_chance")).toBe(false)
			t.expect(Perks.add(data, "pilha_extra", 500)).toBe(Perks.MAX_STOCK - 2)
			t.expect(Perks.count(data, "pilha_extra")).toBe(Perks.MAX_STOCK)
			t.expect(Perks.add(data, "inexistente", 3)).toBe(0)
		end)
		t.it("boosts stack in time and double run rewards only while active", function()
			local data = Schema.template()
			local now = 1000000
			Perks.addBoost(data, "fichas", 60, now)
			Perks.addBoost(data, "fichas", 60, now + 10)
			t.expect(data.boosts.fichasUntil).toBe(now + 7200)
			t.expect(Perks.boostActive(data, "fichas", now + 7199)).toBe(true)
			t.expect(Perks.boostActive(data, "xp", now)).toBe(false)
			local summary: Economy.RunSummary =
				{ won = false, escaped = false, stages = 1, fuses = 0, breakers = false, contributions = 0 }
			local base = Economy.runReward(summary, false)
			local boosted = Economy.recordRun(data, summary, false, now + 5)
			t.expect(boosted.fichas).toBe((base.fichas or 0) * 2)
			t.expect(boosted.xp).toBe(base.xp or 0)
			local later = Schema.template()
			later.boosts.fichasUntil = now
			t.expect(Economy.recordRun(later, summary, false, now + 1).fichas).toBe(base.fichas or 0)
		end)
		t.it("products grant consumables and timed boosts once per receipt", function()
			local data = Schema.template()
			local pack = StoreCatalog.ProductByKey.segunda_chance_3
			local ok, _, granted = Economy.grantProduct(data, pack, "r1", 50)
			t.expect(ok).toBe(true)
			t.expect(Perks.count(data, "segunda_chance")).toBe(3)
			t.expect(granted and granted.consumables and granted.consumables.segunda_chance).toBe(3)
			t.expect((Economy.grantProduct(data, pack, "r1", 50))).toBe(false)
			t.expect(Perks.count(data, "segunda_chance")).toBe(3)
			Economy.grantProduct(data, StoreCatalog.ProductByKey.bonus_duplo_3h, "r2", 100)
			t.expect(data.boosts.fichasUntil).toBe(100 + 180 * 60)
			t.expect(data.boosts.xpUntil).toBe(100 + 180 * 60)
			local kit = StoreCatalog.ProductByKey.kit_sobrevivente
			Economy.grantProduct(data, kit, "r3", 200)
			t.expect(Perks.count(data, "continuar")).toBe(2)
			-- Segunda compra do kit (uma por conta) vira só os Créditos.
			local before = Perks.count(data, "continuar")
			local _, message = Economy.grantProduct(data, kit, "r4", 300)
			t.expect(message).toBe("once_converted")
			t.expect(Perks.count(data, "continuar")).toBe(before)
		end)
		t.it("migration to v4 sanitizes perks, stock, loadout, boosts and story", function()
			local raw: any = Schema.template()
			raw.schemaVersion = 3
			raw.perks = { bateria = 9, folego = -2, silencio = 0 / 0, [5] = 3 }
			raw.consumables = { pilha_extra = 400, segunda_chance = "x" }
			raw.loadout = { pilha_extra = true, segunda_chance = "sim" }
			raw.boosts = "quebrado"
			raw.story = { cleared = { ["1"] = 123 }, flawless = 7 }
			local data = Schema.migrate(raw)
			t.expect(data.perks.bateria).toBe(5)
			t.expect(data.perks.folego).toBeNil()
			t.expect(data.perks.silencio).toBeNil()
			t.expect(data.consumables.pilha_extra).toBe(99)
			t.expect(data.consumables.segunda_chance).toBeNil()
			t.expect(data.loadout.pilha_extra).toBe(true)
			t.expect(data.loadout.segunda_chance).toBeNil()
			t.expect(data.boosts.fichasUntil).toBe(0)
			t.expect(data.story.cleared["1"]).toBe(123)
			t.expect((next(data.story.flawless))).toBeNil()
			local fresh = Schema.migrate(nil)
			t.expect(fresh.boosts.xpUntil).toBe(0)
			t.expect((next(fresh.perks))).toBeNil()
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
