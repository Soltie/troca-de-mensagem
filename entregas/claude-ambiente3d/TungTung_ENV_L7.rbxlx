        <Item class="ModuleScript" referent="572">
          <Properties>
            <string name="Name">TensionDirector</string>
            <string name="Source"><![CDATA[--!strict
local Config = require("@game/ReplicatedStorage/Shared/Config")
local TensionDirector = require("@game/ReplicatedStorage/Shared/Game/TensionDirector")
local TestKit = require("../TestKit")

local T = Config.Tension

local function ctx(overrides: { [string]: any }): TensionDirector.Context
	local c: { [string]: any } = {
		now = 0,
		playing = true,
		creatureActive = true,
		creatureMode = "Patrol",
		creatureDistance = 80,
		fear = 0.45,
		darkness = 1,
		zone = "Corridor",
		progress = 2,
		hidden = false,
	}
	for key, value in overrides do
		c[key] = value
	end
	return c :: any
end

-- Gerador que sempre "sorteia" o primeiro da lista e sempre dispara.
local function always(): number
	return 0
end

-- Roda o diretor de `from` até `to` segundos e devolve os eventos com o tempo.
local function simulate(
	d: TensionDirector.Director,
	from: number,
	to: number,
	base: { [string]: any }
): { { at: number, event: string } }
	local events: { { at: number, event: string } } = {}
	local now = from
	while now < to do
		local c = table.clone(base)
		c.now = now
		local decision = TensionDirector.step(d, ctx(c), T.TickInterval)
		if decision.event then
			table.insert(events, { at = now, event = decision.event })
		end
		now += T.TickInterval
	end
	return events
end

local testSpec: TestKit.Spec = {
	name = "TensionDirector",
	run = function(t)
		t.it("starts in anticipation and enters tension when the creature is near", function()
			local d = TensionDirector.new(always, 0)
			t.expect(d.state).toBe("Anticipation")
			local decision = TensionDirector.step(d, ctx({ now = 1, creatureDistance = 20 }), 0.25)
			t.expect(decision.state).toBe("Tension")
			t.expect(decision.changed).toBe(true)
		end)

		t.it("never fires during a chase and holds a recovery lull afterwards", function()
			local d = TensionDirector.new(always, 0)
			local during = simulate(d, 0, 30, { creatureMode = "Chase", creatureDistance = 10 })
			t.expect(#during).toBe(0)
			t.expect(d.state).toBe("Chase")
			local after = simulate(d, 30, 30 + T.RecoveryTime - 1, { creatureMode = "Patrol", creatureDistance = 90 })
			t.expect(#after).toBe(0)
			t.expect(d.state).toBe("Recovery")
			simulate(d, 30 + T.RecoveryTime, 30 + T.RecoveryTime + 1, { creatureDistance = 90 })
			t.expect(d.state).toBe("Anticipation")
		end)

		t.it("respects the minimum gap between events (no spam)", function()
			local d = TensionDirector.new(always, 0)
			local events = simulate(d, 0, 300, { creatureDistance = 90 })
			t.expect(#events > 0).toBe(true)
			local minGap = TensionDirector.gap(d, 2)
			for i = 2, #events do
				t.expect(events[i].at - events[i - 1].at >= minGap - 1e-6).toBe(true)
			end
		end)

		t.it("respects each event's own cooldown", function()
			local d = TensionDirector.new(always, 0)
			local events = simulate(d, 0, 600, { creatureDistance = 90 })
			local last: { [string]: number } = {}
			for _, e in events do
				local previous = last[e.event]
				if previous then
					t.expect(e.at - previous >= TensionDirector.EVENTS[e.event].cooldown - 1e-6).toBe(true)
				end
				last[e.event] = e.at
			end
		end)

		t.it("filters by zone, fear, darkness and progress", function()
			local d = TensionDirector.new(always, 0)
			-- Recepção iluminada, medo baixo, sem progresso: só eventos sem restrição.
			local c = ctx({ zone = "Lobby", fear = 0, darkness = 0, progress = 0, creatureDistance = 90 })
			t.expect(TensionDirector.eligible(d, "eyes", c)).toBe(false)
			t.expect(TensionDirector.eligible(d, "silhouette", c)).toBe(false)
			t.expect(TensionDirector.eligible(d, "false_alarm", c)).toBe(false)
			t.expect(TensionDirector.eligible(d, "flicker", c)).toBe(true)
			-- "vibrate" exige o Vigia perto (e o estado Tension).
			t.expect(TensionDirector.eligible(d, "vibrate", c)).toBe(false)
			local dark = ctx({ zone = "Storage", fear = 0.6, darkness = 1, progress = 2, creatureDistance = 90 })
			t.expect(TensionDirector.eligible(d, "eyes", dark)).toBe(true)
		end)

		t.it("does nothing while hidden or outside of play", function()
			local d = TensionDirector.new(always, 0)
			t.expect(#simulate(d, 0, 120, { hidden = true, creatureDistance = 90 })).toBe(0)
			t.expect(#simulate(d, 120, 240, { playing = false, creatureDistance = 90 })).toBe(0)
		end)

		t.it("silence-before events block the next one for longer", function()
			local d = TensionDirector.new(always, 0)
			d.cooldowns.flicker = math.huge
			d.cooldowns.distant_steps = math.huge
			d.cooldowns.radio_static = math.huge
			d.cooldowns.whisper = math.huge
			local decision = TensionDirector.step(d, ctx({ now = 100, creatureDistance = 90 }), 0.25)
			t.expect(decision.event).toBe("false_alarm")
			t.expect(decision.silence).toBe(true)
			t.expect(d.busyUntil).toBeCloseTo(100 + TensionDirector.EVENTS["false_alarm"].duration + T.SilenceBefore)
		end)

		t.it("logs state changes and events, bounded", function()
			local d = TensionDirector.new(always, 0)
			simulate(d, 0, 2000, { creatureDistance = 90 })
			t.expect(#d.log > 0).toBe(true)
			t.expect(#d.log <= 40).toBe(true)
			TensionDirector.notify(d, 2000, "awaken", 5)
			t.expect(d.busyUntil >= 2005).toBe(true)
			TensionDirector.reset(d, 2001)
			t.expect(d.state).toBe("Anticipation")
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="573">
          <Properties>
            <string name="Name">ThreatPresentation</string>
            <string name="Source"><![CDATA[--!strict
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local TestKit = require("../TestKit")

local testSpec: TestKit.Spec = {
	name = "ThreatPresentation",
	run = function(t)
		t.it("only active members receive playing effects", function()
			t.expect(Presentation.playing("Playing", "Active")).toBe(true)
			t.expect(Presentation.playing("Playing", nil)).toBe(true)
			for _, status in { "Waiting", "Downed", "Eliminated", "Escaped" } do
				t.expect(Presentation.playing("Playing", status)).toBe(false)
			end
			t.expect(Presentation.playing("Intro", "Active")).toBe(false)
		end)
		t.it("global chase only becomes personal chase for its target, including test IDs", function()
			t.expect(Presentation.mode("Chase", -2, -2, "Active")).toBe("Chase")
			t.expect(Presentation.mode("Chase", -2, -3, "Active")).toBe("Patrol")
			t.expect(Presentation.mode("Capture", 45, 46, "Active")).toBe("Patrol")
			t.expect(Presentation.mode("Chase", 0, 46, "Active")).toBe("Patrol")
			t.expect(Presentation.mode("Search", 0, 46, "Active")).toBe("Search")
		end)
		t.it("preserves solo fallback and silences inactive members", function()
			t.expect(Presentation.mode("Capture", nil, 99, nil)).toBe("Capture")
			t.expect(Presentation.mode("Chase", 99, 99, "Downed")).toBe("Dormant")
		end)
		t.it("capture is an individual edge, not a group defeat", function()
			t.expect(Presentation.captured("Active", "Downed", "Playing", "Playing")).toBe(true)
			t.expect(Presentation.captured("Downed", "Downed", "Playing", "Lost")).toBe(false)
			t.expect(Presentation.captured("Active", "Active", "Playing", "Lost")).toBe(false)
			t.expect(Presentation.captured(nil, "Downed", nil, "Playing")).toBe(false)
			t.expect(Presentation.captured("Downed", "Active", "Playing", "Playing")).toBe(false)
			t.expect(Presentation.captured("Active", "Downed", "Playing", "Playing")).toBe(true)
			t.expect(Presentation.captured(nil, nil, "Playing", "Lost")).toBe(true)
		end)
		t.it("comfort disables all optional screen effects even at maximum fear", function()
			local off = Presentation.effects(1, true, false, false)
			for _, key in { "vignette", "grain", "fog", "blur", "glitch" } do
				t.expect((off :: any)[key]).toBe(0)
			end
			t.expect(Presentation.effects(1, false, true, true).fear).toBe(0)
		end)
		t.it("panic starts above 0.8 and intensity is clamped", function()
			t.expect(Presentation.effects(0.8, true, true, true).blur).toBe(0)
			t.expect(Presentation.effects(2, true, true, true).fear).toBe(1)
			t.expect(Presentation.effects(0.9, true, true, true).blur > 0).toBe(true)
		end)
	end,
}
return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="574">
          <Properties>
            <string name="Name">TungTungClips</string>
            <string name="Source"><![CDATA[--!strict
local ClipCodec = require("@game/ReplicatedStorage/Client/Creature/ClipCodec")
local TungTungClips = require("@game/ReplicatedStorage/Client/Creature/TungTungClips")
local TestKit = require("../TestKit")

local EXPECTED = { walk = true, run = true, slash = true, strafe = true, sheath = true }

local testSpec: TestKit.Spec = {
	name = "TungTungClips",
	run = function(t)
		t.it("base64 decodes known bytes", function()
			local data = ClipCodec.base64Decode("TWFu")
			t.expect(buffer.len(data)).toBe(3)
			t.expect(buffer.tostring(data)).toBe("Man")
			t.expect(buffer.tostring(ClipCodec.base64Decode("TWE="))).toBe("Ma")
			t.expect(buffer.tostring(ClipCodec.base64Decode("TQ=="))).toBe("M")
		end)
		t.it("has every clip the creature uses", function()
			for name in EXPECTED do
				t.expect((TungTungClips.Clips :: any)[name] ~= nil).toBe(true)
			end
			t.expect(#TungTungClips.Bones).toBe(28)
		end)
		t.it("decodes unit quaternions for every bone and frame", function()
			for name, raw in TungTungClips.Clips :: any do
				local decoded = ClipCodec.decode(raw, TungTungClips.Bones, TungTungClips.PosRange)
				t.expect(decoded.frames).toBe(raw.frames)
				for frame = 1, decoded.frames do
					for bone = 1, decoded.boneCount do
						local x, y, z, w = ClipCodec.rotation(decoded, frame, bone)
						local norm = math.sqrt(x * x + y * y + z * z + w * w)
						if math.abs(norm - 1) > 0.002 then
							error(`{name} frame {frame} bone {bone} has norm {norm}`)
						end
					end
				end
			end
		end)
		t.it("loops wrap and one-shots clamp at the end", function()
			local walk = ClipCodec.decode(TungTungClips.Clips.walk, TungTungClips.Bones, TungTungClips.PosRange)
			local a, b, alpha = ClipCodec.locate(walk, walk.duration + 0.5 / walk.fps)
			t.expect(a).toBe(1)
			t.expect(b).toBe(2)
			t.expect(alpha).toBeCloseTo(0.5)
			local slash = ClipCodec.decode(TungTungClips.Clips.slash, TungTungClips.Bones, TungTungClips.PosRange)
			local last, next, _ = ClipCodec.locate(slash, 99)
			t.expect(last).toBe(slash.frames)
			t.expect(next).toBe(slash.frames)
		end)
		t.it("looping clips stay in place (root motion removed)", function()
			local hips = table.find(TungTungClips.Bones, "mixamorig:Hips") :: number
			for _, name in { "walk", "run", "strafe" } do
				local decoded = ClipCodec.decode((TungTungClips.Clips :: any)[name], TungTungClips.Bones, 16)
				local x1, _, z1 = ClipCodec.position(decoded, 1, hips)
				local x2, _, z2 = ClipCodec.position(decoded, decoded.frames, hips)
				t.expect(math.abs(x2 - x1) < 0.05).toBe(true)
				t.expect(math.abs(z2 - z1) < 0.05).toBe(true)
			end
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="575">
          <Properties>
            <string name="Name">VisualQuality</string>
            <string name="Source"><![CDATA[--!strict
local Quality = require("@game/ReplicatedStorage/Shared/Game/VisualQuality")
local Preferences = require("@game/ReplicatedStorage/Shared/Game/HousePreferences")
local Schema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local TestKit = require("../TestKit")
return {
	name = "VisualQuality",
	run = function(t)
		t.it("rejects fractional enums, infinity, NaN and unknown preference keys", function()
			for _, value in { -1, 0.1, 0.75, 2, math.huge, 0 / 0 } do
				t.expect(Preferences.valid("quality", value)).toBe(false)
			end
			t.expect(Preferences.valid("shaders", 0.5)).toBe(false)
			t.expect(Preferences.valid("unknown", 1)).toBe(false)
			for _, value in { 0, 0.25, 0.5, 1 } do
				t.expect(Preferences.valid("quality", value)).toBe(true)
			end
			t.expect(Preferences.sanitize({ quality = 0.75, shaders = 0.5, music = 0.75 })).toEqual({ music = 0.75 })
		end)
		t.it("migrates v5 while preserving progress, money, season and comfort", function()
			local data = Schema.migrate({
				schemaVersion = 5,
				wallet = { fichas = 123, creditos = 9 },
				season = { id = "s1", xp = 231, free = { [1] = true }, premium = {} },
				house = { cleared = { Story = 255 }, preferences = { flashes = 0, vhs = 0, master = 0.75 } },
			})
			t.expect(data.wallet.fichas).toBe(123)
			t.expect(data.season.xp).toBe(231)
			t.expect(data.house.cleared.Story).toBe(255)
			t.expect(data.house.preferences).toEqual({ flashes = 0, vhs = 0, master = 0.75, shaders = 1, quality = 0 })
			t.expect(
				Schema.migrate({ house = { preferences = { shaders = 0, quality = 1 } } }).house.preferences.shaders
			)
				.toBe(0)
		end)
		t.it("uses bounded budgets and a stable conservative automatic policy", function()
			t.expect(Quality.resolve(0, true, 0)).toBe(1)
			t.expect(Quality.resolve(0, false, 0)).toBe(2)
			t.expect(Quality.resolve(0, false, 2)).toBe(1)
			t.expect(Quality.resolve(0, true, 9)).toBe(3)
			for level = 1, 3 do
				local off, on = Quality.budget(level, false), Quality.budget(level, true)
				t.expect(off.shadows == 0 and off.particles == 0 and off.bloom == 0 and not off.depth).toBe(true)
				t.expect(on.shadows <= 3 and on.particles <= 1 and on.bloom <= 0.1).toBe(true)
				on.shadows = 99
				t.expect(Quality.budget(level, true).shadows <= 3).toBe(true)
			end
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="576">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!strict
local W = require("@game/ReplicatedStorage/Shared/Game/Weather")
local TestKit = require("../TestKit")
return {
	name = "Weather",
	run = function(t)
		t.it("rain stops under a roof and never vanishes outdoors on low quality", function()
			t.expect(W.rate(W.RainRate, 1, 0, 1)).toBe(0)
			t.expect(W.rate(W.RainRate, 0, 1, 1) > 0).toBe(true)
			t.expect(W.rate(W.RainRate, 1, 1, 1) > W.rate(W.RainRate, 0.45, 1, 1)).toBe(true)
			t.expect(W.rate(W.RainRate, 5, 3, 9)).toBe(math.floor(W.RainRate * 1.2 + 0.5))
		end)
		t.it("gusts stay in a gentle band", function()
			for i = 0, 2000 do
				local g = W.gust(i * 0.37)
				t.expect(g >= 0.74 and g <= 1.16).toBe(true)
			end
		end)
		t.it("indoor rain is quieter but still audible", function()
			t.expect(W.volume(0)).toBe(W.IndoorVolume)
			t.expect(W.volume(1)).toBe(1)
			t.expect(W.volume(-2) > 0).toBe(true)
		end)
		t.it("lightning is rare, thunder follows, flash is short and bounded", function()
			t.expect(W.strikeInterval(0) >= 35).toBe(true)
			t.expect(W.strikeInterval(1) <= 80).toBe(true)
			t.expect(W.thunderDelay(0.5) > 1).toBe(true)
			for i = -10, 100 do
				local f = W.flash(i / 100)
				t.expect(f >= 0 and f <= 1).toBe(true)
			end
			t.expect(W.flash(0.7)).toBe(0)
			t.expect(W.flash(0.01)).toBe(1)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="577">
        <Properties>
          <string name="Name">TestKit</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Mini framework de testes (sem dependências). Roda no Studio e no Lune.

	Um spec é um ModuleScript em Tests/Specs que retorna:
		return {
			name = "Guard",
			robloxOnly = false, -- true = usa APIs do Roblox; o runner do Lune pula
			run = function(t: TestKit.Context)
				t.describe("number", function()
					t.it("rejects NaN", function()
						t.expect((Guard.number())(0 / 0)).toBe(false)
					end)
				end)
			end,
		}

	Runners: Tests/Run.luau (Studio, via MCP) e scripts/test.luau (Lune).
]]

local TableUtil = require("@game/ReplicatedStorage/Shared/Util/TableUtil")

export type Expectation = {
	toBe: (expected: any) -> (),
	toEqual: (expected: any) -> (),
	toBeNil: () -> (),
	toBeTruthy: () -> (),
	toBeFalsy: () -> (),
	toBeCloseTo: (expected: number, epsilon: number?) -> (),
	-- O valor deve ser uma função que lança erro (opcionalmente contendo `substring`).
	toThrow: (substring: string?) -> (),
}

export type Context = {
	describe: (name: string, body: () -> ()) -> (),
	it: (name: string, body: () -> ()) -> (),
	expect: (value: any) -> Expectation,
}

export type Spec = {
	name: string,
	robloxOnly: boolean?,
	run: (t: Context) -> (),
}

export type Failure = {
	test: string,
	message: string,
}

export type Report = {
	passed: number,
	failed: number,
	skipped: number,
	failures: { Failure },
}

export type RunOptions = {
	includeRobloxOnly: boolean,
}

local function show(value: any): string
	if type(value) == "string" then
		return string.format("%q", value)
	end
	return tostring(value)
end

local function expect(value: any): Expectation
	return {
		toBe = function(expected: any)
			if value ~= expected then
				error(`expected {show(expected)}, got {show(value)}`, 2)
			end
		end,
		toEqual = function(expected: any)
			if not TableUtil.deepEqual(value, expected) then
				error(`expected deep equality with {show(expected)}, got {show(value)}`, 2)
			end
		end,
		toBeNil = function()
			if value ~= nil then
				error(`expected nil, got {show(value)}`, 2)
			end
		end,
		toBeTruthy = function()
			if not value then
				error(`expected truthy, got {show(value)}`, 2)
			end
		end,
		toBeFalsy = function()
			if value then
				error(`expected falsy, got {show(value)}`, 2)
			end
		end,
		toBeCloseTo = function(expected: number, epsilon: number?)
			if type(value) ~= "number" or math.abs(value - expected) > (epsilon or 1e-6) then
				error(`expected ~{expected}, got {show(value)}`, 2)
			end
		end,
		toThrow = function(substring: string?)
			if type(value) ~= "function" then
				error("toThrow expects a function", 2)
			end
			local ok, err = pcall(value)
			if ok then
				error("expected function to throw", 2)
			end
			if substring and not string.find(tostring(err), substring, 1, true) then
				error(`expected error containing {show(substring)}, got {show(tostring(err))}`, 2)
			end
		end,
	}
end

local TestKit = {}

function TestKit.run(specs: { Spec }, options: RunOptions): Report
	local report: Report = { passed = 0, failed = 0, skipped = 0, failures = {} }

	for _, spec in specs do
		if spec.robloxOnly and not options.includeRobloxOnly then
			report.skipped += 1
			continue
		end

		local path: { string } = { spec.name }
		local context: Context = {
			describe = function(name: string, body: () -> ())
				table.insert(path, name)
				body()
				table.remove(path)
			end,
			it = function(name: string, body: () -> ())
				local fullName = table.concat(path, " > ") .. " > " .. name
				local ok, err = pcall(body :: () -> any)
				if ok then
					report.passed += 1
				else
					report.failed += 1
					table.insert(report.failures, { test = fullName, message = tostring(err) })
				end
			end,
			expect = expect,
		}

		local ok, err = pcall(spec.run :: (Context) -> any, context)
		if not ok then
			report.failed += 1
			table.insert(report.failures, { test = `{spec.name} (spec body)`, message = tostring(err) })
		end
	end

	return report
end

function TestKit.format(report: Report): string
	local lines = {
		`[Tests] {report.passed} passed, {report.failed} failed, {report.skipped} skipped specs`,
	}
	for _, failure in report.failures do
		table.insert(lines, `  FAIL {failure.test}: {failure.message}`)
	end
	return table.concat(lines, "\n")
end

return TestKit
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
