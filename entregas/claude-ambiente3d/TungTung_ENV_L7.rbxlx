      <Item class="Script" referent="366">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">2</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Ponto de entrada ÚNICO do cliente: Script com RunContext = Client em ReplicatedStorage
	(recomendação oficial; ver docs/DECISIONS.md). Não use .client.luau em Starter*:
	lá o original E a cópia rodam. Adicione Controllers em ./Controllers e registre abaixo.
]]

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Loader = require("@game/ReplicatedStorage/Shared/Loader")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")

local log = Logger.new("Client")

-- A ordem importa: Init e Start são chamados exatamente nesta ordem.
-- { any }: cada Controller tem campos próprios; o Loader valida Name/Init/Start em runtime.
local controllers: { any } = {
	require("./Controllers/SettingsController"),
	require("./Controllers/TransitionController"),
	require("./Controllers/AudioController"),
	require("./Controllers/CharacterController"),
	require("./Controllers/CameraController"),
	require("./Controllers/CharacterAnimatorController"),
	require("./Controllers/BodyAudioController"),
	require("./Controllers/FlashlightController"),
	require("./Controllers/FearController"),
	require("./Controllers/LightingController"),
	require("./Controllers/RetroFxController"),
	require("./Controllers/WorldFxController"),
	require("./Controllers/RainController"),
	require("./Controllers/ArtController"),
	require("./Controllers/TensionController"),
	require("./Controllers/ScreenFxController"),
	require("./Controllers/ThreatFeedbackController"),
	require("./Controllers/CreatureVisualController"),
	require("./Controllers/GameUiController"),
	require("./Controllers/InteractionController"),
	require("./Controllers/HudController"),
	require("./Controllers/HapticsController"),
	require("./Controllers/CosmeticController"),
	require("./Controllers/StoreController"),
	require("./Controllers/CampaignController"),
	require("./Controllers/CoinController"),
	require("./Controllers/TouchControlsController"),
	require("./Controllers/SpectatorController"),
	require("./Controllers/CinematicController"),
	require("./Controllers/MainMenuController"),
	require("./Controllers/ContinueController"),
	require("./Controllers/StoryController"),
	require("./Controllers/TelevisionController"),
	require("./Controllers/TrailerController"), -- só age no Studio (gravação do trailer)
	require("./Controllers/UiFeedbackController"),
}

local count = Loader.boot(controllers, { label = "Client" })
log.info("boot OK (%d controllers)", count)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="367">
        <Properties>
          <string name="Name">Trailer</string>
        </Properties>
        <Item class="ModuleScript" referent="368">
          <Properties>
            <string name="Name">TrailerActors</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Atores do trailer (só cliente, só Studio; ver TrailerController).

	  Equipe  cópias do personagem local com lanterna na mão (luz própria, sem colisão) e poses
	          procedurais: andar, correr, parado, alcançar, ajoelhar e caído.
	  Vigia   o mesmo corpo low poly do jogo (Client/Creature/Rig) com as poses de Client/Creature/Poses,
	          trocadas a 12 quadros/s como no jogo (stop-motion).
	Tudo é local: ninguém mais vê, nada colide e nada vira regra de jogo.
]]

local Players = game:GetService("Players")

local Poses = require("../Creature/Poses")
local Rig = require("../Creature/Rig")

type Joint = Motor6D | AnimationConstraint

export type Member = {
	model: Model,
	root: BasePart,
	joints: { [string]: Joint },
	bases: { [Joint]: CFrame },
	lamp: Part,
	light: SpotLight,
	standHeight: number,
	floorToPivot: number,
}

export type Creature = {
	rig: Rig.Rig,
	frame: number,
	clock: number,
}

export type PoseName = "walk" | "run" | "idle" | "reach" | "kneel" | "downed"

local rad = math.rad
local TrailerActors = {}

local function readBase(joint: Joint): CFrame
	if joint:IsA("Motor6D") then
		return joint.C0
	end
	return if joint.Attachment0 then joint.Attachment0.CFrame else CFrame.identity
end

local function writeBase(joint: Joint, frame: CFrame)
	if joint:IsA("Motor6D") then
		joint.C0 = frame
	elseif joint.Attachment0 then
		joint.Attachment0.CFrame = frame
	end
end

local function setJoint(member: Member, name: string, rotation: CFrame)
	local joint = member.joints[name]
	if joint then
		writeBase(joint, member.bases[joint] * rotation)
	end
end

-- Cópia do personagem local, limpa de scripts e placas, com lanterna própria.
function TrailerActors.member(parent: Instance, shirt: Color3?): Member?
	local character = Players.LocalPlayer.Character
	if not character then
		return nil
	end
	local wasArchivable = character.Archivable
	character.Archivable = true
	local model = character:Clone()
	character.Archivable = wasArchivable
	if not model then
		return nil
	end
	model.Name = "TrailerMember"
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("BillboardGui") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.LocalTransparencyModifier = 0
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.PlatformStand = true
	end
	if shirt then
		for _, name in { "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm" } do
			local part = model:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				part.Color = shirt
			end
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	root.Transparency = 1
	local joints: { [string]: Joint } = {}
	local bases: { [Joint]: CFrame } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") or (d:IsA("AnimationConstraint") and d.Attachment0 and d.Attachment1) then
			joints[d.Name] = d :: Joint
			bases[d :: Joint] = readBase(d :: Joint)
		end
	end
	local lamp = Instance.new("Part")
	lamp.Name = "Lamp"
	lamp.Size = Vector3.new(0.24, 0.24, 0.7)
	lamp.Color = Color3.fromRGB(40, 42, 44)
	lamp.Material = Enum.Material.Metal
	lamp.Anchored = true
	lamp.CanCollide = false
	lamp.CanQuery = false
	lamp.CanTouch = false
	lamp.CastShadow = false
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Front
	light.Angle = 44
	light.Range = 42
	light.Brightness = 3.2
	light.Color = Color3.fromRGB(255, 232, 196)
	light.Shadows = true
	light.Parent = lamp
	lamp.Parent = model
	local hip = if humanoid then humanoid.HipHeight else 1.84
	model.Parent = parent
	return {
		model = model,
		root = root,
		joints = joints,
		bases = bases,
		lamp = lamp,
		light = light,
		standHeight = hip + root.Size.Y / 2,
		floorToPivot = hip + root.Size.Y / 2,
	}
end

--[[
	Põe o ator em `position` (no chão) olhando para `look`, na pose pedida.
	`phase` anda o ciclo das pernas (radianos); `pitch` (graus) mira a lanterna.
]]
function TrailerActors.pose(
	member: Member,
	position: Vector3,
	look: Vector3,
	name: PoseName,
	phase: number,
	pitch: number?
)
	local flat = Vector3.new(look.X - position.X, 0, look.Z - position.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local pivot = position + Vector3.new(0, member.standHeight, 0)
	member.root.CFrame = CFrame.lookAt(pivot, pivot + flat.Unit)
	for joint, base in member.bases do
		writeBase(joint, base)
	end
	local aim = pitch or 0
	local s = math.sin(phase)
	if name == "walk" or name == "run" then
		local amp = if name == "run" then 38 else 24
		setJoint(member, "LeftHip", CFrame.Angles(rad(amp * s), 0, 0))
		setJoint(member, "RightHip", CFrame.Angles(rad(-amp * s), 0, 0))
		setJoint(member, "LeftKnee", CFrame.Angles(rad(-math.max(0, -s) * amp * 1.4), 0, 0))
		setJoint(member, "RightKnee", CFrame.Angles(rad(-math.max(0, s) * amp * 1.4), 0, 0))
		setJoint(member, "LeftShoulder", CFrame.Angles(rad(-amp * 0.8 * s), 0, 0))
		setJoint(member, "Waist", CFrame.Angles(rad(if name == "run" then -14 else -4), rad(4 * s), 0))
		setJoint(member, "RightShoulder", CFrame.Angles(rad(68 + aim * 0.5), 0, rad(6)))
		setJoint(member, "RightElbow", CFrame.Angles(rad(-25), 0, 0))
		member.root.CFrame *= CFrame.new(0, math.abs(math.cos(phase)) * (if name == "run" then 0.25 else 0.12), 0)
	elseif name == "reach" then
		setJoint(member, "Waist", CFrame.Angles(rad(-10), 0, 0))
		setJoint(member, "LeftShoulder", CFrame.Angles(rad(85), 0, rad(-6)))
		setJoint(member, "LeftElbow", CFrame.Angles(rad(-10), 0, 0))
		setJoint(member, "RightShoulder", CFrame.Angles(rad(60 + aim * 0.5), 0, rad(6)))
		setJoint(member, "RightElbow", CFrame.Angles(rad(-30), 0, 0))
	elseif name == "kneel" then
		local thigh = 0.88
		setJoint(member, "Root", CFrame.new(0, -thigh, 0))
		setJoint(member, "Waist", CFrame.Angles(rad(-24), 0, 0))
		setJoint(member, "Neck", CFrame.Angles(rad(-22), 0, 0))
		setJoint(member, "LeftHip", CFrame.Angles(rad(85), 0, 0))
		setJoint(member, "LeftKnee", CFrame.Angles(rad(-85), 0, 0))
		setJoint(member, "RightHip", CFrame.Angles(rad(-4), 0, 0))
		setJoint(member, "RightKnee", CFrame.Angles(rad(-88), 0, 0))
		setJoint(member, "RightAnkle", CFrame.Angles(rad(30), 0, 0))
		setJoint(member, "LeftShoulder", CFrame.Angles(rad(55), 0, 0))
		setJoint(member, "RightShoulder", CFrame.Angles(rad(40 + aim * 0.5), 0, 0))
	elseif name == "downed" then
		local drop = member.standHeight - 0.95
		setJoint(member, "Root", CFrame.new(0, -drop, 0) * CFrame.Angles(rad(-8), 0, rad(84)))
		setJoint(member, "Neck", CFrame.Angles(rad(-18), rad(20), 0))
		setJoint(member, "LeftHip", CFrame.Angles(rad(35), 0, 0))
		setJoint(member, "LeftKnee", CFrame.Angles(rad(-55), 0, 0))
		setJoint(member, "RightHip", CFrame.Angles(rad(12), 0, 0))
		setJoint(member, "RightKnee", CFrame.Angles(rad(-25), 0, 0))
		setJoint(member, "RightShoulder", CFrame.Angles(rad(70), 0, 0))
	else
		setJoint(member, "RightShoulder", CFrame.Angles(rad(66 + aim * 0.5), 0, rad(6)))
		setJoint(member, "RightElbow", CFrame.Angles(rad(-28), 0, 0))
		setJoint(member, "Waist", CFrame.Angles(rad(2 * math.sin(phase * 0.3)), 0, 0))
	end
end

-- Lanterna na mão direita, apontando para onde o corpo olha (+ pitch). Chame depois de pose().
function TrailerActors.placeLamp(member: Member, pitch: number?, on: boolean?)
	local hand = member.model:FindFirstChild("RightHand")
	local origin = if hand and hand:IsA("BasePart") then hand.Position else member.root.Position
	member.lamp.CFrame = CFrame.new(origin)
		* member.root.CFrame.Rotation
		* CFrame.Angles(rad(pitch or -4), 0, 0)
		* CFrame.new(0, -0.05, -0.3)
	member.light.Enabled = on ~= false
	member.lamp.Transparency = 0
end

function TrailerActors.hide(member: Member)
	member.root.CFrame = CFrame.new(0, -500, 0)
	member.light.Enabled = false
end

-- O Vigia do trailer (mesmo corpo e rosto do jogo).
function TrailerActors.creature(parent: Instance): Creature
	local rig = Rig.build(parent)
	rig.model.Name = "TrailerVigia"
	rig.eyeLight.Range = 9
	return { rig = rig, frame = 1, clock = 0 }
end

-- Pose do Vigia em `position` (pés no chão) olhando para `look`. Troca de quadro a `rate` poses/s.
function TrailerActors.creaturePose(
	creature: Creature,
	position: Vector3,
	look: Vector3,
	animation: string,
	dt: number,
	rate: number,
	headYaw: number?
)
	local frames = (Poses :: any)[animation] or Poses.Idle
	creature.clock += dt
	if creature.clock >= 1 / rate then
		creature.clock = 0
		creature.frame = creature.frame % #frames + 1
	end
	local index = math.clamp(creature.frame, 1, #frames)
	local flat = Vector3.new(look.X - position.X, 0, look.Z - position.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local base = CFrame.lookAt(position, position + flat.Unit)
	local cframes = Rig.solve(creature.rig, base, frames[index], headYaw or 0)
	workspace:BulkMoveTo(creature.rig.order, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

function TrailerActors.hideCreature(creature: Creature)
	local base = CFrame.new(0, -500, 0)
	local cframes = Rig.solve(creature.rig, base, Poses.Idle[1], 0)
	workspace:BulkMoveTo(creature.rig.order, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

return TrailerActors
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="369">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="370">
          <Properties>
            <string name="Name">Components</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Componentes reutilizáveis da remaster "Cursed Mansion" (docs/ui-remaster).
	Só apresentação: nenhum componente chama remotes nem decide preço, posse ou recompensa.

	  text / title            rótulos com a tipografia do tema
	  panel                   cartão com canto, contorno sutil e fundo do tema
	  button(variant, ...)    primary | secondary | ghost | success | danger, com hover/pressão/desabilitado
	  icon / iconButton       pictogramas pixel-art (Icons.pixel) e botão com ícone
	  currency                selo de Fichas/Créditos com setter reativo
	  progress                barra de progresso com setter
	  chip                    etiqueta curta de estado (raridade, voto, equipado...)
]]

local Create = require("./Create")
local Icons = require("./Icons")
local Theme = require("./Theme")

export type Variant = "primary" | "secondary" | "ghost" | "success" | "danger"

type Palette = { bg: Color3, text: Color3, stroke: Color3, hover: Color3, bgTransparency: number }

local Components = {}

local PALETTES: { [string]: Palette } = {
	primary = {
		bg = Theme.Gold,
		text = Theme.Bg,
		stroke = Theme.GoldLight,
		hover = Theme.GoldLight,
		bgTransparency = 0,
	},
	secondary = {
		bg = Theme.BgElevated,
		text = Theme.TextPrimary,
		stroke = Theme.Border,
		hover = Theme.BgElevated:Lerp(Theme.Gold, 0.18),
		bgTransparency = 0,
	},
	ghost = {
		bg = Theme.BgElevated,
		text = Theme.TextSecondary,
		stroke = Theme.Border,
		hover = Theme.BgElevated,
		bgTransparency = 1,
	},
	success = {
		bg = Theme.Success:Lerp(Theme.Bg, 0.55),
		text = Theme.TextPrimary,
		stroke = Theme.Success,
		hover = Theme.Success:Lerp(Theme.Bg, 0.4),
		bgTransparency = 0,
	},
	danger = {
		bg = Theme.Danger,
		text = Theme.TextPrimary,
		stroke = Theme.Danger:Lerp(Theme.TextPrimary, 0.3),
		hover = Theme.Danger:Lerp(Theme.TextPrimary, 0.12),
		bgTransparency = 0,
	},
}

local DISABLED: Palette = {
	bg = Theme.BgSunken,
	text = Theme.TextMuted,
	stroke = Theme.Border,
	hover = Theme.BgSunken,
	bgTransparency = 0.1,
}

local function merge(base: { [string]: any }, props: { [string]: any }?): { [string]: any }
	if props then
		for key, value in props do
			base[key] = value
		end
	end
	return base
end

function Components.formatNumber(value: number): string
	local s = tostring(math.floor(value))
	local negative = s:sub(1, 1) == "-"
	if negative then
		s = s:sub(2)
	end
	local result = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if result:sub(1, 1) == "." then
		result = result:sub(2)
	end
	return if negative then "-" .. result else result
end

function Components.corner(parent: Instance, radius: UDim?): UICorner
	return Create("UICorner", { CornerRadius = radius or Theme.Corner, Parent = parent }) :: UICorner
end

function Components.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Create("UIStroke", {
		Color = color or Theme.Border,
		Thickness = thickness or 1,
		Transparency = transparency or 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	}) :: UIStroke
end

function Components.padding(parent: Instance, x: number, y: number?): UIPadding
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
		Parent = parent,
	}) :: UIPadding
end

function Components.text(props: { [string]: any }): TextLabel
	return Create(
		"TextLabel",
		merge({
			BackgroundTransparency = 1,
			FontFace = Theme.FontBody,
			TextColor3 = Theme.TextPrimary,
			TextSize = Theme.SizeBody,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextWrapped = true,
		}, props)
	) :: TextLabel
end

function Components.title(props: { [string]: any }): TextLabel
	return Components.text(merge({ FontFace = Theme.Font, TextSize = Theme.SizeLarge, TextWrapped = false }, props))
end

function Components.panel(props: { [string]: any }?, children: { any }?): Frame
	local panel = Create(
		"Frame",
		merge({ BackgroundColor3 = Theme.BgPanel, BackgroundTransparency = 0.08, BorderSizePixel = 0 }, props),
		children
	) :: Frame
	Components.corner(panel)
	Components.stroke(panel, Theme.Border, 1, 0.55)
	return panel
end

-- Pinta o botão conforme variante e estado. "disabled" ignora cliques (atributo Disabled).
local function paint(button: TextButton, hovered: boolean?)
	local disabled = button:GetAttribute("Disabled") == true
	local variant = tostring(button:GetAttribute("Variant") or "secondary")
	local palette = if disabled then DISABLED else PALETTES[variant] or PALETTES.secondary
	button.BackgroundColor3 = if hovered and not disabled then palette.hover else palette.bg
	button.BackgroundTransparency = if hovered
			and not disabled
			and variant == "ghost"
		then 0.4
		else palette.bgTransparency
	button.TextColor3 = palette.text
	local outline = button:FindFirstChild("Outline")
	if outline and outline:IsA("UIStroke") then
		outline.Color = palette.stroke
		outline.Transparency = if variant == "ghost" and not hovered then 1 else 0.2
	end
	local icon = button:FindFirstChild("IconSlot")
	if icon then
		local holder = icon:FindFirstChildWhichIsA("Frame")
		if holder then
			Icons.tint(holder, palette.text)
		end
	end
end

function Components.setVariant(button: TextButton, variant: Variant)
	button:SetAttribute("Variant", variant)
	paint(button)
end

function Components.setDisabled(button: TextButton, disabled: boolean)
	button:SetAttribute("Disabled", disabled)
	button.Active = not disabled
	paint(button)
end

function Components.button(variant: Variant, props: { [string]: any }, onActivate: (() -> ())?): TextButton
	local button = Create(
		"TextButton",
		merge({
			AutoButtonColor = false,
			BorderSizePixel = 0,
			FontFace = Theme.Font,
			TextSize = Theme.SizeBody,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		}, props)
	) :: TextButton
	button:SetAttribute("Variant", variant)
	Components.corner(button, Theme.CornerSmall)
	local outline = Components.stroke(button, nil, 1, 0.2)
	outline.Name = "Outline"
	local scale = Create("UIScale", { Name = "PressScale", Parent = button }) :: UIScale
	button.MouseEnter:Connect(function()
		paint(button, true)
	end)
	button.MouseLeave:Connect(function()
		paint(button, false)
		scale.Scale = 1
	end)
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			scale.Scale = 0.97
		end
	end)
	button.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	if onActivate then
		button.Activated:Connect(function()
			if button:GetAttribute("Disabled") ~= true then
				onActivate()
			end
		end)
	end
	paint(button)
	return button
end

-- Ícone pixel-art num quadrado `size` (múltiplo de 12 deixa os pixels nítidos).
function Components.icon(parent: Instance, kind: string, size: number, color: Color3, props: { [string]: any }?): Frame
	local slot = Create(
		"Frame",
		merge({
			Name = "IconSlot",
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
		}, props)
	) :: Frame
	Icons.pixel(slot, kind, color)
	slot.Parent = parent
	return slot
end

-- Botão com ícone à esquerda e rótulo; sem rótulo vira botão só de ícone centralizado.
function Components.iconButton(
	variant: Variant,
	kind: string,
	text: string?,
	props: { [string]: any },
	onActivate: (() -> ())?
): TextButton
	local iconSize = (props.IconSize :: number?) or 24
	props.IconSize = nil
	local button = Components.button(variant, merge({ Text = "" }, props), onActivate)
	local hasText = text ~= nil and text ~= ""
	Components.icon(button, kind, iconSize, button.TextColor3, {
		AnchorPoint = if hasText then Vector2.new(0, 0.5) else Vector2.new(0.5, 0.5),
		Position = if hasText then UDim2.new(0, 14, 0.5, 0) else UDim2.fromScale(0.5, 0.5),
	})
	if hasText then
		Components.text({
			Name = "Label",
			Position = UDim2.fromOffset(iconSize + 24, 0),
			Size = UDim2.new(1, -(iconSize + 34), 1, 0),
			FontFace = button.FontFace,
			TextSize = button.TextSize,
			TextColor3 = button.TextColor3,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = text,
			Parent = button,
		})
		-- O rótulo acompanha a cor do texto do botão (estados).
		local label = button:FindFirstChild("Label") :: TextLabel
		button:GetPropertyChangedSignal("TextColor3"):Connect(function()
			label.TextColor3 = button.TextColor3
		end)
	end
	paint(button)
	return button
end

-- Selo de moeda. Retorna o quadro e um setter (valor já formatado com separador de milhar).
function Components.currency(kind: "fichas" | "creditos", props: { [string]: any }?): (Frame, (number) -> ())
	local fichas = kind == "fichas"
	local badge = Create(
		"Frame",
		merge({
			Name = if fichas then "Fichas" else "Creditos",
			Size = UDim2.fromOffset(132, 36),
			BackgroundColor3 = Theme.BgSunken,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
		}, props)
	) :: Frame
	Components.corner(badge, Theme.CornerPill)
	Components.stroke(badge, if fichas then Theme.Gold else Theme.Info, 1, 0.5)
	Components.icon(badge, if fichas then "Coin" else "Gem", 24, if fichas then Theme.Coin else Theme.Info, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
	})
	local amount = Components.text({
		Name = "Amount",
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(1, -46, 1, 0),
		FontFace = Theme.Font,
		TextSize = 18,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "0",
		Parent = badge,
	})
	local accessible = if fichas then "Fichas" else "Créditos"
	local function set(value: number)
		local formatted = Components.formatNumber(value)
		amount.Text = formatted
		badge:SetAttribute("Value", value)
		badge:SetAttribute("Label", `{formatted} {accessible}`)
	end
	set(0)
	return badge, set
end

function Components.progress(props: { [string]: any }?, color: Color3?): (Frame, (number) -> ())
	local track = Create(
		"Frame",
		merge({
			Name = "Progress",
			Size = UDim2.new(1, 0, 0, 8),
			BackgroundColor3 = Theme.BgSunken,
			BorderSizePixel = 0,
		}, props)
	) :: Frame
	Components.corner(track, Theme.CornerPill)
	local fill = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color or Theme.Gold,
		BorderSizePixel = 0,
		Parent = track,
	}) :: Frame
	Components.corner(fill, Theme.CornerPill)
	local function set(fraction: number)
		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	end
	return track, set
end

function Components.chip(text: string, color: Color3, props: { [string]: any }?): Frame
	local chip = Create(
		"Frame",
		merge({
			Name = "Chip",
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 24),
			BackgroundColor3 = color:Lerp(Theme.Bg, 0.7),
			BorderSizePixel = 0,
		}, props)
	) :: Frame
	Components.corner(chip, Theme.CornerPill)
	Components.stroke(chip, color, 1, 0.3)
	Components.padding(chip, 10, 0)
	Components.text({
		Name = "Label",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		FontFace = Theme.Font,
		TextSize = 13,
		TextColor3 = color:Lerp(Theme.TextPrimary, 0.35),
		TextWrapped = false,
		Text = text,
		Parent = chip,
	})
	return chip
end

return Components
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="371">
          <Properties>
            <string name="Name">Create</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Helper mínimo para construir UI por código (sem lib declarativa).

		local label = Create("TextLabel", {
			Name = "Title",
			Text = "Olá",
			Parent = screenGui,
		}, {
			Create("UIPadding", { PaddingLeft = UDim.new(0, 8) }),
		}) :: TextLabel

	`Parent` é aplicado por último (depois das propriedades e dos filhos),
	para não replicar/renderizar a instância pela metade.
]]

local function Create(className: string, props: { [string]: any }?, children: { any }?): Instance
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

return Create
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="372">
          <Properties>
            <string name="Name">FieldHud</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HUD da casa, pensado para crianças: cartão de objetivo grande no topo, barras coloridas com ícones,
	inventário em quadradinhos, moedas e nível sempre à vista. Tudo arredondado e com contorno.
	O CampaignController preenche os campos; esta tela só monta e expõe as peças.
]]
local Create = require("./Create")
local Theme = require("./Theme")
local Icons = require("./Icons")
local Input = game:GetService("UserInputService")
local Hud = {}

export type Bar = { frame: Frame, fill: Frame, label: TextLabel }
export type Slot = { frame: Frame, icon: TextLabel, count: TextLabel }

local function corner(radius: UDim?): Instance
	return Create("UICorner", { CornerRadius = radius or Theme.Corner })
end

local function stroke(color: Color3?, thickness: number?, transparency: number?): Instance
	return Create("UIStroke", {
		Color = color or Theme.Border,
		Thickness = thickness or 1,
		Transparency = transparency or 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}) :: UIStroke
end

local function card(parent: Instance, name: string, size: UDim2, position: UDim2, anchor: Vector2?): Frame
	return Create("Frame", {
		Name = name,
		Parent = parent,
		AnchorPoint = anchor or Vector2.zero,
		Position = position,
		Size = size,
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, {
		corner(),
		stroke(),
		Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Theme.BgPanel, Theme.Bg),
		}),
	}) :: Frame
end

local function label(
	parent: Instance,
	name: string,
	font: Font,
	size: number,
	color: Color3,
	position: UDim2,
	dimension: UDim2,
	align: Enum.TextXAlignment?
): TextLabel
	return Create("TextLabel", {
		Name = name,
		Parent = parent,
		Position = position,
		Size = dimension,
		BackgroundTransparency = 1,
		FontFace = font,
		TextSize = size,
		TextColor3 = color,
		TextXAlignment = align or Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		Text = "",
	}) :: TextLabel
end

local function bar(parent: Instance, name: string, _icon: string, color: Color3, y: number): Bar
	local frame = Create("Frame", {
		Name = name,
		Parent = parent,
		Position = UDim2.fromOffset(14, y),
		Size = UDim2.new(1, -28, 0, 24),
		BackgroundTransparency = 1,
	}) :: Frame
	local iconLabel = label(frame, "Icon", Theme.Font, 18, Theme.Text, UDim2.new(), UDim2.fromOffset(26, 24))
	iconLabel.Text = ""
	Icons.draw(iconLabel, name, color)
	local track = Create("Frame", {
		Name = "Track",
		Parent = frame,
		Position = UDim2.fromOffset(32, 4),
		Size = UDim2.new(1, -32, 0, 16),
		BackgroundColor3 = Color3.fromRGB(14, 8, 28),
		BorderSizePixel = 0,
	}, { corner(UDim.new(1, 0)) }) :: Frame
	local fill = Create("Frame", {
		Name = "Fill",
		Parent = track,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, {
		corner(UDim.new(1, 0)),
		Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.35), color),
		}),
	}) :: Frame
	local text = label(track, "Value", Theme.Font, 12, Theme.Text, UDim2.new(), UDim2.fromScale(1, 1))
	text.TextStrokeTransparency = 0.4
	return { frame = frame, fill = fill, label = text }
end

local SLOT_COLORS: { [string]: Color3 } = {
	Key = Theme.Gold,
	Fuse = Theme.Info,
	Star = Color3.fromRGB(190, 140, 240),
	Battery = Theme.Gold,
	Lungs = Color3.fromRGB(140, 220, 255),
	Drum = Color3.fromRGB(214, 160, 110),
}

local function slot(parent: Instance, name: string, icon: string, order: number, key: string?): Slot
	local frame = Create("Frame", {
		Name = name,
		Parent = parent,
		LayoutOrder = order,
		Size = UDim2.fromOffset(58, 58),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
	}, { corner(Theme.CornerSmall), stroke(Theme.Border, 2, 0.4) }) :: Frame
	local iconLabel = label(frame, "Icon", Theme.Font, 28, Theme.Text, UDim2.fromOffset(0, -2), UDim2.fromScale(1, 1))
	-- Pictograma próprio (sem emoji). O controller esmaece o slot vazio via TextTransparency do rótulo.
	iconLabel.Text = ""
	local art = Create("Frame", {
		Name = "Art",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(36, 36),
		BackgroundTransparency = 1,
		Parent = iconLabel,
	})
	Icons.pixel(art, icon, SLOT_COLORS[icon] or Theme.Text)
	iconLabel:GetPropertyChangedSignal("TextTransparency"):Connect(function()
		for _, px in art:GetDescendants() do
			if px:IsA("Frame") and px.Name == "Px" then
				px.BackgroundTransparency = iconLabel.TextTransparency
			end
		end
	end)
	local count = label(
		frame,
		"Count",
		Theme.Font,
		15,
		Theme.Hazard,
		UDim2.new(1, -40, 1, -20),
		UDim2.fromOffset(38, 18),
		Enum.TextXAlignment.Right
	)
	count.TextStrokeTransparency = 0.2
	if key then
		local hint =
			label(frame, "Key", Theme.Font, 12, Theme.TextDim, UDim2.fromOffset(4, 2), UDim2.fromOffset(14, 14))
		hint.Text = key
	end
	return { frame = frame, icon = iconLabel, count = count }
end

function Hud.build(parent: Instance)
	local gui = Create("ScreenGui", {
		Name = "CampaignUi",
		Parent = parent,
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		DisplayOrder = 60,
	}) :: ScreenGui
	local safe = Create(
		"Frame",
		{ Name = "SafeArea", Parent = gui, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }
	) :: Frame
	local canvas = Create(
		"Frame",
		{ Name = "Canvas", Parent = safe, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }
	) :: Frame
	local scale = Create("UIScale", { Parent = canvas }) :: UIScale

	-- Cartão do objetivo (topo, centro).
	local objective = card(canvas, "Order", UDim2.fromOffset(470, 132), UDim2.new(0.5, 0, 0, 14), Vector2.new(0.5, 0))
	local objectiveStroke = objective:FindFirstChildOfClass("UIStroke") :: UIStroke
	objectiveStroke.Thickness = 3
	local chapter = label(
		objective,
		"Chapter",
		Theme.Font,
		14,
		Theme.Hazard,
		UDim2.fromOffset(16, 8),
		UDim2.new(1, -32, 0, 18),
		Enum.TextXAlignment.Left
	)
	local destination = label(
		objective,
		"Destination",
		Theme.Font,
		14,
		Theme.Info,
		UDim2.new(0.5, 0, 0, 8),
		UDim2.new(0.5, -16, 0, 18),
		Enum.TextXAlignment.Right
	)
	local title =
		label(objective, "Title", Theme.Font, 26, Theme.Text, UDim2.fromOffset(14, 28), UDim2.new(1, -28, 0, 34))
	title.TextScaled = true
	Create("UITextSizeConstraint", { Parent = title, MaxTextSize = 28, MinTextSize = 16 })
	title.TextStrokeTransparency = 0.6
	local action = label(
		objective,
		"Action",
		Theme.FontNote,
		15,
		Theme.TextDim,
		UDim2.fromOffset(18, 62),
		UDim2.new(1, -36, 0, 40)
	)
	local progressTrack = Create("Frame", {
		Name = "ProgressTrack",
		Parent = objective,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -120, 0, 12),
		BackgroundColor3 = Color3.fromRGB(14, 8, 28),
		BorderSizePixel = 0,
	}, { corner(UDim.new(1, 0)) }) :: Frame
	local progressFill = Create("Frame", {
		Name = "Fill",
		Parent = progressTrack,
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Good,
		BorderSizePixel = 0,
	}, { corner(UDim.new(1, 0)) }) :: Frame
	local progress = label(
		objective,
		"Progress",
		Theme.Font,
		13,
		Theme.Good,
		UDim2.new(1, -56, 1, -24),
		UDim2.fromOffset(48, 16),
		Enum.TextXAlignment.Right
	)

	-- Dica (balão à esquerda).
	local tipPanel = card(canvas, "FieldTip", UDim2.fromOffset(270, 92), UDim2.fromOffset(16, 170))
	local tipTitle = label(
		tipPanel,
		"Heading",
		Theme.Font,
		14,
		Theme.Hazard,
		UDim2.fromOffset(14, 8),
		UDim2.new(1, -28, 0, 18),
		Enum.TextXAlignment.Left
	)
	tipTitle.Text = "DICA"
	local tip = label(
		tipPanel,
		"Tip",
		Theme.FontNote,
		14,
		Theme.Text,
		UDim2.fromOffset(14, 28),
		UDim2.new(1, -28, 1, -36),
		Enum.TextXAlignment.Left
	)
	tip.TextYAlignment = Enum.TextYAlignment.Top

	-- Status (canto inferior esquerdo): fôlego, lanterna e ar.
	local footer = card(canvas, "Equipment", UDim2.fromOffset(260, 118), UDim2.new(0, 16, 1, -16), Vector2.new(0, 1))
	local bars = {
		stamina = bar(footer, "Stamina", "", Theme.Hazard, 10),
		battery = bar(footer, "Battery", "", Theme.Info, 38),
		oxygen = bar(footer, "Oxygen", "", Color3.fromRGB(140, 220, 255), 66),
	}
	local equipment = label(
		footer,
		"Readout",
		Theme.Font,
		13,
		Theme.TextDim,
		UDim2.fromOffset(16, 92),
		UDim2.new(1, -32, 0, 18),
		Enum.TextXAlignment.Left
	)

	-- Inventário (baixo, centro).
	local tray = Create("Frame", {
		Name = "Inventory",
		Parent = canvas,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(470, 62),
		BackgroundTransparency = 1,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame
	local slots = {
		keys = slot(tray, "Keys", "Key", 1),
		fuses = slot(tray, "Fuses", "Fuse", 2),
		artifact = slot(tray, "Artifact", "Star", 3),
		battery = slot(tray, "Battery", "Battery", 4, "1"),
		oxygen = slot(tray, "Oxygen", "Lungs", 5, "2"),
		decoy = slot(tray, "Decoy", "Drum", 6, "3"),
	}
	-- Texto legado (lido por testes antigos); fica invisível atrás dos slots.
	local inventory = label(tray, "Readout", Theme.Font, 1, Theme.Text, UDim2.new(), UDim2.fromOffset(0, 0))
	inventory.Visible = false

	-- Moedas e nível (canto superior direito).
	local wallet = card(canvas, "Wallet", UDim2.fromOffset(170, 46), UDim2.new(1, -16, 0, 14), Vector2.new(1, 0))
	local coins = label(
		wallet,
		"Coins",
		Theme.Font,
		22,
		Theme.Coin,
		UDim2.fromOffset(42, 0),
		UDim2.new(1, -54, 1, 0),
		Enum.TextXAlignment.Left
	)
	coins.Text = "0"
	local coinArt = Create("Frame", {
		Name = "CoinIcon",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1,
		Parent = wallet,
	})
	Icons.pixel(coinArt, "Coin", Theme.Coin)
	local levelBadge = card(canvas, "Level", UDim2.fromOffset(170, 34), UDim2.new(1, -16, 0, 66), Vector2.new(1, 0))
	local level = label(
		levelBadge,
		"Value",
		Theme.Font,
		16,
		Theme.Text,
		UDim2.fromOffset(36, 0),
		UDim2.new(1, -48, 1, 0),
		Enum.TextXAlignment.Left
	)
	level.Text = "NÍVEL 1"
	local starArt = Create("Frame", {
		Name = "LevelIcon",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Parent = levelBadge,
	})
	Icons.pixel(starArt, "Star", Theme.Gold)

	local controls = label(
		canvas,
		"Controls",
		Theme.Font,
		13,
		Theme.TextDim,
		UDim2.new(1, -16, 1, -16),
		UDim2.fromOffset(250, 40),
		Enum.TextXAlignment.Right
	)
	controls.AnchorPoint = Vector2.new(1, 1)
	controls.TextYAlignment = Enum.TextYAlignment.Bottom
	controls.Text = "E usar · F lanterna · Shift correr\nZ prender o ar · H guia · TAB time"
	controls.TextStrokeTransparency = 0.5

	-- Guia (H): cartão central com rolagem.
	local dossier = card(canvas, "Dossier", UDim2.fromOffset(420, 380), UDim2.new(0.5, 0, 0, 14), Vector2.new(0.5, 0))
	dossier.Visible = false
	local heading = label(
		dossier,
		"Heading",
		Theme.Font,
		22,
		Theme.Hazard,
		UDim2.fromOffset(18, 10),
		UDim2.new(1, -150, 0, 30),
		Enum.TextXAlignment.Left
	)
	heading.Text = "GUIA DA CASA"
	local close = Create("TextButton", {
		Name = "Close",
		Parent = dossier,
		Position = UDim2.new(1, -118, 0, 10),
		Size = UDim2.fromOffset(104, 32),
		BackgroundColor3 = Theme.BgElevated,
		Text = "FECHAR [H]",
		FontFace = Theme.Font,
		TextSize = 15,
		TextColor3 = Theme.Text,
		AutoButtonColor = true,
		Modal = true,
	}, { corner(Theme.CornerSmall) }) :: TextButton
	local scroll = Create("ScrollingFrame", {
		Name = "Pages",
		Parent = dossier,
		Position = UDim2.fromOffset(14, 50),
		Size = UDim2.new(1, -28, 1, -62),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Hazard,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}) :: ScrollingFrame
	local pages = label(
		scroll,
		"Text",
		Theme.FontNote,
		15,
		Theme.Text,
		UDim2.fromOffset(4, 0),
		UDim2.new(1, -16, 0, 0),
		Enum.TextXAlignment.Left
	)
	pages.TextYAlignment = Enum.TextYAlignment.Top
	-- Altura calculada pelo controller: AutomaticSize dentro do ScrollingFrame pode limitar o texto ao viewport.

	-- Aviso grande no meio de baixo (resultado de ações).
	local feedback =
		label(canvas, "Feedback", Theme.Font, 22, Theme.Hazard, UDim2.new(0.5, 0, 1, -96), UDim2.new(0.7, 0, 0, 56))
	feedback.AnchorPoint = Vector2.new(0.5, 1)
	feedback.TextStrokeTransparency = 0
	feedback.TextStrokeColor3 = Theme.Ink

	Create("Frame", {
		Name = "Crosshair",
		Parent = canvas,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BorderSizePixel = 0,
		BackgroundColor3 = Theme.Text,
		BackgroundTransparency = 0.2,
	}, { corner(UDim.new(1, 0)) })

	-- Marcador do objetivo: losango amarelo com nome e distância.
	local waypoint =
		label(canvas, "DestinationMarker", Theme.Font, 16, Theme.Hazard, UDim2.new(), UDim2.fromOffset(240, 52))
	waypoint.AnchorPoint = Vector2.new(0.5, 0.5)
	waypoint.TextStrokeTransparency = 0
	waypoint.TextStrokeColor3 = Theme.Ink

	local function resize(viewport: Vector2)
		viewport = safe.AbsoluteSize
		local touch = Input.TouchEnabled
		if touch then
			-- Medidas em pixels de interface: texto e alvos de toque não encolhem junto com o desktop.
			scale.Scale = 1
			canvas.Size = UDim2.fromScale(1, 1)
			local portrait = viewport.X < 600
			local width = if portrait
				then viewport.X - 16
				else math.min(500, viewport.X - math.clamp(viewport.X * 0.29, 210, 252) - 24)
			local y = if portrait then 60 else 8
			local height = if viewport.Y < 420 then 92 else 112
			objective.AnchorPoint = Vector2.zero
			objective.Position, objective.Size = UDim2.fromOffset(8, y), UDim2.fromOffset(width, height)
			chapter.Position, chapter.Size, chapter.TextSize = UDim2.fromOffset(10, 4), UDim2.new(1, -20, 0, 18), 12
			destination.Visible = false
			title.Position, title.Size = UDim2.fromOffset(10, 23), UDim2.new(1, -20, 0, 27)
			action.Position, action.Size, action.TextSize =
				UDim2.fromOffset(10, 50), UDim2.new(1, -20, 0, height - 64), 14
			progressTrack.Size, progressTrack.Position = UDim2.new(1, -80, 0, 5), UDim2.new(0.5, -16, 1, -6)
			progress.Position = UDim2.new(1, -50, 1, -20)
			footer.AnchorPoint = Vector2.zero
			footer.Position, footer.Size = UDim2.fromOffset(8, y + height + 6), UDim2.fromOffset(width, 24)
			footer.BackgroundTransparency = 0.35
			for index, which in { bars.stamina, bars.battery, bars.oxygen } do
				which.frame.Position, which.frame.Size = UDim2.new((index - 1) / 3, 4, 0, 0), UDim2.new(1 / 3, -8, 1, 0)
				local icon = which.frame:FindFirstChild("Icon") :: TextLabel
				local track = which.frame:FindFirstChild("Track") :: Frame
				icon.Visible = false
				track.Position, track.Size = UDim2.fromOffset(0, 4), UDim2.new(1, 0, 0, 16)
			end
			equipment.Visible = false
			wallet.Visible, levelBadge.Visible = false, false
			dossier.Size, dossier.Position =
				UDim2.fromOffset(math.min(560, viewport.X - 16), viewport.Y - 16), UDim2.new(0.5, 0, 0, 8)
			close.Size, close.Position, close.Text = UDim2.fromOffset(104, 44), UDim2.new(1, -114, 0, 4), "FECHAR"
			scroll.Position, scroll.Size = UDim2.fromOffset(12, 56), UDim2.new(1, -24, 1, -68)
			feedback.Position = UDim2.fromScale(if portrait then 0.5 else 0.38, 0.65)
			feedback.Size, feedback.TextSize =
				UDim2.fromOffset(if portrait then viewport.X - 32 else viewport.X - 280, 48), 16
			waypoint.Size, waypoint.TextSize = UDim2.fromOffset(150, 40), 14
			return 1
		end
		local factor = math.clamp(math.min(viewport.X / 820, viewport.Y / 640), 0.35, 1.25)
		objective.AnchorPoint, objective.Position, objective.Size =
			Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 14), UDim2.fromOffset(470, 132)
		destination.Visible, equipment.Visible, wallet.Visible, levelBadge.Visible = true, true, true, true
		scale.Scale = factor
		canvas.Size = UDim2.fromOffset(viewport.X / factor, viewport.Y / factor)
		local compact = viewport.X / factor < 980
		tray.AnchorPoint = Vector2.new(if compact then 1 else 0.5, 1)
		tray.Position = if compact then UDim2.new(1, -16, 1, -16) else UDim2.new(0.5, 0, 1, -16)
		wallet.Position = if compact then UDim2.new(1, -16, 0, 154) else UDim2.new(1, -16, 0, 14)
		levelBadge.Position = if compact then UDim2.new(1, -16, 0, 206) else UDim2.new(1, -16, 0, 66)
		dossier.Size = UDim2.fromOffset(420, math.max(200, viewport.Y / factor - 120))
		return factor
	end

	local function setBar(which: Bar, value: number, text: string, warn: boolean?)
		local clamped = math.clamp(value, 0, 1)
		which.fill.Size = UDim2.fromScale(clamped, 1)
		which.label.Text = text
		which.fill.BackgroundTransparency = if warn and os.clock() % 0.5 < 0.25 then 0.5 else 0
	end

	return {
		gui = gui,
		canvas = canvas,
		order = objective,
		orderStroke = objectiveStroke,
		chapter = chapter,
		title = title,
		destination = destination,
		action = action,
		progress = progress,
		progressFill = progressFill,
		tipPanel = tipPanel,
		tip = tip,
		footer = footer,
		equipment = equipment,
		bars = bars,
		setBar = setBar,
		inventory = inventory,
		tray = tray,
		slots = slots,
		wallet = wallet,
		coins = coins,
		level = level,
		controls = controls,
		dossier = dossier,
		pages = pages,
		close = close,
		feedback = feedback,
		waypoint = waypoint,
		resize = resize,
		viewport = function()
			return safe.AbsoluteSize
		end,
	}
end

return Hud
]]></string>
          </Properties>
