      </Item>
    </Item>
    <Item class="Folder" referent="319">
      <Properties>
        <string name="Name">Client</string>
      </Properties>
      <Item class="Folder" referent="320">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="321">
          <Properties>
            <string name="Name">ArtController</string>
            <string name="Source"><![CDATA[--!strict
-- Texturas compartilhadas e animação ambiente local; não altera colisão, pistas ou estado do jogo.
local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Patterns = require("@game/ReplicatedStorage/Shared/Game/SurfacePatterns")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Create = require("../UI/Create")
local Settings = require("./SettingsController")

local log = Logger.new("ArtController")
local images: { [string]: EditableImage } = {}
local textures = 0
local textured: { [Instance]: number } = {}
local snapshot: GameState.Snapshot? = nil
local indicators: { BasePart } = {}
local screens: { { part: BasePart, gui: SurfaceGui, label: TextLabel } } = {}
local dust: { { part: BasePart, emitter: ParticleEmitter } } = {}
local spark: ParticleEmitter? = nil
local clock = 0
local peakStep = 0
local Controller = { Name = "ArtController" }

local function makeImages()
	for index, kind in Patterns.Kinds do
		local created: EditableImage? = nil
		local ok = pcall(function()
			created = AssetService:CreateEditableImage({ Size = Vector2.new(Patterns.Size, Patterns.Size) })
			assert(created, "editable image budget unavailable")
			created:WritePixelsBuffer(
				Vector2.zero,
				Vector2.new(Patterns.Size, Patterns.Size),
				Patterns.pixels(kind, index)
			)
		end)
		if ok and created then
			images[kind] = created
		elseif created then
			created:Destroy()
		end
	end
	local count = 0
	for _ in images do
		count += 1
	end
	log.info("surface atlas ready (%d/%d); native materials remain as fallback", count, #Patterns.Kinds)
end

local function surface(part: Instance)
	if not part:IsA("BasePart") or part:FindFirstChild("ArtTexture") then
		return
	end
	local kind = part:GetAttribute("SurfaceStyle")
	local image = images[kind :: string]
	if not image then
		return
	end
	local faces: { Enum.NormalId }
	if part.Size.Y <= 1.1 and part.Size.X > 3 and part.Size.Z > 3 then
		faces = { Enum.NormalId.Top }
	elseif part.Name:sub(1, 5) == "Wall_" then
		faces = if part.Size.X > part.Size.Z
			then { Enum.NormalId.Front, Enum.NormalId.Back }
			else { Enum.NormalId.Left, Enum.NormalId.Right }
	else
		faces = { Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Top }
	end
	for _, face in faces do
		if textures >= Config.Art.TextureLimit then
			return
		end
		local texture = Instance.new("Texture")
		texture.Name = "ArtTexture"
		texture.Face = face
		texture.StudsPerTileU = Config.Art.TextureStuds
		texture.StudsPerTileV = Config.Art.TextureStuds
		texture.OffsetStudsU = (part.Position.X % 5) * 0.3
		texture.OffsetStudsV = (part.Position.Z % 5) * 0.3
		local ok = pcall(function()
			texture.ColorMapContent = Content.fromObject(image)
		end)
		if ok then
			texture.Parent = part
			textures += 1
			textured[part] = (textured[part] or 0) + 1
		else
			texture:Destroy()
		end
	end
end

local function removeSurface(part: Instance)
	textures -= textured[part] or 0
	textured[part] = nil
	for _, child in part:GetChildren() do
		if child.Name == "ArtTexture" then
			child:Destroy()
		end
	end
end

local function screen(part: Instance)
	if not part:IsA("BasePart") or part:FindFirstChild("ArtCRT") then
		return
	end
	local gui = Create("SurfaceGui", {
		Name = "ArtCRT",
		Face = if part.Name == "DeadMonitor" then Enum.NormalId.Back else Enum.NormalId.Front,
		CanvasSize = Vector2.new(128, 96),
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		LightInfluence = 0.35,
		Brightness = 0.75,
		AlwaysOnTop = false,
		MaxDistance = Config.Art.ScreenRange,
		Active = false,
		Parent = part,
	}) :: SurfaceGui
	local label = Create("TextLabel", {
		Name = "Readout",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(9, 19, 16),
		TextColor3 = Color3.fromRGB(117, 162, 125),
		Font = Enum.Font.Code,
		TextSize = 11,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = gui,
	}) :: TextLabel
	for y = 0, 90, 6 do
		Create("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromOffset(0, y),
			BackgroundColor3 = Color3.new(),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Parent = gui,
		})
	end
	table.insert(screens, { part = part, gui = gui, label = label })
end

local function mote(part: Instance)
	if not part:IsA("BasePart") or part:FindFirstChild("ArtDust") then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "ArtDust"
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(168, 165, 144))
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.4, 0.87),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new(0.085)
	emitter.Rate = 1.5
	emitter.Lifetime = NumberRange.new(3, 5)
	emitter.Speed = NumberRange.new(0.1, 0.3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightInfluence = 1
	emitter.Enabled = false
	emitter.Parent = part
	table.insert(dust, { part = part, emitter = emitter })
end

local function setupSparks()
	local world = workspace:FindFirstChild("CursedHouse")
	local features = world and world:FindFirstChild("Features")
	local breakers = features and features:FindFirstChild("Breakers")
	local box = breakers and breakers:FindFirstChild("Box")
	if not box or not box:IsA("BasePart") then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "ArtSparks"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90))
	emitter.LightEmission = 0.6
	emitter.Size = NumberSequence.new(0.055)
	emitter.Lifetime = NumberRange.new(0.12, 0.25)
	emitter.Speed = NumberRange.new(4, 7)
	emitter.Acceleration = Vector3.new(0, -12, 0)
	emitter.Rate = 0
	emitter.Parent = box
	spark = emitter
	box:GetAttributeChangedSignal("Spark"):Connect(function()
		if box:GetAttribute("Spark") and Settings.get("flashes") and snapshot and snapshot.phase == "Playing" then
			emitter:Emit(6)
		end
	end)
	Settings.onChanged(function(key, value)
		if key == "flashes" and not value then
			emitter:Clear()
		end
	end)
end

local function step()
	local camera = workspace.CurrentCamera
	local state = snapshot
	if not camera or not state then
		return
	end
	local power = state.powerOn
	for _, part in indicators do
		if not part.Parent then
			continue
		end
		local kind = part:GetAttribute("Indicator")
		if kind == "GaugeGenerator" or kind == "GaugePump" then
			local pivot = part:GetAttribute("Pivot")
			if typeof(pivot) == "CFrame" then
				local angle = if power then -0.5 + math.sin(clock * 1.8) * 0.07 else 1.05
				part.CFrame = pivot * CFrame.Angles(0, 0, angle) * CFrame.new(0, 0.15, 0)
			end
		elseif kind == "PanelLed" then
			part.Color = if power then Color3.fromRGB(70, 175, 100) else Color3.fromRGB(125, 32, 24)
			part.Material = if power
					or not Settings.get("flashes")
					or math.floor(clock) % 2 == 0
				then Enum.Material.Neon
				else Enum.Material.SmoothPlastic
		end
	end
	for _, entry in screens do
		local near = entry.part.Parent ~= nil
			and (entry.part.Position - camera.CFrame.Position).Magnitude < Config.Art.ScreenRange
		entry.gui.Enabled = near and power
		if near and power then
			local text = " S9 / REDE LOCAL\n\n  50 Hz / 220 V\n\n  SETOR ONLINE\n  > MONITORAMENTO"
			if entry.label.Text ~= text then
				entry.label.Text = text
			end
		end
	end
	for _, entry in dust do
		entry.emitter.Enabled = entry.part.Parent ~= nil
			and (entry.part.Position - camera.CFrame.Position).Magnitude < Config.Art.DustRange
	end
end

function Controller.debugState(): { [string]: any }
	local count = 0
	for _ in images do
		count += 1
	end
	return {
		images = count,
		textureBytes = count * Patterns.Size ^ 2 * 4,
		textures = textures,
		screens = #screens,
		dust = #dust,
		indicators = #indicators,
		spark = spark ~= nil,
		peakStepMs = peakStep * 1000,
	}
end

function Controller.Start()
	GameState.observe(function(state)
		snapshot = state
	end)
	makeImages()
	for _, part in CollectionService:GetTagged("ArtSurface") do
		surface(part)
	end
	for _, part in CollectionService:GetTagged("ArtScreen") do
		screen(part)
	end
	for _, part in CollectionService:GetTagged("ArtDust") do
		mote(part)
	end
	for _, part in CollectionService:GetTagged("Indicator") do
		if part:IsA("BasePart") then
			table.insert(indicators, part)
		end
	end
	CollectionService:GetInstanceAddedSignal("ArtSurface"):Connect(surface)
	CollectionService:GetInstanceAddedSignal("ArtScreen"):Connect(screen)
	CollectionService:GetInstanceAddedSignal("ArtDust"):Connect(mote)
	CollectionService:GetInstanceRemovedSignal("ArtSurface"):Connect(removeSurface)
	CollectionService:GetInstanceRemovedSignal("ArtScreen"):Connect(function(part: Instance)
		for index = #screens, 1, -1 do
			if screens[index].part == part then
				screens[index].gui:Destroy()
				table.remove(screens, index)
			end
		end
	end)
	CollectionService:GetInstanceRemovedSignal("ArtDust"):Connect(function(part: Instance)
		for index = #dust, 1, -1 do
			if dust[index].part == part then
				dust[index].emitter:Destroy()
				table.remove(dust, index)
			end
		end
	end)
	setupSparks()
	local elapsed = 0
	RunService.RenderStepped:Connect(function(dt)
		clock += dt
		elapsed += dt
		if elapsed < 1 / 12 then
			return
		end
		elapsed = 0
		local started = os.clock()
		step()
		peakStep = math.max(peakStep, os.clock() - started)
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="322">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Áudio no cliente (mixagem central).

	Grupos:
	  Lofi  mundo, ambiência, música e corpo: EQ "PS1" (corta agudos) + EQ de abafamento
	        (escondido / pânico) + compressor (evita saturar quando tudo toca junto).
	  Ui    interface e stingers: fora do abafamento.

	Camadas em loop com volume suave por contexto:
	  ambiência externa/interna, vento nas frestas, máquinas (com energia), música por estado
	  (calma / tensão / perseguição / alívio), batimento (medo + proximidade), sussurros (medo alto).
	Reverb por sala (zonas criadas pelo servidor em Substation9.Features.Zones).
	silence(s): corta tudo por alguns segundos antes de certos sustos.
	Sons 3D do mundo (servidor) entram no grupo Lofi localmente.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")

export type MusicState = "none" | "calm" | "tension" | "chase" | "relief"

local player = Players.LocalPlayer

local group: SoundGroup? = nil
local uiGroup: SoundGroup? = nil
local muffleEq: EqualizerSoundEffect? = nil
local loops: { [string]: Sound } = {}
local targets: { [string]: number } = {}
local speeds: { [string]: number } = {}
local snapshot: GameState.Snapshot? = nil
local inside = false
local lastInsideCheck = 0
local zone = "Outside"
local zones: { BasePart } = {}
local musicState: MusicState = "none"
local fear = 0
local silenceUntil = 0
local muffleOverride = 0
local nextCreakAt = 0
local nextHushAt = 0
local hushUntil = 0
local forestWasDark = false
local rng = Random.new()

local Preferences = require("@game/ReplicatedStorage/Shared/Game/HousePreferences")
local mixer: { [string]: SoundGroup } = {}
local LOOPS = {
	"AmbExterior",
	"AmbInterior",
	"WindInterior",
	"Machinery",
	"Music",
	"MusicTension",
	"MusicChase",
	"MusicRelief",
	"Heartbeat",
	"Whisper",
}

local function getGroup(): SoundGroup
	assert(group, "[AudioController] used before Init")
	return group
end

local function applyClip(sound: Sound, clipName: string)
	local clip = Audio[clipName]
	assert(clip, `[AudioController] unknown clip "{clipName}"`)
	sound.SoundId = clip.id
	sound.Volume = clip.volume
	sound.PlaybackSpeed = clip.speed or 1
	if clip.region then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(clip.region[1], clip.region[2])
	end
end

local function make(name: string, clipName: string, parent: Instance, looped: boolean, ui: boolean?): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	applyClip(sound, clipName)
	sound.Looped = looped
	sound.SoundGroup = if ui then uiGroup else mixer[Preferences.category(clipName)] or getGroup()
	sound.Parent = parent
	return sound
end

local function creatureRoot(): BasePart?
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	return if root and root:IsA("BasePart") then root else nil
end

local function checkInside(position: Vector3): boolean
	local world = workspace:FindFirstChild(Tags.WorldFolder)
	if not world then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { world }
	params.RespectCanCollide = true
	return workspace:Raycast(position, Vector3.new(0, 25, 0), params) ~= nil
end

local function zoneAt(position: Vector3): (string, string)
	if Config.House.Enabled then
		for _, room in House.Rooms do
			if
				room.id ~= "Exterior"
				and math.abs(position.Y - (room.y + 5)) <= 8
				and math.abs(position.X - room.x) <= 18
				and math.abs(position.Z - room.z) <= 16
			then
				local reverb = if room.y < 0 then "StoneRoom" elseif room.id == "Bath" then "Bathroom" else "Room"
				return room.id, reverb
			end
		end
		return "Hall", "Hallway"
	end
	for _, part in zones do
		local p = part.CFrame:PointToObjectSpace(position)
		local half = part.Size / 2
		if math.abs(p.X) <= half.X and math.abs(p.Z) <= half.Z and math.abs(p.Y) <= half.Y + 2 then
			return (part:GetAttribute("Room") :: string?) or part.Name,
				(part:GetAttribute("Reverb") :: string?) or "Room"
		end
	end
	return "Outside", "Plain"
end

local function setReverb(name: string)
	local ok, value = pcall(function()
		return (Enum.ReverbType :: any)[name]
	end)
	if ok and value and SoundService.AmbientReverb ~= value then
		SoundService.AmbientReverb = value
	end
end

local AudioController = {
	Name = "AudioController",
}

-- Som 2D de uma vez. `ui` = fora do abafamento (interface/stingers).
function AudioController.play(clipName: string, volumeScale: number?, speed: number?, ui: boolean?): Sound
	local sound = make(clipName, clipName, SoundService, false, ui)
	sound.Volume *= volumeScale or 1
	if speed then
		sound.PlaybackSpeed = speed
	end
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(30, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	return sound
end

-- Som 3D de uma vez preso a uma peça/attachment.
function AudioController.playAt(clipName: string, parent: Instance, volumeScale: number?, speed: number?): Sound
	local sound = make(clipName, clipName, parent, false)
	sound.Volume *= volumeScale or 1
	if speed then
		sound.PlaybackSpeed = speed
	end
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = if clipName == "CreakWood" or clipName == "CreakMetal" then 38 else 90
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(30, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	return sound
end

-- Som 3D numa posição do mundo (cria um ponto invisível que some ao terminar).
function AudioController.playAtPosition(
	clipName: string,
	position: Vector3,
	volumeScale: number?,
	speed: number?
): Sound
	local anchor = Instance.new("Part")
	anchor.Name = "SoundPoint"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	anchor.Parent = workspace
	local sound = AudioController.playAt(clipName, anchor, volumeScale, speed)
	sound.Destroying:Once(function()
		-- Destroying ocorre antes de terminar a remoção do filho. Destruir o pai aqui
		-- reentrava no mesmo Sound e disparava "Parent property is locked".
		task.defer(function()
			if anchor.Parent then
				anchor:Destroy()
			end
		end)
	end)
	return sound
end

-- Loop 3D controlado por quem chamou (ex.: rosnado de perseguição na criatura).
function AudioController.loopAt(clipName: string, parent: Instance): Sound
	local sound = make(clipName, clipName, parent, true)
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = if clipName == "CreakWood" or clipName == "CreakMetal" then 38 else 90
	return sound
end

-- Aplica o clip (id, volume, velocidade, trecho) a um Sound existente.
function AudioController.configure(sound: Sound, clipName: string)
	applyClip(sound, clipName)
	sound.SoundGroup = getGroup()
end

function AudioController.isInside(): boolean
	return inside
end

-- Sala atual (id do Layout) ou "Outside".
function AudioController.zone(): string
	return zone
end

function AudioController.setMusicState(state: MusicState)
	musicState = state
end

function AudioController.musicState(): MusicState
	return musicState
end

function AudioController.setFear(value: number)
	fear = math.clamp(value, 0, 1)
end

-- Corta a mixagem por `duration` s (silêncio antes de um susto).
function AudioController.silence(duration: number)
	silenceUntil = math.max(silenceUntil, os.clock() + duration)
end

-- Abafamento extra por `duration` s (ex.: depois de um impacto forte).
function AudioController.muffle(duration: number)
	muffleOverride = math.max(muffleOverride, os.clock() + duration)
end

function AudioController.debugState(): { [string]: any }
	local volumes = {}
	for name, sound in loops do
		volumes[name] = math.floor(sound.Volume * 100 + 0.5) / 100
	end
	return {
		zone = zone,
		inside = inside,
		music = musicState,
		reverb = SoundService.AmbientReverb.Name,
		muffle = if muffleEq then muffleEq.HighGain else 0,
		silenced = os.clock() < silenceUntil,
		hush = os.clock() < hushUntil,
		volumes = volumes,
	}
end

function AudioController.Init()
	local g = Instance.new("SoundGroup")
	g.Name = "Lofi"
	g.Volume = 1
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "Lofi"
	eq.HighGain = -9
	eq.MidGain = -1
	eq.LowGain = 1
	eq.Priority = 1
	eq.Parent = g
	local muffle = Instance.new("EqualizerSoundEffect")
	muffle.Name = "Muffle"
	muffle.HighGain = 0
	muffle.MidGain = 0
	muffle.LowGain = 0
	muffle.Priority = 2
	muffle.Parent = g
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Threshold = -14
	compressor.Ratio = 3
	compressor.Attack = 0.01
	compressor.Release = 0.2
	compressor.Priority = 3
	compressor.Parent = g
	g.Parent = SoundService
	group = g
	muffleEq = muffle

	local ui = Instance.new("SoundGroup")
	ui.Name = "Ui"
	ui.Volume = 1
	ui.Parent = SoundService
	uiGroup = ui
	SoundService.AmbientReverb = Enum.ReverbType.StoneCorridor

	for _, category in { "music", "effects", "breathing", "ambient" } do
		local channel = Instance.new("SoundGroup")
		channel.Name = category
		channel.Parent = g
		mixer[category] = channel
		local function update()
			channel.Volume = tonumber(player:GetAttribute("Mix_" .. category)) or 1
		end
		player:GetAttributeChangedSignal("Mix_" .. category):Connect(update)
		update()
	end
	local function master()
		g.Volume = tonumber(player:GetAttribute("Mix_master")) or 1
		ui.Volume = g.Volume
	end
	player:GetAttributeChangedSignal("Mix_master"):Connect(master)
	master()
	for _, name in LOOPS do
		local sound = make(name, name, SoundService, true)
		targets[name] = 0
		speeds[name] = sound.PlaybackSpeed
		sound.Volume = 0
		loops[name] = sound
	end
end

function AudioController.Start()
	local function spatial(instance: Instance)
		if instance:IsA("Sound") and not instance.SoundGroup then
			instance.SoundGroup = mixer.effects
		end
	end
	for _, instance in workspace:GetDescendants() do
		spatial(instance)
	end
	workspace.DescendantAdded:Connect(spatial)

	for _, sound in loops do
		sound:Play()
	end

	-- Sons 3D do mundo (servidor) também passam pelo filtro lo-fi.
	local function adopt(instance: Instance)
		if instance:IsA("Sound") and not instance.SoundGroup then
			instance.SoundGroup = mixer.effects
		end
	end
	task.spawn(function()
		local world = workspace:WaitForChild(Tags.WorldFolder, 30)
		if world then
			for _, d in world:GetDescendants() do
				adopt(d)
			end
			world.DescendantAdded:Connect(adopt)
			if Config.House.Enabled then
				return -- usa o catálogo da casa em vez das zonas industriais antigas.
			end
			local zoneFolder = world:WaitForChild("Features", 30)
			zoneFolder = zoneFolder and zoneFolder:WaitForChild("Zones", 30)
			if zoneFolder then
				for _, child in zoneFolder:GetChildren() do
					if child:IsA("BasePart") then
						table.insert(zones, child)
					end
				end
			end
		end
	end)

	GameState.observe(function(next: GameState.Snapshot)
		local previous = snapshot
		snapshot = next
		if previous == nil then
			return
		end
		if next.creatureActive and not previous.creatureActive and next.phase == "Playing" then
			AudioController.play("StingerAwaken", 1, nil, true)
		end
		if next.phase ~= previous.phase then
			if next.phase == "Lost" then
				AudioController.play("StingerCapture", 1, nil, true)
				AudioController.play("Roar", 1.1, 0.8, true)
			elseif next.phase == "Won" then
				AudioController.play("StingerWin", 1, nil, true)
			elseif next.phase == "Intro" then
				silenceUntil = 0
				muffleOverride = 0
				musicState = "none"
				nextHushAt, hushUntil, nextCreakAt = 0, 0, 0
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		local camera = workspace.CurrentCamera
		local s = snapshot
		if not camera or not s then
			return
		end
		local now = os.clock()
		local position = camera.CFrame.Position
		local world = workspace:FindFirstChild(Tags.WorldFolder)
		local forest = world ~= nil and world:GetAttribute("ForestActive") == true
		local forestDark = forest and world ~= nil and world:GetAttribute("ForestBlackout") == true
		if forestDark and not forestWasDark and s.phase == "Playing" then
			AudioController.silence(2.2)
			AudioController.playAtPosition("DoorBang", position + camera.CFrame.RightVector * 20, 0.6, 0.65)
		end
		forestWasDark = forestDark
		if now - lastInsideCheck > 0.3 then
			lastInsideCheck = now
			inside = checkInside(position)
			local room, reverb = zoneAt(position)
			zone = if inside then room else "Outside"
			setReverb(if inside then reverb else "Plain")
		end

		local playing = s.phase == "Playing" or s.phase == "Intro"
		local root = creatureRoot()
		local distance = if root and s.creatureActive then (root.Position - position).Magnitude else math.huge
		local near = math.clamp((32 - distance) / 32, 0, 1)
		local silenced = now < silenceUntil
		local hidden = player:GetAttribute("Hidden")
		local isHidden = type(hidden) == "string" and hidden ~= ""

		targets.AmbExterior = if playing then (if inside then 0.05 else Audio.AmbExterior.volume) else 0.03
		targets.AmbInterior = if playing and inside then Audio.AmbInterior.volume else 0
		targets.WindInterior = if playing and inside then Audio.WindInterior.volume * (1 + fear * 0.5) else 0
		targets.Machinery = if playing and s.powerOn and not forest then Audio.Machinery.volume else 0

		local music = musicState
		local inPlay = Presentation.playing(s.phase, player:GetAttribute("CampaignStatus") :: string?)
		-- Pausas espaçadas da ambiência; passos e perseguição continuam audíveis.
		if inPlay and inside and music == "calm" and near == 0 then
			if nextHushAt == 0 then
				nextHushAt = now + rng:NextNumber(18, 32)
			elseif now >= nextHushAt then
				hushUntil = now + rng:NextNumber(3, 5)
				nextHushAt = now + rng:NextNumber(28, 46)
			end
		else
			hushUntil, nextHushAt = 0, 0
		end
		local hush = now < hushUntil
		targets.Music = if inPlay and music == "calm" and not forest then Audio.Music.volume else 0
		targets.MusicTension = if inPlay and music == "tension"
			then Audio.MusicTension.volume * (0.7 + near * 0.6)
			else 0
		if forest and inPlay and music ~= "chase" and not forestDark then
			targets.MusicTension = math.max(targets.MusicTension, Audio.MusicTension.volume * 0.5)
		end
		targets.MusicChase = if inPlay and music == "chase" then Audio.MusicChase.volume else 0
		targets.MusicRelief = if inPlay and music == "relief" then Audio.MusicRelief.volume else 0

		-- Batimento: medo + proximidade. Sussurros só com medo muito alto.
		local beat = math.clamp(fear * 0.7 + near * 0.35, 0, 1)
		targets.Heartbeat = if inPlay then beat * 0.7 else 0
		loops.Heartbeat.PlaybackSpeed = speeds.Heartbeat * (0.85 + beat * 0.6)
		targets.Whisper = if inPlay and fear > 0.72 then Audio.Whisper.volume * (fear - 0.72) / 0.28 else 0

		for name, sound in loops do
			local target = targets[name]
			if hush and (name == "Music" or name == "AmbInterior" or name == "WindInterior") then
				target *= 0.18
			end
			if silenced and name ~= "Heartbeat" then
				target = 0
			end
			local rate = if silenced then 6 elseif name == "MusicChase" and target > sound.Volume then 3 else 1.2
			sound.Volume += (target - sound.Volume) * math.min(1, dt * rate)
		end

		-- Abafamento: escondido no armário, pânico ou impacto recente.
		local eq = muffleEq
		if eq then
			local amount = 0
			if isHidden then
				amount = 1
			elseif fear > 0.82 then
				amount = (fear - 0.82) / 0.18 * 0.7
			end
			if now < muffleOverride then
				amount = math.max(amount, 0.8)
			end
			eq.HighGain += (-34 * amount - eq.HighGain) * math.min(1, dt * 4)
			eq.MidGain += (-10 * amount - eq.MidGain) * math.min(1, dt * 4)
		end

		-- Rangidos ocasionais do prédio (3D, perto do jogador, nunca durante silêncio).
		if inPlay and inside and now >= nextCreakAt and not silenced then
			nextCreakAt = now + rng:NextNumber(14, 30)
			local offset = Vector3.new(rng:NextNumber(-14, 14), rng:NextNumber(3, 8), rng:NextNumber(-14, 14))
			local clip = if Config.House.Enabled or zone == "Office" then "CreakWood" else "CreakMetal"
			local sound = AudioController.playAtPosition(clip, position + offset, rng:NextNumber(0.5, 0.9))
			sound.PlaybackSpeed = rng:NextNumber(0.8, 1.1)
			sound.TimePosition = 0
			task.delay(rng:NextNumber(1.6, 3), function()
				if sound.Parent then
					sound:Stop()
					sound:Destroy()
				end
			end)
		end
	end)
end

return AudioController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="323">
          <Properties>
            <string name="Name">BodyAudioController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Sons do corpo do jogador (cliente):
	- Passos por material do chão: concreto, madeira, metal e água (poças), com variação de
	  amostra/tom/volume e cadência pela distância andada (agachado é mais quieto e espaçado).
	  Os passos padrão do Roblox são silenciados.
	- Respiração: calma (quase nada), ofegante (exaustão) e com medo; o ritmo acelera com a
	  intensidade. Escondido e prendendo a respiração: silêncio; soltar = expiração; arquejo
	  forçado quando o fôlego acaba.
	- Pouso: baque com volume pela queda.
	Sons são locais (só o jogador ouve); o barulho que o Vigia "ouve" é decidido no servidor.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local AudioController = require("./AudioController")
local CharacterController = require("./CharacterController")

export type Surface = "concrete" | "wood" | "metal" | "water"

local player = Players.LocalPlayer
local rng = Random.new()

local STEP_CLIPS: { [Surface]: string } = {
	concrete = "StepConcrete",
	wood = "StepWood",
	metal = "StepMetal",
	water = "StepWater",
}
local MATERIALS: { [Enum.Material]: Surface } = {
	[Enum.Material.Wood] = "wood",
	[Enum.Material.WoodPlanks] = "wood",
	[Enum.Material.DiamondPlate] = "metal",
	[Enum.Material.Metal] = "metal",
	[Enum.Material.CorrodedMetal] = "metal",
	[Enum.Material.Foil] = "metal",
	[Enum.Material.Water] = "water",
}
local BREATHS = { "Breath1", "Breath2", "Breath3", "Breath4" }

local phase: GameState.Phase = "Loading"
local stride = 0
local leftFoot = false
local nextBreathAt = 0
local breathIndex = 1
local fear = 0
local lastSurface: Surface = "concrete"
local puddles: { BasePart } = {}
local holding = false
local gasps = 0

local function isHidden(): boolean
	local hidden = player:GetAttribute("Hidden")
	return type(hidden) == "string" and hidden ~= ""
end

local function inPuddle(position: Vector3): boolean
	for _, puddle in puddles do
		if puddle.Parent then
			local p = puddle.CFrame:PointToObjectSpace(position)
			if
				math.abs(p.X) <= puddle.Size.X / 2 + 0.3
				and math.abs(p.Z) <= puddle.Size.Z / 2 + 0.3
				and math.abs(p.Y) < 4
			then
				return true
			end
		end
	end
	return false
end

local function surfaceAt(motion: CharacterController.Motion, root: BasePart): Surface
	if inPuddle(root.Position - Vector3.new(0, root.Size.Y / 2 + motion.standHipHeight, 0)) then
		return "water"
	end
	local part = motion.floorPart
	if part then
		local tagged = part:GetAttribute("Surface")
		if tagged == "wood" or tagged == "metal" or tagged == "water" or tagged == "concrete" then
			return tagged :: Surface
		end
	end
	local material = motion.floorMaterial
	if material and MATERIALS[material] then
		return MATERIALS[material]
	end
	return "concrete"
end

local function step(motion: CharacterController.Motion, root: BasePart)
	local surface: Surface = surfaceAt(motion, root)
	lastSurface = surface
	leftFoot = not leftFoot
	local loudness = if motion.stance == "Crouch" then 0.4 elseif motion.sprinting then 1.15 else 0.8
	local pitch: number = rng:NextNumber(0.92, 1.08) * (if leftFoot then 1 else 0.96)
	if surface == "metal" then
		pitch *= 0.85
	end
	AudioController.play(STEP_CLIPS[surface], loudness * rng:NextNumber(0.85, 1.05), pitch :: number)
	-- Madeira velha range de vez em quando.
	if surface == "wood" and rng:NextNumber() < 0.12 then
		local creak = AudioController.play("CreakWood", 0.35 * loudness, rng:NextNumber(0.9, 1.15))
		creak.TimePosition = rng:NextNumber(0, 10)
		task.delay(0.6, function()
			if creak.Parent then
				creak:Destroy()
			end
		end)
	end
end

local function breathe(motion: CharacterController.Motion, now: number)
	if now < nextBreathAt then
		return
	end
	local hidden = isHidden()
	if holding then
		nextBreathAt = now + 0.3
		return
	end
	-- Intensidade: o maior entre exaustão e medo (escondido o medo pesa mais).
	local intensity = math.max(
		tonumber(player:GetAttribute("BreathIntensity")) or 0,
		motion.exhaustion,
		(fear - 0.25) / 0.75 * (if hidden then 1.2 else 1)
	)
	if intensity <= 0.05 then
		nextBreathAt = now + 1
		return
	end
	intensity = math.clamp(intensity, 0, 1)
	breathIndex = breathIndex % #BREATHS + 1
	AudioController.play(BREATHS[breathIndex], 0.25 + intensity * 0.75, rng:NextNumber(1.05, 1.2) + intensity * 0.15)
	-- Intervalo entre respirações: 3.2 s (leve) até 0.75 s (pânico/ofegante).
	nextBreathAt = now + (3.2 - intensity * 2.45) * rng:NextNumber(0.9, 1.1)
end

-- Silencia os sons padrão do personagem (passos de plástico etc.).
local function muteDefaults(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	local function mute(child: Instance)
		if child:IsA("Sound") then
			child.Volume = 0
			child:GetPropertyChangedSignal("Volume"):Connect(function()
				if child.Volume ~= 0 then
					child.Volume = 0
				end
			end)
		end
	end
	for _, child in root:GetChildren() do
		mute(child)
	end
	root.ChildAdded:Connect(mute)
end

local BodyAudioController = {
	Name = "BodyAudioController",
}

function BodyAudioController.setFear(value: number)
	fear = math.clamp(value, 0, 1)
end

function BodyAudioController.lastSurface(): Surface
	return lastSurface
end

function BodyAudioController.Start()
	GameState.observe(function(snapshot)
		phase = snapshot.phase
	end)
	if player.Character then
		task.spawn(muteDefaults, player.Character)
	end
	player.CharacterAdded:Connect(muteDefaults)

	-- Poças: as do mapa (nome "Puddle") e as das novidades.
	task.spawn(function()
		local world = workspace:WaitForChild(Tags.WorldFolder, 30)
		if not world then
			return
		end
		task.wait(1)
		for _, d in world:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "Puddle" then
				table.insert(puddles, d)
			end
		end
	end)
	local _ = CollectionService

	CharacterController.onLanded(function(intensity: number)
		AudioController.play("Land", 0.4 + intensity * 0.8, 0.85 + (1 - intensity) * 0.2)
	end)

	player:GetAttributeChangedSignal("HoldBreath"):Connect(function()
		local now = player:GetAttribute("HoldBreath") == true
		if holding and not now and isHidden() then
			-- Soltou: expiração longa e tremida.
			AudioController.play("Breath2", 0.6, 0.9)
			nextBreathAt = os.clock() + 1.2
		elseif now then
			AudioController.play("Breath4", 0.4, 1.3)
		end
		holding = now
	end)
	player:GetAttributeChangedSignal("Gasps"):Connect(function()
		local count = (player:GetAttribute("Gasps") :: number?) or 0
		if count > gasps then
			AudioController.play("Gasp", 1, 1)
			nextBreathAt = os.clock() + 1.6
		end
		gasps = count
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") or (phase ~= "Playing" and phase ~= "Intro") then
			return
		end
		local motion = CharacterController.getMotion()
		local now = os.clock()
		if motion.grounded and not motion.hidden and motion.speed > 1 then
			stride += motion.speed * dt
			local length = if motion.stance == "Crouch" then 2.7 elseif motion.sprinting then 5.2 else 3.9
			if stride >= length then
				stride = 0
				step(motion, root)
			end
		else
			stride = math.min(stride, 1.5)
		end
		if phase == "Playing" then
			breathe(motion, now)
		end
	end)
end

return BodyAudioController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="324">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Compositor ÚNICO da câmera. Todos os efeitos passam por aqui e são somados uma vez por
	quadro, para nunca brigarem entre si nem acumularem:

	  posição (Humanoid.CameraOffset): balanço ao andar, respiração parada, altura agachado
	    (compensa o "pulo" físico do HipHeight), mergulho do pouso;
	  rotação: inclinação lateral, balanço de exaustão, tremor (trauma), coice do pouso.
	    É aplicada DEPOIS do módulo de câmera do Roblox e desfeita ANTES dele no quadro seguinte,
	    então o mouse e a câmera padrão nunca "herdam" o efeito;
	  FOV: base + corrida - medo + pancada (detecção) + zoom (captura).

	Modos especiais (câmera Scriptable, só enquanto durar):
	  hidden   dentro do armário: olhar limitado às frestas;
	  capture  captura: hit-stop curto (sem travar a thread), vira para o Vigia, zoom, tremor.
	reset() volta tudo ao normal (nova rodada / checkpoint).

	Conforto (SettingsController): bob, tilt, shake e fov desligam cada parte.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local CharacterController = require("./CharacterController")
local SettingsController = require("./SettingsController")

local C = Config.Camera
local P = Config.Player
local player = Players.LocalPlayer

type Mode = "normal" | "hidden" | "capture" | "spectate" | "cinema"
local cinemaFrame = CFrame.identity
local cinemaFov = 60
local cinemaFocus = Vector3.zero
local cinemaReturnFrame: CFrame? = nil

local mode: Mode = "normal"
local windowFocused = true
local modalButtons: { [GuiButton]: boolean } = {}
local applied = CFrame.identity
local appliedCamera: Camera? = nil

-- Estado dos efeitos
local bobPhase = 0
local bobAmplitude = 0
local breathClock = 0
local tilt = 0
local trauma = 0
local fear = 0
local fearSmooth = 0
local punch = 0
local sprintAlpha = 0
local crouchAlpha = 0
local landOffset = 0
local landVelocity = 0
local noiseSeed = math.random() * 1000
local currentOffset = Vector3.zero

-- Esconderijo
local hiddenOrigin: CFrame? = nil
local hiddenYaw = 0
local hiddenPitch = 0
local spectateTarget: Player? = nil

-- Captura
local captureStarted = 0
local captureFrom: CFrame? = nil
local captureTarget: (() -> Vector3?)? = nil
local captureZoom = 0
local HIT_STOP = 0.1

local function humanoid(): Humanoid?
	local character = player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

local function rootPart(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Recupera o mouse depois do lobby, de cenas e de painéis. Botões modais visíveis
-- continuam liberando o cursor; um botão dentro de um painel fechado não interfere.
local function updatePointer()
	if not UserInputService.MouseEnabled or not windowFocused then
		return
	end
	local campaign = ReplicatedStorage:FindFirstChild("CampaignState")
	local free = mode == "cinema"
		or mode == "capture"
		or mode == "spectate"
		or player:GetAttribute("ModeMenuOpen") == true
		or (campaign ~= nil and campaign:GetAttribute("Phase") == "Lost")
		or GuiService.MenuIsOpen
		or UserInputService:GetFocusedTextBox() ~= nil
	if not free then
		for button in modalButtons do
			if not button.Modal then
				continue
			end
			local visible = true
			local ancestor: Instance? = button
			while ancestor and ancestor ~= player.PlayerGui do
				if
					(ancestor:IsA("GuiObject") and not ancestor.Visible)
					or (ancestor:IsA("ScreenGui") and not ancestor.Enabled)
				then
					visible = false
					break
				end
				ancestor = ancestor.Parent
			end
			if visible and ancestor == player.PlayerGui then
				free = true
				break
			end
		end
	end
	UserInputService.MouseBehavior = if free then Enum.MouseBehavior.Default else Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = free
end

local function approach(current: number, target: number, rate: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

-- Desfaz a rotação extra do quadro anterior antes do módulo de câmera do Roblox rodar.
local function undo()
	local camera = workspace.CurrentCamera
	if camera and appliedCamera == camera and applied ~= CFrame.identity then
		camera.CFrame = camera.CFrame * applied:Inverse()
	end
	applied = CFrame.identity
end

local function positionOffset(dt: number, motion: CharacterController.Motion, root: BasePart): Vector3
	local bobOn = SettingsController.get("bob")
	local shakeOn = SettingsController.get("shake")

	-- Balanço ao andar: fase pela distância percorrida, amplitude pela postura/corrida.
	local targetAmplitude = 0
	if motion.grounded and motion.speed > 0.5 then
		local base = if motion.stance == "Crouch"
			then C.BobCrouchAmplitude
			elseif motion.sprinting then C.BobSprintAmplitude
			else C.BobAmplitude
		targetAmplitude = base * math.clamp(motion.speed / P.WalkSpeed, 0.3, 1.4)
	end
	bobAmplitude = approach(bobAmplitude, targetAmplitude, 10, dt)
	bobPhase += motion.speed * dt * C.BobFrequency * math.pi
	local offset = Vector3.zero
	if bobOn then
		offset += Vector3.new(math.sin(bobPhase) * bobAmplitude * 0.55, -math.abs(math.cos(bobPhase)) * bobAmplitude, 0)
		-- Respiração parada (mais forte e rápida exausto ou com medo).
		local rate = C.IdleBreathRate * (1 + motion.exhaustion * 1.6 + fearSmooth * 0.8)
		breathClock += dt * rate * math.pi * 2
		local amplitude = C.IdleBreathAmplitude * (1 + motion.exhaustion * 2.2 + fearSmooth)
		offset += Vector3.new(0, math.sin(breathClock) * amplitude, 0)
	end

	-- Pouso: mola amortecida.
	local accel = -140 * landOffset - 16 * landVelocity
	landVelocity += accel * dt
	landOffset += landVelocity * dt
	if shakeOn then
		offset += Vector3.new(0, math.clamp(landOffset, -0.9, 0.3), 0)
	end

	-- Agachar: altura do olho suave, compensando a mudança física do HipHeight.
	crouchAlpha = approach(crouchAlpha, if motion.stance == "Crouch" then 1 else 0, C.CrouchSpeed, dt)
	local floorY = motion.floorY
	if crouchAlpha > 0.002 and motion.grounded and floorY then
		local standEye = floorY + motion.standHipHeight + root.Size.Y / 2 + 1.5
		local desiredEye = standEye - C.CrouchEyeDrop * crouchAlpha
		local actualEye = root.Position.Y + 1.5
		offset += Vector3.new(0, math.clamp(desiredEye - actualEye, -3, 1.5), 0)
	end
	return offset
end

local function rotationOffset(dt: number, motion: CharacterController.Motion, now: number): CFrame
	local tiltOn = SettingsController.get("tilt")
	local shakeOn = SettingsController.get("shake")

	-- Inclinação lateral (strafe) + balanço de exaustão.
	local targetTilt = if tiltOn then -motion.lateral / P.WalkSpeed * C.StrafeTilt else 0
	tilt = approach(tilt, math.clamp(targetTilt, -C.StrafeTilt * 1.3, C.StrafeTilt * 1.3), 8, dt)
	local sway = if tiltOn then math.sin(now * 1.7) * motion.exhaustion * 1.4 else 0
	local roll = math.rad(tilt + sway)
	local pitch = if tiltOn then math.rad(math.sin(now * 3.4) * motion.exhaustion * 0.6) else 0

	-- Tremor por trauma (quadrático) + leve tremor de pânico.
	trauma = math.max(0, trauma - C.TraumaDecay * dt)
	local panic = if fearSmooth > 0.8 then (fearSmooth - 0.8) * 0.6 else 0
	local amount = math.max(trauma, panic)
	if shakeOn and amount > 0 then
		local angle = math.rad(C.ShakeMaxAngle) * amount * amount
		local t = now * 18
		pitch += angle * math.noise(noiseSeed, t)
		roll += angle * math.noise(noiseSeed + 40, t)
		local yaw = angle * math.noise(noiseSeed + 80, t)
		-- Coice do pouso inclina para baixo junto com o mergulho.
		pitch += math.rad(math.clamp(landOffset, -0.9, 0) * 4)
		return CFrame.Angles(pitch, yaw, roll)
	end
	if shakeOn then
		pitch += math.rad(math.clamp(landOffset, -0.9, 0) * 4)
	end
	return CFrame.Angles(pitch, 0, roll)
end

local function fieldOfView(dt: number, motion: CharacterController.Motion): number
	sprintAlpha = approach(sprintAlpha, if motion.sprinting and motion.speed > P.WalkSpeed then 1 else 0, 4, dt)
	punch = approach(punch, 0, 3.2, dt)
	if not SettingsController.get("fov") then
		return P.FieldOfView
	end
	local fov = P.FieldOfView
		+ C.SprintFov * sprintAlpha
		- C.FearFovNarrow * fearSmooth ^ 1.5
		+ C.PunchFov * punch
		- captureZoom
	return math.clamp(fov, 40, 95)
end

local function updateHidden(camera: Camera)
	local origin = hiddenOrigin
	if not origin then
		return
	end
	local delta = UserInputService:GetMouseDelta()
	hiddenYaw = math.clamp(hiddenYaw - delta.X * 0.004, math.rad(-32), math.rad(32))
	hiddenPitch = math.clamp(hiddenPitch - delta.Y * 0.004, math.rad(-18), math.rad(14))
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = origin * CFrame.Angles(0, hiddenYaw, 0) * CFrame.Angles(hiddenPitch, 0, 0)
end

local function updateCapture(camera: Camera, now: number, dt: number)
	camera.CameraType = Enum.CameraType.Scriptable
	local from = captureFrom or camera.CFrame
	captureFrom = from
	local elapsed = now - captureStarted
	-- Hit-stop: segura a imagem por HIT_STOP segundos (a thread segue livre).
	if elapsed < HIT_STOP then
		camera.CFrame = from
		return
	end
	local targetFn = captureTarget
	local target = if targetFn then targetFn() else nil
	local look = if target then CFrame.lookAt(from.Position, target) else from
	local t = math.clamp((elapsed - HIT_STOP) / 0.22, 0, 1)
	local eased = 1 - (1 - t) ^ 3
	local base = from:Lerp(look, eased)
	if SettingsController.get("fov") then
		captureZoom = approach(captureZoom, 22, 6, dt)
	end
	local shake = CFrame.identity
	if SettingsController.get("shake") then
		local angle = math.rad(3.2) * math.max(0, 1 - elapsed / 1.6)
		shake = CFrame.Angles(angle * math.noise(noiseSeed, now * 30), angle * math.noise(noiseSeed + 9, now * 30), 0)
	end
	camera.CFrame = base * shake
end

local function apply(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	local motion = CharacterController.getMotion()
	fearSmooth = approach(fearSmooth, fear, 3, dt)

	if mode == "cinema" then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = cinemaFrame
		camera.Focus = CFrame.new(cinemaFocus)
		camera.FieldOfView = if SettingsController.get("fov") then cinemaFov else P.FieldOfView
		return
	elseif mode == "spectate" then
		local character = spectateTarget and spectateTarget.Character
		local head = character and character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			-- Olho do colega, sem câmera livre, zoom ou visão através de paredes.
			local forward = head.CFrame.LookVector
			local offset = forward * (head.Size.Z / 2 + 0.05)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local exclude: { Instance } = { character :: Model }
			if player.Character then
				table.insert(exclude, player.Character)
			end
			params.FilterDescendantsInstances = exclude
			local hit = workspace:Raycast(head.Position, offset, params)
			local eye = if hit then hit.Position - forward * 0.1 else head.Position + offset
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = CFrame.new(eye) * head.CFrame.Rotation
			camera.FieldOfView = P.FieldOfView
		end
		return
	elseif mode == "hidden" then
		updateHidden(camera)
		camera.FieldOfView = fieldOfView(dt, motion)
		return
	elseif mode == "capture" then
		updateCapture(camera, now, dt)
		camera.FieldOfView = fieldOfView(dt, motion)
		return
	end

	local h = humanoid()
	local root = rootPart()
	if h and root then
		local offset = positionOffset(dt, motion, root)
		currentOffset = offset
		h.CameraOffset = offset
	end
	local rotation = rotationOffset(dt, motion, now)
	camera.CFrame = camera.CFrame * rotation
	applied = rotation
	appliedCamera = camera
	camera.FieldOfView = fieldOfView(dt, motion)
end

local CameraController = {
	Name = "CameraController",
}

function CameraController.setCinema(frame: CFrame, fov: number, focus: Vector3?): boolean
	if mode == "capture" or mode == "hidden" or mode == "spectate" then
		return false
	end
	undo()
	if mode ~= "cinema" and workspace.CurrentCamera then
		cinemaReturnFrame = workspace.CurrentCamera.CFrame
	end
	mode = "cinema"
	cinemaFrame = frame
	cinemaFov = fov
	cinemaFocus = focus or (frame.Position + frame.LookVector * 20)
	return true
end

function CameraController.endCinema()
	if mode == "cinema" then
		CameraController.reset()
	end
end

function CameraController.setSpectator(target: Player?)
	if target then
		if mode == "capture" then
			return
		end
		undo()
		spectateTarget = target
		mode = "spectate"
	elseif mode == "spectate" then
		CameraController.reset()
	end
end

-- Tremor: soma trauma (0..1). O efeito é quadrático (pequenos valores quase não aparecem).
function CameraController.addTrauma(amount: number)
	trauma = math.clamp(trauma + amount, 0, 1)
end

-- Compatível com a API antiga: amplitude ~ trauma (a duração vem do decaimento).
function CameraController.shake(amount: number, _duration: number?)
	CameraController.addTrauma(math.clamp(amount * 4, 0, 1))
end

-- Pancada de FOV (ex.: o Vigia te viu). 1 = PunchFov graus.
function CameraController.punch(amount: number?)
	punch = math.max(punch, amount or 1)
end

-- Medo 0..1 (FearController empurra a cada quadro).
function CameraController.setFear(value: number)
	fear = math.clamp(value, 0, 1)
end

-- Pouso (0..1): mergulho + coice.
function CameraController.land(intensity: number)
	landVelocity -= 6 * math.clamp(intensity, 0, 1)
	CameraController.addTrauma(0.25 * intensity)
end

-- Entra/sai do modo esconderijo. `eye` = posição e direção do olhar pela fresta.
function CameraController.setHidden(eye: CFrame?)
	local camera = workspace.CurrentCamera
	if eye then
		undo()
		hiddenOrigin = eye
		hiddenYaw = 0
		hiddenPitch = 0
		mode = "hidden"
	elseif mode == "hidden" then
		hiddenOrigin = nil
		mode = "normal"
		if camera then
			camera.CameraType = Enum.CameraType.Custom
		end
	end
end

-- Captura: hit-stop, vira para `target()` (cabeça do Vigia), zoom e tremor.
function CameraController.capture(target: () -> Vector3?)
	if mode == "capture" then
		return
	end
	undo()
	mode = "capture"
	captureStarted = os.clock()
	captureFrom = nil
	captureTarget = target
end

function CameraController.isCapturing(): boolean
	return mode == "capture"
end

-- Volta tudo ao normal (nova rodada, checkpoint, saída de cena).
function CameraController.reset()
	undo()
	local returnFrame = if mode == "cinema" then cinemaReturnFrame else nil
	cinemaReturnFrame = nil
	mode = "normal"
	spectateTarget = nil
	hiddenOrigin = nil
	captureTarget = nil
	captureFrom = nil
	captureZoom = 0
	trauma = 0
	punch = 0
	tilt = 0
	landOffset = 0
	landVelocity = 0
	fear = 0
	fearSmooth = 0
	applied = CFrame.identity
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid()
		if returnFrame then
			camera.CFrame = returnFrame
		end
		local root = rootPart()
		if root then
			camera.Focus = CFrame.new(root.Position + Vector3.new(0, 1.5, 0))
		end
		camera.FieldOfView = P.FieldOfView
	end
	local h = humanoid()
	if h then
		h.CameraOffset = Vector3.zero
	end
end

-- Para testes/depuração.
function CameraController.debugState(): { [string]: any }
	return {
		mode = mode,
		mouseBehavior = UserInputService.MouseBehavior.Name,
		spectating = if spectateTarget then spectateTarget.UserId else nil,
		trauma = trauma,
		fear = fearSmooth,
		crouch = crouchAlpha,
		offset = currentOffset,
		fov = if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView else 0,
	}
end

function CameraController.Start()
	local playerGui = player:WaitForChild("PlayerGui")
	local function track(instance: Instance)
		if instance:IsA("GuiButton") then
			modalButtons[instance] = true
		end
	end
	for _, instance in playerGui:GetDescendants() do
		track(instance)
	end
	playerGui.DescendantAdded:Connect(track)
	playerGui.DescendantRemoving:Connect(function(instance: Instance)
		if instance:IsA("GuiButton") then
			modalButtons[instance] = nil
		end
	end)
	UserInputService.WindowFocused:Connect(function()
		windowFocused = true
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		windowFocused = false
	end)
	CharacterController.onLanded(function(intensity: number)
		CameraController.land(intensity)
	end)
	RunService:BindToRenderStep("S9CameraUndo", Enum.RenderPriority.Camera.Value - 1, undo)
	RunService:BindToRenderStep("S9CameraApply", Enum.RenderPriority.Camera.Value + 1, apply)
	RunService:BindToRenderStep("S9CameraPointer", Enum.RenderPriority.Last.Value + 1, updatePointer)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="325">
          <Properties>
            <string name="Name">CampaignController</string>
            <string name="Source"><![CDATA[--!strict
-- HUD cooperativo: objetivo acionável, orientação progressiva, barras, inventário e guia sob demanda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Catalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local HouseCatalog = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Guide = require("@game/ReplicatedStorage/Shared/Game/PlayerGuide")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Hud = require("../UI/FieldHud")
local Juice = require("../UI/Juice")
local Theme = require("../UI/Theme")
local Character = require("./CharacterController")
local AudioController = require("./AudioController")

type FieldSlot = Hud.Slot

local player = Players.LocalPlayer
local Controller = { Name = "CampaignController" }
local guideToggle: (() -> ())? = nil
function Controller.toggleGuide()
	if guideToggle then
		guideToggle()
	end
end
local messages: { [string]: string } = {
	progress = "Etapa certa! Continue seguindo a pista.",
	solved = "Objetivo concluído!",
	need_partner = "Chame um amigo para apertar este mesmo botão!",
	wrong_sequence = "Ops! Botão errado, mas seus acertos continuam salvos.",
	repair_order = "Aperte o botão aceso: desligar, trocar o fusível e ligar.",
	story_order = "Complete as pistas e os itens necessários. H abre o guia.",
	rescuing = "Ajudando... fique pertinho do seu amigo!",
	rescued = "Amigo de pé de novo!",
	rescue_cancelled = "Ajuda interrompida. Chegue perto e tente de novo.",
	too_far = "Chegue mais perto e mire no objeto.",
	vote_recorded = "Voto registrado! Esperando o time.",
	not_active = "Espere um amigo te ajudar ou o próximo capítulo.",
	party_full = "O time está cheio. Espere uma vaga.",
	restarting = "Nova aventura!",
	wait = "Só um instante...",
	occupied = "Já tem alguém escondido aí!",
	hide_enter = "Escondido! E para sair · Espaço/Z para prender o ar",
	hide_exit = "Você saiu do esconderijo.",
	not_available = "Isso não dá para fazer agora.",
	not_playing = "Espere o próximo capítulo.",
	door_opened = "Passagem aberta!",
	spawn_failed = "Você entra no próximo capítulo.",
	second_chance = "Segunda chance: você levantou!",
	continue_used = "O time volta para o começo deste capítulo.",
	checkpoint_restored = "Tentando de novo deste capítulo!",
	supply_full = "Já está cheio. Seu item continua na mochila.",
	need_flashlight = "Recolha a lanterna antes de usar uma pilha.",
}

function Controller.Start()
	if GameState.wait():GetAttribute("CampaignActive") ~= true then
		return
	end
	local state = ReplicatedStorage:WaitForChild("CampaignState", 15)
	assert(state, "[CampaignUI] missing campaign state")
	local ui = Hud.build(player:WaitForChild("PlayerGui"))
	local helpOpen, teamHeld = false, false
	guideToggle = function()
		helpOpen = not helpOpen
	end
	local actions = game:GetService("ContextActionService")
	actions:BindAction("HouseGuideTouch", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			helpOpen = not helpOpen
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonSelect)
	ui.close.Activated:Connect(function()
		helpOpen, teamHeld = false, false
	end)
	local tasks: { Guide.Activity } = {}
	local roster: { any } = {}
	local function decodeTasks()
		tasks = HttpService:JSONDecode((state:GetAttribute("Tasks") or "[]") :: string)
	end
	local function decodeRoster()
		roster = HttpService:JSONDecode((state:GetAttribute("Roster") or "[]") :: string)
	end
	state:GetAttributeChangedSignal("Tasks"):Connect(decodeTasks)
	state:GetAttributeChangedSignal("Roster"):Connect(decodeRoster)
	decodeTasks()
	decodeRoster()
	local feedbackUntil = 0
	player:GetAttributeChangedSignal("CampaignFeedbackSerial"):Connect(function()
		ui.feedback.Text = messages[tostring(player:GetAttribute("CampaignFeedback"))]
			or "Isso não dá para fazer agora."
		feedbackUntil = os.clock() + 4
		Juice.pop(ui.feedback, 0.25)
	end)

	-- Moedas e nível: animam quando sobem.
	local shownCoins = (tonumber(player:GetAttribute("Fichas")) or 0) :: number
	local function refreshCoins()
		local value = (tonumber(player:GetAttribute("Fichas")) or 0) :: number
		if value > shownCoins then
			local gain = value - shownCoins
			Juice.count(shownCoins, value, 0.6, function(current)
				ui.coins.Text = `{current}`
			end)
			Juice.pop(ui.wallet, 0.2)
			Juice.floatText(ui.canvas, `+{gain}`, UDim2.new(1, -100, 0, 80), Theme.Coin, 30)
		else
			ui.coins.Text = `{value}`
		end
		shownCoins = value
	end
	local shownLevel = (tonumber(player:GetAttribute("Level")) or 1) :: number
	local function refreshLevel()
		local value = (tonumber(player:GetAttribute("Level")) or 1) :: number
		ui.level.Text = `NÍVEL {value}`
		if value > shownLevel then
			Juice.pop(ui.level.Parent :: GuiObject, 0.3)
			Juice.confetti(ui.canvas, Vector2.new(0.5, 0.35), 48)
			Juice.floatText(ui.canvas, `NÍVEL {value}!`, UDim2.fromScale(0.5, 0.62), Theme.Good, 40, 1.6)
		end
		shownLevel = value
	end
	-- Moedas pegas no capítulo atual (para o resumo da comemoração).
	local chapterCoins = 0
	player:GetAttributeChangedSignal("CoinPickupSerial"):Connect(function()
		chapterCoins += 1
	end)
	local function celebrate(big: boolean, title: string, detail: string)
		Juice.confetti(ui.canvas, Vector2.new(0.5, 0.3), if big then 90 else 50)
		if big then
			Juice.confetti(ui.canvas, Vector2.new(0.2, 0.35), 40)
			Juice.confetti(ui.canvas, Vector2.new(0.8, 0.35), 40)
		end
		Juice.floatText(ui.canvas, title, UDim2.fromScale(0.5, 0.4), Theme.Hazard, if big then 54 else 44, 2.2)
		task.delay(0.35, function()
			Juice.floatText(ui.canvas, detail, UDim2.fromScale(0.5, 0.5), Theme.Text, 26, 2)
		end)
		AudioController.play("StingerWin", if big then 0.9 else 0.6, 1, true)
	end
	-- Legenda das batidas do Tung Tung (vem do CreatureVisualController quando ele está perto).
	player:GetAttributeChangedSignal("TungKnockSerial"):Connect(function()
		if ui.gui.Enabled then
			Juice.floatText(ui.canvas, "TUM... TUM... TUM...", UDim2.fromScale(0.5, 0.3), Theme.Accent, 30, 1.2)
		end
	end)
	player:GetAttributeChangedSignal("Fichas"):Connect(refreshCoins)
	player:GetAttributeChangedSignal("Level"):Connect(refreshLevel)
	refreshCoins()
	refreshLevel()

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not ui.gui.Enabled then
			return
		end
		if input.KeyCode == Enum.KeyCode.H then
			helpOpen = not helpOpen
		elseif input.KeyCode == Enum.KeyCode.Tab then
			teamHeld = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Tab then
			teamHeld = false
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		teamHeld = false
	end)
	local function setSlot(slot: FieldSlot, count: number, text: string)
		slot.count.Text = text
		slot.icon.TextTransparency = if count > 0 then 0 else 0.6
	end
	local elapsed, stageAt, lastStage, lastObjective, lastSolved = 0, 0, "", "", -1
	local lastPhase = ""
	RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0
		local phase = tostring(state:GetAttribute("Phase"))
		local stage = (state:GetAttribute("Stage") or 0) :: number
		if phase ~= lastPhase then
			if phase == "Intermission" then
				celebrate(false, `CAPÍTULO {stage} CONCLUÍDO!`, `{chapterCoins} moedas neste capítulo`)
			elseif phase == "Won" then
				celebrate(true, "VOCÊS ESCAPARAM!", `{chapterCoins} moedas no último capítulo`)
			end
			lastPhase = phase
		end
		local story = state:GetAttribute("GameMode") == "Story"
		local status = player:GetAttribute("CampaignStatus") :: string?
		local cinema = player:GetAttribute("CinematicActive") == true
		ui.gui.Enabled = phase ~= "Lobby" and not cinema and state:GetAttribute("Building") ~= true
		local legacy = player.PlayerGui:FindFirstChild("GameUi")
		if legacy and legacy:IsA("ScreenGui") then
			legacy.Enabled = false
		end
		if not ui.gui.Enabled then
			teamHeld = false
			player:SetAttribute("FieldGuideOpen", false)
			return
		end
		local key = `{state:GetAttribute("Seed")}:{stage}:{story}`
		if key ~= lastStage then
			lastStage, stageAt, helpOpen = key, os.clock(), false
			chapterCoins = 0
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local factor = ui.resize(camera.ViewportSize)
		local touch = UserInputService.TouchEnabled
		local activity, index = Guide.current(tasks)
		local now = workspace:GetServerTimeNow()
		local briefingRemaining =
			math.max(0, math.ceil(((state:GetAttribute("StorySceneEndsAt") or 0) :: number) - now))
		local title, detail = Guide.objective(if briefingRemaining > 0 then "Briefing" else phase, status, activity)
		local active = status == "Active" and phase == "Playing" and briefingRemaining == 0
		local activePlayers = 0
		local downed: any = nil
		for _, member in roster do
			if member.status == "Active" then
				activePlayers += 1
			end
			if member.status == "Downed" then
				downed = member
			end
		end
		local roleId = player:GetAttribute("CampaignRole")
		local roleTitle, roleDescription = "TIME", ""
		for _, role in Catalog.Roles do
			if role.id == roleId then
				roleTitle, roleDescription = role.title, role.description
			end
		end
		-- O papel completo fica no guia; o cabeçalho divide espaço com o destino da floresta.
		ui.chapter.Text = `{if story then "CAPÍTULO" else "NOITE"} {stage}/{#HouseCatalog.Chapters}`
		ui.title.Text = title
		if title ~= lastObjective then
			lastObjective = title
			Juice.pop(ui.order, 0.08)
		end
		ui.destination.Text = if active and activity then `{Guide.roomName(activity.room)}` else "CASA DO TUNG TUNG"
		ui.action.Text = if active and activity then Guide.instruction(activity, now, activePlayers) else detail
		if touch then
			ui.action.Text = ui.action.Text
				:gsub("aperte E", "toque AÇÃO")
				:gsub("Aperte E", "Toque AÇÃO")
				:gsub("H abre o guia", "GUIA mostra as pistas")
		end
		if phase == "Won" then
			local remaining = math.max(0, math.ceil((tonumber(state:GetAttribute("LobbyReturnAt")) or now) - now))
			ui.action.Text = `Voltando ao lobby com a equipe em {remaining}s`
		end
		local solved = (state:GetAttribute("Solved") or 0) :: number
		local total = math.max(1, (state:GetAttribute("Total") or 1) :: number)
		ui.progressFill.Size = UDim2.fromScale(math.clamp(solved / total, 0, 1), 1)
		ui.progress.Text = `{solved}/{total}`
		if solved > lastSolved and lastSolved >= 0 then
			Juice.pop(ui.progress, 0.6)
		end
		lastSolved = solved
		if phase == "Intermission" then
			local remaining = math.max(
				0,
				math.ceil(((state:GetAttribute("NextStageAt") or 0) :: number) - workspace:GetServerTimeNow())
			)
			ui.action.Text = `Próximo capítulo em {remaining}s`
		end
		if briefingRemaining > 0 then
			ui.action.Text = `Começa em {briefingRemaining}s...`
		end
		if status == "Downed" and phase ~= "Lost" then
			for _, member in roster do
				if member.id == player.UserId then
					ui.action.Text = `Espere um amigo te levantar: {math.max(0, math.ceil(member.downedUntil - now))}s`
				end
			end
		end
		ui.dossier.Visible = helpOpen or teamHeld
		player:SetAttribute("FieldGuideOpen", ui.dossier.Visible)
		ui.order.Visible = not ui.dossier.Visible
		ui.tipPanel.Visible = not touch and active and not ui.dossier.Visible and camera.ViewportSize.Y / factor >= 560
		local tipAge = os.clock() - stageAt
		ui.tip.Text = if tipAge < 16
			then Guide.StageTips[math.clamp(stage, 1, #Guide.StageTips)]
			else Guide.SurvivalTips[(math.floor((tipAge - 16) / 18) % #Guide.SurvivalTips) + 1]
		if downed and active then
			ui.tip.Text = `{downed.name} caiu! Chegue perto, mire e aperte E para ajudar.`
		end

		-- Barras de fôlego, lanterna e ar.
		local stamina, maximum = Character.getStamina()
		local battery = player:GetAttribute("Battery")
		local light = math.clamp(if type(battery) == "number" then battery else 0, 0, 1)
		local oxygen = math.clamp((tonumber(player:GetAttribute("Oxygen")) or 100) :: number, 0, 100)
		local breath = math.clamp(stamina / math.max(maximum, 1e-3), 0, 1)
		ui.setBar(ui.bars.stamina, breath, `FÔLEGO {math.floor(breath * 100)}%`, breath < 0.2)
		ui.setBar(ui.bars.battery, light, `LANTERNA {math.floor(light * 100)}%`, light < 0.15)
		ui.setBar(ui.bars.oxygen, oxygen / 100, `AR {math.floor(oxygen)}%`, oxygen < 25)
		ui.equipment.Text = if player:GetAttribute("Stance") == "Crouch" then "AGACHADO (silencioso)" else ""
		if phase == "Extracting" then
			ui.action.Text = `{if stage >= 6 then "CORRA PARA O RESGATE!" else "FUJA PARA O PORTÃO!"} {math.max(
				0,
				math.ceil(((state:GetAttribute("EscapeEndsAt") or 0) :: number) - now)
			)}s`
		end
		if oxygen < 15 then
			ui.action.Text = "O AR ESTÁ ACABANDO! Solte a respiração!"
		end

		-- Inventário do time e itens pessoais.
		local inventory = HttpService:JSONDecode((state:GetAttribute("Inventory") or "{}") :: string)
		local stock = HttpService:JSONDecode((player:GetAttribute("HouseSupplies") or "{}") :: string)
		local keys = (inventory.key_living or 0) + (inventory.key_kitchen or 0) + (inventory.key_dining or 0)
		local fuses = (inventory.fuse_1 or 0) + (inventory.fuse_2 or 0) + (inventory.fuse_3 or 0)
		setSlot(ui.slots.keys, keys, `{keys}/3`)
		setSlot(ui.slots.fuses, fuses, `{fuses}/3`)
		setSlot(ui.slots.artifact, inventory.artifact or 0, `{inventory.artifact or 0}`)
		setSlot(ui.slots.battery, stock.battery or 0, `{stock.battery or 0}`)
		setSlot(ui.slots.oxygen, stock.oxygen or 0, `{stock.oxygen or 0}`)
		setSlot(ui.slots.decoy, stock.decoy or 0, `{stock.decoy or 0}`)
		ui.inventory.Text =
			`CHAVES {keys}/3 · FUSÍVEIS {fuses}/3 · ARTEFATO {inventory.artifact or 0}\n1 PILHA {stock.battery or 0} · 2 AR {stock.oxygen or 0} · 3 ISCA {stock.decoy or 0}`
		ui.footer.Visible = status == "Active" and not ui.dossier.Visible
		ui.bars.battery.frame.Visible = player:GetAttribute("HasFlashlight") == true
		ui.tray.Visible = not touch and status == "Active" and not ui.dossier.Visible
		ui.controls.Visible = not touch and active and not ui.dossier.Visible and camera.ViewportSize.X / factor >= 900

		if ui.dossier.Visible then
			local lines = {
				`SEU PAPEL: {roleTitle}\n{roleDescription}`,
				if story
					then "MISSÃO\nFaçam os objetivos na ordem abaixo. O marcado é o próximo. São oito capítulos: fujam da casa, atravessem a floresta e alcancem o resgate!"
					else "DESAFIO\nDividam as tarefas disponíveis entre colegas. Coletem em qualquer ordem; mecanismos exigem as pistas e os itens. A seta é uma sugestão.",
				"OBJETIVOS",
			}
			for n, item in tasks do
				table.insert(
					lines,
					`{if item.solved
						then "[FEITO]"
						elseif item.available == false then "[TRANCADO]"
						elseif n == index then "[AGORA]"
						else "-"} {n}. {Guide.roomName(item.room)}\n{item.title or Catalog.KindNames[item.kind]}{if item.solved
						then ""
						elseif item.available == false then "\nComplete as pistas e os itens anteriores."
						else `\n{Guide.instruction(item, now, activePlayers)}`}`
				)
			end
			table.insert(lines, "TIME")
			local statusTitles: { [string]: string } = {
				Active = "na ativa",
				Downed = "precisa de ajuda",
				Waiting = "esperando",
				Escaped = "a salvo",
			}
			for _, member in roster do
				local remaining = if member.status == "Downed"
					then ` ({math.max(0, math.ceil(member.downedUntil - workspace:GetServerTimeNow()))}s)`
					else ""
				table.insert(lines, `{member.name}: {statusTitles[member.status] or member.status}{remaining}`)
			end
			if roleId == "scout" and active then
				local world = workspace:FindFirstChild("CursedHouse")
				local stations = world and world:FindFirstChild("CampaignActivities")
				local character = player.Character
				if stations and character then
					for _, model in stations:GetChildren() do
						local point = model:FindFirstChild("Station")
						if
							point
							and point:IsA("BasePart")
							and (point.Position - character:GetPivot().Position).Magnitude
								<= Config.Campaign.ScoutRange
						then
							table.insert(lines, `RADAR: {model:GetAttribute("RoomLabel") or "objetivo"} por perto!`)
						end
					end
				end
			end
			table.insert(lines, "COMO SOBREVIVER\n" .. table.concat(Guide.SurvivalTips, "\n\n"))
			table.insert(
				lines,
				"CONTROLES\nWASD andar · E usar · F lanterna\nShift correr · C agachar · Z/LB prender o ar\n1 pilha · 2 ar extra · 3 isca\nH guia · segure TAB para ver o time\nSetas: trocar de amigo quando estiver assistindo"
			)
			ui.pages.Text = table.concat(lines, "\n\n")
			if touch then
				ui.pages.Text = ui.pages.Text:gsub("aperte E", "toque AÇÃO"):gsub("Aperte E", "Toque AÇÃO")
				local controlsAt = ui.pages.Text:find("CONTROLES", 1, true)
				if controlsAt then
					ui.pages.Text = ui.pages.Text:sub(1, controlsAt - 1)
						.. "CONTROLES DE TOQUE\nArraste no lado livre da tela para olhar. Use o direcional para andar e o botão do Roblox para pular.\nAÇÃO usa o objeto na mira, ajuda colegas e sai do armário.\nCORRER liga/desliga a corrida; AGACHAR reduz o barulho.\nNo armário, segure O AR e solte para respirar.\nMOCHILA abre pilhas, ar extra e iscas. GUIA mostra objetivos e time; AJUSTES controla efeitos e áudio."
				end
			end
			local bounds = TextService:GetTextSize(
				ui.pages.Text,
				ui.pages.TextSize,
				Enum.Font.GothamMedium,
				Vector2.new(math.max(120, ui.pages.AbsoluteSize.X), 100000)
			)
			ui.pages.Size = UDim2.new(1, -16, 0, bounds.Y + 24)
		end
		ui.waypoint.Visible = active and (activity ~= nil or phase == "Extracting") and not ui.dossier.Visible
		if ui.waypoint.Visible then
			local world = workspace:FindFirstChild("CursedHouse")
			local stations = world and world:FindFirstChild("CampaignActivities")
			local model = stations and activity and stations:FindFirstChild(activity.id)
			local station = model and model:FindFirstChild("Station")
			local target = if phase == "Extracting"
				then Vector3.new(0, 4, if stage >= 6 then 870 else 106)
				elseif station and station:IsA("BasePart") then station.Position + Vector3.new(0, 4, 0)
				else nil
			if target then
				local point, onScreen = camera:WorldToViewportPoint(target)
				local viewport = ui.viewport()
				local width, height = viewport.X / factor, viewport.Y / factor
				local x, y =
					(point.X - ui.canvas.AbsolutePosition.X) / factor, (point.Y - ui.canvas.AbsolutePosition.Y) / factor
				if point.Z < 0 then
					x, y = width - x, height - y
				end
				local margin = if touch then 80 else 130
				local top = if touch then math.min(height * 0.52, 180) else 170
				x, y =
					math.clamp(x, margin, math.max(margin, width - margin)),
					math.clamp(y, top, math.max(top, height - (if touch then 140 else 170)))
				ui.waypoint.Position = UDim2.fromOffset(x, y)
				local distance = math.floor((target - camera.CFrame.Position).Magnitude / 3.57)
				local direction = if onScreen then "" elseif x < width / 2 then "" else ""
				local name = if phase == "Extracting"
					then (if stage >= 6 then "RESGATE" else "SAÍDA DA CASA")
					else Guide.roomName((activity :: Guide.Activity).room)
				ui.waypoint.Text = `{direction} {name}\n{distance} m`
			else
				ui.waypoint.Visible = false
			end
		end
		if os.clock() > feedbackUntil then
			ui.feedback.Text = ""
		end
		local storyUi = player.PlayerGui:FindFirstChild("StoryUi")
		local recording = storyUi and storyUi:FindFirstChild("RecoveredRecording")
		ui.feedback.Visible = not ui.dossier.Visible
			and not (
				storyUi
				and storyUi:IsA("ScreenGui")
				and storyUi.Enabled
				and recording
				and recording:IsA("GuiObject")
				and recording.Visible
			)
	end)
	if RunService:IsStudio() then
		local ok, args = pcall(function()
			return game:GetService("StudioTestService"):GetTestArgs()
		end)
		if ok and type(args) == "table" and args.campaignQA then
			local function qaRequest()
				local command = player:GetAttribute("CampaignQARequest")
				if type(command) ~= "string" then
					return
				end
				local request = HttpService:JSONDecode(command)
				task.spawn(function()
					local result: any
					if request.restart then
						result = Remotes.clientFunction("RequestRestart", 10):InvokeServer()
					elseif request.select then
						local selected = require("./InteractionController").testInteract(request.id)
						result = {
							ok = true,
							data = {
								accepted = selected and player:GetAttribute("CampaignAccepted") == true,
								message = if selected
									then player:GetAttribute("CampaignFeedback")
									else "client_target_unavailable",
							},
						}
					elseif request.breath ~= nil then
						Remotes.clientEvent("SetHoldBreath", 10):FireServer(request.breath)
						result = { ok = true }
					else
						result = Remotes.clientFunction("Interact", 10):InvokeServer(request.id)
					end
					player:SetAttribute(
						"CampaignQAResponse",
						HttpService:JSONEncode({ serial = request.serial, result = result })
					)
				end)
			end
			player:GetAttributeChangedSignal("CampaignQARequest"):Connect(qaRequest)
			qaRequest()
		end
	end
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="326">
          <Properties>
            <string name="Name">CharacterAnimatorController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Poses procedurais locais sobre o Animator, sem alterar física, velocidade ou autoridade.
	Somam ao C0/Attachment0 de cada junta (a animação padrão continua por cima):
	olhar (LookPitch), agachar (pernas dobram e o corpo visível sobe o que faltar), inclinação na
	corrida, lanterna na mão, ajoelhar no resgate e caído de lado quando incapacitado.
	As poses atualizam a 30 Hz; a lanterna dos colegas acompanha a mão a cada quadro.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Pose = require("@game/ReplicatedStorage/Shared/Game/CharacterPose")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Camera = require("./CameraController")

type Joint = Motor6D | AnimationConstraint
type Rig = {
	model: Model,
	motors: { [string]: Joint },
	bases: { [Joint]: CFrame },
	pitch: number,
	crouch: number,
	lamp: BasePart?,
	light: SpotLight?,
	hipHeight: number,
	-- Comprimentos medidos nas juntas (coxa, canela + pé) para ajoelhar/agachar no chão.
	thigh: number,
	shin: number,
	feedbackSerial: any,
	feedbackAt: number,
	-- Correção medida no pé real (cada avatar tem proporções próprias).
	liftFix: number,
}
local rigs: { [Player]: Rig } = {}
local player = Players.LocalPlayer
local lastPitch: number? = nil
local since = 10
local step = 0
local Controller = { Name = "CharacterAnimatorController" }

-- Avatares novos usam AnimationConstraint; o offset base vive no Attachment0.
local function writeBase(joint: Joint, frame: CFrame)
	if joint:IsA("Motor6D") then
		joint.C0 = frame
	elseif joint.Attachment0 then
		joint.Attachment0.CFrame = frame
	end
end

local function readBase(joint: Joint): CFrame
	if joint:IsA("Motor6D") then
		return joint.C0
	end
	return if joint.Attachment0 then joint.Attachment0.CFrame else CFrame.identity
end

-- Ponto da junta no lado da peça 0 (C0) ou da peça 1 (C1), no espaço daquela peça.
local function jointPoint(joint: Joint?, side: number): Vector3?
	if not joint then
		return nil
	end
	if joint:IsA("Motor6D") then
		return if side == 0 then joint.C0.Position else joint.C1.Position
	end
	local attachment = if side == 0 then joint.Attachment0 else joint.Attachment1
	return if attachment then attachment.CFrame.Position else nil
end

-- Ponto mais baixo (Y) de uma peça girada.
local function lowestY(part: BasePart): number
	local half = part.Size / 2
	local lowest = math.huge
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				lowest = math.min(lowest, (part.CFrame * Vector3.new(half.X * x, half.Y * y, half.Z * z)).Y)
			end
		end
	end
	return lowest
end

-- Distância entre duas juntas que prendem a mesma peça (ex.: quadril e joelho na coxa).
local function segment(upper: Joint?, lower: Joint?, fallback: number): number
	local a, b = jointPoint(upper, 1), jointPoint(lower, 0)
	if a and b then
		local length = (a - b).Magnitude
		if length > 0.2 and length < 4 then
			return length
		end
	end
	return fallback
end

local function remove(other: Player)
	local rig = rigs[other]
	if not rig then
		return
	end
	for motor, base in rig.bases do
		if motor.Parent then
			writeBase(motor, base)
		end
	end
	if rig.lamp then
		rig.lamp:Destroy()
	end
	rigs[other] = nil
end

local function getRig(other: Player): Rig?
	local model = other.Character
	-- A Roblox monta attachments/offsets depois do CharacterAdded; aguarde o rig completo.
	if not model or not other:HasAppearanceLoaded() then
		return nil
	end
	local old = rigs[other]
	-- Avatar pode chegar em partes: não congele um cache criado antes dos Motor6Ds.
	if old and old.model == model and old.motors.Neck then
		return old
	end
	remove(other)
	local h = model and model:FindFirstChildOfClass("Humanoid")
	if not model or not h then
		return nil
	end
	local rig: Rig = {
		model = model,
		motors = {},
		bases = {},
		pitch = 0,
		crouch = 0,
		lamp = nil,
		light = nil,
		hipHeight = math.max(tonumber(model:GetAttribute("StandHipHeight")) or h.HipHeight, 1.2),
		thigh = 1,
		shin = 1,
		feedbackSerial = other:GetAttribute("CampaignFeedbackSerial"),
		feedbackAt = -math.huge,
		liftFix = 0,
	}
	for _, inst in model:GetDescendants() do
		if inst:IsA("Motor6D") or (inst:IsA("AnimationConstraint") and inst.Attachment0 and inst.Attachment1) then
			rig.motors[inst.Name] = inst
			rig.bases[inst] = readBase(inst)
		end
	end
	rig.thigh = segment(rig.motors.LeftHip, rig.motors.LeftKnee, 1)
	rig.shin = segment(rig.motors.LeftKnee, rig.motors.LeftAnkle, 0.9)
	if other ~= player then
		local lamp = Instance.new("Part")
		lamp.Name = `TeammateFlashlight_{other.UserId}`
		lamp.Size = Vector3.new(0.24, 0.24, 0.65)
		lamp.Color = Color3.fromRGB(55, 60, 53)
		lamp.Anchored = true
		lamp.CanCollide = false
		lamp.CanQuery = false
		lamp.CanTouch = false
		lamp.CastShadow = false
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Front
		light.Range = 28
		light.Angle = 42
		light.Brightness = 1.4
		light.Shadows = false
		light.Color = Color3.fromRGB(255, 230, 182)
		light.Parent = lamp
		lamp.Parent = workspace
		rig.lamp, rig.light = lamp, light
	end
	rigs[other] = rig
	return rig
end

local function joint(rig: Rig, name: string, frame: CFrame)
	local motor = rig.motors[name]
	if motor then
		writeBase(motor, rig.bases[motor] * frame)
	end
end

local function animate(other: Player, dt: number)
	local rig = getRig(other)
	if not rig then
		return
	end
	local root = rig.model:FindFirstChild("HumanoidRootPart")
	local h = rig.model:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not h then
		return
	end
	local crouch = other:GetAttribute("Stance") == "Crouch"
	rig.crouch = Pose.approach(rig.crouch, if crouch then 1 else 0, 12, dt)
	rig.pitch = Pose.approach(rig.pitch, (other:GetAttribute("LookPitch") :: number?) or 0, 12, dt)
	local down = other:GetAttribute("CampaignStatus") == "Downed"
	-- "rescuing" é o último aviso da campanha; vale só pelo tempo de um resgate (o aviso pode ficar).
	local serial = other:GetAttribute("CampaignFeedbackSerial")
	if serial ~= rig.feedbackSerial then
		rig.feedbackSerial = serial
		rig.feedbackAt = os.clock()
	end
	local rescue = not down
		and other:GetAttribute("CampaignFeedback") == "rescuing"
		and os.clock() - rig.feedbackAt < Config.Campaign.ReviveSeconds + 0.75
	local on = other:GetAttribute(Tags.Attr.Flashlight) == true
		and (other:GetAttribute("Hidden") == nil or other:GetAttribute("Hidden") == "")
	local neck, waist = Pose.split(rig.pitch)
	local angle, lift = Pose.crouch(rig.thigh + rig.shin, math.max(0, rig.hipHeight - h.HipHeight))
	angle *= rig.crouch
	local lean = Pose.lean(root.AssemblyLinearVelocity.Magnitude, Config.Player.WalkSpeed, Config.Player.SprintSpeed)
	for motor, base in rig.bases do
		if motor.Parent then
			writeBase(motor, base)
		end
	end
	local rootBase = rig.motors.Root and rig.bases[rig.motors.Root]
	if down then
		-- Caído de lado: o corpo gira no quadril e desce até o ombro tocar o chão.
		local floorY = root.Position.Y - root.Size.Y / 2 - h.HipHeight
		local pivotY = root.Position.Y + (if rootBase then rootBase.Position.Y else 0)
		local drop = math.max(0, pivotY - floorY - 0.95)
		joint(rig, "Root", CFrame.new(0, -drop, 0) * CFrame.Angles(math.rad(-8), 0, math.rad(84)))
		joint(rig, "RootJoint", CFrame.Angles(0, 0, math.rad(84)))
		joint(rig, "Neck", CFrame.Angles(math.rad(-18), math.rad(20), 0))
		joint(rig, "Waist", CFrame.Angles(math.rad(-12), 0, 0))
		joint(rig, "LeftHip", CFrame.Angles(math.rad(35), 0, 0))
		joint(rig, "LeftKnee", CFrame.Angles(math.rad(-55), 0, 0))
		joint(rig, "RightHip", CFrame.Angles(math.rad(12), 0, 0))
		joint(rig, "RightKnee", CFrame.Angles(math.rad(-25), 0, 0))
		joint(rig, "RightShoulder", CFrame.Angles(math.rad(70), 0, 0))
		joint(rig, "LeftShoulder", CFrame.Angles(math.rad(20), 0, 0))
	elseif rescue then
		-- Ajoelhado ao lado do colega: joelho direito no chão, pé esquerdo à frente, mãos estendidas.
		joint(rig, "Root", CFrame.new(0, -rig.thigh, 0))
		joint(rig, "Waist", CFrame.Angles(math.rad(-22), 0, 0))
		joint(rig, "Neck", CFrame.Angles(math.rad(-20), 0, 0))
		joint(rig, "LeftHip", CFrame.Angles(math.rad(85), 0, 0))
		joint(rig, "LeftKnee", CFrame.Angles(math.rad(-85), 0, 0))
		joint(rig, "RightHip", CFrame.Angles(math.rad(-4), 0, 0))
		joint(rig, "RightKnee", CFrame.Angles(math.rad(-88), 0, 0))
		joint(rig, "RightAnkle", CFrame.Angles(math.rad(30), 0, 0))
		joint(rig, "RightShoulder", CFrame.Angles(math.rad(55), 0, 0))
		joint(rig, "LeftShoulder", CFrame.Angles(math.rad(50), 0, 0))
		joint(rig, "LeftElbow", CFrame.Angles(math.rad(-20), 0, 0))
	else
		joint(rig, "Neck", CFrame.Angles(math.rad(neck), 0, 0))
		joint(rig, "Waist", CFrame.Angles(math.rad(waist - lean - 14 * rig.crouch), 0, 0))
		joint(rig, "LeftHip", CFrame.Angles(angle, 0, 0))
		joint(rig, "RightHip", CFrame.Angles(angle, 0, 0))
		joint(rig, "LeftKnee", CFrame.Angles(-2 * angle, 0, 0))
		joint(rig, "RightKnee", CFrame.Angles(-2 * angle, 0, 0))
		joint(rig, "LeftAnkle", CFrame.Angles(angle, 0, 0))
		joint(rig, "RightAnkle", CFrame.Angles(angle, 0, 0))
		if on then
			joint(rig, "RightShoulder", CFrame.Angles(math.rad(65 + rig.pitch * 0.5), 0, math.rad(8)))
			joint(rig, "RightElbow", CFrame.Angles(math.rad(-35), 0, 0))
		end
		joint(rig, "Root", CFrame.new(0, (lift + rig.liftFix) * rig.crouch, 0))
		-- Agachado e parado no chão: mede o pé mais baixo e corrige a altura até ele encostar.
		if rig.crouch > 0.9 and h.FloorMaterial ~= Enum.Material.Air then
			local left, right = rig.model:FindFirstChild("LeftFoot"), rig.model:FindFirstChild("RightFoot")
			if left and right and left:IsA("BasePart") and right:IsA("BasePart") then
				local floorY = root.Position.Y - root.Size.Y / 2 - h.HipHeight
				local gap = math.min(lowestY(left), lowestY(right)) - floorY
				rig.liftFix = math.clamp(rig.liftFix - gap * 0.5, -1.5, 1.5)
			end
		end
	end
end

-- Lanterna do colega: a cada quadro na mão (a pose roda a 30 Hz; a mão anda a 60).
local function placeLamp(other: Player, rig: Rig)
	local root = rig.model:FindFirstChild("HumanoidRootPart")
	local h = rig.model:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not h then
		return
	end
	local down = other:GetAttribute("CampaignStatus") == "Downed"
	local on = other:GetAttribute(Tags.Attr.Flashlight) == true
		and (other:GetAttribute("Hidden") == nil or other:GetAttribute("Hidden") == "")
	local lamp, light = rig.lamp, rig.light
	if lamp and light then
		local camera = workspace.CurrentCamera
		local near = camera ~= nil and (camera.CFrame.Position - root.Position).Magnitude < 100
		local visible = on and near and not down and h.Health > 0
		lamp.Transparency = if visible then 0 else 1
		light.Enabled = visible
		local hand = rig.model:FindFirstChild("RightHand") or rig.model:FindFirstChild("Right Arm")
		if hand and hand:IsA("BasePart") then
			lamp.CFrame = CFrame.new(hand.Position)
				* root.CFrame.Rotation
				* CFrame.Angles(math.rad(rig.pitch), 0, 0)
				* CFrame.new(0, -0.1, -0.3)
		end
	end
end

function Controller.debugState(): { [string]: any }
	local count, lamps = 0, 0
	local joints = 0
	local constraints = 0
	for _, rig in rigs do
		count += 1
		if rig.lamp then
			lamps += 1
		end
		for _, motor in rig.motors do
			joints += 1
			if motor:IsA("AnimationConstraint") then
				constraints += 1
			end
		end
	end
	return { rigs = count, lamps = lamps, lastPitch = lastPitch, joints = joints, constraints = constraints }
end

function Controller.Start()
	Players.PlayerRemoving:Connect(remove)
	player.CharacterAdded:Connect(function()
		lastPitch = nil
		since = 10
	end)
	RunService.PreSimulation:Connect(function(dt)
		since += dt
		local camera = workspace.CurrentCamera
		local mode = Camera.debugState().mode
		if camera and mode ~= "cinema" and mode ~= "spectate" then
			local pitch = Pose.quantizePitch(math.deg(math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))))
			if Pose.shouldSend(lastPitch, pitch, since) then
				lastPitch, since = pitch, 0
				Remotes.clientEvent("SetLook", 5):FireServer(pitch)
			end
		end
		step += dt
		if step < 1 / 30 then
			return
		end
		local elapsed = step
		step = 0
		for _, other in Players:GetPlayers() do
			animate(other, elapsed)
		end
	end)
	RunService.RenderStepped:Connect(function()
		for other, rig in rigs do
			if rig.lamp and rig.model.Parent then
				placeLamp(other, rig)
			end
		end
	end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="327">
          <Properties>
            <string name="Name">CharacterController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Corpo do jogador em primeira pessoa (cliente). A câmera em si fica no CameraController.
	- Corrida com fôlego (Shift) e aceleração/frenagem com peso (WalkSpeed em rampa).
	- Exaustão: fôlego zerado = passos lentos e ofegantes por ExhaustedTime.
	- Agachar: C alterna, Ctrl segura (controle: B). O pedido vai ao servidor (SetStance), que
	  valida o teto e muda o corpo (HipHeight). Levantar sem espaço é recusado aqui e lá.
	- Detecta pousos (para o tranco de câmera e o som).
	O servidor valida a velocidade e decide o resultado mecânico (ver PlayerStateService).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")

export type Stance = "Stand" | "Crouch"

export type Motion = {
	-- Velocidade horizontal real (studs/s) e componente lateral no espaço da câmera.
	speed: number,
	lateral: number,
	sprinting: boolean,
	stance: Stance,
	-- 0..1: quão "sem fôlego" (exaustão recente).
	exhaustion: number,
	grounded: boolean,
	floorY: number?,
	floorMaterial: Enum.Material?,
	floorPart: BasePart?,
	standHipHeight: number,
	hidden: boolean,
}

local P = Config.Player
local player = Players.LocalPlayer

local stamina = P.StaminaMax
local exhaustedUntil = 0
local exhaustion = 0
local sprinting = false
local phase: GameState.Phase = "Loading"
local currentSpeed = P.WalkSpeed
local requested: Stance = "Stand"
local requestedAt = 0
local crouchHeld = false
local toggledCrouch = false
local lastStandTry = 0
local standHipHeight = 2
local peakFall = 0
local landedCallbacks: { (number) -> () } = {}
local blockedCallbacks: { () -> () } = {}
local lastBlockedAt = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local motion: Motion = {
	speed = 0,
	lateral = 0,
	sprinting = false,
	stance = "Stand",
	exhaustion = 0,
	grounded = true,
	floorY = nil,
	floorMaterial = nil,
	floorPart = nil,
	standHipHeight = 2,
	hidden = false,
}

local function humanoid(): Humanoid?
	local character = player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

local function rootPart(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function disableCoreUi()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	task.spawn(function()
		for _ = 1, 20 do
			local ok = pcall(function()
				StarterGui:SetCore("ResetButtonCallback", false)
			end)
			if ok then
				return
			end
			task.wait(0.5)
		end
	end)
end

-- Postura confirmada pelo servidor (atributo no Player).
local function serverStance(): Stance
	if player:GetAttribute("Stance") == "Crouch" then
		return "Crouch"
	end
	return "Stand"
end

local function isHidden(): boolean
	local hidden = player:GetAttribute("Hidden")
	return type(hidden) == "string" and hidden ~= ""
end

local function active(): boolean
	local status = player:GetAttribute("CampaignStatus")
	return status == nil or status == "Active"
end

-- Há espaço acima da cabeça para levantar? (o servidor faz a mesma checagem)
local function canStand(): boolean
	local root = rootPart()
	local character = player.Character
	if not root or not character then
		return true
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.RespectCanCollide = true
	params.CollisionGroup = root.CollisionGroup
	local height = P.CrouchDrop + P.StandClearance
	-- Topo da cabeça agachado ~ centro da raiz + 2.3.
	local center = root.Position + Vector3.new(0, 2.3 + height / 2, 0)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(1.6, height, 1.2), params)
	return #parts == 0
end

local function sendStance(stance: Stance)
	requested = stance
	requestedAt = os.clock()
	task.spawn(function()
		local ok, remote = pcall(Remotes.clientEvent, "SetStance", 5)
		if ok then
			remote:FireServer(stance)
		end
	end)
end

local function desiredStance(): Stance
	if crouchHeld or toggledCrouch then
		return "Crouch"
	end
	return "Stand"
end

-- Leva a postura pedida ao servidor. Levantar só com espaço (avisa a UI se faltar).
local function syncStance(now: number)
	if phase ~= "Playing" or isHidden() or not active() then
		return
	end
	local desired = desiredStance()
	local confirmed = serverStance()
	if desired == requested and (desired == confirmed or now - requestedAt < 0.6) then
		return
	end
	if desired == "Crouch" then
		sendStance("Crouch")
		return
	end
	if now - lastStandTry < 0.25 then
		return
	end
	lastStandTry = now
	if not canStand() then
		if now - lastBlockedAt > 2.5 then
			lastBlockedAt = now
			for _, callback in blockedCallbacks do
				task.spawn(callback)
			end
		end
		return
	end
	sendStance("Stand")
end

local function currentStance(): Stance
	-- O pedido vale por um instante (resposta do servidor a caminho); depois manda o servidor.
	if os.clock() - requestedAt < 0.6 then
		return requested
	end
	return serverStance()
end

local function probeFloor(root: BasePart, character: Model)
	rayParams.FilterDescendantsInstances = { character }
	local hit =
		workspace:Raycast(root.Position, Vector3.new(0, -(root.Size.Y / 2 + standHipHeight + 1.5), 0), rayParams)
	if hit then
		motion.floorY = hit.Position.Y
		motion.floorMaterial = hit.Material
		motion.floorPart = if hit.Instance:IsA("BasePart") then hit.Instance else nil
	else
		motion.floorY = nil
		motion.floorMaterial = nil
		motion.floorPart = nil
	end
end

local function update(dt: number)
	local h = humanoid()
	local root = rootPart()
	local character = player.Character
	if not h or not root or not character then
		return
	end
	local now = os.clock()
	local hidden = isHidden()
	motion.hidden = hidden

	-- C alterna, Ctrl segura. Sem teto para levantar, continua agachado e tenta de novo.
	syncStance(now)
	local stance: Stance = currentStance()

	local moving = h.MoveDirection.Magnitude > 0.1
	local wantsSprint = player:GetAttribute("TouchSprint") == true
		or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.ButtonL3)
	if stamina <= 0 and exhaustedUntil < now then
		exhaustedUntil = now + P.ExhaustedTime
	end
	local exhausted = now < exhaustedUntil or (stamina < P.StaminaMinToSprint and exhaustedUntil > now - 2)
	sprinting = phase == "Playing"
		and active()
		and wantsSprint
		and moving
		and not exhausted
		and stance == "Stand"
		and not hidden

	-- Melhoria "Fôlego de Maratona" (nível publicado pelo StoreService): mais fôlego e recarga.
	local lungs = Perks.factor("folego", tonumber(player:GetAttribute("PerkFolego")) or 0)
	local staminaMax = P.StaminaMax * lungs
	if sprinting then
		stamina = math.max(0, stamina - dt)
	else
		stamina = math.min(staminaMax, stamina + dt * P.StaminaRegen * lungs * (if moving then 0.7 else 1))
	end
	local exhaustionTarget = if now < exhaustedUntil then 1 else math.clamp(1 - stamina / staminaMax, 0, 1) * 0.5
	exhaustion += (exhaustionTarget - exhaustion) * math.min(1, dt * (if exhaustionTarget > exhaustion then 4 else 0.5))

	-- Velocidade em rampa (peso).
	local target = if stance == "Crouch"
		then P.CrouchSpeed
		elseif sprinting then P.SprintSpeed
		elseif now < exhaustedUntil then P.ExhaustedSpeed
		else P.WalkSpeed
	if not moving then
		target = math.min(target, P.WalkSpeed * 0.45)
	end
	local rate = if target > currentSpeed then P.Acceleration else P.Deceleration
	currentSpeed += math.clamp(target - currentSpeed, -rate * dt, rate * dt)
	if phase == "Playing" and active() and not hidden then
		h.WalkSpeed = math.max(currentSpeed, P.WalkSpeed * 0.45)
		h.JumpHeight = if stance == "Crouch" then 0 else P.JumpHeight
	end

	-- Medidas para câmera e sons.
	local velocity = root.AssemblyLinearVelocity
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local camera = workspace.CurrentCamera
	motion.speed = horizontal.Magnitude
	motion.lateral = if camera then camera.CFrame.RightVector:Dot(horizontal) else 0
	motion.sprinting = sprinting
	motion.stance = stance :: Stance
	motion.exhaustion = exhaustion
	motion.grounded = h.FloorMaterial ~= Enum.Material.Air
	motion.standHipHeight = standHipHeight
	probeFloor(root, character)

	-- Queda: guarda a maior velocidade de descida até pousar.
	if not motion.grounded then
		peakFall = math.max(peakFall, -velocity.Y)
	elseif peakFall > 0 then
		local fall = peakFall
		peakFall = 0
		if fall >= Config.Camera.LandingMinSpeed then
			local intensity = math.clamp(
				(fall - Config.Camera.LandingMinSpeed) / (Config.Camera.LandingMaxSpeed - Config.Camera.LandingMinSpeed),
				0.15,
				1
			)
			for _, callback in landedCallbacks do
				task.spawn(callback, intensity)
			end
		end
	end
end

local CharacterController = {
	Name = "CharacterController",
}

function CharacterController.Init()
	-- Primeira pessoa travada (definido no cliente: no servidor não replica de forma confiável).
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMaxZoomDistance = 0.5
	player.CameraMinZoomDistance = 0.5
	disableCoreUi()
	UserInputService.MouseIconEnabled = false
end

function CharacterController.Start()
	local actions = game:GetService("ContextActionService")
	actions:BindAction("HouseSprintTouch", function(_, state)
		player:SetAttribute("TouchSprint", state == Enum.UserInputState.Begin)
		return Enum.ContextActionResult.Sink
	end, false)
	actions:BindAction("HouseCrouchTouch", function(_, state)
		if state == Enum.UserInputState.Begin then
			CharacterController.requestStance(if serverStance() == "Stand" then "Crouch" else "Stand")
		end
		return Enum.ContextActionResult.Sink
	end, false)
	UserInputService.WindowFocusReleased:Connect(function()
		player:SetAttribute("TouchSprint", false)
	end)

	GameState.observe(function(snapshot)
		if snapshot.phase ~= phase and snapshot.phase == "Intro" then
			stamina = P.StaminaMax
			exhaustedUntil = 0
			exhaustion = 0
			requested = "Stand"
			toggledCrouch = false
			crouchHeld = false
		end
		phase = snapshot.phase
	end)

	player.CharacterAdded:Connect(function(character: Model)
		local h = character:WaitForChild("Humanoid", 10)
		if h and h:IsA("Humanoid") then
			-- Altura de pé de referência (o servidor muda o HipHeight ao agachar).
			standHipHeight = (character:GetAttribute("StandHipHeight") :: number?) or h.HipHeight
		end
		requested = "Stand"
		toggledCrouch = false
		peakFall = 0
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active() then
			return
		end
		if input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.ButtonB then
			if not crouchHeld then
				toggledCrouch = not toggledCrouch
			end
		elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
			crouchHeld = true
			toggledCrouch = false
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
			crouchHeld = false
		end
	end)

	RunService.RenderStepped:Connect(update)
end

function CharacterController.getStamina(): (number, number)
	return stamina, P.StaminaMax * Perks.factor("folego", tonumber(player:GetAttribute("PerkFolego")) or 0)
end

function CharacterController.isSprinting(): boolean
	return sprinting
end

function CharacterController.getMotion(): Motion
	return motion
end

function CharacterController.onLanded(callback: (intensity: number) -> ())
	table.insert(landedCallbacks, callback)
end

-- Chamado quando o jogador tenta levantar sem espaço (a UI mostra um aviso).
function CharacterController.onStandBlocked(callback: () -> ())
	table.insert(blockedCallbacks, callback)
end

-- Força uma postura (ex.: sair do esconderijo de pé). Respeita o teto.
function CharacterController.requestStance(stance: Stance)
	toggledCrouch = stance == "Crouch"
	crouchHeld = false
end

return CharacterController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="328">
          <Properties>
            <string name="Name">CinematicController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Cenas locais; a fase e o relógio da partida continuam sendo decididos pelo servidor.

	  Opening  primeira vez no lobby (antes do menu de modo) e cartela da missão solo (briefing nas legendas);
	  Attract  câmeras de segurança em laço atrás do menu de modo, enquanto a equipe vota;
	  Escape   vitória, da estrada;
	  Story*   capítulos do modo história (o StoryController chama play()).

	Sem tirar a câmera, durante o congelamento do servidor: cartela de etapa do modo padrão com o olho
	abrindo, despertar no início da missão solo e ao ser resgatado.
	Planos de câmera de segurança (CinematicShots.isCctv) andam a 12 quadros/s com cor de CFTV; planos
	na mão são lisos. O próprio personagem aparece nas câmeras. Espaço/A/botão pula (o laço do lobby só
	some com o menu). Movimento reduzido: planos estáticos e olhos abrindo sem tremida.

	Atributos locais do jogador: CinematicActive (cena no ar: HUDs e mão somem), CinematicHold (cena de
	verdade: avisos da loja esperam) e OpeningActive (abertura do lobby: o menu de modo espera).
]]
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local CampaignCatalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Shots = require("@game/ReplicatedStorage/Shared/Game/CinematicShots")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/Presentation")
local HouseCatalog = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Camera = require("./CameraController")
local Settings = require("./SettingsController")
local Transition = require("./TransitionController")
local Store = require("./StoreController")
local Animator = require("./CharacterAnimatorController")
local TungTungRig = require("../Creature/TungTungRig")
local ArmadilhoRig = require("../Creature/ArmadilhoRig")
local AudioController = require("./AudioController")
local Create = require("../UI/Create")
local Theme = require("../UI/Theme")

local CCTV_FPS = 12

export type PlayOptions = {
	-- Repete a sequência até stop() (laço do lobby).
	loop: boolean?,
	-- Sem faixas de cinema nem botão de pular (fica atrás do menu).
	quiet: boolean?,
	-- Troca as legendas da sequência (ex.: briefing da missão solo).
	captions: { string }?,
}

local player = Players.LocalPlayer
local sequence: Shots.Sequence? = nil
local options: PlayOptions = {}
local elapsed = 0
local lastShot = 0
local lastKey = ""
local lastCaption: string? = nil
local ownsTitle = false
local openingSeen = false
local skipButton: TextButton? = nil
local cctvTint: ColorCorrectionEffect? = nil
-- LocalTransparencyModifier original das peças do próprio corpo (aparece nas câmeras).
local revealed: { [BasePart]: number } = {}
local cardToken = 0
local Controller = { Name = "CinematicController" }

-- Participação do Tung Tung nas cenas (só visual, só neste cliente).
-- Abertura: surge na porta na última tomada e bate o bastão. Laço do lobby: anda pela varanda.
local cameo: TungTungRig.TungRig? = nil
local cameoClock = 0
local armadilho: Model? = nil
local epilogueLight: BasePart? = nil
local epilogueShot = 0
local teaser: Frame? = nil
local teaserCountdown: TextLabel? = nil
-- Junto à porta e virado para as câmeras do quintal (o modelo olha para -Z).
local PORCH = CFrame.lookAt(Vector3.new(3, -0.5, 65.6), Vector3.new(8, -0.5, 74))

local function dropCameo()
	if armadilho then
		armadilho:Destroy()
		armadilho = nil
	end
	if epilogueLight then
		epilogueLight:Destroy()
		epilogueLight = nil
	end
	epilogueShot = 0
	if cameo then
		cameo.model:Destroy()
		cameo = nil
	end
end

local function ensureCameo(): TungTungRig.TungRig?
	if not cameo then
		cameo = TungTungRig.build(nil)
		if cameo then
			cameo.model.Name = "TungTungCameo"
			cameo.model.Parent = workspace
			cameoClock = 0
		end
	end
	return cameo
end

local function updateCameo(current: Shots.Sequence, index: number, dt: number)
	if current.name == "Opening" and not options.loop then
		if index < #current.shots then
			dropCameo()
			return
		end
		local rig = ensureCameo()
		if not rig then
			return
		end
		cameoClock += dt
		TungTungRig.place(rig, PORCH)
		if cameoClock < 0.6 then
			TungTungRig.play(rig, "idle", 0)
		elseif TungTungRig.playing(rig) == "idle" and cameoClock < 1 then
			TungTungRig.play(rig, "slash", 0.15, 0.9)
		end
		TungTungRig.step(rig, dt)
	elseif current.name == "Attract" and options.loop then
		local rig = ensureCameo()
		if not rig then
			return
		end
		cameoClock += dt
		-- Trajeto oval: desacelera e vira pelo próprio arco, sem inverter 180 graus de uma vez.
		local angle = cameoClock * math.pi / 8
		local position = Vector3.new(2 + 7 * math.sin(angle), -0.5, 67 + math.cos(angle))
		local velocity = Vector3.new(7 * math.cos(angle), 0, -math.sin(angle)) * math.pi / 8
		TungTungRig.place(rig, CFrame.lookAt(position, position + velocity))
		TungTungRig.play(rig, "walk", 0.3, math.clamp(velocity.Magnitude / 3.5, 0.35, 1))
		TungTungRig.step(rig, dt)
	elseif current.name == "ForestRescue" and (index == 2 or index == 3) then
		local actor = ensureCameo()
		if actor then
			actor.eyeLight.Enabled = false
			TungTungRig.place(actor, CFrame.lookAt(Vector3.new(-7, 0, 830), Vector3.new(-7, 0, 850)))
			TungTungRig.play(actor, "idle", 0.2)
			TungTungRig.step(actor, dt)
		end
		if not armadilho then
			armadilho = ArmadilhoRig.build(workspace)
		end
		local crocodile = armadilho :: Model
		cameoClock += dt
		crocodile:PivotTo(
			CFrame.lookAt(
				Vector3.new(7, math.sin(cameoClock * 1.4) * 0.06, 828 + math.min(1.5, cameoClock * 0.15)),
				Vector3.new(7, 0, 850)
			)
		)
		if not epilogueLight then
			local lamp = Instance.new("Part")
			lamp.Name, lamp.Anchored, lamp.Transparency = "RescueHeadlights", true, 1
			lamp.CanCollide, lamp.CanQuery, lamp.CanTouch = false, false, false
			lamp.CFrame = CFrame.lookAt(Vector3.new(0, 8, 847), Vector3.new(0, 4, 830))
			local light = Instance.new("SpotLight")
			light.Angle, light.Range, light.Brightness, light.Shadows = 85, 52, 3.8, true
			light.Color, light.Parent = Color3.fromRGB(212, 194, 156), lamp
			lamp.Parent, epilogueLight = workspace, lamp
		end
		if epilogueShot ~= index then
			epilogueShot = index
			AudioController.play(if index == 2 then "DoorBang" else "Roar", 0.65, 0.65)
		end
	else
		dropCameo()
	end
end

local function vec(v: Shots.Vec): Vector3
	return Vector3.new(v.x, v.y, v.z)
end

local function sink(): Enum.ContextActionResult
	return Enum.ContextActionResult.Sink
end

local function campaignState(): Instance?
	return if Config.Campaign.Enabled then ReplicatedStorage:FindFirstChild("CampaignState") else nil
end

local function hideSelf()
	for part, value in revealed do
		if part.Parent then
			part.LocalTransparencyModifier = value
		end
	end
	revealed = {}
end

local function showSelf()
	local character = player.Character
	if not character then
		return
	end
	for _, inst in character:GetDescendants() do
		if inst:IsA("BasePart") then
			if revealed[inst] == nil then
				revealed[inst] = inst.LocalTransparencyModifier
			end
			inst.LocalTransparencyModifier = 0
		end
	end
end

local function setCctv(on: boolean)
	if cctvTint then
		cctvTint.Enabled = on
	end
end

function Controller.stop()
	dropCameo()
	local wasActive = sequence ~= nil
	sequence = nil
	options = {}
	lastCaption = nil
	ownsTitle = false
	player:SetAttribute("CinematicActive", false)
	player:SetAttribute("CinematicHold", false)
	player:SetAttribute("OpeningActive", false)
	if skipButton then
		skipButton.Visible = false
	end
	ContextActionService:UnbindAction("S9CinemaMovement")
	Camera.endCinema()
	setCctv(false)
	hideSelf()
	-- Sem cena no ar, não apaga a cartela de etapa nem o despertar (renascer chama stop()).
	if wasActive then
		Transition.reset()
		Transition.reveal(0.25)
	end
end

function Controller.play(value: Shots.Sequence, playOptions: PlayOptions?)
	Controller.stop()
	if Store.isOpen() then
		return
	end
	-- Uma cena nova cancela a cartela/despertar em curso: começa com a tela limpa (olhos abertos).
	cardToken += 1
	Transition.reset()
	sequence = value
	options = playOptions or {}
	elapsed = 0
	lastShot = 0
	player:SetAttribute("CinematicActive", true)
	-- Avisos da loja esperam cenas de verdade (o laço do lobby não segura nada).
	player:SetAttribute("CinematicHold", not options.loop)
	if skipButton then
		skipButton.Visible = false
	end
	ContextActionService:BindActionAtPriority(
		"S9CinemaMovement",
		sink,
		false,
		3000,
		Enum.PlayerActions.CharacterForward,
		Enum.PlayerActions.CharacterBackward,
		Enum.PlayerActions.CharacterLeft,
		Enum.PlayerActions.CharacterRight,
		Enum.PlayerActions.CharacterJump
	)
	if not options.quiet then
		task.spawn(Transition.setLetterbox, true, 0.35)
	end
	-- Laço do lobby é "ao vivo" (REC, hora atual da noite); o resto é fita reproduzida.
	local live = options.loop == true
	Transition.stamp(
		value.shots[1].label,
		if live then "REC" else "PLAY",
		Shots.TAPE_START + (if live then os.time() % 1800 else 0)
	)
	if value.title then
		Transition.title(value.title, value.subtitle)
		ownsTitle = true
	end
end

function Controller.debugState(): { [string]: any }
	return {
		sequence = if sequence then sequence.name else "",
		elapsed = elapsed,
		shot = lastShot,
		loop = options.loop == true,
		caption = lastCaption,
		cctv = cctvTint ~= nil and cctvTint.Enabled,
		revealed = next(revealed) ~= nil,
		openingSeen = openingSeen,
	}
end

local function phaseKey(): (string, string)
	local campaign = campaignState()
	if campaign then
		local phase = tostring(campaign:GetAttribute("Phase"))
		return phase, `{phase}:{campaign:GetAttribute("CampaignId")}:{campaign:GetAttribute("Stage")}`
	end
	local state = GameState.snapshot()
	return state.phase, `{state.phase}:{state.roundId}`
end

local function roleTitle(): string
	local id = player:GetAttribute("CampaignRole")
	for _, role in CampaignCatalog.Roles do
		if role.id == id then
			return role.title
		end
	end
	return "EQUIPE"
end

-- Olhos fecham rápido e abrem pesados (acordar, voltar do resgate).
function Controller.wake(delay: number?)
	cardToken += 1
	local token = cardToken
	task.spawn(function()
		Transition.closeEyes(0.1)
		task.wait(delay or 0.15)
		if token == cardToken then
			Transition.openEyes(1, Settings.motionEnabled())
		end
	end)
end

--[[
	Cartela de etapa (modo padrão): tela escura com "ETAPA N/3", o servidor recria e congela os
	personagens; o olho abre na equipe e a cartela sai. Não mexe na câmera nem nos controles.
]]
function Controller.stageCard()
	local campaign = campaignState()
	if not campaign then
		return
	end
	cardToken += 1
	local token = cardToken
	local stage = tonumber(campaign:GetAttribute("Stage")) or 1
	local title = tostring(campaign:GetAttribute("Title") or "")
	local threat = tostring(campaign:GetAttribute("Threat") or "")
	local character = player.Character
	task.spawn(function()
		local started = os.clock()
		Transition.closeEyes(0.12)
		if token ~= cardToken then
			return
		end
		task.spawn(Transition.setLetterbox, true, 0.3)
		Transition.title(
			`ETAPA {stage}/{#HouseCatalog.Chapters}`,
			`{title}\n{if threat ~= "" then `AMEAÇA: {threat}  ·  ` else ""}VOCÊ: {roleTitle()}`
		)
		-- Espera o renascimento da etapa (ou o fim do congelamento), no máximo ~3 s no escuro.
		while token == cardToken and os.clock() - started < 3.2 do
			local current = player.Character
			local root = current and current:FindFirstChild("HumanoidRootPart")
			local respawned = current ~= character and root ~= nil
			local released = root ~= nil and root:IsA("BasePart") and not root.Anchored
			if respawned or (released and os.clock() - started > 1.2) then
				break
			end
			task.wait(0.1)
		end
		local rest = 1.1 - (os.clock() - started)
		if rest > 0 then
			task.wait(rest)
		end
		if token ~= cardToken then
			return
		end
		Transition.openEyes(1.1, Settings.motionEnabled())
		task.wait(1.3)
		if token ~= cardToken then
			return
		end
		Transition.title(nil)
		Transition.setLetterbox(false, 0.35)
	end)
end

local function onKeyChanged(phase: string, previous: string)
	-- Troca de fase invalida cartelas antigas; o respawn isolado continua preservando a cartela atual.
	cardToken += 1
	Transition.reset()
	Controller.stop()
	local campaign = campaignState()
	if phase == "Lobby" then
		-- Primeira vez no servidor: a abertura passa antes do menu (o menu espera OpeningActive).
		if not openingSeen then
			openingSeen = true
			Controller.play(Shots.Opening)
			player:SetAttribute("OpeningActive", true)
		end
	elseif phase == "Intro" then
		if not GameState.snapshot().fromCheckpoint then
			Controller.play(Shots.Opening, { captions = Text.Intro })
			player:SetAttribute("OpeningActive", true)
		end
	elseif phase == "Won" then
		Controller.play(
			if campaign and campaign:GetAttribute("ForestActive") == true
				then require("@game/ReplicatedStorage/Shared/Game/ForestCinema")
				else Shots.Escape
		)
	elseif phase == "Playing" and previous ~= "" then
		if campaign and campaign:GetAttribute("GameMode") ~= "Story" then
			Controller.stageCard()
		elseif campaign then
			-- História: a cena do capítulo vem do servidor; só um piscar para marcar o corte.
			task.spawn(Transition.blink, 0.02)
		else
			Controller.wake()
		end
	end
end

local function updateSequence(current: Shots.Sequence, dt: number)
	elapsed += dt
	local total = Shots.duration(current)
	local time = if options.loop then Shots.wrap(current, elapsed) else elapsed
	local index, alpha, done = Shots.locate(current, time)
	if done then
		Controller.stop()
		return
	end
	local shot = current.shots[index]
	if skipButton then
		skipButton.Visible = not options.loop and elapsed >= 0.65
	end
	local nextShot = current.shots[index + 1]
	local cutShade = Presentation.cut(
		alpha,
		shot.duration,
		index > 1 and shot.cut == "blink",
		nextShot ~= nil and nextShot.cut == "blink"
	)
	Transition.sceneShade(if options.quiet then 0 else math.max(Presentation.shade(elapsed, total), cutShade))
	updateCameo(current, index, dt)
	local cctv = Shots.isCctv(shot)
	if lastShot ~= index then
		local first = lastShot == 0
		lastShot = index
		Transition.stamp(shot.label, if options.loop then "REC" else "PLAY")
		if shot.cut == "static" and not first then
			Transition.static(0.22, 0.5)
		end
		setCctv(cctv)
		-- A cartela de abertura fica só no primeiro plano.
		if ownsTitle and not first then
			Transition.title(nil)
			ownsTitle = false
		end
	end
	if ownsTitle and #current.shots == 1 and alpha > 0.55 then
		Transition.title(nil)
		ownsTitle = false
	end
	if not options.loop then
		local line = Shots.caption(options.captions or current.captions, elapsed, total)
		if line ~= lastCaption then
			lastCaption = line
			Transition.caption(line)
		end
	end

	local motion = Settings.motionEnabled()
	local progress = if not motion then 0.5 elseif cctv then Shots.quantize(alpha, shot.duration, CCTV_FPS) else alpha
	local position, look = Shots.sample(shot, progress)
	local frame = CFrame.lookAt(vec(position), vec(look))
	if motion and Settings.get("shake") and shot.handheld > 0 then
		local amount = shot.handheld
		frame *= CFrame.Angles(
			math.noise(elapsed * 0.7, 1.3) * amount * 0.02,
			math.noise(elapsed * 0.6, 7.1) * amount * 0.025,
			math.noise(elapsed * 0.5, 3.7) * amount * 0.015
		)
	end
	if not Camera.setCinema(frame, Shots.lens(shot, progress), vec(look)) then
		Controller.stop()
	end
end

function Controller.Init()
	local gui = Create("ScreenGui", {
		Name = "CinematicControls",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 121,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local button = Create("TextButton", {
		Name = "Skip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0.12, 8),
		Size = UDim2.fromOffset(220, 44),
		BackgroundColor3 = Theme.Panel,
		TextColor3 = Theme.Text,
		FontFace = Theme.Font,
		TextSize = 16,
		Text = if UserInputService.TouchEnabled then "PULAR CENA" else "PULAR CENA [ESPAÇO / A]",
		Modal = true,
		Visible = false,
		Parent = gui,
	}) :: TextButton
	skipButton = button
	local panel = Create("Frame", {
		Name = "NextGame",
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(3, 5, 6),
		BorderSizePixel = 0,
		Visible = false,
	}) :: Frame
	local function cardLine(
		name: string,
		y: number,
		height: number,
		value: string,
		color: Color3,
		maximum: number
	): TextLabel
		local label = Create("TextLabel", {
			Name = name,
			Parent = panel,
			Position = UDim2.fromScale(0.1, y),
			Size = UDim2.fromScale(0.8, height),
			BackgroundTransparency = 1,
			Text = value,
			TextColor3 = color,
			FontFace = Theme.Font,
			TextWrapped = true,
			TextScaled = true,
		}) :: TextLabel
		Create("UITextSizeConstraint", { Parent = label, MinTextSize = 12, MaxTextSize = maximum })
		return label
	end
	cardLine("Kicker", 0.16, 0.07, "PRÓXIMO JOGO", Color3.fromRGB(162, 126, 75), 22)
	cardLine("Title", 0.27, 0.19, "A MANSÃO DO ARMADILHO", Color3.fromRGB(222, 208, 170), 46)
	cardLine(
		"Story",
		0.5,
		0.19,
		"Vocês fugiram da casa e da floresta.\nTung Tung Sahur e Crocodilo Armadilho estão procurando vocês.\nA caçada está só começando.",
		Color3.fromRGB(174, 184, 178),
		23
	)
	teaserCountdown = cardLine("Return", 0.8, 0.07, "CONTINUA...", Color3.fromRGB(147, 154, 150), 17)
	teaser = panel
	button.Activated:Connect(Controller.stop)
	-- Imagem de CFTV com visão noturna: dessaturada, clareada e esverdeada (só nos planos fixos).
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "S9CctvFeed"
	tint.Saturation = -0.8
	tint.Contrast = 0.12
	tint.Brightness = 0.14
	tint.TintColor = Color3.fromRGB(200, 236, 210)
	tint.Enabled = false
	tint.Parent = Lighting
	cctvTint = tint
	-- A ponte usa a VM real dos controllers (execute_luau roda em outra VM).
	if RunService:IsStudio() then
		local bridge = Instance.new("BindableFunction")
		bridge.Name = "AnimationDebugBridge"
		bridge.OnInvoke = function(command: string, value: any): any
			if command == "transition" then
				if value == "reset" then
					Transition.reset()
				elseif value == "caption" then
					Transition.caption("Uma fita. Três pancadas. Não responda.")
				elseif value == "title" then
					Transition.title("CAPÍTULO 08", "A FLORESTA · NINGUÉM FICA PARA TRÁS")
				elseif value == "replace" then
					Transition.title(nil)
					Transition.title("CAPÍTULO 09", "A NOVA FITA")
				end
			elseif command == "scene" then
				local selected = if value == "Escape"
					then Shots.Escape
					elseif value == "Attract" then Shots.Attract
					else Shots.Opening
				Controller.play(selected, if value == "Attract" then { loop = true, quiet = true } else nil)
			elseif command == "skip" then
				Controller.stop()
			elseif command == "stage" then
				Controller.stageCard()
			elseif command == "wake" then
				Controller.wake()
			elseif command == "motion" then
				for _, key in { "bob", "tilt", "shake", "fov", "flashes" } do
					Settings.set(key :: Settings.Key, value == true)
				end
			end
			return {
				cinematic = Controller.debugState(),
				camera = Camera.debugState(),
				transition = Transition.debugState(),
				characters = Animator.debugState(),
				feedback = require("./UiFeedbackController").debugState(),
			}
		end
		bridge.Parent = gui
	end
end

function Controller.Start()
	UserInputService.InputBegan:Connect(function(input, _processed)
		if
			UserInputService:GetFocusedTextBox() == nil
			and sequence
			and not options.loop
			and elapsed >= 0.65
			and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA)
		then
			Controller.stop()
		end
	end)
	player.CharacterRemoving:Connect(Controller.stop)
	-- Resgatado: os olhos abrem de novo.
	local lastStatus = player:GetAttribute("CampaignStatus")
	player:GetAttributeChangedSignal("CampaignStatus"):Connect(function()
		local status = player:GetAttribute("CampaignStatus")
		if lastStatus == "Downed" and status == "Active" then
			Controller.wake(0.2)
		end
		lastStatus = status
	end)
	RunService:BindToRenderStep("S9Cinematic", Enum.RenderPriority.Camera.Value - 2, function(dt)
		local phase, key = phaseKey()
		if key ~= lastKey then
			local previous = lastKey
			lastKey = key
			onKeyChanged(phase, previous)
		end
		local current = sequence
		local state = campaignState()
		local showTeaser = phase == "Won"
			and state ~= nil
			and state:GetAttribute("ForestActive") == true
			and (current == nil or (current.name == "ForestRescue" and lastShot >= 4))
		if teaser then
			teaser.Visible = showTeaser
		end
		player:SetAttribute("ForestEpilogueVisible", showTeaser)
		if showTeaser and teaserCountdown and state then
			local remaining = math.max(
				0,
				math.ceil(
					(tonumber(state:GetAttribute("LobbyReturnAt")) or workspace:GetServerTimeNow())
						- workspace:GetServerTimeNow()
				)
			)
			teaserCountdown.Text = `CONTINUA...  ·  A equipe volta ao lobby em {remaining}s`
		end
		if not current then
			-- Lobby com o menu de modo aberto: câmeras de segurança ao fundo.
			if phase == "Lobby" and player:GetAttribute("ModeMenuOpen") == true and not Store.isOpen() then
				Controller.play(Shots.Attract, { loop = true, quiet = true })
			end
			return
		end
		if Store.isOpen() or player:GetAttribute("CampaignStatus") == "Downed" then
			Controller.stop()
			return
		end
		if options.loop and phase ~= "Lobby" then
			Controller.stop()
			return
		end
		updateSequence(current, dt)
	end)
	-- Depois do módulo de câmera do Roblox (que esconde o corpo em primeira pessoa).
	RunService:BindToRenderStep("S9CinematicSelf", Enum.RenderPriority.Camera.Value + 3, function()
		if sequence then
			showSelf()
		end
	end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="329">
          <Properties>
            <string name="Name">CoinController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Moedas da casa no cliente (só visual): giram e flutuam, e cada coleta solta brilho e "plim".
	A coleta é decidida pelo servidor (CoinService); aqui só lemos os atributos CoinPickup* do jogador.
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AudioController = require("./AudioController")

local player = Players.LocalPlayer
local TAG = "HouseCoin"

local bases: { [BasePart]: CFrame } = {}
local clock = 0

local CoinController = { Name = "CoinController" }

local function track(part: Instance)
	if part:IsA("BasePart") then
		bases[part] = part.CFrame
		part.AncestryChanged:Connect(function(_, parent)
			if not parent then
				bases[part] = nil
			end
		end)
	end
end

local function burst(position: Vector3, gem: boolean)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(if gem then Color3.fromRGB(210, 130, 255) else Color3.fromRGB(255, 214, 70))
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.4, 0.7)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = anchor
	anchor.Parent = workspace
	emitter:Emit(if gem then 40 else 18)
	Debris:AddItem(anchor, 1.5)
end

function CoinController.Start()
	for _, part in CollectionService:GetTagged(TAG) do
		track(part)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(track)
	player:GetAttributeChangedSignal("CoinPickupSerial"):Connect(function()
		local at = player:GetAttribute("CoinPickupAt")
		local gem = player:GetAttribute("CoinPickupGem") == true
		if typeof(at) == "Vector3" then
			burst(at, gem)
		end
		AudioController.play("Coin", if gem then 1.2 else 1, if gem then 0.9 else 1.25 + math.random() * 0.15, true)
		if gem then
			AudioController.play("StingerWin", 0.5, 1.2, true)
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		clock += dt
		local spin = clock * 2.6
		for part, base in bases do
			local bob = math.sin(clock * 2 + base.Position.X * 0.3) * 0.35
			part.CFrame = base * CFrame.new(0, bob, 0) * CFrame.Angles(0, spin, 0) * CFrame.Angles(0, math.rad(90), 0)
		end
	end)
end

return CoinController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="330">
          <Properties>
            <string name="Name">ContinueController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Tela de derrota da campanha (co-op e história). O servidor já repete o capítulo DE GRAÇA,
	sozinho, depois de alguns segundos (CampaignRuntime). Esta tela deixa isso claro com uma contagem.

	Quem já tem Continuação no estoque (ganha em kits/recompensas) pode voltar na hora, sem esperar
	("use_continue"). Não há botão de compra aqui: derrota não é momento de vender nada para criança.
	Quem valida a derrota e reabre a etapa é o servidor (CampaignRuntime via StoreService).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Components = require("../UI/Components")
local Create = require("../UI/Create")
local Juice = require("../UI/Juice")
local Theme = require("../UI/Theme")
local AudioController = require("./AudioController")

local player = Players.LocalPlayer

local Controller = { Name = "ContinueController" }

local panel: Frame? = nil
local primary: TextButton? = nil
local status: TextLabel? = nil
local body: TextLabel? = nil
local setCountdown: ((number) -> ())? = nil
local busy = false
local shown = false
local shownAt = 0
local mouseWas = false

local function stock(): number
	local raw = player:GetAttribute("Consumables")
	if type(raw) ~= "string" then
		return 0
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return if ok and type(data) == "table" then tonumber(data.continuar) or 0 else 0
end

local function say(key: string?)
	if status then
		status.Text = if key then (Text.Messages :: any)[key] or key else ""
	end
end

local function useContinue()
	if busy then
		return
	end
	busy = true
	local ok, result = pcall(function()
		return Remotes.clientFunction("Store", 5):InvokeServer("use_continue")
	end)
	busy = false
	if not ok or type(result) ~= "table" or not result.ok then
		say("store_error")
		return
	end
	local data = result.data
	if type(data) == "table" then
		say(data.message)
		if data.ok then
			AudioController.play("StingerAwaken", 0.6, 1.2, true)
		end
	end
end

local function build()
	local gui = Create("ScreenGui", {
		Name = "ContinueOffer",
		ResetOnSpawn = false,
		DisplayOrder = 70,
		IgnoreGuiInset = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Cartão da derrota: tom calmo (terror leve), contagem visível e nenhuma oferta de compra.
	local p = Components.panel({
		Name = "Offer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(1, -32, 0, 176),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	}, {
		Create("UISizeConstraint", { MaxSize = Vector2.new(620, 220) }),
	})
	local outline = p:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color, outline.Thickness, outline.Transparency = Theme.Danger:Lerp(Theme.Gold, 0.4), 2, 0
	end
	Components.padding(p, 16, 14)
	Components.icon(p, "Replay", 36, Theme.GoldLight)
	Components.title({
		Name = "Title",
		Position = UDim2.fromOffset(48, 0),
		Size = UDim2.new(1, -48, 0, 36),
		Text = "O TUNG TUNG PEGOU O TIME!",
		TextColor3 = Theme.GoldLight,
		TextSize = 24,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = p,
	})
	body = Components.text({
		Name = "Body",
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 40),
		FontFace = Theme.FontNote,
		Text = "",
		TextSize = 15,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = p,
	}) :: TextLabel
	local track, setTrack = Components.progress({
		Name = "Countdown",
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.new(1, 0, 0, 8),
	}, Theme.Gold)
	track.Parent = p
	setCountdown = setTrack
	local b = Components.button("success", {
		Name = "Continue",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(0.6, -6, 0, Theme.TouchMin),
		Text = "",
		TextSize = 15,
		Visible = false,
		Parent = p,
	}, function()
		AudioController.play("UiBlip", 0.5, 1.1, true)
		task.spawn(useContinue)
	end)
	b.Modal = true
	status = Components.text({
		Name = "Status",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0.4, -6, 0, Theme.TouchMin),
		FontFace = Theme.Font,
		Text = "",
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Parent = p,
	}) :: TextLabel
	panel = p
	primary = b
end

function Controller.debugState(): { [string]: any }
	return { shown = shown, stock = stock() }
end

function Controller.Start()
	if GameState.wait():GetAttribute("CampaignActive") ~= true then
		return
	end
	local state = ReplicatedStorage:WaitForChild("CampaignState")
	build()
	RunService.RenderStepped:Connect(function()
		local p, b, text = panel, primary, body
		if not p or not b or not text then
			return
		end
		local visible = state:GetAttribute("Phase") == "Lost" and player:GetAttribute("CinematicActive") ~= true
		if visible ~= shown then
			shown = visible
			p.Visible = visible
			if visible then
				say(nil)
				shownAt = os.clock()
				mouseWas = UserInputService.MouseIconEnabled
				Juice.appear(p)
			else
				UserInputService.MouseIconEnabled = mouseWas
			end
		end
		if visible then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			local remaining = math.max(0, math.ceil(Config.Campaign.IntermissionSeconds - (os.clock() - shownAt)))
			text.Text = if remaining > 0
				then `Calma! Todo mundo volta no começo deste capítulo em {remaining}s, de graça. Os capítulos que vocês já terminaram ficam salvos.`
				else "Voltando para o começo do capítulo..."
			local fill = setCountdown
			if fill then
				-- Barra esvazia até o recomeço grátis (mesma contagem do texto).
				fill(remaining / math.max(Config.Campaign.IntermissionSeconds, 1))
			end
			local count = stock()
			b.Visible = count > 0 and remaining > 0
			-- Sem Continuação no estoque não há botão: o cartão encolhe em vez de sobrar espaço vazio.
			p.Size = UDim2.new(1, -32, 0, if b.Visible then 176 else 124)
			b.Text = `VOLTAR AGORA · CONTINUAÇÕES: {count}`
		end
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="331">
          <Properties>
            <string name="Name">CosmeticController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Cosméticos locais (cliente), lidos dos atributos que o servidor publica no Player
	(StoreService): EquipFlashlight, EquipUniform, EquipFilter.
	- Skin da lanterna: cor/material do corpo e tom do feixe (nunca alcance nem brilho).
	- Manga do braço na mão: cor da farda equipada.
	- Filtro de câmera: troca a gradação "RetroGrade" (tom, saturação, contraste).
	- Placas de título (feitas no servidor, CosmeticService): só aparecem fora da ação
	  (intro/intervalo/fim) ou para quem está esperando/assistindo; no escuro do turno, nada flutua.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local FlashlightController = require("./FlashlightController")
local LightingController = require("./LightingController")

local player = Players.LocalPlayer

local phase: GameState.Phase = "Loading"
local accumulator = 0

local function rgb(c: StoreCatalog.RGB?, fallback: Color3): Color3
	if not c then
		return fallback
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function material(name: string?): Enum.Material
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name or "Metal"]
	end)
	return if ok and value then value else Enum.Material.Metal
end

local function equippedItem(attribute: string, kind: StoreCatalog.ItemKind): StoreCatalog.Item
	local id = player:GetAttribute(attribute)
	local item = if type(id) == "string" then StoreCatalog.ItemById[id] else nil
	if item and item.kind == kind then
		return item
	end
	return StoreCatalog.ItemById[StoreCatalog.defaultFor(kind)]
end

local function applyFlashlight()
	local item = equippedItem("EquipFlashlight", "flashlight")
	FlashlightController.applySkin(
		rgb(item.body, Color3.fromRGB(38, 40, 44)),
		rgb(item.head, Color3.fromRGB(52, 54, 58)),
		rgb(item.beam, Color3.fromRGB(255, 232, 196)),
		material(item.material)
	)
end

local function applyUniform()
	local item = equippedItem("EquipUniform", "uniform")
	FlashlightController.applySleeve(rgb(item.shirt, Color3.fromRGB(46, 58, 54)))
end

local function applyFilter()
	local item = equippedItem("EquipFilter", "filter")
	LightingController.setFilter(item)
end

local function titlesVisible(): boolean
	local status = player:GetAttribute("CampaignStatus")
	return phase ~= "Playing" or status == "Waiting" or status == "Escaped"
end

local function updateTitles()
	local show = titlesVisible()
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local folder = character and character:FindFirstChild("S9Cosmetics")
		local tag = folder and folder:FindFirstChild("TitleTag")
		if tag and tag:IsA("BillboardGui") then
			-- A própria placa nunca aparece (primeira pessoa).
			tag.Enabled = show and other ~= player
		end
	end
end

local CosmeticController = {
	Name = "CosmeticController",
}

function CosmeticController.Start()
	for attribute, apply in
		{
			EquipFlashlight = applyFlashlight,
			EquipUniform = applyUniform,
			EquipFilter = applyFilter,
		} :: { [string]: () -> () }
	do
		player:GetAttributeChangedSignal(attribute):Connect(apply)
		apply()
	end
	GameState.observe(function(snapshot)
		phase = snapshot.phase
		updateTitles()
	end)
	-- Personagens novos (respawn, entrada) recebem placas: revisita algumas vezes por segundo.
	RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator >= 0.5 then
			accumulator = 0
			updateTitles()
		end
	end)
end

return CosmeticController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="332">
          <Properties>
            <string name="Name">CreatureVisualController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Visual da criatura no cliente, separado da simulação:
	- A "Root" invisível do servidor anda liso (pathfinding, 60 Hz).
	- Com o asset ReplicatedStorage.Assets.TungTung presente, o corpo é o Tung Tung com esqueleto
	  e animações (andar, correr, golpe, passo lateral) misturadas pelo estado e pela velocidade.
	- Sem o asset (place antiga), cai no boneco low poly em stop-motion (Rig + Poses).
	Colisão, captura e controles não são afetados. Também cuida dos sons da criatura.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Poses = require("../Creature/Poses")
local Rig = require("../Creature/Rig")
local TungTungRig = require("../Creature/TungTungRig")
local AudioController = require("./AudioController")
local CameraController = require("./CameraController")

local HEIGHT = Config.Creature.Height
local V = Config.Visual

-- Velocidade (studs/s) que os pés percorrem em 1x em cada clipe (medida no bake).
local WALK_FEET_SPEED = 1.55
local RUN_FEET_SPEED = 16.5

local rig: Rig.Rig? = nil
local tung: TungTungRig.TungRig? = nil
local shown = false
local stepClock = 0
local poseClock = 0
local poseIndex = 1
local animation = "Idle"
local displayBase: CFrame? = nil
local lastBasePosition: Vector3? = nil
local smoothSpeed = 0
local lastCycle = 0
local moving = false
local mode = "Dormant"
local headYaw = 0
local chaseLoop: Sound? = nil
local nextGrowlAt = 0
local phase: GameState.Phase = "Loading"
local rng = Random.new()
local reaction = ""
local reactionUntil = 0

local function serverRoot(): BasePart?
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	return if root and root:IsA("BasePart") then root else nil
end

local function visualModel(): Model
	if tung then
		return tung.model
	end
	assert(rig, "[CreatureVisualController] used before Init")
	return rig.model
end

local function emitter(): Attachment
	if tung then
		return tung.emitter
	end
	assert(rig, "[CreatureVisualController] used before Init")
	return rig.emitter
end

local function animationFor(currentMode: string): (string, number)
	if os.clock() < reactionUntil then
		return reaction, 8
	end
	if currentMode == "Chase" then
		return "Chase", V.PoseRate.Chase
	elseif currentMode == "Capture" then
		return "Capture", V.PoseRate.Capture
	elseif currentMode == "Search" then
		return "Search", V.PoseRate.Search
	elseif (currentMode == "Patrol" or currentMode == "Investigate") and moving then
		return "Walk", if currentMode == "Investigate" then V.PoseRate.Investigate else V.PoseRate.Patrol
	end
	return "Idle", V.PoseRate.Idle
end

local function setShown(value: boolean)
	if shown == value then
		return
	end
	shown = value
	visualModel().Parent = if value then workspace else nil
	if not value and chaseLoop then
		chaseLoop:Stop()
	end
end

local function onModeChanged(previous: string, current: string)
	if current == "Chase" and previous ~= "Chase" then
		reaction, reactionUntil = "Notice", os.clock() + 0.38
	elseif current == "Investigate" then
		reaction, reactionUntil = "Sniff", os.clock() + 0.65
	elseif current == "Capture" then
		reaction, reactionUntil = "Lunge", os.clock() + 0.4
	else
		reactionUntil = 0
	end
	if tung then
		-- No Tung Tung as reações viram golpes do bastão (perseguição começa com uma pancada no ar).
		if current == "Capture" then
			TungTungRig.play(tung, "slash", 0.08, 1.15)
			reactionUntil = os.clock() + 1.0
		elseif current == "Chase" and previous ~= "Chase" then
			TungTungRig.play(tung, "slash", 0.1, 1.6)
			reactionUntil = os.clock() + 0.7
		end
	end
	if current == "Chase" and previous ~= "Chase" then
		AudioController.playAt("Snarl", emitter())
		if chaseLoop then
			chaseLoop:Play()
		end
	elseif previous == "Chase" and current ~= "Chase" and chaseLoop then
		chaseLoop:Stop()
	end
	if current == "Capture" and chaseLoop then
		chaseLoop:Stop()
	end
end

local function footstep(root: BasePart, camera: Camera?)
	local distance = if camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge
	AudioController.playAt(
		"CreatureStep",
		emitter(),
		if root:GetAttribute("FalseExit") then 0.25 else 1,
		0.42 + rng:NextNumber(-0.04, 0.04)
	)
	-- Tremor dos passos pela distância (o compositor respeita a opção de conforto).
	if distance < 30 then
		local k = (30 - distance) / 30
		CameraController.addTrauma(0.22 * k * k)
	end
end

local function lookYawAt(base: CFrame, camera: Camera?): number
	if camera and (mode == "Chase" or mode == "Capture" or mode == "Investigate" or mode == "Search") then
		local toCamera = base:PointToObjectSpace(camera.CFrame.Position)
		return math.clamp(math.deg(math.atan2(-toCamera.X, -toCamera.Z)), -50, 50)
	end
	return 0
end

-- Tung Tung: segue a Root a cada quadro, escolhe o clipe pela velocidade/estado e emite passos no ciclo.
local function updateTung(t: TungTungRig.TungRig, root: BasePart, dt: number, camera: Camera?)
	local base = root.CFrame * CFrame.new(0, -HEIGHT / 2, 0)
	local previousBase = displayBase
	if previousBase then
		local speed = (base.Position - previousBase.Position).Magnitude / math.max(dt, 1e-3)
		smoothSpeed += (math.min(speed, 40) - smoothSpeed) * math.min(1, dt * 8)
		base = previousBase:Lerp(base, math.min(1, dt * 18))
	end
	displayBase = base
	moving = smoothSpeed > 1.2
	TungTungRig.place(t, base)

	local reacting = os.clock() < reactionUntil
	if not reacting then
		if mode == "Capture" then
			TungTungRig.play(t, "slash", 0.08, 1.15)
		elseif mode == "Search" and not moving then
			TungTungRig.play(t, "strafe", 0.25, 0.55)
		elseif smoothSpeed > 5 then
			TungTungRig.play(t, "run", 0.22, math.clamp(smoothSpeed / RUN_FEET_SPEED, 0.55, 1.35))
		elseif moving then
			TungTungRig.play(t, "walk", 0.25, math.clamp(smoothSpeed / WALK_FEET_SPEED, 0.8, 3.2))
		else
			TungTungRig.play(t, "idle", 0.35)
		end
	end

	headYaw += (lookYawAt(base, camera) - headYaw) * math.min(1, dt * 10)
	TungTungRig.step(t, dt, headYaw)

	-- Passos: dois por ciclo na corrida/lateral, quatro no andar arrastado.
	local playing = TungTungRig.playing(t)
	local steps = if playing == "walk" then 4 elseif playing == "run" or playing == "strafe" then 2 else 0
	local cycle = TungTungRig.cycle(t)
	if steps > 0 and math.floor(cycle * steps) ~= math.floor(lastCycle * steps) then
		footstep(root, camera)
	end
	lastCycle = cycle
	t.eyeLight.Brightness = if mode == "Chase" then 1.8 else 1.1
end

local function updateLegacy(r: Rig.Rig, root: BasePart, dt: number, camera: Camera?)
	local dirty = false
	-- Posição em passos (12 Hz).
	stepClock += dt
	if displayBase == nil or stepClock >= 1 / V.CreatureStepRate then
		stepClock = 0
		local base = root.CFrame * CFrame.new(0, -HEIGHT / 2, 0)
		if lastBasePosition then
			moving = (base.Position - lastBasePosition).Magnitude > 0.08
		end
		lastBasePosition = base.Position
		displayBase = base
		dirty = true
	end

	-- Pose em passos (taxa conforme o modo).
	local name, rate = animationFor(mode)
	if name ~= animation then
		animation = name
		poseIndex = 1
		poseClock = 0
		dirty = true
	end
	poseClock += dt
	local frames = Poses[animation]
	if poseClock >= 1 / rate then
		poseClock = 0
		poseIndex = poseIndex % #frames + 1
		dirty = true
		local pose = frames[poseIndex]
		if pose.step then
			footstep(root, camera)
		end
		-- Cabeça "estala" para olhar o jogador na perseguição (atualiza só no passo).
		headYaw = if displayBase then lookYawAt(displayBase, camera) else 0
		r.eyeLight.Brightness = if rng:NextNumber() < 0.2 then 0.2 else 0.9
	end

	if dirty and displayBase then
		local cframes = Rig.solve(r, displayBase, frames[poseIndex], headYaw)
		workspace:BulkMoveTo(r.order, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function update(dt: number)
	local root = serverRoot()
	local active = root ~= nil and root:GetAttribute(Tags.Attr.CreatureActive) == true and root.Position.Y > -100
	setShown(active and phase ~= "Won")
	if not shown or not root then
		displayBase = nil
		return
	end
	local camera = workspace.CurrentCamera

	local currentMode = (root:GetAttribute(Tags.Attr.CreatureMode) :: string?) or "Patrol"
	if currentMode ~= mode then
		onModeChanged(mode, currentMode)
		mode = currentMode
	end

	if tung then
		updateTung(tung, root, dt, camera)
	elseif rig then
		updateLegacy(rig, root, dt, camera)
	end
	-- Na mata não existe farol/halo denunciando o caçador. A lanterna do jogador ainda o revela.
	local world = workspace:FindFirstChild(Tags.WorldFolder)
	local forest = world ~= nil and world:GetAttribute("ForestActive") == true
	local eye = if tung then tung.eyeLight elseif rig then rig.eyeLight else nil
	if eye then
		eye.Enabled = not forest
	end

	-- Fora da perseguição: rosnados e o "TUM TUM TUM" do bastão (assinatura do Tung Tung).
	local now = os.clock()
	if now >= nextGrowlAt and mode ~= "Chase" and mode ~= "Capture" then
		nextGrowlAt = now + rng:NextNumber(7, 14)
		if tung and rng:NextNumber() < 0.6 then
			AudioController.playAt("DoorBang", emitter(), 0.85, 0.72)
			local distance = if camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge
			if distance < 60 then
				-- Legenda no HUD (CampaignController): perto o bastante para ouvir.
				Players.LocalPlayer:SetAttribute(
					"TungKnockSerial",
					((Players.LocalPlayer:GetAttribute("TungKnockSerial") :: number?) or 0) + 1
				)
			end
		else
			AudioController.playAt("Growl", emitter(), 0.9, rng:NextNumber(0.75, 0.95))
		end
	end
end

local CreatureVisualController = {
	Name = "CreatureVisualController",
}

function CreatureVisualController.react(name: string)
	if name == "DoorBang" then
		reaction, reactionUntil = name, os.clock() + 0.45
		if tung then
			-- Pancada do bastão na porta.
			TungTungRig.play(tung, "slash", 0.08, 1.4)
			reactionUntil = os.clock() + 0.85
		end
	end
end

function CreatureVisualController.Init()
	tung = TungTungRig.build(nil)
	if not tung then
		rig = Rig.build(workspace)
		visualModel().Parent = nil
	end
	chaseLoop = AudioController.loopAt("ChaseLoop", emitter())
end

function CreatureVisualController.Start()
	local function watchDoor(inst: Instance)
		if not inst:IsA("BasePart") or not string.match(inst.Name, "^door_") then
			return
		end
		inst:GetAttributeChangedSignal("BangSerial"):Connect(function()
			local root = serverRoot()
			if root and (root.Position - inst.Position).Magnitude < 12 then
				CreatureVisualController.react("DoorBang")
			end
		end)
	end
	local world = workspace:WaitForChild(Tags.WorldFolder)
	for _, inst in world:GetDescendants() do
		watchDoor(inst)
	end
	world.DescendantAdded:Connect(watchDoor)
	GameState.observe(function(snapshot)
		phase = snapshot.phase
	end)
	RunService.RenderStepped:Connect(update)
end

-- Distância e modo atuais (para efeitos e testes).
function CreatureVisualController.status(): (boolean, string, number)
	local root = serverRoot()
	local camera = workspace.CurrentCamera
	local distance = if root and camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge
	return shown, mode, distance
end

-- Clipe atual do Tung Tung (nil no boneco antigo); usado por testes e câmeras.
function CreatureVisualController.clip(): string?
	return if tung then TungTungRig.playing(tung) else nil
end

return CreatureVisualController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="333">
          <Properties>
            <string name="Name">FearController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Medo do jogador no cliente (FearModel). Não há barra: o valor dirige batimento, respiração,
	vinheta, tremor, FOV, distorção, abafamento, sussurros e alucinações.

	Por que no cliente: é só apresentação, muda a cada quadro e não deve gerar remote por quadro.
	O que é de verdade (onde o Vigia está, se te viu, a captura) continua decidido no servidor;
	aqui só lemos o que já replica (Root do Vigia, atributos, GameState).

	Entradas: distância e modo do Vigia, linha de visão até ele, escuridão (lanterna/luzes por
	perto), esconderijo e lugar seguro. Sustos somam picos (detecção, despertar, barulhos).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local FearModel = require("@game/ReplicatedStorage/Shared/Game/FearModel")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local AudioController = require("./AudioController")
local BodyAudioController = require("./BodyAudioController")
local CameraController = require("./CameraController")
local FlashlightController = require("./FlashlightController")

local player = Players.LocalPlayer
local TICK = 1 / 20

local state = FearModel.new()
local snapshot: GameState.Snapshot? = nil
local accumulator = 0
local lastVisibilityCheck = 0
local visible = false
local lastMode = "Dormant"
local lastAlert = 0
local darkness = 0
local levelCallbacks: { (number) -> () } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function creatureRoot(): BasePart?
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	return if root and root:IsA("BasePart") then root else nil
end

local function isHidden(): boolean
	local hidden = player:GetAttribute("Hidden")
	return type(hidden) == "string" and hidden ~= ""
end

-- Perto de uma luz acesa? (lâmpadas, emergência, holofotes do servidor)
local function nearLight(position: Vector3): boolean
	for _, part in CollectionService:GetTagged(Tags.PowerLight) do
		if part:IsA("BasePart") then
			local light = part:FindFirstChildWhichIsA("Light")
			if light and light.Enabled and light.Brightness > 0.2 then
				local range = (light :: any).Range or 0
				if (part.Position - position).Magnitude < range * 0.75 then
					return true
				end
			end
		end
	end
	return false
end

-- O Vigia está na tela e sem parede no meio?
local function checkVisible(camera: Camera, root: BasePart): boolean
	local head = root.Position + Vector3.new(0, root.Size.Y * 0.35, 0)
	local _, onScreen = camera:WorldToViewportPoint(head)
	if not onScreen then
		return false
	end
	local exclude: { Instance } = {}
	if player.Character then
		table.insert(exclude, player.Character)
	end
	local model = root.Parent
	if model then
		table.insert(exclude, model)
	end
	local visual = workspace:FindFirstChild("VigiaVisual")
	if visual then
		table.insert(exclude, visual)
	end
	table.insert(exclude, camera)
	rayParams.FilterDescendantsInstances = exclude
	local origin = camera.CFrame.Position
	return workspace:Raycast(origin, head - origin, rayParams) == nil
end

local FearController = {
	Name = "FearController",
}

function FearController.get(): number
	return state.value
end

function FearController.level(): number
	return state.level
end

function FearController.darkness(): number
	return darkness
end

function FearController.spike(amount: number)
	FearModel.spike(state, amount)
end

function FearController.onLevelChanged(callback: (level: number) -> ())
	table.insert(levelCallbacks, callback)
end

function FearController.debugState(): { [string]: any }
	return {
		value = math.floor(state.value * 100 + 0.5) / 100,
		base = math.floor(state.base * 100 + 0.5) / 100,
		spike = math.floor(state.spike * 100 + 0.5) / 100,
		level = state.level,
		darkness = darkness,
		visible = visible,
	}
end

function FearController.Start()
	GameState.observe(function(next: GameState.Snapshot)
		local previous = snapshot
		snapshot = next
		if previous and next.phase ~= previous.phase and next.phase == "Intro" then
			FearModel.reset(state)
		end
		if previous and next.creatureActive and not previous.creatureActive and next.phase == "Playing" then
			FearModel.spike(state, 0.25)
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		accumulator += dt
		if accumulator < TICK then
			return
		end
		local step = accumulator
		accumulator = 0
		local s = snapshot
		local camera = workspace.CurrentCamera
		if not s or not camera then
			return
		end
		local now = os.clock()
		local root = creatureRoot()
		local active = root ~= nil and s.creatureActive and root.Position.Y > -100
		local position = camera.CFrame.Position
		local distance = if active and root then (root.Position - position).Magnitude else math.huge
		local status = player:GetAttribute("CampaignStatus") :: string?
		local playing = Presentation.playing(s.phase, status)
		local globalMode = if root
			then (root:GetAttribute(Tags.Attr.CreatureMode) :: string?) or "Dormant"
			else "Dormant"
		local mode = Presentation.mode(
			globalMode,
			if root then root:GetAttribute(Tags.Attr.ThreatTargetUserId) :: number? else nil,
			player.UserId,
			status
		)

		if active and root and distance < 70 and now - lastVisibilityCheck > 0.2 then
			lastVisibilityCheck = now
			visible = checkVisible(camera, root)
		elseif not active or distance >= 70 then
			visible = false
		end

		-- Picos de susto: ele te viu / te ouviu no armário.
		if playing and mode == "Chase" and lastMode ~= "Chase" then
			FearModel.spike(state, 0.35)
		end
		lastMode = mode
		local alert = if root then (root:GetAttribute("Alert") :: number?) or 0 else 0
		if alert ~= lastAlert then
			if lastAlert ~= 0 then
				FearModel.spike(state, 0.4)
			end
			lastAlert = alert
		end

		local lit = s.powerOn or nearLight(position)
		local flashlight = FlashlightController.isOn()
		darkness = if lit then 0 elseif flashlight then 0.35 else 1
		local changed = FearModel.step(state, {
			creatureDistance = if playing then distance else math.huge,
			creatureVisible = playing and visible,
			chasing = playing and (mode == "Chase" or mode == "Capture"),
			darkness = if playing then darkness else 0,
			hidden = isHidden(),
			safe = lit and distance > 45,
		}, step)
		if changed then
			for _, callback in levelCallbacks do
				task.spawn(callback, state.level)
			end
		end

		CameraController.setFear(state.value)
		AudioController.setFear(state.value)
		BodyAudioController.setFear(state.value)
	end)
end

return FearController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="334">
          <Properties>
            <string name="Name">FlashlightController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lanterna na mão (cliente). HUD diegético: a carga aparece nos 4 LEDs em cima da lanterna.

	- F pede liga/desliga ao servidor (SetFlashlight); quem decide é a bateria no servidor
	  (atributos "Flashlight" e "Battery" do Player). Sem carga: clique seco e aviso.
	- A luz segue a mão com atraso (balanço/peso) e acompanha o passo; poeira só aparece no feixe.
	- Falhas: em passos perto do Vigia, com bateria fraca e quando o diretor de tensão pede.
	- Animações locais que representam resultados JÁ aprovados pelo servidor:
	  item voando para a mão (pegar) e chave na fechadura (inserir, girar, clique).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local BatteryModel = require("@game/ReplicatedStorage/Shared/Game/BatteryModel")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local LightingProfile = require("@game/ReplicatedStorage/Shared/Game/LightingProfile")
local AudioController = require("./AudioController")
local SettingsController = require("./SettingsController")
local CharacterController = require("./CharacterController")

local player = Players.LocalPlayer
local BASE_BRIGHTNESS = LightingProfile.Flashlight.brightness
local WARM = Color3.fromRGB(255, 232, 196)

type Viewmodel = {
	model: Model,
	root: BasePart,
	lens: BasePart,
	leds: { BasePart },
	parts: { BasePart },
}

local wanted = true
local phase: GameState.Phase = "Loading"
local raisedAt = 0
local reachAt = -10
local clickAt = -10
local viewmodel: Viewmodel? = nil
local emitter: BasePart? = nil
local spot: SpotLight? = nil
local spill: PointLight? = nil
local dust: ParticleEmitter? = nil
local smoothed: CFrame? = nil
local flickerClock = 0
local flickerFactor = 1
local forcedFlickerUntil = 0
local restoreAfterHide = false
local hintCallbacks: { (string) -> () } = {}
-- Cor do feixe e da lente acesa (skin equipada; ver CosmeticController).
local beamColor = WARM
local rng = Random.new()

local function charge(): number
	local value = player:GetAttribute("Battery")
	return if type(value) == "number" then value else Config.Battery.StartCharge
end

local function serverOn(): boolean
	return player:GetAttribute(Tags.Attr.Flashlight) == true
end

local function isHidden(): boolean
	local hidden = player:GetAttribute("Hidden")
	return type(hidden) == "string" and hidden ~= ""
end

local function hint(key: string)
	for _, callback in hintCallbacks do
		task.spawn(callback, key)
	end
end

local function creatureDistance(position: Vector3): number
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	if root and root:IsA("BasePart") and root:GetAttribute(Tags.Attr.CreatureActive) then
		return (root.Position - position).Magnitude
	end
	return math.huge
end

local function send(value: boolean)
	task.spawn(function()
		local ok, remote = pcall(Remotes.clientEvent, "SetFlashlight", 10)
		if ok then
			remote:FireServer(value)
		end
	end)
end

local function localPart(
	parent: Instance,
	name: string,
	size: Vector3,
	color: Color3,
	material: Enum.Material?
): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Lanterna low poly + mão + manga (só o jogador vê; peças locais sob a câmera).
local function buildViewmodel(): Viewmodel
	local model = Instance.new("Model")
	model.Name = "Viewmodel"
	local parts: { BasePart } = {}
	local function add(name: string, size: Vector3, color: Color3, material: Enum.Material?): BasePart
		local part = localPart(model, name, size, color, material)
		table.insert(parts, part)
		return part
	end
	local root = add("Body", Vector3.new(0.17, 0.17, 0.85), Color3.fromRGB(38, 40, 44), Enum.Material.Metal)
	add("Head", Vector3.new(0.27, 0.27, 0.2), Color3.fromRGB(52, 54, 58), Enum.Material.Metal)
	local lens = add("Lens", Vector3.new(0.22, 0.22, 0.03), Color3.fromRGB(90, 88, 80), Enum.Material.SmoothPlastic)
	add("Switch", Vector3.new(0.06, 0.04, 0.12), Color3.fromRGB(150, 32, 28))
	add("Hand", Vector3.new(0.26, 0.24, 0.36), Color3.fromRGB(150, 118, 96))
	add("Thumb", Vector3.new(0.08, 0.08, 0.18), Color3.fromRGB(140, 110, 90))
	add("Sleeve", Vector3.new(0.32, 0.32, 0.7), Color3.fromRGB(46, 58, 54), Enum.Material.Fabric)
	local leds: { BasePart } = {}
	for i = 1, BatteryModel.LEDS do
		local led = add(`Led{i}`, Vector3.new(0.035, 0.03, 0.05), Color3.fromRGB(20, 20, 20), Enum.Material.Neon)
		table.insert(leds, led)
	end
	model.PrimaryPart = root
	return { model = model, root = root, lens = lens, leds = leds, parts = parts }
end

-- Posições locais (em relação ao corpo da lanterna, -Z = frente).
local OFFSETS: { [string]: CFrame } = {
	Body = CFrame.identity,
	Head = CFrame.new(0, 0, -0.5),
	Lens = CFrame.new(0, 0, -0.61),
	Switch = CFrame.new(0, 0.1, -0.12),
	Hand = CFrame.new(0.02, -0.11, 0.08),
	Thumb = CFrame.new(-0.11, 0.02, -0.02),
	Sleeve = CFrame.new(0.05, -0.2, 0.6) * CFrame.Angles(math.rad(-12), 0, 0),
	Led1 = CFrame.new(0, 0.095, 0.06),
	Led2 = CFrame.new(0, 0.095, 0.12),
	Led3 = CFrame.new(0, 0.095, 0.18),
	Led4 = CFrame.new(0, 0.095, 0.24),
}

local function placeViewmodel(base: CFrame)
	local vm = viewmodel
	if not vm then
		return
	end
	for _, part in vm.parts do
		part.CFrame = base * (OFFSETS[part.Name] or CFrame.identity)
	end
end

local function updateLeds(now: number)
	local vm = viewmodel
	if not vm then
		return
	end
	local c = charge()
	local lit = BatteryModel.leds(c)
	local low = BatteryModel.isLow(c)
	local blinkOff = low and (now * 2.5) % 1 < 0.4
	for i, led in vm.leds do
		local on = i <= lit and not (lit == 1 and blinkOff)
		if not on then
			led.Color = Color3.fromRGB(22, 22, 22)
		elseif lit >= 3 then
			led.Color = Color3.fromRGB(70, 255, 110)
		elseif lit == 2 then
			led.Color = Color3.fromRGB(255, 190, 60)
		else
			led.Color = Color3.fromRGB(255, 60, 50)
		end
	end
end

local function applyVisible()
	local status = player:GetAttribute("CampaignStatus")
	local on = serverOn()
		and phase ~= "Won"
		and not isHidden()
		and player:GetAttribute("CinematicActive") ~= true
		and (status == nil or status == "Active")
	if spot then
		spot.Enabled = on
	end
	if spill then
		spill.Enabled = on
	end
	if dust then
		dust.Enabled = on
	end
	local vm = viewmodel
	if vm then
		vm.lens.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		vm.lens.Color = if on then beamColor else Color3.fromRGB(90, 88, 80)
	end
end

local function partNamed(name: string): BasePart?
	local vm = viewmodel
	if not vm then
		return nil
	end
	for _, part in vm.parts do
		if part.Name == name then
			return part
		end
	end
	return nil
end

local FlashlightController = {
	Name = "FlashlightController",
}

function FlashlightController.isOn(): boolean
	local status = player:GetAttribute("CampaignStatus")
	return serverOn() and (status == nil or status == "Active")
end

function FlashlightController.isWanted(): boolean
	return wanted
end

-- Skin da lanterna (cosmético, só o dono vê). O feixe muda de tom, nunca de alcance/brilho.
function FlashlightController.applySkin(body: Color3, head: Color3, beam: Color3, material: Enum.Material)
	beamColor = beam
	local bodyPart = partNamed("Body")
	local headPart = partNamed("Head")
	if bodyPart then
		bodyPart.Color = body
		bodyPart.Material = material
	end
	if headPart then
		headPart.Color = head
		headPart.Material = if material == Enum.Material.Neon then Enum.Material.Neon else Enum.Material.Metal
	end
	if spot then
		spot.Color = beam
	end
	if spill then
		spill.Color = beam
	end
	applyVisible()
end

-- Manga do braço com a cor da farda equipada.
function FlashlightController.applySleeve(color: Color3)
	local sleeve = partNamed("Sleeve")
	if sleeve then
		sleeve.Color = color
	end
end

-- Pede ligar/desligar (o servidor confirma pelo atributo).
function FlashlightController.set(value: boolean, silent: boolean?)
	if value and charge() < Config.Battery.MinToTurnOn then
		AudioController.play("Flashlight", 0.6, 0.7)
		hint("battery_empty")
		return
	end
	wanted = value
	if not silent then
		AudioController.play("Flashlight", 1, 1.15)
	end
	send(value)
end

-- Falha forte por `duration` s (diretor de tensão, susto).
function FlashlightController.flicker(duration: number)
	if not SettingsController.get("flashes") then
		return
	end
	forcedFlickerUntil = math.max(forcedFlickerUntil, os.clock() + duration)
end

function FlashlightController.onHint(callback: (key: string) -> ())
	table.insert(hintCallbacks, callback)
end

-- Item "voa" até a mão e some (o servidor já aprovou a coleta).
function FlashlightController.showPickup(kind: string, from: Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local color = if kind == "Key"
		then Color3.fromRGB(176, 140, 64)
		elseif kind == "Battery" then Color3.fromRGB(186, 150, 40)
		elseif kind == "Note" then Color3.fromRGB(212, 204, 178)
		else Color3.fromRGB(222, 216, 198)
	local size = if kind == "Key" then Vector3.new(0.3, 0.5, 0.08) else Vector3.new(0.5, 0.22, 0.22)
	local item = localPart(camera, "PickupFx", size, color, Enum.Material.SmoothPlastic)
	item.CFrame = CFrame.new(from)
	AudioController.play("Pickup", 0.8, 1.2)
	task.spawn(function()
		local frames = 6
		local start = CFrame.new(from) * item.CFrame.Rotation
		for i = 1, frames do
			local cam = workspace.CurrentCamera
			if not cam then
				break
			end
			local hand = cam.CFrame * CFrame.new(-0.35, -0.5, -1.1) * CFrame.Angles(0.4, 0.6, 0)
			local t = i / frames
			local eased = 1 - (1 - t) ^ 2
			item.CFrame = start:Lerp(hand, eased)
			item.Size = size * (1 - 0.5 * t)
			task.wait(1 / 20)
		end
		item:Destroy()
	end)
end

-- Chave na fechadura: aparece na mão, avança, gira em dois passos com cliques (~UnlockTime).
function FlashlightController.playKeyUnlock()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local model = Instance.new("Model")
	model.Name = "KeyFx"
	model.Parent = camera
	local bow =
		localPart(model, "Bow", Vector3.new(0.16, 0.16, 0.03), Color3.fromRGB(176, 140, 64), Enum.Material.Metal)
	local blade =
		localPart(model, "Blade", Vector3.new(0.04, 0.03, 0.3), Color3.fromRGB(176, 140, 64), Enum.Material.Metal)
	task.spawn(function()
		local steps: { { forward: number, roll: number, wait: number, sound: boolean } } = {
			{ forward = 0, roll = 0, wait = 0.15, sound = false },
			{ forward = 0.15, roll = 0, wait = 0.15, sound = false },
			{ forward = 0.3, roll = 0, wait = 0.25, sound = true },
			{ forward = 0.3, roll = 45, wait = 0.2, sound = true },
			{ forward = 0.3, roll = 90, wait = 0.45, sound = true },
		}
		for _, s in steps do
			local cam = workspace.CurrentCamera
			if not cam then
				break
			end
			local base = cam.CFrame * CFrame.new(-0.1, -0.32, -0.9 - s.forward) * CFrame.Angles(0, 0, math.rad(s.roll))
			blade.CFrame = base * CFrame.new(0, 0, -0.15)
			bow.CFrame = base * CFrame.new(0, 0, 0.03)
			if s.sound then
				AudioController.play("KeyTurn", 0.9, 1.3 + s.roll / 200)
			end
			task.wait(s.wait)
		end
		model:Destroy()
	end)
end

function FlashlightController.Init()
	local part = Instance.new("Part")
	part.Name = "FlashlightRig"
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false

	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Front
	light.Angle = LightingProfile.Flashlight.angle
	light.Range = 48
	light.Brightness = BASE_BRIGHTNESS
	light.Color = WARM
	light.Shadows = true
	light.Parent = part

	local glow = Instance.new("PointLight")
	glow.Range = 5
	glow.Brightness = LightingProfile.Flashlight.spill
	glow.Color = WARM
	glow.Shadows = false
	glow.Parent = part

	-- Poeira: volume à frente da lanterna; partículas só aparecem onde há luz (LightInfluence 1).
	local volume = Instance.new("Part")
	volume.Name = "DustVolume"
	volume.Size = Vector3.new(4, 3, 9)
	volume.Transparency = 1
	volume.Anchored = true
	volume.CanCollide = false
	volume.CanQuery = false
	volume.CanTouch = false
	local particles = Instance.new("ParticleEmitter")
	particles.Shape = Enum.ParticleEmitterShape.Box
	particles.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	particles.Rate = 16
	particles.Lifetime = NumberRange.new(2.5, 4)
	particles.Speed = NumberRange.new(0.05, 0.25)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Drag = 1.5
	particles.Acceleration = Vector3.new(0, -0.05, 0)
	particles.Size = NumberSequence.new(0.045)
	particles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.45),
		NumberSequenceKeypoint.new(0.8, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	particles.Color = ColorSequence.new(Color3.fromRGB(220, 214, 200))
	particles.LightInfluence = 1
	particles.LightEmission = 0
	particles.Parent = volume
	volume.Parent = part

	part.Parent = workspace
	emitter = part
	spot = light
	spill = glow
	dust = particles
	local vm = buildViewmodel()
	vm.model.Parent = workspace.CurrentCamera
	viewmodel = vm
end

function FlashlightController.Start()
	player:GetAttributeChangedSignal("CinematicActive"):Connect(function()
		if player:GetAttribute("CinematicActive") ~= true then
			raisedAt = os.clock()
		end
		applyVisible()
	end)
	player:GetAttributeChangedSignal("CampaignStatus"):Connect(applyVisible)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if player:GetAttribute("CinematicActive") == true then
			return
		end
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
			reachAt = os.clock()
		end
		if input.KeyCode ~= Enum.KeyCode.F and input.KeyCode ~= Enum.KeyCode.ButtonY then
			return
		end
		local status = player:GetAttribute("CampaignStatus")
		if (phase == "Playing" or phase == "Intro") and not isHidden() and (status == nil or status == "Active") then
			clickAt = os.clock()
			FlashlightController.set(not wanted)
		end
	end)

	player:GetAttributeChangedSignal(Tags.Attr.Flashlight):Connect(function()
		applyVisible()
		if wanted and not serverOn() and charge() <= 0.001 and phase == "Playing" then
			hint("battery_dead")
			AudioController.play("Flashlight", 0.7, 0.6)
		end
	end)
	player:GetAttributeChangedSignal("Hidden"):Connect(function()
		-- Dentro do armário a luz vazaria pelas frestas: apaga e volta ao sair.
		if isHidden() then
			restoreAfterHide = wanted
			if wanted then
				FlashlightController.set(false, true)
			end
		elseif restoreAfterHide then
			restoreAfterHide = false
			FlashlightController.set(true, true)
		end
		applyVisible()
	end)
	player.CharacterAdded:Connect(function()
		raisedAt = os.clock()
		wanted = true
		restoreAfterHide = false
		applyVisible()
	end)

	GameState.observe(function(snapshot)
		phase = snapshot.phase
		applyVisible()
	end)

	RunService:BindToRenderStep("S9Flashlight", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		local camera = workspace.CurrentCamera
		local part = emitter
		local vm = viewmodel
		if not camera or not part or not vm then
			return
		end
		if vm.model.Parent ~= camera then
			vm.model.Parent = camera
		end
		local now = os.clock()
		local budget = SettingsController.visualBudget()
		if spot then
			spot.Shadows = budget.shadows > 0
		end
		if dust then
			dust.Rate = 16 * budget.particles
		end
		local motion = CharacterController.getMotion()

		-- Mão com peso: a rotação segue a câmera com atraso; corrida abaixa a lanterna.
		local lower = if motion.sprinting then math.rad(-14) else 0
		local target = camera.CFrame * CFrame.Angles(lower, 0, 0)
		smoothed = if smoothed then smoothed:Lerp(target, math.min(1, dt * 11)) else target
		local rotation = (smoothed :: CFrame).Rotation
		local bob = math.sin(now * (if motion.sprinting then 11 else 7)) * math.min(motion.speed / 16, 1)
		local hand = CFrame.new(camera.CFrame.Position)
			* rotation
			* CFrame.new(0.42 + bob * 0.02, -0.42 + math.abs(bob) * -0.025, -0.95)
		local raise = math.clamp(1 - (now - raisedAt) / 0.65, 0, 1)
		local reach = math.sin(math.clamp((now - reachAt) / 0.45, 0, 1) * math.pi)
		local click = math.sin(math.clamp((now - clickAt) / 0.2, 0, 1) * math.pi)
		local dip = if motion.stance == "Crouch" then 0.08 else 0
		if SettingsController.motionEnabled() then
			hand *= CFrame.new(-reach * 0.12, -raise * 0.7 - dip, -reach * 0.24 + click * 0.04) * CFrame.Angles(
				math.rad(-raise * 40 + click * 7),
				0,
				math.rad(reach * -8)
			)
		end
		local visible = player:GetAttribute("HasFlashlight") == true
			and not motion.hidden
			and player:GetAttribute("CinematicActive") ~= true
			and (player:GetAttribute("CampaignStatus") == nil or player:GetAttribute("CampaignStatus") == "Active")
			and phase ~= "Won"
			and (phase == "Playing" or phase == "Intro" or phase == "Lost")
		vm.model.Parent = if visible then camera else nil
		placeViewmodel(hand)
		part.CFrame = hand * CFrame.new(0, 0, -0.62)
		local volume = part:FindFirstChild("DustVolume")
		if volume and volume:IsA("BasePart") then
			volume.CFrame = part.CFrame * CFrame.new(0, 0, -5.5)
		end
		updateLeds(now)

		-- Falhas em passos (12 Hz): Vigia perto, bateria fraca ou pedido do diretor.
		flickerClock += dt
		local stepTime = 1 / Config.Visual.FlickerRate
		if flickerClock >= stepTime then
			flickerClock -= stepTime
			local distance = creatureDistance(part.Position)
			local chance = if distance < 22 then (22 - distance) / 22 * 0.35 else 0
			if BatteryModel.isLow(charge()) then
				chance = math.max(chance, 0.12)
			end
			if now < forcedFlickerUntil then
				chance = 0.6
			end
			flickerFactor = if SettingsController.get("flashes") and rng:NextNumber() < chance
				then rng:NextNumber(0, 0.4)
				else 1
		end
		local brightness = BASE_BRIGHTNESS * BatteryModel.brightness(charge()) * flickerFactor
		if spot then
			spot.Brightness = brightness
			spot.Range = 48 * (0.6 + 0.4 * BatteryModel.brightness(charge()))
		end
		if spill then
			spill.Brightness = LightingProfile.Flashlight.spill * flickerFactor
		end
	end)
end

return FlashlightController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="335">
          <Properties>
            <string name="Name">GameUiController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Interface do jogo, toda construída por código (estética PS1: fonte pixel, poucos tons,
	animações em passos de ~12 quadros por segundo).

	Camadas: mira + prompt, objetivo (com ícones de fusível em 2 quadros), legendas, fôlego,
	ajuda (H), introdução (cartela), bilhete, jumpscare (sprite de 2 quadros) e telas finais.
	Tudo reage ao GameState replicado pelo servidor; reiniciar = remote RequestRestart.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Create = require("../UI/Create")
local Theme = require("../UI/Theme")
local AdemirPortrait = require("../Creature/AdemirPortrait")
local SettingsController = require("./SettingsController")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local STEP = 1 / 12 -- passo das animações 2D

type Refs = {
	gui: ScreenGui,
	prompt: TextLabel,
	objective: TextLabel,
	objectiveHint: TextLabel,
	fuseIcons: { Frame },
	caption: TextLabel,
	help: Frame,
	helpLines: { TextLabel },
	intro: Frame,
	introTitle: TextLabel,
	introLines: { TextLabel },
	note: Frame,
	noteText: TextLabel,
	scare: Frame,
	faces: { Frame },
	finale: Frame,
	finaleTitle: TextLabel,
	finaleSubtitle: TextLabel,
	finaleStats: TextLabel,
	restart: TextButton,
	continueButton: TextButton,
	inventory: TextLabel,
}

local refs: Refs? = nil
local snapshot: GameState.Snapshot? = nil
local noteOpen = false
local captionToken = 0
local introToken = 0
local endToken = 0
local finaleToken = 0
local objectiveToken = 0
local lastObjective = ""
local blinkOn = false

local function r(): Refs
	assert(refs, "[GameUiController] used before Init")
	return refs
end

local function label(props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextSize = Theme.SizeBody,
		TextColor3 = Theme.Text,
		TextStrokeColor3 = Theme.Black,
		TextStrokeTransparency = 0.35,
		TextWrapped = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Create("TextLabel", defaults) :: TextLabel
end

local function frame(props: { [string]: any }, children: { any }?): Frame
	local defaults: { [string]: any } = { BorderSizePixel = 0, BackgroundColor3 = Theme.Panel }
	for key, value in props do
		defaults[key] = value
	end
	return Create("Frame", defaults, children) :: Frame
end

local function stroke(color: Color3, thickness: number): Instance
	-- Border: em TextLabel/TextButton o modo padrão contornaria o TEXTO (fica borrado).
	return Create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Rosto do Ademir em 2 quadros; compartilha a textura da cabeça 3D.
local function buildFace(parent: Instance, variant: number): Frame
	local open = variant == 2
	local face = frame({
		Name = `Face{variant}`,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + (if open then 0.012 else 0), 0.52),
		Size = UDim2.fromScale(0.36, 0.78),
		BackgroundColor3 = Theme.Skin,
		Rotation = if open then 5 else -2,
		Visible = false,
		Parent = parent,
	}, { Create("UICorner", { CornerRadius = UDim.new(0.42, 0) }) })
	local aspect = Create("UIAspectRatioConstraint", { AspectRatio = 0.72, Parent = face }) :: UIAspectRatioConstraint
	if AdemirPortrait.createImage({ Parent = face }) then
		face.BackgroundTransparency = 1
		face.Size = UDim2.fromScale(0.8, 0.98)
		aspect.AspectRatio = 1
		return face
	end
	for _, x in { 0.3, 0.7 } do
		frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, 0.38),
			Size = UDim2.fromScale(if open then 0.15 else 0.12, if open then 0.06 else 0.035),
			BackgroundColor3 = Color3.fromRGB(255, 244, 214),
			Parent = face,
		})
	end
	frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromScale(if open then 0.16 else 0.035, if open then 0.32 else 0.22),
		BackgroundColor3 = Theme.Black,
		Parent = face,
	})
	return face
end

local function build(): Refs
	local gui = Create("ScreenGui", {
		Name = "GameUi",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}) :: ScreenGui

	-- Mira
	frame({
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Theme.Text,
		Parent = gui,
	}, { stroke(Theme.Black, 1) })
	local prompt = label({
		Name = "Prompt",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 18),
		Size = UDim2.new(0.8, 0, 0, 60),
		Text = "",
		Visible = false,
		Parent = gui,
	})
	prompt.Font = Enum.Font.Code
	prompt.TextSize = 17
	prompt.TextColor3 = Theme.Hazard
	prompt.BackgroundColor3 = Theme.Panel
	prompt.BackgroundTransparency = 0.12
	prompt.TextStrokeTransparency = 1
	prompt.Size = UDim2.new(0.8, 0, 0, 54)
	Create("UISizeConstraint", { Parent = prompt, MaxSize = Vector2.new(480, 54) })

	-- Objetivo (canto superior esquerdo)
	local objectivePanel = frame({
		Name = "Objective",
		Position = UDim2.fromOffset(20, 20),
		Size = UDim2.fromOffset(380, 74),
		BackgroundTransparency = 0.45,
		Parent = gui,
	}, {
		Create("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 10),
		}),
		stroke(Theme.TextDim, 1),
	})
	label({
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 14),
		Text = "OBJETIVO",
		TextSize = Theme.SizeSmall,
		TextColor3 = Theme.Hazard,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = objectivePanel,
	})
	local objective = label({
		Name = "Text",
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, -96, 0, 34),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = objectivePanel,
	})
	local objectiveHint = label({
		Name = "Hint",
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 14),
		Text = "",
		TextSize = Theme.SizeSmall,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = objectivePanel,
	})
	local fuseIcons: { Frame } = {}
	for i = 1, 3 do
		table.insert(
			fuseIcons,
			frame({
				Name = `Fuse{i}`,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -(3 - i) * 26, 0, 20),
				Size = UDim2.fromOffset(18, 22),
				BackgroundColor3 = Theme.Panel,
				Parent = objectivePanel,
			}, { stroke(Theme.TextDim, 2) })
		)
	end

	-- Legenda (baixo, centro)
	local caption = label({
		Name = "Caption",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -64),
		Size = UDim2.new(0.86, 0, 0, 48),
		Text = "",
		TextSize = Theme.SizeBody,
		Visible = false,
		Parent = gui,
	})

	-- Fôlego e bateria são diegéticos (respiração/postura e LEDs da lanterna).
	-- Inventário sob demanda (segurar Tab), canto inferior esquerdo.
	local inventory = label({
		Name = "Inventory",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -20),
		Size = UDim2.fromOffset(420, 84),
		Text = "",
		TextSize = Theme.SizeSmall,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		Visible = false,
		Parent = gui,
	})
	label({
		Name = "HelpHint",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(160, 16),
		Text = Text.HelpHint,
		TextSize = Theme.SizeSmall,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = gui,
	})

	-- Ajuda (H)
	local help = frame({
		Name = "Help",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 20),
		Size = UDim2.fromOffset(330, 20 + #Text.Help * 20),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, {
		stroke(Theme.TextDim, 1),
		Create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingTop = UDim.new(0, 10) }),
	})
	local helpLines: { TextLabel } = {}
	for i = 1, #Text.Help do
		table.insert(
			helpLines,
			label({
				Position = UDim2.fromOffset(0, (i - 1) * 20),
				Size = UDim2.new(1, -12, 0, 18),
				TextSize = Theme.SizeSmall,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = help,
			})
		)
	end

	-- Bilhete
	local note = frame({
		Name = "Note",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 330),
		BackgroundColor3 = Theme.Paper,
		Rotation = -1.5,
		Visible = false,
		Parent = gui,
	}, {
		stroke(Theme.Ink, 2),
		Create("UIPadding", {
			PaddingLeft = UDim.new(0, 26),
			PaddingRight = UDim.new(0, 26),
			PaddingTop = UDim.new(0, 24),
			PaddingBottom = UDim.new(0, 30),
		}),
	})
	local noteScroll = Create("ScrollingFrame", {
		Name = "Reading",
		Parent = note,
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}) :: ScrollingFrame
	local noteText = label({
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		FontFace = Theme.FontNote,
		TextSize = 19,
		TextColor3 = Theme.Ink,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = noteScroll,
	})
	local noteClose = Create("TextButton", {
		Name = "Close",
		Parent = note,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(120, 44),
		Text = "FECHAR",
		FontFace = Theme.Font,
		TextSize = 16,
		BackgroundColor3 = Theme.Panel,
		TextColor3 = Theme.Text,
		Modal = true,
	}) :: TextButton
	noteClose.Activated:Connect(function()
		note.Visible, noteOpen = false, false
		player:SetAttribute("NoteOpen", false)
	end)
	label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 18),
		Size = UDim2.fromOffset(160, 14),
		Text = "",
		TextSize = Theme.SizeSmall,
		TextColor3 = Theme.Ink,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = note,
	})

	-- Introdução (cartela preta)
	local intro = frame({
		Name = "Intro",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Black,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	})
	local introTitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(800, 50),
		Text = Text.Title,
		TextSize = Theme.SizeTitle,
		TextColor3 = Theme.Accent,
		ZIndex = 5,
		Parent = intro,
	})
	local introLines: { TextLabel } = {}
	for i = 1, #Text.Intro do
		table.insert(
			introLines,
			label({
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0.42, (i - 1) * 30),
				Size = UDim2.fromOffset(900, 24),
				Text = "",
				ZIndex = 5,
				Parent = intro,
			})
		)
	end
	label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(900, 18),
		Text = Text.IntroControls,
		TextSize = Theme.SizeSmall,
		TextColor3 = Theme.TextDim,
		ZIndex = 5,
		Parent = intro,
	})

	-- Jumpscare
	local scare = frame({
		Name = "Scare",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Black,
		Visible = false,
		ZIndex = 8,
		Parent = gui,
	})
	local faces = { buildFace(scare, 1), buildFace(scare, 2) }

	-- Tela final
	local finale = frame({
		Name = "Finale",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Black,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 6,
		Parent = gui,
	})
	local finaleTitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(900, 50),
		TextSize = Theme.SizeTitle - 4,
		ZIndex = 6,
		Parent = finale,
	})
	local finaleSubtitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.36, 46),
		Size = UDim2.fromOffset(900, 20),
		TextColor3 = Theme.TextDim,
		ZIndex = 6,
		Parent = finale,
	})
	local finaleStats = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.36, 86),
		Size = UDim2.fromOffset(900, 20),
		TextSize = Theme.SizeSmall,
		ZIndex = 6,
		Parent = finale,
	})
	local restart = Create("TextButton", {
		Name = "Restart",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.36, 150),
		Size = UDim2.fromOffset(300, 40),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		FontFace = Theme.Font,
		Text = Text.Restart,
		TextSize = Theme.SizeBody,
		TextColor3 = Theme.Text,
		-- Modal libera o mouse da trava de primeira pessoa enquanto a tela final está aberta.
		Modal = true,
		ZIndex = 6,
		Parent = finale,
	}, { stroke(Theme.Text, 2) }) :: TextButton
	-- Continuar do checkpoint: destaque próprio, para não confundir com "reiniciar tudo".
	local continueButton = Create("TextButton", {
		Name = "Continue",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.36, 150),
		Size = UDim2.fromOffset(380, 44),
		BackgroundColor3 = Theme.Hazard,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		FontFace = Theme.Font,
		Text = Text.Continue,
		TextSize = Theme.SizeBody,
		TextColor3 = Theme.Black,
		Visible = false,
		ZIndex = 6,
		Parent = finale,
	}, { stroke(Theme.Black, 2) }) :: TextButton
	-- Escala da interface pela altura da tela (base 720 px).
	local scale = Create("UIScale", { Parent = gui }) :: UIScale
	local function rescale()
		local current = workspace.CurrentCamera
		local height = if current then current.ViewportSize.Y else 720
		scale.Scale = math.clamp(height / 720, 0.75, 1.5)
	end
	rescale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	gui.Parent = player:WaitForChild("PlayerGui")

	return {
		gui = gui,
		prompt = prompt,
		objective = objective,
		objectiveHint = objectiveHint,
		fuseIcons = fuseIcons,
		caption = caption,
		inventory = inventory,
		help = help,
		helpLines = helpLines,
		intro = intro,
		introTitle = introTitle,
		introLines = introLines,
		note = note,
		noteText = noteText,
		scare = scare,
		faces = faces,
		finale = finale,
		finaleTitle = finaleTitle,
		finaleSubtitle = finaleSubtitle,
		finaleStats = finaleStats,
		restart = restart,
		continueButton = continueButton,
	}
end

local function onOff(value: boolean): string
	return if value then Text.On else Text.Off
end

local function refreshHelp()
	local ui = r()
	for i, line in ui.helpLines do
		local template = Text.Help[i]
		if string.find(template, "%s", 1, true) then
			local value = if i == 6 then SettingsController.get("retro") else SettingsController.motionEnabled()
			line.Text = string.format(template, onOff(value))
		else
			line.Text = template
		end
	end
end

local function refreshObjective(s: GameState.Snapshot)
	local ui = r()
	local key = s.objective :: string
	ui.objective.Text = (Text.Objectives :: any)[key] or ""
	if key == "fuses" then
		ui.objective.Text ..= ` ({s.fusesCollected}/{s.fusesTotal})`
	end
	if key ~= lastObjective then
		lastObjective = key
		objectiveToken += 1
		local token = objectiveToken
		ui.objective.TextColor3 = Theme.Hazard
		task.delay(0.7, function()
			if token == objectiveToken then
				ui.objective.TextColor3 = Theme.Text
			end
		end)
	end
	ui.objectiveHint.Text = if s.fusesHeld > 0 and not s.powerOn
		then string.format(Text.ObjectiveHeld, s.fusesHeld)
		else ""
	for i, icon in ui.fuseIcons do
		local uiStroke = icon:FindFirstChildOfClass("UIStroke")
		if i <= s.fusesInserted then
			icon.BackgroundColor3 = Theme.Good
		elseif i <= s.fusesCollected then
			icon.BackgroundColor3 = Theme.Hazard
		else
			icon.BackgroundColor3 = Theme.Panel
		end
		if uiStroke then
			uiStroke.Color = if i == s.fusesCollected + 1 and blinkOn then Theme.Text else Theme.TextDim
		end
	end
end

-- Escreve o texto em passos (efeito máquina de escrever a 12 quadros/s).
local function typeInto(target: TextLabel, value: string, token: number, current: () -> number)
	target.Text = ""
	local length = utf8.len(value) or #value
	local shown = 0
	while shown < length do
		if current() ~= token then
			return
		end
		shown = math.min(length, shown + 3)
		local cut = utf8.offset(value, shown + 1)
		target.Text = if cut then string.sub(value, 1, cut - 1) else value
		task.wait(STEP)
	end
end

local function playIntro(fromCheckpoint: boolean?)
	local ui = r()
	introToken += 1
	local token = introToken
	ui.intro.Visible = true
	ui.intro.BackgroundTransparency = 0
	ui.introTitle.Visible = false
	for _, line in ui.introLines do
		line.Text = ""
	end
	-- Continuar do checkpoint: cartela curta (uma linha), sem repetir a história.
	local lines = if fromCheckpoint then { Text.IntroCheckpoint } else Text.Intro
	task.spawn(function()
		task.wait(0.4)
		if token ~= introToken then
			return
		end
		ui.introTitle.Visible = true
		for i, line in ui.introLines do
			if lines[i] == nil then
				break
			end
			task.wait(0.9)
			if token ~= introToken then
				return
			end
			typeInto(line, lines[i], token, function()
				return introToken
			end)
		end
	end)
end

local function endIntro()
	local ui = r()
	introToken += 1
	local token = introToken
	task.spawn(function()
		-- Esmaece em 4 passos (stop-motion).
		for i = 1, 4 do
			if token ~= introToken then
				return
			end
			ui.intro.BackgroundTransparency = i / 4
			task.wait(STEP * 1.5)
		end
		if token == introToken then
			ui.intro.Visible = false
		end
	end)
end

local function showFinale(s: GameState.Snapshot)
	local ui = r()
	local won = s.phase == "Won"
	local texts = if won then Text.EndWon else Text.EndLost
	ui.finaleTitle.Text = texts.title
	ui.finaleTitle.TextColor3 = if won then Theme.Text else Theme.Accent
	ui.finaleSubtitle.Text = texts.subtitle
	local duration = if s.roundStartedAt > 0 then s.roundEndedAt - s.roundStartedAt else 0
	local total = math.max(0, math.floor(duration))
	ui.finaleStats.Text = string.format(
		Text.EndStats,
		string.format("%02d:%02d", total // 60, total % 60),
		s.fusesCollected,
		s.fusesTotal
	)
	-- Derrota com checkpoint: duas opções distintas. Senão, só "jogar de novo".
	local canContinue = not won and s.checkpointReady
	ui.continueButton.Visible = canContinue
	ui.restart.Text = if canContinue then Text.RestartAll else Text.Restart
	ui.restart.Position = UDim2.new(0.5, 0, 0.36, if canContinue then 204 else 150)
	ui.finale.Visible = true
	finaleToken += 1
	local token = finaleToken
	if SettingsController.motionEnabled() then
		ui.finaleSubtitle.TextTransparency = 1
		TweenService:Create(ui.finaleSubtitle, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
		task.spawn(function()
			for i = 1, 8 do
				if token ~= finaleToken or not snapshot or snapshot.phase ~= s.phase then
					return
				end
				local count = math.floor(total * i / 8)
				ui.finaleStats.Text = string.format(
					Text.EndStats,
					string.format("%02d:%02d", count // 60, count % 60),
					s.fusesCollected,
					s.fusesTotal
				)
				task.wait(STEP)
			end
		end)
	else
		ui.finaleSubtitle.TextTransparency = 0
	end
end

local function playScareThenFinale(s: GameState.Snapshot)
	local ui = r()
	endToken += 1
	local token = endToken
	task.spawn(function()
		ui.scare.Visible = true
		local motion = SettingsController.get("flashes")
		local frames = 16
		for i = 1, frames do
			if token ~= endToken then
				return
			end
			local alt = i % 2 == 0
			ui.faces[1].Visible = not alt
			ui.faces[2].Visible = alt
			-- Fundo pisca vermelho só com efeitos de movimento ligados (conforto).
			ui.scare.BackgroundColor3 = if motion and alt and i < 8 then Color3.fromRGB(70, 0, 0) else Theme.Black
			task.wait(1 / 8)
		end
		if token ~= endToken then
			return
		end
		ui.scare.Visible = false
		showFinale(snapshot or s) -- snapshot mais recente (o horário de fim chega depois da fase)
	end)
end

-- mode: "full" (do zero) ou "checkpoint" (continuar depois de voltar a energia).
local function requestRestart(mode: "full" | "checkpoint")
	task.spawn(function()
		local ok, err = pcall(function()
			Remotes.clientFunction("RequestRestart", 5):InvokeServer(mode)
		end)
		if not ok then
			warn(`[GameUi] restart failed: {err}`)
		end
	end)
end

-- Legenda temporária, com pequena entrada em 2 quadros.
local function showCaption(text: string, duration: number?)
	if text == "" then
		return
	end
	local ui = r()
	captionToken += 1
	local token = captionToken
	task.spawn(function()
		ui.caption.Visible = true
		ui.caption.Text = text
		ui.caption.Position = UDim2.new(0.5, 0, 1, -64)
		if SettingsController.motionEnabled() then
			ui.caption.Position += UDim2.fromOffset(0, 8)
			TweenService:Create(ui.caption, TweenInfo.new(0.16), { Position = UDim2.new(0.5, 0, 1, -64) }):Play()
		end
		ui.caption.TextTransparency = 0.5
		task.wait(STEP)
		ui.caption.TextTransparency = 0
		task.wait(duration or 3)
		if token == captionToken then
			ui.caption.Visible = false
		end
	end)
end

local function onState(s: GameState.Snapshot, changed: string?)
	local previous = snapshot
	snapshot = s
	local ui = r()
	refreshObjective(s)

	local phaseChanged = previous == nil or previous.phase ~= s.phase
	if phaseChanged then
		if s.phase == "Intro" then
			endToken += 1
			ui.finale.Visible = false
			ui.scare.Visible = false
			ui.note.Visible = false
			noteOpen = false
			playIntro(s.fromCheckpoint)
		elseif s.phase == "Playing" then
			endIntro()
		elseif s.phase == "Lost" then
			ui.note.Visible = false
			noteOpen = false
			playScareThenFinale(s)
		elseif s.phase == "Won" then
			ui.note.Visible = false
			noteOpen = false
			endToken += 1
			showFinale(s)
		end
	end

	if previous and s.phase == "Playing" then
		if s.creatureActive and not previous.creatureActive then
			showCaption(Text.Captions.awaken, 4)
		end
		if s.powerOn and not previous.powerOn then
			showCaption(Text.Captions.power, 5)
		end
		if s.gateOpen and not previous.gateOpen then
			showCaption(Text.Captions.gate, 4)
		end
		if s.checkpointReady and not previous.checkpointReady then
			task.delay(5.5, function()
				showCaption(Text.Hints.checkpoint, 3)
			end)
		end
	end
	if changed == "RoundEndedAt" and (s.phase == "Won" or s.phase == "Lost") and ui.finale.Visible then
		showFinale(s)
	end
end

local GameUiController = {
	Name = "GameUiController",
}

function GameUiController.Init()
	local ui = build()
	refs = ui
	-- Interações/avisos também existem no coop, cujo HUD desliga somente o painel solo.
	local shared = Create("ScreenGui", {
		Name = "InteractionUi",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		DisplayOrder = 70,
		Parent = player:WaitForChild("PlayerGui"),
	})
	ui.prompt.Parent = shared
	ui.caption.Parent = shared
	ui.note.Parent = shared
	local safe = Create(
		"Frame",
		{ Name = "SafeArea", Parent = shared, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }
	) :: Frame
	ui.prompt.Parent, ui.caption.Parent, ui.note.Parent = safe, safe, safe
	RunService.RenderStepped:Connect(function()
		local size = safe.AbsoluteSize
		local touch = UserInputService.TouchEnabled
		ui.note.Size = UDim2.fromOffset(math.min(460, size.X - 24), math.min(400, size.Y - 24))
		ui.note.Rotation = if touch then 0 else -1.5
		if ui.note.Visible then
			local reading = ui.note:FindFirstChild("Reading") :: ScrollingFrame
			local bounds = game:GetService("TextService"):GetTextSize(
				ui.noteText.Text,
				19,
				Enum.Font.Gotham,
				Vector2.new(math.max(100, reading.AbsoluteSize.X - 12), 100000)
			)
			ui.noteText.Size, reading.CanvasSize =
				UDim2.new(1, -12, 0, bounds.Y + 32), UDim2.fromOffset(0, bounds.Y + 32)
		end
		if touch then
			ui.prompt.Position = UDim2.new(if size.X < 600 then 0.5 else 0.38, 0, 0.5, 12)
			ui.prompt.Size = UDim2.fromOffset(math.min(400, size.X - (if size.X < 600 then 32 else 280)), 48)
			ui.prompt.TextSize = 14
			ui.caption.Position, ui.caption.Size = UDim2.new(0.5, 0, 1, -12), UDim2.new(1, -24, 0, 44)
		end
	end)
	ui.caption.Font = Enum.Font.Code
	ui.caption.TextSize = 16
	ui.caption.BackgroundColor3 = Theme.Panel
	ui.caption.BackgroundTransparency = 0.12
	local function visibility()
		(shared :: ScreenGui).Enabled = player:GetAttribute("CinematicActive") ~= true
			and player:GetAttribute("ComfortMenuOpen") ~= true
			and player:GetAttribute("FieldGuideOpen") ~= true
			and player:GetAttribute("TouchBackpackOpen") ~= true
	end
	player:GetAttributeChangedSignal("CinematicActive"):Connect(visibility)
	for _, key in { "ComfortMenuOpen", "FieldGuideOpen", "TouchBackpackOpen" } do
		player:GetAttributeChangedSignal(key):Connect(visibility)
	end
	visibility()
	refreshHelp()
end

function GameUiController.Start()
	local ui = r()
	GameState.observe(onState)
	local notePosition = ui.note.Position
	ui.note:GetPropertyChangedSignal("Visible"):Connect(function()
		if not ui.note.Visible then
			ui.note.Position = notePosition
		end
	end)
	local function cinematicChanged()
		local active = player:GetAttribute("CinematicActive") == true
		-- Solo: a cena fica limpa (objetivo/legendas somem). No coop o CampaignController já esconde esta tela.
		if not Config.Campaign.Enabled then
			ui.gui.Enabled = not active
		end
		if active then
			ui.intro.Visible = false
			ui.finale.Visible = false
		elseif snapshot and (snapshot.phase == "Won" or snapshot.phase == "Lost") then
			showFinale(snapshot)
		end
	end
	player:GetAttributeChangedSignal("CinematicActive"):Connect(cinematicChanged)
	cinematicChanged()

	ui.restart.Activated:Connect(function()
		requestRestart("full")
	end)
	ui.continueButton.Activated:Connect(function()
		requestRestart("checkpoint")
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		local s = snapshot
		if input.KeyCode == Enum.KeyCode.R and s and (s.phase == "Won" or s.phase == "Lost") then
			requestRestart("full")
		elseif input.KeyCode == Enum.KeyCode.C and s and s.phase == "Lost" and s.checkpointReady then
			requestRestart("checkpoint")
		elseif input.KeyCode == Enum.KeyCode.H then
			ui.help.Visible = not ui.help.Visible
			refreshHelp()
		end
	end)

	SettingsController.onChanged(function(key, value)
		refreshHelp()
		local template = if key == "retro" then Text.SettingRetro else Text.SettingMotion
		showCaption(string.format(template, onOff(value)), 2)
	end)

	-- Atualizações em passos: piscar dos ícones, fôlego, lanterna.
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		accumulator += dt
		if accumulator < STEP then
			return
		end
		accumulator = 0
		blinkOn = (os.clock() * 2) % 2 < 1
		local s = snapshot
		if s then
			refreshObjective(s)
		end
		-- Inventário: só enquanto segura Tab, durante a rodada.
		local showInventory = s ~= nil
			and (s.phase == "Playing" or s.phase == "Intro")
			and UserInputService:IsKeyDown(Enum.KeyCode.Tab)
		ui.inventory.Visible = showInventory
		if showInventory and s then
			local battery = player:GetAttribute("Battery")
			local percent = math.floor((if type(battery) == "number" then battery else 0) * 100 + 0.5)
			ui.inventory.Text = table.concat({
				Text.Inventory.title,
				string.format(Text.Inventory.fuses, s.fusesHeld, s.fusesInserted, s.fusesTotal),
				if s.hasKey then Text.Inventory.key else Text.Inventory.noKey,
				string.format(Text.Inventory.battery, percent),
			}, "\n")
		end
	end)
end

function GameUiController.setPrompt(text: string?)
	local ui = r()
	if text and UserInputService.TouchEnabled then
		if (player:GetAttribute("Hidden") or "") ~= "" then
			text = "Toque SAIR · Segure O AR para prender a respiração"
				.. (if player:GetAttribute("HoldBreath") == true then "\nPRENDENDO O AR..." else "")
		else
			text = text:gsub("%[E%]", "AÇÃO"):gsub("aperte E", "toque AÇÃO")
		end
	end
	ui.prompt.Visible = text ~= nil
	if text then
		ui.prompt.Text = text
	end
end

function GameUiController.caption(text: string, duration: number?)
	showCaption(text, duration)
end

function GameUiController.showNote(id: string)
	local ui = r()
	local text = (Text.Notes :: any)[id] or ""
	ui.noteText.Text = if id == "note_breakers" then string.format(text, GameState.snapshot().breakerOrder) else text
	ui.note.Visible = true
	local reading = ui.note:FindFirstChild("Reading") :: ScrollingFrame
	reading.CanvasPosition = Vector2.zero
	if SettingsController.motionEnabled() then
		local target = UDim2.fromScale(0.5, 0.5)
		ui.note.Position = target + UDim2.fromOffset(0, 12)
		TweenService:Create(ui.note, TweenInfo.new(0.18), { Position = target }):Play()
	end
	noteOpen = true
	player:SetAttribute("NoteOpen", true)
end

function GameUiController.isNoteOpen(): boolean
	return noteOpen
end

function GameUiController.closeNote()
	local ui = r()
	ui.note.Visible = false
	noteOpen = false
	player:SetAttribute("NoteOpen", false)
end

return GameUiController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="336">
          <Properties>
            <string name="Name">HapticsController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Vibração do controle (gamepad). O PC continua sendo a plataforma principal: sem controle
	conectado, ou com a opção de conforto "haptics" desligada, nada acontece.
	Mobile não é coberto: o HapticService só dirige motores de gamepad.

	Eventos (todos locais e pessoais, como o resto da apresentação da ameaça):
	  passos do Vigia por perto (pulso no motor grande, mais forte quanto mais perto),
	  detecção (o Vigia começou a perseguir VOCÊ), captura, batimento com medo alto, pouso.
]]

local HapticService = game:GetService("HapticService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local CharacterController = require("./CharacterController")
local FearController = require("./FearController")
local SettingsController = require("./SettingsController")

type Pulse = { motor: Enum.VibrationMotor, strength: number, endsAt: number }

local player = Players.LocalPlayer
local INPUT = Enum.UserInputType.Gamepad1
local LARGE = Enum.VibrationMotor.Large
local SMALL = Enum.VibrationMotor.Small

local pulses: { Pulse } = {}
local applied: { [Enum.VibrationMotor]: number } = { [LARGE] = 0, [SMALL] = 0 }
local supportCache: { [Enum.VibrationMotor]: boolean } = {}
local snapshot: GameState.Snapshot? = nil
local previousMode = "Dormant"
local previousStatus: string? = nil
local previousPhase: string? = nil
local nextStepAt = 0
local nextBeatAt = 0
local accumulator = 0

local function enabled(): boolean
	return SettingsController.get("haptics") and UserInputService.GamepadEnabled
end

local function supported(motor: Enum.VibrationMotor): boolean
	local cached = supportCache[motor]
	if cached ~= nil then
		return cached
	end
	local ok, value = pcall(function()
		return HapticService:IsVibrationSupported(INPUT) and HapticService:IsMotorSupported(INPUT, motor)
	end)
	local result = ok and value == true
	supportCache[motor] = result
	return result
end

local function setMotor(motor: Enum.VibrationMotor, value: number)
	if math.abs((applied[motor] or 0) - value) < 0.02 then
		return
	end
	applied[motor] = value
	if supported(motor) then
		pcall(function()
			HapticService:SetMotor(INPUT, motor, value)
		end)
	end
end

local function creature(): (BasePart?, string)
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	if not root or not root:IsA("BasePart") or root:GetAttribute(Tags.Attr.CreatureActive) ~= true then
		return nil, "Dormant"
	end
	local status = player:GetAttribute("CampaignStatus") :: string?
	local mode = Presentation.mode(
		(root:GetAttribute(Tags.Attr.CreatureMode) :: string?) or "Dormant",
		root:GetAttribute(Tags.Attr.ThreatTargetUserId) :: number?,
		player.UserId,
		status
	)
	return root, mode
end

local HapticsController = {
	Name = "HapticsController",
}

-- Pulso avulso: força 0..1 por `duration` segundos.
function HapticsController.pulse(strength: number, duration: number, motor: Enum.VibrationMotor?)
	if not enabled() then
		return
	end
	table.insert(pulses, {
		motor = motor or LARGE,
		strength = math.clamp(strength, 0, 1),
		endsAt = os.clock() + duration,
	})
end

function HapticsController.stopAll()
	table.clear(pulses)
	setMotor(LARGE, 0)
	setMotor(SMALL, 0)
end

function HapticsController.debugState(): { [string]: any }
	return { enabled = enabled(), pulses = #pulses, large = applied[LARGE], small = applied[SMALL] }
end

function HapticsController.Start()
	GameState.observe(function(next)
		snapshot = next
	end)
	SettingsController.onChanged(function(key, value)
		if key == "haptics" and not value then
			HapticsController.stopAll()
		end
	end)
	UserInputService.GamepadDisconnected:Connect(function()
		HapticsController.stopAll()
	end)
	CharacterController.onLanded(function(intensity: number)
		HapticsController.pulse(0.25 + intensity * 0.5, 0.15)
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		if not enabled() then
			if applied[LARGE] > 0 or applied[SMALL] > 0 then
				HapticsController.stopAll()
			end
			return
		end
		local s = snapshot
		local now = os.clock()
		local status = player:GetAttribute("CampaignStatus") :: string?
		local playing = s ~= nil and Presentation.playing(s.phase, status)
		local root, mode = creature()

		if s and Presentation.captured(previousStatus, status, previousPhase, s.phase) then
			HapticsController.pulse(1, 0.6, LARGE)
			HapticsController.pulse(0.8, 0.45, SMALL)
		end
		previousStatus = status
		previousPhase = if s then s.phase else nil

		if playing then
			if mode == "Chase" and previousMode ~= "Chase" then
				HapticsController.pulse(0.6, 0.35, LARGE)
			end
			-- Passos do Vigia: batidas cada vez mais fortes perto de você.
			local camera = workspace.CurrentCamera
			if root and camera and mode ~= "Dormant" then
				local distance = (root.Position - camera.CFrame.Position).Magnitude
				if distance < 22 and now >= nextStepAt then
					local k = (22 - distance) / 22
					nextStepAt = now + (if mode == "Chase" then 0.42 else 0.75)
					HapticsController.pulse(0.1 + 0.35 * k * k, 0.08, LARGE)
				end
			end
			-- Batimento: dois toques curtos no motor pequeno quando o medo está alto.
			local fear = FearController.get()
			if fear > 0.7 and now >= nextBeatAt then
				nextBeatAt = now + 60 / (70 + fear * 60)
				HapticsController.pulse(0.35, 0.07, SMALL)
				task.delay(0.16, function()
					HapticsController.pulse(0.25, 0.06, SMALL)
				end)
			end
		end
		previousMode = mode

		local large, small = 0, 0
		for i = #pulses, 1, -1 do
			local p = pulses[i]
			if now >= p.endsAt then
				table.remove(pulses, i)
			elseif p.motor == LARGE then
				large = math.max(large, p.strength)
			else
				small = math.max(small, p.strength)
			end
		end
		setMotor(LARGE, large)
		setMotor(SMALL, small)
	end)
end

return HapticsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="337">
          <Properties>
            <string name="Name">HudController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Painel de debug construído por código (F3 alterna; padrão em Config.Debug.ShowHud).
	Mostra FPS médio, fase, estado da criatura e posição. Também expõe métricas para testes
	(HudController.metrics()).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Create = require("../UI/Create")
local CreatureVisualController = require("./CreatureVisualController")
local FearController = require("./FearController")
local TensionController = require("./TensionController")

local GUI_NAME = "DebugHud"

local label: TextLabel? = nil
local gui: ScreenGui? = nil
local frameTimes: { number } = {}
local frameIndex = 0
local SAMPLE = 120
local worstFrame = 0

local function averageFps(): number
	local count = #frameTimes
	if count == 0 then
		return 0
	end
	local total = 0
	for _, dt in frameTimes do
		total += dt
	end
	return count / total
end

local HudController = {
	Name = "HudController",
}

function HudController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local screenGui = Create("ScreenGui", {
		Name = GUI_NAME,
		ResetOnSpawn = false,
		DisplayOrder = 100,
		Enabled = Config.Debug.ShowHud,
	}) :: ScreenGui
	label = Create("TextLabel", {
		Name = "Info",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.fromRGB(20, 20, 24),
		BackgroundTransparency = 0.25,
		TextColor3 = Color3.fromRGB(235, 235, 235),
		FontFace = Font.fromEnum(Enum.Font.RobotoMono),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = screenGui,
	}, {
		Create("UIPadding", {
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	}) :: TextLabel
	screenGui.Parent = playerGui
	gui = screenGui
end

function HudController.Start()
	UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.F3 and gui then
			gui.Enabled = not gui.Enabled
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		frameIndex = frameIndex % SAMPLE + 1
		frameTimes[frameIndex] = dt
		worstFrame = math.max(worstFrame * 0.995, dt)
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if label and gui and gui.Enabled then
				local ok, snapshot = pcall(GameState.snapshot)
				local shown, mode, distance = CreatureVisualController.status()
				local character = Players.LocalPlayer.Character
				local position = if character then character:GetPivot().Position else Vector3.zero
				label.Text = string.format(
					"FPS %.0f (pior %.1f ms)\nfase %s  | fusíveis %s\nvigia %s %s %.0f st\npos %.0f, %.0f, %.0f",
					averageFps(),
					worstFrame * 1000,
					if ok then snapshot.phase else "?",
					if ok then `{snapshot.fusesCollected}/{snapshot.fusesInserted}` else "?",
					if shown then "visível" else "oculto",
					mode,
					if distance < math.huge then distance else -1,
					position.X,
					position.Y,
					position.Z
				)
				local tension = TensionController.debugState()
				local lines: { string } = {}
				for i = math.max(1, #tension.log - 4), #tension.log do
					table.insert(lines, tension.log[i])
				end
				label.Text ..= string.format(
					"\nmedo %.2f | diretor %s\n%s",
					FearController.get(),
					tension.state,
					table.concat(lines, "\n")
				)
			end
		end
	end)
end

-- Métricas para validação de desempenho via MCP.
function HudController.metrics(): { [string]: number }
	local camera = workspace.CurrentCamera
	return {
		fps = averageFps(),
		worstFrameMs = worstFrame * 1000,
		viewportX = if camera then camera.ViewportSize.X else 0,
		viewportY = if camera then camera.ViewportSize.Y else 0,
	}
end

return HudController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="338">
          <Properties>
            <string name="Name">InteractionController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Interação "mire e aperte E" (estilo survival horror):
	- Procura o interagível habilitado mais alinhado com o centro da tela, dentro da distância,
	  com linha de visão. Mostra "[E] AÇÃO" na UI.
	- E envia o pedido ao servidor (remote Interact). O servidor valida TUDO de novo e responde
	  com uma chave de mensagem; o cliente só mostra o resultado.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Types = require("@game/ReplicatedStorage/Shared/Types")
local Rules = require("@game/ReplicatedStorage/Shared/Game/InteractionPresentation")
local AudioController = require("./AudioController")
local CameraController = require("./CameraController")
local CharacterController = require("./CharacterController")
local FearController = require("./FearController")
local FlashlightController = require("./FlashlightController")
local ScreenFxController = require("./ScreenFxController")
local GameUiController = require("./GameUiController")

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local player = Players.LocalPlayer
local breathRequested = false
local CONE_DEGREES = 24
local CONE_CLOSE_DEGREES = 40

local current: BasePart? = nil
local busy = false
local phase: GameState.Phase = "Loading"
local roundId = -1
local generation = 0
local hasKey = false
local campaign = false
local highlight: Highlight? = nil

local function hiddenId(): string?
	local id = player:GetAttribute("Hidden")
	return if type(id) == "string" and id ~= "" then id else nil
end

local function allowed(): boolean
	return player:GetAttribute("FieldGuideOpen") ~= true
		and player:GetAttribute("ComfortMenuOpen") ~= true
		and player:GetAttribute("CinematicActive") ~= true
		and Rules.allowed(phase, player:GetAttribute("CampaignStatus") :: string?)
end

local function clearTarget()
	current = nil
	if highlight then
		-- Sem alvo, Adornee=nil usa o Parent (Workspace) e contorna o cenário inteiro.
		highlight.Enabled = false
		highlight.Adornee = nil
	end
	GameUiController.setPrompt(nil)
end

local function holdBreath(value: boolean)
	if value == breathRequested then
		return
	end
	breathRequested = value
	task.spawn(function()
		local ok, remote = pcall(Remotes.clientEvent, "SetHoldBreath", 5)
		if ok then
			remote:FireServer(value)
		end
	end)
end

local function visible(camera: Camera, part: BasePart): boolean
	local origin = camera.CFrame.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = {}
	if player.Character then
		table.insert(exclude, player.Character)
	end
	params.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(origin, part.Position - origin, params)
	if hit == nil or hit.Instance == part then
		return true
	end
	return (hit.Position - part.Position).Magnitude <= 1.5
end

local function findTarget(camera: Camera): BasePart?
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local best: BasePart? = nil
	local bestAngle = math.huge
	for _, instance in CollectionService:GetTagged(Tags.Interactable) do
		if instance:IsA("BasePart") and instance:GetAttribute(Tags.Attr.InteractEnabled) == true then
			local offset = instance.Position - origin
			local distance = offset.Magnitude
			local maxDistance = (instance:GetAttribute(Tags.Attr.InteractDistance) :: number?) or 8
			if distance <= maxDistance and distance > 0.01 then
				local angle = math.deg(math.acos(math.clamp(look:Dot(offset.Unit), -1, 1)))
				local limit = if distance < 3.5 then CONE_CLOSE_DEGREES else CONE_DEGREES
				if angle <= limit and angle < bestAngle and visible(camera, instance) then
					best = instance
					bestAngle = angle
				end
			end
		end
	end
	return best
end

local function messageFor(key: string): string
	return (Text.Messages :: any)[key] or ""
end

local function interact(id: string, part: BasePart?, action: string?)
	if busy or not allowed() then
		return
	end
	busy = true
	local token = generation
	-- A coleta remove a peça no servidor; guardar a origem antes do pedido.
	local origin = if part then part.Position else Vector3.zero
	local ok, response = pcall(function()
		return Remotes.clientFunction("Interact", 5):InvokeServer(id, action)
	end)
	busy = false
	if token ~= generation or not allowed() then
		return
	end
	if not ok then
		GameUiController.caption(messageFor("unknown"))
		return
	end
	local result = response :: Types.Result<Types.InteractResponse>
	if not result.ok then
		return -- rate limit / argumentos: silencioso
	end
	local data = result.data
	if data.accepted then
		if data.note then
			AudioController.play("Paper", 1, 0.8)
			GameUiController.showNote(data.note)
		elseif Rules.pickup(data.kind) then
			FlashlightController.showPickup(data.kind :: string, origin)
		elseif data.kind == "Unlock" then
			FlashlightController.playKeyUnlock()
		elseif data.kind == "BreakerSolved" or (campaign and data.message == "solved") then
			ScreenFxController.pulse(Color3.fromRGB(70, 170, 95))
			AudioController.play("Switch", 0.6, 1.3)
		elseif campaign and data.message == "progress" then
			AudioController.play("Switch", 0.5, 1.2)
		end
	else
		AudioController.play("UiBlip", 1, 0.55)
		if data.kind == "BreakerWrong" or (campaign and data.message == "wrong_sequence") then
			CameraController.addTrauma(0.5)
			FearController.spike(0.15)
			ScreenFxController.pulse(Color3.fromRGB(165, 25, 25))
		elseif data.kind == "DoorLocked" then
			CameraController.addTrauma(0.1)
		end
	end
	local text = messageFor(data.message)
	if text ~= "" then
		GameUiController.caption(text)
	end
end

local InteractionController = {
	Name = "InteractionController",
}

-- Entrada única para teclado e outras interfaces; nunca aceita um ID arbitrário do chamador.
function InteractionController.activate(action: string?)
	if not allowed() then
		return
	end
	local alt = action == "alt"
	if GameUiController.isNoteOpen() then
		if not alt then
			GameUiController.closeNote()
		end
		return
	end
	local hidden = hiddenId()
	if hidden then
		if not alt then
			task.spawn(interact, hidden, nil, nil)
		end
		return
	end
	local part = current
	if part then
		local id = part:GetAttribute(Tags.Attr.InteractId)
		if
			type(id) == "string" and (not alt or (not campaign and type(part:GetAttribute("InteractAlt")) == "string"))
		then
			task.spawn(interact, id, part, if alt then "alt" else nil)
		end
	end
end

function InteractionController.requestBreath(value: boolean)
	if not value or allowed() then
		holdBreath(value)
	end
end
function InteractionController.useSupply(item: string)
	if allowed() then
		task.spawn(function()
			Remotes.clientFunction("UseHouseItem", 5):InvokeServer(item)
		end)
	end
end
function InteractionController.Start()
	campaign = GameState.wait():GetAttribute("CampaignActive") == true
	local focus = Instance.new("Highlight")
	highlight = focus
	focus.Name = "InteractionFocus"
	focus.Enabled = false
	focus.FillTransparency = 1
	focus.OutlineTransparency = 0.55
	focus.OutlineColor = Color3.fromRGB(205, 188, 144)
	focus.DepthMode = Enum.HighlightDepthMode.Occluded
	focus.Parent = workspace
	GameState.observe(function(snapshot)
		if roundId ~= snapshot.roundId or phase ~= snapshot.phase then
			generation += 1
			clearTarget()
		end
		roundId = snapshot.roundId
		hasKey = snapshot.hasKey
		phase = snapshot.phase
	end)
	player:GetAttributeChangedSignal("CampaignStatus"):Connect(function()
		generation += 1
		clearTarget()
	end)
	local function syncHidden()
		local eye = player:GetAttribute("HideEye")
		if hiddenId() and typeof(eye) == "CFrame" and allowed() then
			CameraController.setHidden(eye :: CFrame)
		else
			CameraController.setHidden(nil)
		end
	end
	player:GetAttributeChangedSignal("Hidden"):Connect(syncHidden)
	player:GetAttributeChangedSignal("HideEye"):Connect(syncHidden)
	player.CharacterAdded:Connect(function()
		generation += 1
		CameraController.setHidden(nil)
		clearTarget()
	end)
	syncHidden()
	CharacterController.onStandBlocked(function()
		GameUiController.caption(Text.Hints.no_room)
	end)
	FlashlightController.onHint(function(key)
		local text = (Text.Hints :: any)[key]
		if text and allowed() then
			GameUiController.caption(text)
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not allowed() then
			return
		end
		if input.KeyCode ~= Enum.KeyCode.E and input.KeyCode ~= Enum.KeyCode.Q then
			return
		end
		InteractionController.activate(if input.KeyCode == Enum.KeyCode.Q then "alt" else nil)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Space then
			holdBreath(false)
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		holdBreath(false)
	end)

	local function breathAction(_: string, state: Enum.UserInputState, input: InputObject)
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			holdBreath(false)
			return Enum.ContextActionResult.Sink
		end
		if input.KeyCode == Enum.KeyCode.Space and not hiddenId() then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and allowed() and not UserInputService:GetFocusedTextBox() then
			holdBreath(true)
		end
		return Enum.ContextActionResult.Sink
	end
	ContextActionService:BindAction(
		"HouseBreath",
		breathAction,
		false,
		(Enum.KeyCode :: any)[Config.House.BreathKey],
		Enum.KeyCode.ButtonL1,
		Enum.KeyCode.Space
	)
	ContextActionService:BindAction("HouseInteract", function(_, state)
		if state == Enum.UserInputState.Begin then
			InteractionController.activate()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonX)
	ContextActionService:BindAction("HouseLightTouch", function(_, state)
		if state == Enum.UserInputState.Begin and allowed() then
			FlashlightController.set(not FlashlightController.isWanted())
		end
		return Enum.ContextActionResult.Sink
	end, false)
	local function cancelBreath()
		holdBreath(false)
	end
	GuiService.MenuOpened:Connect(cancelBreath)
	for _, attr in { "CampaignStatus", "CinematicActive", "FieldGuideOpen", "ComfortMenuOpen", "Hidden" } do
		player:GetAttributeChangedSignal(attr):Connect(cancelBreath)
	end
	player.CharacterAdded:Connect(cancelBreath)

	ContextActionService:BindAction("HouseBattery", function(_, state)
		if state == Enum.UserInputState.Begin then
			InteractionController.useSupply("battery")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.One, Enum.KeyCode.DPadLeft)
	ContextActionService:BindAction("HouseOxygen", function(_, state)
		if state == Enum.UserInputState.Begin then
			InteractionController.useSupply("oxygen")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Two, Enum.KeyCode.DPadUp)
	ContextActionService:BindAction("HouseDecoy", function(_, state)
		if state == Enum.UserInputState.Begin then
			InteractionController.useSupply("decoy")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Three, Enum.KeyCode.DPadRight)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		accumulator += dt
		if accumulator < 1 / 20 then
			return
		end
		accumulator = 0
		local camera = workspace.CurrentCamera
		if not camera or not allowed() or GameUiController.isNoteOpen() then
			clearTarget()
			return
		end
		if hiddenId() then
			clearTarget()
			GameUiController.setPrompt(
				Text.HiddenHint .. (if player:GetAttribute("HoldBreath") then "\n" .. Text.HoldingBreath else "")
			)
			return
		end
		current = findTarget(camera)
		if current then
			local prompt = current:GetAttribute(Tags.Attr.InteractPrompt)
			GameUiController.setPrompt(
				Rules.prompt(
					if type(prompt) == "string" then prompt else "",
					current:GetAttribute("InteractAlt") :: string?,
					current:GetAttribute("Locked") == true,
					hasKey,
					campaign
				)
			)
			local parent = current.Parent
			if highlight then
				highlight.Adornee = if parent and parent:IsA("Model") then parent else current
				highlight.Enabled = true
			end
		else
			clearTarget()
		end
	end)
end

-- Para testes/depuração: o que está sob a mira agora.
function InteractionController.currentTarget(): string?
	local part = current
	if part then
		local id = part:GetAttribute(Tags.Attr.InteractId)
		return if type(id) == "string" then id else nil
	end
	return nil
end

-- QA usa a mesma mira, visibilidade, estado e envio do botão E. Não ativa um alvo bloqueado.
function InteractionController.testInteract(expectedId: string): boolean
	assert(RunService:IsStudio(), "Studio-only interaction QA")
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local camera = workspace.CurrentCamera
	if not head or not head:IsA("BasePart") or not camera or not allowed() then
		return false
	end
	if hiddenId() == expectedId then
		interact(expectedId, nil)
		return true
	end
	local focus: BasePart? = nil
	for _, candidate in CollectionService:GetTagged(Tags.Interactable) do
		if candidate:IsA("BasePart") and candidate:GetAttribute(Tags.Attr.InteractId) == expectedId then
			focus = candidate
			break
		end
	end
	if not focus then
		return false
	end
	local previous = camera.CFrame
	camera.CFrame = CFrame.lookAt(head.Position, focus.Position)
	local selected = findTarget(camera)
	camera.CFrame = previous
	if selected ~= focus then
		return false
	end
	current = selected
	interact(expectedId, selected)
	return true
end
return InteractionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="339">
          <Properties>
            <string name="Name">LightingController</string>
            <string name="Source"><![CDATA[--!strict
-- Compositor único do pós artístico/exposição/névoa. Filtros equipáveis usam outra camada.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Profile = require("@game/ReplicatedStorage/Shared/Game/LightingProfile")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Settings = require("./SettingsController")

local player = Players.LocalPlayer
local grade: ColorCorrectionEffect? = nil
local filter: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local depth: DepthOfFieldEffect? = nil
local indoor = 0
local power = 0
local danger = 0
local fog = Profile.World.fogEnd
local baseFog = Profile.World.fogEnd
local insideTarget = false
local rayClock = 1
local elapsed = 0
local treatment = 1
local forest = 0
local controller = { Name = "LightingController" }

local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end

function controller.setDanger(value: number)
	danger = math.clamp(value, 0, 1)
end

function controller.setFilter(item: StoreCatalog.Item)
	local fx = filter
	if not fx then
		return
	end
	local neutral = item.id == StoreCatalog.defaultFor("filter")
	fx.TintColor = if neutral or not item.tint then Color3.new(1, 1, 1) else rgb(item.tint)
	fx.Contrast = if neutral then 0 else item.contrast or 0
	fx.Saturation = if neutral then 0 else item.saturation or 0
	fx.Brightness = if neutral then 0 else item.brightness or 0
end

local function underRoof(position: Vector3): boolean
	local world = workspace:FindFirstChild(Tags.WorldFolder)
	if not world then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { world }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(position, Vector3.new(0, 18, 0), params)
	return hit ~= nil and hit.Instance.CanCollide
end

function controller.debugState(): { [string]: any }
	return {
		indoor = indoor,
		power = power,
		danger = danger,
		fog = Lighting.FogEnd,
		baseFog = baseFog,
		exposure = Lighting.ExposureCompensation,
		shadows = Lighting.GlobalShadows,
		style = Lighting.LightingStyle.Name,
		bloom = bloom and bloom.Intensity,
		depth = depth and depth.FarIntensity,
		contrast = grade and grade.Contrast,
		quality = Settings.visualBudget().name,
		shaders = Settings.shadersEnabled(),
		forest = forest,
	}
end

function controller.Init()
	Lighting.ClockTime = Profile.World.clock
	local scene = Instance.new("ColorCorrectionEffect")
	scene.Name = "S9SceneGrade"
	scene.Parent = Lighting
	grade = scene
	local cosmetic = Instance.new("ColorCorrectionEffect")
	cosmetic.Name = "RetroGrade"
	cosmetic.Parent = Lighting
	filter = cosmetic
	local glow = Instance.new("BloomEffect")
	glow.Name = "RetroBloom"
	glow.Intensity = Profile.Bloom.intensity
	glow.Size = Profile.Bloom.size
	glow.Threshold = Profile.Bloom.threshold
	glow.Parent = Lighting
	bloom = glow
	local dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "S9CinemaDepth"
	dof.FocusDistance = 55
	dof.InFocusRadius = 45
	dof.NearIntensity = 0
	dof.FarIntensity = 0
	dof.Enabled = false
	dof.Parent = Lighting
	depth = dof
end

function controller.Start()
	local function syncBase()
		local value = Lighting:GetAttribute("BaseFogEnd")
		if type(value) == "number" then
			baseFog = value
		end
	end
	syncBase()
	fog = baseFog
	power = if Lighting:GetAttribute("S9PowerOn") == true then 1 else 0
	Lighting:GetAttributeChangedSignal("BaseFogEnd"):Connect(syncBase)
	RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		rayClock += dt
		if elapsed < 1 / 20 then
			return
		end
		local delta = elapsed
		elapsed = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		if rayClock >= 0.35 then
			rayClock = 0
			insideTarget = underRoof(camera.CFrame.Position)
		end
		indoor = Profile.approach(indoor, if insideTarget then 1 else 0, delta)
		power = Profile.approach(power, if Lighting:GetAttribute("S9PowerOn") == true then 1 else 0, delta)
		local world = workspace:FindFirstChild(Tags.WorldFolder)
		forest = Profile.approach(forest, if world and world:GetAttribute("ForestActive") == true then 1 else 0, delta)
		-- A mesma composição governa luz funcional e profundidade, inclusive com Shaders OFF.
		Lighting.Ambient = rgb(Profile.ambient(indoor, power, forest))
		Lighting.OutdoorAmbient = rgb(Profile.World.outdoor):Lerp(rgb(Profile.Forest.outdoor), forest)
		Lighting.FogColor =
			rgb(Profile.World.fog):Lerp(rgb(Profile.World.fogPower), power):Lerp(rgb(Profile.Forest.fog), forest)
		Lighting.FogStart = Profile.World.fogStart + (Profile.Forest.fogStart - Profile.World.fogStart) * forest
		local values = Profile.grade(indoor, power)
		local budget = Settings.visualBudget()
		treatment = Profile.approach(treatment, if Settings.shadersEnabled() then 1 else 0, delta)
		if grade then
			grade.TintColor = Color3.new(1, 1, 1):Lerp(rgb(values.tint), treatment)
			grade.Contrast = values.contrast * treatment
			grade.Saturation = values.saturation * treatment
			grade.Brightness = values.brightness * treatment
		end
		if bloom then
			bloom.Intensity = Profile.approach(bloom.Intensity, budget.bloom, delta)
			bloom.Enabled = bloom.Intensity > 0.001
		end
		if filter then
			filter.Enabled = Settings.shadersEnabled()
		end
		Lighting.ExposureCompensation = Profile.exposure(indoor, power) + forest * Profile.Forest.exposure
		fog =
			Profile.approach(fog, Profile.fogEnd(baseFog * (1 + (Profile.Forest.fogScale - 1) * forest), danger), delta)
		Lighting.FogEnd = fog
		local cinema = budget.depth and player:GetAttribute("CinematicActive") == true and Settings.motionEnabled()
		if depth then
			depth.Enabled = cinema
			depth.FarIntensity = if cinema then 0.07 else 0
		end
	end)
	if RunService:IsStudio() then
		-- Sonda na VM real: comparação de câmeras sem editar scripts sincronizados no Studio.
		local gui = Instance.new("ScreenGui")
		gui.Name = "LightingQA"
		gui.ResetOnSpawn = false
		gui.Enabled = false
		gui.Parent = player:WaitForChild("PlayerGui")
		local bridge = Instance.new("BindableFunction")
		bridge.Name = "Probe"
		local eye: Vector3? = nil
		local look = Vector3.zero
		local prior: { [ScreenGui]: boolean } = {}
		local priorCamera: { camera: Camera, kind: Enum.CameraType, cf: CFrame, focus: CFrame, fov: number }? = nil
		bridge.OnInvoke = function(command: string, position: Vector3?, target: Vector3?): any
			if command == "camera" and position and target then
				local camera = workspace.CurrentCamera
				if not eye and camera then
					priorCamera = {
						camera = camera,
						kind = camera.CameraType,
						cf = camera.CFrame,
						focus = camera.Focus,
						fov = camera.FieldOfView,
					}
				end
				eye, look = position, target
				player:SetAttribute("ModeMenuOpen", false)
				local cinema = player.PlayerGui:FindFirstChild("AnimationDebugBridge", true)
				if cinema and cinema:IsA("BindableFunction") then
					cinema:Invoke("skip")
				end
			elseif command == "release" then
				eye = nil
				local saved = priorCamera
				if saved and saved.camera.Parent then
					saved.camera.CameraType = saved.kind
					saved.camera.CFrame = saved.cf
					saved.camera.Focus = saved.focus
					saved.camera.FieldOfView = saved.fov
				end
				priorCamera = nil
				for ui, enabled in prior do
					if ui.Parent then
						ui.Enabled = enabled
					end
				end
				prior = {}
			end
			local state = controller.debugState()
			state.audio = require("./AudioController").debugState()
			state.fixtures = require("./WorldFxController").debugState()
			return state
		end
		bridge.Parent = gui
		RunService:BindToRenderStep("S9LightingQA", Enum.RenderPriority.Last.Value + 5, function()
			local camera = workspace.CurrentCamera
			if not eye or not camera then
				return
			end
			player:SetAttribute("ModeMenuOpen", false)
			for _, ui in player.PlayerGui:GetChildren() do
				if ui:IsA("ScreenGui") and ui ~= gui then
					if prior[ui] == nil then
						prior[ui] = ui.Enabled
					end
					ui.Enabled = false
				end
			end
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = CFrame.lookAt(eye, look)
			camera.Focus = CFrame.new(look)
			camera.FieldOfView = 65
		end)
	end
end
return controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="340">
          <Properties>
            <string name="Name">MainMenuController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Menu inicial (lobby da campanha). Substitui o antigo ModeMenuController.
	Remaster "Cursed Mansion" (docs/ui-remaster): barra superior com perfil e moedas, trilho de
	navegação com ícones próprios (no celular: 4 destinos + MAIS) e cartões de campanha ilustrados.
	O layout é reconstruído só quando a classe da tela muda (MenuLayout.mode), não a cada quadro.

	  Topo      logo, Fichas, Créditos (+ abre CRÉDITOS na loja), avatar, nível e XP.
	  Trilho    JOGAR em destaque e os demais destinos.
	  Painel    conteúdo da aba:
	    JOGAR       votar História ou Co-op, equipe no servidor, contagem, kit do turno e bônus;
	    MELHORIAS   vantagens permanentes (5 níveis), consumíveis e pacotes em Robux;
	    SERVIDORES  lista de servidores (LobbyService) com ENTRAR;
	    AMIGOS      amigos online (entrar no servidor deles) e convite;
	    LOJA / PASSE / RECOMPENSAS abrem a loja (StoreController) na aba certa.
	  Fundo     câmeras de segurança ao vivo (CinematicController, laço Attract) atrás de um véu.

	Nada é decidido aqui: votos (SelectGameMode), compras (Store) e teleporte (Lobby) passam por
	remotes validados no servidor. O estado vem dos atributos publicados (StoreService, CampaignRuntime).
	Na primeira entrada o menu espera a abertura do jogo (atributo OpeningActive).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
