        <Item class="ModuleScript" referent="358">
          <Properties>
            <string name="Name">AdemirPortrait</string>
            <string name="Source"><![CDATA[--!strict
-- Rosto do Ademir compartilhado entre o corpo e o susto. Uma textura local de 64 KiB,
-- reconstruída do módulo de dados; nenhuma foto é enviada ao Roblox.

local AssetService = game:GetService("AssetService")
local EncodingService = game:GetService("EncodingService")

local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Create = require("../UI/Create")
local Data = require("./AdemirFaceData")

local log = Logger.new("AdemirPortrait")
local portrait: EditableImage? = nil
local attempted = false

local function getPortrait(): EditableImage?
	if attempted then
		return portrait
	end
	attempted = true
	local created: EditableImage? = nil
	local ok, problem = pcall(function()
		local size = Vector2.new(Data.Width, Data.Height)
		local pixels = EncodingService:Base64Decode(buffer.fromstring(Data.RgbaBase64))
		assert(buffer.len(pixels) == Data.Width * Data.Height * 4, "invalid portrait pixel data")
		created = AssetService:CreateEditableImage({ Size = size })
		assert(created, "editable image memory unavailable")
		created:WritePixelsBuffer(Vector2.zero, size, pixels)
	end)
	if not ok then
		if created then
			created:Destroy()
		end
		log.warn("Portrait unavailable; using geometric face: %s", tostring(problem))
		return nil
	end
	portrait = created
	log.info("Local portrait ready (%dx%d)", Data.Width, Data.Height)
	return portrait
end

local AdemirPortrait = {}

-- Todas as imagens compartilham o mesmo EditableImage; o original segue retido pelo módulo.
function AdemirPortrait.createImage(props: { [string]: any }): ImageLabel?
	local image = getPortrait()
	if not image then
		return nil
	end
	local properties: { [string]: any } = {
		Name = "AdemirPhoto",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ImageContent = Content.fromObject(image),
		ResampleMode = Enum.ResamplerMode.Pixelated,
		ScaleType = Enum.ScaleType.Stretch,
	}
	for key, value in props do
		properties[key] = value
	end
	return Create("ImageLabel", properties) :: ImageLabel
end

function AdemirPortrait.applyToRig(parts: { [string]: BasePart }, light: PointLight)
	local head = parts.Head
	local surface = Create("SurfaceGui", {
		Name = "AdemirFace",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(Data.Width, Data.Height),
		AlwaysOnTop = false,
		LightInfluence = 0.35,
		Brightness = 1,
		Active = false,
		Parent = head,
	}) :: SurfaceGui
	if not AdemirPortrait.createImage({ Parent = surface }) then
		surface:Destroy()
		return
	end

	-- O cabelo da referência ocupa a frente; laterais e nuca formam uma massa escura low poly.
	head.Size = Vector3.new(1.12, 1.42, 0.85)
	head.Color = Color3.fromRGB(16, 13, 13)
	head:SetAttribute("Appearance", "AdemirPhoto")
	for _, name in { "Neck", "ForearmL", "ForearmR", "HandL", "HandR" } do
		parts[name].Color = Color3.fromRGB(110, 88, 78)
	end
	for _, name in { "Torso", "Pelvis", "Skirt", "Collar", "UpperArmL", "UpperArmR" } do
		parts[name].Color = Color3.fromRGB(20, 23, 23)
	end
	for _, name in { "EyeL", "EyeR", "Mouth" } do
		parts[name].Transparency = 1
	end
	light.Color = Color3.fromRGB(170, 200, 185)
	light.Range = 4
end

return AdemirPortrait
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="359">
          <Properties>
            <string name="Name">ArmadilhoRig</string>
            <string name="Source"><![CDATA[--!strict
-- Silhueta autoral do epílogo: crocodilo de mandíbulas longas e placas de armadura.
-- Só cenário local; não cria outro inimigo nem interfere na IA desta campanha.
local Rig = {}
function Rig.build(parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = "CrocodiloArmadilho"
	local function part(name: string, p: Vector3, size: Vector3, color: Color3): BasePart
		local piece = Instance.new("Part")
		piece.Name, piece.Size, piece.CFrame = name, size, CFrame.new(p)
		piece.Color, piece.Material = color, Enum.Material.Slate
		piece.Anchored, piece.CanCollide, piece.CanQuery, piece.CanTouch = true, false, false, false
		piece.TopSurface, piece.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		piece.Parent = model
		return piece
	end
	local skin = Color3.fromRGB(57, 77, 48)
	local armor = Color3.fromRGB(69, 61, 48)
	local root = part("Pivot", Vector3.zero, Vector3.one, skin)
	root.Transparency = 1
	model.PrimaryPart = root
	part("Body", Vector3.new(0, 2.9, 0), Vector3.new(5.4, 3.2, 7), skin)
	part("Neck", Vector3.new(0, 3, -3.5), Vector3.new(3.7, 2.7, 3), skin)
	part("Head", Vector3.new(0, 4, -5), Vector3.new(4.1, 2.7, 4), skin)
	part("UpperJaw", Vector3.new(0, 3.7, -8), Vector3.new(3.5, 1, 4.6), skin)
	local jaw = part("LowerJaw", Vector3.new(0, 2.4, -7.7), Vector3.new(3.2, 0.6, 4.5), skin)
	jaw.CFrame *= CFrame.Angles(math.rad(8), 0, 0)
	for _, side in { -1, 1 } do
		part("EyeSocket", Vector3.new(side * 1.8, 5.3, -5.8), Vector3.new(0.65, 0.65, 1.1), armor)
		part("Eye", Vector3.new(side * 1.95, 5.35, -6.2), Vector3.new(0.3, 0.28, 0.5), Color3.fromRGB(190, 132, 48))
		for _, z in { -2.5, 2.5 } do
			local leg = part("Leg", Vector3.new(side * 2.8, 1.5, z), Vector3.new(1.2, 2.8, 1.8), skin)
			leg.CFrame *= CFrame.Angles(0, 0, math.rad(side * 17))
			part("Claw", Vector3.new(side * 3.2, 0.35, z - 0.8), Vector3.new(1.6, 0.5, 2.3), armor)
		end
		for tooth = 1, 5 do
			part(
				"Tooth",
				Vector3.new(side * 1.4, 3, -6 - tooth * 0.7),
				Vector3.new(0.25, 0.9, 0.25),
				Color3.fromRGB(172, 162, 125)
			)
		end
	end
	for row = 1, 5 do
		local plate = part("ArmorPlate", Vector3.new(0, 4.6, 3.8 - row * 1.3), Vector3.new(5.8, 1.1, 1.1), armor)
		plate.CFrame *= CFrame.Angles(math.rad(-14), 0, 0)
	end
	for segment = 1, 5 do
		local tail = part(
			"Tail",
			Vector3.new(0.2 * segment, 2.2 - segment * 0.25, 3 + segment * 1.5),
			Vector3.new(3.1 - segment * 0.4, 1.8 - segment * 0.2, 2.2),
			skin
		)
		tail.CFrame *= CFrame.Angles(0, math.rad(segment * 6), 0)
	end
	model.Parent = parent
	return model
end
return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="360">
          <Properties>
            <string name="Name">ClipCodec</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Decodifica os clipes gerados por tools/tungtung/bake.js (TungTungClips). Módulo puro: só números,
	sem CFrame, para rodar também nos testes do Lune. O cliente monta os CFrames a partir daqui.

	Formato de cada quadro (int16 little-endian):
	  para cada osso de Bones: quaternion x, y, z, w (escala 32767)
	  para cada osso de posBones: x, y, z (escala 32767 = PosRange studs)
]]

export type RawClip = { fps: number, frames: number, loop: boolean, posBones: { string }, data: string }

export type Decoded = {
	fps: number,
	frames: number,
	loop: boolean,
	duration: number,
	boneCount: number,
	-- rot[(quadro - 1) * boneCount * 4 + (osso - 1) * 4 + 1 .. 4] = x, y, z, w
	rot: { number },
	-- pos[osso][(quadro - 1) * 3 + 1 .. 3] = x, y, z (só ossos com deslocamento)
	pos: { [number]: { number } },
}

local ClipCodec = {}

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local LOOKUP: { [number]: number } = {}
for index = 1, #ALPHABET do
	LOOKUP[string.byte(ALPHABET, index)] = index - 1
end

function ClipCodec.base64Decode(text: string): buffer
	local length = #text
	local padding = 0
	if string.sub(text, -2) == "==" then
		padding = 2
	elseif string.sub(text, -1) == "=" then
		padding = 1
	end
	local size = (length // 4) * 3 - padding
	local out = buffer.create(size)
	local cursor = 0
	for index = 1, length, 4 do
		local a = LOOKUP[string.byte(text, index)] or 0
		local b = LOOKUP[string.byte(text, index + 1)] or 0
		local c = LOOKUP[string.byte(text, index + 2)] or 0
		local d = LOOKUP[string.byte(text, index + 3)] or 0
		local value = a * 262144 + b * 4096 + c * 64 + d
		if cursor < size then
			buffer.writeu8(out, cursor, bit32.rshift(value, 16))
		end
		if cursor + 1 < size then
			buffer.writeu8(out, cursor + 1, bit32.band(bit32.rshift(value, 8), 255))
		end
		if cursor + 2 < size then
			buffer.writeu8(out, cursor + 2, bit32.band(value, 255))
		end
		cursor += 3
	end
	return out
end

function ClipCodec.decode(clip: RawClip, bones: { string }, posRange: number): Decoded
	local data = ClipCodec.base64Decode(clip.data)
	local boneCount = #bones
	local posIndex: { number } = {}
	for _, name in clip.posBones do
		local found = table.find(bones, name)
		assert(found, `[ClipCodec] unknown position bone {name}`)
		table.insert(posIndex, found)
	end
	local stride = boneCount * 8 + #posIndex * 6
	assert(buffer.len(data) == stride * clip.frames, "[ClipCodec] clip size does not match its header")
	local rot = table.create(clip.frames * boneCount * 4)
	local pos: { [number]: { number } } = {}
	for _, bone in posIndex do
		pos[bone] = table.create(clip.frames * 3)
	end
	local offset = 0
	for _ = 1, clip.frames do
		for _ = 1, boneCount * 4 do
			table.insert(rot, buffer.readi16(data, offset) / 32767)
			offset += 2
		end
		for _, bone in posIndex do
			local list = pos[bone]
			for _ = 1, 3 do
				table.insert(list, buffer.readi16(data, offset) / 32767 * posRange)
				offset += 2
			end
		end
	end
	return {
		fps = clip.fps,
		frames = clip.frames,
		loop = clip.loop,
		duration = (clip.frames - 1) / clip.fps,
		boneCount = boneCount,
		rot = rot,
		pos = pos,
	}
end

-- Quadros vizinhos e mistura para o tempo `time` (s). Clipes em laço dão a volta; os outros param no fim.
function ClipCodec.locate(decoded: Decoded, time: number): (number, number, number)
	local duration = decoded.duration
	local t = if decoded.loop and duration > 0 then time % duration else math.clamp(time, 0, duration)
	local position = t * decoded.fps
	local a = math.clamp(math.floor(position), 0, decoded.frames - 1)
	local b = math.min(a + 1, decoded.frames - 1)
	return a + 1, b + 1, position - a
end

-- Quaternion (x, y, z, w) de um osso num quadro.
function ClipCodec.rotation(decoded: Decoded, frame: number, bone: number): (number, number, number, number)
	local base = (frame - 1) * decoded.boneCount * 4 + (bone - 1) * 4
	local rot = decoded.rot
	return rot[base + 1], rot[base + 2], rot[base + 3], rot[base + 4]
end

-- Translação de um osso num quadro (0, 0, 0 se o osso não se desloca).
function ClipCodec.position(decoded: Decoded, frame: number, bone: number): (number, number, number)
	local list = decoded.pos[bone]
	if not list then
		return 0, 0, 0
	end
	local base = (frame - 1) * 3
	return list[base + 1], list[base + 2], list[base + 3]
end

return ClipCodec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="361">
          <Properties>
            <string name="Name">Poses</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Poses-chave do Vigia (graus). Não há interpolação: o controller mostra uma pose por vez,
	a ~8–12 poses por segundo (stop-motion), enquanto a posição real se move liso no servidor.

	Convenções (ver Rig.luau):
	  spine  < 0 = curva para frente        neck > 0 = cabeça para cima
	  hip    > 0 = perna para frente         knee < 0 = dobra para trás
	  shoulder > 0 = braço para frente       elbow < 0 = dobra
	  roll/yaw em graus; bob = deslocamento vertical (studs); step = toca o som de passo
]]

export type Pose = {
	spine: number,
	spineRoll: number,
	neck: number,
	neckYaw: number,
	neckRoll: number,
	lShoulder: number,
	lShoulderRoll: number,
	lElbow: number,
	rShoulder: number,
	rShoulderRoll: number,
	rElbow: number,
	lHip: number,
	lKnee: number,
	rHip: number,
	rKnee: number,
	bob: number,
	step: boolean,
}

local function pose(values: { [string]: any }): Pose
	local p: { [string]: any } = {
		spine = -24,
		spineRoll = 0,
		neck = 14,
		neckYaw = 0,
		neckRoll = 0,
		lShoulder = 4,
		lShoulderRoll = -4,
		lElbow = -10,
		rShoulder = 4,
		rShoulderRoll = 4,
		rElbow = -10,
		lHip = 0,
		lKnee = -6,
		rHip = 0,
		rKnee = -6,
		bob = 0,
		step = false,
	}
	for key, value in values do
		assert(p[key] ~= nil, `unknown pose key {key}`)
		p[key] = value
	end
	return table.freeze(p) :: any
end

local Poses: { [string]: { Pose } } = {
	Notice = {
		pose({ spine = -10, neck = 30, lShoulder = 32, rShoulder = 42, bob = 0.12 }),
		pose({ spine = -36, neck = 8, lShoulder = 75, rShoulder = 70, lElbow = -35, rElbow = -30 }),
	},
	Sniff = {
		pose({ spine = -32, neck = 24, neckYaw = -30, rShoulder = 26 }),
		pose({ spine = -30, neck = 28, neckYaw = 32, lShoulder = 20 }),
	},
	DoorBang = {
		pose({ rShoulder = 110, rElbow = -70, spine = -18 }),
		pose({ rShoulder = 90, rElbow = -4, spine = -40, bob = -0.1 }),
	},
	Lunge = {
		pose({ spine = -48, lShoulder = 115, rShoulder = 120, lElbow = -20, rElbow = -25 }),
		pose({ spine = -62, lShoulder = 140, rShoulder = 138, bob = -0.25 }),
	},
	Idle = {
		pose({}),
		pose({ spine = -27, neck = 22, neckRoll = 9, rElbow = -22, bob = -0.05 }),
	},
	Search = {
		pose({ spine = -18, neck = 8, neckYaw = 45, neckRoll = 6 }),
		pose({ spine = -18, neck = 10, neckYaw = 40, neckRoll = 12 }),
		pose({ spine = -20, neck = 8, neckYaw = -45, neckRoll = -6 }),
		pose({ spine = -20, neck = 12, neckYaw = -38, neckRoll = -14 }),
	},
	Walk = {
		pose({
			lHip = 24,
			lKnee = -8,
			rHip = -18,
			rKnee = -26,
			lShoulder = -16,
			rShoulder = 22,
			bob = -0.12,
			step = true,
		}),
		pose({ spine = -27, lHip = 2, lKnee = -4, rHip = 10, rKnee = -48, neckRoll = 6, bob = 0.05 }),
		pose({
			rHip = 24,
			rKnee = -8,
			lHip = -18,
			lKnee = -26,
			rShoulder = -16,
			lShoulder = 22,
			bob = -0.12,
			step = true,
		}),
		pose({ spine = -27, rHip = 2, rKnee = -4, lHip = 10, lKnee = -48, neckRoll = -6, bob = 0.05 }),
	},
	Chase = {
		pose({
			spine = -44,
			neck = 34,
			lHip = 38,
			lKnee = -10,
			rHip = -30,
			rKnee = -40,
			lShoulder = 70,
			rShoulder = 40,
			lElbow = -24,
			rElbow = -40,
			bob = -0.2,
			step = true,
		}),
		pose({
			spine = -48,
			neck = 38,
			neckRoll = 10,
			lHip = 6,
			rHip = 18,
			rKnee = -70,
			lShoulder = 84,
			rShoulder = 62,
			lElbow = -10,
			rElbow = -18,
			bob = 0.1,
		}),
		pose({
			spine = -44,
			neck = 34,
			rHip = 38,
			rKnee = -10,
			lHip = -30,
			lKnee = -40,
			rShoulder = 70,
			lShoulder = 40,
			rElbow = -24,
			lElbow = -40,
			bob = -0.2,
			step = true,
		}),
		pose({
			spine = -48,
			neck = 38,
			neckRoll = -10,
			rHip = 6,
			lHip = 18,
			lKnee = -70,
			rShoulder = 84,
			lShoulder = 62,
			rElbow = -10,
			lElbow = -18,
			bob = 0.1,
		}),
	},
	Capture = {
		pose({
			spine = -10,
			neck = 24,
			lShoulder = 120,
			lShoulderRoll = -34,
			rShoulder = 120,
			rShoulderRoll = 34,
			lElbow = -30,
			rElbow = -30,
		}),
		pose({
			spine = -14,
			neck = 30,
			neckRoll = 14,
			lShoulder = 128,
			lShoulderRoll = -40,
			rShoulder = 112,
			rShoulderRoll = 28,
			lElbow = -18,
			rElbow = -44,
			bob = 0.1,
		}),
	},
}

return table.freeze(Poses)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="362">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Corpo low poly do Vigia (só no cliente) + cinemática direta das poses.

	Silhueta: alto (~7,5 studs), magro, curvado, braços até os joelhos, casaco de vigia escuro,
	cabeça lisa cinzenta com dois olhos pálidos que brilham e uma fenda de boca.
	Peças ancoradas, sem colisão e invisíveis para raycasts (CanQuery = false).
]]

local Poses = require("./Poses")

local UniformDetails = table.clone(require("./UniformDetails"))
table.clear(UniformDetails)

export type Rig = {
	model: Model,
	parts: { [string]: BasePart },
	order: { BasePart },
	head: BasePart,
	emitter: Attachment,
	eyeLight: PointLight,
}

local rgb = Color3.fromRGB
local SKIN = rgb(137, 82, 39)
local COAT = rgb(105, 60, 29)
local PANTS = rgb(89, 50, 26)
local BOOT = rgb(14, 14, 14)
local EYE = rgb(255, 244, 214)

-- Nome -> tamanho, cor, material
local PARTS: { [string]: { size: Vector3, color: Color3, neon: boolean? } } = {
	Baton = { size = Vector3.new(0.45, 3.5, 0.45), color = rgb(76, 42, 20) },
	Pelvis = { size = Vector3.new(1.3, 0.7, 0.75), color = COAT },
	Torso = { size = Vector3.new(1.8, 2.5, 1.2), color = COAT },
	Skirt = { size = Vector3.new(1.2, 0.5, 0.8), color = COAT },
	Collar = { size = Vector3.new(1.3, 0.35, 0.95), color = rgb(48, 52, 60) },
	Neck = { size = Vector3.new(0.35, 0.55, 0.35), color = SKIN },
	Head = { size = Vector3.new(2.2, 1.5, 1.5), color = SKIN },
	EyeL = { size = Vector3.new(0.23, 0.23, 0.1), color = EYE, neon = true },
	EyeR = { size = Vector3.new(0.23, 0.23, 0.1), color = EYE, neon = true },
	Mouth = { size = Vector3.new(0.07, 0.42, 0.05), color = rgb(8, 8, 8) },
	UpperArmL = { size = Vector3.new(0.42, 1.8, 0.42), color = COAT },
	UpperArmR = { size = Vector3.new(0.42, 1.8, 0.42), color = COAT },
	ForearmL = { size = Vector3.new(0.3, 1.9, 0.3), color = SKIN },
	ForearmR = { size = Vector3.new(0.3, 1.9, 0.3), color = SKIN },
	HandL = { size = Vector3.new(0.34, 0.75, 0.16), color = SKIN },
	HandR = { size = Vector3.new(0.34, 0.75, 0.16), color = SKIN },
	ThighL = { size = Vector3.new(0.46, 1.9, 0.46), color = PANTS },
	ThighR = { size = Vector3.new(0.46, 1.9, 0.46), color = PANTS },
	ShinL = { size = Vector3.new(0.36, 1.9, 0.36), color = PANTS },
	ShinR = { size = Vector3.new(0.36, 1.9, 0.36), color = PANTS },
	FootL = { size = Vector3.new(0.46, 0.26, 0.95), color = BOOT },
	FootR = { size = Vector3.new(0.46, 0.26, 0.95), color = BOOT },
}

local HIP_HEIGHT = 3.9
local rad = math.rad

local Rig = {}

function Rig.build(parent: Instance): Rig
	local model = Instance.new("Model")
	model.Name = "VigiaVisual"
	local parts: { [string]: BasePart } = {}
	local order: { BasePart } = {}
	for name, spec in PARTS do
		local part = Instance.new("Part")
		part.Name = name
		part.Size = spec.size
		part.Color = spec.color
		part.Material = if spec.neon then Enum.Material.Neon else Enum.Material.Wood
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		parts[name] = part
		table.insert(order, part)
	end
	local head = parts.Head
	local emitter = Instance.new("Attachment")
	emitter.Name = "Emitter"
	emitter.Parent = head
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 214, 170)
	light.Range = 7
	light.Brightness = 0.9
	light.Shadows = false
	light.Parent = head
	local woodenHead = parts.Head :: Part
	woodenHead.Shape = Enum.PartType.Cylinder
	parts.Mouth.Size = Vector3.new(0.6, 0.55, 0.08)
	for _, detail in UniformDetails do
		local part = Instance.new("Part")
		part.Name = detail.name
		part.Size = detail.size
		part.Color = detail.color
		part.Material = if detail.metal then Enum.Material.Metal else Enum.Material.Fabric
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Parent = model
		parts[detail.name] = part
		table.insert(order, part)
	end
	model.Parent = parent
	return { model = model, parts = parts, order = order, head = head, emitter = emitter, eyeLight = light }
end

-- Calcula o CFrame de cada peça para `pose`, com a base (pé, no chão) em `base`.
-- `extraNeckYaw` permite virar a cabeça para o jogador (graus).
function Rig.solve(rig: Rig, base: CFrame, pose: Poses.Pose, extraNeckYaw: number): { CFrame }
	local cf: { [string]: CFrame } = {}
	local pelvis = base * CFrame.new(0, HIP_HEIGHT + pose.bob, 0)
	cf.Pelvis = pelvis
	cf.Skirt = pelvis * CFrame.new(0, -0.95, 0.05)

	local chest = pelvis * CFrame.Angles(rad(pose.spine), 0, rad(pose.spineRoll))
	cf.Torso = chest * CFrame.new(0, 1.3, 0)
	cf.Collar = chest * CFrame.new(0, 2.5, 0)

	local neck = chest
		* CFrame.new(0, 2.6, -0.1)
		* CFrame.Angles(rad(pose.neck), rad(pose.neckYaw + extraNeckYaw), rad(pose.neckRoll))
	cf.Neck = neck * CFrame.new(0, 0.2, 0)
	local head = neck * CFrame.new(0, 0.9, -0.12)
	cf.Head = head * CFrame.Angles(0, 0, math.rad(90))
	cf.EyeL = head * CFrame.new(-0.2, 0.12, -0.8)
	cf.EyeR = head * CFrame.new(0.2, 0.12, -0.8)
	cf.Mouth = head * CFrame.new(0, -0.27, -0.8)

	for _, side in { "L", "R" } do
		local sign = if side == "L" then -1 else 1
		local shoulderPitch = if side == "L" then pose.lShoulder else pose.rShoulder
		local shoulderRoll = if side == "L" then pose.lShoulderRoll else pose.rShoulderRoll
		local elbowPitch = if side == "L" then pose.lElbow else pose.rElbow
		local shoulder = chest
			* CFrame.new(sign * 0.98, 2.3, 0)
			* CFrame.Angles(rad(shoulderPitch), 0, rad(shoulderRoll))
		-- O braço pende para baixo: girar +pitch em X leva a mão para a frente (-Z).
		cf["UpperArm" .. side] = shoulder * CFrame.new(0, -0.9, 0)
		local elbow = shoulder * CFrame.new(0, -1.8, 0) * CFrame.Angles(rad(-elbowPitch), 0, 0)
		cf["Forearm" .. side] = elbow * CFrame.new(0, -0.95, 0)
		cf["Hand" .. side] = elbow * CFrame.new(0, -2.15, -0.05)

		local hipPitch = if side == "L" then pose.lHip else pose.rHip
		local kneePitch = if side == "L" then pose.lKnee else pose.rKnee
		local hip = pelvis * CFrame.new(sign * 0.42, -0.2, 0) * CFrame.Angles(rad(hipPitch), 0, 0)
		cf["Thigh" .. side] = hip * CFrame.new(0, -0.95, 0)
		local knee = hip * CFrame.new(0, -1.9, 0) * CFrame.Angles(rad(kneePitch), 0, 0)
		cf["Shin" .. side] = knee * CFrame.new(0, -0.95, 0)
		cf["Foot" .. side] = knee * CFrame.new(0, -1.9, -0.25) * CFrame.Angles(-rad(hipPitch + kneePitch) * 0.6, 0, 0)
	end

	for _, detail in UniformDetails do
		cf[detail.name] = cf[detail.anchor] * detail.offset
	end
	cf.Baton = cf.HandR * CFrame.new(0, -0.4, -1.1) * CFrame.Angles(math.rad(40), 0, 0)
	local list = table.create(#rig.order)
	for index, part in rig.order do
		list[index] = cf[part.Name] or base
	end
	return list
end

return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="363">
          <Properties>
            <string name="Name">TungTungClips</string>
            <string name="Source"><![CDATA[--!strict
-- GERADO por tools/tungtung/bake.js a partir das animações Mixamo do Tung Tung (não editar à mão).
-- Cada quadro guarda, por osso, o Bone.Transform (quaternion int16) e, para ossos com deslocamento,
-- a translação (int16, faixa ±16 studs). Ordem dos ossos: Bones.

export type Clip = { fps: number, frames: number, loop: boolean, posBones: { string }, data: string }

local TungTungClips = {}

TungTungClips.PosRange = 16
TungTungClips.Bones = {
	"mixamorig:Hips",
	"mixamorig:Spine",
	"mixamorig:Spine1",
	"mixamorig:Spine2",
	"mixamorig:Neck",
	"mixamorig:Head",
	"mixamorig:LeftShoulder",
	"mixamorig:LeftArm",
	"mixamorig:LeftForeArm",
	"mixamorig:LeftHand",
	"mixamorig:LeftHandIndex1",
	"mixamorig:LeftHandIndex2",
	"mixamorig:LeftHandIndex3",
	"mixamorig:RightShoulder",
	"mixamorig:RightArm",
	"mixamorig:RightForeArm",
	"mixamorig:RightHand",
	"mixamorig:RightHandIndex1",
	"mixamorig:RightHandIndex2",
	"mixamorig:RightHandIndex3",
	"mixamorig:LeftUpLeg",
	"mixamorig:LeftLeg",
	"mixamorig:LeftFoot",
	"mixamorig:LeftToeBase",
	"mixamorig:RightUpLeg",
	"mixamorig:RightLeg",
	"mixamorig:RightFoot",
	"mixamorig:RightToeBase",
}

