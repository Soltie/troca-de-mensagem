        <Item class="ModuleScript" referent="385">
          <Properties>
            <string name="Name">CharacterPose</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Matemática pura das poses procedurais dos jogadores (CharacterAnimatorController) e do olhar
	replicado (PresenceService). Ângulos em graus na rede; radianos só no cálculo das pernas.

	Rede: o cliente manda o pitch do olhar quantizado em passos de PITCH_STEP, no máximo a cada
	SEND_INTERVAL e só quando muda. O servidor revalida com quantizePitch antes de gravar o atributo.
]]

local CharacterPose = {}

CharacterPose.MAX_PITCH = 70
CharacterPose.PITCH_STEP = 2
CharacterPose.SEND_INTERVAL = 0.125
-- Mesmo sem mudança, reenvia de vez em quando (o atributo some quando o personagem renasce).
CharacterPose.HEARTBEAT = 3
-- Dobra máxima do agachamento (coxa à frente / canela para trás).
CharacterPose.MAX_CROUCH = math.rad(72)

-- Pitch do olhar em graus, limitado e arredondado para o passo da rede.
function CharacterPose.quantizePitch(degrees: number): number
	if degrees ~= degrees then
		return 0
	end
	local limited = math.clamp(degrees, -CharacterPose.MAX_PITCH, CharacterPose.MAX_PITCH)
	local step = CharacterPose.PITCH_STEP
	local q = math.floor(limited / step + 0.5) * step
	return math.clamp(q, -CharacterPose.MAX_PITCH, CharacterPose.MAX_PITCH)
end

-- Manda o pitch agora? `last` = último enviado (nil = nunca), `since` = segundos desde o envio.
function CharacterPose.shouldSend(last: number?, current: number, since: number): boolean
	if since < CharacterPose.SEND_INTERVAL then
		return false
	end
	if last == nil then
		return true
	end
	return last ~= current or since >= CharacterPose.HEARTBEAT
end

--[[
	Agachamento com o pé embaixo do quadril: a coxa gira +a, a canela -2a, o pé +a (fica plano).
	As pernas encurtam legLength * (1 - cos a). Retorna (a em radianos, lift): lift é quanto o corpo
	visível precisa subir quando nem a dobra máxima compensa a queda física (`drop`) do HipHeight.
]]
function CharacterPose.crouch(legLength: number, drop: number, maxAngle: number?): (number, number)
	if legLength <= 0 or drop <= 0 then
		return 0, 0
	end
	local limit = maxAngle or CharacterPose.MAX_CROUCH
	local ratio = math.clamp(1 - drop / legLength, -1, 1)
	local angle = math.min(math.acos(ratio), limit)
	local shortened = legLength * (1 - math.cos(angle))
	return angle, math.max(0, drop - shortened)
end

-- Inclinação do tronco (graus) pela velocidade: nada andando, até `max` correndo.
function CharacterPose.lean(speed: number, walkSpeed: number, sprintSpeed: number, max: number?): number
	if sprintSpeed <= walkSpeed then
		return 0
	end
	local t = math.clamp((speed - walkSpeed) / (sprintSpeed - walkSpeed), 0, 1)
	return t * (max or 12)
end

-- Divide o pitch entre pescoço e cintura (o tronco acompanha um pouco).
function CharacterPose.split(pitch: number): (number, number)
	return pitch * 0.65, pitch * 0.35
end

-- Aproxima `current` de `target` com taxa exponencial (rate por segundo).
function CharacterPose.approach(current: number, target: number, rate: number, dt: number): number
	local k = 1 - math.exp(-rate * math.max(dt, 0))
	return current + (target - current) * k
end

return table.freeze(CharacterPose)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="386">
          <Properties>
            <string name="Name">CinematicShots</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Câmeras da casa e matemática pura. Varanda z=64; portão da floresta z=98.
	Abertura/lobby/fuga usam o exterior; StoryCatalog enquadra os interiores fixos.
	Sem game/task/CFrame: CinematicController converte os vetores em câmera.
]]

export type Vec = { x: number, y: number, z: number }
export type Ease = "linear" | "inOut" | "out" | "in"
-- Como se entra NESTE plano: estática de fita, piscar de olhos ou corte seco.
export type Cut = "static" | "blink" | "hard"

export type Shot = {
	-- Carimbo da câmera ("CÂMERA 2 · PÁTIO").
	label: string,
	from: Vec,
	to: Vec,
	lookFrom: Vec,
	lookTo: Vec,
	duration: number,
	fov: number,
	ease: Ease,
	-- Tremor de câmera na mão (0..1); 0 = câmera de segurança fixa.
	handheld: number,
	cut: Cut,
	-- Planos lisos podem ser estáveis; ausência de tremor não significa CFTV.
	style: "film" | "cctv"?,
	fovTo: number?,
}

export type Sequence = {
	name: string,
	shots: { Shot },
	-- Cartela do primeiro plano e legendas distribuídas pela duração (opcionais).
	title: string?,
	subtitle: string?,
	captions: { string }?,
}

local function v(x: number, y: number, z: number): Vec
	return table.freeze({ x = x, y = y, z = z })
end

local function shot(values: Shot): Shot
	assert(values.duration > 0, "[CinematicShots] duration must be positive")
	assert(values.fov >= 20 and values.fov <= 90, "[CinematicShots] fov out of range")
	return table.freeze(values)
end

local CinematicShots = {}

-- Câmeras da casa: varanda em z=64, portão em z=98; todas as trajetórias externas.
CinematicShots.Opening = table.freeze({
	name = "Opening",
	title = "A CASA AMALDIÇOADA",
	subtitle = "03:12 / A FITA NÃO TERMINOU",
	captions = table.freeze({
		"Uma televisão acesa. Uma casa vazia há trinta anos.",
		"Na fita, alguém deixou a porta aberta para vocês.",
		"Se ouvirem três pancadas, não respondam.",
	}),
	shots = table.freeze({
		shot({
			label = "FLORESTA / 03:12",
			style = "film",
			from = v(8, 7, 123),
			to = v(6, 6, 113),
			lookFrom = v(0, 9, 64),
			lookTo = v(0, 8, 64),
			duration = 3.2,
			fov = 54,
			ease = "inOut",
			handheld = 0,
			cut = "static",
		}),
		shot({
			label = "A CASA / FITA ENCONTRADA",
			from = v(-30, 11, 85),
			to = v(-22, 10, 81),
			lookFrom = v(0, 12, 64),
			lookTo = v(0, 10, 64),
			duration = 3,
			fov = 52,
			ease = "inOut",
			handheld = 0.12,
			cut = "hard",
		}),
		shot({
			label = "TRÊS PANCADAS",
			from = v(7, 5, 80),
			to = v(4, 5, 74),
			lookFrom = v(3, 5, 65),
			lookTo = v(3, 5, 65),
			duration = 2.8,
			fov = 48,
			ease = "inOut",
			handheld = 0.2,
			cut = "hard",
		}),
	}),
}) :: Sequence
CinematicShots.Stage = table.freeze({
	name = "Stage",
	shots = table.freeze({
		shot({
			label = "VARANDA / RETORNO",
			from = v(-16, 7, 82),
			to = v(-12, 6, 78),
			lookFrom = v(0, 5, 64),
			lookTo = v(0, 5, 64),
			duration = 1.8,
			fov = 54,
			ease = "inOut",
			handheld = 0,
			cut = "hard",
		}),
		shot({
			label = "O MESMO ENDEREÇO",
			from = v(6, 5, 77),
			to = v(4, 5, 74),
			lookFrom = v(0, 5, 65),
			lookTo = v(0, 5, 65),
			duration = 1.7,
			fov = 52,
			ease = "inOut",
			handheld = 0.12,
			cut = "hard",
		}),
	}),
}) :: Sequence
CinematicShots.Escape = table.freeze({
	name = "Escape",
	title = "A ÚLTIMA FITA",
	subtitle = "FORA DA CASA",
	captions = table.freeze({
		"O coração parou. As paredes perderam a voz.",
		"Na televisão, a fita continua. Agora ela mostra a floresta.",
	}),
	shots = table.freeze({
		shot({
			label = "FLORESTA / FIM DA FITA",
			from = v(8, 6, 112),
			to = v(12, 8, 130),
			lookFrom = v(0, 8, 66),
			lookTo = v(0, 10, 64),
			duration = 6,
			fov = 56,
			ease = "inOut",
			handheld = 0.1,
			cut = "hard",
		}),
	}),
}) :: Sequence
CinematicShots.Attract = table.freeze({
	name = "Attract",
	shots = table.freeze({
		shot({
			label = "CANAL 03 / A CASA",
			from = v(-24, 12, 89),
			to = v(-24, 12, 89),
			lookFrom = v(0, 14, 64),
			lookTo = v(0, 10, 64),
			duration = 5,
			fov = 58,
			ease = "inOut",
			handheld = 0,
			cut = "static",
		}),
		shot({
			label = "CANAL 03 / VARANDA",
			from = v(12, 7, 82),
			to = v(12, 7, 82),
			lookFrom = v(3, 5, 66),
			lookTo = v(0, 5, 66),
			duration = 5,
			fov = 50,
			ease = "inOut",
			handheld = 0,
			cut = "static",
		}),
		shot({
			label = "CANAL 03 / PORTÃO",
			from = v(-18, 9, 119),
			to = v(-18, 9, 119),
			lookFrom = v(0, 6, 98),
			lookTo = v(0, 9, 64),
			duration = 5,
			fov = 60,
			ease = "inOut",
			handheld = 0,
			cut = "static",
		}),
		shot({
			label = "CANAL 03 / JANELAS",
			from = v(-35, 9, 83),
			to = v(-35, 9, 83),
			lookFrom = v(-10, 16, 64),
			lookTo = v(3, 5, 66),
			duration = 5,
			fov = 55,
			ease = "inOut",
			handheld = 0,
			cut = "static",
		}),
	}),
}) :: Sequence

-- Câmera de segurança: fixa e sem tremor (o controller dá cor de CFTV e 12 quadros/s).
function CinematicShots.isCctv(s: Shot): boolean
	return if s.style then s.style == "cctv" else s.handheld <= 0
end

function CinematicShots.lens(s: Shot, alpha: number): number
	return s.fov + ((s.fovTo or s.fov) - s.fov) * CinematicShots.ease(s.ease, alpha)
end

-- Progresso preso na grade de quadros do CFTV (fps), para a imagem andar "aos saltos".
function CinematicShots.quantize(alpha: number, duration: number, fps: number): number
	local frames = math.max(1, math.floor(duration * fps))
	return math.clamp(math.floor(math.clamp(alpha, 0, 1) * frames) / frames, 0, 1)
end

-- Tempo dentro da volta de uma sequência em laço.
function CinematicShots.wrap(sequence: Sequence, elapsed: number): number
	local total = 0
	for _, s in sequence.shots do
		total += s.duration
	end
	if total <= 0 then
		return 0
	end
	return math.max(0, elapsed) % total
end

-- Legenda da vez: as linhas se dividem igualmente pela duração (nil sem legendas).
function CinematicShots.caption(lines: { string }?, elapsed: number, total: number): string?
	if not lines or #lines == 0 or total <= 0 then
		return nil
	end
	local index = math.floor(math.clamp(elapsed / total, 0, 0.9999) * #lines) + 1
	return lines[index]
end

-- Curvas de suavização (t fora de 0..1 é limitado).
function CinematicShots.ease(kind: Ease, t: number): number
	local x = math.clamp(t, 0, 1)
	if kind == "inOut" then
		return x * x * (3 - 2 * x)
	elseif kind == "out" then
		return 1 - (1 - x) * (1 - x)
	elseif kind == "in" then
		return x * x
	end
	return x
end

function CinematicShots.lerp(a: Vec, b: Vec, t: number): Vec
	return { x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t, z = a.z + (b.z - a.z) * t }
end

function CinematicShots.duration(sequence: Sequence): number
	local total = 0
	for _, s in sequence.shots do
		total += s.duration
	end
	return total
end

-- Qual plano está no ar em `elapsed` segundos: (índice, progresso 0..1 dentro dele, terminou?).
function CinematicShots.locate(sequence: Sequence, elapsed: number): (number, number, boolean)
	local shots = sequence.shots
	local start = 0
	for index, s in shots do
		if elapsed < start + s.duration then
			return index, math.max(0, elapsed - start) / s.duration, false
		end
		start += s.duration
	end
	return #shots, 1, true
end

-- Posição da câmera e ponto observado no progresso `alpha` (0..1) do plano.
function CinematicShots.sample(s: Shot, alpha: number): (Vec, Vec)
	local t = CinematicShots.ease(s.ease, alpha)
	return CinematicShots.lerp(s.from, s.to, t), CinematicShots.lerp(s.lookFrom, s.lookTo, t)
end

-- Relógio da fita (HH:MM:SS) a partir de segundos desde a meia-noite.
function CinematicShots.clock(seconds: number): string
	local total = math.max(0, math.floor(seconds)) % 86400
	return string.format("%02d:%02d:%02d", total // 3600, (total // 60) % 60, total % 60)
end

-- A fita começa às 03:12 (a queda de energia da história).
CinematicShots.TAPE_START = 3 * 3600 + 12 * 60

-- O final tem três planos próprios. Abertura e laço do menu usam as definições autorais acima.
CinematicShots.Escape = {
	name = "Escape",
	title = "A ÚLTIMA NOITE",
	subtitle = "THE CURSED HOUSE",
	shots = {
		shot({
			label = "A CASA DESTRUÍDA",
			style = "film",
			fovTo = 60,
			from = v(-65, 65, 120),
			to = v(-55, 60, 112),
			lookFrom = v(0, 16, -10),
			lookTo = v(0, 12, -10),
			duration = 4,
			fov = 64,
			ease = "inOut",
			handheld = 0,
			cut = "blink",
		}),
		shot({
			label = "VOCÊS QUEIMARAM MINHA CASA...",
			style = "film",
			fovTo = 54,
			from = v(12, 10, 90),
			to = v(9, 9, 85),
			lookFrom = v(0, 6, 58),
			lookTo = v(0, 6, 58),
			duration = 4,
			fov = 58,
			ease = "inOut",
			handheld = 0,
			cut = "hard",
		}),
		shot({
			label = "MAS NÃO ACABARAM COMIGO.",
			style = "film",
			fovTo = 46,
			from = v(3, 7, 75),
			to = v(2, 6.5, 73),
			lookFrom = v(0, 5, 58),
			lookTo = v(0, 5, 58),
			duration = 4,
			fov = 50,
			ease = "inOut",
			handheld = 0,
			cut = "hard",
		}),
	},
}
CinematicShots.Escape.captions = {
	"As chamas engoliram a casa. Vocês alcançaram a floresta.",
	"VOCÊS QUEIMARAM MINHA CASA...",
	"MAS NÃO ACABARAM COMIGO.",
}
return table.freeze(CinematicShots)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="387">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras da economia e da progressão (testadas no Lune). Operam sobre os dados do
	jogador (Types.PlayerData). Só o SERVIDOR chama as funções que alteram dados; o cliente usa
	as de leitura (nível, chances, estado do diário) para exibir.

	Sorteios recebem `random: () -> number` (0 <= x < 1) injetado: testável e auditável.
]]

local Perks = require("./Perks")
local StoreCatalog = require("./StoreCatalog")
local Types = require("../Types")

type Data = Types.PlayerData
type Reward = StoreCatalog.Reward
type Item = StoreCatalog.Item
type Chest = StoreCatalog.Chest

export type Granted = {
	fichas: number,
	creditos: number,
	xp: number,
	items: { string },
	-- Itens repetidos convertidos em Fichas (id -> fichas).
	refunds: { [string]: number },
	-- Níveis alcançados nesta concessão.
	levels: { number },
	-- Consumíveis que entraram no estoque (id -> unidades).
	consumables: { [string]: number }?,
}

export type OddsLine = {
	rarity: StoreCatalog.Rarity,
	percent: number,
	items: { string },
	perItem: number,
}

export type RunSummary = {
	won: boolean,
	escaped: boolean,
	stages: number,
	fuses: number,
	breakers: boolean,
	contributions: number,
}

local SECONDS_PER_DAY = 86400

local Economy = {}

local function emptyGranted(): Granted
	return { fichas = 0, creditos = 0, xp = 0, items = {}, refunds = {}, levels = {} }
end

-- ===================== Leitura =====================

function Economy.xpToNext(level: number): number
	return StoreCatalog.LevelBase + StoreCatalog.LevelStep * (level - 1)
end

-- Nível atual, XP dentro do nível e XP necessário para o próximo.
function Economy.levelInfo(xp: number): (number, number, number)
	local level = 1
	local remaining = math.max(0, xp)
	while level < StoreCatalog.LevelCap and remaining >= Economy.xpToNext(level) do
		remaining -= Economy.xpToNext(level)
		level += 1
	end
	return level, remaining, Economy.xpToNext(level)
end

function Economy.isOwned(data: Data, itemId: string, vip: boolean?): boolean
	local entry = StoreCatalog.ItemById[itemId]
	if not entry then
		return false
	end
	if entry.source == "default" then
		return true
	end
	if entry.source == "vip" then
		return vip == true
	end
	return data.owned[itemId] == true
end

function Economy.price(entry: Item, currency: StoreCatalog.Currency): number?
	if currency == "fichas" then
		return entry.fichas
	end
	return entry.creditos
end

-- Itens que um baú pode dar, por raridade (só itens de loja: sem padrão/VIP/nível/fitas).
function Economy.chestPool(chest: Chest): { [string]: { string } }
	local pool: { [string]: { string } } = {}
	for _, entry in StoreCatalog.Items do
		if entry.source == "store" and entry.kind ~= "title" and chest.odds[entry.rarity] ~= nil then
			local list = pool[entry.rarity] or {}
			table.insert(list, entry.id)
			pool[entry.rarity] = list
		end
	end
	return pool
end

-- Chances exibidas antes da compra: por raridade e por item (somam 100%).
function Economy.chestOdds(chest: Chest): { OddsLine }
	local pool = Economy.chestPool(chest)
	local lines: { OddsLine } = {}
	for rarity, percent in chest.odds do
		local items = pool[rarity] or {}
		table.sort(items)
		table.insert(lines, {
			rarity = rarity :: StoreCatalog.Rarity,
			percent = percent,
			items = items,
			perItem = if #items > 0 then percent / #items else 0,
		})
	end
	table.sort(lines, function(a, b)
		return StoreCatalog.Rarities[a.rarity].order < StoreCatalog.Rarities[b.rarity].order
	end)
	return lines
end

function Economy.dayIndex(serverTime: number): number
	return math.floor(serverTime / SECONDS_PER_DAY)
end

-- Estado do calendário diário para o dia `day` (pode resgatar? qual dia da sequência?).
function Economy.dailyState(data: Data, day: number): (boolean, number, Reward)
	local daily = data.daily
	local claimable = daily.lastDay ~= day
	local streakDay: number
	if not claimable then
		streakDay = daily.streak
	elseif daily.lastDay == day - 1 then
		streakDay = daily.streak % #StoreCatalog.Daily + 1
	else
		streakDay = 1
	end
	return claimable, math.max(1, streakDay), StoreCatalog.Daily[math.max(1, streakDay)]
end

function Economy.spinsLeft(data: Data, day: number, vip: boolean?): number
	local total = 1 + (if vip then 1 else 0)
	if data.daily.spinDay ~= day then
		return total
	end
	return math.max(0, total - data.daily.spinsUsed)
end

function Economy.multiplier(vip: boolean?): number
	return if vip then StoreCatalog.VipMultiplier else 1
end

-- Recompensa de uma partida (antes de aplicar). VIP multiplica Fichas e XP.
function Economy.runReward(summary: RunSummary, vip: boolean?): Reward
	local R = StoreCatalog.RunRewards
	local fichas = R.participation.fichas + R.perStage.fichas * summary.stages + R.perFuse.fichas * summary.fuses
	local xp = R.participation.xp + R.perStage.xp * summary.stages + R.perFuse.xp * summary.fuses
	if summary.breakers then
		fichas += R.breakers.fichas
		xp += R.breakers.xp
	end
	if summary.won or summary.escaped then
		fichas += R.escaped.fichas
		xp += R.escaped.xp
	end
	local contributions = math.clamp(summary.contributions, 0, R.contributionCap)
	fichas += R.perContribution.fichas * contributions
	xp += R.perContribution.xp * contributions
	local m = Economy.multiplier(vip)
	return { fichas = math.floor(fichas * m + 0.5), xp = math.floor(xp * m + 0.5) }
end

-- ===================== Escrita (só servidor) =====================

local function grantItem(data: Data, itemId: string, granted: Granted)
	local entry = StoreCatalog.ItemById[itemId]
	if not entry then
		return
	end
	if entry.source ~= "default" and entry.source ~= "vip" and not data.owned[itemId] then
		data.owned[itemId] = true
		table.insert(granted.items, itemId)
		return
	end
	-- Repetido: vira Fichas conforme a raridade.
	local refund = StoreCatalog.Rarities[entry.rarity].refund
	if refund > 0 then
		data.wallet.fichas += refund
		granted.fichas += refund
		granted.refunds[itemId] = refund
	end
end

local function addXp(data: Data, amount: number, granted: Granted)
	if amount <= 0 then
		return
	end
	data.xp += amount
	granted.xp += amount
	local level = Economy.levelInfo(data.xp)
	while data.rewardedLevel < level do
		data.rewardedLevel += 1
		local reached = data.rewardedLevel
		table.insert(granted.levels, reached)
		local fichas = StoreCatalog.LevelFichasBase + StoreCatalog.LevelFichasStep * reached
		data.wallet.fichas += fichas
		granted.fichas += fichas
		local milestone = StoreCatalog.LevelMilestones[reached]
		if milestone then
			if milestone.fichas then
				data.wallet.fichas += milestone.fichas
				granted.fichas += milestone.fichas
			end
			if milestone.creditos then
				data.wallet.creditos += milestone.creditos
				granted.creditos += milestone.creditos
			end
			if milestone.item then
				grantItem(data, milestone.item, granted)
			end
		end
	end
end

-- Aplica uma recompensa (moedas, XP com níveis e marcos, item). Retorna o que foi dado.
function Economy.applyReward(data: Data, reward: Reward, into: Granted?): Granted
	local granted = into or emptyGranted()
	if reward.fichas and reward.fichas > 0 then
		data.wallet.fichas += reward.fichas
		granted.fichas += reward.fichas
	end
	if reward.creditos and reward.creditos > 0 then
		data.wallet.creditos += reward.creditos
		granted.creditos += reward.creditos
	end
	if reward.item then
		grantItem(data, reward.item, granted)
	end
	if reward.xp then
		addXp(data, reward.xp, granted)
	end
	if reward.consumables then
		for id, amount in reward.consumables do
			local added = Perks.add(data, id, amount)
			if added > 0 then
				local list = granted.consumables or {}
				list[id] = (list[id] or 0) + added
				granted.consumables = list
			end
		end
	end
	return granted
end

function Economy.buyItem(data: Data, itemId: string, currency: StoreCatalog.Currency, vip: boolean?): (boolean, string?)
	local entry = StoreCatalog.ItemById[itemId]
	if not entry or entry.source ~= "store" then
		return false, "store_unknown"
	end
	if Economy.isOwned(data, itemId, vip) then
		return false, "store_owned"
	end
	local price = Economy.price(entry, currency)
	if not price then
		return false, "store_no_price"
	end
	if data.wallet[currency] < price then
		return false, "store_poor"
	end
	data.wallet[currency] -= price
	data.owned[itemId] = true
	return true, nil
end

-- Sorteio ponderado: `entries` com campo `weight`; devolve o índice.
function Economy.pickWeighted(weights: { number }, random: () -> number): number
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll = random() * total
	for index, weight in weights do
		roll -= weight
		if roll < 0 then
			return index
		end
	end
	return #weights
end

export type ChestResult = { item: string, rarity: StoreCatalog.Rarity, duplicate: boolean, refund: number }

--[[
	Abre um baú: cobra, sorteia a raridade pelas chances publicadas e um item da raridade
	(uniforme). Repetido vira Fichas. `restricted` = PolicyService proíbe itens aleatórios pagos
	para este jogador (só bloqueia baús pagos).
]]
function Economy.openChest(
	data: Data,
	chestId: string,
	random: () -> number,
	restricted: boolean?
): (boolean, string?, ChestResult?)
	local chest = StoreCatalog.ChestById[chestId]
	if not chest then
		return false, "store_unknown", nil
	end
	if chest.paidRandom and restricted then
		return false, "store_restricted", nil
	end
	if data.wallet[chest.currency] < chest.price then
		return false, "store_poor", nil
	end
	local lines = Economy.chestOdds(chest)
	local weights = {}
	for _, line in lines do
		table.insert(weights, if #line.items > 0 then line.percent else 0)
	end
	local line = lines[Economy.pickWeighted(weights, random)]
	local itemId = line.items[math.clamp(math.floor(random() * #line.items) + 1, 1, #line.items)]
	data.wallet[chest.currency] -= chest.price
	data.stats.chests += 1
	local granted = emptyGranted()
	grantItem(data, itemId, granted)
	local refund = granted.refunds[itemId] or 0
	return true, nil, { item = itemId, rarity = line.rarity, duplicate = refund > 0, refund = refund }
end

function Economy.claimDaily(data: Data, day: number): (boolean, string?, number?, Granted?)
	local claimable, streakDay, reward = Economy.dailyState(data, day)
	if not claimable then
		return false, "daily_claimed", nil, nil
	end
	data.daily.lastDay = day
	data.daily.streak = streakDay
	return true, nil, streakDay, Economy.applyReward(data, reward)
end

function Economy.spin(
	data: Data,
	day: number,
	vip: boolean?,
	random: () -> number
): (boolean, string?, StoreCatalog.SpinSegment?, Granted?)
	if Economy.spinsLeft(data, day, vip) <= 0 then
		return false, "spin_used", nil, nil
	end
	if data.daily.spinDay ~= day then
		data.daily.spinDay = day
		data.daily.spinsUsed = 0
	end
	data.daily.spinsUsed += 1
	local weights = {}
	for _, segment in StoreCatalog.Spin do
		table.insert(weights, segment.weight)
	end
	local segment = StoreCatalog.Spin[Economy.pickWeighted(weights, random)]
	return true, nil, segment, Economy.applyReward(data, segment.reward)
end

-- Fim de partida: estatísticas, recompensa e título da primeira fuga.
-- `now` (os.time) liga os bônus de tempo comprados (Fichas/XP ×2; ver Perks).
function Economy.recordRun(data: Data, summary: RunSummary, vip: boolean?, now: number?): Granted
	data.stats.runs += 1
	data.stats.stages += summary.stages
	if summary.won or summary.escaped then
		data.stats.escapes += 1
	else
		data.stats.captures += 1
	end
	local reward = Economy.runReward(summary, vip)
	if now then
		local fichasMult, xpMult = Perks.runMultipliers(data, now)
		reward.fichas = math.floor((reward.fichas or 0) * fichasMult + 0.5)
		reward.xp = math.floor((reward.xp or 0) * xpMult + 0.5)
	end
	local granted = Economy.applyReward(data, reward)
	if (summary.won or summary.escaped) and not data.owned[StoreCatalog.FirstEscapeItem] then
		grantItem(data, StoreCatalog.FirstEscapeItem, granted)
	end
	return granted
end

-- Fita colecionável. Retorna (nova?, concedido). Repetida não dá nada.
function Economy.addTape(data: Data, tapeId: string, now: number, vip: boolean?): (boolean, Granted?)
	if not StoreCatalog.TapeById[tapeId] or data.tapes[tapeId] then
		return false, nil
	end
	data.tapes[tapeId] = now
	local R = StoreCatalog.RunRewards.tape
	local m = Economy.multiplier(vip)
	local granted = Economy.applyReward(data, {
		fichas = math.floor(R.fichas * m + 0.5),
		xp = math.floor(R.xp * m + 0.5),
	})
	local count = 0
	for _ in data.tapes do
		count += 1
	end
	local milestone = StoreCatalog.TapeMilestones[count]
	if milestone then
		Economy.applyReward(data, milestone, granted)
	end
	return true, granted
end

function Economy.tapeCount(data: Data): number
	local count = 0
	for _ in data.tapes do
		count += 1
	end
	return count
end

function Economy.equip(data: Data, itemId: string, vip: boolean?): (boolean, string?)
	local entry = StoreCatalog.ItemById[itemId]
	if not entry then
		return false, "store_unknown"
	end
	if not Economy.isOwned(data, itemId, vip) then
		return false, "store_locked"
	end
	data.equipped[entry.kind] = itemId
	return true, nil
end

-- Item equipado válido (volta ao padrão se o jogador perdeu o acesso, ex.: VIP).
function Economy.equipped(data: Data, kind: StoreCatalog.ItemKind, vip: boolean?): string
	local current = data.equipped[kind]
	if current and Economy.isOwned(data, current, vip) then
		local entry = StoreCatalog.ItemById[current]
		if entry and entry.kind == kind then
			return current
		end
	end
	return StoreCatalog.defaultFor(kind)
end

--[[
	Compra com Robux já confirmada pela Roblox (ProcessReceipt). Idempotente pelo `purchaseId`:
	repetir o mesmo recibo não concede de novo. `once` = no máximo uma por conta.
]]
function Economy.grantProduct(
	data: Data,
	product: StoreCatalog.Product,
	purchaseId: string,
	now: number
): (boolean, string?, Granted?)
	if data.purchases[purchaseId] then
		return false, "already_granted", nil
	end
	data.purchases[purchaseId] = now
	if product.once and data.oncePurchases[product.key] then
		-- Já tinha o pacote: devolve em Créditos (nunca cobra por nada).
		return true, "once_converted", Economy.applyReward(data, { creditos = product.grant.creditos or 0 })
	end
	if product.once then
		data.oncePurchases[product.key] = now
	end
	local granted = Economy.applyReward(data, product.grant)
	local boost = product.grant.boost
	if boost then
		Perks.addBoost(data, "fichas", boost.fichas or 0, now)
		Perks.addBoost(data, "xp", boost.xp or 0, now)
	end
	if product.key == "pacote_inicial" then
		for _, itemId in StoreCatalog.StarterItems do
			grantItem(data, itemId, granted)
		end
	end
	Economy.trimPurchases(data, 200)
	return true, nil, granted
end

-- Mantém só os `max` recibos mais recentes (os antigos já foram concedidos há muito).
function Economy.trimPurchases(data: Data, max: number)
	local ids = {}
	for id, at in data.purchases do
		table.insert(ids, { id = id, at = at })
	end
	if #ids <= max then
		return
	end
	table.sort(ids, function(a, b)
		return a.at > b.at
	end)
	for i = max + 1, #ids do
		data.purchases[ids[i].id] = nil
	end
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="388">
          <Properties>
            <string name="Name">FearModel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Medo do jogador (0..1). Puro (testado no Lune); o FearController alimenta e lê.
	Não há barra na tela: o valor só dirige efeitos (batimento, respiração, vinheta, FOV,
	tremor, distorção, abafamento, sussurros e alucinações).

	- `target(inputs)`: quanto medo a situação do momento "pede" (proximidade do Vigia,
	  perseguição, escuridão, esconderijo com ele perto). Lugar seguro limita o alvo.
	- `step`: o valor base sobe rápido e desce devagar até o alvo (suavização assimétrica);
	  sustos (`spike`) somam por cima e decaem sozinhos.
	- Níveis 0..3 com histerese: sobe ao passar de `enter`, só desce abaixo de `exit`.
]]

local Config = require("../Config")

export type Inputs = {
	-- math.huge quando o Vigia está inativo.
	creatureDistance: number,
	-- Há linha de visão entre a câmera e o Vigia.
	creatureVisible: boolean,
	chasing: boolean,
	-- 0 = bem iluminado .. 1 = breu (lanterna apagada, sem luz por perto).
	darkness: number,
	hidden: boolean,
	-- Aceso e longe da ameaça.
	safe: boolean,
}

export type State = {
	value: number,
	base: number,
	spike: number,
	level: number,
}

local F = Config.Fear

local FearModel = {}

FearModel.MAX_LEVEL = #F.Levels

function FearModel.new(): State
	return { value = 0, base = 0, spike = 0, level = 0 }
end

function FearModel.target(inputs: Inputs): number
	local target = 0
	if inputs.creatureDistance < F.ProximityRange then
		local near = 1 - inputs.creatureDistance / F.ProximityRange
		target += near ^ 1.5 * F.ProximityWeight
	end
	if inputs.creatureVisible then
		target += F.VisibleWeight
	end
	if inputs.chasing then
		target = math.max(target, F.ChaseFloor)
	end
	target += math.clamp(inputs.darkness, 0, 1) * F.DarkWeight
	if inputs.hidden and inputs.creatureDistance < F.HiddenNearRange then
		target += F.HiddenNearWeight
	end
	if inputs.safe then
		target = math.min(target, F.SafeCeiling)
	end
	return math.clamp(target, 0, 1)
end

-- Susto pontual (detecção, barulho alto, alucinação). Soma por cima do valor base.
function FearModel.spike(state: State, amount: number)
	state.spike = math.clamp(state.spike + amount, 0, F.SpikeMax)
	state.value = math.clamp(state.base + state.spike, 0, 1)
end

-- Nível 0..3 a partir do valor, respeitando a histerese a partir do nível atual.
function FearModel.levelFor(value: number, current: number): number
	local level = current
	while level < #F.Levels and value >= F.Levels[level + 1].enter do
		level += 1
	end
	while level > 0 and value < F.Levels[level].exit do
		level -= 1
	end
	return level
end

-- Avança `dt` segundos. Retorna true se o nível mudou.
function FearModel.step(state: State, inputs: Inputs, dt: number): boolean
	local target = FearModel.target(inputs)
	local rate = if target > state.base then F.RiseRate else F.DecayRate
	state.base += (target - state.base) * (1 - math.exp(-rate * math.max(dt, 0)))
	state.spike = math.max(0, state.spike - F.SpikeDecay * dt)
	state.value = math.clamp(state.base + state.spike, 0, 1)
	local level = FearModel.levelFor(state.value, state.level)
	local changed = level ~= state.level
	state.level = level
	return changed
end

-- Volta ao zero (nova rodada / checkpoint).
function FearModel.reset(state: State)
	state.value = 0
	state.base = 0
	state.spike = 0
	state.level = 0
end

return FearModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="389">
          <Properties>
            <string name="Name">ForestCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- Continuação da casa: pistas legíveis, mecanismos ruidosos e fuga real no servidor.
local TableUtil = require("../Util/TableUtil")
export type Room = { id: string, title: string, x: number, y: number, z: number }
export type Objective = { room: string, title: string, kind: string, item: string?, event: string?, revelation: string }
export type Chapter = { title: string, subtitle: string, objectives: { Objective } }
local Forest = {
	FirstChapter = 6,
	LastChapter = 8,
	Spawn = { x = 0, y = 0, z = 580 },
	Exit = { x = 0, y = 0, z = 870 },
	Rooms = {
