        <Item class="ModuleScript" referent="391">
          <Properties>
            <string name="Name">ForestThreat</string>
            <string name="Source"><![CDATA[--!strict
-- Pressão exclusiva da floresta: difícil, mas sem rastrear jogadores ocultos através de paredes.
local Threat = {}
function Threat.speed(chapter: number, mode: string, base: number): number
	if chapter < 6 or chapter > 8 then
		return base
	end
	local bonus = if mode == "Patrol" then 1.9 elseif mode == "Investigate" then 1.3 elseif mode == "Chase" then 1 else 0
	return base + bonus + (if base > 0 then (chapter - 6) * 0.35 else 0)
end
function Threat.interval(chapter: number): number
	return math.max(12, 24 - (chapter - 6) * 4)
end
function Threat.dark(now: number, chapter: number): boolean
	return chapter >= 6 and chapter <= 8 and now % Threat.interval(chapter) < 6
end
return table.freeze(Threat)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="392">
          <Properties>
            <string name="Name">GameModes</string>
            <string name="Source"><![CDATA[--!strict
-- Votação pura do servidor: um voto por integrante, maioria absoluta e equipe mínima.
local Modes = {}
export type Id = "Standard" | "Story"
export type Votes = { [number]: Id }

function Modes.winner(votes: Votes, members: { [number]: any }, minimum: number): (Id?, number, number)
	local count, standard, story = 0, 0, 0
	for id in members do
		count += 1
		if votes[id] == "Standard" then
			standard += 1
		elseif votes[id] == "Story" then
			story += 1
		end
	end
	if count >= minimum then
		if story > count / 2 then
			return "Story", standard, story
		elseif standard > count / 2 then
			return "Standard", standard, story
		end
	end
	return nil, standard, story
end

return table.freeze(Modes)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="393">
          <Properties>
            <string name="Name">GameState</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Estado da rodada, replicado do servidor para o cliente por ATRIBUTOS em
	ReplicatedStorage.GameState (Configuration criada pelo servidor em runtime).

	- Servidor: GameState.serverCreate() uma vez; depois GameState.set(nome, valor).
	- Cliente: GameState.wait() e GameState.observe(callback) recebe um Snapshot a cada mudança.

	O servidor é a única fonte da verdade: o cliente só lê.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Phase = "Loading" | "Intro" | "Playing" | "Won" | "Lost"
export type ObjectiveKey = "enter" | "fuses" | "insert" | "breakers" | "escape" | "run"

export type Snapshot = {
	phase: Phase,
	roundId: number,
	objective: ObjectiveKey,
	fusesTotal: number,
	fusesCollected: number,
	fusesHeld: number,
	fusesInserted: number,
	powerOn: boolean,
	gateOpen: boolean,
	creatureActive: boolean,
	roundStartedAt: number,
	roundEndedAt: number,
	hasKey: boolean,
	breakersOn: boolean,
	-- Ordem dos disjuntores desta rodada (ex.: "B - C - A"), para o procedimento.
	breakerOrder: string,
	-- Há checkpoint para continuar (tela de derrota mostra a opção).
	checkpointReady: boolean,
	-- Esta tentativa começou do checkpoint (intro curta).
	fromCheckpoint: boolean,
}

local INSTANCE_NAME = "GameState"

local DEFAULTS: { [string]: any } = {
	Phase = "Loading",
	RoundId = 0,
	Objective = "enter",
	FusesTotal = 3,
	FusesCollected = 0,
	FusesHeld = 0,
	FusesInserted = 0,
	PowerOn = false,
	GateOpen = false,
	CreatureActive = false,
	RoundStartedAt = 0,
	RoundEndedAt = 0,
	HasKey = false,
	BreakersOn = false,
	BreakerOrder = "",
	CheckpointReady = false,
	FromCheckpoint = false,
}

local GameState = {}

GameState.INSTANCE_NAME = INSTANCE_NAME

function GameState.serverCreate(): Configuration
	assert(RunService:IsServer(), "[GameState] serverCreate must run on the server")
	local existing = ReplicatedStorage:FindFirstChild(INSTANCE_NAME)
	if existing then
		return existing :: Configuration
	end
	local config = Instance.new("Configuration")
	config.Name = INSTANCE_NAME
	for name, value in DEFAULTS do
		config:SetAttribute(name, value)
	end
	config.Parent = ReplicatedStorage
	return config
end

local function instance(): Configuration
	local config = ReplicatedStorage:FindFirstChild(INSTANCE_NAME)
	assert(config, "[GameState] not created yet")
	return config :: Configuration
end

function GameState.set(name: string, value: any)
	assert(DEFAULTS[name] ~= nil, `[GameState] unknown attribute "{name}"`)
	instance():SetAttribute(name, value)
end

function GameState.get(name: string): any
	return instance():GetAttribute(name)
end

-- Cliente: espera a instância aparecer (o servidor cria no boot).
function GameState.wait(timeout: number?): Configuration
	local config = ReplicatedStorage:WaitForChild(INSTANCE_NAME, timeout or 30)
	assert(config, "[GameState] timed out waiting for ReplicatedStorage.GameState")
	return config :: Configuration
end

function GameState.snapshotOf(config: Instance): Snapshot
	local function attr(name: string): any
		local value = config:GetAttribute(name)
		if value == nil then
			return DEFAULTS[name]
		end
		return value
	end
	return {
		phase = attr("Phase"),
		roundId = attr("RoundId"),
		objective = attr("Objective"),
		fusesTotal = attr("FusesTotal"),
		fusesCollected = attr("FusesCollected"),
		fusesHeld = attr("FusesHeld"),
		fusesInserted = attr("FusesInserted"),
		powerOn = attr("PowerOn"),
		gateOpen = attr("GateOpen"),
		creatureActive = attr("CreatureActive"),
		roundStartedAt = attr("RoundStartedAt"),
		roundEndedAt = attr("RoundEndedAt"),
		hasKey = attr("HasKey"),
		breakersOn = attr("BreakersOn"),
		breakerOrder = attr("BreakerOrder"),
		checkpointReady = attr("CheckpointReady"),
		fromCheckpoint = attr("FromCheckpoint"),
	}
end

function GameState.snapshot(): Snapshot
	return GameState.snapshotOf(instance())
end

-- Chama `callback(snapshot, mudouAtributo)` agora e a cada mudança. Retorna função para desconectar.
function GameState.observe(callback: (snapshot: Snapshot, changed: string?) -> ()): () -> ()
	local config = GameState.wait()
	callback(GameState.snapshotOf(config), nil)
	local connection = config.AttributeChanged:Connect(function(name: string)
		callback(GameState.snapshotOf(config), name)
	end)
	return function()
		connection:Disconnect()
	end
end

return GameState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="394">
          <Properties>
            <string name="Name">HouseBroadcast</string>
            <string name="Source"><![CDATA[--!strict
-- A mesma transmissão acompanha pistas, televisão e cartelas; não contém soluções de puzzles.
local TableUtil = require("../Util/TableUtil")
local Broadcast = {
	{
		"A fita estava rodando antes de vocês chegarem.",
		"Ela mostra a porta da frente. Pelo lado de dentro.",
		"Três chaves. Uma pergunta: quem está gravando?",
	},
	{
		"Na gravação, ele bate à porta de cada quarto.",
		"Uma família respondia. Agora, só a casa responde.",
		"Se ouvirem três pancadas, apaguem a luz e escutem.",
	},
	{
		"O relógio parou na noite em que a família sumiu.",
		"Máscara, livro, retrato: cada lembrança guarda uma parte dela.",
		"Ele não protege a casa. A casa mantém ele aqui.",
	},
	{
		"O cofre foi fechado por alguém que tentou sair.",
		"O coração alimenta as paredes. O altar pode quebrar o ciclo.",
		"Devolvam o que foi levado. Não respondam às pancadas.",
	},
	{
		"A fita finalmente está mostrando o presente.",
		"Quando o coração parar, a casa perderá sua forma.",
		"Memorizem o retorno: escada, hall, varanda, floresta.",
	},
}
table.insert(Broadcast, {
	"A casa caiu, mas as pancadas continuam.",
	"O guarda deixou um mapa e um aviso: a mata se cala antes de ele chegar.",
	"Sigam as marcas amarelas. A floresta também escuta.",
})
table.insert(Broadcast, {
	"O acampamento está vazio. O rádio ainda chia.",
	"O diário ensina a frequência do resgate. Há duas vozes na transmissão.",
	"Uma delas pede que vocês sigam para uma mansão. O guarda escreveu: NÃO PAREM.",
})
table.insert(Broadcast, {
	"Além das árvores, há uma estrada.",
	"Alimentem a torre e chamem o resgate.",
	"O sinal revela a estrada ao resgate. Também revela o destino aos caçadores.",
})
return TableUtil.deepFreeze(Broadcast)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="395">
          <Properties>
            <string name="Name">HouseCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- Metadados públicos; soluções e sorteio pertencem ao HousePlan no servidor.
local TableUtil = require("../Util/TableUtil")
export type Room = { id: string, title: string, x: number, y: number, z: number }
export type Objective = { room: string, title: string, kind: string, item: string?, event: string?, revelation: string }
export type Chapter = { title: string, subtitle: string, objectives: { Objective } }
local function objective(
	room: string,
	title: string,
	kind: string,
	item: string?,
	event: string?,
	clue: string?
): Objective
	return {
		room = room,
		title = title,
		kind = kind,
		item = item,
		event = event,
		revelation = clue or title .. ": concluído.",
	}
end
local House = {
	Rooms = {
		{ id = "Exterior", title = "CAMINHO DA FLORESTA", x = 0, y = 0, z = 76 },
		{ id = "Hall", title = "HALL", x = 0, y = 0, z = 2 },
		{ id = "Living", title = "SALA DE ESTAR", x = -26, y = 0, z = -4 },
		{ id = "Kitchen", title = "COZINHA", x = 26, y = 0, z = -4 },
		{ id = "Dining", title = "SALA DE JANTAR", x = -26, y = 0, z = -36 },
		{ id = "Bath", title = "BANHEIRO", x = 26, y = 0, z = -36 },
		{ id = "Library", title = "BIBLIOTECA", x = -26, y = 0, z = -68 },
		{ id = "Machine", title = "SALA DE MÁQUINAS", x = 26, y = 0, z = -68 },
		{ id = "Bedroom", title = "QUARTO", x = -26, y = 16, z = -4 },
		{ id = "Child", title = "QUARTO INFANTIL", x = 26, y = 16, z = -4 },
		{ id = "Office", title = "ESCRITÓRIO", x = -26, y = 16, z = -36 },
		{ id = "Locked", title = "SALA TRANCADA", x = 26, y = 16, z = -36 },
		{ id = "Attic", title = "SÓTÃO", x = -26, y = 32, z = -4 },
		{ id = "AtticClock", title = "SÓTÃO / RELÓGIO", x = 26, y = 32, z = -4 },
