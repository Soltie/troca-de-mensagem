}

local function walletOf(currency: string): number
	return tonumber(player:GetAttribute(if currency == "fichas" then "Fichas" else "Creditos")) or 0
end

local function priceText(currency: string, price: number): string
	return `{number(price)} {if currency == "fichas" then "FICHAS" else "CRÉDITOS"}`
end

-- Diálogo de confirmação do menu (compras com Fichas/Créditos). Tocar fora cancela.
local function confirmDialog(title: string, message: string, confirmText: string, onConfirm: () -> ())
	local root = rootFrame
	if not root then
		return
	end
	local old = root:FindFirstChild("Confirm")
	if old then
		old:Destroy()
	end
	local holder = Create("Frame", {
		Name = "Confirm",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = root,
	}) :: Frame
	local dismiss = Create("TextButton", {
		Name = "Dismiss",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Overlay,
		BackgroundTransparency = 0.35,
		AutoButtonColor = false,
		Text = "",
		Parent = holder,
	}) :: TextButton
	dismiss.Activated:Connect(function()
		holder:Destroy()
	end)
	pendingConfirm = function()
		holder:Destroy()
		onConfirm()
	end
	holder.Destroying:Connect(function()
		pendingConfirm = nil
	end)
	local box = Components.panel({
		Name = "Box",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(if compactMenu then 340 else 440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.BgPanel,
		BackgroundTransparency = 0,
		Active = true,
		Parent = holder,
	})
	local outline = box:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color, outline.Transparency = Theme.Gold, 0.3
	end
	Components.padding(box, 18)
	Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = box })
	Components.title({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = title,
		TextSize = 20,
		LayoutOrder = 1,
		Parent = box,
	})
	note({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = message,
		TextSize = 15,
		LayoutOrder = 2,
		Parent = box,
	})
	local row = Create("Frame", {
		Name = "Actions",
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = box,
	})
	button({
		Name = "Cancel",
		Variant = "secondary",
		Size = UDim2.new(0.5, -5, 1, 0),
		Text = "CANCELAR",
		TextSize = 16,
		Parent = row,
	}, function()
		holder:Destroy()
	end)
	button({
		Name = "Confirm",
		Variant = "primary",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, -5, 1, 0),
		Text = confirmText,
		TextSize = 16,
		Parent = row,
	}, function()
		holder:Destroy()
		onConfirm()
	end)
end

-- Botão de preço: mostra a moeda com ícone; sem saldo fica desativado e diz quanto falta.
local function priceButton(
	parent: Instance,
	currency: string,
	price: number,
	props: { [string]: any },
	onBuy: () -> ()
): TextButton
	local have = walletOf(currency)
	local affordable = have >= price
	local fichas = currency == "fichas"
	props.Text = if affordable then priceText(currency, price) else `FALTAM {priceText(currency, price - have)}`
	props.Variant = if fichas then "primary" else "secondary"
	props.TextSize = props.TextSize or 14
	local b = button(props, onBuy)
	-- Espaço para o ícone da moeda à esquerda sem sobrepor o texto centralizado.
	Create("UIPadding", { PaddingLeft = UDim.new(0, 30), PaddingRight = UDim.new(0, 6), Parent = b })
	local icon = Components.icon(b, if fichas then "Coin" else "Gem", 24, if fichas then Theme.Coin else Theme.Info, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -22, 0.5, 0),
	})
	icon.Name = "Currency"
	Components.setDisabled(b, not affordable)
	b.Parent = parent
	return b
end

local function cardShell(
	parent: Instance,
	name: string,
	order: number,
	height: number,
	look: { icon: string, color: Color3 }
): Frame
	local card = Components.panel({
		Name = name,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = order,
		Parent = parent,
	})
	Components.padding(card, 12)
	local tile = Create("Frame", {
		Name = "IconTile",
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = look.color:Lerp(Theme.Bg, 0.75),
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.corner(tile, Theme.CornerSmall)
	Components.stroke(tile, look.color, 1, 0.4)
	Components.icon(tile, look.icon, 36, look.color, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	})
	return card
end

local function sectionHeader(parent: Instance, order: number, title: string, subtitle: string)
	local box = Create("Frame", {
		Name = `Section_{order}`,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	label({ Size = UDim2.new(1, 0, 0, 22), Text = title, TextSize = 18, TextColor3 = Theme.Gold, Parent = box })
	note({
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 18),
		Text = subtitle,
		TextSize = 13,
		Parent = box,
	})
end

local function buildPerks(b: Frame)
	local width = b.AbsoluteSize.X
	local columns = if width >= 640 then 2 else 1
	singleColumn = columns == 1
	local scroll = Create("ScrollingFrame", {
		Name = "PerksScroll",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = b,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) }),
	}) :: ScrollingFrame
	local levels = json("Perks", {})
	local stock = json("Consumables", {})
	local loadout: { [string]: boolean } = {}
	for _, id in json("Loadout", {}) do
		loadout[tostring(id)] = true
	end

	local function grid(order: number, cellHeight: number): Frame
		return Create("Frame", {
			Name = `Grid_{order}`,
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = scroll,
		}, {
			Create("UIGridLayout", {
				CellSize = UDim2.new(1 / columns, if columns == 2 then -5 else 0, 0, cellHeight),
				CellPadding = UDim2.fromOffset(10, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		}) :: Frame
	end

	sectionHeader(scroll, 1, "MELHORIAS PERMANENTES", "Valem em todas as partidas. Cada uma tem 5 níveis.")
	local perkGrid = grid(2, 196)
	for i, perk in Perks.List do
		local level = math.clamp(tonumber(levels[perk.id]) or 0, 0, Perks.MAX_LEVEL)
		local look = PERK_LOOK[perk.id] or { icon = "Perks", color = Theme.Gold }
		local card = cardShell(perkGrid, `Perk_{perk.id}`, i, 196, look)
		card:SetAttribute("Level", level)
		label({
			Name = "PerkName",
			Position = UDim2.fromOffset(64, 0),
			Size = UDim2.new(1, -64, 0, 22),
			Text = perk.name,
			TextSize = 17,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = card,
		})
		note({
			Position = UDim2.fromOffset(64, 24),
			Size = UDim2.new(1, -64, 0, 30),
			Text = perk.description,
			TextSize = 13,
			Parent = card,
		})
		-- Nível em 5 etapas + rótulo (não depende só de cor).
		local steps = Create("Frame", {
			Name = "Levels",
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, -86, 0, 10),
			BackgroundTransparency = 1,
			Parent = card,
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for step = 1, Perks.MAX_LEVEL do
			local segment = Create("Frame", {
				LayoutOrder = step,
				Size = UDim2.new(1 / Perks.MAX_LEVEL, -4, 1, 0),
				BackgroundColor3 = if step <= level then look.color else Theme.BgSunken,
				BorderSizePixel = 0,
				Parent = steps,
			})
			Components.corner(segment, Theme.CornerPill)
		end
		label({
			Name = "LevelText",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 56),
			Size = UDim2.fromOffset(80, 22),
			Text = `NÍVEL {level}/{Perks.MAX_LEVEL}`,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = look.color,
			Parent = card,
		})
		local now = if level > 0 then effectText(perk.id, level) else "SEM EFEITO"
		label({
			Name = "Effect",
			Position = UDim2.fromOffset(0, 82),
			Size = UDim2.new(1, 0, 0, 36),
			Text = if level >= Perks.MAX_LEVEL
				then `AGORA: {now} · NÍVEL MÁXIMO`
				else `AGORA: {now}\nPRÓXIMO: {effectText(perk.id, level + 1)}`,
			TextSize = 13,
			TextColor3 = GREEN,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local actions = Create("Frame", {
			Name = "Actions",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, Theme.TouchMin),
			BackgroundTransparency = 1,
			Parent = card,
		})
		if level >= Perks.MAX_LEVEL then
			local done = button(
				{ Variant = "success", Size = UDim2.fromScale(1, 1), Text = "NÍVEL MÁXIMO", Parent = actions },
				function() end
			)
			Components.setDisabled(done, true)
		else
			for column, currency in { "fichas", "creditos" } do
				local price = Perks.nextCost(perk.id, level, currency :: Perks.Currency) or 0
				priceButton(actions, currency, price, {
					Name = if currency == "fichas" then "UpgradeFichas" else "UpgradeCreditos",
					Position = UDim2.new((column - 1) * 0.5, if column == 1 then 0 else 5, 0, 0),
					Size = UDim2.new(0.5, -5, 1, 0),
				}, function()
					confirmDialog(
						`MELHORAR {perk.name}?`,
						`Nível {level + 1}: {effectText(perk.id, level + 1)}. Custa {priceText(currency, price)}; você fica com {priceText(
							currency,
							walletOf(currency) - price
						)}.`,
						"MELHORAR",
						function()
							store(if currency == "fichas" then "upgrade_fichas" else "upgrade_creditos", perk.id)
						end
					)
				end)
			end
		end
	end

	sectionHeader(
		scroll,
		3,
		"CONSUMÍVEIS PARA A PARTIDA",
		"Compre aqui; coloque na mochila para usar sozinho na partida (aba JOGAR)."
	)
	local itemGrid = grid(4, 264)
	for i, def in Perks.Consumables do
		local count = tonumber(stock[def.id]) or 0
		local on = loadout[def.id] == true
		local look = PERK_LOOK[def.id] or { icon = "Backpack", color = Theme.Gold }
		local card = cardShell(itemGrid, `Consumable_{def.id}`, i, 264, look)
		card:SetAttribute("Count", count)
		label({
			Name = "ItemName",
			Position = UDim2.fromOffset(64, 0),
			Size = UDim2.new(1, -64, 0, 22),
			Text = def.name,
			TextSize = 17,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = card,
		})
		local stateText, stateColor = "FORA DA MOCHILA", Theme.TextSecondary
		if count <= 0 then
			stateText, stateColor = "SEM ESTOQUE", Theme.TextMuted
		elseif not def.loadout then
			stateText, stateColor = "USO NO BOTÃO CONTINUAR", Theme.Info
		elseif on then
			stateText, stateColor = "NA MOCHILA", GREEN
		end
		local chips = Create("Frame", {
			Name = "Chips",
			Position = UDim2.fromOffset(64, 26),
			Size = UDim2.new(1, -64, 0, 24),
			BackgroundTransparency = 1,
			Parent = card,
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		Components.chip(`VOCÊ TEM {count}`, look.color, { LayoutOrder = 1, Parent = chips })
		Components.chip(stateText, stateColor, { LayoutOrder = 2, Parent = chips })
		note({
			Position = UDim2.fromOffset(0, 60),
			Size = UDim2.new(1, 0, 0, 34),
			Text = def.description,
			TextSize = 13,
			Parent = card,
		})
		label({
			Position = UDim2.fromOffset(0, 96),
			Size = UDim2.new(1, 0, 0, 18),
			Text = if def.bundle > 1 then `CADA COMPRA: {def.bundle} UNIDADES` else "CADA COMPRA: 1 UNIDADE",
			TextSize = 12,
			TextColor3 = Theme.TextSecondary,
			Parent = card,
		})
		local full = count + def.bundle > Perks.MAX_STOCK
		local buyRow = Create("Frame", {
			Name = "Buy",
			Position = UDim2.new(0, 0, 1, -(2 * Theme.TouchMin + 8)),
			Size = UDim2.new(1, 0, 0, Theme.TouchMin),
			BackgroundTransparency = 1,
			Parent = card,
		})
		local options: { { currency: string, price: number } } = {}
		if def.fichas then
			table.insert(options, { currency = "fichas", price = def.fichas })
		end
		if def.creditos then
			table.insert(options, { currency = "creditos", price = def.creditos })
		end
		for index, option in options do
			local share = 1 / #options
			local buyButton = priceButton(buyRow, option.currency, option.price, {
				Name = if option.currency == "fichas" then "BuyFichas" else "BuyCreditos",
				Position = UDim2.new(share * (index - 1), if index == 1 then 0 else 5, 0, 0),
				Size = UDim2.new(share, if #options > 1 then -5 else 0, 1, 0),
			}, function()
				confirmDialog(
					`COMPRAR {def.name}?`,
					`Recebe {def.bundle} {if def.bundle > 1 then "unidades" else "unidade"}. Custa {priceText(
						option.currency,
						option.price
					)}; você fica com {priceText(option.currency, walletOf(option.currency) - option.price)}.`,
					"COMPRAR",
					function()
						store(
							if option.currency == "fichas" then "consumable_fichas" else "consumable_creditos",
							def.id
						)
					end
				)
			end)
			if full then
				buyButton.Text = `ESTOQUE CHEIO ({Perks.MAX_STOCK})`
				Components.setDisabled(buyButton, true)
			end
		end
		-- Ativação separada da compra: só itens de mochila com estoque.
		local toggleRow = Create("Frame", {
			Name = "Loadout",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, Theme.TouchMin),
			BackgroundTransparency = 1,
			Parent = card,
		})
		local toggle = button({
			Name = "Toggle",
			Variant = if on and count > 0 then "success" elseif def.loadout and count > 0 then "secondary" else "ghost",
			Size = UDim2.fromScale(1, 1),
			Text = if not def.loadout
				then "APARECE QUANDO O TIME PERDER"
				elseif count <= 0 then "COMPRE PARA USAR NA MOCHILA"
				elseif on then "NA MOCHILA · TOCAR PARA TIRAR"
				else "COLOCAR NA MOCHILA",
			TextSize = 14,
			Parent = toggleRow,
		}, function()
			if def.loadout and count > 0 then
				store(if on then "loadout_off" else "loadout_on", def.id)
			end
		end)
		Components.setDisabled(toggle, not def.loadout or count <= 0)
	end

	-- Pacotes em Robux só aparecem quando o produto existe no Creator Hub (ID publicado).
	local keys = {
		"kit_sobrevivente",
		"segunda_chance_3",
		"segunda_chance_10",
		"pilhas_10",
		"bonus_fichas_1h",
		"bonus_duplo_3h",
		"arquivo_elias",
		"creditos_550",
		"creditos_1200",
		"creditos_2800",
	}
	local sellable = {}
	for _, key in keys do
		local product = StoreCatalog.ProductByKey[key]
		if product and product.id > 0 then
			table.insert(sellable, product)
		end
	end
	if #sellable > 0 then
		sectionHeader(scroll, 5, "PACOTES EM ROBUX", "Compra pela janela oficial do Roblox.")
		local packs = grid(6, 132)
		for i, product in sellable do
			local card = Components.panel({ Name = `Product_{product.key}`, LayoutOrder = i, Parent = packs })
			Components.padding(card, 10)
			label({ Size = UDim2.new(1, 0, 0, 22), Text = product.name, TextSize = 15, Parent = card })
			note({
				Position = UDim2.fromOffset(0, 24),
				Size = UDim2.new(1, 0, 0, 40),
				Text = product.description,
				TextSize = 12,
				Parent = card,
			})
			button({
				Name = "Buy",
				Variant = "success",
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, Theme.TouchMin),
				Text = `R$ {product.robux}`,
				Parent = card,
			}, function()
				buyProduct(product.key)
			end)
		end
	end
end

local PHASE_NAMES: { [string]: string } = {
	Lobby = "NO LOBBY",
	Playing = "EM PARTIDA",
	Intermission = "ENTRE ETAPAS",
	Extracting = "FUGINDO",
	Won = "TERMINANDO",
	Lost = "TERMINANDO",
}

local function fetchServers()
	lastServerFetch = os.clock()
	task.spawn(function()
		local data, err = invoke("Lobby", "servers")
		if err then
			say(err)
			return
		end
		serverCache = data
		if currentTab == "servers" then
			dirty = true
		end
	end)
end

-- Lista rolável padrão das abas sociais (uma única rolagem vertical).
local function socialList(parent: Instance, top: number): ScrollingFrame
	return Create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(0, top),
		Size = UDim2.new(1, 0, 1, -top),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	}) :: ScrollingFrame
end

-- Estado vazio/aviso com ícone: explica o que acontece e o que fazer, sem botão falso.
local function emptyState(parent: Instance, icon: string, title: string, message: string)
	local box = Components.panel({ Name = "Empty", Size = UDim2.new(1, 0, 0, 92), LayoutOrder = 0, Parent = parent })
	Components.padding(box, 14)
	Components.icon(box, icon, 36, Theme.TextMuted, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
	})
	label({
		Position = UDim2.fromOffset(52, 4),
		Size = UDim2.new(1, -52, 0, 22),
		Text = title,
		TextSize = 16,
		Parent = box,
	})
	note({
		Position = UDim2.fromOffset(52, 30),
		Size = UDim2.new(1, -52, 0, 34),
		Text = message,
		TextSize = 13,
		Parent = box,
	})
end

local function buildServers(b: Frame)
	local data = serverCache
	if not data or os.clock() - lastServerFetch > 20 then
		fetchServers()
	end
	local current = if data then data.current else nil
	local head = Components.panel({ Name = "Current", Size = UDim2.new(1, -10, 0, 64), Parent = b })
	Components.padding(head, 12, 8)
	Components.icon(head, "Servers", 24, Theme.Gold, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
	})
	label({
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -194, 0.5, 0),
		Text = "ESTE SERVIDOR",
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Parent = head,
	})
	label({
		Name = "CurrentStatus",
		Position = UDim2.new(0, 34, 0.5, 0),
		Size = UDim2.new(1, -194, 0.5, 0),
		Text = if current
			then `{current.players}/{current.max} JOGADORES · {PHASE_NAMES[current.phase] or current.phase}`
			else "CARREGANDO...",
		TextSize = 16,
		TextColor3 = Theme.Gold,
		Parent = head,
	})
	button({
		Name = "Refresh",
		Variant = "secondary",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(150, Theme.TouchMin),
		Text = "ATUALIZAR",
		TextSize = 14,
		Parent = head,
	}, fetchServers)
	local list = socialList(b, 76)
	if not data then
		emptyState(list, "Servers", "PROCURANDO SERVIDORES...", "A lista aparece em instantes.")
		return
	end
	if not data.online then
		emptyState(
			list,
			"Servers",
			"SÓ NO JOGO PUBLICADO",
			"A lista de outros servidores funciona no jogo publicado. No Studio só existe este servidor."
		)
		return
	end
	local servers = if type(data.servers) == "table" then data.servers else {}
	if #servers == 0 then
		emptyState(list, "Friends", "NENHUM OUTRO SERVIDOR ABERTO", "Chame amigos pela aba AMIGOS e joguem juntos.")
	end
	for i, entry in servers do
		local full = entry.players >= entry.max
		local row =
			Components.panel({ Name = `Server_{i}`, Size = UDim2.new(1, 0, 0, 72), LayoutOrder = i, Parent = list })
		Components.padding(row, 12, 10)
		local chips = Create("Frame", {
			Size = UDim2.new(1, -170, 0, 24),
			BackgroundTransparency = 1,
			Parent = row,
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local mode = if entry.mode == "Story"
			then "HISTÓRIA"
			elseif entry.mode == "Standard" then "DESAFIO"
			else "VOTANDO"
		Components.chip(
			PHASE_NAMES[entry.phase] or tostring(entry.phase),
			Theme.Info,
			{ LayoutOrder = 1, Parent = chips }
		)
		Components.chip(mode, Theme.Gold, { LayoutOrder = 2, Parent = chips })
		if (entry.stage or 0) > 0 then
			Components.chip(`CAPÍTULO {entry.stage}`, Theme.TextSecondary, { LayoutOrder = 3, Parent = chips })
		end
		Components.icon(row, "Friends", 12, Theme.TextSecondary, { Position = UDim2.fromOffset(0, 36) })
		label({
			Position = UDim2.fromOffset(18, 30),
			Size = UDim2.fromOffset(80, 22),
			Text = `{entry.players}/{entry.max}`,
			TextSize = 14,
			Parent = row,
		})
		local bar, setBar = Components.progress({
			Position = UDim2.fromOffset(90, 38),
			Size = UDim2.new(1, -270, 0, 6),
		}, if full then Theme.Danger else GREEN)
		bar.Parent = row
		setBar(entry.players / math.max(entry.max, 1))
		local join = button({
			Name = "Join",
			Variant = "success",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(150, Theme.TouchMin),
			Text = if full then "CHEIO" else "ENTRAR",
			TextSize = 15,
			Parent = row,
		}, function()
			local result, err = invoke("Lobby", "join", entry.job)
			say(err or (if type(result) == "table" then result.message else nil))
		end)
		Components.setDisabled(join, full)
	end
end

local function fetchFriends()
	task.spawn(function()
		local ok, result = pcall(function()
			return player:GetFriendsOnline(50)
		end)
		if ok and type(result) == "table" then
			friendsCache, friendsError = result, nil
		else
			friendsCache, friendsError = {}, tostring(result)
		end
		if currentTab == "friends" then
			dirty = true
		end
	end)
end

local function invite()
	task.spawn(function()
		local ok, can = pcall(function()
			return SocialService:CanSendGameInviteAsync(player)
		end)
		if ok and can then
			pcall(function()
				SocialService:PromptGameInvite(player)
			end)
		else
			say("lobby_studio")
		end
	end)
end

local function buildFriends(b: Frame)
	if not friendsCache then
		fetchFriends()
	end
	local head = Components.panel({ Name = "Invite", Size = UDim2.new(1, -10, 0, 64), Parent = b })
	Components.padding(head, 8)
	Components.iconButton("primary", "Friends", "CONVIDAR AMIGOS", {
		Name = "Invite",
		Size = UDim2.new(1, -168, 1, 0),
		TextSize = 17,
		Parent = head,
	}, function()
		AudioController.play("UiBlip", 0.5, 1.1, true)
		invite()
	end)
	button({
		Name = "Refresh",
		Variant = "secondary",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 158, 1, 0),
		Text = "ATUALIZAR",
		TextSize = 14,
		Parent = head,
	}, fetchFriends)
	local list = socialList(b, 76)
	local friends = friendsCache
	if not friends then
		emptyState(list, "Friends", "PROCURANDO AMIGOS ONLINE...", "A lista aparece em instantes.")
		return
	end
	if friendsError then
		emptyState(list, "Friends", "NÃO DEU PARA LER SEUS AMIGOS", "Tente ATUALIZAR em alguns segundos.")
		return
	end
	if #friends == 0 then
		emptyState(list, "Friends", "NENHUM AMIGO ONLINE AGORA", "Use CONVIDAR AMIGOS para chamar alguém para a casa.")
	end
	-- Quem está neste jogo aparece primeiro.
	table.sort(friends, function(a, c)
		local inA = a.PlaceId == game.PlaceId and game.PlaceId ~= 0
		local inC = c.PlaceId == game.PlaceId and game.PlaceId ~= 0
		if inA ~= inC then
			return inA
		end
		return tostring(a.DisplayName or a.UserName) < tostring(c.DisplayName or c.UserName)
	end)
	for i, friend in friends do
		local here = friend.PlaceId == game.PlaceId and game.PlaceId ~= 0
		local row =
			Components.panel({ Name = `Friend_{i}`, Size = UDim2.new(1, 0, 0, 68), LayoutOrder = i, Parent = list })
		Components.padding(row, 10)
		local face = Create("ImageLabel", {
			Size = UDim2.fromOffset(48, 48),
			BackgroundColor3 = Theme.BgSunken,
			BorderSizePixel = 0,
			Image = `rbxthumb://type=AvatarHeadShot&id={friend.VisitorId}&w=48&h=48`,
			Parent = row,
		})
		Components.corner(face, Theme.CornerPill)
		Components.stroke(face, if here then GREEN else Theme.Border, 2, if here then 0 else 0.5)
		label({
			Position = UDim2.fromOffset(60, 2),
			Size = UDim2.new(1, -230, 0, 22),
			Text = tostring(friend.DisplayName or friend.UserName or "?"),
			TextSize = 16,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		label({
			Position = UDim2.fromOffset(60, 26),
			Size = UDim2.new(1, -230, 0, 18),
			Text = if here then "JOGANDO TUNG TUNG SAHUR" else tostring(friend.LastLocation or "ONLINE"),
			TextSize = 12,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextColor3 = if here then GREEN else Theme.TextSecondary,
			Parent = row,
		})
		if here then
			button({
				Name = "JoinFriend",
				Variant = "success",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(1, 0.5),
				Size = UDim2.fromOffset(150, Theme.TouchMin),
				Text = "ENTRAR",
				TextSize = 15,
				Parent = row,
			}, function()
				local result, err = invoke("Lobby", "friend", tostring(friend.VisitorId))
				say(err or (if type(result) == "table" then result.message else nil))
			end)
		end
	end
end

type CardMetrics = { art: number, height: number, title: number, desc: number, pad: number, vote: number }

-- Medidas do cartão de campanha (PC em pixels de desenho 1280×720; compacto em pixels reais).
local function cardMetrics(): CardMetrics
	if compactMenu then
		return { art = 76, height = 270, title = 21, desc = 13, pad = 12, vote = 44 }
	end
	return { art = 88, height = 306, title = 28, desc = 15, pad = 14, vote = 48 }
end

-- Arte original do cartão: céu noturno em gradiente, lua e horizonte pixel-art (casa ou mata).
local function campaignArt(parent: Instance, story: boolean, m: CardMetrics): Frame
	local art = Create("Frame", {
		Name = "Art",
		Size = UDim2.new(1, 0, 0, m.art),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = parent,
	}) :: Frame
	Components.corner(art, Theme.CornerLarge)
	Create("UIGradient", {
		Rotation = 90,
		Color = if story
			then ColorSequence.new(Color3.fromRGB(30, 42, 66), Color3.fromRGB(86, 58, 36))
			else ColorSequence.new(Color3.fromRGB(16, 34, 44), Color3.fromRGB(24, 56, 42)),
		Parent = art,
	})
	local moon = Create("Frame", {
		Name = "Moon",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 10),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.GoldLight,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Parent = art,
	})
	Components.corner(moon, Theme.CornerPill)
	-- Horizonte: silhuetas escuras; as janelas da casa deixam o céu quente aparecer como luz acesa.
	local big = math.max(36, math.floor((m.art - 16) / 12) * 12)
	local small = math.max(24, big - 24)
	local shapes: { { string | number } } = if story
		then { { "Tree", small, 0.52 }, { "House", big, 0.66 }, { "Tree", small, 0.8 } }
		else {
			{ "Tree", small, 0.5 },
			{ "Tree", big, 0.62 },
			{ "Tree", small + 12, 0.75 },
			{ "Tree", small, 0.86 },
		}
	for _, shape in shapes do
		local size = shape[2] :: number
		Components.icon(art, shape[1] :: string, size, Theme.Overlay, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(shape[3] :: number, 0, 1, 2),
		})
	end
	Create("Frame", {
		Name = "Ground",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Theme.Overlay,
		BorderSizePixel = 0,
		Parent = art,
	})
	return art
end

-- Trilha dos 8 capítulos: estado por ícone e texto, não só por cor.
local function chapterTrack(parent: Instance, y: number, height: number)
	local cleared, flawless = storyCleared()
	local states = MenuLayout.chapters(cleared, flawless, #StoryRewards.Chapters)
	local track = Create("Frame", {
		Name = "Chapters",
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local count = #states
	for chapter, state in states do
		local won = state == "cleared" or state == "flawless"
		local tile = Create("Frame", {
			Name = `Chapter_{chapter}`,
			LayoutOrder = chapter,
			Size = UDim2.new(1 / count, -4 * (count - 1) / count, 1, 0),
			BackgroundColor3 = if won then Theme.GoldDeep else Theme.BgSunken,
			BorderSizePixel = 0,
			Parent = track,
		}) :: Frame
		tile:SetAttribute("State", state)
		Components.corner(tile, Theme.CornerSmall)
		Components.stroke(
			tile,
			if state == "next" or won then Theme.Gold else Theme.Border,
			if state == "next" then 2 else 1,
			if state == "open" then 0.6 else 0.1
		)
		if won then
			Components.icon(tile, if state == "flawless" then "Star" else "Check", 12, Theme.GoldLight, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
			})
		else
			label({
				Size = UDim2.fromScale(1, 1),
				Text = tostring(chapter),
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextColor3 = if state == "next" then Theme.GoldLight else Theme.TextMuted,
				Parent = tile,
			})
		end
	end
end

local function modeCard(
	parent: Instance,
	index: number,
	columns: number,
	id: string,
	eyebrow: string,
	title: string,
	description: string,
	extra: (Frame, CardMetrics) -> ()
)
	local m = cardMetrics()
	local card = Create("Frame", {
		Name = `Mode_{id}`,
		Position = if columns == 2
			then UDim2.new((index - 1) * 0.5, if index == 1 then 0 else 6, 0, 0)
			else UDim2.fromOffset(0, (index - 1) * (m.height + 12)),
		Size = if columns == 2 then UDim2.new(0.5, -6, 1, 0) else UDim2.new(1, 0, 0, m.height),
		BackgroundColor3 = Theme.BgPanel,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Parent = parent,
	}) :: Frame
	Components.corner(card, Theme.CornerLarge)
	local border = Components.stroke(card, Theme.Border, 1, 0.45)
	local story = id == "Story"
	local art = campaignArt(card, story, m)
	Components.chip(eyebrow, if story then Theme.Gold else GREEN, {
		Position = UDim2.fromOffset(m.pad, 10),
		Parent = art,
	})
	local titleLabel = label({
		Name = "Title",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, m.pad, 1, -8),
		Size = UDim2.new(0.62, 0, 0, m.title + 6),
		Text = title,
		TextSize = m.title,
		TextWrapped = false,
		TextScaled = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = art,
	})
	titleLabel.TextStrokeColor3 = Theme.Overlay
	titleLabel.TextStrokeTransparency = 0.2
	local inner = Create("Frame", {
		Name = "Info",
		Position = UDim2.fromOffset(m.pad, m.art + 10),
		Size = UDim2.new(1, -2 * m.pad, 1, -(m.art + 10 + m.pad)),
		BackgroundTransparency = 1,
		Parent = card,
	}) :: Frame
	note({
		Name = "Description",
		Size = UDim2.new(1, 0, 0, if compactMenu then 32 else 36),
		Text = description,
		TextSize = m.desc,
		Parent = inner,
	})
	extra(inner, m)
	Components.icon(inner, "Friends", 24, Theme.TextSecondary, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -(m.vote - 24) // 2),
	})
	local votes = label({
		Name = "Votes",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 32, 1, 0),
		Size = UDim2.new(0.45, -32, 0, m.vote),
		Text = "0 VOTOS",
		TextSize = 15,
		TextColor3 = Theme.TextSecondary,
		Parent = inner,
	})
	local vote = button({
		Name = "Vote",
		Variant = "primary",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0.55, 0, 0, m.vote),
		Text = "VOTAR",
		TextSize = if compactMenu then 20 else 22,
	}, function()
		local data, err = invoke("SelectGameMode", id)
		if err then
			say(err)
		elseif type(data) == "table" and not data.accepted then
			say("not_available")
		end
	end)
	vote.Parent = inner
	table.insert(live, function()
		local state = campaign()
		local count = tonumber(if state then state:GetAttribute(if story then "StoryVotes" else "StandardVotes") else 0)
			or 0
		votes.Text = px(if count == 1 then "1 VOTO" else `{count} VOTOS`)
		local mine = player:GetAttribute("GameModeVote") == id
		local wanted: Components.Variant = if mine then "success" else "primary"
		if vote:GetAttribute("Variant") ~= wanted then
			Components.setVariant(vote, wanted)
		end
		vote.Text = px(if mine then "SEU VOTO" else "VOTAR")
		border.Color = if mine then Theme.Gold else Theme.Border
		border.Transparency = if mine then 0 else 0.45
		border.Thickness = if mine then 2 else 1
	end)
end

-- Slots de informação dentro do cartão (A: trilha/linha 1, B: recompensa/linha 2, C: oferta/estado).
local function slotY(m: CardMetrics, slot: string): (number, number)
	local compact = m.art < 84
	if slot == "A" then
		return if compact then 36 else 40, if compact then 28 else 30
	elseif slot == "B" then
		return if compact then 68 else 76, if compact then 16 else 18
	end
	return if compact then 90 else 100, if compact then 32 else 36
end

local function teamPanel(parent: Instance, position: UDim2, size: UDim2)
	local panel = Components.panel({ Name = "Team", Position = position, Size = size, Parent = parent })
	Components.padding(panel, 12, 10)
	Components.icon(panel, "Friends", 24, Theme.Gold)
	local status = label({
		Name = "Status",
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -164, 0, 24),
		Text = "",
		TextSize = 15,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = Theme.Gold,
		Parent = panel,
	})
	button({
		Name = "Invite",
		Variant = "ghost",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -4),
		Size = UDim2.fromOffset(124, if compactMenu then 40 else 32),
		Text = "CONVIDAR",
		TextSize = 14,
	}, invite).Parent =
		panel
	local slots = Create("Frame", {
		Name = "Slots",
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local avatar = if compactMenu then 36 else 40
	local slotFrames: { Frame } = {}
	local max = Config.Campaign.maxPlayers
	for i = 1, max do
		local slot = Create("Frame", {
			Name = `Slot_{i}`,
			Position = UDim2.fromScale((i - 1) / max, 0),
			Size = UDim2.fromScale(1 / max, 1),
			BackgroundTransparency = 1,
			Parent = slots,
		}) :: Frame
		local face = Create("ImageLabel", {
			Name = "Face",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromOffset(avatar, avatar),
			BackgroundColor3 = Theme.BgSunken,
			BorderSizePixel = 0,
			Image = "",
			Parent = slot,
		}) :: ImageLabel
		Components.corner(face, Theme.CornerPill)
		Components.stroke(face, Theme.Border, 2, 0.5).Name = "Ring"
		Components.icon(face, "Plus", 12, Theme.TextMuted, {
			Name = "Empty",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
		})
		label({
			Name = "Who",
			Position = UDim2.fromOffset(0, avatar + 2),
			Size = UDim2.new(1, 0, 0, 16),
			Text = "",
			TextSize = 12,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = slot,
		})
		table.insert(slotFrames, slot)
	end
	table.insert(live, function()
		local state = campaign()
		local list = Players:GetPlayers()
		local count = #list
		local remaining = if state
			then math.ceil((tonumber(state:GetAttribute("NextStageAt")) or 0) - workspace:GetServerTimeNow())
			else 0
		status.Text = px(
			if remaining > 0
				then `TIME REUNIDO · COMEÇANDO EM {remaining}s`
				elseif
					count < Config.Campaign.minPlayers
				then `TIME {count}/{max} · FALTAM {Config.Campaign.minPlayers - count} PARA COMEÇAR`
				else `TIME {count}/{max} · ESPERANDO OS VOTOS`
		)
		for i, slot in slotFrames do
			local other = list[i]
			local face = slot:FindFirstChild("Face") :: ImageLabel
			local who = slot:FindFirstChild("Who") :: TextLabel
			local ring = face:FindFirstChild("Ring") :: UIStroke
			local empty = face:FindFirstChild("Empty") :: Frame
			if other then
				face.Image = `rbxthumb://type=AvatarHeadShot&id={other.UserId}&w=48&h=48`
				empty.Visible = false
				who.Text = px(other.DisplayName)
				local vote = other:GetAttribute("GameModeVote")
				ring.Color = if vote == "Story" then Theme.Gold elseif vote == "Standard" then GREEN else Theme.Border
				ring.Transparency = if vote == "Story" or vote == "Standard" then 0 else 0.5
			else
				face.Image = ""
				empty.Visible = true
				who.Text = ""
				ring.Color, ring.Transparency = Theme.Border, 0.7
			end
		end
	end)
end

-- Mochila da partida: consumíveis reais (estoque/kit publicados pelo StoreService).
local function kitPanel(parent: Instance, position: UDim2, size: UDim2)
	local panel = Components.panel({ Name = "Kit", Position = position, Size = size, Parent = parent })
	Components.padding(panel, 12, 10)
	Components.icon(panel, "Backpack", 24, Theme.Gold)
	label({
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -32, 0, 24),
		Text = "MOCHILA DA PARTIDA",
		TextSize = 15,
		TextColor3 = Theme.Gold,
		Parent = panel,
	})
	local stock = json("Consumables", {})
	local loadout: { [string]: boolean } = {}
	for _, id in json("Loadout", {}) do
		loadout[tostring(id)] = true
	end
	local holder = Create("Frame", {
		Name = "Slots",
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 1, -32),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local total = #Perks.Consumables
	for i, def in Perks.Consumables do
		local count = tonumber(stock[def.id]) or 0
		local on = loadout[def.id] == true
		local active = def.loadout and on and count > 0
		local stateText = if count <= 0
			then "SEM ESTOQUE"
			elseif not def.loadout then "USO NA DERROTA"
			elseif on then "NA MOCHILA"
			else "FORA DA MOCHILA"
		local tile = Components.button(if active then "success" else "secondary", {
			Name = `Kit_{def.id}`,
			LayoutOrder = i,
			Size = UDim2.new(1 / total, -6 * (total - 1) / total, 1, 0),
			Text = "",
		}, function()
			click()
			if count <= 0 then
				currentTab = "perks"
				dirty = true
			elseif def.loadout then
				store(if on then "loadout_off" else "loadout_on", def.id)
			else
				say("Use no botão CONTINUAR depois de uma derrota.")
			end
		end)
		tile.Parent = holder
		label({
			Name = "ItemName",
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.new(1, -12, 0.62, -4),
			Text = `{def.name} x{count}`,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = tile,
		})
		label({
			Name = "ItemState",
			Position = UDim2.new(0, 6, 0.62, 0),
			Size = UDim2.new(1, -12, 0.38, -4),
			Text = stateText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = if active then GREEN elseif count <= 0 then Theme.TextMuted else Theme.TextSecondary,
			Parent = tile,
		})
	end
end

-- Vitrine: o próprio Tung Tung do jogo, animado, com a "fala" dele.
local function showcase(parent: Instance, order: number)
	local portraitWidth = if singleColumn then 110 else 200
	local textX = portraitWidth + 10
	local box = Components.panel({
		Name = "Showcase",
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, if compactMenu then 132 else 150),
		LayoutOrder = order,
		Parent = parent,
	})
	Create("UIGradient", {
		Color = ColorSequence.new(Theme.BgElevated, Theme.Bg),
		Rotation = 0,
		Parent = box,
	})
	local viewport = Create("ViewportFrame", {
		Name = "TungTung",
		Size = UDim2.new(0, portraitWidth, 1, 0),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 140, 170),
		LightColor = Color3.fromRGB(255, 226, 180),
		LightDirection = Vector3.new(-0.6, -1, 0.4),
		Parent = box,
	}) :: ViewportFrame
	Components.icon(box, "Drum", 24, Theme.Gold, { Position = UDim2.fromOffset(textX, 12) })
	label({
		Position = UDim2.fromOffset(textX + 32, 8),
		Size = UDim2.new(1, -textX - 44, 0, 32),
		Text = "TUNG TUNG SAHUR",
		TextSize = if singleColumn then 20 else 26,
		TextColor3 = Theme.GoldLight,
		Parent = box,
	})
	note({
		Position = UDim2.fromOffset(textX, 46),
		Size = UDim2.new(1, -textX - 12, 0, 24),
		Text = "“TUM... TUM... TUM... SAHUR!”",
		TextSize = 15,
		TextColor3 = Theme.TextPrimary,
		Parent = box,
	})
	note({
		Position = UDim2.fromOffset(textX, 74),
		Size = UDim2.new(1, -textX - 12, 0, 56),
		Text = "Ele anda pela casa com o bastão. Apague a lanterna, se esconda nos armários e salve seus amigos!",
		TextSize = 14,
		Parent = box,
	})
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local rig = TungTungRig.build(world)
	if rig then
		local camera = Instance.new("Camera")
		camera.FieldOfView = 30
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 4.6, -13.5), Vector3.new(0, 3.9, 0))
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		local clips: { TungTungRig.ClipName } = { "idle", "slash", "strafe", "walk", "sheath" }
		local index, showClock, sway = 1, 0, 0
		local connection: RBXScriptConnection? = nil
		connection = RunService.RenderStepped:Connect(function(dt)
			if not viewport.Parent then
				if connection then
					connection:Disconnect()
				end
				return
			end
			local screen = gui
			if not screen or not screen.Enabled then
				return
			end
			showClock += dt
			sway += dt
			if showClock > 3 then
				showClock = 0
				index = index % #clips + 1
				TungTungRig.play(rig, clips[index], 0.3)
			end
			TungTungRig.place(rig, CFrame.Angles(0, math.sin(sway * 0.6) * 0.5, 0))
			TungTungRig.step(rig, dt)
		end)
	end
end

local function buildPlay(parent: Frame)
	local width = parent.AbsoluteSize.X
	if width <= 0 then
		width = if compactMenu then 600 else 900
	end
	local columns = MenuLayout.columns(width)
	columnsShown = columns
	singleColumn = columns == 1
	local m = cardMetrics()
	-- Conteúdo maior que o painel rola numa única lista vertical.
	local scroll = Create("ScrollingFrame", {
		Name = "PlayScroll",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		Parent = parent,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 6) }),
	})
	local modes = frame({
		Name = "Modes",
		Size = UDim2.new(1, 0, 0, if columns == 2 then m.height else m.height * 2 + 12),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = scroll,
	})
	modeCard(
		modes,
		1,
		columns,
		"Story",
		"MODO HISTÓRIA",
		"THE CURSED HOUSE",
		"Casa + floresta: 8 capítulos, perseguição e resgate. Solo ou equipe de até 6.",
		function(inner, cm)
			local ay, ah = slotY(cm, "A")
			chapterTrack(inner, ay, ah)
			local by, bh = slotY(cm, "B")
			local chapter, reward = storyPreview()
			label({
				Name = "NextReward",
				Position = UDim2.fromOffset(0, by),
				Size = UDim2.new(1, 0, 0, bh),
				Text = `PRÓXIMO: CAP. {chapter} · {reward}`,
				TextSize = 13,
				TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextColor3 = GREEN,
				Parent = inner,
			})
			local cy, ch = slotY(cm, "C")
			if player:GetAttribute("StoryPass") == true then
				Components.chip("PASSE DA HISTÓRIA ATIVO · RECOMPENSAS x2", Theme.Gold, {
					Position = UDim2.fromOffset(0, cy + (ch - 24) // 2),
					Parent = inner,
				})
			else
				-- Produto sem ID publicado não vira botão morto (ver docs/ui-remaster/AUDITORIA.md).
				local pass = StoreCatalog.ProductByKey[StoreCatalog.StoryPassKey]
				if not pass or pass.id <= 0 then
					local cleared, flawless = storyCleared()
					local won, perfect = 0, 0
					for index = 1, #StoryRewards.Chapters do
						won += if cleared[index] then 1 else 0
						perfect += if flawless[index] then 1 else 0
					end
					label({
						Name = "Progress",
						Position = UDim2.fromOffset(0, cy),
						Size = UDim2.new(1, 0, 0, ch),
						Text = `VENCIDOS {won}/{#StoryRewards.Chapters} · SEM QUEDAS {perfect}/{#StoryRewards.Chapters}`,
						TextSize = 13,
						TextColor3 = Theme.TextSecondary,
						Parent = inner,
					})
				else
					button({
						Name = "StoryPass",
						Position = UDim2.fromOffset(0, cy),
						Size = UDim2.new(1, 0, 0, ch),
						Text = `PASSE DA HISTÓRIA · RECOMPENSAS x2 · R$ {pass.robux}`,
						TextSize = 13,
					}, function()
						buyProduct(StoreCatalog.StoryPassKey)
					end).Parent =
						inner
				end
			end
		end
	)
	modeCard(
		modes,
		2,
		columns,
		"Standard",
		"MODO DESAFIO",
		"MAIS UMA NOITE",
		"Casa, jardins e floresta: 8 capítulos com itens e passagens sorteados. 1–6 jogadores.",
		function(inner, cm)
			local ay, ah = slotY(cm, "A")
			Components.icon(inner, "Coin", 24, Theme.Coin, {
				Position = UDim2.fromOffset(0, ay + (ah - 24) // 2),
			})
			label({
				Position = UDim2.fromOffset(32, ay),
				Size = UDim2.new(1, -32, 0, ah),
				Text = "FICHAS E XP POR CAPÍTULO, FUGA E AJUDA AO TIME",
				TextSize = 13,
				TextColor3 = GREEN,
				Parent = inner,
			})
			local by, bh = slotY(cm, "B")
			label({
				Position = UDim2.fromOffset(32, by),
				Size = UDim2.new(1, -32, 0, bh),
				Text = "MOEDAS E FITAS VHS ESPALHADAS PELA CASA",
				TextSize = 12,
				TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextColor3 = Theme.TextSecondary,
				Parent = inner,
			})
			local cy, ch = slotY(cm, "C")
			local product = StoreCatalog.ProductByKey.bonus_duplo_3h
			local sellable = product ~= nil and product.id > 0
			local boost = label({
				Name = "Boost",
				Position = UDim2.fromOffset(0, cy),
				Size = UDim2.new(if sellable then 0.5 else 1, -4, 0, ch),
				Text = "",
				TextSize = 12,
				TextColor3 = Theme.Gold,
				Parent = inner,
			})
			table.insert(live, function()
				local now = workspace:GetServerTimeNow()
				local fichas = (tonumber(player:GetAttribute("BoostFichasUntil")) or 0) - now
				local xp = (tonumber(player:GetAttribute("BoostXpUntil")) or 0) - now
				local parts = {}
				if fichas > 0 then
					table.insert(parts, `FICHAS x2 · {clock(fichas)}`)
				end
				if xp > 0 then
					table.insert(parts, `XP x2 · {clock(xp)}`)
				end
				if player:GetAttribute("Vip") == true then
					table.insert(parts, "VIP x1,5")
				end
				boost.Text = px(if #parts > 0 then "ATIVO: " .. table.concat(parts, " · ") else "")
			end)
			if sellable then
				button({
					Name = "Boost",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, cy),
					Size = UDim2.new(0.5, -4, 0, ch),
					Text = `FICHAS E XP x2 · 3H · R$ {product.robux}`,
					TextSize = 12,
				}, function()
					buyProduct("bonus_duplo_3h")
				end).Parent =
					inner
			end
		end
	)
	local rowHeight = if compactMenu then 116 else 124
	local party = frame({
		Name = "Party",
		Size = UDim2.new(1, 0, 0, if columns == 2 then rowHeight else rowHeight * 2 + 12),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = scroll,
	})
	if columns == 2 then
		teamPanel(party, UDim2.new(), UDim2.new(0.56, -6, 1, 0))
		kitPanel(party, UDim2.new(0.56, 6, 0, 0), UDim2.new(0.44, -6, 1, 0))
	else
		teamPanel(party, UDim2.new(), UDim2.new(1, 0, 0, rowHeight))
		kitPanel(party, UDim2.fromOffset(0, rowHeight + 12), UDim2.new(1, 0, 0, rowHeight))
	end
	showcase(scroll, 3)
end

local TITLES: { [string]: { string } } = {
	play = {
		"ESCOLHA A CAMPANHA",
		`A maioria da equipe decide. Com {Config.Campaign.minPlayers} ou mais pessoas, a contagem começa.`,
	},
	perks = { "MELHORIAS E CONSUMÍVEIS", "Vantagens que valem em todas as partidas. Compre com Fichas ou Créditos." },
	servers = { "SERVIDORES", "Entre num lobby aberto ou numa partida com vaga." },
	friends = { "AMIGOS", "Entre no servidor de um amigo ou chame a equipe." },
}

local function renderTab()
	-- Redesenho por mudança de saldo/estoque (compra, mochila) mantém a rolagem da mesma aba.
	local keep: Vector2? = nil
	local previous = body
	if previous and previous:GetAttribute("Tab") == currentTab then
		local scroller = previous:FindFirstChildWhichIsA("ScrollingFrame")
		if scroller then
			keep = scroller.CanvasPosition
		end
	end
	local b = clearBody()
	if not b then
		return
	end
	b:SetAttribute("Tab", currentTab)
	local titles = TITLES[currentTab] or TITLES.play
	if header then
		header.Text = px(titles[1])
	end
	if subheader then
		subheader.Text = titles[2]
	end
	for id, nav in navButtons do
		local selected = id == currentTab
		-- No PC o JOGAR é sempre a ação principal; os demais destinos marcam a aba aberta.
		if id ~= "play" or compactMenu then
			Components.setVariant(nav, if selected then "secondary" elseif id == "play" then "primary" else "ghost")
		end
		local bar = nav:FindFirstChild("Bar")
		if bar and bar:IsA("Frame") then
			bar.Visible = selected
		end
	end
	if currentTab == "perks" then
		buildPerks(b)
	elseif currentTab == "servers" then
		buildServers(b)
	elseif currentTab == "friends" then
		buildFriends(b)
	else
		buildPlay(b)
	end
	local saved = keep
	if saved then
		local scroller = b:FindFirstChildWhichIsA("ScrollingFrame")
		if scroller then
			-- A lista nova mede o canvas no próximo quadro; aplica a posição depois disso.
			task.defer(function()
				scroller.CanvasPosition = saved
			end)
		end
		return
	end
	-- Entrada da aba: desliza 12 px.
	local top = bodyTop
	b.Position = UDim2.fromOffset(0, top + 12)
	TweenService:Create(b, TweenInfo.new(0.16, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(0, top) }):Play()
end

local function selectTab(id: TabId)
	if id == "settings" then
		Settings.toggleMenu()
		return
	end
	local storeTab = STORE_TABS[id]
	if storeTab then
		Store.openTab(storeTab)
		return
	end
	currentTab = id
	dirty = true
end

-- Só no Studio: atributo MenuViewportQA = "844x390" simula a tela de um celular (capturas de QA).
local qaViewport = ViewportQA.size

-- Selo de notificação: só quando há prêmio diário ou giro disponível de verdade.
local function dailyReady(): boolean
	return player:GetAttribute("DailyClaimable") == true or (tonumber(player:GetAttribute("SpinsLeft")) or 0) > 0
end

local function notifyDot(parent: Instance, position: UDim2): Frame
	local dot = Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
		Parent = parent,
	}) :: Frame
	Components.corner(dot, Theme.CornerPill)
	Components.stroke(dot, Theme.Overlay, 2, 0)
	table.insert(frameUpdates, function()
		dot.Visible = dailyReady()
	end)
	return dot
end

-- Barra superior: marca à esquerda; moedas, + Créditos e perfil (nível/XP) à direita.
local function topBar(root: Frame, mode: MenuLayout.Mode): number
	local compact = mode.compact
	local height = if mode.short then 46 elseif compact then 52 else 60
	local margin = if compact then 8 else 28
	local y = if compact then 6 else 20
	local bar = Create("Frame", {
		Name = "TopBar",
		Position = UDim2.fromOffset(margin, y),
		Size = UDim2.new(1, -2 * margin, 0, height),
		BackgroundTransparency = 1,
		Parent = root,
	})
	-- O "REC" da câmera de segurança já aparece atrás do menu (CinematicController); sem ponto duplicado.
	local brandY = if compact then 0 else -9
	local logo = Components.title({
		Name = "Logo",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, brandY),
		Size = UDim2.fromOffset(if compact then 210 else 440, 38),
		Text = "TUNG TUNG SAHUR",
		TextSize = if compact then 21 else 34,
		TextColor3 = Theme.GoldLight,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = bar,
	})
	logo.TextStrokeColor3 = Theme.Overlay
	logo.TextStrokeTransparency = 0.1
	if not compact then
		Components.text({
			Name = "Subtitle",
			Position = UDim2.new(0, 0, 0.5, 11),
			Size = UDim2.fromOffset(440, 18),
			Text = "THE CURSED HOUSE · EXPLORE, PEGUE MOEDAS E FUJA DO TUM TUM TUM",
			FontFace = Theme.Font,
			TextSize = 13,
			TextColor3 = Theme.TextSecondary,
			TextWrapped = false,
			Parent = bar,
		})
	end

	local status = Create("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.new(1, -240, 1, 0),
		BackgroundTransparency = 1,
		Parent = bar,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local badgeHeight = if compact then 38 else 40
	local badgeWidth = if compact then 100 else 140
	local _, setFichas = Components.currency("fichas", {
		Size = UDim2.fromOffset(badgeWidth, badgeHeight),
		LayoutOrder = 1,
		Parent = status,
	})
	local _, setCreditos = Components.currency("creditos", {
		Size = UDim2.fromOffset(badgeWidth, badgeHeight),
		LayoutOrder = 2,
		Parent = status,
	})
	Components.iconButton("success", "Plus", nil, {
		Name = "AddCredits",
		Size = UDim2.fromOffset(badgeHeight, badgeHeight),
		LayoutOrder = 3,
		Parent = status,
	}, function()
		click()
		Store.openTab("robux")
	end)

	local profileHeight = if compact then 40 else 48
	local avatar = profileHeight - 8
	local profile = Create("Frame", {
		Name = "Profile",
		Size = UDim2.fromOffset(if compact then 118 else 240, profileHeight),
		BackgroundColor3 = Theme.BgSunken,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		LayoutOrder = 4,
		Parent = status,
	})
	Components.corner(profile, Theme.CornerLarge)
	Components.stroke(profile, Theme.Gold, 1, 0.55)
	local face = Create("ImageLabel", {
		Name = "Avatar",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(avatar, avatar),
		BackgroundColor3 = Theme.BgElevated,
		BorderSizePixel = 0,
		Image = `rbxthumb://type=AvatarHeadShot&id={player.UserId}&w=150&h=150`,
		Parent = profile,
	})
	Components.corner(face, Theme.CornerPill)
	local textX = avatar + 12
	local nameLabel: TextLabel? = nil
	if not compact then
		nameLabel = Components.text({
			Name = "PlayerName",
			Position = UDim2.fromOffset(textX, 4),
			Size = UDim2.new(1, -(textX + 8), 0, 18),
			FontFace = Theme.Font,
			TextSize = 15,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = player.DisplayName,
			Parent = profile,
		})
	end
	local levelLabel = Components.text({
		Name = "Level",
		Position = UDim2.fromOffset(textX, if compact then 3 else 22),
		Size = UDim2.new(1, -(textX + 8), 0, 16),
		FontFace = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Gold,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		Parent = profile,
	})
	local xpTrack, setXp = Components.progress({
		Name = "Xp",
		Position = UDim2.new(0, textX, 1, -12),
		Size = UDim2.new(1, -(textX + 10), 0, 6),
	}, GREEN)
	xpTrack.Parent = profile
	table.insert(frameUpdates, function()
		setFichas(tonumber(player:GetAttribute("Fichas")) or 0)
		setCreditos(tonumber(player:GetAttribute("Creditos")) or 0)
		local xp = tonumber(player:GetAttribute("Xp")) or 0
		local level, into, needed = Economy.levelInfo(xp)
		levelLabel.Text =
			px(if compact then `NÍVEL {level}` else `NÍVEL {level} · {number(into)}/{number(needed)} XP`)
		setXp(into / math.max(needed, 1))
		local nameText = nameLabel
		if nameText then
			local titleId = player:GetAttribute("Title")
			local titleItem = if type(titleId) == "string" then StoreCatalog.ItemById[titleId] else nil
			local suffix = (if titleItem then ` · {titleItem.name}` else "")
				.. (if player:GetAttribute("Vip") == true then " · VIP" else "")
			nameText.Text = player.DisplayName .. suffix
		end
	end)
	return y + height
end

-- Trilho do PC: JOGAR em destaque e os demais destinos com ícone e rótulo.
local function desktopRail(root: Frame, top: number): number
	local width = 248
	local rail = Create("Frame", {
		Name = "Rail",
		Position = UDim2.fromOffset(28, top),
		Size = UDim2.new(0, width, 1, -(top + 28)),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, item in NAV do
		local isPlay = item.id == "play"
		local nav = Components.iconButton(if isPlay then "primary" else "ghost", item.icon, item.label, {
			Name = `Nav_{item.id}`,
			LayoutOrder = i * 10,
			Size = UDim2.new(1, 0, 0, if isPlay then 60 else 46),
			TextSize = if isPlay then 26 else 18,
			Parent = rail,
		}, function()
			click()
			selectTab(item.id)
		end)
		if not isPlay then
			Create("Frame", {
				Name = "Bar",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.new(0, 4, 0.6, 0),
				BackgroundColor3 = Theme.Gold,
				BorderSizePixel = 0,
				Visible = false,
				Parent = nav,
			})
		end
		if STORE_TABS[item.id] or item.id == "settings" then
			-- Abre outra janela (loja/ajustes): seta discreta deixa isso claro antes do clique.
			Components.text({
				Name = "Opens",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(16, 20),
				Text = "›",
				TextSize = 22,
				TextColor3 = Theme.TextMuted,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = nav,
			})
		end
		if item.id == "daily" then
			notifyDot(nav, UDim2.new(1, -38, 0.5, 0))
		end
		if isPlay then
			Create("Frame", {
				Name = "Spacer",
				Size = UDim2.new(1, 0, 0, 6),
				BackgroundTransparency = 1,
				LayoutOrder = 15,
				Parent = rail,
			})
		end
		navButtons[item.id] = nav
	end
	return 28 + width + 20
end

-- Peça do trilho compacto: ícone em cima, rótulo curto embaixo (alvo de toque >= 52 px).
local function railTile(
	parent: Instance,
	id: string,
	text: string,
	icon: string,
	order: number,
	height: number,
	onClick: () -> ()
): TextButton
	local tile = Components.button(if id == "play" then "primary" else "ghost", {
		Name = `Nav_{id}`,
		Text = "",
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, height),
		Parent = parent,
	}, function()
		click()
		onClick()
	end)
	Components.icon(tile, icon, 24, tile.TextColor3, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, if height < 56 then 6 else 8),
	})
	local caption = Components.text({
		Name = "Label",
		Position = UDim2.new(0, 2, 1, -20),
		Size = UDim2.new(1, -4, 0, 16),
		Text = text,
		FontFace = Theme.Font,
		TextSize = 11,
		TextColor3 = tile.TextColor3,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = tile,
	})
	tile:GetPropertyChangedSignal("TextColor3"):Connect(function()
		caption.TextColor3 = tile.TextColor3
	end)
	return tile
end

-- Trilho do celular: 4 destinos + MAIS (prêmio diário, servidores, amigos, ajustes num menu curto).
local function compactRail(root: Frame, top: number, mode: MenuLayout.Mode): number
	local width = 76
	local rail = Create("ScrollingFrame", {
		Name = "Rail",
		Position = UDim2.fromOffset(8, top),
		Size = UDim2.new(0, width, 1, -(top + 8)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = root,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local height = if mode.short then 52 else 58
	local visible, overflow = MenuLayout.split(NAV, true)
	for i, item in visible do
		navButtons[item.id] = railTile(rail, item.id, item.short, item.icon, i, height, function()
			selectTab(item.id)
		end)
	end
	-- Fundo que fecha o MAIS ao tocar fora; o menu fica ao lado do trilho, acima do painel.
	local catcher = Create("TextButton", {
		Name = "MoreCatcher",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Overlay,
		BackgroundTransparency = 0.6,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 20,
		Parent = root,
	}) :: TextButton
	local itemHeight = Theme.TouchMin
	local popover = Components.panel({
		Name = "More",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8 + width + 8, 1, -8),
		Size = UDim2.fromOffset(240, #overflow * (itemHeight + 6) + 18),
		BackgroundColor3 = Theme.BgPanel,
		BackgroundTransparency = 0,
		Visible = false,
		ZIndex = 21,
		Parent = root,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Components.padding(popover, 9)
	local function setMore(open: boolean)
		popover.Visible = open
		catcher.Visible = open
	end
	catcher.Activated:Connect(function()
		setMore(false)
	end)
	for i, item in overflow do
		local entry = Components.iconButton("ghost", item.icon, item.label, {
			Name = `More_{item.id}`,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, itemHeight),
			TextSize = 16,
			ZIndex = 22,
			Parent = popover,
		}, function()
			click()
			setMore(false)
			selectTab(item.id)
		end)
		for _, child in entry:GetDescendants() do
			if child:IsA("GuiObject") then
				child.ZIndex = 22
			end
		end
		if item.id == "daily" then
			notifyDot(entry, UDim2.new(1, -16, 0.5, 0)).ZIndex = 23
		end
	end
	local more = railTile(rail, "more", "MAIS", "More", #visible + 1, height, function()
		setMore(not popover.Visible)
	end)
	notifyDot(more, UDim2.new(1, -12, 0, 12))
	return 8 + width + 8
end

local function build(mode: MenuLayout.Mode): ScreenGui
	frameUpdates = {}
	navButtons = {}
	compactMenu = mode.compact
	local screen = Create("ScreenGui", {
		Name = "MainMenu",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		DisplayOrder = 200,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}) :: ScreenGui
	screen:SetAttribute("Layout", mode.key)
	local safe = frame({ Name = "SafeArea", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = screen })
	local qaWidth, qaHeight = qaViewport()
	if qaWidth and qaHeight then
		-- QA no Studio: simula a tela de um aparelho no centro da janela, com moldura visível.
		safe.AnchorPoint, safe.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
		safe.Size, safe.ClipsDescendants = UDim2.fromOffset(qaWidth, qaHeight), true
		Components.stroke(safe, Theme.Danger, 2, 0)
	end
	local root = frame({
		Name = "Root",
		Size = UDim2.fromScale(1 / mode.scale, 1 / mode.scale),
		BackgroundTransparency = 1,
		Parent = safe,
	})
	rootFrame = root
	rootScale = Create("UIScale", { Scale = mode.scale, Parent = root }) :: UIScale
	-- Véu: escuro à esquerda (leitura), aberto à direita (as câmeras da casa aparecem atrás).
	Create("Frame", {
		Name = "Veil",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = VEIL,
		BorderSizePixel = 0,
		Parent = root,
	}, {
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.05),
				NumberSequenceKeypoint.new(0.35, 0.25),
				NumberSequenceKeypoint.new(1, 0.5),
			}),
		}),
	})

	local top = topBar(root, mode) + (if mode.compact then 6 else 20)
	local left = if mode.compact then compactRail(root, top, mode) else desktopRail(root, top)
	local margin = if mode.compact then 8 else 28

	local right = Components.panel({
		Name = "Content",
		Position = UDim2.fromOffset(left, top),
		Size = UDim2.new(1, -(left + margin), 1, -(top + margin)),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.12,
		Parent = root,
	})
	local rightCorner = right:FindFirstChildOfClass("UICorner")
	if rightCorner then
		rightCorner.CornerRadius = Theme.CornerLarge
	end
	local padX = if mode.compact then 10 else 20
	local padY = if mode.compact then 8 else 16
	Components.padding(right, padX, padY)
	header = Components.title({
		Name = "Header",
		Size = UDim2.new(1, 0, 0, if mode.compact then 26 else 32),
		Text = "",
		TextSize = if mode.compact then 20 else 28,
		Parent = right,
	})
	subheader = note({
		Name = "Subheader",
		Position = UDim2.fromOffset(0, if mode.compact then 28 else 36),
		Size = UDim2.new(1, 0, 0, if mode.compact then 18 else 22),
		Text = "",
		TextSize = if mode.compact then 13 else 15,
		Visible = not mode.short,
		Parent = right,
	})
	bodyTop = if mode.short then 32 elseif mode.compact then 52 else 66
	local footer = if mode.compact then 0 else 28
	body = frame({
		Name = "Body",
		Position = UDim2.fromOffset(0, bodyTop),
		Size = UDim2.new(1, 0, 1, -(bodyTop + footer)),
		BackgroundTransparency = 1,
		Parent = right,
	})
	if not mode.compact then
		local tip = label({
			Name = "Tip",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, -440, 0, 20),
			Text = "",
			TextSize = Theme.SizeSmall,
			TextColor3 = Theme.TextMuted,
			Parent = right,
		})
		tip.TextWrapped, tip.TextTruncate = false, Enum.TextTruncate.AtEnd
		local tipClock = 0
		table.insert(frameUpdates, function(dt)
			tipClock += dt
			if tipClock > 6 or tip.Text == "" then
				tipClock = 0
				tipIndex = tipIndex % #TIPS + 1
				tip.Text = px("DICA: " .. TIPS[tipIndex])
			end
		end)
	end
	-- Aviso curto de resultado (compra, erro, voto). No celular fica sobre a base do painel.
	feedback = label({
		Name = "Feedback",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = if mode.compact then UDim2.new(1, 0, 0, 34) else UDim2.fromOffset(420, 22),
		Text = "",
		TextSize = if mode.compact then 14 else Theme.SizeSmall,
		TextColor3 = GREEN,
		TextXAlignment = if mode.compact then Enum.TextXAlignment.Center else Enum.TextXAlignment.Right,
		BackgroundColor3 = Theme.BgSunken,
		BackgroundTransparency = if mode.compact then 0.08 else 1,
		Visible = false,
		ZIndex = 5,
		Parent = right,
	})
	if mode.compact then
		local f = feedback :: TextLabel
		Components.corner(f, Theme.CornerSmall)
	end
	screen.Parent = player:WaitForChild("PlayerGui")
	return screen
end

-- Classe de layout pela viewport da câmera: não depende da GUI recém-criada (sem medir 0 no
-- primeiro quadro e reconstruir em laço). As margens seguras ficam com o ScreenInsets.
local function currentMode(): MenuLayout.Mode
	local qaWidth, qaHeight = qaViewport()
	if qaWidth and qaHeight then
		local mode = MenuLayout.mode(qaWidth, qaHeight, true)
		mode.key ..= `@{qaWidth}x{qaHeight}`
		return mode
	end
	local size = workspace.CurrentCamera.ViewportSize
	return MenuLayout.mode(size.X, size.Y, UserInputService.TouchEnabled)
end

-- ===================== Ciclo =====================

function Controller.debugState(): { [string]: any }
	return {
		open = gui ~= nil and gui.Enabled,
		tab = currentTab,
		servers = serverCache ~= nil,
		friends = friendsCache ~= nil,
	}
end

-- Para QA: troca a aba como um clique faria.
function Controller.select(id: string)
	selectTab(id :: TabId)
end

function Controller.Start()
	if GameState.wait():GetAttribute("CampaignActive") ~= true then
		return
	end
	local state = ReplicatedStorage:WaitForChild("CampaignState")
	menuMode = currentMode()
	gui = build(menuMode :: MenuLayout.Mode)
	-- Qualquer mudança de saldo, estoque, nível ou voto redesenha a aba (no máximo uma vez por quadro).
	for _, name in
		{
			"Fichas",
			"Creditos",
			"Perks",
			"Consumables",
			"Loadout",
			"StoryProgress",
			"StoryPass",
			"Vip",
		}
	do
		player:GetAttributeChangedSignal(name):Connect(function()
			dirty = true
		end)
	end
	-- QA (harness da campanha): vota pelo atributo ModeQARequest, como o menu antigo.
	if RunService:IsStudio() then
		local ok, args = pcall(function()
			return game:GetService("StudioTestService"):GetTestArgs()
		end)
		if ok and type(args) == "table" and args.modeMenuQA then
			local function qaVote()
				local command = player:GetAttribute("ModeQARequest")
				local mode = if type(command) == "string" then string.match(command, "^([%a]+):%d+$") else nil
				if mode == "Story" or mode == "Standard" then
					task.spawn(function()
						Remotes.clientFunction("SelectGameMode"):InvokeServer(mode)
					end)
				end
			end
			player:GetAttributeChangedSignal("ModeQARequest"):Connect(qaVote)
			qaVote()
		end
		-- QA de layout/fluxo sem foco de janela: "tab:perks" | "confirm:x" (toca CONFIRMAR no diálogo).
		player:GetAttributeChangedSignal("MenuQARequest"):Connect(function()
			local raw = player:GetAttribute("MenuQARequest")
			if type(raw) ~= "string" then
				return
			end
			local command, arg = string.match(raw, "^(%a+):([%w_]+)$")
			if command == "tab" and arg then
				selectTab(arg :: TabId)
			elseif command == "confirm" then
				local run = pendingConfirm
				if run then
					run()
				end
			end
		end)
	end
	RunService:BindToRenderStep("S9MainMenu", Enum.RenderPriority.Last.Value, function(dt: number)
		local screen = gui
		if not screen then
			return
		end
		local open = state:GetAttribute("Phase") == "Lobby" and player:GetAttribute("OpeningActive") ~= true
		player:SetAttribute("ModeMenuOpen", open)
		if open then
			-- Troca de classe (PC ↔ celular ↔ celular baixo) reconstrói a moldura; só escala, ajusta.
			local mode = currentMode()
			local current = menuMode
			if not current or mode.key ~= current.key then
				menuMode = mode
				local rebuilt = build(mode)
				screen:Destroy()
				gui, screen = rebuilt, rebuilt
				dirty = true
			elseif math.abs(mode.scale - current.scale) > 0.005 then
				menuMode = mode
				local root, scale = rootFrame, rootScale
				if root and scale then
					scale.Scale = mode.scale
					root.Size = UDim2.fromScale(1 / mode.scale, 1 / mode.scale)
				end
			end
			local b = body
			if b and currentTab == "play" and b.AbsoluteSize.X > 0 then
				if MenuLayout.columns(b.AbsoluteSize.X) ~= columnsShown then
					dirty = true
				end
			end
		end
		-- A loja abre por cima: o menu some enquanto ela estiver aberta.
		screen.Enabled = open and not Store.isOpen()
		if open and not wasOpen then
			Cinema.stop()
			currentTab = "play"
			dirty = true
		end
		if open then
			if not Store.isOpen() then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
			end
			if dirty then
				dirty = false
				renderTab()
			end
			for _, update in live do
				update()
			end
			for _, update in frameUpdates do
				update(dt)
			end
		elseif wasOpen then
			UserInputService.MouseIconEnabled = false
		end
		wasOpen = open
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="341">
          <Properties>
            <string name="Name">RainController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Chuva só no cliente (não toca em regra de jogo nem replica nada):
	- gotas em volta da câmera, iluminadas pelas luzes do cenário, que param sob qualquer telhado;
	- respingos no chão logo abaixo da câmera;
	- som de chuva (abafado dentro de casa) e trovões distantes;
	- relâmpago raro, só com a opção de flashes ligada (conforto visual).
	A quantidade de gotas segue a qualidade visual escolhida; em Baixa ainda chove, com menos gotas.
]]
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Weather = require("@game/ReplicatedStorage/Shared/Game/Weather")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local AudioController = require("./AudioController")
local Settings = require("./SettingsController")

local STREAK = "rbxassetid://90203797622509"
local SPLASH = "rbxassetid://131263262987295"

local controller = { Name = "RainController" }

-- Grade 3 × 2 de células de 24 studs, centrada um pouco à frente do olhar e 30 studs acima.
local CELL = 24
local CELLS = {
	Vector3.new(-24, 0, -12),
	Vector3.new(0, 0, -12),
	Vector3.new(24, 0, -12),
	Vector3.new(-24, 0, 12),
	Vector3.new(0, 0, 12),
	Vector3.new(24, 0, 12),
}
type Cell = { part: BasePart, emitter: ParticleEmitter, offset: Vector3 }
local cells: { Cell } = {}
local splashes: ParticleEmitter? = nil
local floor: BasePart? = nil
local sound: Sound? = nil
local muffle: EqualizerSoundEffect? = nil
local flashFx: ColorCorrectionEffect? = nil
local outdoor = 1
local outdoorTarget = 1
local groundY = 0
local nextStrike = 0
local strikeAt = -100
local rng = Random.new()

local function holder(name: string, size: Vector3): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
	part.Transparency = 1
	part.Size = size
	part.CastShadow = false
	return part
end

-- Telhado acima da câmera (casa, varanda, pavilhões) e chão abaixo dela.
local function probe(position: Vector3)
	local world = workspace:FindFirstChild(Tags.WorldFolder)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = if world then { world } else {}
	params.RespectCanCollide = true
	local roof = workspace:Raycast(position, Vector3.new(0, 80, 0), params)
	outdoorTarget = if roof then 0 else 1
	local below = workspace:Raycast(position + Vector3.new(0, 1, 0), Vector3.new(0, -40, 0), params)
	groundY = if below then below.Position.Y else position.Y - 5
end

local function strike(now: number)
	strikeAt = now
	nextStrike = now + Weather.strikeInterval(rng:NextNumber())
	task.delay(Weather.thunderDelay(rng:NextNumber()), function()
		local thunder = AudioController.play("AmbThunder", 0.55 + outdoor * 0.45)
		-- O arquivo tem vários estrondos: cada trovão começa num trecho diferente e some em 9 s.
		thunder.TimePosition = rng:NextNumber(0, 90)
		task.delay(9, function()
			if thunder.Parent then
				thunder:Stop()
				thunder:Destroy()
			end
		end)
	end)
end

function controller.debugState(): { [string]: any }
	return {
		outdoor = outdoor,
		rate = if cells[1] then cells[1].emitter.Rate * #cells else 0,
		splash = splashes and splashes.Rate,
		volume = sound and sound.Volume,
		nextStrike = nextStrike,
	}
end

-- Ponte de QA no Studio: força um relâmpago agora.
function controller.strikeNow()
	strike(os.clock())
end

function controller.Init()
	local folder = Instance.new("Folder")
	folder.Name = "ClientWeather"
	folder.Parent = workspace
	-- Várias células pequenas: um emissor só, numa área grande, fica ralo (o motor limita partículas por emissor).
	for index, offset in CELLS do
		local cell = holder("RainCell" .. index, Vector3.new(CELL, 1, CELL))
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Drops"
		emitter.Texture = STREAK
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
		emitter.Speed = NumberRange.new(75, 90)
		emitter.Lifetime = NumberRange.new(0.55, 0.65)
		emitter.SpreadAngle = Vector2.new(3, 3)
		emitter.Acceleration = Vector3.new(4, 0, 1.5) -- vento leve inclina as gotas
		emitter.Size = NumberSequence.new(1.1)
		emitter.Squash = NumberSequence.new(2.2) -- positivo = gota alta e fina
		emitter.Transparency = NumberSequence.new(0.35)
		emitter.Color = ColorSequence.new(Color3.fromRGB(205, 214, 230))
		emitter.LightInfluence = 0.25
		emitter.LightEmission = 0.6
		emitter.Rate = 0
		emitter.Parent = cell
		cell.Parent = folder
		table.insert(cells, { part = cell, emitter = emitter, offset = offset })
	end
	local bottom = holder("RainFloor", Vector3.new(44, 0.2, 44))
	local splash = Instance.new("ParticleEmitter")
	splash.Name = "Splashes"
	splash.Texture = SPLASH
	splash.EmissionDirection = Enum.NormalId.Top
	splash.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
	splash.Speed = NumberRange.new(0.05)
	splash.Lifetime = NumberRange.new(0.22, 0.32)
	splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 0.85) })
	splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	splash.Color = ColorSequence.new(Color3.fromRGB(205, 214, 230))
	splash.LightInfluence = 1
	splash.Rate = 0
	splash.Parent = bottom
	bottom.Parent = folder
	splashes, floor = splash, bottom
	local fx = Instance.new("ColorCorrectionEffect")
	fx.Name = "RainLightning"
	fx.TintColor = Color3.fromRGB(214, 226, 255)
	fx.Enabled = false
	fx.Parent = Lighting
	flashFx = fx
end

function controller.Start()
	local rain = AudioController.loopAt("AmbRain", SoundService)
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "RainMuffle"
	eq.LowGain, eq.MidGain, eq.HighGain = 0, 0, 0
	eq.Parent = rain
	rain:Play()
	sound, muffle = rain, eq
	local base = rain.Volume
	nextStrike = os.clock() + Weather.strikeInterval(rng:NextNumber())
	local probeClock = 1
	RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local now = os.clock()
		local eye = camera.CFrame.Position
		probeClock += dt
		if probeClock >= 0.25 then
			probeClock = 0
			probe(eye)
		end
		outdoor += (outdoorTarget - outdoor) * math.min(1, dt * 4)
		-- A nuvem anda com a câmera e um pouco à frente: a maioria das gotas cai onde se olha.
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local ahead = if flat.Magnitude > 0.01 then flat.Unit * 14 else Vector3.zero
		local budget = Settings.visualBudget().particles
		local gust = Weather.gust(now)
		local open = if outdoorTarget > 0.5 then 1 else 0
		local perCell = Weather.rate(Weather.RainRate, budget, open, gust) / #CELLS
		for _, cell in cells do
			cell.part.CFrame = CFrame.new(eye + ahead + Vector3.new(0, 30, 0) + cell.offset)
			cell.emitter.Rate = perCell
		end
		if floor then
			floor.CFrame = CFrame.new(eye.X + ahead.X, groundY + 0.15, eye.Z + ahead.Z)
		end
		if splashes then
			splashes.Rate = Weather.rate(Weather.SplashRate, budget, open, gust)
		end
		if sound then
			sound.Volume = base * Weather.volume(outdoor) * (0.85 + 0.15 * gust)
		end
		if muffle then
			muffle.HighGain = -28 * (1 - outdoor)
			muffle.MidGain = -8 * (1 - outdoor)
		end
		if now >= nextStrike then
			strike(now)
		end
		local fx = flashFx
		if fx then
			local amount = if Settings.get("flashes") then Weather.flash(now - strikeAt) else 0
			fx.Enabled = amount > 0
			fx.Brightness = amount * Weather.FlashPeak * (0.3 + 0.7 * outdoor)
		end
	end)
end

return controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="342">
          <Properties>
            <string name="Name">RetroFxController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	"Filtro retrô" (o Roblox não tem shader de tela nem pixelização de render, validado):
	- Gradação, bloom e exposição são compostos somente pelo LightingController.
	- Sobreposição 2D (scanlines, vinheta, granulação animada a 12 quadros/s e uma "linha de
	  tracking" ocasional): liga/desliga com V (conforto).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local SettingsController = require("./SettingsController")
local FearController = require("./FearController")

local E = Config.Effects
local player = Players.LocalPlayer

local overlay: ScreenGui? = nil
local scanlines: Frame? = nil
local grain: { Frame } = {}
local tracking: Frame? = nil
local lastHeight = 0
local rng = Random.new()

local function buildScanlines(container: Frame, height: number)
	container:ClearAllChildren()
	local spacing = E.ScanlineSpacing
	for y = 0, height, spacing do
		local line = Instance.new("Frame")
		line.BorderSizePixel = 0
		line.BackgroundColor3 = Color3.new(0, 0, 0)
		line.BackgroundTransparency = E.ScanlineTransparency
		line.Position = UDim2.fromOffset(0, y)
		line.Size = UDim2.new(1, 0, 0, 1)
		line.Parent = container
	end
end

local function edge(parent: Instance, anchor: Vector2, position: UDim2, size: UDim2, rotation: number)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.new(0, 0, 0)
	f.BackgroundTransparency = 0.36
	f.AnchorPoint = anchor
	f.Position = position
	f.Size = size
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = f
	f.Parent = parent
end

local function buildOverlay(): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "RetroOverlay"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.Enabled = SettingsController.get("retro")

	-- Vinheta (4 bordas com gradiente).
	edge(gui, Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.16, 1), 0)
	edge(gui, Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.16, 1), 180)
	edge(gui, Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.14), 90)
	edge(gui, Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.14), 270)

	local lines = Instance.new("Frame")
	lines.Name = "Scanlines"
	lines.BackgroundTransparency = 1
	lines.Size = UDim2.fromScale(1, 1)
	lines.Parent = gui
	scanlines = lines

	for _ = 1, E.GrainDots do
		local dot = Instance.new("Frame")
		dot.BorderSizePixel = 0
		dot.Size = UDim2.fromOffset(2, 2)
		dot.Parent = gui
		table.insert(grain, dot)
	end

	local track = Instance.new("Frame")
	track.Name = "Tracking"
	track.BorderSizePixel = 0
	track.BackgroundColor3 = Color3.new(1, 1, 1)
	track.BackgroundTransparency = 0.93
	track.Size = UDim2.new(1, 0, 0, 3)
	track.Visible = false
	track.Parent = gui
	tracking = track

	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

local RetroFxController = {
	Name = "RetroFxController",
}

function RetroFxController.Init()
	overlay = buildOverlay()
end

function RetroFxController.Start()
	SettingsController.onChanged(function(key, value)
		if key == "retro" and overlay then
			overlay.Enabled = value
		end
	end)

	local accumulator = 0
	local trackingY = -10
	RunService.RenderStepped:Connect(function(dt: number)
		local gui = overlay
		local camera = workspace.CurrentCamera
		if not gui or not gui.Enabled or not camera then
			return
		end
		local height = math.floor(camera.ViewportSize.Y)
		if height ~= lastHeight and scanlines then
			lastHeight = height
			buildScanlines(scanlines, height)
		end
		accumulator += dt
		if accumulator < 1 / Config.Visual.FlickerRate then
			return
		end
		accumulator = 0
		-- Granulação em passos (12 quadros/s).
		local budget = SettingsController.visualBudget()
		for index, dot in grain do
			dot.Visible = index <= math.floor(#grain * budget.grain)
			if not dot.Visible then
				continue
			end
			dot.Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber())
			local light = rng:NextNumber() < 0.5
			dot.BackgroundColor3 = if light then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
			dot.BackgroundTransparency = math.clamp(rng:NextNumber(0.88, 0.98) - FearController.get() * 0.06, 0.8, 1)
		end
		-- Linha de tracking de VHS descendo de vez em quando.
		local track = tracking
		if track then
			if trackingY < 0 and rng:NextNumber() < 0.01 then
				trackingY = 0
			end
			if trackingY >= 0 then
				trackingY += 0.06
				track.Visible = false -- tracking VHS pertence ao ScreenFxController
				track.Position = UDim2.fromScale(0, trackingY)
				if trackingY > 1 then
					trackingY = -10
				end
			end
		end
	end)
end

return RetroFxController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="343">
          <Properties>
            <string name="Name">ScreenFxController</string>
            <string name="Source"><![CDATA[--!strict
-- Efeitos locais limitados; HUD de campanha fica acima (DisplayOrder 60).
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local PixelText = require("@game/ReplicatedStorage/Shared/Game/PixelText")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local Create = require("../UI/Create")
local FearController = require("./FearController")
local SettingsController = require("./SettingsController")
local LightingController = require("./LightingController")

local player = Players.LocalPlayer
local snapshot: GameState.Snapshot? = nil
local edges: { Frame } = {}
local bands: { Frame } = {}
local overlay: ScreenGui? = nil
local impact: Frame? = nil
local puzzlePulse: Frame? = nil
local pulseAt = -math.huge
local stamp: TextLabel? = nil
local tracking: Frame? = nil
local blur: BlurEffect? = nil
local baseFog = Lighting.FogEnd
local captureAt = -math.huge
local clock = 0
local lastEffects: { [string]: number } = {}
local rng = Random.new()

local ScreenFxController = { Name = "ScreenFxController" }

function ScreenFxController.capture()
	captureAt = os.clock()
end

function ScreenFxController.pulse(color: Color3)
	if puzzlePulse and SettingsController.get("flashes") then
		puzzlePulse.BackgroundColor3 = color
		pulseAt = os.clock()
	end
end

function ScreenFxController.reset()
	captureAt = -math.huge
	pulseAt = -math.huge
	if puzzlePulse then
		puzzlePulse.Visible = false
	end
	LightingController.setDanger(0)
	if blur then
		blur.Size = 0
	end
end

function ScreenFxController.debugState(): { [string]: any }
	return {
		effects = table.clone(lastEffects),
		blur = if blur then blur.Size else 0,
		fog = Lighting.FogEnd,
		baseFog = baseFog,
		impact = if impact then impact.Visible else false,
		puzzlePulse = if puzzlePulse then puzzlePulse.Visible else false,
		vhs = if stamp then stamp.Visible else false,
		bands = #bands,
	}
end

function ScreenFxController.Init()
	local initialFog = Lighting:GetAttribute("BaseFogEnd")
	baseFog = if type(initialFog) == "number" then initialFog else Lighting.FogEnd
	local gui = Create("ScreenGui", {
		Name = "FearOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 55,
		Parent = player:WaitForChild("PlayerGui"),
	}) :: ScreenGui
	overlay = gui
	local definitions: { { anchor: Vector2, position: UDim2, size: UDim2, rotation: number } } = {
		{ anchor = Vector2.new(0, 0), position = UDim2.fromScale(0, 0), size = UDim2.fromScale(0.22, 1), rotation = 0 },
		{
			anchor = Vector2.new(1, 0),
			position = UDim2.fromScale(1, 0),
			size = UDim2.fromScale(0.22, 1),
			rotation = 180,
		},
		{
			anchor = Vector2.new(0, 0),
			position = UDim2.fromScale(0, 0),
			size = UDim2.fromScale(1, 0.22),
			rotation = 90,
		},
		{
			anchor = Vector2.new(0, 1),
			position = UDim2.fromScale(0, 1),
			size = UDim2.fromScale(1, 0.22),
			rotation = 270,
		},
	}
	for i, definition in definitions do
		local edge = Create("Frame", {
			Name = `FearEdge{i}`,
			AnchorPoint = definition.anchor,
			Position = definition.position,
			Size = definition.size,
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			Parent = gui,
		}, { Create("UIGradient", { Rotation = definition.rotation, Transparency = NumberSequence.new(0, 1) }) }) :: Frame
		table.insert(edges, edge)
	end
	-- Faixas translúcidas aproximam deslocamento/chroma; não são um shader de tela.
	for i = 1, 6 do
		local band = Create("Frame", {
			Name = `Glitch{i}`,
			BorderSizePixel = 0,
			BackgroundTransparency = 0.92,
			Visible = false,
			BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(160, 30, 30) else Color3.fromRGB(30, 160, 180),
			Size = UDim2.new(1, 4, 0, 3),
			Parent = gui,
		}) :: Frame
		table.insert(bands, band)
	end
	stamp = Create("TextLabel", {
		Name = "VHS",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 1, -30),
		Size = UDim2.fromOffset(330, 20),
		TextSize = 15,
		Font = Enum.Font.Code,
		TextColor3 = Color3.fromRGB(180, 190, 175),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Visible = false,
		Parent = gui,
	}) :: TextLabel
	tracking = Create("Frame", {
		Name = "Tracking",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.96,
		Size = UDim2.new(1, 0, 0, 2),
		Visible = false,
		Parent = gui,
	}) :: Frame
	impact = Create("Frame", {
		Name = "CaptureImpact",
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	}) :: Frame
	puzzlePulse = Create("Frame", {
		Name = "PuzzlePulse",
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = gui,
	}) :: Frame
	blur = Create("BlurEffect", { Name = "PanicBlur", Size = 0, Parent = Lighting }) :: BlurEffect
end

function ScreenFxController.Start()
	GameState.observe(function(next)
		local previous = snapshot
		snapshot = next
		if previous and next.roundId ~= previous.roundId then
			ScreenFxController.reset()
		end
	end)
	Lighting:GetAttributeChangedSignal("BaseFogEnd"):Connect(function()
		local value = Lighting:GetAttribute("BaseFogEnd")
		if type(value) == "number" then
			baseFog = value
		end
	end)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		clock += dt
		if accumulator < 1 / 12 then
			return
		end
		accumulator = 0
		local s = snapshot
		if not s or not overlay then
			return
		end
		local playing = Presentation.playing(s.phase, player:GetAttribute("CampaignStatus") :: string?)
		local flashes = SettingsController.get("flashes")
		if puzzlePulse then
			local age = os.clock() - pulseAt
			puzzlePulse.Visible = playing and flashes and age < 0.3
			puzzlePulse.BackgroundTransparency = math.clamp(0.8 + age / 0.3 * 0.2, 0.8, 1)
		end
		local fx = Presentation.effects(FearController.get(), playing, flashes, SettingsController.get("retro"))
		lastEffects = fx
		for _, edge in edges do
			edge.BackgroundTransparency = 1 - fx.vignette
		end
		if blur then
			blur.Size = fx.blur
		end
		LightingController.setDanger(fx.fog)
		local elapsed = os.clock() - captureAt
		local captured = flashes and elapsed < 0.15
		local glitch = math.max(fx.glitch, if flashes and elapsed < 0.8 then 1 - elapsed / 0.8 else 0)
		for _, band in bands do
			band.Visible = glitch > 0 and rng:NextNumber() < glitch * 0.45
			band.Position = UDim2.new(0, rng:NextInteger(-3, 3), rng:NextNumber(), 0)
		end
		if impact then
			impact.Visible = captured
			impact.BackgroundTransparency = if captured then 0.45 + elapsed / 0.15 * 0.55 else 1
			impact.BackgroundColor3 = if elapsed < 0.05 then Color3.new(1, 1, 1) else Color3.fromRGB(150, 15, 15)
		end
		local vhs = SettingsController.get("vhs") and playing
		if stamp then
			stamp.Visible = vhs
			local seconds = math.max(0, math.floor(workspace:GetServerTimeNow() - s.roundStartedAt))
			stamp.Text = PixelText.normalize(
				string.format("> PLAY %02d:%02d 15 OUT 1999", math.floor(seconds / 60), seconds % 60)
			)
		end
		if tracking then
			tracking.Visible = vhs and clock % 11 < 1
			tracking.Position = UDim2.fromScale(0, clock % 1)
		end
	end)
end

return ScreenFxController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="344">
          <Properties>
            <string name="Name">SettingsController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Opções de conforto do jogador (só no cliente, por sessão). Valores iniciais em Config.Comfort.
	  retro    scanlines, granulação, vinheta fixa            (atalho V)
	  vhs      carimbo de hora, tracking, aberração cromática
	  bob      balanço ao andar e respiração parada           (atalho B liga/desliga bob+tilt+shake)
	  tilt     inclinação lateral
	  shake    tremores
	  fov      FOV dinâmico (corrida, medo, susto)
	  flashes  clarões e falhas de tela fortes
	  haptics  vibração do controle
	O menu (tecla O) fica no GameUiController; os outros controllers leem com get().
]]

local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local HttpService = game:GetService("HttpService")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Components = require("../UI/Components")
local Create = require("../UI/Create")
local Theme = require("../UI/Theme")
local Quality = require("@game/ReplicatedStorage/Shared/Game/VisualQuality")
local Preferences = require("@game/ReplicatedStorage/Shared/Game/HousePreferences")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local log = Logger.new("VisualQA")

export type Key = "retro" | "vhs" | "bob" | "tilt" | "shake" | "fov" | "flashes" | "haptics"

-- Ordem do menu.
local KEYS: { Key } = { "bob", "tilt", "shake", "fov", "flashes", "retro", "vhs", "haptics" }

-- Tabela "aberta" (chave dinâmica): o tipo Key garante as chaves válidas na API.
local values: { [string]: boolean } = {}
for _, key in KEYS do
	values[key] = (Config.Comfort :: any)[key] ~= false
end
local listeners: { (key: Key, value: boolean) -> () } = {}
local menu: Frame? = nil
local buttons: { [string]: TextButton } = {}
local mixes: { [string]: number } = { master = 1, music = 1, effects = 1, breathing = 1, ambient = 1 }
local syncing = false
local shaders = true
local visualQuality = 0
local autoLevel = 2
local status: TextLabel? = nil
local pending: { [string]: number } = {}
local acknowledged: { [string]: number } = {}
local qualityNames = { [0] = "Automática", [0.25] = "Baixa", [0.5] = "Média", [1] = "Alta" }

local function refreshMenu()
	for index, key in KEYS do
		local button = buttons[key]
		if button then
			-- [n] = atalho numérico do teclado; o estado também vem por texto, não só por cor.
			button.Text = `[{index}] {(Text.Options :: any)[key]}: {if values[key] then Text.On else Text.Off}`
			Components.setVariant(button, if values[key] then "success" else "secondary")
		end
	end
	local labels = {
		master = "VOLUME GERAL",
		music = "MÚSICA",
		effects = "EFEITOS",
		breathing = "RESPIRAÇÃO",
		ambient = "AMBIENTE",
	}
	for key, value in mixes do
		local button = buttons[key]
		if button then
			button.Text = `{labels[key]} {math.floor(value * 100)}%`
			local fill = button:FindFirstChild("Fill", true)
			if fill and fill:IsA("Frame") then
				fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
			end
		end
	end
	if buttons.shaders then
		buttons.shaders.Text = `EFEITOS DE LUZ (SHADERS): {if shaders then "LIGADO" else "DESLIGADO"}`
		Components.setVariant(buttons.shaders, if shaders then "success" else "secondary")
	end
	if buttons.quality then
		-- string.upper não converte letras acentuadas (UTF-8): nomes já em maiúsculas.
		local upper = { [0] = "AUTOMÁTICA", [0.25] = "BAIXA", [0.5] = "MÉDIA", [1] = "ALTA" }
		buttons.quality.Text = `QUALIDADE VISUAL: {upper[visualQuality] or qualityNames[visualQuality]}`
	end
	if status then
		local saved = Players.LocalPlayer:GetAttribute("HousePreferencesSaved")
		local current = Players.LocalPlayer:GetAttribute("HousePreferences")
		status.Text = if next(pending)
			then "Aplicado localmente · aguardando servidor"
			elseif saved ~= nil and saved == current then (if Players.LocalPlayer:GetAttribute(
					"HousePreferencesSaveMode"
				) == "mock"
				then "Salvo na simulação local do Studio"
				else "Preferências salvas")
			else "Aplicado · aceito na sessão; aguardando salvamento"
	end
end

local SettingsController = {
	Name = "SettingsController",
	KEYS = KEYS,
}

function SettingsController.visualBudget(): Quality.Budget
	return Quality.budget(Quality.resolve(visualQuality, false, autoLevel), shaders)
end
function SettingsController.shadersEnabled(): boolean
	return shaders
end
function SettingsController.setVisual(key: string, value: number)
	if (key ~= "shaders" and key ~= "quality") or not Preferences.valid(key, value) then
		return
	end
	if key == "shaders" then
		shaders = value == 1
	else
		visualQuality = value
	end
	if not syncing then
		if acknowledged[key] ~= value then
			pending[key] = value
			Remotes.clientEvent("SetHousePreference"):FireServer(key, value)
		else
			pending[key] = nil
		end
	end
	Players.LocalPlayer:SetAttribute("VisualQualityApplied", SettingsController.visualBudget().name)
	Players.LocalPlayer:SetAttribute("ShadersApplied", shaders)
	refreshMenu()
end

function SettingsController.toggleMenu()
	if menu then
		menu.Visible = not menu.Visible
		Players.LocalPlayer:SetAttribute("ComfortMenuOpen", menu.Visible)
	end
end
function SettingsController.get(key: Key): boolean
	return values[key]
end

function SettingsController.set(key: Key, value: boolean)
	if values[key] == value then
		return
	end
	values[key] = value
	if not syncing then
		pending[key] = if value then 1 else 0
		Remotes.clientEvent("SetHousePreference"):FireServer(key, if value then 1 else 0)
	end
	refreshMenu()
	for _, listener in listeners do
		task.spawn(listener, key, value)
	end
end

function SettingsController.toggle(key: Key): boolean
	SettingsController.set(key, not values[key])
	return values[key]
end

-- Atalho B: movimento de câmera inteiro (balanço, inclinação e tremor) de uma vez.
function SettingsController.toggleMotion(): boolean
	local next = not (values["bob"] or values["tilt"] or values["shake"])
	SettingsController.set("bob", next)
	SettingsController.set("tilt", next)
	SettingsController.set("shake", next)
	return next
end

function SettingsController.motionEnabled(): boolean
	return values["bob"] or values["tilt"] or values["shake"]
end

function SettingsController.onChanged(listener: (key: Key, value: boolean) -> ())
	table.insert(listeners, listener)
end

function SettingsController.Init()
	local gui = Create("ScreenGui", {
		Name = "ComfortOptions",
		ResetOnSpawn = false,
		DisplayOrder = 250,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	}) :: ScreenGui
	local safe = Create(
		"Frame",
		{ Name = "SafeArea", Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }
	) :: Frame
	local panel = Components.panel({
		Name = "Options",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.92, 0, 0, 420),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.03,
		Visible = false,
		Parent = safe,
	}, {
		Create("UISizeConstraint", { MaxSize = Vector2.new(760, 640) }),
	})
	local outline = panel:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color, outline.Transparency = Theme.Gold, 0.45
	end
	menu = panel
	Components.icon(panel, "Settings", 24, Theme.Gold, { Position = UDim2.fromOffset(18, 18) })
	Components.title({
		Name = "Title",
		Position = UDim2.fromOffset(50, 12),
		Size = UDim2.new(1, -200, 0, 34),
		TextSize = 26,
		TextColor3 = Theme.GoldLight,
		Text = "AJUSTES",
		Parent = panel,
	})
	Components.text({
		Name = "Hint",
		Position = UDim2.fromOffset(18, 48),
		Size = UDim2.new(1, -36, 0, 18),
		FontFace = Theme.FontNote,
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Text = "Toque numa opção para mudar. Pistas e sinais de perigo continuam visíveis em qualquer qualidade.",
		Parent = panel,
	})
	status = Components.text({
		Name = "SaveStatus",
		Position = UDim2.fromOffset(18, 68),
		Size = UDim2.new(1, -36, 0, 16),
		FontFace = Theme.FontNote,
		TextSize = 11,
		TextColor3 = Theme.TextMuted,
		Text = "Aplicado localmente · salvamento não confirmado",
		Parent = panel,
	}) :: TextLabel
	local scroll = Create("ScrollingFrame", {
		Name = "OptionsScroll",
		Parent = panel,
		Position = UDim2.fromOffset(14, 92),
		Size = UDim2.new(1, -28, 1, -104),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) }),
	}) :: ScrollingFrame
	local grids: { UIGridLayout } = {}
	local function section(order: number, icon: string, title: string): Frame
		local head = Create("Frame", {
			Name = `Section_{title}`,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = scroll,
		})
		Components.icon(head, icon, 24, Theme.Gold)
		Components.title({
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -32, 1, 0),
			Text = title,
			TextSize = 16,
			TextColor3 = Theme.Gold,
			Parent = head,
		})
		local grid = Create("Frame", {
			Name = `Grid_{title}`,
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order + 1,
			Parent = scroll,
		}) :: Frame
		local layout = Create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, Theme.TouchMin + 4),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = grid,
		}) :: UIGridLayout
		table.insert(grids, layout)
		return grid
	end
	local function option(parent: Instance, key: string, order: number, callback: () -> ())
		local button = Components.button("secondary", {
			Name = key,
			LayoutOrder = order,
			Text = key,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = parent,
		}, callback)
		-- Modal: libera o cursor da primeira pessoa enquanto o painel está aberto.
		button.Modal = true
		Components.padding(button, 12, 0)
		buttons[key] = button
	end
	local graphics = section(1, "Star", "GRÁFICOS")
	option(graphics, "shaders", 1, function()
		SettingsController.setVisual("shaders", if shaders then 0 else 1)
	end)
	option(graphics, "quality", 2, function()
		local order = { 0, 0.25, 0.5, 1 }
		local index = table.find(order, visualQuality) or 1
		SettingsController.setVisual("quality", order[index % #order + 1])
	end)
	local comfort = section(3, "Heart", "CONFORTO E TELA")
	for index, key in KEYS do
		option(comfort, key, index, function()
			SettingsController.toggle(key :: Key)
		end)
	end
	local audio = section(5, "Drum", "ÁUDIO (TOQUE PARA BAIXAR 25%)")
	for index, key in { "master", "music", "effects", "breathing", "ambient" } do
		option(audio, key, index, function()
			mixes[key] = if mixes[key] <= 0 then 1 else math.max(0, mixes[key] - 0.25)
			Players.LocalPlayer:SetAttribute("Mix_" .. key, mixes[key])
			pending[key] = mixes[key]
			Remotes.clientEvent("SetHousePreference"):FireServer(key, mixes[key])
			refreshMenu()
		end)
		local track = Create("Frame", {
			Name = "Level",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(70, 6),
			BackgroundColor3 = Theme.BgSunken,
			BorderSizePixel = 0,
			Parent = buttons[key],
		})
		Components.corner(track, Theme.CornerPill)
		local fill = Create("Frame", {
			Name = "Fill",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Success,
			BorderSizePixel = 0,
			Parent = track,
		})
		Components.corner(fill, Theme.CornerPill)
	end
	local close = Components.iconButton("secondary", "Close", "FECHAR", {
		Name = "close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(124, 44),
		TextSize = 15,
		Parent = panel,
	}, function()
		panel.Visible = false
		Players.LocalPlayer:SetAttribute("ComfortMenuOpen", false)
	end)
	close.Modal = true
	buttons.close = close
	RunService.RenderStepped:Connect(function()
		if not panel.Visible then
			return
		end
		panel.Size = UDim2.new(0.94, 0, 0, math.max(180, math.min(640, safe.AbsoluteSize.Y - 20)))
		-- Uma coluna em telas estreitas; duas a partir de 560 px.
		local columns = if panel.AbsoluteSize.X >= 560 then 2 else 1
		for _, layout in grids do
			layout.CellSize = UDim2.new(1 / columns, if columns == 2 then -4 else 0, 0, Theme.TouchMin + 4)
		end
	end)
	refreshMenu()
end

function SettingsController.Start()
	local qualityOk, saved = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	-- Amostra única ao iniciar; não oscila conforme FPS ou reconstruções do mundo.
	autoLevel = if qualityOk and saved > 0 then saved else (if UserInputService.TouchEnabled then 2 else 6)
	local function load()
		local raw = Players.LocalPlayer:GetAttribute("HousePreferences")
		if type(raw) ~= "string" then
			return
		end
		local ok, prefs = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok then
			return
		end
		prefs = Preferences.sanitize(prefs)
		acknowledged = prefs
		for key, value in pending do
			if prefs[key] == value then
				pending[key] = nil
			end
		end
		syncing = true
		for _, key in { "shaders", "quality" } do
			if pending[key] == nil then
				SettingsController.setVisual(key, prefs[key] or (if key == "shaders" then 1 else 0))
			end
		end
		for _, key in KEYS do
			if prefs[key] ~= nil and pending[key] == nil then
				SettingsController.set(key :: Key, prefs[key] >= 0.5)
			end
		end
		syncing = false
		for key in mixes do
			if type(prefs[key]) == "number" and pending[key] == nil then
				mixes[key] = prefs[key]
				Players.LocalPlayer:SetAttribute("Mix_" .. key, mixes[key])
			end
		end
		refreshMenu()
	end
	Players.LocalPlayer:GetAttributeChangedSignal("HousePreferences"):Connect(load)
	Players.LocalPlayer:GetAttributeChangedSignal("HousePreferencesSaved"):Connect(refreshMenu)
	Players.LocalPlayer:GetAttributeChangedSignal("HousePreferencesSaveMode"):Connect(refreshMenu)
	load()
	if RunService:IsStudio() then
		local bridge = Instance.new("BindableFunction")
		bridge.Name = "VisualQA"
		bridge.OnInvoke = function(key: string, value: number?): any
			if value ~= nil then
				SettingsController.setVisual(key, value)
			end
			return {
				shaders = shaders,
				preference = visualQuality,
				budget = SettingsController.visualBudget(),
				pending = pending,
			}
		end
		bridge.Parent = Players.LocalPlayer.PlayerGui:WaitForChild("ComfortOptions")
		local function qaVisualRequest()
			local raw = Players.LocalPlayer:GetAttribute("VisualQARequest")
			if type(raw) ~= "string" then
				return
			end
			local request = HttpService:JSONDecode(raw)
			SettingsController.setVisual("shaders", request.shaders)
			SettingsController.setVisual("quality", request.quality)
			task.spawn(function()
				-- O primeiro pedido pode anteceder o Start dos demais controllers e a adaptação suave.
				local state: any = nil
				local deadline = os.clock() + 15
				repeat
					task.wait(0.25)
					local probe = Players.LocalPlayer.PlayerGui:FindFirstChild("Probe", true) :: BindableFunction?
					state = if probe then probe:Invoke("state") else nil
				until (state and (request.shaders == 1 or (state.bloom < 0.001 and state.depth == 0)))
					or os.clock() > deadline
				assert(state, "Missing real lighting QA bridge")
				assert(state.shaders == (request.shaders == 1), "Shader preference crossed clients")
				assert(state.quality == SettingsController.visualBudget().name, "Visual budget not applied")
				assert(state.fixtures.shadows <= SettingsController.visualBudget().shadows, "Shadow budget exceeded")
				if request.shaders == 0 then
					assert(state.bloom < 0.001 and state.depth == 0, "Optional post still active")
				end
				log.info(
					"PASS serial=%s shaders=%s quality=%s fixtures=%d shadows=%d",
					tostring(request.serial),
					tostring(state.shaders),
					state.quality,
					state.fixtures.fixtures,
					state.fixtures.shadows
				)
			end)
		end
		Players.LocalPlayer:GetAttributeChangedSignal("VisualQARequest"):Connect(qaVisualRequest)
		qaVisualRequest()
	end
	-- Reenvia somente valores locais ainda não reconhecidos, respeitando o rate limit existente.
	task.spawn(function()
		while true do
			task.wait(2)
			for key, value in pending do
				if acknowledged[key] ~= value then
					Remotes.clientEvent("SetHousePreference"):FireServer(key, value)
				end
				task.wait(0.3)
			end
		end
	end)
	ContextActionService:BindAction("HouseOptionsTouch", function(_, state)
		if state == Enum.UserInputState.Begin and menu then
			menu.Visible = not menu.Visible
			Players.LocalPlayer:SetAttribute("ComfortMenuOpen", menu.Visible)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonR3)

	-- O também é zoom da câmera padrão; InputBegan chega processado e perdia o atalho.
	ContextActionService:BindActionAtPriority("S9ComfortOptions", function(_, state)
		if UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and menu then
			menu.Visible = not menu.Visible
			Players.LocalPlayer:SetAttribute("ComfortMenuOpen", menu.Visible)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.O)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.V then
			SettingsController.toggle("retro")
		elseif input.KeyCode == Enum.KeyCode.B then
			SettingsController.toggleMotion()
		elseif menu and menu.Visible then
			local numberKeys = {
				Enum.KeyCode.One,
				Enum.KeyCode.Two,
				Enum.KeyCode.Three,
				Enum.KeyCode.Four,
				Enum.KeyCode.Five,
				Enum.KeyCode.Six,
				Enum.KeyCode.Seven,
				Enum.KeyCode.Eight,
			}
			local index = table.find(numberKeys, input.KeyCode)
			if index then
				SettingsController.toggle(KEYS[index])
			end
		end
	end)
end

return SettingsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="345">
          <Properties>
            <string name="Name">SpectatorController</string>
            <string name="Source"><![CDATA[--!strict
-- Acompanha apenas colegas ativos; nenhuma ação de jogo é enviada por este controller.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Rules = require("@game/ReplicatedStorage/Shared/Game/SpectatorRules")
local PixelText = require("@game/ReplicatedStorage/Shared/Game/PixelText")
local Camera = require("./CameraController")
local Create = require("../UI/Create")

local player = Players.LocalPlayer
local selected: number? = nil
local direction = 0
local Controller = { Name = "SpectatorController" }

function Controller.debugState(): { [string]: any }
	return { target = selected }
end

function Controller.cycle(step: number)
	direction = if step < 0 then -1 else 1
end

function Controller.Start()
	local banner = Create("TextLabel", {
		Name = "SpectatorStatus",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.new(0.9, 0, 0, 64),
		BackgroundColor3 = Color3.fromRGB(12, 16, 18),
		BackgroundTransparency = 0.1,
		TextColor3 = Color3.fromRGB(222, 216, 198),
		Font = Enum.Font.Code,
		TextSize = 15,
		TextWrapped = true,
		Visible = false,
		Parent = Create("ScreenGui", {
			Name = "SpectatorUi",
			ResetOnSpawn = false,
			DisplayOrder = 65,
			Parent = player:WaitForChild("PlayerGui"),
		}),
	}) :: TextLabel
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and banner.Visible then
			if input.KeyCode == Enum.KeyCode.Right then
				Controller.cycle(1)
			elseif input.KeyCode == Enum.KeyCode.Left then
				Controller.cycle(-1)
			end
		end
	end)
	local elapsed = 0
	RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0
		local state = ReplicatedStorage:FindFirstChild("CampaignState")
		local phase = if state then state:GetAttribute("Phase") else ""
		local allowed = Rules.allowed(tostring(phase), player:GetAttribute("CampaignStatus") :: string?)
		banner.Visible = allowed
		if not allowed then
			selected = nil
			direction = 0
			Camera.setSpectator(nil)
			return
		end
		local ids, candidates = {}, {}
		for _, other in Players:GetPlayers() do
			local character = other.Character
			local h = character and character:FindFirstChildOfClass("Humanoid")
			local head = character and character:FindFirstChild("Head")
			if other ~= player and other:GetAttribute("CampaignStatus") == "Active" and h and h.Health > 0 and head then
				table.insert(ids, other.UserId)
				candidates[other.UserId] = other
			end
		end
		selected = Rules.choose(ids, selected, direction)
		direction = 0
		local target = if selected then candidates[selected] else nil
		Camera.setSpectator(target)
		banner.Text = PixelText.normalize(
			(
				if target
					then `ACOMPANHANDO {target.DisplayName} · {if UserInputService.TouchEnabled
						then "TOQUE COLEGA PARA TROCAR"
						else "[← / →] TROCAR"}`
					else "AGUARDANDO COLEGAS ATIVOS."
			)
				.. (
					if player:GetAttribute("CampaignStatus") == "Downed"
						then "\nVOCÊ AINDA PODE SER RESGATADO POR UM COLEGA."
						else "\nVOCÊ RETORNA NO PRÓXIMO ESTÁGIO."
				)
		)
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="346">
          <Properties>
            <string name="Name">StoreController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Loja do Turno (cliente): só MOSTRA e PEDE. Preço, posse, sorteio, política e moedas são
	decididos no servidor (StoreService); o estado vem dos atributos do Player.

	Abre com L (ou Select no controle) fora da ação: intro, intervalo, telas finais, ou enquanto
	espera/assiste na campanha. Abas: LOJA, BAÚS, DIÁRIO, COLEÇÃO, CRÉDITOS.
	- Baús: botão "CHANCES (DETALHES)" mostra todas as chances em % ANTES de abrir (regra de
	  itens aleatórios pagos). O baú pago some/trava para contas restritas pela PolicyService.
	- Recompensas (StoreNotice): relatório do turno, fita achada, nível novo e compra, em
	  avisos curtos com som. Botão modal libera o mouse da primeira pessoa enquanto aberta.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local Season = require("@game/ReplicatedStorage/Shared/Game/Season")
local SeasonCatalog = require("@game/ReplicatedStorage/Shared/Game/SeasonCatalog")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local StoreView = require("@game/ReplicatedStorage/Shared/Game/StoreView")
local Types = require("@game/ReplicatedStorage/Shared/Types")
local Components = require("../UI/Components")
local Create = require("../UI/Create")
local Icons = require("../UI/Icons")
local ItemPreview = require("../UI/ItemPreview")
local Theme = require("../UI/Theme")
local ViewportQA = require("../UI/ViewportQA")
local AudioController = require("./AudioController")
local Settings = require("./SettingsController")

type Tab = "shop" | "season" | "chests" | "daily" | "collection" | "robux"

local player = Players.LocalPlayer
local TABS: { Tab } = { "shop", "season", "chests", "daily", "collection", "robux" }
local S = Text.Store

local panel: Frame? = nil
local content: ScrollingFrame? = nil
local overlay: Frame? = nil
local message: TextLabel? = nil
local hintLabel: TextLabel? = nil
local toastHolder: Frame? = nil
local tabButtons: { [Tab]: TextButton } = {}
local kindButtons: { [string]: TextButton } = {}
local tab: Tab = "shop"
local kindFilter: StoreCatalog.ItemKind = "flashlight"
-- Remaster: item em foco no painel de detalhe, layout da janela e setters da barra superior.
local selectedItem: string? = nil
local detail: Frame? = nil
local kindsBar: Frame? = nil
local compactStore = false
local shortStore = false
local twoPane = true
local setFichasBadge: ((number) -> ())? = nil
local setCreditosBadge: ((number) -> ())? = nil
local setXpBar: ((number) -> ())? = nil
local levelChip: TextLabel? = nil
-- QA no Studio: ações dos botões da aba aberta (press:<nome> no StoreQARequest).
local qaActions: { [string]: () -> () } = {}
-- Última rotação da roleta: depois do giro, a roda redesenhada continua apontando o prêmio.
local wheelRotation = 0

local TAB_ICONS: { [Tab]: string } = {
	shop = "Store",
	season = "Season",
	chests = "Chest",
	daily = "Daily",
	collection = "Tape",
	robux = "Gem",
}
local isOpen = false
-- Animação em curso (roleta/baú): mudanças de atributo não redesenham a aba no meio dela.
local animating = false
local busy = false
local phase: GameState.Phase = "Loading"
local mouseWasEnabled = false
local toastToken = 0

local function rgb(c: StoreCatalog.RGB): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- A fonte do tema (FredokaOne) tem acentos; o texto passa direto.
local function px(value: string): string
	return value
end

local function attr(name: string, fallback: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return fallback
	end
	return value
end

local function jsonSet(name: string): { [string]: boolean }
	local set = {}
	local ok, list = pcall(function()
		return HttpService:JSONDecode(attr(name, "[]"))
	end)
	if ok and type(list) == "table" then
		for _, id in list do
			set[id] = true
		end
	end
	return set
end

local function equippedId(kind: StoreCatalog.ItemKind): string
	local names = { flashlight = "EquipFlashlight", uniform = "EquipUniform", filter = "EquipFilter", title = "Title" }
	return attr((names :: any)[kind], StoreCatalog.defaultFor(kind))
end

-- Pode abrir agora? (fora da ação, ou esperando/assistindo na campanha)
local function allowed(): boolean
	local status = player:GetAttribute("CampaignStatus")
	return phase ~= "Playing" or status == "Waiting" or status == "Escaped"
end

local function label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextColor3 = Theme.Text,
		TextSize = Theme.SizeBody,
		TextWrapped = true,
	}
	for key, value in props do
		base[key] = value
	end
	return Create("TextLabel", base) :: TextLabel
end

-- Botão do tema. A cor de texto legada vira variante: destaque (Hazard) = principal,
-- verde (Good) = sucesso, apagado (TextDim) ou demais = secundário. O clique sempre chega.
local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local color = props.TextColor3
	local variant: Components.Variant = props.Variant
		or (if color == Theme.Hazard then "primary" elseif color == Theme.Good then "success" else "secondary")
	props.Variant, props.TextColor3, props.BackgroundColor3 = nil, nil, nil
	if props.TextSize == nil then
		props.TextSize = Theme.SizeSmall
	end
	local b = Components.button(variant, props, function()
		AudioController.play("UiBlip", 1, 1.1, true)
		onClick()
	end)
	if RunService:IsStudio() and type(props.Name) == "string" then
		-- QA: "press:<Nome>" executa este clique (respeita botão desativado).
		qaActions[props.Name] = function()
			if b.Parent and b:GetAttribute("Disabled") ~= true then
				onClick()
			end
		end
	end
	return b
end

local function setMessage(key: string?)
	local m = message
	if not m then
		return
	end
	local text = if key then (Text.Messages :: any)[key] or key else ""
	m.Text = text
end

local function request(action: string, arg: string?): Types.Result<any>?
	if busy then
		return nil
	end
	busy = true
	local ok, response = pcall(function()
		return Remotes.clientFunction("Store", 5):InvokeServer(action, arg)
	end)
	busy = false
	if not ok then
		setMessage("store_error")
		return nil
	end
	return response
end

local function track(event: string, offer: string?)
	Remotes.clientEvent("StoreTrack", 5):FireServer(event, offer)
end

-- ===================== Avisos (toasts) =====================

local function showToast(lines: { string }, color: Color3?, duration: number?)
	local holder = toastHolder
	if not holder then
		return
	end
	-- Cenas (abertura, fuga, capítulo) passam limpas: o aviso espera a cena terminar (CinematicController).
	if player:GetAttribute("CinematicHold") == true then
		task.delay(0.5, showToast, lines, color, duration)
		return
	end
	toastToken += 1
	local card = Create("Frame", {
		Size = UDim2.fromOffset(330, 26 + #lines * 20),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		LayoutOrder = -toastToken,
		Parent = holder,
	}, {
		Create("UIStroke", { Color = color or Theme.Hazard, Thickness = 2 }),
		Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 8) }),
		Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	}) :: Frame
	for index, line in lines do
		label({
			Size = UDim2.new(1, -10, 0, 20),
			Text = px(line),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if index == 1 then (color or Theme.Hazard) else Theme.Text,
			LayoutOrder = index,
			Parent = card,
		})
	end
	task.delay(duration or 5, function()
		card:Destroy()
	end)
end

-- O aviso do fim da partida chega junto com a fase: espera um instante para a cena de fuga começar.
local function toast(lines: { string }, color: Color3?, duration: number?)
	task.delay(0.35, showToast, lines, color, duration)
end

local function itemName(id: string): string
	local item = StoreCatalog.ItemById[id]
	return if item then item.name else id
end

local function onNotice(payload: { [string]: any })
	local lines: { string } = {}
	local kind = payload.kind
	if kind == "run" then
		table.insert(lines, Text.Rewards.run)
	elseif kind == "task" then
		table.insert(lines, "OBJETIVO CONCLUÍDO")
		table.insert(lines, if payload.contributed then "BÔNUS POR AJUDAR A EQUIPE" else "RECOMPENSA DA EQUIPE")
	elseif kind == "tape" then
		local tape = StoreCatalog.TapeById[payload.tape or ""]
		local title = if tape then tape.title else "?"
		if payload.new then
			table.insert(lines, string.format(Text.Rewards.tape, payload.finder or "", title))
		else
			table.insert(lines, string.format(Text.Rewards.tapeOld, title))
		end
	elseif kind == "daily" then
		table.insert(lines, string.format(Text.Rewards.daily, payload.day or 1))
	elseif kind == "purchase" then
		table.insert(lines, Text.Rewards.purchase)
	elseif kind == "story" then
		table.insert(lines, string.format(Text.Rewards.story, payload.chapter or 1))
		if payload.first then
			table.insert(lines, Text.Rewards.storyFirst)
		end
		if payload.flawless then
			table.insert(lines, Text.Rewards.storyFlawless)
		end
		if payload.completed then
			table.insert(lines, Text.Rewards.storyComplete)
		end
		if payload.pass then
			table.insert(lines, Text.Rewards.storyPass)
		end
	elseif kind == "season" then
		table.insert(lines, if payload.premium then Text.Rewards.seasonPremium else Text.Rewards.seasonRewards)
		for _, tier in payload.tiers or {} do
			table.insert(lines, string.format(Text.Rewards.season, tier))
		end
	end
	if (payload.seasonXp or 0) > 0 then
		table.insert(lines, string.format(Text.Rewards.seasonXp, payload.seasonXp))
	end
	if (payload.fichas or 0) > 0 then
		table.insert(lines, string.format(Text.Rewards.fichas, payload.fichas))
	end
	if (payload.creditos or 0) > 0 then
		table.insert(lines, string.format(Text.Rewards.creditos, payload.creditos))
	end
	if (payload.xp or 0) > 0 then
		table.insert(lines, string.format(Text.Rewards.xp, payload.xp))
	end
	if kind == "run" and payload.vip then
		table.insert(lines, Text.Rewards.vipBonus)
	end
	for _, level in payload.levels or {} do
		table.insert(lines, string.format(Text.Rewards.level, level))
	end
	for _, id in payload.items or {} do
		table.insert(lines, string.format(Text.Rewards.item, itemName(id)))
	end
	-- Consumíveis (Segunda Chance, Pilha Extra, Continuação) que entraram no estoque.
	for id, amount in payload.consumables or {} do
		local def = Perks.ConsumableById[id]
		if def and type(amount) == "number" then
			table.insert(lines, string.format(Text.Rewards.consumable, amount, def.name))
		end
	end
	if #lines == 0 then
		return
	end
	local leveled = payload.levels and #payload.levels > 0
	AudioController.play(if leveled then "StingerWin" else "Pickup", if leveled then 0.6 else 0.8, nil, true)
	toast(lines, if leveled then Theme.Good else Theme.Hazard, if kind == "run" then 9 else 5)
end

-- ===================== Conteúdo das abas =====================

local function clearContent(): ScrollingFrame?
	local c = content
	if not c then
		return nil
	end
	for _, child in c:GetChildren() do
		if not child:IsA("UIGridLayout") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	return c
end

local function setLayout(c: ScrollingFrame, grid: boolean)
	for _, child in c:GetChildren() do
		if child:IsA("UIGridLayout") or child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	if grid then
		Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(196, 132),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = c,
		})
	else
		Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = c,
		})
	end
end

local render: () -> ()

local function priceText(currency: StoreCatalog.Currency, price: number): string
	return `{Components.formatNumber(price)} {if currency == "fichas" then "FICHAS" else "CRÉDITOS"}`
end

local function walletOf(currency: StoreCatalog.Currency): number
	return tonumber(attr(if currency == "fichas" then "Fichas" else "Creditos", 0)) or 0
end

local function clearOverlay(): Frame?
	local o = overlay
	if not o then
		return nil
	end
	for _, child in o:GetChildren() do
		child:Destroy()
	end
	o.Visible = true
	return o
end

local function modalBox(o: Frame, size: UDim2): Frame
	local box = Components.panel({
		Name = "Modal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = Theme.BgPanel,
		BackgroundTransparency = 0,
		Parent = o,
	})
	local outline = box:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color, outline.Transparency = Theme.Gold, 0.3
	end
	return box
end

local function buyResult(result: Types.Result<any>?)
	if not result then
		return
	end
	if result.ok then
		setMessage(result.data.message)
		if result.data.ok then
			AudioController.play("Switch", 0.6, 1.4, true)
		end
	else
		setMessage("store_error")
	end
end

-- Pedido de compra confirmado: o servidor valida preço, saldo e posse (StoreService).
local function purchase(item: StoreCatalog.Item, currency: StoreCatalog.Currency)
	if overlay then
		overlay.Visible = false
	end
	buyResult(request(if currency == "fichas" then "buy_fichas" else "buy_creditos", item.id))
	render()
end

-- Compra com moeda do jogo: mostra item, preço e o saldo que sobra antes de pedir ao servidor.
local function confirmPurchase(item: StoreCatalog.Item, option: StoreView.PriceOption)
	local o = clearOverlay()
	if not o then
		return
	end
	local box = modalBox(o, UDim2.fromOffset(if compactStore then 360 else 440, 0))
	box.AutomaticSize = Enum.AutomaticSize.Y
	Components.padding(box, 18)
	Create("UIListLayout", {
		Padding = UDim.new(0, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = box,
	})
	local thumb = Create("Frame", {
		Name = "Thumb",
		Size = UDim2.fromOffset(96, 96),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = box,
	})
	ItemPreview.thumbnail(thumb, item)
	Components.title({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = `COMPRAR {item.name}?`,
		TextSize = 20,
		LayoutOrder = 2,
		Parent = box,
	})
	local left = walletOf(option.currency) - option.price
	Components.text({
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.FontNote,
		TextColor3 = Theme.TextSecondary,
		Text = `Custa {priceText(option.currency, option.price)}. Depois você fica com {priceText(
			option.currency,
			left
		)}.`,
		TextSize = 15,
		LayoutOrder = 3,
		Parent = box,
	})
	local row = Create("Frame", {
		Name = "Actions",
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		Parent = box,
	})
	button({
		Name = "Cancel",
		Variant = "secondary",
		Size = UDim2.new(0.5, -5, 1, 0),
		Text = "CANCELAR",
		TextSize = 16,
		Parent = row,
	}, function()
		o.Visible = false
	end)
	button({
		Name = "Confirm",
		Variant = "primary",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, -5, 1, 0),
		Text = "CONFIRMAR",
		TextSize = 16,
		Parent = row,
	}, function()
		purchase(item, option.currency)
	end)
end

local openDetailModal: (StoreCatalog.Item) -> ()

-- Conteúdo do detalhe: prévia (3D girável quando há modelo), raridade, quem vê, como obter e ação.
local function fillDetail(container: Frame, item: StoreCatalog.Item, inModal: boolean)
	local rarity = StoreCatalog.Rarities[item.rarity]
	local accent = rgb(rarity.color)
	local owned = jsonSet("Owned")
	local vip = attr("Vip", false) == true
	local state = StoreView.state(item, owned, equippedId(item.kind), vip)
	-- A prévia cede espaço para o texto: nome, selos, quem vê e como obter precisam de ~140 px
	-- além dos botões (1 ou 2). Painel ainda sem medida (primeiro quadro) usa a proporção padrão.
	local buttonCount = if state == "buyable"
		then #StoreView.prices(item, walletOf("fichas"), walletOf("creditos"))
		elseif state == "locked" then 0
		else 1
	local height = container.AbsoluteSize.Y - 24
	local previewHeight = 0.44
	if height > 0 then
		local free = height - 150 - buttonCount * (Theme.TouchMin + 8)
		previewHeight = math.clamp(free / height, 0.22, 0.5)
	end
	local preview = Create("Frame", {
		Name = "Preview",
		Size = UDim2.fromScale(1, previewHeight),
		BackgroundColor3 = Theme.BgSunken,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = container,
	}, {
		Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Theme.BgElevated, Theme.BgSunken),
		}),
	})
	Components.corner(preview, Theme.CornerSmall)
	Components.stroke(preview, accent, 1, 0.4)
	local viewport = ItemPreview.model(preview, item)
	if viewport then
		Components.text({
			Name = "RotateHint",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(1, -12, 0, 16),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "ARRASTE PARA GIRAR",
			TextSize = 11,
			TextColor3 = Theme.TextMuted,
			Parent = preview,
		})
	else
		local holder = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.8, 0.8),
			BackgroundTransparency = 1,
			Parent = preview,
		}, { Create("UIAspectRatioConstraint", { AspectRatio = if item.kind == "title" then 2 else 1.3 }) })
		ItemPreview.thumbnail(holder, item)
	end
	if inModal then
		Components.iconButton("secondary", "Close", nil, {
			Name = "Back",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(Theme.TouchMin, Theme.TouchMin),
			Parent = preview,
		}, function()
			AudioController.play("UiBlip", 1, 1.1, true)
			if overlay then
				overlay.Visible = false
			end
		end)
	end

	local actions: { { variant: Components.Variant, text: string, disabled: boolean, run: (() -> ())? } } = {}
	if state == "equipped" then
		table.insert(actions, { variant = "success", text = "EQUIPADO", disabled = true })
	elseif state == "owned" then
		table.insert(actions, {
			variant = "primary",
			text = "EQUIPAR",
			disabled = false,
			run = function()
				local result = request("equip", item.id)
				if result and result.ok then
					setMessage(result.data.message)
				end
				if inModal and overlay then
					overlay.Visible = false
				end
				render()
			end,
		})
	elseif state == "buyable" then
		local options = StoreView.prices(item, walletOf("fichas"), walletOf("creditos"))
		for index, option in options do
			table.insert(actions, {
				variant = if index == 1 then "primary" else "secondary",
				text = if option.affordable
					then `COMPRAR · {priceText(option.currency, option.price)}`
					else `FALTAM {priceText(option.currency, option.missing)}`,
				disabled = not option.affordable,
				run = function()
					confirmPurchase(item, option)
				end,
			})
		end
	end
	local actionHeight = #actions * (Theme.TouchMin + 8)
	local info = Create("Frame", {
		Name = "Info",
		Position = UDim2.new(0, 0, previewHeight, 10),
		Size = UDim2.new(1, 0, 1 - previewHeight, -(10 + actionHeight)),
		BackgroundTransparency = 1,
		Parent = container,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	label({
		Name = "ItemName",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = item.name,
		TextSize = if compactStore then 19 else 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.TextPrimary,
		LayoutOrder = 1,
		Parent = info,
	})
	local chips = Create("Frame", {
		Name = "Chips",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = info,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Components.chip(rarity.label, accent, { LayoutOrder = 1, Parent = chips })
	local stateLabel, stateColor = "BLOQUEADO", Theme.TextMuted
	if state == "equipped" then
		stateLabel, stateColor = "EQUIPADO", Theme.Success
	elseif state == "owned" then
		stateLabel, stateColor = "ADQUIRIDO", Theme.Success
	elseif state == "buyable" then
		stateLabel, stateColor = "À VENDA", Theme.Gold
	end
	Components.chip(stateLabel, stateColor, { LayoutOrder = 2, Parent = chips })
	Components.text({
		Name = "KindNote",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = Theme.FontNote,
		TextSize = 14,
		TextColor3 = Theme.TextSecondary,
		Text = StoreView.kindNote(item.kind),
		LayoutOrder = 3,
		Parent = info,
	})
	local how = Create("Frame", {
		Name = "HowToGet",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		Parent = info,
	})
	Components.icon(
		how,
		if state == "locked" then "Lock" elseif state == "buyable" then "Coin" else "Check",
		24,
		if state == "locked" then Theme.TextMuted elseif state == "buyable" then Theme.Coin else Theme.Success
	)
	Components.text({
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -32, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.TextPrimary,
		Text = if (state == "owned" or state == "equipped") and item.source ~= "default"
			then "VOCÊ JÁ TEM ESTE ITEM."
			else StoreView.howToGet(item),
		Parent = how,
	})
	for index, action in actions do
		local b = button({
			Name = `Action_{index}`,
			Variant = action.variant,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, -(#actions - index) * (Theme.TouchMin + 8)),
			Size = UDim2.new(1, 0, 0, Theme.TouchMin),
			Text = action.text,
			TextSize = 16,
			Parent = container,
		}, function()
			local run = action.run
			if run then
				run()
			end
		end)
		Components.setDisabled(b, action.disabled)
	end
end

local function renderDetail()
	local d = detail
	if not d then
		return
	end
	for _, child in d:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local item = if selectedItem then StoreCatalog.ItemById[selectedItem] else nil
	if not item or item.kind ~= kindFilter then
		item = StoreCatalog.ItemById[equippedId(kindFilter)]
	end
	if not item then
		return
	end
	selectedItem = item.id
	fillDetail(d, item, false)
end

openDetailModal = function(item: StoreCatalog.Item)
	local o = clearOverlay()
	if not o then
		return
	end
	local box = modalBox(o, UDim2.new(1, -24, 1, -24))
	Create("UISizeConstraint", { MaxSize = Vector2.new(460, 620), Parent = box })
	Components.padding(box, 12)
	fillDetail(box, item, true)
end

-- Grade da loja: miniatura real, nome, raridade e estado; tocar abre o detalhe.
local function renderShop(c: ScrollingFrame)
	setLayout(c, true)
	local grid = c:FindFirstChildOfClass("UIGridLayout")
	local width = math.max(c.AbsoluteSize.X - 16, 200)
	local columns = if compactStore then (if width >= 520 then 3 else 2) else math.clamp(math.floor(width / 186), 2, 5)
	-- Tela baixa: mais colunas para que uma linha inteira de cartões caiba na altura visível.
	local visibleHeight = c.AbsoluteSize.Y
	if visibleHeight > 0 then
		local widest = math.floor((visibleHeight - 12) / 1.16)
		columns = math.clamp(math.max(columns, math.ceil((width + 10) / (widest + 10))), 2, 6)
	end
	local cellWidth = math.floor((width - (columns - 1) * 10) / columns)
	if grid then
		grid.CellSize = UDim2.fromOffset(cellWidth, math.floor(cellWidth * 1.16))
		grid.CellPadding = UDim2.fromOffset(10, 10)
	end
	local owned = jsonSet("Owned")
	local vip = attr("Vip", false) == true
	local fichas, creditos = walletOf("fichas"), walletOf("creditos")
	local items = StoreView.itemsOfKind(kindFilter)
	local current = if selectedItem then StoreCatalog.ItemById[selectedItem] else nil
	if not current or current.kind ~= kindFilter then
		selectedItem = equippedId(kindFilter)
	end
	local strokes: { [string]: UIStroke } = {}
	for index, item in items do
		local rarity = StoreCatalog.Rarities[item.rarity]
		local accent = rgb(rarity.color)
		local state = StoreView.state(item, owned, equippedId(item.kind), vip)
		local cell = Create("TextButton", {
			Name = `Item_{item.id}`,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.BgPanel,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Parent = c,
		}) :: TextButton
		cell:SetAttribute("State", state)
		Components.corner(cell, Theme.CornerSmall)
		local selected = twoPane and item.id == selectedItem
		local outline = Components.stroke(
			cell,
			if selected then Theme.Gold else accent,
			if selected then 2 else 1,
			if selected then 0 else 0.45
		)
		strokes[item.id] = outline
		Create("Frame", {
			Name = "RarityBar",
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = accent,
			BorderSizePixel = 0,
			Parent = cell,
		})
		local thumb = Create("Frame", {
			Name = "ThumbHolder",
			Position = UDim2.fromOffset(6, 9),
			Size = UDim2.new(1, -12, 0.56, -9),
			BackgroundTransparency = 1,
			Parent = cell,
		})
		ItemPreview.thumbnail(thumb, item)
		label({
			Name = "ItemName",
			Position = UDim2.new(0, 8, 0.56, 6),
			Size = UDim2.new(1, -16, 0, 30),
			Text = item.name,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = cell,
		})
		label({
			Name = "Rarity",
			Position = UDim2.new(0, 8, 0.56, 38),
			Size = UDim2.new(1, -16, 0, 14),
			Text = rarity.label,
			TextSize = 11,
			TextColor3 = accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cell,
		})
		local status = Create("Frame", {
			Name = "Status",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 8, 1, -6),
			Size = UDim2.new(1, -16, 0, 20),
			BackgroundTransparency = 1,
			Parent = cell,
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local function statusText(text: string, color: Color3, order: number)
			label({
				Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = text,
				TextSize = 12,
				TextWrapped = false,
				TextColor3 = color,
				LayoutOrder = order,
				Parent = status,
			})
		end
		if state == "equipped" then
			Components.icon(status, "Check", 12, Theme.Success, { LayoutOrder = 1 })
			statusText("EQUIPADO", Theme.Success, 2)
		elseif state == "owned" then
			statusText("ADQUIRIDO", Theme.TextSecondary, 1)
		elseif state == "buyable" then
			for order, option in StoreView.prices(item, fichas, creditos) do
				local fichasOption = option.currency == "fichas"
				Components.icon(
					status,
					if fichasOption then "Coin" else "Gem",
					12,
					if option.affordable then (if fichasOption then Theme.Coin else Theme.Info) else Theme.TextMuted,
					{ LayoutOrder = order * 2 - 1 }
				)
				statusText(
					Components.formatNumber(option.price),
					if option.affordable then Theme.TextPrimary else Theme.TextMuted,
					order * 2
				)
			end
		else
			Components.icon(status, "Lock", 12, Theme.TextMuted, { LayoutOrder = 1 })
			statusText("BLOQUEADO", Theme.TextMuted, 2)
		end
		cell.Activated:Connect(function()
			AudioController.play("UiBlip", 1, 1.1, true)
			selectedItem = item.id
			if twoPane then
				for id, stroke in strokes do
					local entry = StoreCatalog.ItemById[id]
					local mine = id == item.id
					stroke.Color = if mine then Theme.Gold else rgb(StoreCatalog.Rarities[entry.rarity].color)
					stroke.Thickness = if mine then 2 else 1
					stroke.Transparency = if mine then 0 else 0.45
				end
				renderDetail()
			else
				openDetailModal(item)
			end
		end)
	end
	if twoPane then
		renderDetail()
	end
end

-- ===================== Recompensas (ícones e textos) =====================

local function rewardParts(reward: StoreCatalog.Reward?): { string }
	local parts = {}
	if not reward then
		return parts
	end
	if reward.item then
		table.insert(parts, itemName(reward.item))
	end
	if reward.fichas then
		table.insert(parts, `{Components.formatNumber(reward.fichas)} FICHAS`)
	end
	if reward.creditos then
		table.insert(parts, `{Components.formatNumber(reward.creditos)} CRÉDITOS`)
	end
	if reward.xp then
		table.insert(parts, `{Components.formatNumber(reward.xp)} XP`)
	end
	return parts
end

-- Arte da recompensa: miniatura real do item, ou a moeda/XP com o ícone próprio.
local function rewardArt(parent: Instance, reward: StoreCatalog.Reward?)
	local entry = if reward and reward.item then StoreCatalog.ItemById[reward.item] else nil
	if entry then
		ItemPreview.thumbnail(parent, entry)
		return
	end
	local holder = Create("Frame", {
		Name = "RewardArt",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.BgSunken,
		BorderSizePixel = 0,
		Parent = parent,
	})
	Components.corner(holder, Theme.CornerSmall)
	local kind, color = "Star", Theme.Success
	if reward and reward.creditos then
		kind, color = "Gem", Theme.Info
	elseif reward and reward.fichas then
		kind, color = "Coin", Theme.Coin
	elseif not reward then
		kind, color = "Close", Theme.TextMuted
	end
	Components.icon(holder, kind, 36, color, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	})
end

-- ===================== Chances e rolo do baú =====================

local function showOdds(title: string, lines: { string })
	track("view", "odds")
	local o = clearOverlay()
	if not o then
		return
	end
	local box = modalBox(o, UDim2.fromOffset(if compactStore then 380 else 600, 0))
	box.AutomaticSize = Enum.AutomaticSize.Y
	Components.padding(box, 16)
	Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = box })
	Components.title({
		Size = UDim2.new(1, 0, 0, 26),
		Text = title,
		TextSize = 20,
		TextColor3 = Theme.Gold,
		LayoutOrder = 0,
		Parent = box,
	})
	for i, line in lines do
		Components.text({
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = line,
			FontFace = if string.sub(line, 1, 2) == "  " then Theme.FontNote else Theme.Font,
			TextSize = 14,
			TextColor3 = if string.sub(line, 1, 2) == "  " then Theme.TextSecondary else Theme.TextPrimary,
			LayoutOrder = i,
			Parent = box,
		})
	end
	button({
		Name = "OddsOk",
		Variant = "primary",
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		Text = "ENTENDI",
		TextSize = 16,
		LayoutOrder = #lines + 1,
		Parent = box,
	}, function()
		o.Visible = false
	end)
end

local function percent(value: number): string
	-- 4 casas: a política pede ao menos 4 casas após o primeiro dígito não-zero quando arredonda.
	local text = string.format("%.4f", value)
	text = string.gsub(text, "%.?0+$", "")
	return text
end

local function oddsLines(chest: StoreCatalog.Chest): { string }
	local lines = {}
	for _, line in Economy.chestOdds(chest) do
		local rarity = StoreCatalog.Rarities[line.rarity]
		table.insert(lines, string.format(S.oddsLine, rarity.label, percent(line.percent), percent(line.perItem)))
		local names = {}
		for _, id in line.items do
			table.insert(names, itemName(id))
		end
		table.insert(lines, "  " .. table.concat(names, ", "))
	end
	table.insert(lines, S.oddsNote)
	return lines
end

-- Rolo de miniaturas que desacelera e para no item sorteado pelo servidor.
local function playReel(
	pool: { string },
	result: string,
	rarity: StoreCatalog.Rarity,
	duplicate: boolean,
	refund: number
)
	local o = clearOverlay()
	if not o then
		return
	end
	local accent = rgb(StoreCatalog.Rarities[rarity].color)
	local box = modalBox(o, UDim2.fromOffset(if compactStore then 340 else 420, 300))
	Components.padding(box, 16)
	local frameArt = Create("Frame", {
		Name = "Reel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(132, 132),
		BackgroundTransparency = 1,
		Parent = box,
	})
	local outline = Components.stroke(frameArt, Theme.Border, 2, 0)
	local name = Components.title({
		Position = UDim2.fromOffset(0, 142),
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		TextSize = 20,
		Parent = box,
	})
	local sub = Components.text({
		Position = UDim2.fromOffset(0, 174),
		Size = UDim2.new(1, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		TextColor3 = Theme.TextSecondary,
		Parent = box,
	})
	local function show(id: string)
		for _, child in frameArt:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local entry = StoreCatalog.ItemById[id]
		if entry then
			ItemPreview.thumbnail(frameArt, entry)
		end
		name.Text = itemName(id)
	end
	local rng = Random.new()
	local delay = 0.05
	while delay < 0.32 do
		show(pool[rng:NextInteger(1, #pool)])
		AudioController.play("UiBlip", 0.5, 1.6, true)
		task.wait(delay)
		delay *= 1.16
	end
	show(result)
	name.TextColor3 = accent
	outline.Color = accent
	sub.Text = if duplicate
		then string.format(S.duplicate, refund)
		else string.format(S.newItem, StoreCatalog.Rarities[rarity].label)
	AudioController.play(if rarity == "legendary" or rarity == "epic" then "StingerWin" else "Switch", 0.7, nil, true)
	button({
		Variant = "primary",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		Text = "OK",
		TextSize = 16,
		Parent = box,
	}, function()
		o.Visible = false
		animating = false
		render()
	end)
end

-- ===================== BAÚS =====================

local function openChest(chest: StoreCatalog.Chest)
	animating = true
	local result = request("open_chest", chest.id)
	if not result or not result.ok then
		animating = false
		return
	end
	local data = result.data
	if not data.ok then
		animating = false
		setMessage(data.message)
		return
	end
	setMessage(nil)
	local pool = {}
	for _, line in Economy.chestOdds(chest) do
		for _, id in line.items do
			table.insert(pool, id)
		end
	end
	task.spawn(playReel, pool, data.item, data.rarity, data.duplicate == true, data.refund or 0)
end

local function renderChests(c: ScrollingFrame)
	setLayout(c, false)
	local restricted = attr("PaidRandomRestricted", true) == true
	for index, chest in StoreCatalog.Chests do
		local blocked = chest.paidRandom and restricted
		local fichas = chest.currency == "fichas"
		local box = Components.panel({
			Name = `Chest_{chest.id}`,
			Size = UDim2.new(1, -4, 0, if shortStore then 176 elseif compactStore then 214 else 168),
			LayoutOrder = index,
			Parent = c,
		})
		Components.padding(box, 14)
		local tile = Create("Frame", {
			Size = UDim2.fromOffset(72, 72),
			BackgroundColor3 = (if fichas then Theme.Wood else Theme.GoldDeep):Lerp(Theme.Bg, 0.4),
			BorderSizePixel = 0,
			Parent = box,
		})
		Components.corner(tile, Theme.CornerSmall)
		Components.icon(tile, "Chest", 48, if fichas then Theme.Gold else Theme.GoldLight, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
		})
		label({
			Position = UDim2.fromOffset(86, 0),
			Size = UDim2.new(1, -86, 0, 26),
			Text = chest.name,
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = box,
		})
		Components.text({
			Position = UDim2.fromOffset(86, 28),
			Size = UDim2.new(1, -86, 0, 18),
			FontFace = Theme.FontNote,
			TextSize = 13,
			TextColor3 = Theme.TextSecondary,
			Text = if chest.paidRandom
				then "Item aleatório pago com Créditos. Repetido vira Fichas."
				else "Item aleatório com Fichas ganhas jogando. Repetido vira Fichas.",
			Parent = box,
		})
		-- Barra de chances por raridade (tamanho = chance real) + rótulos com %.
		local odds = Economy.chestOdds(chest)
		local bar = Create("Frame", {
			Name = "OddsBar",
			Position = UDim2.fromOffset(86, 54),
			Size = UDim2.new(1, -86, 0, 12),
			BackgroundColor3 = Theme.BgSunken,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = box,
		}, {
			Create(
				"UIListLayout",
				{ FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder }
			),
		})
		Components.corner(bar, Theme.CornerPill)
		local legend = Create("Frame", {
			Position = UDim2.fromOffset(86, 70),
			Size = UDim2.new(1, -86, 0, 18),
			BackgroundTransparency = 1,
			Parent = box,
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for order, line in odds do
			local rarity = StoreCatalog.Rarities[line.rarity]
			Create("Frame", {
				LayoutOrder = order,
				Size = UDim2.fromScale(line.percent / 100, 1),
				BackgroundColor3 = rgb(rarity.color),
				BorderSizePixel = 0,
				Parent = bar,
			})
			Components.text({
				LayoutOrder = order,
				Size = UDim2.fromOffset(0, 18),
				AutomaticSize = Enum.AutomaticSize.X,
				FontFace = Theme.Font,
				TextSize = 12,
				TextWrapped = false,
				TextColor3 = rgb(rarity.color),
				Text = `{rarity.label} {percent(line.percent)}%`,
				Parent = legend,
			})
		end
		local actions = Create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, if compactStore then 2 * Theme.TouchMin + 8 else Theme.TouchMin),
			BackgroundTransparency = 1,
			Parent = box,
		})
		local have = walletOf(chest.currency)
		local open = button({
			Name = `Open_{chest.id}`,
			Variant = "primary",
			Size = if compactStore then UDim2.new(1, 0, 0, Theme.TouchMin) else UDim2.new(0.6, -5, 1, 0),
			Text = if blocked
				then S.restricted
				elseif have < chest.price then `FALTAM {priceText(chest.currency, chest.price - have)}`
				else `ABRIR · {priceText(chest.currency, chest.price)}`,
			TextSize = 15,
			Parent = actions,
		}, function()
			if blocked then
				setMessage("store_restricted")
				return
			end
			-- Confirmação antes de gastar (o sorteio acontece no servidor).
			local o = clearOverlay()
			if not o then
				return
			end
			local dialog = modalBox(o, UDim2.fromOffset(if compactStore then 340 else 420, 0))
			dialog.AutomaticSize = Enum.AutomaticSize.Y
			Components.padding(dialog, 18)
			Create(
				"UIListLayout",
				{ Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = dialog }
			)
			Components.title({
				Size = UDim2.fromScale(1, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				Text = `ABRIR {chest.name}?`,
				TextSize = 20,
				LayoutOrder = 1,
				Parent = dialog,
			})
			Components.text({
				Size = UDim2.fromScale(1, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextXAlignment = Enum.TextXAlignment.Center,
				FontFace = Theme.FontNote,
				TextColor3 = Theme.TextSecondary,
				Text = `Custa {priceText(chest.currency, chest.price)}. O item é sorteado; veja as chances antes. Depois você fica com {priceText(
					chest.currency,
					have - chest.price
				)}.`,
				TextSize = 15,
				LayoutOrder = 2,
				Parent = dialog,
			})
			local row = Create("Frame", {
				Size = UDim2.new(1, 0, 0, Theme.TouchMin),
				BackgroundTransparency = 1,
				LayoutOrder = 3,
				Parent = dialog,
			})
			button({
				Variant = "secondary",
				Size = UDim2.new(0.5, -5, 1, 0),
				Text = "CANCELAR",
				TextSize = 16,
				Parent = row,
			}, function()
				o.Visible = false
			end)
			button({
				Name = "Confirm",
				Variant = "primary",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.new(0.5, -5, 1, 0),
				Text = "ABRIR",
				TextSize = 16,
				Parent = row,
			}, function()
				o.Visible = false
				openChest(chest)
			end)
		end)
		Components.setDisabled(open, blocked or have < chest.price)
		button({
			Name = `Odds_{chest.id}`,
			Variant = "secondary",
			AnchorPoint = if compactStore then Vector2.new(0, 1) else Vector2.new(1, 0),
			Position = if compactStore then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 0),
			Size = if compactStore then UDim2.new(1, 0, 0, Theme.TouchMin) else UDim2.new(0.4, -5, 1, 0),
			Text = "VER CHANCES",
			TextSize = 15,
			Parent = actions,
		}, function()
			showOdds(string.format(S.oddsTitle, chest.name), oddsLines(chest))
		end)
	end
end

-- ===================== DIÁRIO + ROLETA =====================

local function dailyCalendar(c: ScrollingFrame)
	local streak = attr("DailyStreak", 1)
	local claimable = attr("DailyClaimable", false) == true
	local box = Components.panel({
		Name = "Daily",
		Size = UDim2.new(1, -4, 0, if compactStore then 262 else 250),
		LayoutOrder = 1,
		Parent = c,
	})
	Components.padding(box, 14)
	Components.icon(box, "Daily", 24, Theme.Gold)
	label({
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -32, 0, 24),
		Text = "PRÊMIO DIÁRIO",
		TextSize = 19,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = box,
	})
	Components.text({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 18),
		FontFace = Theme.FontNote,
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Text = "Volte todo dia: o prêmio cresce até o dia 7. Se perder um dia, a sequência volta ao dia 1.",
		Parent = box,
	})
	local row = Create("Frame", {
		Name = "Days",
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, 112),
		BackgroundTransparency = 1,
		Parent = box,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local days = #StoreCatalog.Daily
	for day, reward in StoreCatalog.Daily do
		local done = day < streak or (day == streak and not claimable)
		local today = day == streak and claimable
		local final = day == days
		local cell = Create("Frame", {
			Name = `Day_{day}`,
			LayoutOrder = day,
			Size = UDim2.new(if final then 1.4 / (days + 0.4) else 1 / (days + 0.4), -6, 1, 0),
			BackgroundColor3 = if today
				then Theme.GoldDeep
				elseif done then Theme.Success:Lerp(Theme.Bg, 0.7)
				else Theme.BgSunken,
			BorderSizePixel = 0,
			Parent = row,
		}) :: Frame
		cell:SetAttribute("State", if today then "today" elseif done then "done" else "future")
		Components.corner(cell, Theme.CornerSmall)
		Components.stroke(
			cell,
			if today then Theme.Gold elseif done then Theme.Success else Theme.Border,
			if today then 2 else 1,
			if today or done then 0 else 0.5
		)
		label({
			Size = UDim2.new(1, 0, 0, 22),
			Text = `DIA {day}`,
			TextSize = 13,
			TextColor3 = if today then Theme.GoldLight elseif done then Theme.Success else Theme.TextSecondary,
			Parent = cell,
		})
		Components.icon(
			cell,
			if done then "Check" elseif reward.creditos then "Gem" else "Coin",
			if final then 36 else 24,
			if done then Theme.Success elseif reward.creditos then Theme.Info else Theme.Coin,
			{
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.48),
			}
		)
		label({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 2, 1, -4),
			Size = UDim2.new(1, -4, 0, 30),
			Text = table.concat(rewardParts(reward), "\n"),
			TextSize = 11,
			TextColor3 = Theme.TextPrimary,
			Parent = cell,
		})
	end
	local claim = button({
		Name = "ClaimDaily",
		Variant = if claimable then "primary" else "secondary",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		Text = if claimable then string.format(S.daily, streak) else string.format(S.dailyDone, streak % days + 1),
		TextSize = 15,
		Parent = box,
	}, function()
		if claimable then
			local result = request("claim_daily")
			if result and result.ok then
				setMessage(result.data.message)
				if result.data.ok then
					AudioController.play("Pickup", 0.8, nil, true)
				end
			end
			render()
		end
	end)
	Components.setDisabled(claim, not claimable)
end

local SPIN_COLORS = {
	Color3.fromRGB(70, 92, 130),
	Color3.fromRGB(150, 104, 52),
	Color3.fromRGB(92, 142, 108),
	Color3.fromRGB(112, 82, 140),
	Color3.fromRGB(176, 136, 62),
	Color3.fromRGB(66, 132, 168),
}

-- Roda desenhada com raios finos (sem imagens): cada fatia tem o ângulo da chance real.
local function buildWheel(parent: Instance, size: number): (Frame, { { number } })
	local arcs = StoreView.spinArcs(StoreCatalog.Spin)
	local holder = Create("Frame", {
		Name = "WheelHolder",
		Size = UDim2.fromOffset(size, size + 18),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local wheel = Create("Frame", {
		Name = "Wheel",
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.fromOffset(size, size),
		Rotation = wheelRotation,
		BackgroundColor3 = Theme.BgSunken,
		BorderSizePixel = 0,
		Parent = holder,
	}) :: Frame
	Components.corner(wheel, Theme.CornerPill)
	Components.stroke(wheel, Theme.Gold, 3, 0)
	local rays = 120
	local radius = size / 2
	local thickness = math.ceil(2 * math.pi * radius / rays) + 2
	-- GuiObject gira em torno do PRÓPRIO centro: cada raio fica num quadro do tamanho da roda
	-- (mesmo centro), e é esse quadro que gira.
	local function spoke(name: string, angle: number, width: number, color: Color3)
		local pivot = Create("Frame", {
			Name = name,
			Size = UDim2.fromScale(1, 1),
			Rotation = angle,
			BackgroundTransparency = 1,
			Parent = wheel,
		})
		Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 3),
			Size = UDim2.new(0, width, 0.5, -3),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = pivot,
		})
	end
	for ray = 0, rays - 1 do
		local angle = (ray + 0.5) * 360 / rays
		local index = 1
		for i, arc in arcs do
			if angle >= arc[1] and angle < arc[2] then
				index = i
			end
		end
		spoke("Ray", angle, thickness, SPIN_COLORS[(index - 1) % #SPIN_COLORS + 1])
	end
	for index, arc in arcs do
		-- Divisória na borda de cada fatia e rótulo no meio dela.
		spoke("Divider", arc[1], 2, Theme.Overlay)
		local mid = (arc[1] + arc[2]) / 2
		local rad = math.rad(mid)
		local segment = StoreCatalog.Spin[index]
		-- Fatia estreita: texto ao longo do raio (de dentro para fora) para não invadir a vizinha.
		local narrow = arc[2] - arc[1] < 45
		local reach = if narrow then 0.3 else 0.31
		local text = Components.title({
			Name = `Label_{segment.id}`,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + math.sin(rad) * reach, 0.5 - math.cos(rad) * reach),
			Size = UDim2.fromOffset(if narrow then radius * 0.62 else radius * 0.7, if narrow then 16 else 30),
			Rotation = if narrow then mid - 90 else mid,
			Text = segment.label,
			TextSize = if size < 240 then 11 else 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = true,
			Parent = wheel,
		})
		text.TextStrokeColor3 = Theme.Overlay
		text.TextStrokeTransparency = 0.3
	end
	local hub = Create("Frame", {
		Name = "Hub",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.2, 0.2),
		BackgroundColor3 = Theme.Bg,
		BorderSizePixel = 0,
		Parent = wheel,
	})
	Components.corner(hub, Theme.CornerPill)
	Components.stroke(hub, Theme.Gold, 2, 0)
	Components.icon(hub, "Drum", 24, Theme.Gold, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	})
	-- Ponteiro fixo no topo (fora da roda que gira).
	local pointer = Create("Frame", {
		Name = "Pointer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(24, 26),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = holder,
	})
	Icons.pixel(pointer, "Pointer", Theme.GoldLight)
	return wheel, arcs
end

local function spinWheel(c: ScrollingFrame)
	local spins = tonumber(attr("SpinsLeft", 0)) or 0
	local box = Components.panel({
		Name = "Spin",
		Size = UDim2.new(1, -4, 0, if compactStore then 560 else 340),
		LayoutOrder = 2,
		Parent = c,
	})
	Components.padding(box, 14)
	local wheelSize = if compactStore then 260 else 300
	local wheel, arcs = buildWheel(box, wheelSize)
	local infoX = if compactStore then 0 else wheelSize + 24
	local infoY = if compactStore then wheelSize + 28 else 0
	local info = Create("Frame", {
		Name = "Info",
		Position = UDim2.fromOffset(infoX, infoY),
		Size = UDim2.new(1, -infoX, 1, -infoY),
		BackgroundTransparency = 1,
		Parent = box,
	})
	label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "ROLETA GRÁTIS",
		TextSize = 19,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = info,
	})
	Components.text({
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 40),
		FontFace = Theme.FontNote,
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Text = "Um giro grátis por dia (VIP ganha mais um). O tamanho de cada fatia é a chance real do prêmio.",
		Parent = info,
	})
	local count =
		Components.chip(string.format(S.spinsLeft, spins), if spins > 0 then Theme.Gold else Theme.TextMuted, {
			Position = UDim2.fromOffset(0, 74),
			Parent = info,
		})
	count.Name = "SpinsLeft"
	local result = Components.title({
		Name = "Result",
		Position = UDim2.fromOffset(0, 106),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextSize = 22,
		TextColor3 = Theme.Success,
		Parent = info,
	})
	local spin: TextButton
	spin = button({
		Name = "Spin",
		Variant = "primary",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -(Theme.TouchMin + 8)),
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		Text = if spins > 0 then S.spin else "VOLTE AMANHÃ PARA GIRAR",
		TextSize = 16,
		Parent = info,
	}, function()
		if spins <= 0 or animating then
			return
		end
		animating = true
		Components.setDisabled(spin, true)
		local response = request("spin")
		if not response or not response.ok or not response.data.ok then
			animating = false
			if response and response.ok then
				setMessage(response.data.message)
			end
			render()
			return
		end
		-- O prêmio já foi decidido e pago pelo servidor; a roda só mostra o resultado.
		local target = 1
		for i, segment in StoreCatalog.Spin do
			if segment.id == response.data.segment then
				target = i
			end
		end
		local finish = StoreView.spinRotation(arcs, target, Random.new():NextNumber(), 5)
		local start = wheel.Rotation % 360
		task.spawn(function()
			local duration = if Settings.motionEnabled() then 4.2 else 0.6
			local elapsed, lastTick = 0, start
			while elapsed < duration do
				local dt = RunService.RenderStepped:Wait()
				elapsed += dt
				local t = math.clamp(elapsed / duration, 0, 1)
				local eased = 1 - (1 - t) ^ 4
				wheel.Rotation = start + (finish - start) * eased
				-- Clique a cada fatia de 30° que passa pelo ponteiro.
				if wheel.Rotation - lastTick >= 30 then
					lastTick = wheel.Rotation
					AudioController.play("UiBlip", 0.35, 1.8, true)
				end
			end
			wheel.Rotation = finish
			wheelRotation = finish % 360
			AudioController.play("Switch", 0.7, 1.2, true)
			local segment = StoreCatalog.Spin[target]
			result.Text = `+ {segment.label}`
			setMessage(`VOCÊ GANHOU {segment.label}!`)
			task.wait(1.6)
			animating = false
			render()
		end)
	end)
	Components.setDisabled(spin, spins <= 0)
	button({
		Name = "SpinOdds",
		Variant = "secondary",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, Theme.TouchMin),
		Text = "VER CHANCES",
		TextSize = 15,
		Parent = info,
	}, function()
		local lines = {}
		for index, segment in StoreCatalog.Spin do
			table.insert(lines, `{segment.label}: {percent(arcs[index][3])}%`)
		end
		table.insert(lines, "  Sorteio feito no servidor. Grátis: não usa Robux nem Créditos.")
		showOdds(S.spinOdds, lines)
	end)
end

local function renderDaily(c: ScrollingFrame)
	setLayout(c, false)
	local list = c:FindFirstChildOfClass("UIListLayout")
	if list then
		list.Padding = UDim.new(0, 12)
	end
	dailyCalendar(c)
	spinWheel(c)
end

-- ===================== COLEÇÃO =====================

local function renderCollection(c: ScrollingFrame)
	setLayout(c, false)
	local tapes = jsonSet("Tapes")
	local count = 0
	for _ in tapes do
		count += 1
	end
	local total = #StoreCatalog.Tapes
	-- Progresso e marcos (4, 8, 12 fitas) com a arte real da recompensa.
	local summary = Components.panel({
		Name = "CollectionSummary",
		Size = UDim2.new(1, -4, 0, 176),
		LayoutOrder = 1,
		Parent = c,
	})
	Components.padding(summary, 14)
	Components.icon(summary, "Tape", 24, Theme.Gold)
	label({
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -32, 0, 24),
		Text = `FITAS VHS · {count}/{total}`,
		TextSize = 19,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = summary,
	})
	Components.text({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 18),
		FontFace = Theme.FontNote,
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Text = "Uma fita aparece escondida em cada partida. Quando alguém acha, o time todo ganha.",
		Parent = summary,
	})
	local progressBar, setTrack = Components.progress({
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 8),
	}, Theme.Gold)
	progressBar.Parent = summary
	setTrack(count / total)
	local amounts = {}
	for amount in StoreCatalog.TapeMilestones do
		table.insert(amounts, amount)
	end
	table.sort(amounts)
	local milestones = Create("Frame", {
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 76),
		BackgroundTransparency = 1,
		Parent = summary,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for order, amount in amounts do
		local reward = StoreCatalog.TapeMilestones[amount]
		local reached = count >= amount
		local cell = Create("Frame", {
			Name = `Milestone_{amount}`,
			LayoutOrder = order,
			Size = UDim2.new(1 / #amounts, -8, 1, 0),
			BackgroundColor3 = if reached then Theme.Success:Lerp(Theme.Bg, 0.7) else Theme.BgSunken,
			BorderSizePixel = 0,
			Parent = milestones,
		})
		Components.corner(cell, Theme.CornerSmall)
		Components.stroke(cell, if reached then Theme.Success else Theme.Border, 1, 0.3)
		local art = Create("Frame", {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.fromOffset(64, 64),
			BackgroundTransparency = 1,
			Parent = cell,
		})
		rewardArt(art, reward)
		label({
			Position = UDim2.fromOffset(78, 6),
			Size = UDim2.new(1, -84, 0, 20),
			Text = `{amount} FITAS`,
			TextSize = 14,
			TextColor3 = if reached then Theme.Success else Theme.TextPrimary,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cell,
		})
		label({
			Position = UDim2.fromOffset(78, 28),
			Size = UDim2.new(1, -84, 0, 40),
			Text = (if reached then "RECEBIDO: " else "") .. table.concat(rewardParts(reward), " + "),
			TextSize = 11,
			TextColor3 = Theme.TextSecondary,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = cell,
		})
	end
	local grid = Create("Frame", {
		Name = "Tapes",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = c,
	}, {
		Create("UIGridLayout", {
			CellSize = UDim2.new(if compactStore then 0.5 else 1 / 3, -8, 0, 96),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for index, tape in StoreCatalog.Tapes do
		local found = tapes[tape.id] == true
		local cell = Components.panel({ Name = `Tape_{tape.id}`, LayoutOrder = index, Parent = grid })
		Components.padding(cell, 10)
		Components.icon(cell, if found then "Tape" else "Lock", 24, if found then Theme.Gold else Theme.TextMuted)
		label({
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -32, 0, 24),
			Text = if found then tape.title else `FITA {index} · NÃO ENCONTRADA`,
			TextSize = 14,
			TextColor3 = if found then Theme.GoldLight else Theme.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cell,
		})
		Components.text({
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 1, -30),
			FontFace = Theme.FontNote,
			TextSize = 13,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = if found then Theme.TextPrimary else Theme.TextMuted,
			Text = if found then `“{tape.line}”` else "Procure pela casa durante as partidas.",
			Parent = cell,
		})
	end
end

-- ===================== TEMPORADA =====================

local function renderSeason(c: ScrollingFrame)
	setLayout(c, false)
	local list = c:FindFirstChildOfClass("UIListLayout")
	if list then
		list.Padding = UDim.new(0, 12)
	end
	local season = SeasonCatalog.SeasonById[attr("SeasonId", "")]
	if not season then
		Components.text({ Size = UDim2.new(1, -12, 0, 64), Text = Text.Season.none, FontFace = Theme.Font, Parent = c })
		return
	end
	local tier, into, need = Season.tierInfo(season, attr("SeasonXp", 0))
	local premium = attr("SeasonPremium", false) == true
	local intro = Components.panel({
		Name = "SeasonSummary",
		Size = UDim2.new(1, -4, 0, if shortStore then 176 elseif compactStore then 214 else 168),
		LayoutOrder = 0,
		Parent = c,
	})
	Components.padding(intro, 14)
	Components.icon(intro, "Season", 24, Theme.Gold)
	label({
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -32, 0, 24),
		Text = string.format(Text.Season.header, season.number, season.name),
		TextSize = 19,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = intro,
	})
	local days = Season.daysLeft(season, os.time())
	Components.chip(
		if days <= 1 then Text.Season.lastDay else string.format(Text.Season.daysLeft, days),
		Theme.Info,
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = intro }
	)
	label({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 20),
		Text = string.format(Text.Season.tier, tier, #season.tiers)
			.. "  ·  "
			.. string.format(Text.Season.xp, into, need),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = intro,
	})
	local bar, setBar =
		Components.progress({ Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 8) }, Theme.Gold)
	bar.Name = "SeasonProgress"
	bar.Parent = intro
	setBar(if need > 0 then into / need else 1)
	Components.text({
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 0, 30),
		FontFace = Theme.FontNote,
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Text = "XP da temporada vem de partidas, fugas, fitas e do prêmio diário. As recompensas são entregues sozinhas ao alcançar cada nível.",
		Parent = intro,
	})
	local product = StoreCatalog.ProductByKey[season.passKey]
	local passRow = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, if compactStore then Theme.TouchMin else 36),
		BackgroundTransparency = 1,
		Parent = intro,
	})
	if premium then
		Components.chip(Text.Season.owned, Theme.Success, { Parent = passRow })
	elseif product and (product.id > 0 or RunService:IsStudio()) then
		-- ID 0 só existe para simulação no Studio (MONETIZATION.md); ao vivo o botão some.
		button({
			Name = "BuySeason",
			Variant = "success",
			Size = UDim2.fromScale(if compactStore then 1 else 0.5, 1),
			Text = if product.id > 0
				then string.format(Text.Season.buy, product.robux)
				else `{string.format(Text.Season.buy, product.robux)} · SIMULAÇÃO STUDIO`,
			TextSize = 14,
			Parent = passRow,
		}, function()
			local result = request("buy_product", season.passKey)
			if result then
				setMessage(if result.ok then result.data.message else result.error)
			end
			task.delay(0.6, render)
		end)
	else
		Components.chip("TRILHA PAGA AINDA NÃO ESTÁ À VENDA", Theme.TextMuted, { Parent = passRow })
	end

	-- Trilha horizontal: nível no topo, GRÁTIS em cima e PAGA embaixo, com a arte real.
	local columnWidth = if compactStore then 116 else 132
	local cellHeight, rowGap = 112, 8
	-- Rótulos GRÁTIS/PAGA fixos à esquerda; só os níveis rolam na horizontal.
	local trackBox = Create("Frame", {
		Name = "SeasonTrackBox",
		Size = UDim2.new(1, -4, 0, 34 + 2 * (cellHeight + rowGap) + 8),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = c,
	})
	for row, trackName in { "free", "premium" } do
		local tag = Create("Frame", {
			Name = `Row_{trackName}`,
			Position = UDim2.fromOffset(0, 34 + (row - 1) * (cellHeight + rowGap)),
			Size = UDim2.fromOffset(76, cellHeight),
			BackgroundColor3 = if trackName == "free" then Theme.BgElevated else Theme.GoldDeep,
			BorderSizePixel = 0,
			Parent = trackBox,
		})
		Components.corner(tag, Theme.CornerSmall)
		label({
			Size = UDim2.fromScale(1, 1),
			Text = if trackName == "free" then "GRÁTIS" else "PAGA",
			TextSize = 14,
			TextColor3 = if trackName == "free" then Theme.TextPrimary else Theme.GoldLight,
			Parent = tag,
		})
	end
	local strip = Create("ScrollingFrame", {
		Name = "SeasonTrack",
		Position = UDim2.fromOffset(84, 0),
		Size = UDim2.new(1, -84, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		CanvasSize = UDim2.fromOffset(#season.tiers * (columnWidth + 8), 0),
		Parent = trackBox,
	}) :: ScrollingFrame
	-- Colunas montadas sob demanda (visíveis + vizinhas): 30 níveis com arte pesariam no celular.
	local built: { [number]: boolean } = {}
	local function buildColumn(index: number)
		if built[index] or not season.tiers[index] then
			return
		end
		built[index] = true
		local entry = season.tiers[index]
		local reached = index <= tier
		local x = (index - 1) * (columnWidth + 8)
		local current = index == tier
		local head = Create("Frame", {
			Name = `SeasonTier_{index}`,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(columnWidth, 28),
			BackgroundColor3 = if current
				then Theme.Gold
				elseif reached then Theme.Success:Lerp(Theme.Bg, 0.6)
				else Theme.BgSunken,
			BorderSizePixel = 0,
			Parent = strip,
		})
		Components.corner(head, Theme.CornerPill)
		label({
			Size = UDim2.fromScale(1, 1),
			Text = string.format(Text.Season.tierLabel, index),
			TextSize = 13,
			TextColor3 = if current then Theme.Bg elseif reached then Theme.Success else Theme.TextMuted,
			Parent = head,
		})
		for row, trackName in { "free", "premium" } do
			local reward = if trackName == "free" then entry.free else entry.premium
			local unlocked = reached and (trackName == "free" or premium)
			local lockedByPass = trackName == "premium" and not premium
			local cell = Create("Frame", {
				Name = trackName,
				Position = UDim2.fromOffset(x, 34 + (row - 1) * (cellHeight + rowGap)),
				Size = UDim2.fromOffset(columnWidth, cellHeight),
				BackgroundColor3 = Theme.BgPanel,
				BorderSizePixel = 0,
				Parent = strip,
			}) :: Frame
			cell:SetAttribute("State", if unlocked then "received" elseif lockedByPass then "pass" else "locked")
			Components.corner(cell, Theme.CornerSmall)
			Components.stroke(
				cell,
				if unlocked then Theme.Success elseif trackName == "premium" then Theme.Gold else Theme.Border,
				1,
				if unlocked then 0 else 0.5
			)
			local art = Create("Frame", {
				Position = UDim2.fromOffset(8, 8),
				Size = UDim2.new(1, -16, 0, 54),
				BackgroundTransparency = 1,
				Parent = cell,
			})
			rewardArt(art, reward)
			label({
				Name = "TrackPreview",
				Position = UDim2.fromOffset(6, 64),
				Size = UDim2.new(1, -12, 0, 28),
				Text = if reward then table.concat(rewardParts(reward), " + ") else Text.Season.empty,
				TextSize = 11,
				Parent = cell,
			})
			local stateText = if unlocked
				then Text.Season.received
				elseif lockedByPass then "TRILHA PAGA"
				else `NÍVEL {index}`
			label({
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 6, 1, -4),
				Size = UDim2.new(1, -12, 0, 16),
				Text = stateText,
				TextSize = 11,
				TextColor3 = if unlocked then Theme.Success elseif lockedByPass then Theme.Gold else Theme.TextMuted,
				Parent = cell,
			})
			if not unlocked then
				-- Véu leve + cadeado: dá para ver o prêmio, mas fica claro que ainda não é seu.
				local veil = Create("Frame", {
					Size = UDim2.fromScale(1, 1),
					BackgroundColor3 = Theme.Overlay,
					BackgroundTransparency = 0.55,
					BorderSizePixel = 0,
					Parent = cell,
				})
				Components.corner(veil, Theme.CornerSmall)
				Components.icon(veil, "Lock", 24, Theme.TextSecondary, {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -6, 0, 6),
				})
			end
		end
	end
	local step = columnWidth + 8
	local function ensureVisible()
		local first = math.floor(strip.CanvasPosition.X / step) + 1
		local count = math.ceil(math.max(strip.AbsoluteSize.X, 400) / step) + 1
		for index = first - 1, first + count do
			buildColumn(index)
		end
	end
	strip:GetPropertyChangedSignal("CanvasPosition"):Connect(ensureVisible)
	-- Abre a trilha no nível atual.
	strip.CanvasPosition = Vector2.new(math.max(0, (tier - 2) * step), 0)
	ensureVisible()
	task.defer(function()
		strip.CanvasPosition = Vector2.new(math.max(0, (tier - 2) * step), 0)
		ensureVisible()
	end)
end

-- ===================== CRÉDITOS (Robux) =====================

local function renderRobux(c: ScrollingFrame)
	setLayout(c, false)
	Components.text({
		Size = UDim2.new(1, -4, 0, 36),
		FontFace = Theme.FontNote,
		TextSize = 13,
		TextColor3 = Theme.TextSecondary,
		Text = "Compras com Robux abrem a janela oficial do Roblox. Nada é cobrado sem a sua confirmação lá.",
		LayoutOrder = 0,
		Parent = c,
	})
	local studio = RunService:IsStudio()
	for index, product in StoreCatalog.Products do
		local owned = (product.key == "vip" and attr("Vip", false) == true)
			or (product.key == "pacote_inicial" and attr("StarterBought", false) == true)
			or (product.key == "turno_extra_s1" and attr("SeasonPremium", false) == true)
		local box = Components.panel({
			Name = `Product_{product.key}`,
			Size = UDim2.new(1, -4, 0, if compactStore then 132 else 84),
			LayoutOrder = index,
			Parent = c,
		})
		Components.padding(box, 12)
		local grant = product.grant
		local tile = Create("Frame", { Size = UDim2.fromOffset(56, 56), BackgroundTransparency = 1, Parent = box })
		rewardArt(tile, grant)
		label({
			Position = UDim2.fromOffset(68, 0),
			Size = UDim2.new(if compactStore then 1 else 0.62, -68, 0, 22),
			Text = product.name,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = box,
		})
		Components.text({
			Position = UDim2.fromOffset(68, 24),
			Size = UDim2.new(if compactStore then 1 else 0.62, -68, 0, 34),
			FontFace = Theme.FontNote,
			TextSize = 13,
			TextColor3 = Theme.TextSecondary,
			Text = product.description,
			Parent = box,
		})
		local configured = product.id > 0
		local buy = button({
			Name = `Buy_{product.key}`,
			Variant = if owned then "success" else "primary",
			AnchorPoint = if compactStore then Vector2.new(0, 1) else Vector2.new(1, 0.5),
			Position = if compactStore then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 0.5),
			Size = if compactStore then UDim2.new(1, 0, 0, Theme.TouchMin) else UDim2.new(0.34, 0, 0, Theme.TouchMin),
			Text = if owned
				then S.owned
				elseif configured then string.format(S.buyRobux, product.robux)
				elseif studio then `{string.format(S.buyRobux, product.robux)} · SIMULAÇÃO`
				else "AINDA NÃO ESTÁ À VENDA",
			TextSize = 14,
			Parent = box,
		}, function()
			if owned then
				return
			end
			local result = request("buy_product", product.key)
			if result and result.ok then
				setMessage(result.data.message)
			end
			task.delay(0.6, render)
		end)
		-- Produto sem ID: só simulável no Studio (MONETIZATION.md); ao vivo não há botão de compra ativo.
		Components.setDisabled(buy, owned or (not configured and not studio))
	end
end

-- Distribui a janela conforme a tela: PC (janela central, grade + detalhe ao lado) ou toque/tela
-- pequena (quase tela cheia; detalhe abre por cima). O Studio pode simular um aparelho (ViewportQA).
local function applyLayout()
	local p = panel
	local c = content
	if not p or not c then
		return
	end
	local qaWidth, qaHeight = ViewportQA.size()
	local viewport = workspace.CurrentCamera.ViewportSize
	compactStore = qaWidth ~= nil or UserInputService.TouchEnabled or viewport.X < 1000 or viewport.Y < 600
	local width, height
	if qaWidth and qaHeight then
		p.Size = UDim2.fromOffset(qaWidth - 16, qaHeight - 16)
		width, height = qaWidth - 16, qaHeight - 16
	elseif compactStore then
		p.Size = UDim2.new(1, -16, 1, -16)
		width, height = viewport.X - 16, viewport.Y - 16
	else
		p.Size = UDim2.fromScale(0.92, 0.9)
		width, height = math.min(viewport.X * 0.92, 1180), math.min(viewport.Y * 0.9, 780)
	end
	-- Celular na horizontal é baixo: uma coluna de grade e detalhe por cima (openDetailModal).
	shortStore = height < 520
	twoPane = width >= 760 and not shortStore
	local shop = tab == "shop"
	local pad = if shortStore then 8 elseif compactStore then 10 else 16
	local headerHeight = if shortStore then 40 elseif compactStore then 44 else 52
	local tabsY = pad + headerHeight + (if shortStore then 4 else 6)
	local tabsHeight = if shortStore then 40 else 44
	local kindsHeight = if shortStore then 36 else 40
	local kindsY = tabsY + tabsHeight + (if shortStore then 6 else 8)
	local contentY = if shop then kindsY + kindsHeight + 8 else tabsY + tabsHeight + 8
	local footer = if shortStore then 26 else 40
	local m = message
	if m then
		m.Size = UDim2.new(1, -2 * pad, 0, footer - 6)
		m.Position = UDim2.new(0, pad, 1, -4)
	end
	local kinds = kindsBar
	if kinds then
		kinds.Visible = shop
		kinds.Position = UDim2.fromOffset(pad, kindsY)
		kinds.Size = UDim2.new(1, -2 * pad, 0, kindsHeight)
	end
	local topBar = p:FindFirstChild("TopBar")
	if topBar and topBar:IsA("Frame") then
		topBar.Position = UDim2.fromOffset(pad, pad)
		topBar.Size = UDim2.new(1, -2 * pad, 0, headerHeight)
	end
	local tabBar = p:FindFirstChild("Tabs")
	if tabBar and tabBar:IsA("GuiObject") then
		tabBar.Position = UDim2.fromOffset(pad, tabsY)
		tabBar.Size = UDim2.new(1, -2 * pad, 0, tabsHeight + 4)
	end
	local split = shop and twoPane
	c.Position = UDim2.fromOffset(pad, contentY)
	c.Size = UDim2.new(if split then 0.62 else 1, if split then -pad - 6 else -2 * pad, 1, -(contentY + footer + pad))
	local d = detail
	if d then
		d.Visible = split
		d.Position = UDim2.new(0.62, 6, 0, contentY)
		d.Size = UDim2.new(0.38, -pad - 6, 1, -(contentY + footer + pad))
	end
	-- Abas: no PC dividem a largura; no toque têm largura fixa e rolam na horizontal.
	for index, key in TABS do
		local b = tabButtons[key :: Tab]
		if b then
			if compactStore then
				b.Size = UDim2.fromOffset(146, tabsHeight)
			else
				b.Size = UDim2.new(1 / #TABS, -6, 0, tabsHeight)
			end
			b.LayoutOrder = index
		end
	end
end

render = function()
	local c = clearContent()
	if not c or not isOpen then
		return
	end
	applyLayout()
	-- Barra superior: saldo, nível e XP (atributos publicados pelo StoreService).
	local xp = attr("Xp", 0)
	local level, into, need = Economy.levelInfo(xp)
	if setFichasBadge then
		setFichasBadge(tonumber(attr("Fichas", 0)) or 0)
	end
	if setCreditosBadge then
		setCreditosBadge(tonumber(attr("Creditos", 0)) or 0)
	end
	if levelChip then
		local vip = if attr("Vip", false) == true then " · VIP" else ""
		levelChip.Text = px(string.format(S.level, level) .. vip)
	end
	if setXpBar then
		setXpBar(into / math.max(need, 1))
	end
	for key, b in tabButtons do
		Components.setVariant(b, if key == tab then "secondary" else "ghost")
	end
	for kind, b in kindButtons do
		Components.setVariant(b, if kind == kindFilter then "secondary" else "ghost")
	end
	-- Mesma aba e filtro (redesenho por compra/saldo): mantém a rolagem; trocou: volta ao topo.
	local view = `{tab}/{kindFilter}`
	local keep = if c:GetAttribute("View") == view then c.CanvasPosition else Vector2.zero
	c:SetAttribute("View", view)
	c.CanvasPosition = Vector2.zero
	task.defer(function()
		c.CanvasPosition = keep
	end)
	if tab == "shop" then
		renderShop(c)
	elseif tab == "season" then
		renderSeason(c)
	elseif tab == "chests" then
		renderChests(c)
	elseif tab == "daily" then
		renderDaily(c)
	elseif tab == "collection" then
		renderCollection(c)
	else
		renderRobux(c)
	end
end

local function setOpen(value: boolean)
	local p = panel
	if not p then
		return
	end
	if value and not allowed() then
		setMessage(nil)
		toast({ S.blocked }, Theme.TextDim, 3)
		return
	end
	if value == isOpen then
		return
	end
	isOpen = value
	p.Visible = value
	if value then
		track("open")
		mouseWasEnabled = UserInputService.MouseIconEnabled
		UserInputService.MouseIconEnabled = true
		setMessage(nil)
		render()
	else
		UserInputService.MouseIconEnabled = mouseWasEnabled
		if overlay then
			overlay.Visible = false
		end
	end
end

local function build()
	local screen = Create("ScreenGui", {
		Name = "StoreUi",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		-- Camadas por hierarquia: diálogos dentro do Overlay ficam acima do véu escuro.
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 220,
		Parent = player:WaitForChild("PlayerGui"),
	}) :: ScreenGui

	toastHolder = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 60),
		Size = UDim2.fromOffset(340, 500),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	}) :: Frame

	hintLabel = label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -40),
		Size = UDim2.fromOffset(160, 16),
		Text = S.hint,
		TextSize = Theme.SizeSmall,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Parent = screen,
	})

	local p = Create("Frame", {
		Name = "Store",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.9),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Visible = false,
		Parent = screen,
	}, {
		Create("UISizeConstraint", { MaxSize = Vector2.new(1180, 780) }),
	}) :: Frame
	Components.corner(p, Theme.CornerLarge)
	Components.stroke(p, Theme.Gold, 1, 0.55)
	panel = p
	-- Modal: libera o mouse da trava de primeira pessoa enquanto a loja está aberta.
	Create("TextButton", {
		Name = "MouseRelease",
		Size = UDim2.fromScale(0, 0),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		Parent = p,
	})

	-- Barra superior: título, moedas, nível/XP e fechar.
	local top = Create("Frame", {
		Name = "TopBar",
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.new(1, -32, 0, 48),
		BackgroundTransparency = 1,
		Parent = p,
	})
	Components.icon(top, "Store", 24, Theme.Gold, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
	})
	local title = Components.title({
		Name = "Title",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 34, 0.5, 0),
		Size = UDim2.fromOffset(160, 34),
		Text = S.title,
		TextSize = 26,
		TextColor3 = Theme.GoldLight,
		Parent = top,
	})
	title.TextStrokeColor3 = Theme.Overlay
	title.TextStrokeTransparency = 0.3
	local status = Create("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.new(1, -180, 1, 0),
		BackgroundTransparency = 1,
		Parent = top,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local _, setF =
		Components.currency("fichas", { Size = UDim2.fromOffset(124, 38), LayoutOrder = 1, Parent = status })
	local _, setC =
		Components.currency("creditos", { Size = UDim2.fromOffset(124, 38), LayoutOrder = 2, Parent = status })
	setFichasBadge, setCreditosBadge = setF, setC
	local level = Create("Frame", {
		Name = "Level",
		Size = UDim2.fromOffset(150, 38),
		BackgroundColor3 = Theme.BgSunken,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Parent = status,
	}) :: Frame
	Components.corner(level, Theme.CornerPill)
	Components.stroke(level, Theme.Success, 1, 0.55)
	levelChip = Components.text({
		Name = "LevelText",
		Position = UDim2.fromOffset(12, 3),
		Size = UDim2.new(1, -24, 0, 18),
		FontFace = Theme.Font,
		TextSize = 13,
		TextWrapped = false,
		TextColor3 = Theme.TextPrimary,
		Text = "",
		Parent = level,
	})
	local xpTrack, setXp = Components.progress({
		Name = "Xp",
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.new(1, -24, 0, 5),
	}, Theme.Success)
	xpTrack.Parent = level
	setXpBar = setXp
	local close = Components.iconButton("secondary", "Close", "FECHAR", {
		Name = "Close",
		Size = UDim2.fromOffset(124, 44),
		TextSize = 15,
		LayoutOrder = 4,
		Parent = status,
	}, function()
		AudioController.play("UiBlip", 1, 1.1, true)
		setOpen(false)
	end)
	close:SetAttribute("Hint", S.close)

	-- Abas com ícones.
	local tabBar = Create("ScrollingFrame", {
		Name = "Tabs",
		Parent = p,
		Position = UDim2.fromOffset(16, 72),
		Size = UDim2.new(1, -32, 0, 48),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: ScrollingFrame
	for _, key in TABS do
		tabButtons[key :: Tab] = Components.iconButton("ghost", TAB_ICONS[key :: Tab], (S.tabs :: any)[key], {
			Name = `Tab_{key}`,
			Size = UDim2.fromOffset(132, 44),
			TextSize = 15,
			Parent = tabBar,
		}, function()
			AudioController.play("UiBlip", 1, 1.1, true)
			tab = key :: Tab
			track("view", key)
			setMessage(nil)
			render()
		end)
	end
	-- Filtro por tipo (só na aba LOJA).
	local kinds = Create("Frame", {
		Name = "Kinds",
		Position = UDim2.fromOffset(16, 128),
		Size = UDim2.new(1, -32, 0, 40),
		BackgroundTransparency = 1,
		Parent = p,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame
	kindsBar = kinds
	for i, kind in StoreCatalog.KINDS do
		kindButtons[kind] = button({
			Name = `Kind_{kind}`,
			Variant = "ghost",
			Size = UDim2.new(1 / #StoreCatalog.KINDS, -6, 1, 0),
			Text = (S.kinds :: any)[kind],
			TextSize = 14,
			LayoutOrder = i,
			Parent = kinds,
		}, function()
			kindFilter = kind :: StoreCatalog.ItemKind
			selectedItem = nil
			setMessage(nil)
			track("view", kind)
			tab = "shop"
			render()
		end)
	end
	content = Create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(16, 178),
		Size = UDim2.new(1, -32, 1, -230),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = p,
	}, {
		Create("UIPadding", {
			PaddingTop = UDim.new(0, 4),
			PaddingLeft = UDim.new(0, 2),
			PaddingRight = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 6),
		}),
	}) :: ScrollingFrame
	-- Painel de detalhe do item (PC); no toque o detalhe abre por cima (openDetailModal).
	local d = Components.panel({
		Name = "Detail",
		BackgroundColor3 = Theme.BgPanel,
		BackgroundTransparency = 0.05,
		Parent = p,
	})
	Components.padding(d, 12)
	detail = d
	message = label({
		Name = "Message",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -10),
		Size = UDim2.new(1, -32, 0, 30),
		Text = "",
		TextSize = 14,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = p,
	})
	overlay = Create("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Overlay,
		BackgroundTransparency = 0.3,
		-- Ativo: cliques no véu não atravessam para abas e cartões atrás do diálogo.
		Active = true,
		Visible = false,
		ZIndex = 5,
		Parent = p,
	}) :: Frame
	local last = ""
	RunService.RenderStepped:Connect(function()
		local touch = UserInputService.TouchEnabled
		if isOpen then
			-- Mudou a classe da tela (rotação, janela, simulação no Studio): redistribui e redesenha.
			local qaWidth, qaHeight = ViewportQA.size()
			local viewport = workspace.CurrentCamera.ViewportSize
			local key = `{qaWidth or 0}x{qaHeight or 0}/{math.floor(viewport.X)}x{math.floor(viewport.Y)}`
			if key ~= last then
				last = key
				if not animating and not (overlay and overlay.Visible) then
					render()
				end
			end
			-- No toque, sobram só ícone e moedas na barra superior.
			close.Size = if compactStore then UDim2.fromOffset(44, 44) else UDim2.fromOffset(124, 44)
			local closeLabel = close:FindFirstChild("Label")
			if closeLabel and closeLabel:IsA("GuiObject") then
				closeLabel.Visible = not compactStore
			end
			local closeIcon = close:FindFirstChild("IconSlot")
			if closeIcon and closeIcon:IsA("GuiObject") then
				closeIcon.AnchorPoint = if compactStore then Vector2.new(0.5, 0.5) else Vector2.new(0, 0.5)
				closeIcon.Position = if compactStore then UDim2.fromScale(0.5, 0.5) else UDim2.new(0, 14, 0.5, 0)
			end
			level.Visible = not compactStore
			title.Visible = not (compactStore and p.AbsoluteSize.X < 560)
		end
		if touch and toastHolder then
			toastHolder.Visible = player:GetAttribute("ModeMenuOpen") ~= true
				and player:GetAttribute("FieldGuideOpen") ~= true
				and player:GetAttribute("ComfortMenuOpen") ~= true
				and player:GetAttribute("TouchBackpackOpen") ~= true
		end
		if hintLabel and touch then
			hintLabel.Visible = false
		end
	end)
end

local StoreController = {
	Name = "StoreController",
}

function StoreController.isOpen(): boolean
	return isOpen
end

function StoreController.setOpen(value: boolean)
	setOpen(value)
end

-- Abre numa aba (menu inicial: LOJA, PASSE, RECOMPENSAS, ROBUX).
function StoreController.openTab(key: string)
	if table.find(TABS, key :: Tab) then
		tab = key :: Tab
		track("view", key)
	end
	if isOpen then
		setMessage(nil)
		render()
	else
		setOpen(true)
	end
end

function StoreController.Init()
	build()
end

function StoreController.Start()
	GameState.observe(function(snapshot)
		phase = snapshot.phase
		if isOpen and not allowed() then
			setOpen(false)
		end
		if hintLabel then
			hintLabel.Visible = allowed() and phase ~= "Loading"
		end
	end)
	player:GetAttributeChangedSignal("CampaignStatus"):Connect(function()
		if isOpen and not allowed() then
			setOpen(false)
		end
		if hintLabel then
			hintLabel.Visible = allowed() and phase ~= "Loading"
		end
	end)
	-- Qualquer mudança de saldo/itens redesenha a loja aberta.
	for _, name in
		{
			"Fichas",
			"Creditos",
			"Xp",
			"Owned",
			"Tapes",
			"EquipFlashlight",
			"EquipUniform",
			"EquipFilter",
			"Title",
			"Vip",
			"SpinsLeft",
			"DailyClaimable",
			"DailyStreak",
			"StarterBought",
			"SeasonId",
			"SeasonXp",
			"SeasonPremium",
		}
	do
		player:GetAttributeChangedSignal(name):Connect(function()
			if isOpen and not animating and not (overlay and overlay.Visible) then
				render()
			end
		end)
	end
	-- QA no Studio (automação sem foco de janela): o atributo StoreQARequest executa o mesmo
	-- caminho dos cliques. "kind:uniform" | "select:<id>" | "detail:<id>" | "confirm:<id>:fichas|creditos".
	if RunService:IsStudio() then
		player:GetAttributeChangedSignal("StoreQARequest"):Connect(function()
			local raw = player:GetAttribute("StoreQARequest")
			if type(raw) ~= "string" then
				return
			end
			local command, arg, extra = string.match(raw, "^(%a+):([%w_]+):?(%a*)$")
			local item = if arg then StoreCatalog.ItemById[arg] else nil
			if command == "kind" and table.find(StoreCatalog.KINDS, arg :: any) then
				tab, kindFilter, selectedItem = "shop", arg :: any, nil
				render()
			elseif command == "select" and item then
				tab, kindFilter, selectedItem = "shop", item.kind, item.id
				render()
			elseif command == "detail" and item then
				openDetailModal(item)
			elseif command == "confirm" and item then
				for _, option in StoreView.prices(item, walletOf("fichas"), walletOf("creditos")) do
					if option.currency == extra then
						confirmPurchase(item, option)
					end
				end
			elseif command == "buy" and item and (extra == "fichas" or extra == "creditos") then
				-- Equivale a tocar CONFIRMAR no diálogo.
				purchase(item, extra :: StoreCatalog.Currency)
			elseif command == "tab" and table.find(TABS, arg :: any) then
				tab = arg :: Tab
				render()
			elseif command == "press" and arg and qaActions[arg] then
				qaActions[arg]()
			elseif command == "close" then
				if overlay then
					overlay.Visible = false
				end
			end
		end)
	end
	task.spawn(function()
		local ok, remote = pcall(Remotes.clientEvent, "StoreNotice", 30)
		if ok then
			remote.OnClientEvent:Connect(function(payload: any)
				if type(payload) == "table" then
					onNotice(payload)
				end
			end)
		end
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.L or input.KeyCode == Enum.KeyCode.ButtonSelect then
			setOpen(not isOpen)
		end
	end)
end

return StoreController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="347">
          <Properties>
            <string name="Name">StoryController</string>
            <string name="Source"><![CDATA[--!strict
-- Usa a câmera/cenas do outro controller; não cria um segundo compositor de câmera.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Story = require("@game/ReplicatedStorage/Shared/Game/StoryCatalog")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Create = require("../UI/Create")
local Cinema = require("./CinematicController")
local Transition = require("./TransitionController")

local Controller = { Name = "StoryController" }
local player = Players.LocalPlayer
function Controller.Start()
	if GameState.wait():GetAttribute("CampaignActive") ~= true then
		return
	end
	local state = ReplicatedStorage:WaitForChild("CampaignState")
	local gui = Create("ScreenGui", {
		Name = "StoryUi",
		Parent = player:WaitForChild("PlayerGui"),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 65,
		Enabled = false,
	}) :: ScreenGui
	local function text(name: string, y: number, height: number): TextLabel
		return Create("TextLabel", {
			Name = name,
			Parent = gui,
			Position = UDim2.fromScale(0.17, y),
			Size = UDim2.fromScale(0.66, height),
			BackgroundColor3 = Color3.fromRGB(8, 14, 16),
			BackgroundTransparency = 0.12,
			TextColor3 = Color3.fromRGB(230, 216, 180),
			Font = Enum.Font.Code,
			TextSize = 17,
			Text = "",
			TextWrapped = true,
			BorderSizePixel = 0,
		}) :: TextLabel
	end
	local revelation = text("RecoveredRecording", 0.72, 0.13)
	-- Objetivo unificado no CampaignUi; aqui ficam somente gravações e cenas.
	revelation.AnchorPoint = Vector2.new(0.5, 1)
	revelation.Position = UDim2.new(0.5, 0, 1, -150)
	revelation.Size = UDim2.new(0.78, 0, 0, 84)
	revelation.TextScaled = true
	Create("UITextSizeConstraint", { Parent = revelation, MinTextSize = 14, MaxTextSize = 17 })
	local endingAt = 0
	local ending = text("Continues", 0, 1)
	ending.Position, ending.Size = UDim2.fromScale(0, 0), UDim2.fromScale(1, 1)
	ending.BackgroundColor3, ending.BackgroundTransparency, ending.TextSize = Color3.new(0, 0, 0), 0, 32
	ending.Text, ending.Visible = "CONTINUA...", false
	local previous = ""
	local lastSolved = 0
	local revealUntil = 0
	RunService:BindToRenderStep("S9Story", Enum.RenderPriority.Camera.Value - 1, function()
		local active = state:GetAttribute("GameMode") == "Story" and state:GetAttribute("Phase") ~= "Lobby"
		gui.Enabled = active and player:GetAttribute("CinematicActive") ~= true
		ending.Visible = false
		if not active then
			endingAt = 0
			previous, lastSolved = "", 0
			return
		end
		local stage = (state:GetAttribute("Stage") or 0) :: number
		local chapter = Story.Chapters[stage]
		if not chapter then
			return
		end
		local now = workspace:GetServerTimeNow()
		local endsAt = (state:GetAttribute("StorySceneEndsAt") or 0) :: number
		local key = `{state:GetAttribute("StorySceneSerial")}:{stage}`
		if endsAt > now and key ~= previous then
			previous, lastSolved = key, 0
			revealUntil = 0
			Cinema.play(Story.Scenes[stage])
			Transition.caption(nil)
		end
		local phase = tostring(state:GetAttribute("Phase"))
		local solved = (state:GetAttribute("Solved") or 0) :: number
		if solved > lastSolved then
			revelation.Text = chapter.objectives[solved].revelation
			revealUntil = now + 10
		end
		lastSolved = solved
		if phase == "Won" then
			if endingAt == 0 then
				endingAt = now
			end
			-- O CinematicController apresenta o epílogo nos dois modos, inclusive após pular a cena.
			ending.Visible = false
			local remaining = math.max(0, math.ceil((tonumber(state:GetAttribute("LobbyReturnAt")) or now) - now))
			ending.Text = `CONTINUA...\nA MANSÃO DO ARMADILHO\nVoltando ao lobby com a equipe em {remaining}s`
			ending.TextSize = 24
			revelation.Text = Story.Ending
		end
		revelation.Visible = not ending.Visible
			and (phase == "Won" or ((phase == "Playing" or phase == "Extracting") and now < revealUntil))
			and player:GetAttribute("FieldGuideOpen") ~= true
		if endsAt <= now and phase == "Playing" and string.sub(Cinema.debugState().sequence, 1, 5) == "Story" then
			Cinema.stop()
		end
	end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="348">
          <Properties>
            <string name="Name">TelevisionController</string>
            <string name="Source"><![CDATA[--!strict
-- Atualização limitada a 8 Hz e só perto da TV; nenhuma câmera ou regra de missão é alterada.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Broadcast = require("@game/ReplicatedStorage/Shared/Game/HouseBroadcast")
local Settings = require("./SettingsController")
local Controller = { Name = "TelevisionController" }
function Controller.Start()
	local elapsed = 0
	local screens: { [BasePart]: boolean } = {}
	local function track(inst: Instance)
		if inst:IsA("BasePart") then
			screens[inst] = true
		end
	end
	for _, inst in CollectionService:GetTagged("HouseTelevision") do
		track(inst)
	end
	CollectionService:GetInstanceAddedSignal("HouseTelevision"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("HouseTelevision"):Connect(function(inst)
		if inst:IsA("BasePart") then
			screens[inst] = nil
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.125 then
			return
		end
		elapsed = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local state = ReplicatedStorage:FindFirstChild("CampaignState")
		local stage = math.clamp(tonumber(state and state:GetAttribute("Stage")) or 1, 1, #Broadcast)
		local now = workspace:GetServerTimeNow()
		for screen in screens do
			if not screen.Parent or (camera.CFrame.Position - screen.Position).Magnitude > 55 then
				continue
			end
			local gui = screen:FindFirstChildOfClass("SurfaceGui")
			local label = gui and gui:FindFirstChildOfClass("TextLabel")
			if label then
				local phase = state and state:GetAttribute("Phase")
				local line = math.floor(now / 6) % #Broadcast[stage] + 1
				label.Text = if phase == "Extracting" or phase == "Won"
					then "CANAL 03 / AO VIVO\nSAIAM. AGORA."
					else string.format("CANAL 03 / FITA %02d\n%s", stage, Broadcast[stage][line])
			end
			local scan = gui and gui:FindFirstChild("Scan")
			if scan and scan:IsA("Frame") then
				scan.Visible = Settings.motionEnabled() and Settings.get("flashes")
				scan.Position = UDim2.fromScale(0, (now * 0.12) % 1)
			end
		end
	end)
	-- Mantém o ciclo de vida associado ao controller, sem remotes ou objetos por quadro.
	Players.LocalPlayer:SetAttribute("TelevisionReady", true)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="349">
          <Properties>
            <string name="Name">TensionController</string>
            <string name="Source"><![CDATA[--!strict
-- Executa o diretor puro. Eventos são locais, canceláveis e nunca movem colisores do servidor.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Director = require("@game/ReplicatedStorage/Shared/Game/TensionDirector")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local Audio = require("./AudioController")
local Fear = require("./FearController")
local Flashlight = require("./FlashlightController")
local Settings = require("./SettingsController")
local WorldFx = require("./WorldFxController")

local player = Players.LocalPlayer
local rng = Random.new()
local director = Director.new(function()
	return rng:NextNumber()
end, os.clock())
local snapshot: GameState.Snapshot? = nil
local generation = 0
local effects: Folder? = nil
local hiddenParts: { [BasePart]: number } = {}
local sounds: { Sound } = {}
local running = false
local eventCounts: { [string]: number } = {}
local lastWarning = 0
local visualsCreated = 0

local function cleanup()
	generation += 1
	for part, previous in hiddenParts do
		if part.Parent then
			part.LocalTransparencyModifier = previous
		end
	end
	table.clear(hiddenParts)
	for _, sound in sounds do
		if sound.Parent then
			sound:Destroy()
		end
	end
	table.clear(sounds)
	if effects then
		effects:Destroy()
		effects = nil
	end
end

local function rootPart(): BasePart?
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	return if root and root:IsA("BasePart") then root else nil
end

local function context(): Director.Context
	local s = snapshot
	local camera = workspace.CurrentCamera
	local root = rootPart()
	local status = player:GetAttribute("CampaignStatus") :: string?
	local mode = Presentation.mode(
		if root then (root:GetAttribute(Tags.Attr.CreatureMode) :: string?) or "Dormant" else "Dormant",
		if root then root:GetAttribute(Tags.Attr.ThreatTargetUserId) :: number? else nil,
		player.UserId,
		status
	)
	local campaign = ReplicatedStorage:FindFirstChild("CampaignState")
	local progress = if s then math.min(4, s.fusesCollected + (if s.powerOn then 1 else 0)) else 0
	if campaign then
		local stage = (campaign:GetAttribute("Stage") :: number?) or 0
		local solved = (campaign:GetAttribute("Solved") :: number?) or 0
		progress = math.clamp(stage - 1 + (if solved > 0 then 1 else 0), 0, 4)
	end
	return {
		now = os.clock(),
		playing = s ~= nil and Presentation.playing(s.phase, status),
		creatureActive = root ~= nil and root:GetAttribute(Tags.Attr.CreatureActive) == true,
		creatureMode = mode,
		creatureDistance = if root and camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge,
		fear = Fear.get(),
		darkness = Fear.darkness(),
		zone = Audio.zone(),
		progress = progress,
		hidden = type(player:GetAttribute("Hidden")) == "string" and player:GetAttribute("Hidden") ~= "",
	}
end

local function soundAt(name: string, position: Vector3, volume: number?, speed: number?)
	table.insert(sounds, Audio.playAtPosition(name, position, volume, speed))
end

local function parameters(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = {}
	for _, member in Players:GetPlayers() do
		if member.Character then
			table.insert(exclude, member.Character)
		end
	end
	for _, name in { Tags.CreatureModel, "VigiaVisual", "TensionLocal" } do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(exclude, instance)
		end
	end
	params.FilterDescendantsInstances = exclude
	return params
end

local function apparition(name: string, token: number)
	local camera = workspace.CurrentCamera
	if not camera or not effects then
		return
	end
	local eyes = name == "eyes"
	local angle = math.rad(
		if eyes then rng:NextNumber(-10, 10) else rng:NextNumber(35, 55) * (if rng:NextNumber() < 0.5 then -1 else 1)
	)
	local position = (camera.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -rng:NextNumber(18, 26))).Position
	if workspace:Raycast(camera.CFrame.Position, position - camera.CFrame.Position, parameters()) then
		return
	end
	local figure = Instance.new("Model")
	figure.Name = name
	figure.Parent = effects
	visualsCreated += 1
	for i = 1, 2 do
		local part = Instance.new("Part")
		part.Name = if eyes then "Eye" else "Silhouette"
		part.Size = if eyes
			then Vector3.new(0.12, 0.12, 0.12)
			else (if i == 1 then Vector3.new(1.5, 4.8, 0.7) else Vector3.new(1, 1.3, 0.8))
		part.Color = if eyes then Color3.fromRGB(140, 155, 100) else Color3.new(0.02, 0.02, 0.02)
		part.Material = if eyes then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.CFrame = CFrame.new(
			position
				+ (
					if eyes
						then Vector3.new((i - 1.5) * 0.55, 0, 0)
						else Vector3.new(0, if i == 1 then -1.3 else 1.7, 0)
				)
		)
		part.Parent = figure
	end
	if not eyes then
		Fear.spike(0.12)
	end
	local untilAt = os.clock() + (if eyes then 2.2 else 0.7)
	while token == generation and os.clock() < untilAt do
		local current = workspace.CurrentCamera
		if not current then
			break
		end
		local direction = position - current.CFrame.Position
		if direction.Magnitude < 0.1 then
			break
		end
		local aligned = current.CFrame.LookVector:Dot(direction.Unit)
		if aligned > math.cos(math.rad(if eyes then 12 else 15)) and (not eyes or Flashlight.isOn()) then
			break
		end
		task.wait(0.05)
	end
	figure:Destroy()
end

local function moveVisual(name: string, token: number)
	local camera = workspace.CurrentCamera
	local world = workspace:FindFirstChild(Tags.WorldFolder)
	local folder = world and world:FindFirstChild(if name == "door_twitch" then "Doors" else "Props")
	if not camera or not folder or not effects then
		return
	end
	local count = 0
	for _, item in folder:GetDescendants() do
		if not item:IsA("BasePart") then
			continue
		end
		local distance = (item.Position - camera.CFrame.Position).Magnitude
		local _, onScreen = camera:WorldToViewportPoint(item.Position)
		local door = name == "door_twitch"
			and string.sub(item.Name, 1, 5) == "door_"
			and item:GetAttribute("DoorState") == "closed"
		local small = name ~= "door_twitch" and item.Size.Magnitude < 3.5 and not item:FindFirstChildWhichIsA("Light")
		if distance > (if door then 20 else 14) or not (door or small) or (name == "object_shift" and onScreen) then
			continue
		end
		local clone = item:Clone()
		clone:ClearAllChildren()
		for _, tag in CollectionService:GetTags(clone) do
			CollectionService:RemoveTag(clone, tag)
		end
		clone.Anchored = true
		clone.CanCollide = false
		clone.CanQuery = false
		clone.CanTouch = false
		clone.LocalTransparencyModifier = 0
		clone.Parent = effects
		visualsCreated += 1
		hiddenParts[item] = item.LocalTransparencyModifier
		item.LocalTransparencyModifier = 1
		local base = item.CFrame
		local started = os.clock()
		while token == generation and os.clock() - started < 1.2 and item.Parent and item.CFrame == base do
			local elapsed = os.clock() - started
			clone.CFrame = if name == "object_shift"
				then base * CFrame.new(0.6, 0, 0) * CFrame.Angles(0, math.rad(15), 0)
				elseif door then base * CFrame.Angles(0, math.sin(elapsed * 8) * math.rad(2), 0)
				else base * CFrame.new(math.sin(elapsed * 40) * 0.035, 0, 0)
			task.wait(1 / 30)
		end
		if item.Parent and hiddenParts[item] ~= nil then
			item.LocalTransparencyModifier = hiddenParts[item]
		end
		hiddenParts[item] = nil
		clone:Destroy()
		count += 1
		if count >= 1 then
			break
		end
	end
	if count > 0 then
		soundAt("DoorRattle", camera.CFrame.Position, 0.25)
	end
end

local function perform(name: string, token: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	eventCounts[name] = (eventCounts[name] or 0) + 1
	local origin = camera.CFrame.Position
	if name == "flicker" or name == "false_alarm" then
		if Settings.get("flashes") then
			WorldFx.surge(1.2, origin, 18)
			Flashlight.flicker(1)
		end
		if name == "false_alarm" then
			soundAt("Snarl", origin - camera.CFrame.LookVector * 30, 0.5)
		end
	elseif name == "distant_steps" then
		local position = origin - camera.CFrame.LookVector * 30
		-- Busca um ponto atrás de obstáculo para não representar o Vigia à vista.
		local hit = workspace:Raycast(origin, position - origin, parameters())
		if not hit then
			return
		end
		for _ = 1, 5 do
			if token ~= generation then
				return
			end
			soundAt("CreatureStep", position, 0.45, 0.55)
			task.wait(0.5)
		end
	elseif name == "radio_static" then
		local world = workspace:FindFirstChild(Tags.WorldFolder)
		local features = world and world:FindFirstChild("Features")
		local radio = features and features:FindFirstChild("GuardRadio")
		local body = radio and radio:FindFirstChild("Radio")
		if body and body:IsA("BasePart") then
			soundAt("RadioStatic", body.Position, 0.65)
		end
		local led = radio and radio:FindFirstChild("Led")
		if led and led:IsA("BasePart") then
			hiddenParts[led] = led.LocalTransparencyModifier
			local untilAt = os.clock() + 1.8
			while token == generation and led.Parent and os.clock() < untilAt do
				led.LocalTransparencyModifier = if math.floor(os.clock() * 8) % 2 == 0 then 0 else 0.85
				task.wait(0.125)
			end
			if led.Parent and hiddenParts[led] ~= nil then
				led.LocalTransparencyModifier = hiddenParts[led]
			end
			hiddenParts[led] = nil
		end
	elseif name == "whisper" then
		table.insert(sounds, Audio.play("Whisper", 0.3))
	elseif name == "silhouette" or name == "eyes" then
		apparition(name, token)
	elseif name == "vibrate" or name == "door_twitch" or name == "object_shift" then
		moveVisual(name, token)
	end
end

local function schedule(name: string, silence: boolean)
	cleanup()
	local token = generation
	local folder = Instance.new("Folder")
	folder.Name = "TensionLocal"
	folder.Parent = workspace
	effects = folder
	if silence then
		Audio.silence(Config.Tension.SilenceBefore)
	end
	task.spawn(function()
		if silence then
			task.wait(Config.Tension.SilenceBefore)
		end
		local ctx = context()
		if
			token ~= generation
			or not ctx.playing
			or ctx.hidden
			or ctx.creatureMode == "Chase"
			or ctx.creatureMode == "Capture"
		then
			if token == generation then
				cleanup()
			end
			return
		end
		perform(name, token)
		task.wait(Director.EVENTS[name].duration)
		if token == generation then
			cleanup()
		end
	end)
end

local Controller = { Name = "TensionController" }

-- Ferramenta local de QA: sem remote e indisponível fora do Studio.
function Controller.preview(name: string): boolean
	local ctx = context()
	if
		not RunService:IsStudio()
		or not Director.EVENTS[name]
		or not ctx.playing
		or ctx.hidden
		or ctx.creatureMode == "Chase"
		or ctx.creatureMode == "Capture"
	then
		return false
	end
	schedule(name, false)
	return true
end

function Controller.debugState(): { [string]: any }
	return {
		state = director.state,
		log = table.clone(director.log),
		events = table.clone(eventCounts),
		generation = generation,
		visualsCreated = visualsCreated,
		active = running,
		localParts = if effects then #effects:GetDescendants() else 0,
	}
end

function Controller.Start()
	GameState.observe(function(next)
		local previous = snapshot
		snapshot = next
		if not previous or next.roundId ~= previous.roundId or next.phase == "Intro" and previous.phase ~= "Intro" then
			cleanup()
			Director.reset(director, os.clock())
		elseif next.creatureActive and not previous.creatureActive then
			Director.notify(director, os.clock(), "awaken", 3)
		end
	end)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < Config.Tension.TickInterval then
			return
		end
		local step = math.min(accumulator, 1)
		accumulator = 0
		local ctx = context()
		local active = ctx.playing and not ctx.hidden and ctx.creatureMode ~= "Chase" and ctx.creatureMode ~= "Capture"
		if running and not active then
			cleanup()
		end
		running = active
		local decision = Director.step(director, ctx, step)
		local music: Audio.MusicState = if not ctx.playing
			then "none"
			elseif decision.state == "Chase" then "chase"
			elseif decision.state == "Recovery" then "relief"
			elseif decision.state == "Tension" then "tension"
			else "calm"
		Audio.setMusicState(music)
		if decision.event then
			schedule(decision.event, decision.silence)
		end
		if active and ctx.creatureActive and ctx.creatureDistance < 18 and ctx.now - lastWarning > 6 then
			lastWarning = ctx.now
			local camera = workspace.CurrentCamera
			WorldFx.surge(0.3, if camera then camera.CFrame.Position else nil, 18)
		end
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="350">
          <Properties>
            <string name="Name">ThreatFeedbackController</string>
            <string name="Source"><![CDATA[--!strict
-- Captura é uma transição pessoal. Nunca prende a câmera de colegas ou de quem já foi resgatado.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/ThreatPresentation")
local Audio = require("./AudioController")
local Camera = require("./CameraController")
local Fear = require("./FearController")
local ScreenFx = require("./ScreenFxController")

local player = Players.LocalPlayer
local previousStatus: string? = nil
local previousPhase: string? = nil
local previousRound = -1
local previousMode = "Dormant"
local captureUntil = 0
local captureCount = 0
local chaseCount = 0

local function target(): Vector3?
	local visual = workspace:FindFirstChild("VigiaVisual")
	local head = visual and visual:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local model = workspace:FindFirstChild(Tags.CreatureModel)
	local root = model and model:FindFirstChild(Tags.CreatureRoot)
	return if root and root:IsA("BasePart") then root.Position + Vector3.new(0, 2, 0) else nil
end

local Controller = { Name = "ThreatFeedbackController" }

function Controller.debugState(): { [string]: any }
	return { captures = captureCount, chases = chaseCount, mode = previousMode, capturing = captureUntil > 0 }
end

function Controller.Start()
	-- Um único observador amostra fase/status juntos, evitando duplicar feedback por ordem de atributos.
	local state: GameState.Snapshot? = nil
	GameState.observe(function(next)
		state = next
	end)
	RunService.RenderStepped:Connect(function()
		local s = state
		if not s then
			return
		end
		local status = player:GetAttribute("CampaignStatus") :: string?
		local now = os.clock()
		local reset = previousRound ~= s.roundId or s.phase == "Intro" or s.phase == "Loading" or s.phase == "Won"
		if reset or (captureUntil > 0 and (now >= captureUntil or status == "Active")) then
			if captureUntil > 0 or previousRound ~= s.roundId then
				Camera.reset()
				ScreenFx.reset()
			end
			captureUntil = 0
		end
		if not reset and Presentation.captured(previousStatus, status, previousPhase, s.phase) then
			captureCount += 1
			captureUntil = now + 1.1
			Camera.capture(target)
			ScreenFx.capture()
			Fear.spike(0.45)
			Audio.muffle(1.2)
			-- O áudio de derrota solo já pertence ao AudioController. No coop o susto é pessoal.
			if status ~= nil then
				Audio.play("StingerCapture", 1, nil, true)
				Audio.play("Roar", 1, 0.8, true)
			end
		end
		local model = workspace:FindFirstChild(Tags.CreatureModel)
		local root = model and model:FindFirstChild(Tags.CreatureRoot)
		local mode = "Dormant"
		if root then
			mode = Presentation.mode(
				(root:GetAttribute(Tags.Attr.CreatureMode) :: string?) or "Dormant",
				root:GetAttribute(Tags.Attr.ThreatTargetUserId) :: number?,
				player.UserId,
				status
			)
		end
		if Presentation.playing(s.phase, status) and mode == "Chase" and previousMode ~= "Chase" then
			chaseCount += 1
			Camera.punch()
			Camera.addTrauma(0.35)
		end
		previousMode = mode
		previousStatus = status
		previousPhase = s.phase
		previousRound = s.roundId
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="351">
          <Properties>
            <string name="Name">TouchControlsController</string>
            <string name="Source"><![CDATA[--!strict
-- Ações nas bordas; movimento, pulo e arraste da câmera continuam com o Roblox.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Create = require("../UI/Create")
local Theme = require("../UI/Theme")
local Interaction = require("./InteractionController")
local GameUi = require("./GameUiController")
local Character = require("./CharacterController")
local Flashlight = require("./FlashlightController")
local Campaign = require("./CampaignController")
local Settings = require("./SettingsController")
local Spectator = require("./SpectatorController")
local Controller = { Name = "TouchControlsController" }
local player = Players.LocalPlayer

function Controller.Start()
	local gui = Create("ScreenGui", {
		Name = "HouseTouchControls",
		Parent = player:WaitForChild("PlayerGui"),
		ResetOnSpawn = false,
		DisplayOrder = 85,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ClipToDeviceSafeArea = true,
	}) :: ScreenGui
	local root = Create(
		"Frame",
		{ Name = "SafeArea", Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }
	) :: Frame
	local controls = Create("Frame", {
		Name = "Actions",
		Parent = root,
		AnchorPoint = Vector2.new(1, 1),
		BackgroundTransparency = 1,
	}) :: Frame
	local navigation = Create("Frame", {
		Name = "Navigation",
		Parent = root,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(156, 44),
		BackgroundTransparency = 1,
	}) :: Frame
	local function button(parent: Instance, name: string, title: string): TextButton
		return Create("TextButton", {
			Name = name,
			Parent = parent,
			Text = title,
			TextSize = 14,
			TextWrapped = true,
			FontFace = Theme.Font,
			TextColor3 = Theme.Text,
			BackgroundColor3 = Theme.Panel,
			BackgroundTransparency = 0.12,
			AutoButtonColor = true,
			BorderSizePixel = 0,
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 12) }),
			Create("UIStroke", { Color = Theme.Hazard, Thickness = 1, Transparency = 0.4 }),
		}) :: TextButton
	end
	local action = button(controls, "Interact", "AÇÃO")
	local sprint = button(controls, "Sprint", "CORRER")
	local crouch = button(controls, "Crouch", "AGACHAR")
	local light = button(controls, "Light", "LANTERNA")
	local pack = button(controls, "Backpack", "MOCHILA")
	local breath = button(controls, "Breath", "SEGURE\nO AR")
	local guide = button(navigation, "Guide", "GUIA")
	local options = button(navigation, "Options", "AJUSTES")
	guide.Size, options.Size = UDim2.fromOffset(74, 44), UDim2.fromOffset(74, 44)
	options.Position = UDim2.fromOffset(82, 0)

	local inventory = Create("Frame", {
		Name = "Inventory",
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		BorderSizePixel = 0,
	}, { Create("UICorner", { CornerRadius = Theme.Corner }), Create("UIStroke", { Color = Theme.Hazard }) }) :: Frame
	local inventoryTitle = Create("TextLabel", {
		Name = "TeamItems",
		Parent = inventory,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -112, 0, 54),
		Text = "MOCHILA",
		TextSize = 14,
		TextWrapped = true,
		FontFace = Theme.Font,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel
	local close = button(inventory, "Close", "FECHAR")
	close.Position, close.Size = UDim2.new(1, -94, 0, 10), UDim2.fromOffset(82, 44)
	close.Modal = true
	local open = false
	local function closePack()
		open = false
		player:SetAttribute("TouchBackpackOpen", false)
	end
	close.Activated:Connect(closePack)
	local heldBreath: InputObject? = nil
	local breathConnection: RBXScriptConnection? = nil
	local function releaseBreath()
		if breathConnection then
			breathConnection:Disconnect()
			breathConnection = nil
		end
		heldBreath = nil
		Interaction.requestBreath(false)
	end
	local function cancel()
		releaseBreath()
		player:SetAttribute("TouchSprint", false)
	end
	breath.InputBegan:Connect(function(input)
		if
			input.UserInputType ~= Enum.UserInputType.Touch
			and input.UserInputType ~= Enum.UserInputType.MouseButton1
		then
			return
		end
		releaseBreath()
		heldBreath = input
		Interaction.requestBreath(true)
		breathConnection = input:GetPropertyChangedSignal("UserInputState"):Connect(function()
			if
				input.UserInputState == Enum.UserInputState.End
				or input.UserInputState == Enum.UserInputState.Cancel
			then
				releaseBreath()
			end
		end)
	end)
	Input.InputEnded:Connect(function(input)
		if input == heldBreath then
			releaseBreath()
		end
	end)
	Input.WindowFocusReleased:Connect(cancel)
	GuiService.MenuOpened:Connect(cancel)
	for _, name in
		{
			"CampaignStatus",
			"CinematicActive",
			"ComfortMenuOpen",
			"FieldGuideOpen",
			"TouchBackpackOpen",
			"NoteOpen",
			"Hidden",
		}
	do
		player:GetAttributeChangedSignal(name):Connect(cancel)
	end
	player.CharacterAdded:Connect(function()
		cancel()
		closePack()
	end)
	action.Activated:Connect(function()
		if
			not GameUi.isNoteOpen()
			and (player:GetAttribute("Hidden") or "") == ""
			and Interaction.currentTarget() == nil
		then
			GameUi.caption("Chegue perto e mire no objeto para usar AÇÃO.", 2)
		else
			Interaction.activate()
		end
	end)
	sprint.Activated:Connect(function()
		player:SetAttribute("TouchSprint", player:GetAttribute("TouchSprint") ~= true)
	end)
	light.Activated:Connect(function()
		Flashlight.set(not Flashlight.isWanted())
	end)
	crouch.Activated:Connect(function()
		Character.requestStance(if Character.getMotion().stance == "Stand" then "Crouch" else "Stand")
	end)
	pack.Activated:Connect(function()
		open = not open
		player:SetAttribute("TouchBackpackOpen", open)
	end)
	guide.Activated:Connect(function()
		closePack()
		Campaign.toggleGuide()
	end)
	options.Activated:Connect(function()
		closePack()
		Settings.toggleMenu()
	end)
	local stockButtons: { [string]: TextButton } = {}
	local stockLabels = {
		battery = "PILHA — recarregar lanterna",
		oxygen = "AR EXTRA — recuperar oxigênio",
		decoy = "ISCA — distrair o Tung Tung",
	}
	local stockValues: { [string]: number } = {}
	for index, item in { "battery", "oxygen", "decoy" } do
		local b = button(inventory, item, item)
		b.Position, b.Size = UDim2.fromOffset(12, 68 + (index - 1) * 52), UDim2.new(1, -24, 0, 44)
		b.Modal = true
		stockButtons[item] = b
		b.Activated:Connect(function()
			if (stockValues[item] or 0) > 0 then
				Interaction.useSupply(item)
				closePack()
			end
		end)
	end
	local function stock()
		local raw = player:GetAttribute("HouseSupplies")
		stockValues = if type(raw) == "string" then HttpService:JSONDecode(raw) else {}
		for item, b in stockButtons do
			local count = stockValues[item] or 0
			b.Text = `{stockLabels[item]} ×{count}`
			b.TextTransparency = if count > 0 then 0 else 0.55
			b.Active, b.AutoButtonColor = count > 0, count > 0
		end
	end
	player:GetAttributeChangedSignal("HouseSupplies"):Connect(stock)
	stock()
	local watching = Create("Frame", {
		Name = "Spectate",
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(224, 44),
		BackgroundTransparency = 1,
	}) :: Frame
	local previous, nextPlayer = button(watching, "Previous", "◀ COLEGA"), button(watching, "Next", "COLEGA ▶")
	previous.Size, nextPlayer.Size = UDim2.fromOffset(108, 44), UDim2.fromOffset(108, 44)
	nextPlayer.Position = UDim2.fromOffset(116, 0)
	previous.Activated:Connect(function()
		Spectator.cycle(-1)
	end)
	nextPlayer.Activated:Connect(function()
		Spectator.cycle(1)
	end)

	local elapsed = 0
	RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0
		gui.Enabled = Input.TouchEnabled
		local w, h = root.AbsoluteSize.X, root.AbsoluteSize.Y
		local width = math.clamp(w * 0.29, 210, 252)
		local cell, height = (width - 12) / 3, 52
		local bottom = if w >= 900 then 148 else 112
		local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
		local jump = touchGui and touchGui:FindFirstChild("JumpButton", true)
		if jump and jump:IsA("GuiObject") and jump.Visible then
			bottom = math.max(bottom, h - (jump.AbsolutePosition.Y - root.AbsolutePosition.Y) + 12)
		end
		controls.Size, controls.Position = UDim2.fromOffset(width, height * 2 + 8), UDim2.new(1, -8, 1, -bottom)
		for index, b in { crouch, sprint, action, light, pack, breath } do
			b.Size = UDim2.fromOffset(cell, height)
			b.Position = UDim2.fromOffset(((index - 1) % 3) * (cell + 6), math.floor((index - 1) / 3) * (height + 8))
		end
		inventory.Size = UDim2.fromOffset(math.min(400, w - 24), 228)
		local state = ReplicatedStorage:FindFirstChild("CampaignState")
		local phase = if state then state:GetAttribute("Phase") else GameState.get("Phase")
		local status = player:GetAttribute("CampaignStatus")
		local cinema = player:GetAttribute("CinematicActive") == true
		local active = (phase == "Playing" or phase == "Extracting") and status == "Active"
		local menu = player:GetAttribute("ComfortMenuOpen") == true or player:GetAttribute("FieldGuideOpen") == true
		local hidden = type(player:GetAttribute("Hidden")) == "string" and player:GetAttribute("Hidden") ~= ""
		local note = GameUi.isNoteOpen()
		controls.Visible = active and not menu and not cinema and not open
		inventory.Visible = active and not menu and not cinema and open
		navigation.Visible = not cinema
			and not menu
			and (phase == "Playing" or phase == "Extracting" or phase == "Intermission")
		watching.Visible = not cinema
			and not menu
			and not open
			and (phase == "Playing" or phase == "Extracting")
			and (status == "Waiting" or status == "Downed" or status == "Escaped")
		breath.Visible = hidden and not note
		sprint.Visible, crouch.Visible = not hidden and not note, not hidden and not note
		light.Visible = not hidden and not note and player:GetAttribute("HasFlashlight") == true
		pack.Visible = not hidden and not note
		action.Text = if note
			then "FECHAR"
			elseif hidden then "SAIR"
			elseif (Interaction.currentTarget() or ""):find("rescue", 1, true) then "AJUDAR"
			else "AÇÃO"
		action.BackgroundColor3 = if hidden
				or note
				or Interaction.currentTarget() ~= nil
			then Theme.Accent
			else Theme.Panel
		sprint.Text = if player:GetAttribute("TouchSprint") == true then "CORRER\nLIGADO" else "CORRER"
		sprint.BackgroundColor3 = if player:GetAttribute("TouchSprint") == true then Theme.Accent else Theme.Panel
		crouch.Text = if Character.getMotion().stance == "Crouch" then "LEVANTAR" else "AGACHAR"
		light.Text = if Flashlight.isWanted() then "LUZ\nLIGADA" else "LANTERNA"
		breath.BackgroundColor3 = if heldBreath then Theme.Accent else Theme.Panel
		if not active or menu or cinema then
			closePack()
		end
		if not controls.Visible and (heldBreath or player:GetAttribute("TouchSprint") == true) then
			cancel()
		end
		if open and state then
			local items = HttpService:JSONDecode((state:GetAttribute("Inventory") or "{}") :: string)
			inventoryTitle.Text =
				`MOCHILA DO TIME\nCHAVES {(items.key_living or 0) + (items.key_kitchen or 0) + (items.key_dining or 0)}/3 · FUSÍVEIS {(items.fuse_1 or 0) + (items.fuse_2 or 0) + (items.fuse_3 or 0)}/3 · ARTEFATO {items.artifact or 0}`
		end
	end)
end
return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="352">
          <Properties>
            <string name="Name">TrailerController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Trailer de ~40 s do jogo, montado e tocado DENTRO do Roblox (só no Studio; nunca para jogadores).
	Gravado com OBS (janela do Studio + áudio do Studio): docs/TRAILER.md.

	Roteiro (segundos):
	   0.0  preto, drone, chiado; data e "a Subestação 9 parou de responder"
	   3.6  LOGO (impacto)
	   5.2  estrada -> portão; a equipe chega com lanternas
	  12.0  "ELES ENTRARAM JUNTOS."
	  13.2  corredor escuro: o Vigia no fundo; a luz falha e ele está mais perto
	  16.6  close do Vigia, rugido -> "O VIGIA"
	  18.5  montagem: RELIGUE A ENERGIA (painel, faíscas/explosão), ESCONDA-SE (armário),
	        perseguição, SALVE SUA EQUIPE, mapa novo, "ELE SEGUE A LUZ", FUJA (portão)
	  29.0  o Vigia avança na câmera -> corte seco com o maior impacto
	  30.0  silêncio, um batimento
	  31.6  LOGO final + modos + "EM BREVE NO ROBLOX"
	  40.0  fim

	Tudo é local (atores, luzes, UI e sons); a ponte "TrailerBridge" (PlayerGui, só Studio) prepara,
	toca, para e mostra um instante (seek) para conferir enquadramentos.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local PixelText = require("@game/ReplicatedStorage/Shared/Game/PixelText")
local Actors = require("../Trailer/TrailerActors")
local Create = require("../UI/Create")
local Theme = require("../UI/Theme")
local Camera = require("./CameraController")

local player = Players.LocalPlayer
local DURATION = 40
local LETTERBOX = (1 - (16 / 9) / 2.39) / 2

type Title = { t: number, d: number, text: string, sub: string?, color: Color3?, size: number? }
type Caption = { t: number, d: number, text: string }
type SoundCue = { t: number, key: string, volume: number?, speed: number?, stop: number? }
type Shot = {
	t: number,
	d: number,
	name: string,
	-- Câmera no progresso alpha (0..1) e tempo local (s).
	camera: (alpha: number, time: number) -> (CFrame, number),
	-- Atores e efeitos do plano (chamado a cada quadro com o tempo local).
	act: ((alpha: number, time: number, dt: number) -> ())?,
	shake: number?,
}

local Controller = { Name = "TrailerController" }

local enabled = false
local playing = false
local startedAt = 0
local armedAt: number? = nil
local seekTime: number? = nil
local lastTime = 0
local lastShot = ""
local gui: ScreenGui? = nil
local ui: { [string]: any } = {}
