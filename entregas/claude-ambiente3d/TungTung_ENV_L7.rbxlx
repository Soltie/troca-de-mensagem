        <Item class="ModuleScript" referent="419">
          <Properties>
            <string name="Name">ThreatPresentation</string>
            <string name="Source"><![CDATA[--!strict
-- Regras puras de apresentação: o estado global da criatura não é uma captura de toda a equipe.
local Config = require("../Config")

local Presentation = {}

function Presentation.playing(phase: string, status: string?): boolean
	return phase == "Playing" and (status == nil or status == "Active")
end

function Presentation.mode(mode: string, targetId: number?, userId: number, status: string?): string
	if status ~= nil and status ~= "Active" then
		return "Dormant"
	end
	if (mode == "Chase" or mode == "Capture") and targetId ~= userId then
		-- Compatibilidade solo com snapshots antigos; coop exige alvo explícito.
		if status == nil and (targetId == nil or targetId == 0) then
			return mode
		end
		return "Patrol"
	end
	return mode
end

function Presentation.captured(previousStatus: string?, status: string?, previousPhase: string?, phase: string): boolean
	if status ~= nil then
		return status == "Downed" and previousStatus ~= nil and previousStatus ~= "Downed"
	end
	return previousPhase ~= nil and previousPhase ~= "Lost" and phase == "Lost"
end

function Presentation.effects(fear: number, playing: boolean, flashes: boolean, retro: boolean)
	local value = if playing then math.clamp(fear, 0, 1) else 0
	local panic = math.clamp((value - 0.8) / 0.2, 0, 1)
	return {
		fear = value,
		vignette = if retro then value * 0.65 else 0,
		grain = if retro then value else 0,
		fog = if retro then value * value else 0,
		blur = if flashes then panic * Config.Effects.PanicBlur else 0,
		glitch = if flashes then panic else 0,
	}
end

return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="420">
          <Properties>
            <string name="Name">VisualQuality</string>
            <string name="Source"><![CDATA[--!strict
-- Política estável por sessão; não mede FPS nem força os gráficos do cliente Roblox.
local Quality = {}
export type Budget = {
	name: string,
	shadows: number,
	particles: number,
	detailDistance: number,
	bloom: number,
	depth: boolean,
	grain: number,
}
local budgets: { Budget } = {
	{ name = "Baixa", shadows = 0, particles = 0, detailDistance = 48, bloom = 0, depth = false, grain = 0 },
	{ name = "Média", shadows = 1, particles = 0.45, detailDistance = 90, bloom = 0.07, depth = false, grain = 0.35 },
	{ name = "Alta", shadows = 3, particles = 1, detailDistance = 145, bloom = 0.1, depth = true, grain = 1 },
}
function Quality.resolve(preference: number, touch: boolean, savedQuality: number): number
	if preference == 0.25 then
		return 1
	end
	if preference == 0.5 then
		return 2
	end
	if preference == 1 then
		return 3
	end
	-- Automático do Roblox não expõe um nível efetivo confiável: padrão conservador médio.
	if savedQuality > 0 then
		return if savedQuality <= 3 then 1 elseif savedQuality <= 7 then 2 else 3
	end
	return if touch then 1 else 2
end
function Quality.budget(level: number, shaders: boolean): Budget
	local source = budgets[math.clamp(math.floor(level), 1, 3)]
	return {
		name = source.name,
		shadows = if shaders then source.shadows else 0,
		particles = if shaders then source.particles else 0,
		detailDistance = source.detailDistance,
		bloom = if shaders then source.bloom else 0,
		depth = shaders and source.depth,
		grain = if shaders then source.grain else 0,
	}
end
return table.freeze(Quality)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="421">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!strict
-- Chuva e relâmpagos: números puros (sem engine), testados no Lune. O RainController aplica no cliente.
local Weather = {}

Weather.RainRate = 2700 -- gotas/s em qualidade Alta, ao ar livre (somando as células)
Weather.SplashRate = 400 -- respingos/s no chão em volta da câmera
Weather.MinBudget = 0.3 -- qualidade Baixa ainda chove (menos), só sem os efeitos opcionais
Weather.IndoorVolume = 0.35 -- chuva ouvida de dentro de casa, abafada
Weather.FlashPeak = 0.22 -- brilho extra máximo do relâmpago (ColorCorrection.Brightness)

-- Rajadas lentas: a intensidade varia sem padrão perceptível (0,75 a 1,15).
function Weather.gust(now: number): number
	return 0.95 + 0.2 * math.sin(now * 0.21) * math.sin(now * 0.073 + 1.3)
end

-- `outdoor` 0..1 (sob telhado = 0); `particles` = orçamento da qualidade visual (0..1).
function Weather.rate(base: number, particles: number, outdoor: number, gust: number): number
	local budget = math.max(Weather.MinBudget, math.clamp(particles, 0, 1))
	return math.floor(base * budget * math.clamp(outdoor, 0, 1) * math.clamp(gust, 0.6, 1.2) + 0.5)
end

function Weather.volume(outdoor: number): number
	local o = math.clamp(outdoor, 0, 1)
	return Weather.IndoorVolume + (1 - Weather.IndoorVolume) * o
end

-- Próximo relâmpago entre 35 e 80 s; `roll` em 0..1.
function Weather.strikeInterval(roll: number): number
	return 35 + math.clamp(roll, 0, 1) * 45
end

-- O trovão chega depois do clarão (tempestade a alguns quilômetros).
function Weather.thunderDelay(roll: number): number
	return 1.2 + math.clamp(roll, 0, 1) * 2.8
end

-- Clarão duplo e curto, depois cai a zero; `t` = segundos desde o relâmpago.
function Weather.flash(t: number): number
	if t < 0 or t >= 0.6 then
		return 0
	elseif t < 0.06 then
		return 1
	elseif t < 0.12 then
		return 0.15
	elseif t < 0.18 then
		return 0.75
	end
	return 0.75 * (1 - (t - 0.18) / 0.42)
end

return table.freeze(Weather)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="422">
        <Properties>
          <string name="Name">Loader</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Ciclo de vida determinístico de Services (servidor) e Controllers (cliente).

	1. Valida a lista: cada módulo é uma tabela com `Name` único e `Init`/`Start` opcionais.
	2. Chama `Init()` de todos, na ordem da lista (preparar estado, conectar dependências).
	3. Chama `Start()` de todos, na mesma ordem (começar a trabalhar; loops longos via task.spawn).

	Qualquer erro interrompe o boot com uma mensagem clara, por exemplo:
		[Server] Init failed in PlayerDataService: <erro + traceback>

	Puro: roda no Roblox e no Lune.
]]

export type Module = {
	Name: string,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

export type Options = {
	-- Prefixo das mensagens de erro, ex.: "Server" ou "Client".
	label: string,
}

type Phase = "Init" | "Start"

local Loader = {}

function Loader.validate(label: string, modules: { any }): { Module }
	local seen: { [string]: boolean } = {}
	for index, module in modules do
		if type(module) ~= "table" then
			error(`[{label}] module #{index} is not a table (got {typeof(module)})`, 0)
		end
		local name = module.Name
		if type(name) ~= "string" or name == "" then
			error(`[{label}] module #{index} is missing a non-empty string "Name"`, 0)
		end
		if seen[name] then
			error(`[{label}] duplicate module name "{name}"`, 0)
		end
		seen[name] = true
		for _, hook in { "Init", "Start" } do
			local fn = module[hook]
			if fn ~= nil and type(fn) ~= "function" then
				error(`[{label}] {name}.{hook} must be a function (got {typeof(fn)})`, 0)
			end
		end
	end
	return modules :: { Module }
end

local function runPhase(label: string, phase: Phase, modules: { Module })
	for _, module in modules do
		local fn = if phase == "Init" then module.Init else module.Start
		if fn then
			local ok, err = xpcall(fn, debug.traceback)
			if not ok then
				error(`[{label}] {phase} failed in {module.Name}: {err}`, 0)
			end
		end
	end
end

-- Executa Init e depois Start de todos os módulos. Retorna quantos módulos subiram.
function Loader.boot(modules: { any }, options: Options): number
	local validated = Loader.validate(options.label, modules)
	runPhase(options.label, "Init", validated)
	runPhase(options.label, "Start", validated)
	return #validated
end

return Loader
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="423">
        <Properties>
          <string name="Name">Logger</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Logger com escopo e nível mínimo.

		local log = Logger.new("PlayerDataService")
		log.info("loaded %s", player.Name)   --> [PlayerDataService] loaded Fulano

	Formatação via string.format só acontece quando há argumentos extras.
	Puro: roda no Roblox e no Lune. Para testes, troque a saída com Logger.setSink.
]]

local Config = require("./Config")
local Types = require("./Types")

type LogLevel = Types.LogLevel

export type Sink = (level: LogLevel, line: string) -> ()

export type Logger = {
	scope: string,
	debug: (message: string, ...any) -> (),
	info: (message: string, ...any) -> (),
	warn: (message: string, ...any) -> (),
	error: (message: string, ...any) -> (),
}

local LEVEL_ORDER: { [LogLevel]: number } = {
	Debug = 1,
	Info = 2,
	Warn = 3,
	Error = 4,
}

local function defaultSink(level: LogLevel, line: string)
	if level == "Warn" or level == "Error" then
		warn(line)
	else
		print(line)
	end
end

local minLevel: LogLevel = Config.LogLevel
local sink: Sink = defaultSink

local Logger = {}

function Logger.setLevel(level: LogLevel)
	minLevel = level
end

function Logger.getLevel(): LogLevel
	return minLevel
end

-- Passe nil para voltar à saída padrão (print/warn).
function Logger.setSink(newSink: Sink?)
	sink = newSink or defaultSink
end

function Logger.format(scope: string, level: LogLevel, message: string, ...: any): string
	local text = if select("#", ...) > 0 then string.format(message, ...) else message
	local prefix = if level == "Error" then "ERROR: " else ""
	return `[{scope}] {prefix}{text}`
end

function Logger.new(scope: string): Logger
	local function emit(level: LogLevel, message: string, ...: any)
		if LEVEL_ORDER[level] < LEVEL_ORDER[minLevel] then
			return
		end
		sink(level, Logger.format(scope, level, message, ...))
	end

	return {
		scope = scope,
		debug = function(message: string, ...: any)
			emit("Debug", message, ...)
		end,
		info = function(message: string, ...: any)
			emit("Info", message, ...)
		end,
		warn = function(message: string, ...: any)
			emit("Warn", message, ...)
		end,
		error = function(message: string, ...: any)
			emit("Error", message, ...)
		end,
	}
end

return Logger
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="424">
        <Properties>
          <string name="Name">Net</string>
        </Properties>
        <Item class="ModuleScript" referent="425">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Validação de argumentos vindos do cliente. Tudo que chega por remote é `unknown`:
	o cliente pode mandar qualquer tipo, NaN, infinito, strings gigantes, tabelas com
	metatables, argumentos a mais etc.

		local validate = Guard.args({ Guard.string({ maxLength = 32 }), Guard.optional(Guard.integer()) })
		local ok, reason = validate(table.pack(...))

	Puro (exceto Guard.instanceOf, que usa :IsA): roda no Roblox e no Lune.
]]

export type Validator = (value: unknown) -> (boolean, string?)

export type NumberOptions = {
	min: number?,
	max: number?,
	integer: boolean?,
}

export type StringOptions = {
	minLength: number?,
	-- Padrão: 200 (strings longas são um vetor comum de abuso).
	maxLength: number?,
	-- Padrão Lua (string.match) que a string inteira deve satisfazer.
	pattern: string?,
}

local DEFAULT_MAX_STRING = 200

local Guard = {}

local function fail(expected: string, value: unknown): (boolean, string?)
	return false, `expected {expected}, got {typeof(value)}`
end

function Guard.number(options: NumberOptions?): Validator
	local opts: NumberOptions = options or {}
	return function(value: unknown)
		if type(value) ~= "number" then
			return fail("number", value)
		end
		local n = value :: number
		if n ~= n then
			return false, "number is NaN"
		end
		if n == math.huge or n == -math.huge then
			return false, "number is not finite"
		end
		if opts.integer and n % 1 ~= 0 then
			return false, "number is not an integer"
		end
		if opts.min and n < opts.min then
			return false, `number below min {opts.min}`
		end
		if opts.max and n > opts.max then
			return false, `number above max {opts.max}`
		end
		return true, nil
	end
end

function Guard.integer(options: NumberOptions?): Validator
	local opts: NumberOptions = options or {}
	return Guard.number({ min = opts.min, max = opts.max, integer = true })
end

function Guard.string(options: StringOptions?): Validator
	local opts: StringOptions = options or {}
	local maxLength = opts.maxLength or DEFAULT_MAX_STRING
	return function(value: unknown)
		if type(value) ~= "string" then
			return fail("string", value)
		end
		local s = value :: string
		local length = utf8.len(s)
		if length == nil then
			return false, "string is not valid UTF-8"
		end
		if length > maxLength then
			return false, `string longer than {maxLength}`
		end
		if opts.minLength and length < opts.minLength then
			return false, `string shorter than {opts.minLength}`
		end
		if opts.pattern and string.match(s, opts.pattern) ~= s then
			return false, "string does not match pattern"
		end
		return true, nil
	end
end

function Guard.boolean(): Validator
	return function(value: unknown)
		if type(value) ~= "boolean" then
			return fail("boolean", value)
		end
		return true, nil
	end
end

-- Aceita somente um dos valores listados (comparação com ==).
function Guard.literal(...: string | number | boolean): Validator
	local allowed = table.pack(...)
	return function(value: unknown)
		for index = 1, allowed.n do
			if value == allowed[index] then
				return true, nil
			end
		end
		return false, "value is not one of the allowed literals"
	end
end

function Guard.optional(validator: Validator): Validator
	return function(value: unknown)
		if value == nil then
			return true, nil
		end
		return validator(value)
	end
end

-- Array denso (1..n) sem metatable, com no máximo `maxLength` itens (padrão 100).
function Guard.array(itemValidator: Validator, maxLength: number?): Validator
	local limit = maxLength or 100
	return function(value: unknown)
		if type(value) ~= "table" then
			return fail("array", value)
		end
		local tbl = value :: { [any]: unknown }
		if getmetatable(tbl :: any) ~= nil then
			return false, "array has a metatable"
		end
		local count = 0
		for key in tbl do
			count += 1
			if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
				return false, "array has non-sequential keys"
			end
		end
		if count ~= #tbl then
			return false, "array has holes"
		end
		if count > limit then
			return false, `array longer than {limit}`
		end
		for index = 1, count do
			local ok, reason = itemValidator(tbl[index])
			if not ok then
				return false, `item #{index}: {reason}`
			end
		end
		return true, nil
	end
end

-- Roblox: aceita somente Instances da classe indicada (usa :IsA).
function Guard.instanceOf(className: string): Validator
	return function(value: unknown)
		if typeof(value) ~= "Instance" then
			return fail(className, value)
		end
		if not (value :: any):IsA(className) then
			return false, `expected {className}, got {(value :: any).ClassName}`
		end
		return true, nil
	end
end

-- Valida a lista de argumentos de um remote. Rejeita argumentos a mais.
-- Use com table.pack(...) para preservar nils: validate(table.pack(...)).
function Guard.args(validators: { Validator }): (args: { n: number, [number]: unknown }) -> (boolean, string?)
	local expected = #validators
	return function(args)
		if args.n > expected then
			return false, `too many arguments (expected at most {expected}, got {args.n})`
		end
		for index, validator in validators do
			local ok, reason = validator(args[index])
			if not ok then
				return false, `arg #{index}: {reason}`
			end
		end
		return true, nil
	end
end

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="426">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rate limit por chave (ex.: UserId) usando token bucket.

		local limiter = RateLimiter.new({ capacity = 5, refillPerSecond = 2 })
		if not limiter.allow(player.UserId) then return end

	`capacity` = rajada máxima; `refillPerSecond` = taxa sustentada.
	Chame `reset(key)` quando o jogador sair, para não acumular memória.
	Puro: o relógio é injetável, então os testes rodam no Lune.
]]

export type Options = {
	capacity: number,
	refillPerSecond: number,
	-- Padrão: os.clock.
	clock: (() -> number)?,
}

export type RateLimiter = {
	allow: (key: any) -> boolean,
	reset: (key: any) -> (),
	size: () -> number,
}

type Bucket = {
	tokens: number,
	updatedAt: number,
}

local RateLimiter = {}

function RateLimiter.new(options: Options): RateLimiter
	assert(options.capacity > 0, "RateLimiter: capacity must be > 0")
	assert(options.refillPerSecond >= 0, "RateLimiter: refillPerSecond must be >= 0")

	local clock = options.clock or os.clock
	local buckets: { [any]: Bucket } = {}
	local count = 0

	local function allow(key: any): boolean
		local now = clock()
		local bucket = buckets[key]
		if bucket == nil then
			bucket = { tokens = options.capacity, updatedAt = now }
			buckets[key] = bucket
			count += 1
		else
			local elapsed = math.max(0, now - bucket.updatedAt)
			bucket.tokens = math.min(options.capacity, bucket.tokens + elapsed * options.refillPerSecond)
			bucket.updatedAt = now
		end
		if bucket.tokens >= 1 then
			bucket.tokens -= 1
			return true
		end
		return false
	end

	local function reset(key: any)
		if buckets[key] ~= nil then
			buckets[key] = nil
			count -= 1
		end
	end

	local function size(): number
		return count
	end

	return {
		allow = allow,
		reset = reset,
		size = size,
	}
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="427">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Registro central de remotes. TODO remote do jogo é declarado em DEFINITIONS, e só aqui.

	- Servidor: Remotes.setupServer() cria a pasta ReplicatedStorage.<RemotesFolderName> com
	  todos os remotes (chamado uma vez pelo bootstrap). Depois use serverEvent/serverFunction.
	- Cliente: clientEvent/clientFunction esperam o remote aparecer (com timeout).
	- Nome desconhecido = erro imediato. Nunca crie RemoteEvent/RemoteFunction "soltos".

	Handlers no servidor devem passar por Server/Net/ServerNet (validação + rate limit).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require("../Config")

export type RemoteKind = "RemoteEvent" | "RemoteFunction" | "UnreliableRemoteEvent"

local DEFINITIONS: { [string]: RemoteKind } = {
	UseHouseItem = "RemoteFunction",
	SetHousePreference = "RemoteEvent",
	-- Voto de modo no lobby; a maioria da equipe decide antes do início.
	SelectGameMode = "RemoteFunction",
	-- Cliente pede para interagir com algo: (id, ação opcional "use" | "alt"). Servidor valida tudo.
	Interact = "RemoteFunction",
	-- Cliente pede lanterna ligada/desligada; o servidor decide pela bateria (afeta a visão do Vigia).
	SetFlashlight = "RemoteEvent",
	-- Cliente pede postura ("Stand" | "Crouch"); o servidor checa o teto e muda o corpo.
	SetStance = "RemoteEvent",
	-- Escondido: prender/soltar a respiração.
	SetHoldBreath = "RemoteEvent",
	-- Cliente pede nova rodada nas telas finais: "full" (do zero) ou "checkpoint".
	RequestRestart = "RemoteFunction",
	-- Loja/progressão: (ação, argumento?). O servidor valida preço, posse, política e moeda.
	Store = "RemoteFunction",
	-- Servidor -> cliente: recompensas concedidas (fim de partida, fita, nível, compra).
	StoreNotice = "RemoteEvent",
	-- Cliente -> servidor: só telemetria do funil da loja ("open" | "view", oferta?). Não muda o jogo.
	StoreTrack = "RemoteEvent",
	-- Pitch do olhar (graus) para os colegas verem cabeça e lanterna; só visual (PresenceService).
	SetLook = "RemoteEvent",
	-- Menu inicial: ("servers") lista de servidores; ("join", jobId) / ("friend", userId) teleporte validado.
	Lobby = "RemoteFunction",
}

local FOLDER_NAME = Config.Net.RemotesFolderName

local Remotes = {}

function Remotes.names(): { string }
	local names = {}
	for name in DEFINITIONS do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Remotes.kindOf(name: string): RemoteKind
	local kind: RemoteKind? = DEFINITIONS[name]
	if kind then
		return kind
	end
	error(`[Remotes] unknown remote "{name}"; declare it in Shared/Net/Remotes.luau`, 3)
end

-- Cria (ou completa) a pasta de remotes. Idempotente. Somente no servidor.
function Remotes.setupServer(): Folder
	assert(RunService:IsServer(), "[Remotes] setupServer must run on the server")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if folder == nil then
		local newFolder = Instance.new("Folder")
		newFolder.Name = FOLDER_NAME
		newFolder.Parent = ReplicatedStorage
		folder = newFolder
	end
	assert(folder and folder:IsA("Folder"), `[Remotes] ReplicatedStorage.{FOLDER_NAME} must be a Folder`)
	for _, name in Remotes.names() do
		local kind = DEFINITIONS[name]
		local existing = folder:FindFirstChild(name)
		if existing == nil then
			local remote = Instance.new(kind)
			remote.Name = name
			remote.Parent = folder
		elseif existing.ClassName ~= kind then
			error(`[Remotes] {name} exists as {existing.ClassName}, expected {kind}`)
		end
	end
	return folder
end

local function serverRemote(name: string, kind: RemoteKind): Instance
	if Remotes.kindOf(name) ~= kind then
		error(`[Remotes] {name} is a {Remotes.kindOf(name)}, not a {kind}`, 3)
	end
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	local remote = folder and folder:FindFirstChild(name)
	if remote == nil then
		error(`[Remotes] {name} not found; call Remotes.setupServer() first`, 3)
	end
	return remote
end

local function clientRemote(name: string, kind: RemoteKind, timeout: number?): Instance
	if Remotes.kindOf(name) ~= kind then
		error(`[Remotes] {name} is a {Remotes.kindOf(name)}, not a {kind}`, 3)
	end
	local limit = timeout or Config.Net.ClientWaitTimeout
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, limit)
	local remote = folder and folder:WaitForChild(name, limit)
	if remote == nil then
		error(`[Remotes] timed out after {limit}s waiting for {name}`, 3)
	end
	return remote
end

function Remotes.serverEvent(name: string): RemoteEvent
	return serverRemote(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.serverFunction(name: string): RemoteFunction
	return serverRemote(name, "RemoteFunction") :: RemoteFunction
end

function Remotes.serverUnreliableEvent(name: string): UnreliableRemoteEvent
	return serverRemote(name, "UnreliableRemoteEvent") :: UnreliableRemoteEvent
end

function Remotes.clientEvent(name: string, timeout: number?): RemoteEvent
	return clientRemote(name, "RemoteEvent", timeout) :: RemoteEvent
end

function Remotes.clientFunction(name: string, timeout: number?): RemoteFunction
	return clientRemote(name, "RemoteFunction", timeout) :: RemoteFunction
end

function Remotes.clientUnreliableEvent(name: string, timeout: number?): UnreliableRemoteEvent
	return clientRemote(name, "UnreliableRemoteEvent", timeout) :: UnreliableRemoteEvent
end

return Remotes
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="428">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Tipos compartilhados entre servidor e cliente.
	Este módulo não tem lógica: só `export type`. Importe com:
		local Types = require("@game/ReplicatedStorage/Shared/Types")
]]

export type LogLevel = "Debug" | "Info" | "Warn" | "Error"

-- Envelope padrão de resposta de RemoteFunction (ver Server/Net/ServerNet).
export type Result<T> = { ok: true, data: T } | { ok: false, error: string }

-- Modo de persistência do PlayerDataService.
export type DataMode = "real" | "mock"

-- Dados persistidos de cada jogador. Mudou o formato? Suba Config.Data.SchemaVersion
-- e trate a migração em Server/Data/PlayerDataSchema.
export type PlayerData = {
	schemaVersion: number,
	sessions: number,
	firstJoin: number,
	lastJoin: number,
	-- v2: economia, cosméticos e progressão (regras em Shared/Game/Economy).
	wallet: { fichas: number, creditos: number },
	xp: number,
	-- Último nível cujas recompensas já foram entregues.
	rewardedLevel: number,
	owned: { [string]: boolean },
	-- Tipo de cosmético -> id equipado (flashlight, uniform, filter, title).
	equipped: { [string]: string },
	-- Fitas colecionáveis -> quando achou (os.time).
	tapes: { [string]: number },
	daily: { lastDay: number, streak: number, spinDay: number, spinsUsed: number },
	stats: { runs: number, escapes: number, captures: number, chests: number, stages: number },
	-- Recibos de compra já concedidos (idempotência do ProcessReceipt) -> os.time.
	purchases: { [string]: number },
	-- Produtos de compra única já entregues (ex.: pacote inicial) -> os.time.
	oncePurchases: { [string]: number },
	-- v3: passe de temporada (regras em Shared/Game/Season). `id` = temporada a que xp e
	-- recompensas se referem (outra temporada zera tudo). free/premium = níveis cuja recompensa
	-- já foi entregue em cada trilha; chave = nível em texto ("1".."30"), porque o DataStore salva JSON.
	season: { id: string, xp: number, free: { [string]: boolean }, premium: { [string]: boolean } },
	-- v4: vantagens pagas (regras em Shared/Game/Perks): nível de cada melhoria, estoque de
	-- consumíveis, kit de uso automático e bônus de tempo (os.time em que acabam).
	perks: { [string]: number },
	consumables: { [string]: number },
	loadout: { [string]: boolean },
	boosts: { fichasUntil: number, xpUntil: number },
	-- v4: modo história (Shared/Game/StoryRewards): capítulo -> os.time da 1ª vitória / da 1ª sem quedas.
	house: {
		preferences: { [string]: number },
		cleared: { [string]: number },
		flawless: { [string]: number },
		endings: { [string]: number },
		achievements: { [string]: number },
	},
	story: { cleared: { [string]: number }, flawless: { [string]: number } },
	-- Trava de sessão (um servidor por vez escreve os dados). Ver Server/Data/SessionLock.
	sessionLock: { job: string, at: number }?,
}

-- Resposta do remote "Interact" / "RequestRestart" (dentro do envelope Result).
-- message = chave de Text.Messages; note = id do bilhete a exibir;
-- kind = tipo do objeto (o cliente anima a resposta aprovada: pegar item, chave, disjuntor...).
export type InteractResponse = {
	accepted: boolean,
	message: string,
	note: string?,
	kind: string?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="429">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="430">
          <Properties>
            <string name="Name">Retry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Tenta executar `fn` até `attempts` vezes, com backoff exponencial entre as tentativas.

		local ok, value, err = Retry.run(function()
			return store:GetAsync(key)
		end, { attempts = 3, baseDelay = 1 })

	Puro: a espera é injetável (`wait`), então os testes rodam no Lune sem dormir.
]]

export type Options = {
	attempts: number,
	-- Atraso antes da 2ª tentativa; dobra a cada falha.
	baseDelay: number,
	maxDelay: number?,
	-- Padrão: task.wait (Roblox).
	wait: ((seconds: number) -> ())?,
	onRetry: ((attempt: number, err: string, delay: number) -> ())?,
}

local Retry = {}

function Retry.delayFor(attempt: number, baseDelay: number, maxDelay: number?): number
	local delay = baseDelay * 2 ^ (attempt - 1)
	return if maxDelay then math.min(delay, maxDelay) else delay
end

-- Retorna (true, valor, nil) no sucesso ou (false, nil, últimoErro) se todas falharem.
function Retry.run<T>(fn: () -> T, options: Options): (boolean, T?, string?)
	assert(options.attempts >= 1, "Retry.run: attempts must be >= 1")
	local wait: (seconds: number) -> () = options.wait or function(seconds: number)
		task.wait(seconds)
	end
	local lastError = "unknown error"
	for attempt = 1, options.attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result, nil
		end
		lastError = tostring(result)
		if attempt < options.attempts then
			local delay = Retry.delayFor(attempt, options.baseDelay, options.maxDelay)
			if options.onRetry then
				options.onRetry(attempt, lastError, delay)
			end
			wait(delay)
		end
	end
	return false, nil, lastError
end

return Retry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="431">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Utilitários puros de tabela (sem APIs do Roblox; testáveis no Lune).
]]

local TableUtil = {}

-- Cópia profunda. Não copia metatables; referências cíclicas não são suportadas.
function TableUtil.deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in value :: any do
		copy[key] = TableUtil.deepCopy(item)
	end
	return copy :: any
end

-- Retorna uma cópia de `target` com as chaves ausentes preenchidas a partir de `template`
-- (recursivo). Valores existentes em `target` são preservados, mesmo que o tipo difira.
function TableUtil.reconcile<T>(target: any, template: T): T
	if type(target) ~= "table" then
		return TableUtil.deepCopy(template)
	end
	local result = TableUtil.deepCopy(target)
	for key, templateValue in template :: any do
		local current = result[key]
		if current == nil then
			result[key] = TableUtil.deepCopy(templateValue)
		elseif type(templateValue) == "table" and type(current) == "table" then
			result[key] = TableUtil.reconcile(current, templateValue)
		end
	end
	return result
end

-- Congela a tabela e todas as subtabelas (table.freeze é raso por padrão).
function TableUtil.deepFreeze<T>(value: T): T
	if type(value) == "table" and not table.isfrozen(value :: any) then
		for _, item in value :: any do
			TableUtil.deepFreeze(item)
		end
		table.freeze(value :: any)
	end
	return value
end

-- Igualdade estrutural (usada pelos testes).
function TableUtil.deepEqual(a: any, b: any): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for key, value in a do
		if not TableUtil.deepEqual(value, b[key]) then
			return false
		end
	end
	for key in b do
		if a[key] == nil then
			return false
		end
	end
	return true
end

return TableUtil
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="432">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="433">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="434">
        <Properties>
          <string name="Name">Campaign</string>
        </Properties>
        <Item class="ModuleScript" referent="435">
          <Properties>
            <string name="Name">ActivityBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Converte um plano em estações sem colisão e bloqueios somente nos atalhos opcionais.
local CollectionService = game:GetService("CollectionService")
local Catalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local PixelText = require("@game/ReplicatedStorage/Shared/Game/PixelText")
local Build = require("../World/Build")
local Palette = require("../World/Palette")
local Generator = require("./CampaignGenerator")
local Session = require("./CoopSession")

export type Target = { taskId: string, button: number, focus: BasePart }
export type Built = {
	root: Folder,
	targets: { [string]: Target },
	lamps: { [string]: BasePart },
	labels: { [string]: TextLabel },
	meters: { [string]: { BasePart } },
	plan: Generator.Plan,
}
local HouseActivities = require("./HouseActivities")
local Builder = {}
local repairNames = { "ISOLAR CIRCUITO", "ENCAIXAR FUSIVEL", "TESTAR ENERGIA" }

function Builder.build(parent: Instance, plan: Generator.Plan, distance: number): Built
	if plan.house then
		return HouseActivities.build(parent, plan, distance)
	end
	local valid, reason = Generator.validate(plan)
	assert(valid, `[CampaignBuilder] invalid plan: {reason}`)
	local previous = parent:FindFirstChild("CampaignActivities")
	if previous then
		previous:Destroy()
	end
	local root = Build.folder(parent, "CampaignActivities")
	local built: Built = { root = root, targets = {}, lamps = {}, labels = {}, meters = {}, plan = plan }
	for index, activity in plan.activities do
		local model = Build.model(root, activity.id)
		model:SetAttribute("RoomLabel", Catalog.RoomNames[activity.room])
		local p = Vector3.new(activity.x, 0, activity.z)
		Build.block(model, "Station", p, Vector3.new(3.4, 3, 0.9), 0, Palette.MetalDark, { collide = false })
		local lamp = Build.block(
			model,
			"Status",
			p + Vector3.new(0, 3.5, 0),
			Vector3.new(0.45, 0.4, 0.3),
			0,
			Palette.Red,
			{ collide = false }
		)
		built.lamps[activity.id] = lamp
		local clue = if activity.kind == "sequence"
			then `SEQUÊNCIA {table.concat(activity.order, " - ")}`
			elseif activity.kind == "relay" then "RELÉ: DUAS PESSOAS CONFIRMAM"
			else "REPARAR: 3 ETAPAS"
		local instructions = Build.sign(
			model,
			"Instructions",
			p + Vector3.new(0, 5.2, 0),
			Vector3.zAxis,
			Vector2.new(6.5, 2.4),
			string.format("%02d / %s\n%s", index, activity.title or Catalog.RoomNames[activity.room] or "SETOR", clue),
			{
				textColor = Palette.Hazard,
				background = Palette.Black,
				lit = true,
			}
		)
		built.labels[activity.id] = instructions:FindFirstChildWhichIsA("TextLabel", true) :: TextLabel
		built.meters[activity.id] = {}
		for step = 1, 3 do
			table.insert(
				built.meters[activity.id],
				Build.block(
					model,
					`Step{step}`,
					p + Vector3.new((step - 2) * 0.8, 2.95, 0.6),
					Vector3.new(0.6, 0.12, 0.15),
					0,
					Palette.MetalDark,
					{ collide = false, query = false }
				)
			)
		end
		Build.sign(
			model,
			"Reward",
			p + Vector3.new(0, 0.6, 0.7),
			Vector3.zAxis,
			Vector2.new(5.8, 0.6),
			"EQUIPE +12 F / 24 XP | AJUDA +8 F / 16 XP",
			{ textColor = Palette.ExitGreen, background = Palette.Black, lit = true }
		)
		for button = 1, (if activity.kind == "relay" then 1 else 3) do
			local id = `{activity.id}_{button}`
			local x = if activity.kind ~= "relay" then (button - 2) * 1.05 else 0
			local focus = Build.block(
				model,
				id,
				p + Vector3.new(x, 2.3, 0.6),
				Vector3.new(0.9, 0.7, 0.3),
				0,
				Palette.Hazard,
				{ collide = false }
			)
			Build.sign(
				model,
				`ButtonLabel{button}`,
				p + Vector3.new(x, 1.45, 0.65),
				Vector3.zAxis,
				Vector2.new(0.95, 0.7),
				if activity.kind == "repair"
					then `{button}\n{({ "ISOLAR", "TROCAR", "TESTAR" })[button]}`
					elseif activity.kind == "sequence" then tostring(button)
					else "RELE",
				{ textColor = Palette.Hazard, background = Palette.Black, lit = true }
			)
			focus:SetAttribute(Tags.Attr.InteractId, id)
			focus:SetAttribute(
				Tags.Attr.InteractPrompt,
				if activity.kind == "sequence" then `ACIONAR {button}` else "CONFIRMAR ESTAÇÃO"
			)
			focus:SetAttribute(Tags.Attr.InteractDistance, distance)
			focus:SetAttribute(Tags.Attr.InteractEnabled, true)
			CollectionService:AddTag(focus, Tags.Interactable)
			built.targets[id] = { taskId = activity.id, button = button, focus = focus }
		end
	end
	for _, id in plan.closedLinks do
		for _, link in Catalog.Links do
			if link.id == id then
				local size = if link.axis == "X" then Vector3.new(6, 9, 0.8) else Vector3.new(0.8, 9, 6)
				local shutter = Build.block(
					root,
					`Shutter_{id}`,
					Vector3.new(link.x, 0, link.z),
					size,
					0,
					Palette.WallLowerCold,
					{ material = Enum.Material.Metal }
				)
				shutter:SetAttribute("OptionalLink", id)
			end
		end
	end
	return built
end

function Builder.refresh(built: Built, tasks: { [string]: Session.TaskState }, now: number?, activePlayers: number?)
	if built.plan.house then
		HouseActivities.refresh(built, tasks)
		return
	end
	local clock = now or workspace:GetServerTimeNow()
	local active = activePlayers or built.plan.players
	local current: string? = nil
	for _, spec in built.plan.activities do
		local state = tasks[spec.id]
		if state and not state.solved then
			current = spec.id
			break
		end
	end
	for index, spec in built.plan.activities do
		local state = tasks[spec.id]
		if not state then
			continue
		end
		local locked = built.plan.mode == "Story" and spec.id ~= current and not state.solved
		local clue = if state.solved
			then "CONCLUIDA - EQUIPE AVANCOU"
			elseif locked then "AGUARDE O OBJETIVO ATUAL"
			elseif spec.kind == "repair" then `{state.progress}/3 | PROXIMO: {repairNames[state.progress + 1]}`
			elseif
				spec.kind == "sequence"
			then `ORDEM: {table.concat(spec.order, " - ")}\n{state.progress}/3 | ACIONE {spec.order[state.progress + 1]} (ACERTOS SALVOS)`
			elseif state.relayBy and active == 1 then `CONFIRME SOZINHO: E EM {math.max(
				0,
				math.ceil(state.relayUntil - clock)
			)}s`
			elseif state.relayBy then `COLEGA: CONFIRME COM E EM {math.max(0, math.ceil(state.relayUntil - clock))}s`
			elseif active == 1 then "ULTIMO ATIVO: E, DEPOIS E DE NOVO"
			else "VENHAM EM DUPLA: E, DEPOIS OUTRO COLEGA USA E"
		local title = spec.title or Catalog.KindNames[spec.kind]
		built.labels[spec.id].Text = PixelText.normalize(string.format("%02d / %s\n%s", index, title, clue))
		for step, meter in built.meters[spec.id] do
			meter.Color = if state.solved or step <= state.progress then Palette.ExitGreen else Palette.MetalDark
			meter.Material = Enum.Material.Neon
		end
	end
	for _, target in built.targets do
		local state = tasks[target.taskId]
		local locked = built.plan.mode == "Story" and target.taskId ~= current
		target.focus:SetAttribute(Tags.Attr.InteractEnabled, state ~= nil and not state.solved and not locked)
		if state then
			local kind = state.spec.kind
			local nextButton = if kind == "sequence" then state.spec.order[state.progress + 1] else state.progress + 1
			local prompt = if kind == "repair"
				then repairNames[target.button]
				elseif kind == "sequence" then `ACIONAR {target.button}`
				elseif state.relayBy then "CONFIRMAR RELE (OUTRO COLEGA)"
				else "ARMAR RELE - CHAME UM COLEGA"
			if kind == "relay" and active == 1 then
				prompt = if state.relayBy then "CONFIRMAR RELE SOZINHO" else "ARMAR RELE SOZINHO"
			end
			target.focus:SetAttribute(Tags.Attr.InteractPrompt, prompt)
			target.focus.Color = if state.solved
				then Palette.ExitGreen
				elseif locked then Palette.MetalDark
				elseif kind == "relay" or target.button == nextButton then Palette.Hazard
				else Palette.MetalDark
			target.focus.Material = if not locked and (target.button == nextButton or kind == "relay")
				then Enum.Material.Neon
				else Enum.Material.Metal
		end
		local lamp = built.lamps[target.taskId]
		if state and lamp then
			lamp.Color = if state.solved
				then Palette.ExitGreen
				elseif state.progress > 0 then Palette.Hazard
				else Palette.Red
			lamp.Material = Enum.Material.Neon
			lamp:SetAttribute("Progress", state.progress)
			lamp:SetAttribute("Solved", state.solved)
		end
	end
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="436">
          <Properties>
            <string name="Name">CampaignGenerator</string>
            <string name="Source"><![CDATA[--!strict
-- Sorteia conteúdo e conexões secundárias; nunca remove a espinha de circulação validada.
local Catalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local Layout = require("../World/Layout")
local ProceduralLayout = require("../World/ProceduralLayout")
local SeededRandom = require("./SeededRandom")

export type Activity = {
	house: boolean?,
	y: number?,
	item: string?,
	event: string?,
	id: string,
	slot: string,
	room: string,
	kind: string,
	order: { number },
	x: number,
	z: number,
	title: string?,
}
export type Plan = {
	house: boolean?,
	mode: string?,
	seed: number,
	stage: number,
	title: string,
	threat: string,
	players: number,
	activities: { Activity },
	closedLinks: { string },
	sector: ProceduralLayout.Plan,
}

local Generator = {}

function Generator.create(seed: number, stage: number, players: number): Plan
	assert(stage % 1 == 0 and stage >= 1 and stage <= #Catalog.Stages, "Invalid campaign stage")
	assert(players % 1 == 0 and players >= 1 and players <= 8, "Invalid party size")
	local rng = SeededRandom.new(seed + stage * 7919)
	local definition = Catalog.Stages[stage]
	local sector = ProceduralLayout.create(seed, stage)
	local oldSlots = rng.shuffle(Catalog.Slots)
	local newSlots = rng.shuffle(ProceduralLayout.slots(sector))
	local count = math.max(3, players) + stage - 1
	local slots = {}
	-- A maioria das estações explora a ala sorteada; mantém tarefas no núcleo e o retorno à saída.
	local newCount = math.ceil(count * 0.6)
	for i = 1, count do
		table.insert(slots, if i <= newCount then newSlots[i] else oldSlots[i - newCount])
	end
	slots = rng.shuffle(slots)
	local activities: { Activity } = {}
	for i = 1, count do
		local slot = slots[i]
		local kind = definition.kinds[(i - 1) % #definition.kinds + 1]
		table.insert(activities, {
			id = `task_{i}`,
			slot = slot.id,
			room = slot.room,
			kind = kind,
			order = rng.shuffle({ 1, 2, 3 }),
			x = slot.x,
			z = slot.z,
		})
	end
	local optional: { string } = {}
	for _, link in Catalog.Links do
		if link.optional then
			table.insert(optional, link.id)
		end
	end
	optional = rng.shuffle(optional)
	local closed: { string } = {}
	for i = 1, rng.integer(0, 2) do
		table.insert(closed, optional[i])
	end
	return {
		seed = seed,
		stage = stage,
		title = definition.title,
		threat = definition.threat,
		players = players,
		activities = activities,
		closedLinks = closed,
		sector = sector,
	}
end

function Generator.validate(plan: Plan): (boolean, string?)
	local valid, reason = ProceduralLayout.validate(plan.sector)
	if not valid then
		return false, reason
	end
	if plan.sector.seed ~= plan.seed or plan.sector.stage ~= (if plan.mode == "Story" then 1 else plan.stage) then
		return false, "map_identity_mismatch"
	end
	local slots = table.clone(Catalog.Slots)
	for _, slot in ProceduralLayout.slots(plan.sector) do
		table.insert(slots, slot)
	end
	local closed: { [string]: boolean } = {}
	for _, id in plan.closedLinks do
		local found = false
		for _, link in Catalog.Links do
			if link.id == id and link.optional then
				found = true
			end
		end
		if not found or closed[id] then
			return false, "invalid_closure"
		end
		closed[id] = true
	end
	local reached: { [string]: boolean } = { Courtyard = true }
	local changed = true
	while changed do
		changed = false
		for _, link in Catalog.Links do
			if not closed[link.id] and (reached[link.a] or reached[link.b]) then
				if not reached[link.a] or not reached[link.b] then
					changed = true
				end
				reached[link.a], reached[link.b] = true, true
			end
		end
	end
	for _, room in Layout.Rooms do
		if not reached[room.id] then
			return false, "unreachable_room"
		end
	end
	local occupied: { [string]: boolean } = {}
	local ids: { [string]: boolean } = {}
	for _, activity in plan.activities do
		if occupied[activity.slot] or ids[activity.id] then
			return false, "duplicate_activity"
		end
		occupied[activity.slot], ids[activity.id] = true, true
		local known = false
		for _, slot in slots do
			if
				slot.id == activity.slot
				and slot.x == activity.x
				and slot.z == activity.z
				and slot.room == activity.room
			then
				known = true
			end
		end
		if not known then
			return false, "unknown_slot"
		end
		if activity.kind ~= "repair" and activity.kind ~= "sequence" and activity.kind ~= "relay" then
			return false, "unknown_activity"
		end
		local seen: { [number]: boolean } = {}
		for _, n in activity.order do
			if n % 1 ~= 0 or n < 1 or n > 3 or seen[n] then
				return false, "invalid_sequence"
			end
			seen[n] = true
		end
		if #activity.order ~= 3 then
			return false, "invalid_sequence"
		end
	end
	if #plan.activities < 3 then
		return false, "too_few_activities"
	end
	return true, nil
end

return Generator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="437">
          <Properties>
            <string name="Name">CampaignMode</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Config = require("@game/ReplicatedStorage/Shared/Config")

local Mode = {}

function Mode.enabled(): boolean
	if Config.Campaign.Enabled then
		return true
	end
	if RunService:IsStudio() then
		local ok, args = pcall(function()
			return game:GetService("StudioTestService"):GetTestArgs()
		end)
		return ok and type(args) == "table" and args.campaignQA == true
	end
	return false
end

return Mode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="438">
          <Properties>
            <string name="Name">CampaignRuntime</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime alternativo registrado pelo ponto de entrada RoundService: nunca roda junto com a rodada solo.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local StarterPlayer = game:GetService("StarterPlayer")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Catalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local Modes = require("@game/ReplicatedStorage/Shared/Game/GameModes")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local Story = require("@game/ReplicatedStorage/Shared/Game/StoryCatalog")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local TaskRewards = require("@game/ReplicatedStorage/Shared/Game/TaskRewards")
local Preferences = require("@game/ReplicatedStorage/Shared/Game/HousePreferences")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local ServerNet = require("../Net/ServerNet")
local WorldService = require("../Services/WorldService")
local CreatureService = require("../Services/CreatureService")
local CollectibleService = require("../Services/CollectibleService")
-- Vantagens pagas (Claude): Segunda Chance, tempo de resgate e Continuação.
local PerkService = require("../Services/PerkService")
local StoreService = require("../Services/StoreService")
local Builder = require("./ActivityBuilder")
local Build = require("../World/Build")
local Session = require("./CoopSession")

local Endings = require("./Endings")
local PlayerData = require("../Services/PlayerDataService")

local C = Config.Campaign
local log = Logger.new("Campaign")
local session = Session.new(1, C, nil, true)
local taskPayments: TaskRewards.Ledger = {}
local pendingTaskPayments: { [string]: { [number]: boolean } } = {}
local rewardCampaign = 0
local replicated: Configuration? = nil
local built: Builder.Built? = nil
local version = 0
local startedAt = 0
local nextStageAt = 0
local nextThreatAt = 0
local blackoutUntil = 0
local building = false
local escapeEndsAt = 0
local lostRetryAt = 0
local lobbyReturnAt = 0
local tutorialHeld: { [number]: number } = {}
local supplies: { [number]: { [string]: number } } = {}
local endingPaid: { [number]: boolean } = {}
local endingShown = false
local spawning: { [Player]: boolean } = {}
local spawnedVersion: { [Player]: number } = {}
local spawnSlots: { [number]: number } = {}
local playerAdapter: any = nil
local channels: { [number]: { target: number, endsAt: number } } = {}
local nextActionAt: { [number]: number } = {}
local rescueParts: { [number]: BasePart } = {}
local modeVotes: Modes.Votes = {}
local selectedMode: Modes.Id? = nil
local sceneSerial = 0
local sceneStartedAt = 0
local sceneEndsAt = 0
local qaMode: Modes.Id? = nil
if RunService:IsStudio() then
	local ok, args = pcall(function()
		return game:GetService("StudioTestService"):GetTestArgs()
	end)
	if ok and type(args) == "table" and args.campaignQA and not args.modeMenuQA then
		qaMode = if args.storyQA then "Story" else "Standard"
	end
end

local Runtime = { Name = "RoundService" }

local function slotFor(id: number): number
	if spawnSlots[id] then
		return spawnSlots[id]
	end
	local used: { [number]: boolean } = {}
	for _, slot in spawnSlots do
		used[slot] = true
	end
	for slot = 1, C.maxPlayers do
		if not used[slot] then
			spawnSlots[id] = slot
			return slot
		end
	end
	error("[Campaign] no spawn slot available")
end

local function parts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return character,
		if root and root:IsA("BasePart") then root else nil,
		character and character:FindFirstChildOfClass("Humanoid")
end

local function feedback(player: Player, message: string)
	player:SetAttribute("CampaignFeedback", message)
	local serial = player:GetAttribute("CampaignFeedbackSerial")
	player:SetAttribute("CampaignFeedbackSerial", (if type(serial) == "number" then serial else 0) + 1)
end

local function freeze(player: Player, value: boolean)
	local _, root = parts(player)
	if root then
		root.Anchored = value
	end
end

local function publish()
	if not replicated then
		return
	end
	if session.phase == "Won" and lobbyReturnAt == 0 then
		lobbyReturnAt = workspace:GetServerTimeNow() + C.EndingSeconds
	end
	replicated:SetAttribute("LobbyReturnAt", lobbyReturnAt)
	local roster = {}
	for _, player in Players:GetPlayers() do
		local member = session.members[player.UserId]
		if member then
			player:SetAttribute("CampaignStatus", member.status)
			player:SetAttribute("CampaignRole", member.role)
			table.insert(roster, {
				id = member.id,
				name = player.DisplayName,
				role = member.role,
				status = member.status,
				contributions = member.contributions,
				downedUntil = member.downedUntil,
				deathCause = player:GetAttribute("DeathCause"),
			})
		end
	end
	table.sort(roster, function(a, b)
		return a.id < b.id
	end)
	local tasks = {}
	local plan = session.plan
	if plan then
		for _, spec in plan.activities do
			local state = session.tasks[spec.id]
			table.insert(tasks, {
				id = spec.id,
				room = spec.room,
				kind = spec.kind,
				title = spec.title,
				solved = state.solved,
				progress = state.progress,
				required = #spec.order,
				available = Session.taskReady(session, spec.id),
				relayUntil = state.relayUntil,
			})
		end
	end
	replicated:SetAttribute("Roster", HttpService:JSONEncode(roster))
	replicated:SetAttribute("Tasks", HttpService:JSONEncode(tasks))
	replicated:SetAttribute("Inventory", HttpService:JSONEncode(session.inventory))
	replicated:SetAttribute("EscapeEndsAt", escapeEndsAt)
	replicated:SetAttribute("Stage", session.stage)
	replicated:SetAttribute("ForestActive", session.stage >= 6)
	replicated:SetAttribute("Seed", session.seed)
	replicated:SetAttribute("Title", if plan then plan.title else "REUNINDO A EQUIPE")
	replicated:SetAttribute("Threat", if plan then Catalog.Threats[plan.threat].title else "")
	replicated:SetAttribute("Solved", Session.solvedCount(session))
	replicated:SetAttribute("Total", if plan then #plan.activities else 0)
	replicated:SetAttribute("NextStageAt", nextStageAt)
	replicated:SetAttribute("Phase", session.phase)
	local _, standardVotes, storyVotes = Modes.winner(modeVotes, session.members, C.minPlayers)
	replicated:SetAttribute("GameMode", selectedMode or "")
	replicated:SetAttribute("StandardVotes", standardVotes)
	replicated:SetAttribute("StoryVotes", storyVotes)
	replicated:SetAttribute("Players", Session.count(session))
	replicated:SetAttribute("Building", building)
	replicated:SetAttribute("StorySceneSerial", sceneSerial)
	replicated:SetAttribute("StorySceneStartedAt", sceneStartedAt)
	replicated:SetAttribute("StorySceneEndsAt", sceneEndsAt)
	local phase = if building
		then "Intro"
		elseif session.phase == "Won" then "Won"
		elseif session.phase == "Lost" then "Lost"
		elseif session.phase == "Playing" or session.phase == "Extracting" then "Playing"
		else "Intro"
	GameState.set("RoundStartedAt", startedAt)
	if phase == "Won" or phase == "Lost" then
		GameState.set("RoundEndedAt", workspace:GetServerTimeNow())
	end
	GameState.set("Phase", phase)
	GameState.set("PowerOn", WorldService.isPowered())
	GameState.set("CreatureActive", CreatureService.isActive())
	if built and session.plan then
		Builder.refresh(built, session.tasks)
	end
end

local function clearRescues()
	for _, part in rescueParts do
		part:Destroy()
	end
	rescueParts, channels = {}, {}
end

local function spawnMember(player: Player)
	if not player.Parent or not session.members[player.UserId] then
		return
	end
	-- Pedidos de join/restart podem ficar enfileirados enquanto o avatar carrega.
	-- Um personagem pronto para esta versão já satisfaz todos esses pedidos.
	local existing = player.Character
	local existingHumanoid = existing and existing:FindFirstChildOfClass("Humanoid")
	if spawnedVersion[player] == version and existingHumanoid and existingHumanoid.Health > 0 then
		return
	end
	if spawning[player] then
		task.delay(0.2, spawnMember, player)
		return
	end
	spawning[player] = true
	local thisVersion = version
	local ok, reason = pcall(function(): any
		player:LoadCharacterAsync()
		if not player.Parent or not session.members[player.UserId] then
			return nil
		end
		-- O avatar recém-carregado serve ao capítulo vigente, mesmo se ele mudou durante o yield.
		thisVersion = version
		local character = player.Character
		assert(character, "[Campaign] character missing after load")
		local root = character:WaitForChild("HumanoidRootPart", C.SpawnTimeout)
		local humanoid = character:WaitForChild("Humanoid", C.SpawnTimeout)
		assert(
			root and root:IsA("BasePart") and humanoid and humanoid:IsA("Humanoid"),
			"[Campaign] character parts missing"
		)
		if not player.Parent or not session.members[player.UserId] then
			return nil
		end
		thisVersion = version
		root.Anchored = true
		if character then
			local index = slotFor(player.UserId)
			local offset = Vector3.new(((index - 1) % 4) * 4 - 6, 0, math.floor((index - 1) / 4) * 4)
			local member = session.members[player.UserId]
			if member and member.status == "Waiting" then
				offset += Vector3.new(-28, 0, -8)
			end
			character:PivotTo(WorldService.spawnCFrame() + offset)
			root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		end
		if humanoid then
			humanoid.WalkSpeed, humanoid.UseJumpPower, humanoid.JumpHeight =
				Config.Player.WalkSpeed, false, Config.Player.JumpHeight
			humanoid.Died:Connect(function()
				if thisVersion == version then
					local member = session.members[player.UserId]
					if member and member.status == "Active" then
						local id = playerAdapter and playerAdapter.hiddenId(player)
						local locker = id and WorldService.locker(id)
						if locker then
							locker.occupant = nil
						end
						if playerAdapter then
							playerAdapter.exitHide(player)
						end
						Session.eliminate(session, player.UserId)
						publish()
					end
				end
			end)
		end
		player:SetAttribute("HasFlashlight", session.inventory.flashlight == 1)
		player:SetAttribute("DeathCause", "")
		player:SetAttribute(Tags.Attr.Flashlight, session.inventory.flashlight == 1)
		if playerAdapter then
			playerAdapter.resetForSpawn(player)
		end
		player:SetAttribute("CampaignGraceUntil", workspace:GetServerTimeNow() + C.SpawnGrace)
		local member = session.members[player.UserId]
		freeze(player, building or not member or member.status ~= "Active")
		spawnedVersion[player] = thisVersion
		return nil
	end)
	spawning[player] = nil
	if not ok then
		log.error("spawn failed for %s: %s", player.Name, tostring(reason))
	end
end

local function stage()
	if building then
		return
	end
	local ok, reason = Session.beginStage(session)
	if not ok then
		if reason ~= "need_players" then
			log.warn("stage refused: %s", reason or "?")
		end
		return
	end
	building = true
	version += 1
	for _, player in Players:GetPlayers() do
		freeze(player, true)
	end
	channels, nextActionAt, tutorialHeld = {}, {}, {}
	escapeEndsAt, lostRetryAt, lobbyReturnAt = 0, 0, 0
	clearRescues()
	CreatureService.reset()
	local plan = session.plan
	assert(plan, "[Campaign] missing stage plan")
	WorldService.resetRound(
		Random.new(if selectedMode == "Story" then Story.MapSeed else session.seed + session.stage),
		plan.sector
	)
	WorldService.setHouseStage(session.stage, session.seed, selectedMode)
	local world = WorldService.get()
	-- As trancas da missão solo não podem invalidar o grafo da campanha.
	local worldAdapter: any = WorldService
	if type(worldAdapter.doorSnapshot) == "function" and type(worldAdapter.applyDoors) == "function" then
		local states = worldAdapter.doorSnapshot()
		worldAdapter.applyDoors(states, {})
	end
	for _, focus in CollectionService:GetTagged(Tags.Interactable) do
		if focus:IsDescendantOf(world.root) then
			focus:SetAttribute(Tags.Attr.InteractEnabled, false)
		end
	end
	for id in world.interactables do
		WorldService.setInteractEnabled(id, world.interactables[id].kind == "Door")
	end
	-- Esconderijos usam a mesma seleção de alvo do jogador; precisam ser reativados após o reset.
	for _, locker in WorldService.features().lockers do
		WorldService.setInteractEnabled(locker.id, true)
	end
	built = Builder.build(world.root, plan, Config.Game.InteractDistance)
	WorldService.setPower(session.stage >= 3 and session.stage < 6)
	startedAt = if session.stage == 1 then workspace:GetServerTimeNow() else startedAt
	nextStageAt, nextThreatAt, blackoutUntil = 0, workspace:GetServerTimeNow() + C.ThreatInterval, 0
	for _, player in Players:GetPlayers() do
		freeze(player, true)
		task.spawn(spawnMember, player)
	end
	local thisVersion = version
	task.delay(if selectedMode == "Story" then 0 else C.StageIntroSeconds, function()
		if thisVersion ~= version then
			return
		end
		local deadline = os.clock() + C.SpawnTimeout
		local function everyoneReady(): boolean
			for _, player in Players:GetPlayers() do
				local member = session.members[player.UserId]
				if member and member.status == "Active" and spawnedVersion[player] ~= thisVersion then
					return false
				end
			end
			return true
		end
		while thisVersion == version and not everyoneReady() and os.clock() < deadline do
			task.wait(0.1)
		end
		if thisVersion ~= version then
			return
		end
		for _, player in Players:GetPlayers() do
			local member = session.members[player.UserId]
			if member and member.status == "Active" and spawnedVersion[player] ~= thisVersion then
				member.status = "Waiting"
				feedback(player, "spawn_failed")
				log.warn("spawn timed out for %s", player.Name)
			end
		end
		if selectedMode == "Story" then
			sceneSerial += 1
			sceneStartedAt = workspace:GetServerTimeNow()
			sceneEndsAt = sceneStartedAt + Story.SceneSeconds
			publish()
			task.wait(Story.SceneSeconds)
			if thisVersion ~= version then
				return
			end
		end
		building = false
		for _, player in Players:GetPlayers() do
			local member = session.members[player.UserId]
			freeze(player, not member or member.status ~= "Active")
		end
		if session.stage >= 3 then
			CreatureService.activate(nil)
		end
		CreatureService.setHunt(false)
		publish()
	end)
	publish()
	log.info("stage=%d seed=%d players=%d tasks=%d", session.stage, session.seed, plan.players, #plan.activities)
end

local function hasSight(player: Player, focus: BasePart, range: number): boolean
	local character, root, humanoid = parts(player)
	if not character or not root or not humanoid or humanoid.Health <= 0 or not focus.Parent then
		return false
	end
	if (root.Position - focus.Position).Magnitude > range then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local head = character:FindFirstChild("Head")
	local origin = if head and head:IsA("BasePart") then head.Position else root.Position + Vector3.yAxis * 1.5
	local hit = workspace:Raycast(origin, focus.Position - origin, params)
	return hit == nil or hit.Instance == focus or (hit.Position - focus.Position).Magnitude < 1.5
end

-- Consumível Segunda Chance (PerkService): levanta sem ajudante, com a mesma carência do resgate.
local function selfRevive(player: Player, expectedVersion: number)
	if expectedVersion ~= version or not player.Parent then
		return
	end
	local now = workspace:GetServerTimeNow()
	if not Session.selfRevive(session, player.UserId, now) then
		return
	end
	player:SetAttribute("CampaignGraceUntil", now + C.ReviveGrace)
	freeze(player, false)
	local beacon = rescueParts[player.UserId]
	if beacon then
		beacon:Destroy()
		rescueParts[player.UserId] = nil
	end
	for helperId, channel in channels do
		if channel.target == player.UserId then
			channels[helperId] = nil
		end
	end
	feedback(player, "second_chance")
	publish()
end

local function capture(player: Player)
	if playerAdapter then
		local id = playerAdapter.hiddenId(player)
		local locker = id and WorldService.locker(id)
		if locker then
			locker.occupant = nil
		end
		playerAdapter.exitHide(player)
	end
	local now = workspace:GetServerTimeNow()
	local member = session.members[player.UserId]
	if not member or member.status ~= "Active" or (session.phase ~= "Playing" and session.phase ~= "Extracting") then
		return
	end
	-- Segunda Chance no kit (PerkService): gasta agora e agenda o levantar; a derrota espera a janela.
	local captureVersion = version
	local rising = PerkService.secondChance(player, function()
		selfRevive(player, captureVersion)
	end)
	if not Session.capture(session, player.UserId, now, if rising then Perks.SECOND_CHANCE_DELAY + 2 else nil) then
		return
	end
	freeze(player, true)
	local _, root = parts(player)
	if root then
		local beacon = Build.part(
			WorldService.get().root,
			`Rescue_{player.UserId}`,
			Vector3.new(1, 1, 1),
			CFrame.new(root.Position + Vector3.new(0, 3.3, 0)),
			Color3.fromRGB(90, 220, 160),
			{ transparency = 0.4, collide = false }
		)
		beacon:SetAttribute(Tags.Attr.InteractId, `rescue_{player.UserId}`)
		beacon:SetAttribute(Tags.Attr.InteractPrompt, `RESGATAR {player.DisplayName}`)
		beacon:SetAttribute(Tags.Attr.InteractDistance, Config.Game.InteractDistance)
		beacon:SetAttribute(Tags.Attr.InteractEnabled, true)
		CollectionService:AddTag(beacon, Tags.Interactable)
		rescueParts[player.UserId] = beacon
	end
	publish()
	-- O cérebro legado termina em Capture; recolocar o Vigia permite continuar caçando a equipe.
	local thisVersion = version
	task.delay(C.CaptureRecovery, function()
		if thisVersion == version and (session.phase == "Playing" or session.phase == "Extracting") then
			CreatureService.reset()
			CreatureService.activate(nil)
			CreatureService.setFuses(math.min(2, session.stage - 1))
			CreatureService.setHunt(false)
		end
	end)
end

local function payCompletedTasks()
	for key, recipients in pendingTaskPayments do
		for id, contributed in recipients do
			local player = Players:GetPlayerByUserId(id)
			if not player then
				recipients[id] = nil
			elseif player:GetAttribute("StoreReady") == true then
				if
					TaskRewards.claim(taskPayments, key, id, function()
						return StoreService.awardTask(player, contributed) ~= nil
					end)
				then
					recipients[id] = nil
				end
			end
		end
		if next(recipients) == nil then
			pendingTaskPayments[key] = nil
		end
	end
end

local function afterActivity(previous: Session.Phase)
	if session.phase ~= previous then
		if session.phase == "Intermission" then
			nextStageAt = workspace:GetServerTimeNow() + C.IntermissionSeconds
			CreatureService.freeze()
			for _, player in Players:GetPlayers() do
				freeze(player, true)
			end
		elseif session.phase == "Extracting" then
			escapeEndsAt = workspace:GetServerTimeNow() + Config.House.EscapeSeconds
			WorldService.setHouseDestruction(session.stage == 5)
			CreatureService.makeNoise(
				if session.stage >= 6 then Vector3.new(0, 0, 850) else Vector3.new(26, -16, -68),
				500
			)
			CreatureService.setFrozen(false)
			WorldService.setPower(false)
			WorldService.openGate()
		end
	end
	publish()
end

local function interact(player: Player, id: string, _action: string?): { accepted: boolean, message: string }
	-- Fita VHS colecionável (Claude, monetização/progressão): mesma validação nos dois modos.
	if id == CollectibleService.TAPE_ID then
		return CollectibleService.collect(player)
	end
	local member = session.members[player.UserId]
	local now = workspace:GetServerTimeNow()
	local function response(ok: boolean, message: string)
		player:SetAttribute("CampaignAccepted", ok)
		feedback(player, message)
		return { accepted = ok, message = message }
	end
	if building or not member or member.status ~= "Active" then
		return response(false, "not_active")
	end
	if session.phase ~= "Playing" and session.phase ~= "Extracting" then
		return response(false, "not_playing")
	end
	if now < (nextActionAt[player.UserId] or 0) then
		return response(false, "wait")
	end
	local station = built and built.targets[id]
	local targetId = tonumber(string.match(id, "^rescue_([%-]?%d+)$"))
	local focus = if station then station.focus elseif targetId then rescueParts[targetId] else nil
	if focus then
		if not hasSight(player, focus, Config.Game.InteractDistance + Config.Game.InteractTolerance) then
			return response(false, "too_far")
		end
		nextActionAt[player.UserId] = now + C.ActionCooldown
		if targetId then
			local target = session.members[targetId]
			if not target or target.status ~= "Downed" then
				return response(false, "not_available")
			end
			if channels[player.UserId] then
				return response(false, "rescuing")
			end
			channels[player.UserId] = {
				target = targetId,
				-- Melhoria "Mãos de Socorrista" (nível publicado pelo StoreService) encurta o resgate.
				endsAt = now
					+ (if member.role == "medic" then C.MedicReviveSeconds else C.ReviveSeconds)
						* Perks.factor("socorro", tonumber(player:GetAttribute("PerkSocorro")) or 0),
			}
			return response(true, "rescuing")
		end
		assert(station, "[Campaign] missing activity target")
		local spec = session.tasks[station.taskId].spec
		if spec.kind == "explore" or spec.kind == "hide" or spec.kind == "breath" then
			return response(false, "not_available")
		end
		local previous: Session.Phase = session.phase
		local ok, message = Session.act(session, player.UserId, station.taskId, station.button, now)
		if message == "wrong_sequence" then
			CreatureService.makeNoise(focus.Position, 45)
		end
		if ok then
			CreatureService.makeNoise(focus.Position, 22)
		end
		if ok and message == "solved" then
			WorldService.houseEvent(spec.event)
			if spec.event == "silhouette" then
				CreatureService.silhouette()
				WorldService.upperNoise()
			end
			if spec.item == "flashlight" and playerAdapter then
				for _, teammate in Players:GetPlayers() do
					playerAdapter.grantFlashlight(teammate)
				end
			end
			if spec.kind == "clue" then
				local clue = station.focus.Parent and station.focus.Parent:FindFirstChild("Clue")
				local text = clue and clue:FindFirstChildWhichIsA("TextLabel", true)
				if text and replicated then
					replicated:SetAttribute("LastClue", text.Text)
				end
			end
			local activity = session.tasks[station.taskId]
			local key = `{rewardCampaign}:{session.stage}:{station.taskId}`
			local recipients: { [number]: boolean } = {}
			for _, teammate in Players:GetPlayers() do
				local participant = session.members[teammate.UserId]
				if
					participant
					and (
						participant.status == "Active"
						or participant.status == "Downed"
						or activity.contributors[teammate.UserId]
					)
				then
					if not (taskPayments[key] and taskPayments[key][teammate.UserId]) then
						recipients[teammate.UserId] = activity.contributors[teammate.UserId] == true
					end
				end
			end
			-- Dados ainda carregando? A fila paga assim que o perfil estiver pronto, inclusive após a etapa.
			local pending = pendingTaskPayments[key] or {}
			for recipientId, contributed in recipients do
				pending[recipientId] = pending[recipientId] == true or contributed
			end
			pendingTaskPayments[key] = pending
			payCompletedTasks()
		end
		afterActivity(previous)
		return response(ok, message)
	end
	if playerAdapter then
		local currentHide = playerAdapter.hiddenId(player)
		if currentHide then
			if currentHide ~= id then
				return response(false, "not_available")
			end
			local locker = WorldService.locker(currentHide)
			playerAdapter.exitHide(player)
			if locker then
				locker.occupant = nil
			end
			return response(true, "hide_exit")
		end
		local locker = WorldService.locker(id)
		if locker then
			if locker.occupant and locker.occupant ~= player then
				return response(false, "occupied")
			end
			if
				not hasSight(player, locker.door, 10.5)
				or playerAdapter.sinceExit(player) < Config.Hide.ExitCooldown
			then
				return response(false, "too_far")
			end
			local seen = CreatureService.sawEntry(player)
			if playerAdapter.enterHide(player, id, locker.inside, locker.eye, locker.exit, locker.front, seen) then
				locker.occupant = player
				return response(true, "hide_enter")
			end
		end
	end
	local item = WorldService.interactable(id)
	if
		item
		and item.kind == "Door"
		and hasSight(player, item.focus, Config.Game.InteractDistance + Config.Game.InteractTolerance)
	then
		nextActionAt[player.UserId] = now + C.ActionCooldown
		local door = WorldService.door(id)
		if door then
			WorldService.useDoor(id)
			CreatureService.makeNoise(door.center, 30)
			return response(true, "door_opened")
		end
	end
	return response(false, "not_available")
end

-- Consumível Continuação (StoreService "use_continue"): depois da derrota, a equipe repete a etapa.
local function retryStage(player: Player): (boolean, string?)
	if building or not session.members[player.UserId] then
		return false, "not_member"
	end
	local ok, reason = Session.retryStage(session)
	if not ok then
		return false, reason
	end
	version += 1
	clearRescues()
	CreatureService.reset()
	-- O checkpoint mantém a identidade da campanha: não repete pagamentos por derrota.
	GameState.set("RoundEndedAt", 0)
	nextStageAt = workspace:GetServerTimeNow() + C.IntermissionSeconds
	for _, other in Players:GetPlayers() do
		feedback(other, "checkpoint_restored")
	end
	publish()
	log.info("%s used a continue: stage %d again", player.Name, session.stage + 1)
	return true, nil
end

local function restartCampaign()
	if built then
		built.root:Destroy()
		built = nil
	end
	rewardCampaign += 1
	taskPayments, supplies, endingPaid = {}, {}, {}
	endingShown = false
	escapeEndsAt, lostRetryAt, lobbyReturnAt = 0, 0, 0
	version += 1
	building = false
	clearRescues()
	CreatureService.reset()
	selectedMode, modeVotes = qaMode, {}
	sceneStartedAt, sceneEndsAt = 0, 0
	local seed = if selectedMode == "Story"
		then Story.MapSeed
		else C.Seed or ((os.time() + version * 7919) % 2147483646)
	session = Session.new(seed, C, selectedMode, true)
	spawnSlots = {}
	for _, player in Players:GetPlayers() do
		Session.join(session, player.UserId)
		player:SetAttribute("GameModeVote", "")
		supplies[player.UserId] = { battery = 1, oxygen = 1, decoy = 1 }
		slotFor(player.UserId)
		player:SetAttribute("HasFlashlight", false)
		player:SetAttribute(Tags.Attr.Flashlight, false)
		if playerAdapter then
			playerAdapter.resetForSpawn(player)
		end
		local character, root = parts(player)
		if character and root then
			-- O lobby usa as câmeras da casa; reúne os avatares no pátio de entrada.
			character:PivotTo(CFrame.new((slotFor(player.UserId) - 1) * 4 - 10, 3, 77))
			root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			if playerAdapter then
				playerAdapter.markTeleported(player)
			end
		end
		freeze(player, true)
	end
	WorldService.setHouseStage(1, seed, "Story")
	nextStageAt, startedAt = 0, 0
	GameState.set("RoundId", version)
	GameState.set("RoundEndedAt", 0)
	if replicated then
		replicated:SetAttribute("Ending", "")
		replicated:SetAttribute("LastClue", "")
	end
	publish()
end

local function tick()
	payCompletedTasks()
	local now = workspace:GetServerTimeNow()
	local before = session.phase .. ":" .. Session.count(session, "Downed")
	local relayExpired = false
	for _, activity in session.tasks do
		if not activity.solved and activity.relayBy and now >= activity.relayUntil then
			relayExpired = true
		end
	end
	Session.tick(session, now)
	for helperId, channel in channels do
		local helper = Players:GetPlayerByUserId(helperId)
		local target = Players:GetPlayerByUserId(channel.target)
		local beacon = rescueParts[channel.target]
		local member = session.members[helperId]
		if
			not helper
			or not target
			or not beacon
			or not member
			or member.status ~= "Active"
			or not hasSight(helper, beacon, Config.Game.InteractDistance)
		then
			channels[helperId] = nil
			if helper then
				feedback(helper, "rescue_cancelled")
			end
		elseif now >= channel.endsAt then
			channels[helperId] = nil
			if Session.revive(session, helperId, channel.target, now) then
				target:SetAttribute("CampaignGraceUntil", now + C.ReviveGrace)
				freeze(target, false)
				beacon:Destroy()
				rescueParts[channel.target] = nil
				feedback(helper, "rescued")
				publish()
			end
		end
	end
	for id, beacon in rescueParts do
		local member = session.members[id]
		if not member or member.status ~= "Downed" then
			beacon:Destroy()
			rescueParts[id] = nil
		end
	end
	if session.phase == "Lobby" then
		local winner: Modes.Id? = qaMode or (Modes.winner(modeVotes, session.members, C.minPlayers))
		if Session.count(session) >= C.minPlayers and winner then
			if selectedMode ~= winner then
				selectedMode = winner
				session.mode = winner
				session.seed = if winner == "Story"
					then Story.MapSeed
					else C.Seed or ((os.time() + version * 7919) % 2147483646)
				nextStageAt = 0
			end
			if nextStageAt == 0 then
				nextStageAt = now + C.LobbySeconds
				publish()
			end
			if now >= nextStageAt then
				stage()
			end
		elseif nextStageAt ~= 0 then
			nextStageAt = 0
			selectedMode = nil
			publish()
		end
	elseif session.phase == "Intermission" then
		if now >= nextStageAt then
			stage()
		end
	elseif session.phase == "Extracting" then
		for _, player in Players:GetPlayers() do
			local _, root = parts(player)
			if root and WorldService.isInExitZone(root.Position) and Session.escape(session, player.UserId) then
				freeze(player, true)
				publish()
			end
		end
	end
	if session.phase == "Playing" and not building and session.plan then
		for _, spec in session.plan.activities do
			if session.tasks[spec.id].solved then
				continue
			end
			for _, player in Players:GetPlayers() do
				local member = session.members[player.UserId]
				local _, root = parts(player)
				if not member or member.status ~= "Active" or not root then
					continue
				end
				local hidden = playerAdapter and playerAdapter.hiddenId(player)
				local complete = spec.kind == "explore"
					and (root.Position - Vector3.new(spec.x, spec.y or 0, spec.z)).Magnitude < 9
				if not Session.taskReady(session, spec.id) then
					continue
				end
				if spec.kind == "hide" then
					complete = if session.stage >= 6
						then hidden ~= nil and string.sub(hidden, 1, 12) == "hide_Forest_"
						else hidden == "hide_Library"
				end
				if spec.kind == "breath" then
					local inHide = if session.stage >= 6
						then hidden ~= nil and string.sub(hidden, 1, 12) == "hide_Forest_"
						else hidden == "hide_Library"
					if inHide and player:GetAttribute("HoldBreath") == true then
						tutorialHeld[player.UserId] = (tutorialHeld[player.UserId] or 0) + 0.2
						complete = tutorialHeld[player.UserId] >= 2
					else
						tutorialHeld[player.UserId] = 0
					end
				end
				if complete then
					local previous: Session.Phase = session.phase
					Session.act(session, player.UserId, spec.id, 1, now)
					WorldService.houseEvent(spec.event)
					if spec.event == "awaken" then
						CreatureService.activate(Vector3.new(0, 0, -68))
						CreatureService.holdOff(10)
					end
					afterActivity(previous)
					break
				end
			end
			break
		end
	end
	if session.phase == "Playing" and not building then
		WorldService.forestPressure(now, true)
		if built then
			Builder.refresh(built, session.tasks, now, Session.count(session, "Active"))
		end
		if blackoutUntil > 0 and now >= blackoutUntil then
			WorldService.setPower(session.stage < 6)
			blackoutUntil = 0
			publish()
		end
		if now >= nextThreatAt then
			nextThreatAt = now + C.ThreatInterval
			if session.stage == 2 then
				local plan = session.plan
				if plan then
					local point = plan.activities[(math.floor(now) % #plan.activities) + 1]
					CreatureService.makeNoise(Vector3.new(point.x, 0, point.z), 100)
				end
			elseif session.stage >= 3 then
				WorldService.setPower(false)
				blackoutUntil = now + C.BlackoutSeconds
				publish()
			end
		end
	end
	if session.phase == "Extracting" and escapeEndsAt > 0 and now >= escapeEndsAt then
		for _, member in session.members do
			if member.status == "Active" or member.status == "Downed" then
				member.status, member.risingUntil = "Waiting", nil
			end
		end
		Session.tick(session, now)
		publish()
	end
	if session.phase == "Lost" and not building then
		if lostRetryAt == 0 then
			lostRetryAt = now + C.IntermissionSeconds
		end
		if now >= lostRetryAt then
			retryStage(Players:GetPlayers()[1])
			lostRetryAt = 0
		end
	end
	if
		session.phase == "Won"
		and Endings.resolve(Session.count(session, "Escaped"), math.min(now, escapeEndsAt), escapeEndsAt, session.stage)
	then
		if not endingShown then
			endingShown = true
			if session.stage < 6 then
				WorldService.houseRuins()
			end
			if session.stage >= 6 then
				CreatureService.freeze()
			else
				CreatureService.endingPose()
			end
		end
		if replicated then
			replicated:SetAttribute("Ending", if session.stage >= 6 then "forest_rescue" else "house_fire")
		end
		for _, player in Players:GetPlayers() do
			if
				not endingPaid[player.UserId]
				and session.members[player.UserId]
				and session.members[player.UserId].status == "Escaped"
			then
				endingPaid[player.UserId] = PlayerData.update(player, function(data)
					data.house.endings[if session.stage >= 6 then "forest_rescue" else "house_fire"] = os.time()
					data.house.achievements.escaped = os.time()
				end)
			end
		end
	end
	if before:sub(1, 10) == "Extracting" and session.phase == "Intermission" then
		nextStageAt = now + C.IntermissionSeconds
		escapeEndsAt = 0
		CreatureService.freeze()
		publish()
	end
	if session.phase == "Won" or session.phase == "Lost" then
		CreatureService.freeze()
		for _, player in Players:GetPlayers() do
			freeze(player, true)
		end
	end
	if session.phase == "Won" and lobbyReturnAt > 0 and now >= lobbyReturnAt then
		restartCampaign()
		return
	end
	if relayExpired or before ~= session.phase .. ":" .. Session.count(session, "Downed") then
		publish()
	end
end

function Runtime.Init()
	Players.CharacterAutoLoads = false
	StarterPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
	StarterPlayer.CameraMaxZoomDistance = 0.5
	StarterPlayer.CameraMinZoomDistance = 0.5
	local gameState = GameState.serverCreate()
	gameState:SetAttribute("CampaignActive", true)
	local state = Instance.new("Configuration")
	state.Name = "CampaignState"
	state.Parent = ReplicatedStorage
	replicated = state
	if not PhysicsService:IsCollisionGroupRegistered("CampaignPlayers") then
		PhysicsService:RegisterCollisionGroup("CampaignPlayers")
	end
	PhysicsService:CollisionGroupSetCollidable("CampaignPlayers", "CampaignPlayers", false)
	CreatureService.onCapture(capture)
	restartCampaign()
end

function Runtime.Start()
	ServerNet.onEvent("SetHousePreference", {
		args = {
			Guard.literal(
				"bob",
				"tilt",
				"shake",
				"fov",
				"flashes",
				"retro",
				"vhs",
				"haptics",
				"master",
				"music",
				"effects",
				"breathing",
				"ambient",
				"shaders",
				"quality"
			),
			Guard.number({ min = 0, max = 1 }),
		},
		rateLimit = { capacity = 12, refillPerSecond = 4 },
	}, function(player: Player, key: string, value: number)
		if not Preferences.valid(key, value) then
			return
		end
		if PlayerData.update(player, function(data)
			data.house.preferences[key] = value
		end) then
			local data = PlayerData.get(player)
			if data then
				player:SetAttribute("HousePreferences", HttpService:JSONEncode(data.house.preferences))
			end
		end
	end)

	if playerAdapter then
		playerAdapter.setNoiseHandler(CreatureService.makeNoise)
	end
	ServerNet.onInvoke(
		"UseHouseItem",
		{ args = { Guard.literal("battery", "oxygen", "decoy") }, rateLimit = { capacity = 3, refillPerSecond = 0.5 } },
		function(player: Player, item: string)
			local member = session.members[player.UserId]
			if
				building
				or not member
				or member.status ~= "Active"
				or (session.phase ~= "Playing" and session.phase ~= "Extracting")
			then
				return false
			end
			local stock = supplies[player.UserId]
			if not stock or (stock[item] or 0) <= 0 or not playerAdapter then
				return false
			end
			local _, root = parts(player)
			if not root then
				return false
			end
			if item == "battery" and player:GetAttribute("HasFlashlight") ~= true then
				feedback(player, "need_flashlight")
				return false
			end
			if
				(item == "battery" and playerAdapter.battery(player) >= 0.98)
				or (item == "oxygen" and (tonumber(player:GetAttribute("Oxygen")) or 100) >= 99.9)
			then
				feedback(player, "supply_full")
				return false
			end
			stock[item] -= 1
			if item == "battery" then
				playerAdapter.addBattery(player, 0.5)
			elseif item == "oxygen" then
				playerAdapter.addOxygen(player, 25)
			else
				CreatureService.makeNoise(root.Position + root.CFrame.LookVector * 6, 50)
			end
			player:SetAttribute("HouseSupplies", HttpService:JSONEncode(stock))
			return true
		end
	)

	StoreService.setContinueHandler(retryStage)
	ServerNet.onInvoke("SelectGameMode", {
		args = { Guard.literal("Standard", "Story") },
		rateLimit = { capacity = 4, refillPerSecond = 1 },
	}, function(player: Player, mode: Modes.Id)
		if session.phase ~= "Lobby" or not session.members[player.UserId] then
			return { accepted = false, message = "mode_locked" }
		end
		if modeVotes[player.UserId] == mode then
			return { accepted = true, message = "vote_recorded" }
		end
		modeVotes[player.UserId] = mode
		player:SetAttribute("GameModeVote", mode)
		nextStageAt = 0
		publish()
		return { accepted = true, message = "vote_recorded" }
	end)
	ServerNet.onInvoke("Interact", {
		args = {
			Guard.string({ maxLength = 32, pattern = "^[%w_%-]+$" }),
			Guard.optional(Guard.literal("use", "alt")),
		},
		rateLimit = { capacity = 6, refillPerSecond = 3 },
	}, interact)
	ServerNet.onInvoke("RequestRestart", {
		args = { Guard.optional(Guard.literal("full", "checkpoint")) },
		rateLimit = { capacity = 2, refillPerSecond = 0.5 },
	}, function(player: Player)
		local passed, reason = Session.voteRestart(session, player.UserId)
		if passed then
			restartCampaign()
		end
		feedback(player, if passed then "restarting" else (reason or "vote_recorded"))
		return { accepted = reason == nil, message = reason or "vote_recorded" }
	end)
	-- Compatível com o template anterior e com PlayerStateService (dono da bateria no polish).
	task.defer(function()
		if not ServerNet.isRegistered("SetFlashlight") then
			ServerNet.onEvent(
				"SetFlashlight",
				{ args = { Guard.boolean() }, rateLimit = { capacity = 10, refillPerSecond = 5 } },
				function(player: Player, on: boolean)
					player:SetAttribute(Tags.Attr.Flashlight, on)
				end
			)
		end
	end)
	local function join(player: Player)
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMaxZoomDistance, player.CameraMinZoomDistance = 0.5, 0.5
		local ok = session.members[player.UserId] ~= nil or Session.join(session, player.UserId)
		if not ok then
			player:SetAttribute("CampaignStatus", "Waiting")
			feedback(player, "party_full")
			return
		end
		slotFor(player.UserId)
		if not supplies[player.UserId] then
			supplies[player.UserId] = { battery = 1, oxygen = 1, decoy = 1 }
		end
		player:SetAttribute("HouseSupplies", HttpService:JSONEncode(supplies[player.UserId]))
		player:SetAttribute("GameModeVote", "")
		player.CharacterAdded:Connect(function(character)
			local function assign(instance: Instance)
				if instance:IsA("BasePart") then
					instance.CollisionGroup = "CampaignPlayers"
				end
			end
			for _, descendant in character:GetDescendants() do
				assign(descendant)
			end
			character.DescendantAdded:Connect(assign)
		end)
		task.spawn(spawnMember, player)
		publish()
	end
	Players.PlayerAdded:Connect(join)
	Players.PlayerRemoving:Connect(function(player)
		if playerAdapter then
			local id = playerAdapter.hiddenId(player)
			local locker = id and WorldService.locker(id)
			if locker then
				locker.occupant = nil
			end
		end
		modeVotes[player.UserId] = nil
		Session.leave(session, player.UserId)
		if Session.count(session) == 0 then
			rewardCampaign += 1
			taskPayments = {}
			version += 1
			building = false
			-- Servidor vazio também encerra a partida: a próxima equipe recebe outro mapa.
			session = Session.new(
				if qaMode == "Story" then Story.MapSeed else C.Seed or ((os.time() + version * 7919) % 2147483646),
				C,
				qaMode,
				true
			)
			selectedMode, modeVotes = qaMode, {}
			sceneStartedAt, sceneEndsAt = 0, 0
			nextStageAt, startedAt = 0, 0
			clearRescues()
			CreatureService.reset()
		end
		channels[player.UserId], nextActionAt[player.UserId], spawning[player] = nil, nil, nil
		spawnedVersion[player] = nil
		spawnSlots[player.UserId] = nil
		if rescueParts[player.UserId] then
			rescueParts[player.UserId]:Destroy()
			rescueParts[player.UserId] = nil
		end
		publish()
	end)
	for _, player in Players:GetPlayers() do
		join(player)
	end
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, reason = pcall(tick :: () -> any)
			if not ok then
				log.error("tick failed: %s", tostring(reason))
			end
		end
	end)
	if RunService:IsStudio() then
		local ok, args = pcall(function()
			return game:GetService("StudioTestService"):GetTestArgs()
		end)
		if ok and type(args) == "table" and args.campaignQA then
			task.spawn(function()
				require("../../Tests/CampaignHarness").run(Runtime, args)
			end)
		end
	end
end

function Runtime.restart()
	restartCampaign()
end

-- Salto de QA apenas no Studio: exercita o runtime real, sem fabricar estado replicado no cliente.
function Runtime.debugForest(chapter: number): boolean
	assert(RunService:IsStudio(), "Studio-only forest preview")
	assert(chapter >= 6 and chapter <= 8 and chapter % 1 == 0, "Invalid forest preview chapter")
	if building or #Players:GetPlayers() == 0 then
		return false
	end
	selectedMode, modeVotes = "Story", {}
	session = Session.new(Story.MapSeed, C, "Story", true)
	for _, player in Players:GetPlayers() do
		Session.join(session, player.UserId)
	end
	session.stage, session.phase = chapter - 1, "Intermission"
	session.inventory.flashlight = 1
	endingShown = false
	stage()
	return true
end

function Runtime.setPlayerAdapter(adapter: any)
	playerAdapter = adapter
end
function Runtime.lose(player: Player)
	capture(player)
end
function Runtime.win(player: Player)
	if Session.escape(session, player.UserId) then
		publish()
	end
end
function Runtime.getPhase(): "Loading" | "Intro" | "Playing" | "Won" | "Lost"
	return GameState.get("Phase")
end
function Runtime.snapshot(): { [string]: any }
	return {
		mode = selectedMode,
		building = building,
		tasks = session.tasks,
		phase = session.phase,
		stage = session.stage,
		seed = session.seed,
		players = Session.count(session),
		active = Session.count(session, "Active"),
		downed = Session.count(session, "Downed"),
		solved = Session.solvedCount(session),
		plan = session.plan,
		members = session.members,
	}
end

return Runtime
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="439">
          <Properties>
            <string name="Name">CoopSession</string>
            <string name="Source"><![CDATA[--!strict
-- Estado puro da equipe. Só o adaptador do servidor verifica distância/visão e aplica efeitos físicos.
local Catalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local Generator = require("./CampaignGenerator")
local HousePlan = require("./HousePlan")
local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Progress = require("@game/ReplicatedStorage/Shared/Game/HouseProgression")

export type Status = "Active" | "Downed" | "Waiting" | "Escaped"
export type Phase = "Lobby" | "Playing" | "Intermission" | "Extracting" | "Won" | "Lost"
export type Member = {
	id: number,
	role: string,
	status: Status,
	downedUntil: number,
	contributions: number,
	-- Segunda Chance (vantagem paga) em curso: até quando o caído ainda pode levantar sozinho.
	risingUntil: number?,
}
export type TaskState = {
	spec: Generator.Activity,
	progress: number,
	solved: boolean,
	relayBy: number?,
	relayUntil: number,
	contributors: { [number]: boolean },
}
export type Policy = { minPlayers: number, maxPlayers: number, downedSeconds: number, relayWindow: number }
export type State = {
	house: boolean,
	inventory: { [string]: number },
	checkpointInventory: { [string]: number },
	mode: string,
	seed: number,
	stage: number,
	phase: Phase,
	members: { [number]: Member },
	plan: Generator.Plan?,
	tasks: { [string]: TaskState },
	votes: { [number]: boolean },
	policy: Policy,
}

local Session = {}

local function finite(n: number): boolean
	return n == n and math.abs(n) < math.huge
end

function Session.new(seed: number, policy: Policy, mode: string?, house: boolean?): State
	assert(mode == nil or mode == "Standard" or mode == "Story", "Invalid game mode")
	assert(finite(seed) and seed % 1 == 0, "Invalid campaign seed")
	assert(
		policy.minPlayers >= 1 and policy.maxPlayers <= 8 and policy.minPlayers <= policy.maxPlayers,
		"Invalid party policy"
	)
	assert(policy.downedSeconds > 0 and policy.relayWindow > 0, "Invalid timer policy")
	return {
		house = house == true,
		inventory = {},
		checkpointInventory = {},
		mode = mode or "Standard",
		seed = seed,
		stage = 0,
		phase = "Lobby",
		members = {},
		plan = nil,
		tasks = {},
		votes = {},
		policy = table.clone(policy),
	}
end

function Session.count(state: State, status: Status?): number
	local n = 0
	for _, member in state.members do
		if status == nil or member.status == status then
			n += 1
		end
	end
	return n
end

function Session.join(state: State, id: number): (boolean, string?)
	if not finite(id) or id % 1 ~= 0 then
		return false, "invalid_player"
	end
	if state.members[id] then
		return false, "already_joined"
	end
	local count = Session.count(state)
	if count >= state.policy.maxPlayers then
		return false, "party_full"
	end
	local role = Catalog.Roles[count % #Catalog.Roles + 1].id
	state.members[id] = { id = id, role = role, status = "Waiting", downedUntil = 0, contributions = 0 }
	return true, nil
end

local function evaluate(state: State)
	if state.phase ~= "Playing" and state.phase ~= "Extracting" then
		return
	end
	local active = Session.count(state, "Active")
	local escaped = Session.count(state, "Escaped")
	local downed = Session.count(state, "Downed")
	local success: Phase = if state.house and state.stage == 5 then "Intermission" else "Won"
	-- Alguém caído vai levantar sozinho (Segunda Chance): a derrota espera a janela dele.
	for _, member in state.members do
		if member.status == "Downed" and member.risingUntil then
			return
		end
	end
	-- Evacuados não apagam instantaneamente os colegas derrubados: aguardar resgate/timeout.
	if state.phase == "Extracting" and active == 0 and escaped > 0 and downed > 0 then
		return
	end
	if state.phase == "Extracting" and active == 0 and downed == 0 and escaped > 0 then
		state.phase = success
	elseif active == 0 then
		state.phase = if escaped > 0 then success else "Lost"
	end
end

function Session.leave(state: State, id: number)
	state.members[id], state.votes[id] = nil, nil
	for _, activity in state.tasks do
		if activity.relayBy == id and not activity.solved then
			activity.relayBy, activity.relayUntil, activity.progress = nil, 0, 0
		end
	end
	evaluate(state)
	if Session.count(state) == 0 then
		state.phase, state.stage, state.plan, state.tasks, state.votes = "Lobby", 0, nil, {}, {}
	end
end

function Session.beginStage(state: State): (boolean, string?)
	if state.phase ~= "Lobby" and state.phase ~= "Intermission" then
		return false, "wrong_phase"
	end
	local count = Session.count(state)
	-- O mínimo vale só para iniciar a campanha. Desconexões não bloqueiam estágios posteriores.
	if count == 0 or (state.stage == 0 and count < state.policy.minPlayers) then
		return false, "need_players"
	end
	if state.stage >= (if state.house then #House.Chapters else #Catalog.Stages) then
		return false, "campaign_complete"
	end
	local plan = if state.house
		then HousePlan.create(state.seed, state.stage + 1, count, state.mode)
		else Generator.create(state.seed, state.stage + 1, count)
	local valid: boolean, reason: string? = false, nil
	if state.house then
		valid, reason = HousePlan.validate(plan)
	else
		valid, reason = Generator.validate(plan)
	end
	state.checkpointInventory = table.clone(state.inventory)
	if not valid then
		return false, reason
	end
	state.stage += 1
	state.plan, state.tasks, state.votes = plan, {}, {}
	for _, spec in plan.activities do
		state.tasks[spec.id] =
			{ spec = spec, progress = 0, solved = false, relayBy = nil, relayUntil = 0, contributors = {} }
	end
	for _, member in state.members do
		member.status, member.downedUntil = "Active", 0
	end
	state.phase = "Playing"
	return true, nil
end

function Session.solvedCount(state: State): number
	local n = 0
	for _, activity in state.tasks do
		if activity.solved then
			n += 1
		end
	end
	return n
end

function Session.taskReady(state: State, taskId: string): boolean
	local plan = state.plan
	if state.phase ~= "Playing" or not plan or not state.tasks[taskId] or state.tasks[taskId].solved then
		return false
	end
	for index, spec in plan.activities do
		if spec.id == taskId then
			if not state.house and state.mode ~= "Story" then
				return true
			end
			return Progress.ready(state.mode, plan.stage, index, function(n)
				return state.tasks[plan.activities[n].id].solved
			end)
		end
	end
	return false
end
function Session.act(state: State, id: number, taskId: string, button: number, now: number): (boolean, string)
	if state.phase ~= "Playing" then
		return false, "wrong_phase"
	end
	local member = state.members[id]
	if not member or member.status ~= "Active" then
		return false, "not_active"
	end
	if
		not finite(now)
		or not finite(button)
		or button % 1 ~= 0
		or button < 1
		or button > (if state.house then 4 else 3)
	then
		return false, "invalid_action"
	end
	local activity = state.tasks[taskId]
	if not activity or activity.solved then
		return false, "not_available"
	end
	if not Session.taskReady(state, taskId) then
		return false, "story_order"
	end
	local kind = activity.spec.kind
	local result = "progress"
	if state.house then
		if kind == "puzzle" or kind == "repair" then
			if activity.spec.order[activity.progress + 1] ~= button then
				return false, "wrong_sequence"
			end
			activity.progress += 1
			activity.solved = activity.progress >= #activity.spec.order
		else
			if button ~= 1 then
				return false, "invalid_action"
			end
			activity.progress, activity.solved = 1, true
		end
		if activity.solved and activity.spec.item then
			state.inventory[activity.spec.item] = 1
		end
	elseif kind == "repair" then
		if button ~= activity.progress + 1 then
			return false, "repair_order"
		end
		-- O técnico combina isolamento + encaixe; testar a energia continua sendo uma ação explícita.
		activity.progress += if member.role == "technician" and activity.progress == 0 then 2 else 1
		activity.solved = activity.progress >= 3
	elseif kind == "sequence" then
		if activity.spec.order[activity.progress + 1] ~= button then
			return false, "wrong_sequence"
		end
		activity.progress += 1
		activity.solved = activity.progress >= 3
	elseif kind == "relay" then
		if button ~= 1 then
			return false, "invalid_action"
		end
		if activity.relayBy == nil or activity.relayUntil <= now then
			activity.relayBy = id
			activity.relayUntil = now + state.policy.relayWindow * (if member.role == "operator" then 1.5 else 1)
			activity.progress = 1
			result = "need_partner"
		elseif activity.relayBy ~= id or Session.count(state, "Active") == 1 then
			activity.progress, activity.solved = 3, true
		else
			return false, "need_partner"
		end
	else
		return false, "unknown_activity"
	end
	-- Ajudar vale uma contribuição por estação, inclusive para o técnico. Repetir o relé não gera farm.
	if not activity.contributors[id] then
		activity.contributors[id] = true
		member.contributions += 1
	end
	if activity.solved then
		result = "solved"
	end
	local plan = state.plan
	if plan and Session.solvedCount(state) == #plan.activities then
		state.phase = if (state.house and state.stage == 5)
				or state.stage == (if state.house then #House.Chapters else #Catalog.Stages)
			then "Extracting"
			else "Intermission"
	end
	return true, result
end

-- `rising` (s): o jogador tem Segunda Chance; a derrota da equipe espera essa janela.
function Session.capture(state: State, id: number, now: number, rising: number?): boolean
	if state.phase ~= "Playing" and state.phase ~= "Extracting" then
		return false
	end
	local member = state.members[id]
	if not member or member.status ~= "Active" or not finite(now) then
		return false
	end
	member.status, member.downedUntil = "Downed", now + state.policy.downedSeconds
	member.risingUntil = if rising and rising > 0 and finite(rising) then now + rising else nil
	for _, activity in state.tasks do
		if activity.relayBy == id and not activity.solved then
			activity.relayBy, activity.relayUntil, activity.progress = nil, 0, 0
		end
	end
	evaluate(state)
	return true
end

function Session.eliminate(state: State, id: number): boolean
	local member = state.members[id]
	if not member or member.status ~= "Active" then
		return false
	end
	member.status, member.risingUntil = "Waiting", nil
	evaluate(state)
	return true
end

function Session.revive(state: State, helperId: number, targetId: number, now: number): (boolean, string?)
	if state.phase ~= "Playing" and state.phase ~= "Extracting" then
		return false, "wrong_phase"
	end
	local helper, target = state.members[helperId], state.members[targetId]
	if not finite(now) or helperId == targetId or not helper or helper.status ~= "Active" then
		return false, "not_active"
	end
	if not target or target.status ~= "Downed" or now >= target.downedUntil then
		return false, "not_available"
	end
	target.status, target.downedUntil = "Active", 0
	helper.contributions += 1
	return true, nil
end

-- Consumível "Segunda Chance" (Shared/Game/Perks): o próprio incapacitado levanta, sem ajudante.
function Session.selfRevive(state: State, id: number, now: number): (boolean, string?)
	if state.phase ~= "Playing" and state.phase ~= "Extracting" then
		return false, "wrong_phase"
	end
	local member = state.members[id]
	if not finite(now) or not member or member.status ~= "Downed" or now >= member.downedUntil then
		return false, "not_available"
	end
	member.status, member.downedUntil, member.risingUntil = "Active", 0, nil
	return true, nil
end

-- Consumível "Continuação": depois da derrota a equipe volta para o intervalo e repete a mesma etapa.
function Session.retryStage(state: State): (boolean, string?)
	if state.phase ~= "Lost" then
		return false, "wrong_phase"
	end
	if state.stage < 1 then
		return false, "not_available"
	end
	state.inventory = table.clone(state.checkpointInventory)
	state.stage -= 1
	state.phase = "Intermission"
	state.votes = {}
	return true, nil
end

function Session.tick(state: State, now: number)
	if not finite(now) then
		return
	end
	for _, activity in state.tasks do
		if not activity.solved and activity.relayBy and now >= activity.relayUntil then
			activity.relayBy, activity.relayUntil, activity.progress = nil, 0, 0
		end
	end
	for _, member in state.members do
		-- Janela da Segunda Chance vencida (jogador saiu, etapa trocou): volta a valer a derrota.
		if member.risingUntil and now >= member.risingUntil then
			member.risingUntil = nil
		end
		if member.status == "Downed" and now >= member.downedUntil then
			member.status = "Waiting"
			member.risingUntil = nil
		end
	end
	evaluate(state)
end

function Session.escape(state: State, id: number): boolean
	if state.phase ~= "Extracting" then
		return false
	end
	local member = state.members[id]
	if not member or member.status ~= "Active" then
		return false
	end
	member.status = "Escaped"
	evaluate(state)
	return true
end

function Session.voteRestart(state: State, id: number): (boolean, string?)
	if state.phase ~= "Lost" and state.phase ~= "Won" then
		return false, "wrong_phase"
	end
	if not state.members[id] then
		return false, "not_member"
	end
	state.votes[id] = true
	local votes = 0
	for voter in state.votes do
		if state.members[voter] then
			votes += 1
		end
	end
	return votes > Session.count(state) / 2, nil
end

return Session
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="440">
          <Properties>
            <string name="Name">Endings</string>
            <string name="Source"><![CDATA[--!strict
-- Resolução centralizada; apenas o final com fuga real está habilitado.
local Endings = {}
Endings.Available = table.freeze({ "house_fire", "forest_rescue" })
Endings.Pending = table.freeze({ "secret_escape", "tung_secret" })
function Endings.resolve(escaped: number, now: number, deadline: number, chapter: number?): string?
	if escaped > 0 and now <= deadline then
		return if chapter and chapter >= 6 then "forest_rescue" else "house_fire"
	end
	return nil
end
return Endings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="441">
          <Properties>
            <string name="Name">ForestPlan</string>
            <string name="Source"><![CDATA[--!strict
local Forest = require("@game/ReplicatedStorage/Shared/Game/ForestCatalog")
local Generator = require("./CampaignGenerator")
local Layout = require("../World/ProceduralLayout")
local Random = require("./SeededRandom")
local Plan = {}
function Plan.create(seed: number, chapter: number, players: number, mode: string): Generator.Plan
	assert(chapter >= 6 and chapter <= 8 and chapter % 1 == 0, "Invalid forest chapter")
	assert(players >= 1 and players <= 6 and players % 1 == 0, "Invalid forest party")
	local definition = Forest.Chapters[chapter - 5]
	local rng = Random.new(seed + chapter * 7919)
	local uses: { [string]: number } = {}
	local activities: { Generator.Activity } = {}
	for index, objective in definition.objectives do
		local room = Forest.Rooms[1]
		for _, candidate in Forest.Rooms do
			if candidate.id == objective.room then
				room = candidate
			end
		end
		uses[room.id] = (uses[room.id] or 0) + 1
		local offset = if mode == "Standard" then rng.integer(-3, 3) else 0
		local hide = objective.kind == "hide" or objective.kind == "breath"
		table.insert(activities, {
			id = `task_{index}`,
			slot = `{room.id}_{index}`,
			room = room.id,
			x = if hide then -24 else room.x + (if uses[room.id] % 2 == 1 then -5 else 5) + offset,
			y = 0,
			z = if hide then 730 else room.z + (uses[room.id] - 1) * 8,
			kind = objective.kind,
			item = objective.item,
			event = objective.event,
			title = objective.title,
			order = if objective.kind == "repair"
				then { 1, 2, 3 }
				elseif objective.kind == "puzzle" then rng.shuffle({ 1, 2, 3, 4 })
				else { 1 },
			house = true,
		})
	end
	return {
		house = true,
		mode = mode,
		seed = seed,
		stage = chapter,
		players = players,
		title = definition.title,
		threat = "echo",
		activities = activities,
		closedLinks = {},
		sector = Layout.create(seed, 1),
	}
end
function Plan.validate(plan: Generator.Plan): (boolean, string?)
	if
		not plan.house
		or plan.stage < 6
		or plan.stage > 8
		or plan.stage % 1 ~= 0
		or plan.players < 1
		or plan.players > 6
	then
		return false, "invalid_forest_plan"
	end
	local expected = Plan.create(plan.seed, plan.stage, plan.players, plan.mode or "Story")
	if #plan.activities ~= #expected.activities then
		return false, "missing_forest_objectives"
	end
	for index, spec in plan.activities do
		local other = expected.activities[index]
		if
			spec.id ~= other.id
			or spec.kind ~= other.kind
			or spec.room ~= other.room
			or spec.item ~= other.item
			or spec.event ~= other.event
			or spec.x ~= other.x
			or spec.y ~= other.y
			or spec.z ~= other.z
			or #spec.order ~= #other.order
		then
			return false, "invalid_forest_dependency"
		end
		for n, button in spec.order do
			if button ~= other.order[n] then
				return false, "invalid_forest_repair"
			end
		end
	end
	return true, nil
end
return Plan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="442">
          <Properties>
            <string name="Name">HouseActivities</string>
            <string name="Source"><![CDATA[--!strict
-- Objetos de missão da casa, distintos das estações industriais preservadas para regressão.
local CollectionService = game:GetService("CollectionService")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Build = require("../World/Build")
local Plan = require("./HousePlan")
local Generator = require("./CampaignGenerator")
local TaskProps = require("../World/HouseTaskProps")
local Progress = require("@game/ReplicatedStorage/Shared/Game/HouseProgression")
local Activities = {}
local repairSteps = { "ISOLAR O CIRCUITO", "ENCAIXAR OS FUSÍVEIS", "TESTAR A ENERGIA" }
local gold = Color3.fromRGB(219, 171, 80)
local symbols = { "LUA", "OLHO", "CHAMA", "PORTA" }
function Activities.build(parent: Instance, plan: Generator.Plan, distance: number): any
	assert(Plan.validate(plan))
	local old = parent:FindFirstChild("CampaignActivities")
	if old then
		old:Destroy()
	end
	local root = Build.folder(parent, "CampaignActivities")
	local built: any = { root = root, targets = {}, lamps = {}, labels = {}, meters = {}, plan = plan }
	for index, spec in plan.activities do
		local model = Build.model(root, spec.id)
		model:SetAttribute("RoomLabel", spec.room)
		local p = Vector3.new(spec.x, spec.y or 0, spec.z)
		-- Referência transparente para o marcador existente do FieldHud.
		Build.block(
			model,
			"Station",
			p,
			Vector3.new(0.2, 0.2, 0.2),
			0,
			gold,
			{ collide = false, query = false, transparency = 1 }
		)
		if spec.kind == "hide" or spec.kind == "breath" or spec.kind == "explore" then
			continue
		end
		local base = Build.block(model, "AntiquePedestal", p, Vector3.new(4, 1.7, 2), 0, Color3.fromRGB(53, 35, 29))
		base.Material = Enum.Material.Wood
		TaskProps.build(model, p, spec.item, spec.kind)
		if spec.kind == "clue" then
			local solution: { number }? = nil
			if plan.stage >= 6 then
				for _, candidate in plan.activities do
					if candidate.kind == "puzzle" then
						solution = candidate.order
						break
					end
				end
			elseif spec.item == "book" then
				solution = plan.activities[5].order
			elseif spec.item == "panel_clue" then
				solution = plan.activities[2].order
			elseif spec.item == "safe_clue" then
				solution = plan.activities[4].order
			end
			local text = if solution
				then `LUA=1 OLHO=2 CHAMA=3 PORTA=4\nORDEM: {table.concat(solution, " - ")}`
				elseif plan.stage >= 6 then "O ECO SOBREVIVEU À CASA.\nCHAMEM O RESGATE PELA TORRE."
				else "ELE NÃO É O DONO.\nO CORAÇÃO ESTÁ SOB A CASA."
			Build.sign(
				model,
				"Clue",
				p + Vector3.new(0, 4.5, -0.4),
				Vector3.zAxis,
				Vector2.new(8, 2.7),
				text,
				{ textColor = gold, background = Color3.fromRGB(28, 21, 19), lit = true }
			)
		end
		if spec.kind == "collect" and spec.item and string.find(spec.item, "key") then
			Build.cylinder(
				model,
				"KeyRing",
				p + Vector3.new(0, 2.3, 0),
				Vector3.yAxis,
				0.2,
				1.4,
				gold,
				{ collide = false }
			)
		elseif spec.item == "flashlight" then
			Build.light(base, "Street", Color3.fromRGB(255, 210, 139), 18, 0.9, true)
		end
		local count = if spec.kind == "puzzle" then 4 elseif spec.kind == "repair" then 3 else 1
		for button = 1, count do
			local id = `{spec.id}_{button}`
			local focus = Build.block(
				model,
				id,
				p + Vector3.new((button - (count + 1) / 2) * 1.8, 2, 0.5),
				Vector3.new(1.2, if spec.kind == "collect" then 1.6 else 0.8, 0.9),
				0,
				gold,
				{ collide = false }
			)
			focus:SetAttribute(Tags.Attr.InteractId, id)
			focus:SetAttribute(
				Tags.Attr.InteractPrompt,
				if spec.kind == "puzzle"
					then `PRESSIONAR {symbols[button]}`
					elseif spec.kind == "repair" then repairSteps[button]
					else spec.title
			)
			focus:SetAttribute(Tags.Attr.InteractDistance, distance)
			focus:SetAttribute(Tags.Attr.InteractEnabled, index == 1 and spec.kind ~= "hide" and spec.kind ~= "breath")
			CollectionService:AddTag(focus, Tags.Interactable)
			built.targets[id] = { taskId = spec.id, button = button, focus = focus }
			if count > 1 then
				Build.sign(
					model,
					"Symbol",
					focus.Position + Vector3.new(0, 1.5, 0),
					Vector3.zAxis,
					Vector2.new(1.7, 0.7),
					if spec.kind == "repair" then `{button} {repairSteps[button]}` else `{button} {symbols[button]}`,
					{ textColor = gold, lit = true }
				)
			end
		end
		if spec.kind == "repair" or spec.kind == "puzzle" then
			local status = Build.sign(
				model,
				"TaskProgress",
				p + Vector3.new(0, 6, 0),
				Vector3.zAxis,
				Vector2.new(9, 1.2),
				"",
				{ textColor = gold, lit = true }
			)
			built.labels[spec.id] = status:FindFirstChildWhichIsA("TextLabel", true)
		end
	end
	return built
end
function Activities.refresh(built: any, tasks: any)
	local ready: { [string]: boolean } = {}
	for index, spec in built.plan.activities do
		ready[spec.id] = not tasks[spec.id].solved
			and Progress.ready(built.plan.mode, built.plan.stage, index, function(n)
				return tasks[built.plan.activities[n].id].solved
			end)
	end
	for _, target in built.targets do
		local state = tasks[target.taskId]
		if not state then
			continue
		end
		local spec = state.spec
		if built.labels[spec.id] then
			built.labels[spec.id].Text = if state.solved
				then "CONCLUÍDO"
				elseif not ready[spec.id] then "ENCONTRE AS PISTAS E OS ITENS NECESSÁRIOS"
				elseif spec.kind == "repair" then `{state.progress}/3 · {repairSteps[state.progress + 1]}`
				else `{state.progress}/4 · CONSULTE A PISTA RECUPERADA`
		end
		local enabled = ready[target.taskId]
			and spec.kind ~= "hide"
			and spec.kind ~= "breath"
			and spec.kind ~= "explore"
		if spec.kind == "repair" then
			enabled = enabled and target.button == state.progress + 1
		end
		target.focus:SetAttribute(Tags.Attr.InteractEnabled, enabled)
		target.focus.Transparency = if spec.kind == "collect" then 1 else 0
		if spec.kind == "collect" and target.focus.Parent then
			for _, object in target.focus.Parent:GetDescendants() do
				if
					object:IsA("BasePart")
					and object ~= target.focus
					and object.Name ~= "Station"
					and object.Name ~= "AntiquePedestal"
				then
					object.Transparency = if state.solved then 1 else 0
				end
			end
		end
		target.focus.Color = if state.solved or (spec.kind == "repair" and target.button <= state.progress)
			then Color3.fromRGB(63, 105, 76)
			elseif enabled then Color3.fromRGB(219, 171, 80)
			else Color3.fromRGB(97, 91, 77)
	end
end
return Activities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="443">
          <Properties>
            <string name="Name">HouseLevelPlan</string>
            <string name="Source"><![CDATA[--!strict
-- Sorteio privado: a História preserva o percurso; o Desafio visita a propriedade inteira.
local Random = require("./SeededRandom")
export type Spot = { room: string, x: number, y: number, z: number }
export type Passage = { x: number, y: number, z: number, width: number }
export type Level = {
	outdoor: boolean,
	theme: string,
	spots: { Spot },
	passages: { Passage },
	stairSide: number,
	serviceStair: boolean,
}
local Levels = {}

function Levels.create(seed: number, chapter: number, mode: string): Level
	local rng = Random.new(seed + chapter * 104729)
	local outdoor = mode == "Standard" and (chapter == 3 or (chapter == 4 and rng.integer(0, 1) == 1))
	local stairSide = if rng.integer(0, 1) == 0 then -1 else 1
	local spots: { Spot } = {
		{ room = "JARDIM DE INVERNO", x = -76, y = 0, z = 24 },
		{ room = "PAVILHÃO DAS MEMÓRIAS", x = -76, y = 0, z = -44 },
		{ room = "ESTUFA", x = 76, y = 0, z = 24 },
		{ room = "OFICINA DO JARDINEIRO", x = 76, y = 0, z = -44 },
		{ room = "PÁTIO DO RELÓGIO", x = -22, y = 0, z = -101 },
		{ room = "FONTE SELADA", x = 22, y = 0, z = -101 },
	}
	local passages: { Passage } = {}
	spots[2] = { room = "MIRANTE DO JARDIM", x = stairSide * 94, y = 8, z = 36 }
	if mode == "Standard" then
		for _, y in { -16, 0, 16, 32 } do
			for _, side in { -1, 1 } do
				-- Salas unidas viram salões; outras recebem portas de serviço de dez studs.
				for _, z in { -20, -52 } do
					local roll = rng.integer(1, 4)
					local stairAccess = chapter >= 3 and y >= 16 and side == stairSide and z == -52
					if roll == 1 and not stairAccess then
						continue
					end
					table.insert(passages, { x = side * 26, y = y, z = z, width = if roll == 2 then 24 else 10 })
				end
			end
		end
	end
	return {
		outdoor = outdoor,
		theme = if outdoor
			then ({ "O JARDIM DAS LEMBRANÇAS", "OS SEGREDOS DA ESTUFA", "O PÁTIO ESQUECIDO" })[rng.integer(1, 3)]
			else "A CASA POR DENTRO",
		spots = if outdoor then rng.shuffle(spots) else {},
		passages = passages,
		stairSide = stairSide,
		serviceStair = mode == "Standard" and chapter >= 3,
	}
end

function Levels.relocate(level: Level, index: number): Spot?
	return if level.outdoor then level.spots[index] else nil
end

return Levels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="444">
          <Properties>
            <string name="Name">HousePlan</string>
            <string name="Source"><![CDATA[--!strict
-- O plano privado mantém códigos e pontos reproduzíveis sem replicar soluções no HUD.
local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Generator = require("./CampaignGenerator")
local Layout = require("../World/ProceduralLayout")
local Random = require("./SeededRandom")
local Levels = require("./HouseLevelPlan")
local Plan = {}
function Plan.create(seed: number, chapter: number, players: number, mode: string): Generator.Plan
	if chapter >= 6 then
		return require("./ForestPlan").create(seed, chapter, players, mode)
	end
	assert(chapter >= 1 and chapter <= #House.Chapters and chapter % 1 == 0, "Invalid house chapter")
	assert(players >= 1 and players <= 6 and players % 1 == 0, "Invalid house party")
	local rng = Random.new(seed + chapter * 7919)
	local level = Levels.create(seed, chapter, mode)
	local activities: { Generator.Activity } = {}
	local roomUses: { [string]: number } = {}
	for index, objective in House.Chapters[chapter].objectives do
		local room: House.Room? = nil
		for _, candidate in House.Rooms do
			if candidate.id == objective.room then
				room = candidate
			end
		end
		assert(room, "Unknown house room")
		local solution = if objective.kind == "puzzle" then rng.shuffle({ 1, 2, 3, 4 }) else { 1 }
		-- Variação dentro da sala preserva todos os pré-requisitos e os corredores.
		local offset = if mode == "Standard" and room.id ~= "Hall" then rng.integer(-2, 2) else 0
		roomUses[room.id] = (roomUses[room.id] or 0) + 1
		local use = roomUses[room.id]
		local dx = if use % 2 == 1 then -5 else 5
		local dz = if use <= 2 then -3 else 6
		if room.id == "Hall" then
			dx, dz = 0, -(use - 1) * 14
		end
		if objective.kind == "hide" or objective.kind == "breath" then
			dx, dz = if room.x < 0 then -11 else 11, 11
			offset = 0
		end
		local spot = Levels.relocate(level, index)
		local repair = mode == "Standard" and objective.event == "power"
		table.insert(activities, {
			id = `task_{index}`,
			slot = `{objective.room}_{index}`,
			room = if spot then spot.room else room.id,
			x = if spot then spot.x else room.x + dx + offset,
			y = if spot then spot.y else room.y,
			z = if spot then spot.z else room.z + dz,
			kind = if repair then "repair" else objective.kind,
			order = if repair then { 1, 2, 3 } else solution,
			title = if spot then `{objective.title} / {spot.room}` else objective.title,
			item = objective.item,
			event = objective.event,
			house = true,
		})
	end
	return {
		house = true,
		mode = mode,
		seed = seed,
		stage = chapter,
		players = players,
		title = if level.outdoor
			then string.format("%02d · %s", chapter, level.theme)
			else House.Chapters[chapter].title,
		threat = if chapter < 3 then "watcher" else "echo",
		activities = activities,
		closedLinks = {},
		sector = Layout.create(seed, 1),
	}
end
function Plan.validate(plan: Generator.Plan): (boolean, string?)
	if plan.stage >= 6 then
		return require("./ForestPlan").validate(plan)
	end
	if not plan.house or plan.stage < 1 or plan.stage > #House.Chapters or plan.players < 1 or plan.players > 6 then
		return false, "invalid_house_plan"
	end
	local expected = House.Chapters[plan.stage].objectives
	local level = Levels.create(plan.seed, plan.stage, plan.mode or "Story")
	if #plan.activities ~= #expected then
		return false, "missing_objectives"
	end
	local ids: { [string]: boolean } = {}
	for index, activity in plan.activities do
		local objective = expected[index]
		local spot = Levels.relocate(level, index)
		local repair = plan.mode == "Standard" and objective.event == "power"
		if
			ids[activity.id]
			or activity.room ~= (if spot then spot.room else objective.room)
			or activity.kind ~= (if repair then "repair" else objective.kind)
			or activity.item ~= objective.item
			or activity.event ~= objective.event
		then
			return false, "invalid_dependency"
		end
		ids[activity.id] = true
		if spot and (activity.x ~= spot.x or activity.y ~= spot.y or activity.z ~= spot.z) then
			return false, "invalid_exterior_position"
		end
		if
			repair
			and (#activity.order ~= 3 or activity.order[1] ~= 1 or activity.order[2] ~= 2 or activity.order[3] ~= 3)
		then
			return false, "invalid_repair"
		end
		if activity.kind == "puzzle" and #activity.order ~= 4 then
			return false, "missing_solution"
		end
	end
	return true, nil
end
return Plan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="445">
          <Properties>
            <string name="Name">SeededRandom</string>
            <string name="Source"><![CDATA[--!strict
-- Park-Miller: operações inteiras exatas em double, estável no Lune e no Roblox.
local SeededRandom = {}
export type Generator = { integer: (number, number) -> number, shuffle: <T>({ T }) -> { T } }

function SeededRandom.new(seed: number): Generator
	assert(seed == seed and math.abs(seed) < math.huge and seed % 1 == 0, "Seed must be a finite integer")
	local state = (seed % 2147483646) + 1
	local function integer(a: number, b: number): number
		assert(a % 1 == 0 and b % 1 == 0 and b >= a, "Invalid integer range")
		state = (state * 16807) % 2147483647
		return a + (state % (b - a + 1))
	end
	local function shuffle<T>(items: { T }): { T }
		local out = table.clone(items)
		for i = #out, 2, -1 do
			local j = integer(1, i)
			out[i], out[j] = out[j], out[i]
		end
		return out
	end
	return { integer = integer, shuffle = shuffle }
end

return SeededRandom
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="446">
