-- ===================== Interface =====================

local function px(value: string): string
	return PixelText.normalize(value)
end

local function buildUi()
	local screen = Create("ScreenGui", {
		Name = "TrailerUi",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 500,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}) :: ScreenGui
	local function black(name: string, fields: { [string]: any }): Frame
		local base: { [string]: any } = { Name = name, BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }
		for key, value in fields do
			base[key] = value
		end
		return Create("Frame", base) :: Frame
	end
	ui.top = black("BarTop", { Size = UDim2.fromScale(1, LETTERBOX), ZIndex = 5, Parent = screen })
	ui.bottom = black("BarBottom", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, LETTERBOX),
		ZIndex = 5,
		Parent = screen,
	})
	-- Vinheta de cinema (escurece as bordas).
	ui.vignette = Create("Frame", {
		Name = "Vignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = screen,
	}, {
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(0.22, 1),
				NumberSequenceKeypoint.new(0.78, 1),
				NumberSequenceKeypoint.new(1, 0.35),
			}),
		}),
	})
	-- Frestas do armário.
	ui.slits = Create("Frame", {
		Name = "Slits",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 3,
		Parent = screen,
	})
	for i = 0, 7 do
		black(`Slat{i}`, {
			Position = UDim2.fromScale(0, i / 8),
			Size = UDim2.fromScale(1, 1 / 8 - 0.045),
			BackgroundTransparency = 0.04,
			ZIndex = 3,
			Parent = ui.slits,
		})
	end
	ui.static = Create("Frame", {
		Name = "Static",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 6,
		Parent = screen,
	})
	ui.bars = {}
	for _ = 1, 26 do
		table.insert(ui.bars, Create("Frame", { BorderSizePixel = 0, ZIndex = 6, Parent = ui.static }))
	end
	ui.black = black("Black", { Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = screen })
	ui.flash = Create("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = screen,
	})
	-- Cartela grande.
	ui.titleHolder = Create("Frame", {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.22),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 9,
		Parent = screen,
	})
	ui.titleScale = Create("UIScale", { Parent = ui.titleHolder })
	ui.title = Create("TextLabel", {
		Size = UDim2.fromScale(1, 0.7),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		TextColor3 = Theme.Text,
		TextStrokeTransparency = 0.2,
		ZIndex = 9,
		Parent = ui.titleHolder,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 120 }) })
	ui.titleSub = Create("TextLabel", {
		Position = UDim2.fromScale(0, 0.72),
		Size = UDim2.fromScale(1, 0.28),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		TextColor3 = Theme.Hazard,
		ZIndex = 9,
		Parent = ui.titleHolder,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 44 }) })
	-- Legenda (máquina de escrever) na faixa de baixo.
	ui.caption = Create("TextLabel", {
		Name = "Caption",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 1 - LETTERBOX / 2),
		Size = UDim2.fromScale(0.86, LETTERBOX * 0.5),
		BackgroundTransparency = 1,
		FontFace = Theme.FontNote,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(226, 220, 198),
		Visible = false,
		ZIndex = 9,
		Parent = screen,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 34 }) })
	-- Logo.
	ui.logo = Create("Frame", {
		Name = "Logo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.47),
		Size = UDim2.fromScale(0.8, 0.5),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 9,
		Parent = screen,
	})
	ui.logoScale = Create("UIScale", { Parent = ui.logo })
	ui.logoRec = Create("TextLabel", {
		Size = UDim2.fromScale(1, 0.1),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		Text = px("● REC · ARQUIVO 009 · TURNO DA NOITE"),
		TextColor3 = Theme.Accent,
		ZIndex = 9,
		Parent = ui.logo,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 24 }) })
	ui.logoName = Create("TextLabel", {
		Position = UDim2.fromScale(0, 0.14),
		Size = UDim2.fromScale(1, 0.42),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		Text = px("SUBESTAÇÃO 9"),
		TextColor3 = Theme.Text,
		TextStrokeColor3 = Theme.Accent,
		TextStrokeTransparency = 0.4,
		ZIndex = 9,
		Parent = ui.logo,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 150 }) })
	ui.logoTag = Create("TextLabel", {
		Position = UDim2.fromScale(0, 0.58),
		Size = UDim2.fromScale(1, 0.12),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		Text = px("O VIGIA AINDA ESTÁ NO TURNO"),
		TextColor3 = Theme.Hazard,
		ZIndex = 9,
		Parent = ui.logo,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 36 }) })
	ui.logoModes = Create("TextLabel", {
		Position = UDim2.fromScale(0, 0.74),
		Size = UDim2.fromScale(1, 0.1),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		Text = px("MODO HISTÓRIA · CO-OP DE 2 A 8 JOGADORES"),
		TextColor3 = Theme.Text,
		ZIndex = 9,
		Visible = false,
		Parent = ui.logo,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 28 }) })
	ui.logoSoon = Create("TextLabel", {
		Position = UDim2.fromScale(0, 0.88),
		Size = UDim2.fromScale(1, 0.12),
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextScaled = true,
		Text = px("EM BREVE NO ROBLOX"),
		TextColor3 = Color3.fromRGB(120, 200, 140),
		ZIndex = 9,
		Visible = false,
		Parent = ui.logo,
	}, { Create("UITextSizeConstraint", { MaxTextSize = 34 }) })
	screen.Parent = player:WaitForChild("PlayerGui")
	gui = screen
end

-- Entrada "pancada": cresce, encolhe para o tamanho e treme; sai em 0,15 s.
local function slam(holder: GuiObject, scale: UIScale, local_t: number, d: number)
	local inT = math.clamp(local_t / 0.14, 0, 1)
	scale.Scale = 1.35 - 0.35 * (1 - (1 - inT) ^ 3)
	local shake = if local_t < 0.3 then (0.3 - local_t) * 30 else 0
	holder.Position = UDim2.new(0.5, rng:NextNumber(-shake, shake), 0.5, rng:NextNumber(-shake, shake))
	local out = math.clamp((d - local_t) / 0.15, 0, 1)
	return out
end

local function renderUi(time: number)
	local now = os.clock()
	-- Preto.
	local isBlack = time >= DURATION
	for _, span in BLACK do
		if time >= span[1] and time < span[2] then
			isBlack = true
		end
	end
	ui.black.Visible = isBlack
	-- Clarão.
	local flash = 0
	for _, at in FLASHES do
		local since = time - at
		if since >= 0 and since < 0.35 then
			flash = math.max(flash, 1 - since / 0.35)
		end
	end
	ui.flash.BackgroundTransparency = 1 - flash * 0.9
	-- Estática.
	local static = false
	for _, at in STATIC do
		if time >= at - 0.06 and time < at + 0.14 then
			static = true
		end
	end
	ui.static.Visible = static
	if static then
		for _, bar in ui.bars do
			local gray = rng:NextInteger(30, 240)
			bar.BackgroundColor3 = Color3.fromRGB(gray, gray, gray)
			bar.BackgroundTransparency = rng:NextNumber(0, 0.5)
			bar.Position = UDim2.fromScale(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 1))
			bar.Size = UDim2.new(rng:NextNumber(0.5, 1.4), 0, 0, rng:NextInteger(2, 30))
		end
	end
	-- Frestas (plano do armário).
	ui.slits.Visible = lastShot == "locker" and not isBlack
	-- Cartelas grandes.
	local shownTitle = false
	for _, title in TITLES do
		local local_t = time - title.t
		if local_t >= 0 and local_t < title.d then
			shownTitle = true
			ui.titleHolder.Visible = true
			ui.title.Text = px(title.text)
			ui.title.TextColor3 = title.color or Theme.Text
			ui.titleHolder.Size = UDim2.fromScale(0.9, 0.22 * (title.size or 1))
			ui.titleSub.Text = if title.sub then px(title.sub) else ""
			local out = slam(ui.titleHolder, ui.titleScale, local_t, title.d)
			ui.title.TextTransparency = 1 - out
			ui.titleSub.TextTransparency = 1 - out
			ui.title.TextStrokeTransparency = 1 - out * 0.8
		end
	end
	if not shownTitle then
		ui.titleHolder.Visible = false
	end
	-- Legenda datilografada.
	local caption: Caption? = nil
	for _, c in CAPTIONS do
		if time >= c.t and time < c.t + c.d then
			caption = c
		end
	end
	if caption then
		local chars = math.floor((time - caption.t) * 38)
		ui.caption.Visible = true
		local cut = utf8.offset(caption.text, chars + 1)
		ui.caption.Text = if cut then string.sub(caption.text, 1, cut - 1) else caption.text
		ui.caption.ZIndex = 9
	else
		ui.caption.Visible = false
	end
	-- Logos (abertura 3,6–5,2; final 31,6–38,9).
	local openLogo = time >= 3.6 and time < 5.2
	local endLogo = time >= 31.6 and time < 38.9
	ui.logo.Visible = openLogo or endLogo
	if openLogo or endLogo then
		local local_t = time - (if openLogo then 3.6 else 31.6)
		local d = if openLogo then 1.6 else 7.3
		local out = slam(ui.logo, ui.logoScale, local_t, d)
		ui.logo.Position = UDim2.new(0.5, ui.logo.Position.X.Offset, 0.47, ui.logo.Position.Y.Offset)
		-- Falha de luz no logo.
		local flicker = (local_t > 0.5 and rng:NextNumber() < 0.06) and 0.6 or 0
		ui.logoName.TextTransparency = math.clamp(1 - out + flicker, 0, 1)
		ui.logoRec.TextTransparency = if (now * 1.6) % 1 < 0.6 then 1 - out else 1
		ui.logoTag.TextTransparency = 1 - out
		ui.logoModes.Visible = endLogo and local_t > 1.0
		ui.logoSoon.Visible = endLogo and local_t > 2.0
		ui.logoModes.TextTransparency = 1 - out
		ui.logoSoon.TextTransparency = 1 - out
	end
end

-- ===================== Sons =====================

local function playCue(index: number, cue: SoundCue)
	local clip = (Audio :: any)[cue.key]
	if not clip then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = `Trailer_{cue.key}`
	sound.SoundId = clip.id
	sound.Volume = cue.volume or clip.volume
	sound.PlaybackSpeed = cue.speed or clip.speed or 1
	sound.Looped = cue.stop ~= nil and cue.stop - cue.t > 4
	sound.SoundGroup = trailerMix
	if clip.region then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(clip.region[1], clip.region[2])
	end
	sound.Parent = SoundService
	sound:Play()
	sounds[index] = sound
end

local function updateSounds(time: number)
	for index, cue in SOUNDS do
		if not fired[index] and time >= cue.t then
			fired[index] = true
			playCue(index, cue)
		end
		local sound = sounds[index]
		if sound and cue.stop and time >= cue.stop then
			sound:Stop()
			sound:Destroy()
			sounds[index] = nil
		end
	end
end

local function stopSounds(keepFired: boolean?)
	for index, sound in sounds do
		sound:Stop()
		sound:Destroy()
		sounds[index] = nil
	end
	if not keepFired then
		fired = {}
	end
end

-- ===================== Execução =====================

local function shotAt(time: number): Shot?
	for _, shot in SHOTS do
		if time >= shot.t and time < shot.t + shot.d then
			return shot
		end
	end
	return nil
end

local function frame(time: number, dt: number)
	renderUi(time)
	local shot = shotAt(time)
	allLightsOff()
	if not shot then
		lastShot = ""
		hideAll()
		-- Câmera parada (a tela está preta ou no logo).
		Camera.setCinema(CFrame.lookAt(v(0, 300, 0), v(0, 300, -10)), 50, v(0, 300, -10))
		return
	end
	if shot.name ~= lastShot then
		lastShot = shot.name
		hideAll()
	end
	local local_t = time - shot.t
	local alpha = math.clamp(local_t / shot.d, 0, 1)
	if shot.act then
		shot.act(alpha, local_t, dt)
	end
	if shot.name ~= "graffiti" then
		glowGraffiti(false)
	end
	local cf, fov = shot.camera(alpha, local_t)
	local lampPart = fx.cameraLamp.Parent :: BasePart
	lampPart.CFrame = cf * CFrame.new(0.6, -0.8, 0)
	local shake = shot.shake or 0
	if time < hitShakeUntil then
		shake += 1
	end
	if shake > 0 then
		local k = shake * 0.012
		cf *= CFrame.Angles(
			math.noise(time * 2.1, 3.3) * k + rng:NextNumber(-k, k) * 0.15,
			math.noise(time * 1.7, 9.1) * k,
			math.noise(time * 1.3, 5.7) * k * 0.6
		)
	end
	Camera.setCinema(cf, fov, cf.Position + cf.LookVector * 20)
	-- Sem esperar o próximo quadro do compositor.
	local camera = workspace.CurrentCamera
	if camera then
		camera.CFrame = cf
		camera.FieldOfView = fov
	end
end

local function setActive(on: boolean)
	if on == enabled then
		return
	end
	enabled = on
	if gui then
		gui.Enabled = on
	end
	if grade then
		grade.Enabled = on
	end
	player:SetAttribute("CinematicActive", on)
	if on then
		for _, group in SoundService:GetChildren() do
			if group:IsA("SoundGroup") and group ~= trailerMix then
				savedAudioVolumes[group] = group.Volume
				group.Volume = 0
			end
		end
		for _, kind in Enum.CoreGuiType:GetEnumItems() do
			if kind ~= Enum.CoreGuiType.All then
				pcall(function()
					savedCoreGui[kind] = StarterGui:GetCoreGuiEnabled(kind)
					StarterGui:SetCoreGuiEnabled(kind, false)
				end)
			end
		end
	else
		for group, volume in savedAudioVolumes do
			if group.Parent then
				group.Volume = volume
			end
		end
		savedAudioVolumes = {}
		for kind, visible in savedCoreGui do
			pcall(function()
				StarterGui:SetCoreGuiEnabled(kind, visible)
			end)
		end
		savedCoreGui = {}
	end
	-- Esconde as outras telas durante o trailer.
	for _, other in player.PlayerGui:GetChildren() do
		if other:IsA("ScreenGui") and other ~= gui then
			if on then
				other:SetAttribute("TrailerWasEnabled", other.Enabled)
				other.Enabled = false
			elseif other:GetAttribute("TrailerWasEnabled") ~= nil then
				other.Enabled = other:GetAttribute("TrailerWasEnabled") == true
				other:SetAttribute("TrailerWasEnabled", nil)
			end
		end
	end
	-- O próprio personagem sai de cena (fica parado longe).
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		if on then
			savedCharacterPivot = character:GetPivot()
			savedAnchored = root.Anchored
			root.Anchored = true
			character:PivotTo(CFrame.new(-150, 4, 110))
		else
			if savedCharacterPivot then
				character:PivotTo(savedCharacterPivot)
			end
			root.Anchored = savedAnchored
			savedCharacterPivot = nil
		end
	end
	if not on then
		Camera.endCinema()
		allLightsOff()
		hideAll()
		glowGraffiti(false)
	end
end

function Controller.prepare()
	if not props then
		buildProps()
		buildActors()
	end
	setActive(true)
	frame(0, 0)
end

function Controller.play()
	Controller.prepare()
	stopSounds()
	armedAt = nil
	playing = true
	seekTime = nil
	startedAt = os.clock()
	lastTime = 0
end

function Controller.arm(delay: number): number
	Controller.prepare()
	stopSounds()
	playing = false
	seekTime = 0
	armedAt = DateTime.now().UnixTimestampMillis + math.clamp(delay, 0, 30) * 1000
	return armedAt :: number
end

function Controller.seek(time: number)
	Controller.prepare()
	playing = false
	armedAt = nil
	stopSounds()
	seekTime = time
end

function Controller.stop()
	playing = false
	armedAt = nil
	seekTime = nil
	stopSounds()
	setActive(false)
end

function Controller.Start()
	if not RunService:IsStudio() then
		return
	end
	buildUi()
	local bridge = Instance.new("BindableFunction")
	bridge.Name = "TrailerBridge"
	bridge.OnInvoke = function(command: string, value: any): any
		if command == "play" then
			Controller.play()
		elseif command == "arm" then
			return Controller.arm(tonumber(value) or 4)
		elseif command == "seek" then
			Controller.seek(tonumber(value) or 0)
		elseif command == "stop" then
			Controller.stop()
		end
		return {
			playing = playing,
			armedAt = armedAt,
			time = if playing then os.clock() - startedAt else seekTime,
			shot = lastShot,
			duration = DURATION,
		}
	end
	bridge.Parent = gui
	-- Depois da câmera do Roblox e do compositor (o trailer manda na imagem).
	RunService:BindToRenderStep("S9Trailer", Enum.RenderPriority.Camera.Value + 4, function(dt)
		if not enabled then
			return
		end
		if armedAt then
			if DateTime.now().UnixTimestampMillis < armedAt then
				frame(0, dt)
				return
			end
			Controller.play()
		end
		local time = if playing then os.clock() - startedAt else (seekTime or 0)
		if playing then
			updateSounds(time)
			-- Corte de som deliberado após o bote, antes do batimento e do logo final.
			if time >= 30.2 and lastTime < 30.2 then
				stopSounds(true)
			end
			if trailerMix then
				trailerMix.Volume = 0.8 * math.clamp((DURATION + 0.5 - time) / 1.2, 0, 1)
			end
			if time >= 29.95 and lastTime < 29.95 then
				hitShakeUntil = time + 0.3
			end
			if time >= DURATION + 0.5 then
				playing = false
				seekTime = DURATION + 0.5
				stopSounds()
			end
		end
		lastTime = time
		frame(time, dt)
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="353">
          <Properties>
            <string name="Name">TransitionController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Transições de tela (só cliente), no ritmo stop-motion do jogo (passos de 1/12 s):

	  letterbox  faixas de cinema (entram e saem em passos);
	  eyes       pálpebras com borda suave: fechar, abrir com tremida (acordar, voltar do resgate);
	  fade       tela preta (0 = some, 1 = preto);
	  static     estática de fita VHS entre planos; com "flashes" desligado vira só um escurecer;
	  stamp      carimbo da fita: ▶ PLAY / ● REC, nome da câmera e relógio correndo;
	  title      cartela central (título + subtítulo) com tremida de projeção;
	  caption    legenda datilografada na faixa de baixo.

	Funções que animam (setLetterbox, closeEyes, openEyes, blink, setFade) BLOQUEIAM até terminar:
	chame dentro de task.spawn quando não quiser esperar. Cada camada tem um token: um pedido novo
	cancela a animação anterior da mesma camada. reset() limpa tudo na hora.
	A tela fica acima de toda a interface (DisplayOrder 120).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CinematicShots = require("@game/ReplicatedStorage/Shared/Game/CinematicShots")
local Presentation = require("@game/ReplicatedStorage/Shared/Game/Presentation")
local SettingsController = require("./SettingsController")
local Create = require("../UI/Create")
local Theme = require("../UI/Theme")

local STEP = 1 / 12
local BAR = 0.11
local NOISE_BARS = 22
local LID = 0.62

export type StampMode = "PLAY" | "REC"

type Refs = {
	gui: ScreenGui,
	top: Frame,
	bottom: Frame,
	lidTop: Frame,
	lidBottom: Frame,
	fade: Frame,
	sceneShade: Frame,
	noise: Frame,
	bars: { Frame },
	tracking: Frame,
	stamp: Frame,
	stampMode: TextLabel,
	stampDot: Frame,
	stampCamera: TextLabel,
	stampClock: TextLabel,
	title: TextLabel,
	subtitle: TextLabel,
	caption: TextLabel,
}

local refs: Refs? = nil
local tokens: { [string]: number } = {}
local letterboxAlpha = 0
local eyesAlpha = 0
local fadeAlpha = 0
local staticUntil = 0
local staticStrength = 0
local stampClock = 0
local stampMode: StampMode = "PLAY"
local sceneAlpha = 0
local revealStarted: number? = nil
local revealDuration = 0.25
local rng = Random.new()

local function r(): Refs
	assert(refs, "[TransitionController] used before Init")
	return refs
end

local function bump(layer: string): number
	tokens[layer] = (tokens[layer] or 0) + 1
	return tokens[layer]
end

local function alive(layer: string, token: number): boolean
	return tokens[layer] == token
end

-- Tempo real: faixas/fades lisos; a textura VHS continua atualizando no ritmo próprio.
local function stepped(layer: string, duration: number, apply: (number) -> (), existingToken: number?): boolean
	local token = existingToken or bump(layer)
	local started = os.clock()
	while true do
		if not alive(layer, token) then
			return false
		end
		local alpha = if duration <= 0 then 1 else math.clamp((os.clock() - started) / duration, 0, 1)
		apply(Presentation.ease(alpha))
		if alpha >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
	return alive(layer, token)
end

local function text(props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		TextSize = Theme.SizeBody,
		TextColor3 = Theme.Text,
		TextStrokeColor3 = Theme.Black,
		TextStrokeTransparency = 0.3,
		ZIndex = 6,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Create("TextLabel", defaults) :: TextLabel
end

local function black(props: { [string]: any }, children: { any }?): Frame
	local defaults: { [string]: any } = {
		BackgroundColor3 = Theme.Black,
		BorderSizePixel = 0,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Create("Frame", defaults, children) :: Frame
end

-- Borda suave das pálpebras (transparente só na beira que fecha).
local function lidGradient(rotation: number): Instance
	return Create("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.82, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
end

local function build(): Refs
	local gui = Create("ScreenGui", {
		Name = "TransitionUi",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 120,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}) :: ScreenGui

	local top = black({ Name = "BarTop", Size = UDim2.fromScale(1, 0), ZIndex = 2, Parent = gui })
	local bottom = black({
		Name = "BarBottom",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		ZIndex = 2,
		Parent = gui,
	})

	-- Estática: barras horizontais sorteadas a cada passo + faixa de tracking.
	local noise = Create("Frame", {
		Name = "Static",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(120, 120, 116),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 3,
		Parent = gui,
	}) :: Frame
	local bars: { Frame } = {}
	for i = 1, NOISE_BARS do
		table.insert(
			bars,
			Create("Frame", {
				Name = `Bar{i}`,
				BorderSizePixel = 0,
				ZIndex = 3,
				Parent = noise,
			}) :: Frame
		)
	end
	local tracking = Create("Frame", {
		Name = "Tracking",
		Size = UDim2.fromScale(1, 0.07),
		BackgroundColor3 = Color3.fromRGB(230, 230, 222),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = noise,
	}) :: Frame

	-- Carimbo da fita (canto superior, dentro da faixa quando ela existe).
	local stamp = Create("Frame", {
		Name = "Stamp",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 6,
		Parent = gui,
	}) :: Frame
	-- Ponto vermelho do REC (a fonte pixel não tem "●").
	local stampDot = Create("Frame", {
		Name = "Dot",
		Position = UDim2.new(0, 28, 0.03, 4),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 6,
		Parent = stamp,
	}, {
		Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
	}) :: Frame
	local stampModeLabel = text({
		Name = "Mode",
		Position = UDim2.new(0, 52, 0.03, 0),
		Size = UDim2.fromOffset(240, 24),
		TextSize = Theme.SizeLarge,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = stamp,
	})
	local stampCamera = text({
		Name = "Camera",
		Position = UDim2.new(0, 28, 0.03, 28),
		Size = UDim2.fromOffset(520, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = stamp,
	})
	local stampClockLabel = text({
		Name = "Clock",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -28, 0.03, 0),
		Size = UDim2.fromOffset(300, 24),
		TextSize = Theme.SizeLarge,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = stamp,
	})

	local title = text({
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.new(0.9, 0, 0, 60),
		TextSize = 56,
		TextScaled = true,
		TextWrapped = true,
		TextColor3 = Theme.Text,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 11, -- acima das pálpebras: a cartela de etapa aparece no escuro
		Parent = gui,
	})
	local subtitle = text({
		Name = "Subtitle",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.44, 40),
		Size = UDim2.new(0.86, 0, 0, 44),
		TextScaled = true,
		TextWrapped = true,
		TextSize = Theme.SizeLarge,
		TextColor3 = Theme.Hazard,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 11,
		Parent = gui,
	})
	local caption = text({
		Name = "Caption",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 1 - BAR / 2),
		Size = UDim2.new(0.86, 0, BAR, -8),
		TextScaled = true,
		TextSize = Theme.SizeLarge,
		TextWrapped = true,
		Visible = false,
		ZIndex = 7,
		Parent = gui,
	})

	-- Pálpebras e fade ficam por cima de tudo (o título some com o olho fechado).
	local lidTop = black({
		Name = "LidTop",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(1.2, LID),
		ZIndex = 9,
		Parent = gui,
	}, { lidGradient(90) })
	local lidBottom = black({
		Name = "LidBottom",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1.2, LID),
		ZIndex = 9,
		Parent = gui,
	}, { lidGradient(-90) })
	local fade = black({
		Name = "Fade",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = gui,
	})
	local sceneShade = black({
		Name = "SceneShade",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = gui,
	})
	Create("UITextSizeConstraint", { Parent = title, MinTextSize = 18, MaxTextSize = 56 })
	Create("UITextSizeConstraint", { Parent = subtitle, MinTextSize = 12, MaxTextSize = Theme.SizeLarge })
	Create("UITextSizeConstraint", { Parent = caption, MinTextSize = 12, MaxTextSize = Theme.SizeLarge })
	stampCamera.Size = UDim2.new(0.64, -28, 0, 32)
	stampCamera.TextScaled, stampCamera.TextWrapped = true, true
	stampClockLabel.Size = UDim2.new(0.3, -16, 0, 24)
	stampClockLabel.TextScaled = true
	Create("UITextSizeConstraint", { Parent = stampCamera, MinTextSize = 10, MaxTextSize = Theme.SizeBody })
	Create("UITextSizeConstraint", { Parent = stampClockLabel, MinTextSize = 12, MaxTextSize = Theme.SizeLarge })

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return {
		gui = gui,
		top = top,
		bottom = bottom,
		lidTop = lidTop,
		lidBottom = lidBottom,
		fade = fade,
		sceneShade = sceneShade,
		noise = noise,
		bars = bars,
		tracking = tracking,
		stamp = stamp,
		stampMode = stampModeLabel,
		stampDot = stampDot,
		stampCamera = stampCamera,
		stampClock = stampClockLabel,
		title = title,
		subtitle = subtitle,
		caption = caption,
	}
end

local function applyLetterbox(alpha: number)
	letterboxAlpha = alpha
	local ui = r()
	ui.top.Size = UDim2.fromScale(1, BAR * alpha)
	ui.bottom.Size = UDim2.fromScale(1, BAR * alpha)
end

-- 0 = olhos abertos, 1 = fechados. A borda suave passa um pouco do meio para fechar de vez.
local function applyEyes(alpha: number)
	eyesAlpha = alpha
	local ui = r()
	local reach = (0.5 + LID * 0.18) * alpha
	ui.lidTop.Position = UDim2.fromScale(0.5, reach)
	ui.lidBottom.Position = UDim2.fromScale(0.5, 1 - reach)
end

local function applyFade(alpha: number)
	fadeAlpha = alpha
	r().fade.BackgroundTransparency = 1 - alpha
end

local function updateStatic(now: number)
	local ui = r()
	local active = now < staticUntil
	ui.noise.Visible = active
	if not active then
		return
	end
	local flashes = SettingsController.get("flashes")
	if not flashes then
		-- Conforto: sem cintilação, só um véu escuro estável.
		ui.noise.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
		ui.noise.BackgroundTransparency = 1 - 0.7 * staticStrength
		for _, bar in ui.bars do
			bar.Visible = false
		end
		ui.tracking.Visible = false
		return
	end
	ui.noise.BackgroundColor3 = Color3.fromRGB(110, 110, 106)
	ui.noise.BackgroundTransparency = 1 - (0.45 + rng:NextNumber(0, 0.35)) * staticStrength
	for _, bar in ui.bars do
		bar.Visible = rng:NextNumber() < 0.8
		local gray = rng:NextInteger(20, 245)
		bar.BackgroundColor3 = Color3.fromRGB(gray, gray, gray - rng:NextInteger(0, 12))
		bar.BackgroundTransparency = rng:NextNumber(0.05, 0.6)
		bar.Position = UDim2.fromScale(rng:NextNumber(-0.3, 0.2), rng:NextNumber(0, 1))
		bar.Size = UDim2.new(rng:NextNumber(0.4, 1.3), 0, 0, rng:NextInteger(2, 26))
	end
	ui.tracking.Visible = true
	ui.tracking.Position = UDim2.fromScale(0, (now * 1.7) % 1.1 - 0.05)
end

local TransitionController = {
	Name = "TransitionController",
}

function TransitionController.Init()
	refs = build()
	applyEyes(0)
	applyLetterbox(0)
	applyFade(0)
end

function TransitionController.Start()
	local stepClock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local started = revealStarted
		if started then
			local alpha = math.clamp((os.clock() - started) / revealDuration, 0, 1)
			sceneAlpha = 1 - Presentation.ease(alpha)
			r().sceneShade.BackgroundTransparency = 1 - sceneAlpha
			if alpha >= 1 then
				revealStarted = nil
			end
		end
		stepClock += dt
		local ui = r()
		if ui.stamp.Visible then
			stampClock += dt
		end
		-- Estática e carimbo atualizam a ~20 Hz (fita, não vídeo liso).
		if stepClock < 0.05 then
			return
		end
		stepClock = 0
		local now = os.clock()
		updateStatic(now)
		if ui.stamp.Visible then
			local blinkOn = (now * 1.6) % 1 < 0.6
			if stampMode == "REC" then
				ui.stampMode.Text = "REC"
				ui.stampMode.TextColor3 = Theme.Accent
				ui.stampDot.Visible = blinkOn
			else
				ui.stampMode.Text = "PLAY >"
				ui.stampMode.TextColor3 = Theme.Text
				ui.stampDot.Visible = false
			end
			ui.stampClock.Text = CinematicShots.clock(stampClock)
			-- Tremida de tracking no carimbo (desliga com "vhs").
			local jitter = if SettingsController.get("vhs") and rng:NextNumber() < 0.15
				then rng:NextInteger(-2, 2)
				else 0
			ui.stamp.Position = UDim2.fromOffset(jitter, 0)
		end
	end)
end

-- Faixas de cinema (bloqueia durante `duration`).
function TransitionController.setLetterbox(on: boolean, duration: number?)
	local from = letterboxAlpha
	local target = if on then 1 else 0
	stepped("letterbox", duration or 0.5, function(t)
		applyLetterbox(from + (target - from) * t)
	end)
end

function TransitionController.closeEyes(duration: number?)
	local from = eyesAlpha
	stepped("eyes", duration or 0.25, function(t)
		applyEyes(from + (1 - from) * t * t)
	end)
end

-- Abre os olhos; `flutter` faz a tremida de quem acorda (abre um pouco, pesa, abre de vez).
function TransitionController.openEyes(duration: number?, flutter: boolean?)
	local total = duration or 0.6
	local token = bump("eyes")
	local function hold(alpha: number, time: number): boolean
		if not alive("eyes", token) then
			return false
		end
		applyEyes(alpha)
		task.wait(time)
		return alive("eyes", token)
	end
	if flutter then
		local sequence = { 0.72, 0.55, 0.62, 0.86, 0.9, 0.5, 0.3, 0.15, 0.05, 0 }
		for _, alpha in sequence do
			if not hold(alpha, total / #sequence) then
				return
			end
		end
	else
		local steps = math.max(2, math.floor(total / STEP + 0.5))
		local from = eyesAlpha
		for i = 1, steps do
			local t = i / steps
			if not hold(from * (1 - t) * (1 - t), STEP) then
				return
			end
		end
	end
	applyEyes(0)
end

-- Piscar rápido (fecha, segura, abre).
function TransitionController.blink(hold: number?)
	local token = bump("blink")
	TransitionController.closeEyes(0.16)
	if not alive("blink", token) then
		return
	end
	task.wait(hold or 0.08)
	if not alive("blink", token) then
		return
	end
	TransitionController.openEyes(0.25, false)
end

function TransitionController.setFade(alpha: number, duration: number?)
	local from = fadeAlpha
	local target = math.clamp(alpha, 0, 1)
	stepped("fade", duration or 0.4, function(t)
		applyFade(from + (target - from) * t)
	end)
end

-- Estática de fita por `duration` segundos (não bloqueia).
function TransitionController.static(duration: number, strength: number?)
	staticUntil = os.clock() + duration
	staticStrength = math.clamp(strength or 1, 0, 1)
	updateStatic(os.clock())
end

-- Carimbo da fita. label = nil esconde. clock = segundos desde a meia-noite (continua se omitido).
function TransitionController.stamp(label: string?, mode: StampMode?, clock: number?)
	local ui = r()
	if not label then
		ui.stamp.Visible = false
		return
	end
	stampMode = mode or "PLAY"
	if clock then
		stampClock = clock
	end
	ui.stampCamera.Text = label
	ui.stamp.Visible = true
end

-- Camada própria: não disputa fade/pálpebras com resgate, derrota ou cartela.
function TransitionController.sceneShade(alpha: number)
	revealStarted = nil
	sceneAlpha = math.clamp(alpha, 0, 1)
	r().sceneShade.BackgroundTransparency = 1 - sceneAlpha
end

function TransitionController.reveal(duration: number?)
	TransitionController.sceneShade(1)
	revealDuration = math.max(0.01, duration or 0.25)
	revealStarted = os.clock()
end

-- Cartela central. title = nil apaga. Entra com 3 quadros de tremida de projeção.
function TransitionController.title(title: string?, subtitle: string?)
	local ui = r()
	local token = bump("title")
	if not title then
		local from = ui.title.TextTransparency
		task.spawn(function()
			stepped("title", 0.18, function(alpha)
				ui.title.TextTransparency = from + (1 - from) * alpha
				ui.title.TextStrokeTransparency = from + (1 - from) * alpha
				ui.subtitle.TextTransparency = alpha
				ui.subtitle.TextStrokeTransparency = alpha
			end, token)
			if alive("title", token) then
				ui.title.Visible, ui.subtitle.Visible = false, false
			end
		end)
		return
	end
	ui.title.Text = title
	ui.subtitle.Text = subtitle or ""
	ui.subtitle.Visible = false
	ui.subtitle.TextTransparency = 0
	ui.subtitle.TextStrokeTransparency = 0
	task.spawn(function()
		local offsets: { number } = { 6, -3, 1, 0 }
		if not SettingsController.motionEnabled() then
			offsets = { 0, 0, 0, 0 }
		end
		local fades = { 0.7, 0.35, 0.15, 0 }
		for i, offset in offsets do
			if not alive("title", token) then
				return
			end
			ui.title.Visible = true
			ui.title.Position = UDim2.new(0.5, offset, 0.44, 0)
			ui.title.TextTransparency = fades[i]
			ui.title.TextStrokeTransparency = fades[i]
			task.wait(STEP)
		end
		task.wait(0.3)
		if alive("title", token) and subtitle then
			ui.subtitle.Visible = true
		end
	end)
end

-- Legenda datilografada na faixa de baixo. text = nil apaga.
function TransitionController.caption(value: string?)
	local ui = r()
	local token = bump("caption")
	if not value or value == "" then
		ui.caption.Visible = false
		return
	end
	local normalized = value
	ui.caption.Text = normalized
	ui.caption.MaxVisibleGraphemes = if SettingsController.motionEnabled() then 0 else -1
	ui.caption.Visible = true
	if not SettingsController.motionEnabled() then
		return
	end
	task.spawn(function()
		local length = utf8.len(normalized) or #normalized
		local started = os.clock()
		while true do
			if not alive("caption", token) then
				return
			end
			local shown = math.min(length, math.floor((os.clock() - started) * math.max(60, length / 0.65)))
			ui.caption.MaxVisibleGraphemes = shown
			if shown >= length then
				ui.caption.MaxVisibleGraphemes = -1
				break
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

-- Limpa tudo na hora (troca de rodada, cena cancelada).
function TransitionController.reset()
	for layer in tokens do
		bump(layer)
	end
	staticUntil = 0
	TransitionController.sceneShade(0)
	applyLetterbox(0)
	applyEyes(0)
	applyFade(0)
	local ui = r()
	ui.stamp.Visible = false
	ui.title.Visible = false
	ui.subtitle.Visible = false
	ui.caption.Visible = false
	updateStatic(os.clock())
end

function TransitionController.debugState(): { [string]: any }
	return {
		letterbox = letterboxAlpha,
		eyes = eyesAlpha,
		fade = fadeAlpha,
		sceneShade = sceneAlpha,
		revealing = revealStarted ~= nil,
		static = os.clock() < staticUntil,
		stamp = r().stamp.Visible,
		title = if r().title.Visible then r().title.Text else nil,
	}
end

return TransitionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="354">
          <Properties>
            <string name="Name">UiFeedbackController</string>
            <string name="Source"><![CDATA[--!strict
-- Resposta local a mouse, toque e foco do controle; não altera nenhuma ação do botão.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Settings = require("./SettingsController")

type Feedback = {
	button: GuiButton,
	overlay: Frame,
	scale: UIScale?,
	hovered: boolean,
	focused: boolean,
	pressed: boolean,
	tweens: { Tween },
	connections: { RBXScriptConnection },
}

local tracked: { [GuiButton]: Feedback } = {}
local Controller = { Name = "UiFeedbackController" }

local function update(state: Feedback)
	for _, tween in state.tweens do
		tween:Cancel()
	end
	table.clear(state.tweens)
	local enabled = state.button.Active and state.button.Interactable and state.button.Visible
	local pressed = enabled and state.pressed
	local highlighted = enabled and (state.hovered or state.focused)
	local transparency = if pressed then 0.88 elseif highlighted then 0.94 else 1
	local duration = if Settings.motionEnabled() then (if pressed then 0.07 else 0.16) else 0
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	table.insert(state.tweens, TweenService:Create(state.overlay, info, { BackgroundTransparency = transparency }))
	if state.scale then
		table.insert(
			state.tweens,
			TweenService:Create(state.scale, info, {
				Scale = if pressed and Settings.motionEnabled() then 0.985 else 1,
			})
		)
	end
	for _, tween in state.tweens do
		tween:Play()
	end
end

local function attach(instance: Instance)
	if not instance:IsA("GuiButton") or tracked[instance] or instance:GetAttribute("PresentationFeedback") == false then
		return
	end
	local gui = instance:FindFirstAncestorWhichIsA("ScreenGui")
	-- Controles de movimento já têm resposta própria; esta frente cuida da apresentação.
	if not gui or gui.Name == "TouchControls" or gui.Name == "HouseTouchControls" then
		return
	end
	-- Um botão clonado não herda o estado pressionado nem ganha dois overlays.
	local copiedOverlay = instance:FindFirstChild("PresentationFeedback")
	if copiedOverlay then
		copiedOverlay:Destroy()
	end
	local overlay = Instance.new("Frame")
	overlay.Name = "PresentationFeedback"
	overlay.BackgroundColor3 = Color3.fromRGB(236, 223, 188)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = instance.ZIndex + 1
	overlay.Active, overlay.Selectable = false, false
	local corner = instance:FindFirstChildWhichIsA("UICorner")
	if corner then
		corner:Clone().Parent = overlay
	end
	overlay.Parent = instance
	local scale: UIScale? = nil
	local existingScale = instance:FindFirstChildWhichIsA("UIScale")
	if existingScale and existingScale.Name == "PresentationScale" then
		existingScale.Scale = 1
		scale = existingScale
	elseif not existingScale then
		local created = Instance.new("UIScale")
		created.Name = "PresentationScale"
		created.Parent = instance
		scale = created
	end
	local state: Feedback = {
		button = instance,
		overlay = overlay,
		scale = scale,
		hovered = false,
		focused = false,
		pressed = false,
		tweens = {},
		connections = {},
	}
	tracked[instance] = state
	local function connect(signal: RBXScriptSignal, callback: (...any) -> ())
		table.insert(state.connections, signal:Connect(callback))
	end
	connect(instance.MouseEnter, function()
		state.hovered = true
		update(state)
	end)
	connect(instance.MouseLeave, function()
		state.hovered = false
		state.pressed = false
		update(state)
	end)
	connect(instance.SelectionGained, function()
		state.focused = true
		update(state)
	end)
	connect(instance.SelectionLost, function()
		state.focused = false
		state.pressed = false
		update(state)
	end)
	connect(instance.InputBegan, function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA
		then
			state.pressed = true
			update(state)
		end
	end)
	for _, property in { "Visible", "Active", "Interactable" } do
		connect(instance:GetPropertyChangedSignal(property), function()
			state.pressed, state.hovered, state.focused = false, false, false
			update(state)
		end)
	end
	connect(instance.Destroying, function()
		tracked[instance] = nil
		for _, tween in state.tweens do
			tween:Cancel()
		end
		for _, connection in state.connections do
			connection:Disconnect()
		end
	end)
end

function Controller.debugState(): { [string]: any }
	local buttons, pressed = 0, 0
	for _, state in tracked do
		buttons += 1
		if state.pressed then
			pressed += 1
		end
	end
	return { buttons = buttons, pressed = pressed }
end

function Controller.Start()
	local gui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui.DescendantAdded:Connect(attach)
	for _, descendant in gui:GetDescendants() do
		attach(descendant)
	end
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA
		then
			for _, state in tracked do
				if state.pressed then
					state.pressed = false
					update(state)
				end
			end
		end
	end)
	Settings.onChanged(function()
		for _, state in tracked do
			update(state)
		end
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="355">
          <Properties>
            <string name="Name">WorldFxController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Efeitos de luz no cliente, sempre "em passos" (12 Hz), sem mexer no estado do servidor
	(o servidor liga/desliga as luzes; aqui só modulamos o brilho localmente):
	- luzes marcadas com Flicker piscam;
	- sirene do portão alterna com a energia ligada;
	- picos de falha quando O Vigia acorda e quando a energia volta.
]]

local RunService = game:GetService("RunService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Profile = require("@game/ReplicatedStorage/Shared/Game/LightingProfile")
local SettingsController = require("./SettingsController")

local rng = Random.new()
local surgeUntil = 0
local surgeOrigin: Vector3? = nil
local surgeRadius = math.huge
local snapshot: GameState.Snapshot? = nil
type Fixture = { part: BasePart, seed: number, brightness: number, range: number, visibility: number, visible: boolean }
local fixtures: { [Light]: Fixture } = {}
local nextSeed = 0
local shadowClock = 1
local shadowCount = 0
local particles: { [ParticleEmitter]: number } = {}
local details: { [BasePart]: boolean } = {}

local function selectShadows()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local candidates: { Profile.Candidate } = {}
	local world = workspace:FindFirstChild(Tags.WorldFolder)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = if world then { world } else {}
	params.RespectCanCollide = true
	for light, entry in fixtures do
		local part = entry.part
		if part.Parent and light.Parent then
			local direction = part.Position - camera.CFrame.Position
			local hit = if direction.Magnitude <= Profile.ShadowDistance
				then workspace:Raycast(camera.CFrame.Position, direction, params)
				else nil
			entry.visible = hit == nil or hit.Instance == part or (hit.Position - part.Position).Magnitude < 1.5
			table.insert(candidates, {
				id = tostring(entry.seed),
				enabled = light.Enabled and light.Brightness > 0.01 and entry.visible,
				distance = (part.Position - camera.CFrame.Position).Magnitude,
				range = (light :: any).Range,
			})
		end
	end
	local budget = SettingsController.visualBudget()
	local chosen = Profile.selectShadows(candidates, budget.shadows)
	for emitter, rate in particles do
		if emitter.Parent then
			emitter.Rate = rate * budget.particles
		end
	end
	for part in details do
		if part.Parent then
			part.LocalTransparencyModifier = if (part.Position - camera.CFrame.Position).Magnitude
					> budget.detailDistance
				then 1
				else 0
		end
	end
	shadowCount = 0
	for light, entry in fixtures do
		light.Shadows = chosen[tostring(entry.seed)] == true
		if light.Shadows then
			shadowCount += 1
		end
	end
end

local function step()
	local now = os.clock()
	local flashes = SettingsController.get("flashes")
	local surging = flashes and now < surgeUntil
	local s = snapshot
	for light, entry in fixtures do
		local instance = entry.part
		if instance.Parent then
			if light.Parent then
				local raw = (instance:GetAttribute("BaseBrightness") :: number?) or entry.brightness
				local base, reach = Profile.fixture(instance.Name, raw, entry.range)
				local ranged = light :: any
				ranged.Range = reach
				local kind = instance:GetAttribute(Tags.Attr.LightKind)
				local architectural = kind ~= nil
					or instance.Name == "NightLight"
					or instance.Name == "LampShade"
					or instance.Name == "Flame"
				local factor = if architectural
					then Profile.flicker(now, entry.seed, instance:GetAttribute(Tags.Attr.Flicker) == true, flashes)
					else 1
				-- Luzes sem sombra de outros cômodos não atravessam paredes/tetos na visão local.
				local target = if architectural and kind ~= "Exit" and not entry.visible then 0.12 else 1
				entry.visibility += (target - entry.visibility) * 0.22
				factor *= entry.visibility
				if
					surging
					and architectural
					and kind ~= "Exit"
					and (surgeOrigin == nil or (instance.Position - surgeOrigin).Magnitude <= surgeRadius)
				then
					factor = if rng:NextNumber() < 0.5 then rng:NextNumber(0.25, 0.5) else rng:NextNumber(0.8, 1.2)
				end
				if kind == "Beacon" then
					local on = s ~= nil and s.powerOn and (not flashes or (now * 2.5) % 2 < 1)
					instance.Transparency = if on then 0 else 0.6
					factor = if on then 1 else 0
				end
				light.Brightness = base * factor
			end
		end
	end
end

local WorldFxController = {
	Name = "WorldFxController",
}

function WorldFxController.debugState(): { [string]: any }
	local count = 0
	for _ in fixtures do
		count += 1
	end
	local particleCount, detailCount = 0, 0
	for _ in particles do
		particleCount += 1
	end
	for _ in details do
		detailCount += 1
	end
	return {
		fixtures = count,
		shadows = shadowCount,
		budget = SettingsController.visualBudget().shadows,
		particles = particleCount,
		details = detailCount,
	}
end

-- Pico de falha nas luzes por `duration` segundos.
function WorldFxController.surge(duration: number, origin: Vector3?, radius: number?)
	surgeUntil = math.max(surgeUntil, os.clock() + duration)
	surgeOrigin = origin
	surgeRadius = radius or math.huge
end

function WorldFxController.Start()
	local function add(instance: Instance)
		local world = workspace:FindFirstChild(Tags.WorldFolder)
		if not world or not instance:IsDescendantOf(world) then
			return
		end
		if instance:IsA("ParticleEmitter") and instance:GetAttribute("VisualOptional") == true then
			particles[instance] = instance.Rate
		end
		if
			instance:IsA("BasePart")
			and instance:GetAttribute("VisualDetail") == true
			and not instance.CanCollide
			and not instance.CanQuery
		then
			details[instance] = true
		end
		if not instance:IsA("Light") or fixtures[instance] then
			return
		end
		local part = instance.Parent
		if not part or not part:IsA("BasePart") then
			return
		end
		nextSeed += 1
		fixtures[instance] = {
			part = part,
			seed = nextSeed,
			brightness = instance.Brightness,
			range = (instance :: any).Range,
			visibility = 1,
			visible = true,
		}
	end
	-- Inclui luzes decorativas sem tag, sem tocar nas lanternas dos jogadores.
	task.spawn(function()
		local world = workspace:WaitForChild(Tags.WorldFolder, 30)
		if not world then
			return
		end
		for _, instance in world:GetDescendants() do
			add(instance)
		end
		-- Um par de listeners acompanha também a substituição completa da raiz no retorno ao lobby.
		workspace.DescendantAdded:Connect(add)
		workspace.DescendantRemoving:Connect(function(instance)
			if instance:IsA("Light") then
				fixtures[instance] = nil
			end
			if instance:IsA("ParticleEmitter") then
				particles[instance] = nil
			end
			if instance:IsA("BasePart") then
				details[instance] = nil
			end
		end)
	end)
	GameState.observe(function(next: GameState.Snapshot)
		local previous = snapshot
		snapshot = next
		if previous and next.phase == "Playing" then
			if next.creatureActive and not previous.creatureActive then
				WorldFxController.surge(1.4)
			end
			if next.powerOn and not previous.powerOn then
				WorldFxController.surge(1.8)
			end
		end
	end)

	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		shadowClock += dt
		if shadowClock >= 0.5 then
			shadowClock = 0
			selectShadows()
		end
		accumulator += dt
		if accumulator >= 1 / Config.Visual.FlickerRate then
			accumulator = 0
			step()
		end
	end)
end

return WorldFxController
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="356">
        <Properties>
          <string name="Name">Creature</string>
        </Properties>
        <Item class="ModuleScript" referent="357">
