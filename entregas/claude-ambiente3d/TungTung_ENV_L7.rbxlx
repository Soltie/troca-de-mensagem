        <Item class="ModuleScript" referent="550">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[--!strict
local Config = require("@game/ReplicatedStorage/Shared/Config")
local MockDataStore = require("@game/ServerScriptService/Server/Data/MockDataStore")
local PlayerDataSchema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "PlayerData",
	run = function(t)
		t.describe("PlayerDataSchema", function()
			t.it("creates a fresh template for nil or garbage", function()
				local fromNil = PlayerDataSchema.migrate(nil)
				t.expect(fromNil.sessions).toBe(0)
				t.expect(fromNil.schemaVersion).toBe(Config.Data.SchemaVersion)
				t.expect(PlayerDataSchema.migrate("garbage").sessions).toBe(0)
			end)

			t.it("keeps saved values and fills missing fields", function()
				local data = PlayerDataSchema.migrate({ sessions = 7, schemaVersion = 0 })
				t.expect(data.sessions).toBe(7)
				t.expect(data.firstJoin).toBe(0)
				t.expect(data.schemaVersion).toBe(Config.Data.SchemaVersion)
			end)

			t.it("migrates v1 saves to v2 without losing old fields", function()
				local data =
					PlayerDataSchema.migrate({ schemaVersion = 1, sessions = 3, firstJoin = 10, lastJoin = 20 })
				t.expect(data.sessions).toBe(3)
				t.expect(data.wallet.fichas).toBe(0)
				t.expect(data.wallet.creditos).toBe(0)
				t.expect(data.equipped.flashlight).toBe("lanterna_padrao")
				t.expect(data.rewardedLevel).toBe(1)
				t.expect((next(data.purchases))).toBeNil()
			end)

			t.it("repairs corrupted wallet values", function()
				local data = PlayerDataSchema.migrate({ wallet = { fichas = -5, creditos = "x" }, xp = 0 / 0 })
				t.expect(data.wallet.fichas).toBe(0)
				t.expect(data.wallet.creditos).toBe(0)
				t.expect(data.xp).toBe(0)
			end)

			t.it("returns independent copies of the template", function()
				local a = PlayerDataSchema.template()
				a.sessions = 99
				t.expect(PlayerDataSchema.template().sessions).toBe(0)
			end)
		end)

		t.describe("MockDataStore", function()
			t.it("returns nil for unknown keys", function()
				t.expect(MockDataStore.new():GetAsync("missing")).toBeNil()
			end)

			t.it("stores copies via UpdateAsync (multi-return transform, like the real API)", function()
				local store = MockDataStore.new()
				local value = { sessions = 1 }
				store:UpdateAsync("k", function(_current: any)
					return value, { 123 }
				end)
				value.sessions = 50
				t.expect(store:GetAsync("k")).toEqual({ sessions = 1 })
			end)

			t.it("passes the current value to the transform and cancels on nil", function()
				local store = MockDataStore.new()
				store:UpdateAsync("k", function()
					return { n = 1 }
				end)
				store:UpdateAsync("k", function(current: any)
					t.expect(current).toEqual({ n = 1 })
					return nil
				end)
				t.expect(store:GetAsync("k")).toEqual({ n = 1 })
				store:RemoveAsync("k")
				t.expect(store:GetAsync("k")).toBeNil()
			end)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="551">
          <Properties>
            <string name="Name">PlayerGuide</string>
            <string name="Source"><![CDATA[--!strict
local Guide = require("@game/ReplicatedStorage/Shared/Game/PlayerGuide")
local TestKit = require("../TestKit")
return {
	name = "PlayerGuide",
	run = function(t)
		local function activity(kind: string, progress: number): Guide.Activity
			return { id = "task_1", room = "Lobby", kind = kind, solved = false, progress = progress }
		end
		t.it("advances past solved tasks and handles completed or empty chapters", function()
			local first, second = activity("repair", 3), activity("sequence", 1)
			first.solved = true
			local current, index = Guide.current({ first, second })
			t.expect(current).toBe(second)
			t.expect(index).toBe(2)
			second.solved = true
			t.expect((Guide.current({ first, second }))).toBe(nil)
			t.expect((Guide.current({}))).toBe(nil)
		end)
		t.it("explains relay confirmation only while its server window remains open", function()
			local relay = activity("relay", 1)
			relay.relayUntil = 110
			t.expect(string.find(Guide.instruction(relay, 105), "5s", 1, true) ~= nil).toBe(true)
			t.expect(string.find(Guide.instruction(relay, 111), "Trabalho em dupla", 1, true) ~= nil).toBe(true)
		end)
		t.it("shows rescue and waiting instructions instead of assigning inactive players a station", function()
			local repair = activity("repair", 0)
			local downed = Guide.objective("Playing", "Downed", repair)
			t.expect(downed).toBe("Você caiu!")
			local escaped = Guide.objective("Extracting", "Escaped", repair)
			t.expect(escaped).toBe("Você está a salvo!")
			local lost = Guide.objective("Lost", "Downed", repair)
			t.expect(lost).toBe("O Tung Tung pegou o time!")
		end)
		t.it("explains solo relay fallback and protected wait after skipping the scene", function()
			t.expect(string.find(Guide.instruction(activity("relay", 0), 0, 1), "último de pé", 1, true) ~= nil)
				.toBe(true)
			local title = Guide.objective("Briefing", "Active", activity("repair", 0))
			t.expect(title).toBe("Prepare-se!")
		end)
		t.it("preserves authored titles and directs sequences to the physical clue", function()
			local sequence = activity("sequence", 1)
			sequence.title = "Recuperar o registro do turno"
			t.expect((Guide.objective("Playing", "Active", sequence))).toBe(sequence.title)
			t.expect(string.find(Guide.instruction(sequence, 0), "placa", 1, true) ~= nil).toBe(true)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="552">
          <Properties>
            <string name="Name">PlayerRules</string>
            <string name="Source"><![CDATA[--!strict
local Config = require("@game/ReplicatedStorage/Shared/Config")
local PlayerRules = require("@game/ServerScriptService/Server/Game/PlayerRules")
local TestKit = require("../TestKit")

local P = Config.Player

local spec: TestKit.Spec = {
	name = "PlayerRules",
	run = function(t)
		t.it("crouching lowers the speed limit", function()
			t.expect(PlayerRules.maxSpeed("Crouch") < PlayerRules.maxSpeed("Stand")).toBe(true)
			t.expect(PlayerRules.walkSpeed("Crouch")).toBe(P.CrouchSpeed)
			t.expect(PlayerRules.walkSpeed("Stand")).toBe(P.WalkSpeed)
		end)

		t.it("tolerates short bursts and corrects sustained overspeed", function()
			local check = PlayerRules.newSpeedCheck()
			local limit = PlayerRules.maxSpeed("Stand")
			t.expect(PlayerRules.checkSpeed(check, limit, limit, 0)).toBe("ok")
			t.expect(PlayerRules.checkSpeed(check, limit * 3, limit, 1)).toBe("over")
			t.expect(PlayerRules.checkSpeed(check, limit * 3, limit, 1 + P.SpeedGrace * 0.5)).toBe("over")
			t.expect(PlayerRules.checkSpeed(check, limit * 3, limit, 1 + P.SpeedGrace)).toBe("correct")
			-- Volta ao normal: zera a contagem.
			t.expect(PlayerRules.checkSpeed(check, limit, limit, 5)).toBe("ok")
			t.expect(check.overSince).toBeNil()
			-- NaN não é tratado como excesso.
			t.expect(PlayerRules.checkSpeed(check, 0 / 0, limit, 6)).toBe("ok")
		end)

		t.it("holding breath: max duration, forced gasp and cooldown", function()
			local b = PlayerRules.newBreath()
			t.expect(PlayerRules.holdBreath(b, 0)).toBe(true)
			t.expect(PlayerRules.holdBreath(b, 0.1)).toBe(false)
			t.expect(PlayerRules.stepBreath(b, P.HoldBreathMax - 0.1)).toBeNil()
			t.expect(PlayerRules.stepBreath(b, P.HoldBreathMax)).toBe("gasp")
			t.expect(b.holding).toBe(false)
			t.expect(PlayerRules.holdBreath(b, P.HoldBreathMax + 0.5)).toBe(false)
			t.expect(PlayerRules.holdBreath(b, P.HoldBreathMax + P.HoldBreathCooldown)).toBe(true)
		end)

		t.it("voluntary release has a shorter cooldown and no gasp", function()
			local b = PlayerRules.newBreath()
			PlayerRules.holdBreath(b, 0)
			PlayerRules.releaseBreath(b, 2)
			t.expect(b.holding).toBe(false)
			t.expect(PlayerRules.stepBreath(b, 100)).toBeNil()
			t.expect(PlayerRules.holdBreath(b, 2 + P.HoldBreathCooldown * 0.5)).toBe(true)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="553">
          <Properties>
            <string name="Name">Presentation</string>
            <string name="Source"><![CDATA[--!strict
local Presentation = require("@game/ReplicatedStorage/Shared/Game/Presentation")
local TestKit = require("../TestKit")
return {
	name = "Presentation",
	run = function(t)
		t.it("scene masks both camera handoffs without holding the middle", function()
			t.expect(Presentation.shade(0, 8)).toBe(1)
			t.expect(Presentation.shade(4, 8)).toBe(0)
			t.expect(Presentation.shade(8, 8)).toBe(1)
			t.expect(Presentation.shade(0, 0)).toBe(0)
			for i = 0, 80 do
				local value = Presentation.shade(i / 10, 8)
				t.expect(value >= 0 and value <= 1).toBe(true)
			end
		end)
		t.it("cut mask meets at the boundary and leaves static cuts alone", function()
			t.expect(Presentation.cut(0, 4, true, false)).toBe(1)
			t.expect(Presentation.cut(1, 4, false, true)).toBe(1)
			t.expect(Presentation.cut(0.5, 4, true, true)).toBe(0)
			t.expect(Presentation.cut(0, 4, false, false)).toBe(0)
			t.expect(Presentation.cut(1, 4, false, false)).toBe(0)
		end)
		t.it("very short scenes keep a visible middle and clamp overrun", function()
			t.expect(Presentation.shade(0.03, 0.06)).toBe(0)
			t.expect(Presentation.shade(1, 0.06)).toBe(1)
			t.expect(Presentation.ease(-2)).toBe(0)
			t.expect(Presentation.ease(2)).toBe(1)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="554">
          <Properties>
            <string name="Name">ProceduralLayout</string>
            <string name="Source"><![CDATA[--!strict
local Layout = require("@game/ServerScriptService/Server/World/ProceduralLayout")
local Base = require("@game/ServerScriptService/Server/World/Layout")
local Generator = require("@game/ServerScriptService/Server/Campaign/CampaignGenerator")
local TestKit = require("../TestKit")

local function signature(plan: Layout.Plan, geometryOnly: boolean?): string
	local parts = {}
	if not geometryOnly then
		for _, room in plan.rooms do
			table.insert(parts, `{room.kind}:{room.turn}`)
		end
	end
	for _, edge in plan.links do
		table.insert(parts, `{edge.a}-{edge.b}`)
	end
	return table.concat(parts, "/")
end

local spec: TestKit.Spec = {
	name = "ProceduralLayout",
	run = function(t)
		t.it("reproduces geometry, room functions and equipment placement from seed and stage", function()
			t.expect(Layout.create(9182, 2)).toEqual(Layout.create(9182, 2))
		end)
		t.it("keeps 1500 layouts connected with a bounded size and at least one internal loop", function()
			for seed = 1, 500 do
				for stage = 1, 3 do
					local plan = Layout.create(seed, stage)
					local valid, reason = Layout.validate(plan)
					assert(valid, `seed={seed} stage={stage}: {reason}`)
					t.expect(#plan.rooms).toBe(9)
					t.expect(#plan.links >= #plan.rooms).toBe(true)
					for _, room in plan.rooms do
						t.expect(room.x - 14 >= Layout.Bounds.x0 and room.x + 14 <= Layout.Bounds.x1).toBe(true)
						t.expect(room.z - 14 >= Layout.Bounds.z0 and room.z + 14 <= Layout.Bounds.z1).toBe(true)
					end
					local routes = Layout.returnRoutes(plan)
					for _, room in plan.rooms do
						local cell, steps = room.cell, 0
						while cell ~= 0 do
							steps += 1
							assert(steps <= 9 and routes[cell] ~= nil, "Missing or looping return signage")
							local nextCell = routes[cell]
							assert(
								nextCell == 0 or Layout.connected(plan, cell, nextCell),
								"Return sign points through wall"
							)
							cell = nextCell
						end
					end
				end
			end
		end)
		t.it("varies actual door geometry as well as room functions across seeds and stages", function()
			local shapes: { [string]: boolean } = {}
			local maps: { [string]: boolean } = {}
			for seed = 1, 128 do
				local first = Layout.create(seed, 1)
				shapes[signature(first, true)] = true
				maps[signature(first)] = true
				t.expect(signature(first) ~= signature(Layout.create(seed, 2))).toBe(true)
				t.expect(signature(first) ~= signature(Layout.create(seed + 1, 1))).toBe(true)
			end
			local count = 0
			for _ in shapes do
				count += 1
			end
			t.expect(count >= 48).toBe(true)
			count = 0
			for _ in maps do
				count += 1
			end
			t.expect(count).toBe(128)
		end)
		t.it("aligns both entrances with the physical north wall and the existing rooms", function()
			local wall = Base.wallById("annexNorth")
			assert(wall, "North wall missing")
			for _, cell in Layout.Entrances do
				local x = Layout.entranceX(cell)
				local found = false
				for _, opening in wall.openings do
					if opening.center == x and opening.width >= Layout.DoorWidth then
						found = true
					end
				end
				t.expect(found).toBe(true)
				local room = Base.roomAt(x, Layout.Bounds.z1 + 2)
				t.expect(room ~= nil and (room.id == "Control" or room.id == "Archive")).toBe(true)
			end
		end)
		t.it("separates every pavilion with sixteen studs of real circulation", function()
			local plan = Layout.create(9182, 1)
			for _, edge in Layout.edges() do
				local a, b = plan.rooms[edge.a], plan.rooms[edge.b]
				local distance = math.abs(a.x - b.x) + math.abs(a.z - b.z)
				t.expect(distance - Layout.RoomSize).toBe(16)
			end
			local passages = Layout.passages(plan)
			t.expect(#passages).toBe(#plan.links + 1)
			for _, p in passages do
				t.expect(p.x1 - p.x0 >= Layout.DoorWidth and p.z1 - p.z0 >= Layout.DoorWidth).toBe(true)
			end
		end)
		t.it("recognizes roofs instead of treating the entire outdoor perimeter as a building", function()
			for seed = 1, 50 do
				local plan = Layout.create(seed, 1)
				local outdoors = 0
				for _, room in plan.rooms do
					local open = Layout.isOutdoorRoom(room)
					outdoors += if open then 1 else 0
					t.expect(Layout.isIndoor(plan, room.x, room.z)).toBe(not open)
				end
				t.expect(outdoors).toBe(2)
				for _, p in Layout.passages(plan) do
					t.expect(Layout.isIndoor(plan, (p.x0 + p.x1) / 2, (p.z0 + p.z1) / 2)).toBe(p.covered)
				end
				for _, zone in Layout.ExteriorZones do
					t.expect(Layout.isIndoor(plan, (zone.x0 + zone.x1) / 2, (zone.z0 + zone.z1) / 2)).toBe(false)
				end
			end
		end)
		t.it("rejects disconnected, duplicated or non-adjacent routes and invalid rooms", function()
			local plan = Layout.create(8, 1)
			plan.links[1] = { a = 1, b = 9 }
			t.expect((Layout.validate(plan))).toBe(false)
			plan = Layout.create(8, 1)
			plan.links[1] = plan.links[2]
			t.expect((Layout.validate(plan))).toBe(false)
			plan = Layout.create(8, 1)
			plan.rooms[1].kind = plan.rooms[2].kind
			t.expect((Layout.validate(plan))).toBe(false)
			plan = Layout.create(8, 1)
			plan.rooms[1].x += 2
			t.expect((Layout.validate(plan))).toBe(false)
			plan = Layout.create(8, 1)
			plan.rooms[1].turn = 0.5
			t.expect((Layout.validate(plan))).toBe(false)
			plan = Layout.create(8, 1)
			-- Isolar a célula 1 ainda deixa nove arestas: o tamanho sozinho não prova conectividade.
			plan.links = {}
			for _, edge in Layout.edges() do
				if edge.a ~= 1 and edge.b ~= 1 then
					table.insert(plan.links, edge)
				end
			end
			t.expect((Layout.validate(plan))).toBe(false)
		end)
		t.it("places a majority of campaign tasks in generated rooms and validates their actual coordinates", function()
			for players = 3, 8 do
				for stage = 1, 3 do
					local plan = Generator.create(9182, stage, players)
					local count = 0
					for _, activity in plan.activities do
						if activity.slot:sub(1, 7) == "sector_" then
							count += 1
						end
					end
					t.expect(count > #plan.activities / 2).toBe(true)
					t.expect((Generator.validate(plan))).toBe(true)
				end
			end
			local plan = Generator.create(9182, 2, 8)
			plan.sector.stage = 1
			t.expect((Generator.validate(plan))).toBe(false)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="555">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
local RateLimiter = require("@game/ReplicatedStorage/Shared/Net/RateLimiter")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "RateLimiter",
	run = function(t)
		local now = 0
		local function clock(): number
			return now
		end

		t.it("allows a burst up to capacity, then blocks", function()
			now = 0
			local limiter = RateLimiter.new({ capacity = 3, refillPerSecond = 1, clock = clock })
			t.expect(limiter.allow("a")).toBe(true)
			t.expect(limiter.allow("a")).toBe(true)
			t.expect(limiter.allow("a")).toBe(true)
			t.expect(limiter.allow("a")).toBe(false)
		end)

		t.it("refills over time without exceeding capacity", function()
			now = 0
			local limiter = RateLimiter.new({ capacity = 2, refillPerSecond = 1, clock = clock })
			limiter.allow("a")
			limiter.allow("a")
			t.expect(limiter.allow("a")).toBe(false)
			now = 1
			t.expect(limiter.allow("a")).toBe(true)
			t.expect(limiter.allow("a")).toBe(false)
			now = 100
			t.expect(limiter.allow("a")).toBe(true)
			t.expect(limiter.allow("a")).toBe(true)
			t.expect(limiter.allow("a")).toBe(false)
		end)

		t.it("tracks keys independently and frees them on reset", function()
			now = 0
			local limiter = RateLimiter.new({ capacity = 1, refillPerSecond = 0, clock = clock })
			t.expect(limiter.allow(1)).toBe(true)
			t.expect(limiter.allow(2)).toBe(true)
			t.expect(limiter.allow(1)).toBe(false)
			t.expect(limiter.size()).toBe(2)
			limiter.reset(1)
			t.expect(limiter.size()).toBe(1)
			t.expect(limiter.allow(1)).toBe(true)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="556">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Usa APIs do Roblox: só roda no Studio (Tests/Run). O require fica dentro de run()
-- para o runner do Lune conseguir carregar o arquivo e pular o spec.
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "Remotes",
	robloxOnly = true,
	run = function(t)
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local RunService = game:GetService("RunService")
		local Config = require("@game/ReplicatedStorage/Shared/Config")
		local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")

		t.it("lists declared remotes in sorted order", function()
			local names = Remotes.names()
			t.expect(table.find(names, "Interact") ~= nil).toBe(true)
			local sorted = table.clone(names)
			table.sort(sorted)
			t.expect(names).toEqual(sorted)
		end)

		t.it("errors on unknown remote names", function()
			t.expect(function()
				Remotes.kindOf("DoesNotExist")
			end).toThrow('unknown remote "DoesNotExist"')
		end)

		t.it("server has every declared remote with the right class", function()
			if not (RunService:IsServer() and RunService:IsRunning()) then
				return -- só faz sentido no servidor durante o playtest
			end
			local folder = ReplicatedStorage:FindFirstChild(Config.Net.RemotesFolderName)
			t.expect(folder).toBeTruthy()
			for _, name in Remotes.names() do
				local remote = (folder :: Instance):FindFirstChild(name)
				t.expect(remote and remote.ClassName).toBe(Remotes.kindOf(name))
			end
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="557">
          <Properties>
            <string name="Name">Retry</string>
            <string name="Source"><![CDATA[--!strict
local Retry = require("@game/ReplicatedStorage/Shared/Util/Retry")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "Retry",
	run = function(t)
		t.it("returns the value on first success without waiting", function()
			local waits = 0
			local ok, value, err = Retry.run(function()
				return 42
			end, {
				attempts = 3,
				baseDelay = 1,
				wait = function()
					waits += 1
				end,
			})
			t.expect(ok).toBe(true)
			t.expect(value).toBe(42)
			t.expect(err).toBeNil()
			t.expect(waits).toBe(0)
		end)

		t.it("retries with exponential backoff until success", function()
			local calls = 0
			local delays: { number } = {}
			local ok, value = Retry.run(function()
				calls += 1
				if calls < 3 then
					error("boom")
				end
				return "done"
			end, {
				attempts = 5,
				baseDelay = 1,
				wait = function(seconds: number)
					table.insert(delays, seconds)
				end,
			})
			t.expect(ok).toBe(true)
			t.expect(value).toBe("done")
			t.expect(calls).toBe(3)
			t.expect(delays).toEqual({ 1, 2 })
		end)

		t.it("gives up after the last attempt and returns the last error", function()
			local calls = 0
			local ok, value, err = Retry.run(function(): number
				calls += 1
				error(`fail {calls}`, 0)
			end, { attempts = 3, baseDelay = 0, wait = function() end })
			t.expect(ok).toBe(false)
			t.expect(value).toBeNil()
			t.expect(err).toBe("fail 3")
			t.expect(calls).toBe(3)
		end)

		t.it("caps the delay at maxDelay", function()
			t.expect(Retry.delayFor(1, 1, 5)).toBe(1)
			t.expect(Retry.delayFor(4, 1, 5)).toBe(5)
			t.expect(Retry.delayFor(3, 2, nil)).toBe(8)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="558">
          <Properties>
            <string name="Name">RoundRules</string>
            <string name="Source"><![CDATA[--!strict
local RoundRules = require("@game/ServerScriptService/Server/Game/RoundRules")
local TestKit = require("../TestKit")

local function context(overrides: { [string]: any }): RoundRules.InteractionContext
	local ctx: { [string]: any } = {
		phase = "Playing",
		exists = true,
		enabled = true,
		alive = true,
		distance = 4,
		maxDistance = 8,
		tolerance = 2.5,
		lineOfSight = true,
	}
	for key, value in overrides do
		ctx[key] = value
	end
	return ctx :: any
end

local spec: TestKit.Spec = {
	name = "RoundRules",
	run = function(t)
		t.describe("phases", function()
			t.it("follows Loading -> Intro -> Playing -> Won/Lost -> Intro", function()
				t.expect(RoundRules.canTransition("Loading", "Intro")).toBe(true)
				t.expect(RoundRules.canTransition("Intro", "Playing")).toBe(true)
				t.expect(RoundRules.canTransition("Playing", "Won")).toBe(true)
				t.expect(RoundRules.canTransition("Playing", "Lost")).toBe(true)
				t.expect(RoundRules.canTransition("Lost", "Intro")).toBe(true)
				t.expect(RoundRules.canTransition("Won", "Intro")).toBe(true)
			end)

			t.it("blocks double endings and skipping phases", function()
				t.expect(RoundRules.canTransition("Lost", "Won")).toBe(false)
				t.expect(RoundRules.canTransition("Won", "Lost")).toBe(false)
				t.expect(RoundRules.canTransition("Lost", "Lost")).toBe(false)
				t.expect(RoundRules.canTransition("Intro", "Won")).toBe(false)
				t.expect(RoundRules.canTransition("Loading", "Playing")).toBe(false)
			end)

			t.it("only restarts from end screens", function()
				t.expect(RoundRules.canRestart("Won")).toBe(true)
				t.expect(RoundRules.canRestart("Lost")).toBe(true)
				t.expect(RoundRules.canRestart("Playing")).toBe(false)
				t.expect(RoundRules.canRestart("Intro")).toBe(false)
			end)
		end)

		t.describe("validateInteraction", function()
			t.it("accepts a valid interaction", function()
				t.expect((RoundRules.validateInteraction(context({})))).toBe(true)
			end)

			t.it("rejects outside of Playing", function()
				local ok, reason = RoundRules.validateInteraction(context({ phase = "Intro" }))
				t.expect(ok).toBe(false)
				t.expect(reason).toBe("not_playing")
			end)

			t.it("rejects missing, disabled, dead, far and blocked", function()
				t.expect(select(2, RoundRules.validateInteraction(context({ exists = false })))).toBe("unknown")
				t.expect(select(2, RoundRules.validateInteraction(context({ enabled = false })))).toBe("not_available")
				t.expect(select(2, RoundRules.validateInteraction(context({ alive = false })))).toBe("dead")
				t.expect(select(2, RoundRules.validateInteraction(context({ distance = 11 })))).toBe("too_far")
				t.expect(select(2, RoundRules.validateInteraction(context({ lineOfSight = false })))).toBe("blocked")
			end)

			t.it("accepts within tolerance and rejects NaN distance", function()
				t.expect((RoundRules.validateInteraction(context({ distance = 10.4 })))).toBe(true)
				t.expect((RoundRules.validateInteraction(context({ distance = 0 / 0 })))).toBe(false)
			end)
		end)

		t.it("formats round time as MM:SS", function()
			t.expect(RoundRules.formatTime(0)).toBe("00:00")
			t.expect(RoundRules.formatTime(402.7)).toBe("06:42")
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="559">
          <Properties>
            <string name="Name">Season</string>
            <string name="Source"><![CDATA[--!strict
local Season = require("@game/ReplicatedStorage/Shared/Game/Season")
local Catalog = require("@game/ReplicatedStorage/Shared/Game/SeasonCatalog")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local Schema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local TestKit = require("../TestKit")
local season = Catalog.Seasons[1]
local spec: TestKit.Spec = {
	name = "Season",
	run = function(t)
		t.it("uses inclusive start, exclusive end and thirty valid tiers", function()
			t.expect(Season.current(season.startsAt - 1)).toBe(nil)
			t.expect(Season.current(season.startsAt)).toBe(season)
			t.expect(Season.current(season.endsAt)).toBe(nil)
			t.expect(Season.maxTier(season)).toBe(30)
			t.expect(Season.daysLeft(season, season.endsAt - 1)).toBe(1)
			for _, tier in season.tiers do
				for _, reward in { tier.free, tier.premium } do
					if reward and reward.item then
						t.expect(StoreCatalog.ItemById[reward.item].source).toBe("season")
					end
				end
			end
		end)
		t.it("tier boundaries clamp to thirty and preserve separate account XP", function()
			t.expect((Season.tierInfo(season, -1))).toBe(1)
			t.expect((Season.tierInfo(season, 399))).toBe(1)
			t.expect((Season.tierInfo(season, 400))).toBe(2)
			t.expect((Season.tierInfo(season, 10 ^ 9))).toBe(30)
			local data = Schema.template()
			Season.addXp(data, season, 400, false)
			t.expect(data.xp).toBe(0)
			t.expect(data.season.xp).toBe(400)
		end)
		t.it("free grants and retroactive premium grants are idempotent", function()
			local data = Schema.template()
			Season.addXp(data, season, 1600, false)
			t.expect(data.owned.titulo_hora_extra).toBe(true)
			t.expect(data.owned.farda_hora_extra).toBe(nil)
			local freeBalance = data.wallet.fichas
			Season.grantReached(data, season, false)
			t.expect(data.wallet.fichas).toBe(freeBalance)
			Season.grantReached(data, season, true)
			t.expect(data.owned.farda_hora_extra).toBe(true)
			t.expect(data.owned.lanterna_ponto).toBe(true)
			local balance = data.wallet.fichas
			local creditos = data.wallet.creditos
			Season.grantReached(data, season, true)
			t.expect(data.wallet.fichas).toBe(balance)
			t.expect(data.wallet.creditos).toBe(creditos)
		end)
		t.it("new season resets progress and keeps cosmetics and currency", function()
			local data = Schema.template()
			Season.addXp(data, season, 1600, true)
			local nextSeason = table.clone(season)
			nextSeason.id = "s2"
			local balance = data.wallet.fichas
			t.expect(Season.sync(data, nextSeason)).toBe(true)
			t.expect(data.season.xp).toBe(0)
			t.expect((next(data.season.premium))).toBe(nil)
			t.expect(data.wallet.fichas).toBe(balance)
			t.expect(data.owned.lanterna_ponto).toBe(true)
		end)
		t.it("migrates v2 without losing wallet, inventory or receipts", function()
			local data = Schema.template()
			data.wallet.fichas = 900
			data.owned.lanterna_militar = true
			local raw: any = data
			raw.schemaVersion = 2
			raw.season = nil
			local migrated = Schema.migrate(raw)
			-- Sobe até a versão atual (v4 acrescentou vantagens e história; a temporada continua aqui).
			t.expect(migrated.schemaVersion >= 3).toBe(true)
			t.expect(migrated.wallet.fichas).toBe(900)
			t.expect(migrated.owned.lanterna_militar).toBe(true)
			t.expect(migrated.season.xp).toBe(0)
		end)
	end,
}
return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="560">
          <Properties>
            <string name="Name">ServerList</string>
            <string name="Source"><![CDATA[--!strict
local ServerList = require("@game/ReplicatedStorage/Shared/Game/ServerList")
local TestKit = require("../TestKit")

local JOB_A = "aaaaaaaa-0000-0000-0000-000000000001"
local JOB_B = "bbbbbbbb-0000-0000-0000-000000000002"
local JOB_C = "cccccccc-0000-0000-0000-000000000003"
local SELF = "ffffffff-0000-0000-0000-00000000000f"

local function entry(job: string, players: number, phase: string, updated: number): ServerList.Entry
	return { job = job, players = players, max = 8, mode = "", phase = phase, stage = 0, updated = updated }
end

local testSpec: TestKit.Spec = {
	name = "ServerList",
	run = function(t)
		t.it("validates job ids and decodes only sane records", function()
			t.expect(ServerList.validJob(JOB_A)).toBe(true)
			t.expect(ServerList.validJob("studio")).toBe(false)
			t.expect(ServerList.validJob("../../etc/passwd-0000-0000-0000-0000")).toBe(false)
			t.expect(ServerList.decode("x", JOB_A)).toBeNil()
			t.expect(ServerList.decode({ players = 3, max = 8, updated = 1 }, "nope")).toBeNil()
			t.expect(ServerList.decode({ players = 0 / 0, max = 8, updated = 1 }, JOB_A)).toBeNil()
			local decoded = ServerList.decode(
				{ players = 12, max = 8, updated = 5, phase = "Hacked", mode = "Story", stage = 77 },
				JOB_A
			)
			t.expect(decoded ~= nil).toBe(true)
			if decoded then
				t.expect(decoded.players).toBe(8)
				t.expect(decoded.phase).toBe("Lobby")
				t.expect(decoded.mode).toBe("Story")
				t.expect(decoded.stage).toBe(9)
			end
		end)
		t.it("joinable refuses self, stale and full servers", function()
			local now = 1000
			t.expect((ServerList.joinable(entry(JOB_A, 3, "Lobby", now), JOB_A, now))).toBe(false)
			local _, stale = ServerList.joinable(entry(JOB_A, 3, "Lobby", now - ServerList.TTL - 1), SELF, now)
			t.expect(stale).toBe("server_gone")
			local _, full = ServerList.joinable(entry(JOB_A, 8, "Lobby", now), SELF, now)
			t.expect(full).toBe("server_full")
			t.expect((ServerList.joinable(entry(JOB_A, 7, "Playing", now), SELF, now))).toBe(true)
		end)
		t.it("sorts open lobbies first, then fuller servers, hiding self and stale", function()
			local now = 500
			local list = ServerList.sorted({
				entry(JOB_A, 6, "Playing", now),
				entry(JOB_B, 2, "Lobby", now),
				entry(JOB_C, 8, "Lobby", now),
				entry(SELF, 4, "Lobby", now),
				entry("dddddddd-0000-0000-0000-000000000004", 5, "Lobby", now - 999),
			}, SELF, now)
			t.expect(#list).toBe(3)
			t.expect(list[1].job).toBe(JOB_B)
			t.expect(list[2].job).toBe(JOB_A)
			t.expect(list[3].job).toBe(JOB_C)
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="561">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
local MockDataStore = require("@game/ServerScriptService/Server/Data/MockDataStore")
local PlayerDataSchema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local SessionLock = require("@game/ServerScriptService/Server/Data/SessionLock")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "SessionLock",
	run = function(t)
		t.it("free, own or expired locks can be taken; a fresh foreign lock cannot", function()
			t.expect(SessionLock.canTake(nil, "a", 100)).toBe(true)
			t.expect(SessionLock.canTake(SessionLock.make("a", 90), "a", 100)).toBe(true)
			t.expect(SessionLock.canTake(SessionLock.make("b", 90), "a", 100)).toBe(false)
			t.expect(SessionLock.canTake(SessionLock.make("b", 0), "a", SessionLock.TTL)).toBe(true)
			t.expect(SessionLock.canTake("garbage" :: any, "a", 1)).toBe(true)
		end)

		t.it("a blocked UpdateAsync transform leaves the stored data untouched", function()
			local store = MockDataStore.new()
			local data = PlayerDataSchema.template()
			data.wallet.creditos = 500
			data.sessionLock = SessionLock.make("new-server", 1000)
			store:UpdateAsync("k", function()
				return data
			end)
			-- Servidor antigo tenta salvar uma versão desatualizada: a trava de outro bloqueia.
			store:UpdateAsync("k", function(current: any)
				if not SessionLock.canTake(current.sessionLock, "old-server", 1010) then
					return nil
				end
				return PlayerDataSchema.template()
			end)
			t.expect(store:GetAsync("k").wallet.creditos).toBe(500)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="562">
          <Properties>
            <string name="Name">SpectatorRules</string>
            <string name="Source"><![CDATA[--!strict
local Rules = require("@game/ReplicatedStorage/Shared/Game/SpectatorRules")
local TestKit = require("../TestKit")
return {
	name = "SpectatorRules",
	run = function(t)
		t.it("only waiting and escaped members spectate a live stage", function()
			for _, phase in { "Playing", "Extracting" } do
				t.expect(Rules.allowed(phase, "Waiting")).toBe(true)
				t.expect(Rules.allowed(phase, "Escaped")).toBe(true)
				for _, status in { "Active", "Downed", "Unknown" } do
					t.expect(Rules.allowed(phase, status)).toBe(false)
				end
			end
			for _, phase in { "Lobby", "Intro", "Lost", "Won", "Intermission" } do
				t.expect(Rules.allowed(phase, "Waiting")).toBe(false)
			end
			t.expect(Rules.allowed("Playing", nil)).toBe(false)
		end)
		t.it("cycles both ways with wraparound without changing the source list", function()
			local ids = { 7, -2, 4 }
			t.expect(Rules.choose(ids, nil, 0)).toBe(-2)
			t.expect(Rules.choose(ids, 7, 1)).toBe(-2)
			t.expect(Rules.choose(ids, -2, -1)).toBe(7)
			t.expect(Rules.choose(ids, 4, 0)).toBe(4)
			t.expect(ids[1]).toBe(7)
		end)
		t.it("recovers from disconnects and an empty or single survivor roster", function()
			t.expect(Rules.choose({}, 4, 1)).toBe(nil)
			t.expect(Rules.choose({ -3 }, 4, -1)).toBe(-3)
			t.expect(Rules.choose({ -3 }, -3, 1)).toBe(-3)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="563">
          <Properties>
            <string name="Name">StoreCatalog</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "StoreCatalog",
	run = function(t)
		t.it("has unique item ids and a default for every kind", function()
			local seen = {}
			for _, item in StoreCatalog.Items do
				t.expect(seen[item.id]).toBeNil()
				seen[item.id] = true
				t.expect(StoreCatalog.Rarities[item.rarity] ~= nil).toBe(true)
			end
			for _, kind in StoreCatalog.KINDS do
				local default = StoreCatalog.ItemById[StoreCatalog.defaultFor(kind :: StoreCatalog.ItemKind)]
				t.expect(default ~= nil and default.kind == kind and default.source == "default").toBe(true)
			end
		end)

		t.it("store items have a price; titles are never sold", function()
			for _, item in StoreCatalog.Items do
				if item.source == "store" then
					t.expect(item.fichas ~= nil or item.creditos ~= nil).toBe(true)
				end
				if item.kind == "title" then
					t.expect(item.fichas == nil and item.creditos == nil).toBe(true)
				end
			end
		end)

		-- Regra de itens aleatórios pagos: chances em % de cada resultado, somando exatamente 100%.
		t.it("chest odds sum to 100% and every rarity has items", function()
			for _, chest in StoreCatalog.Chests do
				local total = 0
				local perItemTotal = 0
				for _, line in Economy.chestOdds(chest) do
					total += line.percent
					t.expect(#line.items > 0).toBe(true)
					perItemTotal += line.perItem * #line.items
				end
				t.expect(total).toBe(100)
				t.expect(perItemTotal).toBeCloseTo(100, 1e-9)
			end
		end)

		t.it("only the Robux-currency chest is flagged as paid random", function()
			for _, chest in StoreCatalog.Chests do
				t.expect(chest.paidRandom).toBe(chest.currency == "creditos")
			end
		end)

		t.it("every referenced reward item exists", function()
			local function check(reward: StoreCatalog.Reward)
				if reward.item then
					t.expect(StoreCatalog.ItemById[reward.item] ~= nil).toBe(true)
				end
			end
			for _, reward in StoreCatalog.LevelMilestones do
				check(reward)
			end
			for _, reward in StoreCatalog.TapeMilestones do
				check(reward)
			end
			for _, reward in StoreCatalog.Daily do
				check(reward)
			end
			for _, id in StoreCatalog.StarterItems do
				t.expect(StoreCatalog.ItemById[id] ~= nil).toBe(true)
			end
			t.expect(StoreCatalog.ItemById[StoreCatalog.FirstEscapeItem] ~= nil).toBe(true)
		end)

		t.it("spin weights sum to 100 and products have unique keys", function()
			local total = 0
			for _, segment in StoreCatalog.Spin do
				total += segment.weight
			end
			t.expect(total).toBe(100)
			local keys = {}
			for _, product in StoreCatalog.Products do
				t.expect(keys[product.key]).toBeNil()
				keys[product.key] = true
			end
			t.expect(#StoreCatalog.Tapes).toBe(12)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="564">
          <Properties>
            <string name="Name">StoreFunnel</string>
            <string name="Source"><![CDATA[--!strict
local Funnel = require("@game/ServerScriptService/Server/Game/StoreFunnel")
local TestKit = require("../TestKit")
local spec: TestKit.Spec = {
	name = "StoreFunnel",
	run = function(t)
		t.it("ignores unsolicited steps and repeats within a session", function()
			local state = Funnel.new()
			t.expect(#Funnel.view(state, "shop")).toBe(0)
			t.expect(#Funnel.purchase(state, "item", "fichas")).toBe(0)
			t.expect(Funnel.open(state, "a")[1].step).toBe(1)
			t.expect(#Funnel.view(state, "invalid")).toBe(0)
			t.expect(Funnel.view(state, "season")[1].step).toBe(2)
			t.expect(#Funnel.view(state, "shop")).toBe(0)
			t.expect(Funnel.purchase(state, "pass", "robux")[1].step).toBe(3)
			t.expect(#Funnel.purchase(state, "pass", "robux")).toBe(0)
			t.expect(Funnel.open(state, "b")[1].step).toBe(1)
			t.expect(state.session).toBe("b")
		end)
	end,
}
return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="565">
          <Properties>
            <string name="Name">StoreView</string>
            <string name="Source"><![CDATA[--!strict
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local StoreView = require("@game/ReplicatedStorage/Shared/Game/StoreView")
local TestKit = require("../TestKit")

return {
	name = "StoreView",
	run = function(t)
		t.it("every item explains a concrete way to get it", function()
			for _, item in StoreCatalog.Items do
				local text = StoreView.howToGet(item)
				t.expect(text ~= "").toBe(true)
				-- Fontes com número no catálogo precisam mostrar o número (nível, fitas, capítulo, nível do passe).
				if item.source == "level" or item.source == "tapes" or item.source == "season" then
					t.expect(string.find(text, "%d") ~= nil).toBe(true)
				end
				if item.source == "story" then
					t.expect(string.find(text, "%d") ~= nil).toBe(true)
				end
			end
		end)
		t.it("every kind has a note about who sees it", function()
			for _, kind in StoreCatalog.KINDS do
				t.expect(StoreView.kindNote(kind :: StoreCatalog.ItemKind) ~= "").toBe(true)
			end
		end)
		t.it("state follows ownership, equip and store source", function()
			local retro = StoreCatalog.ItemById.lanterna_retro
			t.expect(StoreView.state(retro, {}, "lanterna_padrao", false)).toBe("buyable")
			t.expect(StoreView.state(retro, { lanterna_retro = true }, "lanterna_padrao", false)).toBe("owned")
			t.expect(StoreView.state(retro, { lanterna_retro = true }, "lanterna_retro", false)).toBe("equipped")
			local default = StoreCatalog.ItemById.lanterna_padrao
			t.expect(StoreView.state(default, {}, "lanterna_padrao", false)).toBe("equipped")
			local vip = StoreCatalog.ItemById.lanterna_supervisor
			t.expect(StoreView.state(vip, {}, "lanterna_padrao", false)).toBe("locked")
			t.expect(StoreView.state(vip, {}, "lanterna_padrao", true)).toBe("owned")
			t.expect(StoreView.state(StoreCatalog.ItemById.lanterna_vigia, {}, "x", false)).toBe("locked")
		end)
		t.it("prices come from the catalog and report what is missing", function()
			local retro = StoreCatalog.ItemById.lanterna_retro
			local options = StoreView.prices(retro, 400, 200)
			t.expect(#options).toBe(2)
			t.expect(options[1].currency).toBe("fichas")
			t.expect(options[1].price).toBe(retro.fichas)
			t.expect(options[1].affordable).toBe(false)
			t.expect(options[1].missing).toBe((retro.fichas :: number) - 400)
			t.expect(options[2].affordable).toBe(true)
			t.expect(#StoreView.prices(StoreCatalog.ItemById.lanterna_vigia, 99999, 99999)).toBe(0)
		end)
		t.it("filter grade desaturates, tints and keeps neutral filters neutral", function()
			local neutral = { kind = "filter", tint = { 255, 255, 255 } } :: any
			local same = StoreView.grade({ 200, 100, 50 }, neutral)
			t.expect(same[1]).toBe(200)
			t.expect(same[2]).toBe(100)
			t.expect(same[3]).toBe(50)
			local cctv = StoreCatalog.ItemById.filtro_cctv
			local gray = StoreView.grade({ 220, 60, 40 }, cctv)
			-- Saturação -1: canais quase iguais (só a tinta pálida separa um pouco).
			t.expect(math.abs(gray[1] - gray[2]) <= 12).toBe(true)
			local sepia = StoreView.grade({ 128, 128, 128 }, StoreCatalog.ItemById.filtro_sepia)
			t.expect(sepia[1] > sepia[3]).toBe(true)
			for _, value in StoreView.grade({ 255, 255, 255 }, StoreCatalog.ItemById.filtro_infra) do
				t.expect(value >= 0 and value <= 255).toBe(true)
			end
		end)
		t.it("spin wheel slices match the real weights and close the circle", function()
			local arcs = StoreView.spinArcs(StoreCatalog.Spin)
			t.expect(#arcs).toBe(#StoreCatalog.Spin)
			local total = 0
			for _, segment in StoreCatalog.Spin do
				total += segment.weight
			end
			for index, arc in arcs do
				local expected = StoreCatalog.Spin[index].weight / total * 360
				t.expect(math.abs((arc[2] - arc[1]) - expected) < 1e-6).toBe(true)
				t.expect(math.abs(arc[3] - StoreCatalog.Spin[index].weight / total * 100) < 1e-6).toBe(true)
			end
			t.expect(math.abs(arcs[#arcs][2] - 360) < 1e-6).toBe(true)
		end)
		t.it("spin rotation lands the pointer inside the server's segment", function()
			local arcs = StoreView.spinArcs(StoreCatalog.Spin)
			for index, arc in arcs do
				for _, fraction in { 0, 0.5, 1 } do
					local rotation = StoreView.spinRotation(arcs, index, fraction, 4)
					t.expect(rotation >= 4 * 360).toBe(true)
					-- O ponteiro no topo aponta para o ângulo (-rotação) mod 360 da roda.
					local pointed = (360 - rotation % 360) % 360
					t.expect(pointed > arc[1] and pointed < arc[2]).toBe(true)
				end
			end
		end)
		t.it("items of a kind keep rarity order and cover the catalog", function()
			local total = 0
			for _, kind in StoreCatalog.KINDS do
				local list = StoreView.itemsOfKind(kind :: StoreCatalog.ItemKind)
				total += #list
				for index = 2, #list do
					local a = StoreCatalog.Rarities[list[index - 1].rarity].order
					local b = StoreCatalog.Rarities[list[index].rarity].order
					t.expect(a <= b).toBe(true)
				end
			end
			t.expect(total).toBe(#StoreCatalog.Items)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="566">
          <Properties>
            <string name="Name">StoryMode</string>
            <string name="Source"><![CDATA[--!strict
local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Plan = require("@game/ServerScriptService/Server/Campaign/HousePlan")
local Story = require("@game/ReplicatedStorage/Shared/Game/StoryCatalog")
local Modes = require("@game/ReplicatedStorage/Shared/Game/GameModes")
local Shots = require("@game/ReplicatedStorage/Shared/Game/CinematicShots")
local Schema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local Oxygen = require("@game/ServerScriptService/Server/Game/Oxygen")
local TestKit = require("../TestKit")
return {
	name = "StoryMode",
	run = function(t: TestKit.Context)
		t.it("solo starts with one vote, ties wait, outsiders do not vote", function()
			t.expect((Modes.winner({ [1] = "Story" }, { [1] = {} }, Config.Campaign.minPlayers))).toBe("Story")
			t.expect((Modes.winner({ [1] = "Story", [2] = "Standard" }, { [1] = {}, [2] = {} }, 1))).toBe(nil)
			t.expect((Modes.winner({ [99] = "Story" }, { [1] = {} }, 1))).toBe(nil)
		end)
		t.it("finishes house and forest chapters with 1, 2 and 6 survivors and no duplicated pickups", function()
			for _, count in { 1, 2, 6 } do
				for _, mode in { "Story", "Standard" } do
					local s = Session.new(90312, Config.Campaign, mode, true)
					for id = 1, count do
						t.expect((Session.join(s, id))).toBe(true)
					end
					for chapter = 1, 8 do
						t.expect((Session.beginStage(s))).toBe(true)
						local plan = s.plan
						assert(plan, "Expected house plan")
						t.expect((Plan.validate(plan))).toBe(true)
						if mode == "Story" or chapter == 1 or chapter == 5 then
							t.expect((Session.act(s, 1, plan.activities[2].id, 1, 1))).toBe(false)
						end
						for _, spec in plan.activities do
							if spec.kind == "puzzle" or spec.kind == "repair" then
								local wrong = spec.order[1] % 4 + 1
								t.expect((Session.act(s, 1, spec.id, wrong, 1))).toBe(false)
								for _, button in spec.order do
									t.expect((Session.act(s, 1, spec.id, button, 1))).toBe(true)
								end
							else
								t.expect((Session.act(s, 1, spec.id, 1, 1))).toBe(true)
							end
							t.expect((Session.act(s, 1, spec.id, 1, 1))).toBe(false)
						end
						t.expect(s.phase).toBe(if chapter == 5 or chapter == 8 then "Extracting" else "Intermission")
						if chapter == 5 then
							for id = 1, count do
								Session.escape(s, id)
							end
							t.expect(s.phase).toBe("Intermission")
						end
					end
					t.expect(s.inventory.artifact).toBe(1)
					for id = 1, count do
						Session.escape(s, id)
					end
					t.expect(s.phase).toBe("Won")
				end
			end
		end)
		t.it("many seeds retain prerequisites, room bounds and reproducible four-symbol solutions", function()
			for seed = 1, 120 do
				for chapter = 1, 5 do
					local a = Plan.create(seed, chapter, 1, "Standard")
					local b = Plan.create(seed, chapter, 6, "Standard")
					t.expect((Plan.validate(a))).toBe(true)
					t.expect(a.activities).toEqual(b.activities)
					local occupied: { [string]: boolean } = {}
					for _, activity in a.activities do
						if activity.kind ~= "hide" and activity.kind ~= "breath" then
							local point = `{activity.x}:{activity.y}:{activity.z}`
							t.expect(occupied[point]).toBe(nil)
							occupied[point] = true
						end
						t.expect(math.abs(activity.x) <= 100 and activity.z >= -112 and activity.z <= 80).toBe(true)
						t.expect(
							activity.y == -16
								or activity.y == 0
								or activity.y == 8
								or activity.y == 16
								or activity.y == 32
						).toBe(true)
						if activity.kind == "puzzle" then
							local seen = {}
							for _, symbol in activity.order do
								seen[symbol] = true
							end
							for symbol = 1, 4 do
								t.expect(seen[symbol]).toBe(true)
							end
						end
					end
				end
			end
		end)
		t.it("checkpoint restores the same code and removes unfinished chapter items", function()
			local s = Session.new(123, Config.Campaign, "Standard", true)
			Session.join(s, 1)
			Session.beginStage(s)
			local before = s.plan
			Session.act(s, 1, "task_1", 1, 1)
			Session.act(s, 1, "task_2", 1, 1)
			t.expect(s.inventory.flashlight).toBe(1)
			Session.eliminate(s, 1)
			t.expect(s.phase).toBe("Lost")
			Session.retryStage(s)
			Session.beginStage(s)
			t.expect(s.plan).toEqual(before)
			t.expect(s.inventory.flashlight).toBe(nil)
		end)
		t.it("oxygen consumes eight seconds, cancels with cooldown, and cannot spam silence", function()
			local o = Oxygen.new()
			t.expect(Oxygen.request(o, true, 0)).toBe(true)
			Oxygen.step(o, 6, 6)
			t.expect(o.value).toBe(25)
			Oxygen.request(o, false, 6)
			t.expect(Oxygen.request(o, true, 6.1)).toBe(false)
			Oxygen.step(o, 1, 7)
			t.expect(o.value).toBe(25)
			Oxygen.step(o, 1, 9)
			t.expect(o.value).toBe(45)
			t.expect(Oxygen.request(o, true, 9)).toBe(true)
			t.expect(Oxygen.step(o, 8, 17)).toBe(true)
			t.expect(o.dead).toBe(true)
			t.expect(Oxygen.request(o, true, 18)).toBe(false)
		end)
		t.it("v4 migration preserves wallet purchases and old story separately from new house", function()
			local old: any = Schema.template()
			old.schemaVersion, old.house = 4, nil
			old.wallet.fichas, old.owned.lanterna_elias = 1234, true
			old.story.cleared["1"] = 100
			old.purchases.receipt = 200
			local migrated = Schema.migrate(old)
			t.expect(migrated.wallet.fichas).toBe(1234)
			t.expect(migrated.owned.lanterna_elias).toBe(true)
			t.expect(migrated.story.cleared["1"]).toBe(100)
			t.expect(migrated.house.cleared["1"]).toBe(nil)
			t.expect(migrated.purchases.receipt).toBe(200)
		end)
		t.it("preferences reject corruption and preserve fractional audio volumes", function()
			local Prefs = require("@game/ReplicatedStorage/Shared/Game/HousePreferences")
			local migrated = Schema.migrate({
				house = { preferences = { music = 0.75, master = 1, bad = 1, ambient = 0 / 0, effects = 2 } },
			})
			t.expect(migrated.house.preferences.music).toBe(0.75)
			t.expect(migrated.house.preferences.bad).toBe(nil)
			t.expect(migrated.house.preferences.ambient).toBe(nil)
			t.expect(Prefs.category("Breath1")).toBe("breathing")
			t.expect(Prefs.category("MusicChase")).toBe("music")
		end)
		t.it("house rejects seventh player and disconnect cannot lose essential team items", function()
			local s = Session.new(42, Config.Campaign, "Story", true)
			for id = 1, 6 do
				t.expect((Session.join(s, id))).toBe(true)
			end
			t.expect((Session.join(s, 7))).toBe(false)
			Session.beginStage(s)
			Session.act(s, 1, "task_1", 1, 0)
			Session.act(s, 1, "task_2", 1, 0)
			Session.leave(s, 1)
			t.expect(s.inventory.flashlight).toBe(1)
			t.expect(s.phase).toBe("Playing")
		end)
		t.it("eight chapter scenes fit their shared server interval", function()
			t.expect(#Story.Chapters).toBe(8)
			for _, scene in Story.Scenes do
				t.expect(Shots.duration(scene)).toBe(Story.SceneSeconds)
			end
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="567">
          <Properties>
            <string name="Name">StoryRewards</string>
            <string name="Source"><![CDATA[--!strict
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local StoryRewards = require("@game/ReplicatedStorage/Shared/Game/StoryRewards")
local Schema = require("@game/ServerScriptService/Server/Data/PlayerDataSchema")
local TestKit = require("../TestKit")

local testSpec: TestKit.Spec = {
	name = "StoryRewards",
	run = function(t)
		t.it("every chapter reward points to real items and consumables", function()
			for _, chapter in StoryRewards.Chapters do
				for _, reward in { chapter.first, chapter.again, chapter.flawless } do
					if reward.item then
						t.expect(StoreCatalog.ItemById[reward.item] ~= nil).toBe(true)
					end
					local consumables: { [string]: number } = reward.consumables or {}
					for id in consumables do
						t.expect(Perks.ConsumableById[id] ~= nil).toBe(true)
					end
				end
			end
			t.expect(StoreCatalog.ItemById[StoryRewards.CompletionItem] ~= nil).toBe(true)
			for _, id in StoreCatalog.StoryPassItems do
				t.expect(StoreCatalog.ItemById[id].source).toBe("storypass")
			end
		end)
		t.it("first clear pays big once, repeats pay less", function()
			local data = Schema.template()
			local granted, outcome = StoryRewards.award(data, 1, false, false, 100)
			t.expect(outcome and outcome.first).toBe(true)
			-- Fichas do capítulo + as dos níveis que o XP do capítulo pode ter subido.
			local firstFichas = if granted then granted.fichas else 0
			t.expect(firstFichas >= 400).toBe(true)
			t.expect(data.house.cleared["1"]).toBe(100)
			local again, second = StoryRewards.award(data, 1, false, false, 200)
			t.expect(second and second.first).toBe(false)
			local againFichas = if again then again.fichas else 0
			t.expect(againFichas >= 120 and againFichas < firstFichas).toBe(true)
			t.expect(data.house.cleared["1"]).toBe(100)
			local kind = StoryRewards.preview(data, 1)
			t.expect(kind).toBe("again")
		end)
		t.it("flawless bonus pays once and grants consumables", function()
			local data = Schema.template()
			StoryRewards.award(data, 2, true, false, 10)
			t.expect(data.owned.farda_ronda).toBe(true)
			t.expect(Perks.count(data, "segunda_chance")).toBe(1)
			local _, outcome = StoryRewards.award(data, 2, true, false, 20)
			t.expect(outcome and outcome.flawless).toBe(false)
			t.expect(Perks.count(data, "segunda_chance")).toBe(1)
		end)
		t.it("story pass doubles currencies but not items", function()
			local data = Schema.template()
			local granted = StoryRewards.award(data, 3, false, true, 5)
			t.expect((if granted then granted.fichas else 0) >= 1600).toBe(true)
			t.expect((if granted then granted.creditos else 0) >= 100).toBe(true)
			t.expect(data.owned.lanterna_elias).toBe(true)
		end)
		t.it("clearing all chapters unlocks the completion title once", function()
			local data = Schema.template()
			StoryRewards.award(data, 1, false, false, 1)
			StoryRewards.award(data, 2, false, false, 2)
			t.expect(data.owned[StoryRewards.CompletionItem]).toBeNil()
			StoryRewards.award(data, 3, false, false, 3)
			StoryRewards.award(data, 4, false, false, 4)
			StoryRewards.award(data, 5, false, false, 5)
			t.expect(data.owned[StoryRewards.CompletionItem]).toBeNil()
			StoryRewards.award(data, 6, false, false, 6)
			StoryRewards.award(data, 7, false, false, 7)
			local _, outcome = StoryRewards.award(data, 8, false, false, 8)
			t.expect(outcome and outcome.completed).toBe(true)
			t.expect(data.owned[StoryRewards.CompletionItem]).toBe(true)
			local _, again = StoryRewards.award(data, 3, false, false, 4)
			t.expect(again and again.completed).toBe(false)
			t.expect(StoryRewards.clearedCount(data)).toBe(8)
		end)
		t.it("unknown chapter grants nothing", function()
			local data = Schema.template()
			local granted, outcome = StoryRewards.award(data, 9, true, true, 1)
			t.expect(granted).toBeNil()
			t.expect(outcome).toBeNil()
			t.expect(data.wallet.fichas).toBe(0)
		end)
	end,
}

return testSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="568">
          <Properties>
            <string name="Name">SurfacePatterns</string>
            <string name="Source"><![CDATA[--!strict
local Patterns = require("@game/ReplicatedStorage/Shared/Game/SurfacePatterns")
local TestKit = require("../TestKit")
return {
	name = "SurfacePatterns",
	run = function(t)
		t.it("all surfaces produce bounded RGBA tiles with visible and transparent wear", function()
			for _, kind in Patterns.Kinds do
				local pixels = Patterns.pixels(kind, 7)
				t.expect(buffer.len(pixels)).toBe(Patterns.Size ^ 2 * 4)
				local minAlpha, maxAlpha = 255, 0
				for i = 3, buffer.len(pixels) - 1, 4 do
					minAlpha = math.min(minAlpha, buffer.readu8(pixels, i))
					maxAlpha = math.max(maxAlpha, buffer.readu8(pixels, i))
				end
				t.expect(minAlpha < maxAlpha).toBe(true)
				t.expect(maxAlpha < 200).toBe(true)
			end
		end)
		t.it("same seed is reproducible and different seeds change wear", function()
			local a = buffer.tostring(Patterns.pixels("paint", 4))
			t.expect(a).toBe(buffer.tostring(Patterns.pixels("paint", 4)))
			t.expect(a == buffer.tostring(Patterns.pixels("paint", 5))).toBe(false)
		end)
		t.it("rejects unknown texture kinds", function()
			local ok = pcall(Patterns.pixels, "unknown", 1)
			t.expect(ok).toBe(false)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="569">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
local TableUtil = require("@game/ReplicatedStorage/Shared/Util/TableUtil")
local TestKit = require("../TestKit")

local spec: TestKit.Spec = {
	name = "TableUtil",
	run = function(t)
		t.describe("deepCopy", function()
			t.it("copies nested tables independently", function()
				local original = { a = 1, nested = { b = 2 } }
				local copy = TableUtil.deepCopy(original)
				copy.nested.b = 3
				t.expect(original.nested.b).toBe(2)
				t.expect(copy.a).toBe(1)
			end)

			t.it("returns non-table values as-is", function()
				t.expect(TableUtil.deepCopy(5)).toBe(5)
				t.expect(TableUtil.deepCopy("x")).toBe("x")
			end)
		end)

		t.describe("reconcile", function()
			local template = { coins = 0, settings = { music = true, volume = 1 } }

			t.it("fills missing keys recursively and keeps existing values", function()
				local result = TableUtil.reconcile({ coins = 10, settings = { volume = 0.5 } }, template)
				t.expect(result).toEqual({ coins = 10, settings = { music = true, volume = 0.5 } })
			end)

			t.it("returns a copy of the template for non-table input", function()
				local result = TableUtil.reconcile(nil, template)
				t.expect(result).toEqual(template)
				result.settings.music = false
				t.expect(template.settings.music).toBe(true)
			end)
		end)

		t.describe("deepFreeze", function()
			t.it("freezes nested tables", function()
				local frozen = TableUtil.deepFreeze({ nested = { value = 1 } })
				t.expect(table.isfrozen(frozen)).toBe(true)
				t.expect(table.isfrozen(frozen.nested)).toBe(true)
				t.expect(function()
					(frozen.nested :: any).value = 2
				end).toThrow()
			end)
		end)

		t.describe("deepEqual", function()
			t.it("compares structurally", function()
				local a: { any } = { 1, { 2 } }
				local b: { any } = { 1, { 2 } }
				t.expect(TableUtil.deepEqual(a, b)).toBe(true)
				t.expect(TableUtil.deepEqual({ a = 1 }, { a = 1, b = 2 })).toBe(false)
				t.expect(TableUtil.deepEqual({ a = 1, b = 2 }, { a = 1 })).toBe(false)
			end)
		end)
	end,
}

return spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="570">
          <Properties>
            <string name="Name">TaskRewards</string>
            <string name="Source"><![CDATA[--!strict
local Rewards = require("@game/ReplicatedStorage/Shared/Game/TaskRewards")
local TestKit = require("../TestKit")
return {
	name = "TaskRewards",
	run = function(t)
		t.it("shares completion rewards and gives each helper the same fixed bonus", function()
			t.expect(Rewards.reward(false)).toEqual({ fichas = 12, xp = 24 })
			t.expect(Rewards.reward(true)).toEqual({ fichas = 20, xp = 40 })
		end)
		t.it("pays once across duplicate completion and continuation of the same stage", function()
			local ledger: Rewards.Ledger = {}
			local count = 0
			local function grant(): boolean
				count += 1
				return true
			end
			t.expect(Rewards.claim(ledger, "1:task_1", 7, grant)).toBe(true)
			t.expect(Rewards.claim(ledger, "1:task_1", 7, grant)).toBe(false)
			t.expect(count).toBe(1)
			t.expect(Rewards.claim(ledger, "1:task_1", 8, grant)).toBe(true)
			t.expect(Rewards.claim(ledger, "2:task_1", 7, grant)).toBe(true)
			t.expect(Rewards.claim({}, "1:task_1", 7, grant)).toBe(true)
		end)
		t.it("does not consume a reward if the player profile is not ready", function()
			local ledger: Rewards.Ledger = {}
			t.expect(Rewards.claim(ledger, "1:task_1", 7, function()
				return false
			end)).toBe(false)
			t.expect(Rewards.claim(ledger, "1:task_1", 7, function()
				return true
			end)).toBe(true)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="571">
          <Properties>
            <string name="Name">TaskStations</string>
            <string name="Source"><![CDATA[--!strict
local TestKit = require("../TestKit")
return {
	name = "TaskStations",
	robloxOnly = true,
	run = function(t)
		local Builder = require("@game/ServerScriptService/Server/Campaign/ActivityBuilder")
		local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
		local Config = require("@game/ReplicatedStorage/Shared/Config")
		local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
		local function fixture(mode: string, stage: number, run: (any, any) -> ())
			local root = Instance.new("Folder")
			local state = Session.new(90312, Config.Campaign, mode)
			Session.join(state, 1)
			Session.join(state, 2)
			state.stage = stage - 1
			Session.beginStage(state)
			local ok, reason = pcall(function()
				local plan = state.plan :: any
				if mode == "Story" then
					plan.mode = "Story"
				end
				local built = Builder.build(root, plan, 9)
				run(built, state)
			end)
			root:Destroy()
			assert(ok, tostring(reason))
		end
		t.it("builds distinct repair components and updates the next action after technician assistance", function()
			fixture("Standard", 1, function(built, state)
				local id = (state.plan :: any).activities[1].id
				t.expect(built.targets[`{id}_3`] ~= nil).toBe(true)
				Session.act(state, 1, id, 1, 0)
				Builder.refresh(built, state.tasks, 0, 2)
				t.expect(string.find(built.labels[id].Text, "TESTAR ENERGIA", 1, true) ~= nil).toBe(true)
				t.expect(built.targets[`{id}_3`].focus:GetAttribute(Tags.Attr.InteractPrompt)).toBe("TESTAR ENERGIA")
				Session.act(state, 2, id, 3, 1)
				Builder.refresh(built, state.tasks, 1, 2)
				t.expect(built.targets[`{id}_3`].focus:GetAttribute(Tags.Attr.InteractEnabled)).toBe(false)
			end)
		end)
		t.it("shows relay countdown, expiry, and a clear fallback for the last survivor", function()
			fixture("Standard", 2, function(built, state)
				local id = (state.plan :: any).activities[1].id
				Session.act(state, 1, id, 1, 0)
				Builder.refresh(built, state.tasks, 1, 2)
				t.expect(string.find(built.labels[id].Text, "COLEGA:", 1, true) ~= nil).toBe(true)
				Session.tick(state, 50)
				Builder.refresh(built, state.tasks, 50, 1)
				t.expect(string.find(built.labels[id].Text, "ULTIMO ATIVO", 1, true) ~= nil).toBe(true)
				t.expect(built.targets[`{id}_1`].focus:GetAttribute(Tags.Attr.InteractPrompt))
					.toBe("ARMAR RELE SOZINHO")
			end)
		end)
		t.it("keeps future story stations locked and preserves sequence progress after mistakes", function()
			fixture("Story", 1, function(built, state)
				Builder.refresh(built, state.tasks, 0, 2)
				t.expect(built.targets.task_2_1.focus:GetAttribute(Tags.Attr.InteractEnabled)).toBe(false)
				Session.act(state, 1, "task_1", 1, 0)
				Session.act(state, 1, "task_1", 3, 1)
				Builder.refresh(built, state.tasks, 1, 2)
				t.expect(built.targets.task_2_1.focus:GetAttribute(Tags.Attr.InteractEnabled)).toBe(true)
				local order = state.tasks.task_2.spec.order
				Session.act(state, 2, "task_2", order[1], 2)
				Session.act(state, 2, "task_2", order[1], 3)
				Builder.refresh(built, state.tasks, 3, 2)
				t.expect(state.tasks.task_2.progress).toBe(1)
			end)
		end)
	end,
} :: TestKit.Spec
]]></string>
          </Properties>
