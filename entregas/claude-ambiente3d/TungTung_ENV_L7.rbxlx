          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="448">
          <Properties>
            <string name="Name">MockDataStore</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataStore em memória com a mesma interface usada pelo PlayerDataService
	(GetAsync / UpdateAsync / RemoveAsync). Usado quando não há acesso às APIs
	(Studio sem permissão, place não publicada). Os dados somem quando o servidor fecha.
	Puro: testável no Lune.
]]

local TableUtil = require("@game/ReplicatedStorage/Shared/Util/TableUtil")

export type Store = {
	GetAsync: (self: Store, key: string) -> any,
	UpdateAsync: (self: Store, key: string, transform: (current: any) -> ...any) -> any,
	RemoveAsync: (self: Store, key: string) -> any,
}

local MockDataStore = {}

function MockDataStore.new(): Store
	local entries: { [string]: any } = {}
	local store = {}

	function store.GetAsync(_self: Store, key: string): any
		return TableUtil.deepCopy(entries[key])
	end

	function store.UpdateAsync(_self: Store, key: string, transform: (current: any) -> ...any): any
		-- Como no real, o transform pode retornar (valor, userIds, metadata); só o valor importa aqui.
		local nextValue = transform(TableUtil.deepCopy(entries[key]))
		-- Igual ao DataStore real: retornar nil cancela a escrita.
		if nextValue ~= nil then
			entries[key] = TableUtil.deepCopy(nextValue)
		end
		return TableUtil.deepCopy(entries[key])
	end

	function store.RemoveAsync(_self: Store, key: string): any
		local previous = entries[key]
		entries[key] = nil
		return previous
	end

	return store :: any
end

return MockDataStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="449">
          <Properties>
            <string name="Name">PlayerDataSchema</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Formato dos dados persistidos do jogador + migração de versões antigas.
	Puro: testável no Lune.

	Para mudar o formato:
	  1. altere Types.PlayerData e TEMPLATE;
	  2. suba Config.Data.SchemaVersion;
	  3. trate a conversão em migrate() (dados antigos nunca podem quebrar o load).

	Versões:
	  1  sessões e datas de entrada.
	  2  economia/cosméticos/progressão (carteira, XP, itens, equipados, fitas, diário,
	     estatísticas, recibos de compra) e trava de sessão. Contas v1 recebem tudo zerado.
	  3  passe de temporada (season: id, XP de temporada e níveis entregues por trilha).
	     Contas v2 começam a temporada do zero.
	  4  vantagens pagas (perks, consumables, loadout, boosts) e progresso da história (story).
	     Contas v3 começam sem melhorias, sem estoque e sem capítulos.
]]

local Config = require("@game/ReplicatedStorage/Shared/Config")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local TableUtil = require("@game/ReplicatedStorage/Shared/Util/TableUtil")
local Types = require("@game/ReplicatedStorage/Shared/Types")

local Preferences = require("@game/ReplicatedStorage/Shared/Game/HousePreferences")
local TEMPLATE: Types.PlayerData = TableUtil.deepFreeze({
	schemaVersion = Config.Data.SchemaVersion,
	sessions = 0,
	firstJoin = 0,
	lastJoin = 0,
	wallet = { fichas = 0, creditos = 0 },
	xp = 0,
	rewardedLevel = 1,
	owned = {},
	equipped = {
		flashlight = StoreCatalog.Defaults.flashlight,
		uniform = StoreCatalog.Defaults.uniform,
		filter = StoreCatalog.Defaults.filter,
		title = StoreCatalog.Defaults.title,
	},
	tapes = {},
	daily = { lastDay = 0, streak = 0, spinDay = 0, spinsUsed = 0 },
	stats = { runs = 0, escapes = 0, captures = 0, chests = 0, stages = 0 },
	purchases = {},
	oncePurchases = {},
	season = { id = "", xp = 0, free = {}, premium = {} },
	perks = {},
	consumables = {},
	loadout = {},
	boosts = { fichasUntil = 0, xpUntil = 0 },
	story = { cleared = {}, flawless = {} },
	house = { cleared = {}, flawless = {}, endings = {}, achievements = {}, preferences = { shaders = 1, quality = 0 } },
})

-- Mapa { [string]: number } saneado (lixo vira vazio; números inválidos somem).
local function numberMap(value: unknown, max: number): { [string]: number }
	local clean: { [string]: number } = {}
	if type(value) ~= "table" then
		return clean
	end
	for key, n in value :: { [any]: any } do
		if type(key) == "string" and type(n) == "number" and n == n and n >= 0 and n ~= math.huge then
			clean[key] = math.min(math.floor(n), max)
		end
	end
	return clean
end

local function finiteOr(value: any, fallback: number): number
	return if type(value) == "number" and value == value and math.abs(value) ~= math.huge then value else fallback
end

local PlayerDataSchema = {}

function PlayerDataSchema.template(): Types.PlayerData
	return TableUtil.deepCopy(TEMPLATE)
end

-- Converte qualquer valor salvo (inclusive nil ou lixo) em PlayerData válido.
function PlayerDataSchema.migrate(raw: unknown): Types.PlayerData
	if type(raw) ~= "table" then
		return PlayerDataSchema.template()
	end
	-- v1 -> v2 -> v3 -> v4: os campos novos vêm do template (reconcile preenche o que falta).
	local data = TableUtil.reconcile(raw, TEMPLATE)
	local h = data.house :: any
	if type(h) ~= "table" then
		h = {}
	end
	data.house = {
		preferences = Preferences.sanitize(h.preferences),
		cleared = numberMap(h.cleared, 2147483647),
		flawless = numberMap(h.flawless, 2147483647),
		endings = numberMap(h.endings, 2147483647),
		achievements = numberMap(h.achievements, 2147483647),
	}
	-- v6: preferências gráficas individuais; preserva volumes/conforto e todo o progresso v5.
	if data.house.preferences.shaders == nil then
		data.house.preferences.shaders = 1
	end
	if data.house.preferences.quality == nil then
		data.house.preferences.quality = 0
	end
	-- Valores corrompidos não podem travar a economia.
	for _, currency in StoreCatalog.CURRENCIES do
		local value = (data.wallet :: any)[currency]
		if type(value) ~= "number" or value ~= value or value < 0 then
			(data.wallet :: any)[currency] = 0
		end
	end
	if type(data.xp) ~= "number" or data.xp ~= data.xp or data.xp < 0 then
		data.xp = 0
	end
	-- Temporada corrompida: recomeça do zero (melhor do que travar a entrega das trilhas).
	local season = data.season :: any
	if
		type(season) ~= "table"
		or type(season.id) ~= "string"
		or type(season.xp) ~= "number"
		or season.xp ~= season.xp
		or season.xp == math.huge
		or season.xp < 0
		or type(season.free) ~= "table"
		or type(season.premium) ~= "table"
	then
		data.season = { id = "", xp = 0, free = {}, premium = {} }
	end
	-- v4: níveis e estoques nunca negativos/NaN; bônus e história com formato fixo.
	data.perks = numberMap(data.perks, 5)
	data.consumables = numberMap(data.consumables, 99)
	local loadout: { [string]: boolean } = {}
	if type(data.loadout) == "table" then
		for key, on in data.loadout :: { [any]: any } do
			if type(key) == "string" and on == true then
				loadout[key] = true
			end
		end
	end
	data.loadout = loadout
	local boosts = if type(data.boosts) == "table" then data.boosts :: any else {}
	data.boosts = { fichasUntil = finiteOr(boosts.fichasUntil, 0), xpUntil = finiteOr(boosts.xpUntil, 0) }
	local story = if type(data.story) == "table" then data.story :: any else {}
	data.story = { cleared = numberMap(story.cleared, 2 ^ 40), flawless = numberMap(story.flawless, 2 ^ 40) }
	data.schemaVersion = Config.Data.SchemaVersion
	return data
end

return PlayerDataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="450">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Trava de sessão dos dados do jogador (pura, testada no Lune).

	Só um servidor por vez escreve os dados de um jogador: ao carregar, o servidor grava
	`sessionLock = { job = JobId, at = os.time() }` (UpdateAsync). Outro servidor que encontrar a
	trava ainda válida espera e tenta de novo; depois de TTL sem renovação (servidor caiu) pode tomar.
	O autosave renova a trava; sair do jogo a libera. Isso evita que uma reconexão rápida faça
	um servidor antigo sobrescrever compras/progresso gravados pelo novo.
]]

export type Lock = { job: string, at: number }

local SessionLock = {}

-- Segundos sem renovação para considerar a trava abandonada (> 2 autosaves).
SessionLock.TTL = 300
-- Tentativas ao carregar antes de tomar a trava à força, e espera entre elas (s).
SessionLock.Attempts = 4
SessionLock.RetryDelay = 3

-- Este servidor pode assumir/escrever os dados?
function SessionLock.canTake(current: Lock?, job: string, now: number, ttl: number?): boolean
	if current == nil or type(current) ~= "table" then
		return true
	end
	if current.job == job then
		return true
	end
	local at = if type(current.at) == "number" then current.at else 0
	return now - at >= (ttl or SessionLock.TTL)
end

function SessionLock.make(job: string, now: number): Lock
	return { job = job, at = now }
end

return SessionLock
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="451">
        <Properties>
          <string name="Name">Game</string>
        </Properties>
        <Item class="ModuleScript" referent="452">
          <Properties>
            <string name="Name">BreakerPuzzle</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Puzzle dos disjuntores (puro, testado no Lune). Depois dos 3 fusíveis no quadro, os
	disjuntores precisam ser religados na ordem do diagrama (sorteada por rodada).
	Ordem certa: cada alavanca sobe e acende. Errou: todas caem (faísca + barulho no mundo).
]]

export type State = {
	order: { number },
	-- Quantos acertos seguidos (alavancas já levantadas, na ordem).
	progress: number,
	solved: boolean,
}

export type Result = "progress" | "solved" | "wrong" | "already"

local BreakerPuzzle = {}

function BreakerPuzzle.new(order: { number }): State
	assert(#order >= 1, "BreakerPuzzle.new: empty order")
	local seen = {}
	for _, index in order do
		assert(not seen[index], "BreakerPuzzle.new: repeated breaker")
		seen[index] = true
	end
	return { order = table.clone(order), progress = 0, solved = false }
end

-- Ordem aleatória de 1..count. `nextInteger(a, b)` é injetado (Random:NextInteger no jogo).
function BreakerPuzzle.shuffle(count: number, nextInteger: (number, number) -> number): { number }
	local order = {}
	for i = 1, count do
		order[i] = i
	end
	for i = count, 2, -1 do
		local j = nextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	return order
end

function BreakerPuzzle.isUp(state: State, index: number): boolean
	if state.solved then
		return true
	end
	for i = 1, state.progress do
		if state.order[i] == index then
			return true
		end
	end
	return false
end

function BreakerPuzzle.press(state: State, index: number): Result
	if state.solved or BreakerPuzzle.isUp(state, index) then
		return "already"
	end
	if state.order[state.progress + 1] == index then
		state.progress += 1
		if state.progress >= #state.order then
			state.solved = true
			return "solved"
		end
		return "progress"
	end
	state.progress = 0
	return "wrong"
end

-- Letras do diagrama (1 -> "A"...). Ex.: {2,3,1} -> "B - C - A".
function BreakerPuzzle.describe(order: { number }): string
	local letters = {}
	for _, index in order do
		table.insert(letters, string.char(64 + index))
	end
	return table.concat(letters, " - ")
end

return BreakerPuzzle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="453">
          <Properties>
            <string name="Name">Checkpoint</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Checkpoint de sessão (puro, testado no Lune). Gravado uma vez por rodada, quando a energia
	volta. Guarda o que é preciso para continuar dali: objetivos (fusíveis, chave, disjuntores),
	portas (aberta/fresta/fechada, trancas), carga da lanterna, itens já pegos e a ordem dos
	disjuntores. Nada é persistido: some ao "reiniciar tudo" ou ao sair do jogo.

	capture/restore sempre copiam: o snapshot nunca é alterado pelo jogo depois de gravado.
]]

local TableUtil = require("@game/ReplicatedStorage/Shared/Util/TableUtil")
local Objectives = require("./Objectives")

export type DoorState = "open" | "crack" | "closed"

export type Snapshot = {
	objectives: Objectives.State,
	doors: { [string]: DoorState },
	locked: { [string]: boolean },
	battery: number,
	breakerOrder: { number },
	-- Itens do mundo já pegos (pilhas, chave), por id.
	taken: { [string]: boolean },
}

local Checkpoint = {}

function Checkpoint.capture(input: Snapshot): Snapshot
	local copy = TableUtil.deepCopy(input)
	copy.battery = math.clamp(copy.battery, 0, 1)
	return copy
end

-- Cópia independente para aplicar no jogo (o snapshot continua intacto para outra tentativa).
function Checkpoint.restore(snapshot: Snapshot): Snapshot
	return TableUtil.deepCopy(snapshot)
end

-- Só vale continuar de um checkpoint que já tem a energia ligada.
function Checkpoint.isUsable(snapshot: Snapshot?): boolean
	return snapshot ~= nil and snapshot.objectives.powerOn and not snapshot.objectives.gateOpen
end

return Checkpoint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="454">
          <Properties>
            <string name="Name">CoinPlan</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Onde as moedas aparecem em cada capítulo (regra pura, testada no Lune).

	Dentro dos cômodos usamos pontos "seguros" no sistema local do cômodo (`out` = rumo à fachada):
	longe dos móveis encostados na fachada (out >= 9), da mesa do fundo e do esconderijo (11, 11).
	No corredor, uma fileira por andar; no quintal, pontos ao lado da trilha. Cada capítulo tem
	uma gema (vale mais) num cômodo sorteado.
]]

local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local SeededRandom = require("../Campaign/SeededRandom")

export type Coin = { id: string, x: number, y: number, z: number, gem: boolean }

local CoinPlan = {}

-- (out, z) relativos ao centro do cômodo; ver comentário acima.
CoinPlan.RoomSpots = {
	{ -13, 8 },
	{ -4, -6 },
	{ 5, 0 },
	{ -9, 13 },
	{ 9, -14 },
}

CoinPlan.HallSpots = { { -4, -26 }, { 4, -46 }, { -4, -66 } }
CoinPlan.Levels = { -16, 0, 16, 32 }
CoinPlan.Height = 2.2

local function roomPoint(room: House.Room, spot: { number }): (number, number)
	local side = if room.x < 0 then -1 else 1
	return room.x + side * spot[1], room.z + spot[2]
end

-- `perRoom` moedas por cômodo, `yard` no quintal. Determinístico por `seed`.
function CoinPlan.create(seed: number, perRoom: number, yard: number): { Coin }
	local rng = SeededRandom.new(seed)
	local coins: { Coin } = {}
	local rooms: { House.Room } = {}
	for _, room in House.Rooms do
		if room.id ~= "Exterior" and room.id ~= "Hall" then
			table.insert(rooms, room)
		end
	end
	local gemRoom = rng.integer(1, #rooms)
	for index, room in rooms do
		local order = rng.shuffle({ 1, 2, 3, 4, 5 })
		for n = 1, math.min(perRoom, #order) do
			local x, z = roomPoint(room, CoinPlan.RoomSpots[order[n]])
			table.insert(coins, {
				id = `coin_{room.id}_{n}`,
				x = x,
				y = room.y + CoinPlan.Height,
				z = z,
				gem = index == gemRoom and n == 1,
			})
		end
	end
	for _, level in CoinPlan.Levels do
		for n, spot in CoinPlan.HallSpots do
			table.insert(
				coins,
				{ id = `coin_hall_{level}_{n}`, x = spot[1], y = level + CoinPlan.Height, z = spot[2], gem = false }
			)
		end
	end
	for n = 1, yard do
		-- Dos dois lados da trilha, entre a varanda e a saída.
		local side = if n % 2 == 0 then -1 else 1
		table.insert(coins, {
			id = `coin_yard_{n}`,
			x = side * rng.integer(20, 60),
			y = CoinPlan.Height - 0.5,
			z = rng.integer(72, 124),
			gem = false,
		})
	end
	return coins
end

return CoinPlan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="455">
          <Properties>
            <string name="Name">CreatureBrain</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Cérebro do Vigia: máquina de estados pura (testada no Lune). Não move nada e não faz
	raycast — o CreatureService calcula a percepção e executa o comando devolvido.

	Modos:
	  Dormant     parado/escondido até ativar
	  Patrol      segue a rota de patrulha (o service escolhe o próximo nó)
	  Investigate vai até um ponto (barulho, último lugar visto, "faro")
	  Search      parado olhando em volta por SearchTime, depois volta a patrulhar
	  Chase       persegue o jogador
	  Capture     pegou o jogador (fim de rodada)

	Posições são opacas (o service usa Vector3; os testes usam tabelas).
]]

local Config = require("@game/ReplicatedStorage/Shared/Config")

export type Mode = "Dormant" | "Patrol" | "Investigate" | "Search" | "Chase" | "Capture"

export type Perception = {
	now: number,
	-- Linha de visão + alcance + campo de visão (o service já combinou tudo).
	canSee: boolean,
	-- Só linha de visão (sem considerar alcance/ângulo); usada para a captura.
	lineOfSight: boolean,
	distance: number?,
	targetPos: any?,
	noisePos: any?,
	-- Energia ligada: ele sempre sabe onde o jogador está.
	hunt: boolean,
	-- O service avisa quando chegou ao destino atual.
	arrived: boolean,
}

export type Command = {
	mode: Mode,
	target: any?,
	speed: number,
	-- Evento para efeitos/legendas: "spotted" | "lost" | "capture" | nil
	event: string?,
}

export type Brain = {
	mode: Mode,
	fuses: number,
	lastKnownPos: any?,
	lastSeenAt: number,
	investigatePos: any?,
	searchUntil: number,
}

local C = Config.Creature

local CreatureBrain = {}

function CreatureBrain.new(): Brain
	return {
		mode = "Dormant",
		fuses = 0,
		lastKnownPos = nil,
		lastSeenAt = -math.huge,
		investigatePos = nil,
		searchUntil = 0,
	}
end

function CreatureBrain.activate(brain: Brain)
	if brain.mode == "Dormant" then
		brain.mode = "Patrol"
	end
end

function CreatureBrain.speedFor(mode: Mode, fuses: number, hunt: boolean): number
	if mode == "Chase" then
		if hunt then
			return C.HuntSpeed
		end
		return C.ChaseSpeed + fuses * C.ChaseSpeedPerFuse
	elseif mode == "Investigate" then
		return C.InvestigateSpeed
	elseif mode == "Patrol" then
		return C.PatrolSpeed + fuses * C.PatrolSpeedPerFuse
	end
	return 0
end

local function command(brain: Brain, target: any?, hunt: boolean, event: string?): Command
	return {
		mode = brain.mode,
		target = target,
		speed = CreatureBrain.speedFor(brain.mode, brain.fuses, hunt),
		event = event,
	}
end

function CreatureBrain.step(brain: Brain, p: Perception): Command
	if brain.mode == "Dormant" or brain.mode == "Capture" then
		return command(brain, nil, p.hunt, nil)
	end

	-- Captura: perto o bastante e sem parede no meio.
	if p.distance and p.distance <= C.CaptureRange and p.lineOfSight then
		brain.mode = "Capture"
		return command(brain, nil, p.hunt, "capture")
	end

	-- Viu (ou a energia voltou e ele caça): persegue.
	if (p.canSee or p.hunt) and p.targetPos ~= nil then
		local event = if brain.mode ~= "Chase" and p.canSee then "spotted" else nil
		brain.mode = "Chase"
		brain.lastKnownPos = p.targetPos
		brain.lastSeenAt = p.now
		return command(brain, p.targetPos, p.hunt, event)
	end

	if brain.mode == "Chase" then
		local unseen = p.now - brain.lastSeenAt
		if unseen <= C.GraceTime and p.targetPos ~= nil then
			-- "Intuição" curta: ainda segue o jogador logo após virar uma esquina.
			return command(brain, brain.lastKnownPos, p.hunt, nil)
		end
		if unseen <= C.LoseSightTime and not p.arrived then
			return command(brain, brain.lastKnownPos, p.hunt, nil)
		end
		brain.mode = "Search"
		brain.searchUntil = p.now + C.SearchTime
		return command(brain, nil, p.hunt, "lost")
	end

	-- Barulho interrompe patrulha/procura (não a perseguição, tratada acima).
	if p.noisePos ~= nil then
		brain.mode = "Investigate"
		brain.investigatePos = p.noisePos
		return command(brain, p.noisePos, p.hunt, nil)
	end

	if brain.mode == "Investigate" then
		if p.arrived then
			brain.mode = "Search"
			brain.searchUntil = p.now + C.SearchTime
			return command(brain, nil, p.hunt, nil)
		end
		return command(brain, brain.investigatePos, p.hunt, nil)
	end

	if brain.mode == "Search" then
		if p.now >= brain.searchUntil then
			brain.mode = "Patrol"
		end
		return command(brain, nil, p.hunt, nil)
	end

	-- Patrol: o service escolhe o próximo nó da rota.
	return command(brain, nil, p.hunt, nil)
end

return CreatureBrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="456">
          <Properties>
            <string name="Name">EconomyEvents</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras do analytics de economia (testadas no Lune): transformam o que as regras de
	Shared/Game/Economy concederam ou cobraram em eventos de fonte/sumidouro, no formato de
	AnalyticsService:LogEconomyEvent. Quem envia é o TelemetryService (só em servidor publicado).

	- Valores sempre positivos (o painel mostra sumidouros como negativos).
	- `balance` = saldo DEPOIS do evento; vários eventos da mesma concessão terminam, em ordem,
	  no saldo atual da carteira.
	- Uma concessão é quebrada em: parte base (o contexto: partida, diário, compra...), níveis
	  da conta ("level_up") e itens repetidos convertidos em Fichas ("duplicate_refund").
	- SKUs e tipos de transação têm poucos valores fixos: o painel agrupa melhor e não estoura
	  os limites de cardinalidade.
]]

local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")

export type Flow = "Source" | "Sink"

export type Event = {
	flow: Flow,
	currency: StoreCatalog.Currency,
	amount: number,
	balance: number,
	transaction: string,
	sku: string,
}

type Part = { transaction: string, sku: string, fichas: number, creditos: number }
type Entry = { flow: Flow, currency: StoreCatalog.Currency, amount: number, transaction: string, sku: string }

local EconomyEvents = {}

-- Nome da moeda no painel (no máximo 5 moedas por experiência).
EconomyEvents.CurrencyNames = table.freeze({ fichas = "Fichas", creditos = "Creditos" })

-- Tipos de transação: os nomes de Enum.AnalyticsEconomyTransactionType, mais um próprio.
EconomyEvents.Transaction = table.freeze({
	IAP = "IAP",
	Shop = "Shop",
	Gameplay = "Gameplay",
	TimedReward = "TimedReward",
	ContextualPurchase = "ContextualPurchase",
	Season = "SeasonPass",
})

EconomyEvents.LEVEL_SKU = "level_up"
EconomyEvents.REFUND_SKU = "duplicate_refund"

-- Fichas e Créditos que os níveis da conta deram dentro de `granted` (curva + marcos).
local function levelPart(granted: Economy.Granted): (number, number)
	local fichas, creditos = 0, 0
	for _, level in granted.levels do
		fichas += StoreCatalog.LevelFichasBase + StoreCatalog.LevelFichasStep * level
		local milestone = StoreCatalog.LevelMilestones[level]
		if milestone then
			fichas += milestone.fichas or 0
			creditos += milestone.creditos or 0
		end
	end
	return fichas, creditos
end

local function refundPart(granted: Economy.Granted): number
	local total = 0
	for _, fichas in granted.refunds do
		total += fichas
	end
	return total
end

-- Eventos em ordem; o saldo de cada moeda termina em `wallet` no último evento dela.
local function withBalances(entries: { Entry }, wallet: { fichas: number, creditos: number }): { Event }
	local running: { [string]: number } = {}
	for _, currency in StoreCatalog.CURRENCIES do
		local delta = 0
		for _, entry in entries do
			if entry.currency == currency then
				delta += if entry.flow == "Source" then entry.amount else -entry.amount
			end
		end
		running[currency] = (wallet :: any)[currency] - delta
	end
	local events: { Event } = {}
	for _, entry in entries do
		local balance = running[entry.currency] + (if entry.flow == "Source" then entry.amount else -entry.amount)
		running[entry.currency] = balance
		table.insert(events, {
			flow = entry.flow,
			currency = entry.currency,
			amount = entry.amount,
			balance = math.max(0, balance),
			transaction = entry.transaction,
			sku = entry.sku,
		})
	end
	return events
end

export type Spend = { currency: StoreCatalog.Currency, amount: number }

-- Uma parte de uma transação: gasto (opcional) e/ou concessão (opcional), com seu tipo e SKU.
export type Change = {
	transaction: string,
	sku: string,
	spend: Spend?,
	granted: Economy.Granted?,
}

local function addChange(entries: { Entry }, change: Change)
	local spend = change.spend
	if spend and spend.amount > 0 then
		table.insert(entries, {
			flow = "Sink",
			currency = spend.currency,
			amount = spend.amount,
			transaction = change.transaction,
			sku = change.sku,
		})
	end
	local granted = change.granted
	if not granted then
		return
	end
	local levelFichas, levelCreditos = levelPart(granted)
	local refunds = refundPart(granted)
	local parts: { Part } = {
		{
			transaction = change.transaction,
			sku = change.sku,
			fichas = math.max(0, granted.fichas - levelFichas - refunds),
			creditos = math.max(0, granted.creditos - levelCreditos),
		},
		{
			transaction = EconomyEvents.Transaction.Gameplay,
			sku = EconomyEvents.LEVEL_SKU,
			fichas = levelFichas,
			creditos = levelCreditos,
		},
		{ transaction = change.transaction, sku = EconomyEvents.REFUND_SKU, fichas = refunds, creditos = 0 },
	}
	for _, part in parts do
		for _, currency in StoreCatalog.CURRENCIES do
			local amount = (part :: any)[currency] :: number
			if amount > 0 then
				table.insert(entries, {
					flow = "Source",
					currency = currency :: StoreCatalog.Currency,
					amount = amount,
					transaction = part.transaction,
					sku = part.sku,
				})
			end
		end
	end
end

--[[
	Eventos de UMA transação, na ordem das partes (em cada parte: gasto antes das fontes).
	`wallet` = carteira DEPOIS de tudo. Ex.: partida + trilhas da temporada no mesmo fim de rodada,
	ou o preço do baú + o reembolso do item repetido.
]]
function EconomyEvents.build(wallet: { fichas: number, creditos: number }, changes: { Change }): { Event }
	local entries: { Entry } = {}
	for _, change in changes do
		addChange(entries, change)
	end
	return withBalances(entries, wallet)
end

-- Atalhos: só fontes / só gasto.
function EconomyEvents.sources(
	granted: Economy.Granted,
	wallet: { fichas: number, creditos: number },
	transaction: string,
	sku: string
): { Event }
	return EconomyEvents.build(wallet, { { transaction = transaction, sku = sku, granted = granted } })
end

function EconomyEvents.sink(
	currency: StoreCatalog.Currency,
	amount: number,
	wallet: { fichas: number, creditos: number },
	transaction: string,
	sku: string
): { Event }
	return EconomyEvents.build(
		wallet,
		{ { transaction = transaction, sku = sku, spend = { currency = currency, amount = amount } } }
	)
end

return EconomyEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="457">
          <Properties>
            <string name="Name">HideRules</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras dos esconderijos (armários). Testadas no Lune.

	Esconder-se é uma fuga de verdade: se o Vigia NÃO te viu entrar, ele perde o rastro, vai
	até onde te viu por último e procura. Ele te acha se:
	  - viu você entrar (perseguição com visão recente) e chega ao armário; ou
	  - fica perto do armário por NoticeTime sem você prender a respiração (ele ouve).
]]

local Config = require("@game/ReplicatedStorage/Shared/Config")

export type EnterContext = {
	playing: boolean,
	alive: boolean,
	occupied: boolean,
	alreadyHidden: boolean,
	-- Segundos desde que saiu de um esconderijo (math.huge se nunca).
	sinceExit: number,
}

export type FoundContext = {
	sawEntry: boolean,
	creatureActive: boolean,
	-- Distância do Vigia ao armário.
	distance: number,
	holdingBreath: boolean,
	-- Tempo contínuo (s) que o Vigia está dentro de NoticeRange com você respirando.
	exposedTime: number,
	captureRange: number,
}

local H = Config.Hide

local HideRules = {}

function HideRules.canEnter(ctx: EnterContext): (boolean, string?)
	if not ctx.playing then
		return false, "not_playing"
	end
	if not ctx.alive then
		return false, "dead"
	end
	if ctx.alreadyHidden then
		return false, "not_available"
	end
	if ctx.occupied then
		return false, "hide_occupied"
	end
	if ctx.sinceExit < H.ExitCooldown then
		return false, "not_available"
	end
	return true, nil
end

-- Viu entrar? `sinceSeen` = segundos desde a última vez que o Vigia te enxergou.
function HideRules.sawEntry(sinceSeen: number, chasing: boolean): boolean
	return chasing and sinceSeen <= H.SawEntryWindow
end

-- Acumula o tempo de exposição (Vigia perto e você respirando). Zera quando ele se afasta.
function HideRules.exposure(previous: number, distance: number, holdingBreath: boolean, dt: number): number
	if distance > H.NoticeRange then
		return 0
	end
	if holdingBreath then
		return previous
	end
	return previous + dt
end

function HideRules.found(ctx: FoundContext): boolean
	if not ctx.creatureActive then
		return false
	end
	if ctx.sawEntry and ctx.distance <= ctx.captureRange + 1.5 then
		return true
	end
	return ctx.distance <= H.NoticeRange and not ctx.holdingBreath and ctx.exposedTime >= H.NoticeTime
end

return HideRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="458">
          <Properties>
            <string name="Name">Objectives</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras do objetivo. Sem APIs do Roblox: o RoundService chama estas funções e aplica o
	resultado no mundo. Testado no Lune.

	Fluxo: coletar fusíveis (cada um uma vez) -> inserir no quadro os que estão na mão ->
	religar os disjuntores na ordem do diagrama -> a energia volta -> com energia o portão abre.
	Paralelo (atalho): pegar a chave e destrancar a porta trancada.
]]

export type State = {
	total: number,
	collected: { [string]: boolean },
	held: number,
	inserted: number,
	breakersOn: boolean,
	powerOn: boolean,
	gateOpen: boolean,
	enteredBuilding: boolean,
	hasKey: boolean,
	keyTaken: boolean,
	unlocked: { [string]: boolean },
}

export type ObjectiveKey = "enter" | "fuses" | "insert" | "breakers" | "escape" | "run"

local Objectives = {}

function Objectives.new(total: number): State
	assert(total >= 1, "Objectives.new: total must be >= 1")
	return {
		total = total,
		collected = {},
		held = 0,
		inserted = 0,
		breakersOn = false,
		powerOn = false,
		gateOpen = false,
		enteredBuilding = false,
		hasKey = false,
		keyTaken = false,
		unlocked = {},
	}
end

function Objectives.collectedCount(state: State): number
	local count = 0
	for _ in state.collected do
		count += 1
	end
	return count
end

-- Pega um fusível. Falha se já foi pego ou se já há fusíveis demais.
function Objectives.collect(state: State, fuseId: string): (boolean, string?)
	if state.collected[fuseId] then
		return false, "not_available"
	end
	if Objectives.collectedCount(state) >= state.total then
		return false, "not_available"
	end
	state.collected[fuseId] = true
	state.held += 1
	return true, nil
end

-- Insere no quadro todos os fusíveis na mão. Retorna quantos foram inseridos.
function Objectives.insert(state: State): (number, string?)
	if state.powerOn or state.inserted >= state.total then
		return 0, "already_powered"
	end
	if state.held <= 0 then
		return 0, "no_fuses"
	end
	local amount = math.min(state.held, state.total - state.inserted)
	state.held -= amount
	state.inserted += amount
	return amount, nil
end

function Objectives.isPanelComplete(state: State): boolean
	return state.inserted >= state.total
end

-- Os disjuntores só respondem com os fusíveis todos no quadro.
function Objectives.canUseBreakers(state: State): (boolean, string?)
	if state.breakersOn or state.powerOn then
		return false, "already_powered"
	end
	if not Objectives.isPanelComplete(state) then
		return false, "need_fuses"
	end
	return true, nil
end

function Objectives.solveBreakers(state: State): boolean
	if not Objectives.canUseBreakers(state) then
		return false
	end
	state.breakersOn = true
	return true
end

function Objectives.powerOn(state: State): boolean
	if not Objectives.isPanelComplete(state) or not state.breakersOn or state.powerOn then
		return false
	end
	state.powerOn = true
	return true
end

function Objectives.openGate(state: State): (boolean, string?)
	if not state.powerOn then
		return false, "no_power"
	end
	if state.gateOpen then
		return false, "already_open"
	end
	state.gateOpen = true
	return true, nil
end

function Objectives.canWin(state: State): boolean
	return state.powerOn and state.gateOpen
end

function Objectives.takeKey(state: State): (boolean, string?)
	if state.keyTaken then
		return false, "not_available"
	end
	state.keyTaken = true
	state.hasKey = true
	return true, nil
end

-- Usa a chave numa porta trancada. A chave fica na fechadura (só abre uma porta).
function Objectives.useKey(state: State, doorId: string): (boolean, string?)
	if state.unlocked[doorId] then
		return false, "already_unlocked"
	end
	if not state.hasKey then
		return false, "door_locked"
	end
	state.hasKey = false
	state.unlocked[doorId] = true
	return true, nil
end

function Objectives.objectiveKey(state: State): ObjectiveKey
	if state.gateOpen then
		return "run"
	end
	if state.powerOn then
		return "escape"
	end
	if not state.enteredBuilding then
		return "enter"
	end
	if Objectives.isPanelComplete(state) then
		return "breakers"
	end
	if Objectives.collectedCount(state) >= state.total then
		return "insert"
	end
	return "fuses"
end

return Objectives
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="459">
          <Properties>
            <string name="Name">Oxygen</string>
            <string name="Source"><![CDATA[--!strict
-- Oxigênio independente de fôlego/bateria; relógio e consumo simulados só pelo servidor.
export type State = { value: number, holding: boolean, readyAt: number, held: number, dead: boolean }
local Oxygen = {}
function Oxygen.new(): State
	return { value = 100, holding = false, readyAt = 0, held = 0, dead = false }
end
function Oxygen.request(state: State, hold: boolean, now: number): boolean
	if not hold then
		if state.holding then
			state.readyAt = now + 2
		end
		state.holding, state.held = false, 0
		return true
	end
	if state.dead or state.value < 35 or now < state.readyAt then
		return false
	end
	state.holding = true
	return true
end
function Oxygen.step(state: State, dt: number, now: number): boolean
	if state.dead then
		return false
	end
	if state.holding then
		state.held += dt
		state.value = math.max(0, state.value - 12.5 * dt)
		if state.value <= 0 or state.held >= 8 then
			state.dead, state.holding, state.value = true, false, 0
			return true
		end
	elseif now >= state.readyAt then
		state.value = math.min(100, state.value + 20 * dt)
	end
	return false
end
return Oxygen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="460">
          <Properties>
            <string name="Name">PlayerRules</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras do corpo do jogador (testadas no Lune), aplicadas pelo PlayerStateService:
	- velocidade máxima aceita por postura e checagem com tolerância e carência (anti speed hack
	  sem punir lag ou empurrão);
	- segurar a respiração (só escondido): duração máxima, arquejo forçado e recarga.
]]

local Config = require("@game/ReplicatedStorage/Shared/Config")

export type Stance = "Stand" | "Crouch"

export type SpeedCheck = {
	overSince: number?,
}

export type SpeedVerdict = "ok" | "over" | "correct"

export type Breath = {
	holding: boolean,
	since: number,
	cooldownUntil: number,
}

local P = Config.Player

local PlayerRules = {}

-- Velocidade horizontal máxima permitida (sem tolerância) para a postura.
function PlayerRules.maxSpeed(stance: Stance): number
	if stance == "Crouch" then
		return P.CrouchSpeed
	end
	return P.SprintSpeed
end

-- WalkSpeed inicial que o servidor aplica ao trocar de postura.
function PlayerRules.walkSpeed(stance: Stance): number
	if stance == "Crouch" then
		return P.CrouchSpeed
	end
	return P.WalkSpeed
end

function PlayerRules.newSpeedCheck(): SpeedCheck
	return { overSince = nil }
end

--[[
	`speed` = velocidade horizontal medida no servidor; `allowed` = limite da postura.
	"over" enquanto passa do limite dentro da carência; "correct" quando passou tempo demais
	(o service devolve o jogador à última posição válida). Depois de "correct" a contagem zera.
]]
function PlayerRules.checkSpeed(check: SpeedCheck, speed: number, allowed: number, now: number): SpeedVerdict
	if speed ~= speed or speed <= allowed * P.SpeedTolerance then
		check.overSince = nil
		return "ok"
	end
	local since = check.overSince
	if since == nil then
		check.overSince = now
		return "over"
	end
	if now - since >= P.SpeedGrace then
		check.overSince = nil
		return "correct"
	end
	return "over"
end

function PlayerRules.newBreath(): Breath
	return { holding = false, since = 0, cooldownUntil = 0 }
end

-- Começa a prender a respiração. Recusa durante a recarga.
function PlayerRules.holdBreath(breath: Breath, now: number): boolean
	if breath.holding or now < breath.cooldownUntil then
		return false
	end
	breath.holding = true
	breath.since = now
	return true
end

-- Solta a respiração voluntariamente (sem arquejo).
function PlayerRules.releaseBreath(breath: Breath, now: number)
	if breath.holding then
		breath.holding = false
		breath.cooldownUntil = now + P.HoldBreathCooldown * 0.5
	end
end

-- Avança o relógio. Retorna "gasp" quando o fôlego acabou (solta à força, faz barulho).
function PlayerRules.stepBreath(breath: Breath, now: number): "gasp"?
	if breath.holding and now - breath.since >= P.HoldBreathMax then
		breath.holding = false
		breath.cooldownUntil = now + P.HoldBreathCooldown
		return "gasp"
	end
	return nil
end

return PlayerRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="461">
          <Properties>
            <string name="Name">RoundRules</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras da rodada: transições de fase e validação de interação.
	O servidor nunca confia no cliente: toda interação passa por validateInteraction.
	Testado no Lune.
]]

export type Phase = "Loading" | "Intro" | "Playing" | "Won" | "Lost"

export type InteractionContext = {
	phase: Phase,
	exists: boolean,
	enabled: boolean,
	alive: boolean,
	distance: number,
	maxDistance: number,
	tolerance: number,
	lineOfSight: boolean,
}

local TRANSITIONS: { [Phase]: { [Phase]: boolean } } = {
	Loading = { Intro = true },
	Intro = { Playing = true },
	Playing = { Won = true, Lost = true },
	Won = { Intro = true },
	Lost = { Intro = true },
}

local RoundRules = {}

function RoundRules.canTransition(from: Phase, to: Phase): boolean
	local allowed = TRANSITIONS[from]
	return allowed ~= nil and allowed[to] == true
end

function RoundRules.canRestart(phase: Phase): boolean
	return phase == "Won" or phase == "Lost"
end

-- Ordem importa: a primeira regra violada define o motivo devolvido ao cliente.
function RoundRules.validateInteraction(ctx: InteractionContext): (boolean, string?)
	if ctx.phase ~= "Playing" then
		return false, "not_playing"
	end
	if not ctx.alive then
		return false, "dead"
	end
	if not ctx.exists then
		return false, "unknown"
	end
	if not ctx.enabled then
		return false, "not_available"
	end
	if ctx.distance ~= ctx.distance or ctx.distance > ctx.maxDistance + ctx.tolerance then
		return false, "too_far"
	end
	if not ctx.lineOfSight then
		return false, "blocked"
	end
	return true, nil
end

-- Formata segundos como MM:SS para as telas finais.
function RoundRules.formatTime(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", total // 60, total % 60)
end

return RoundRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="462">
          <Properties>
            <string name="Name">StoreFunnel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Funil da loja (regras puras, testadas no Lune): abrir loja -> ver oferta -> comprar.
	Funil recorrente da Roblox: cada abertura da loja é uma sessão (funnelSessionId = GUID).

	- 1 OpenStore: o cliente abriu a loja (nova sessão a cada abertura).
	- 2 ViewOffer: o jogador ESCOLHEU olhar uma oferta (aba ou categoria com algo à venda, ou as
	  chances de um baú). A aba que já abre na tela não conta: assim o passo 2 mede interesse.
	- 3 Purchase: uma compra deu certo nesta sessão (Fichas, Créditos ou Robux).
	Cada passo é registrado no máximo uma vez por sessão (repetidos só gastariam o limite de
	eventos). Sem sessão aberta (ex.: recibo depois de sair do jogo), o funil não registra nada.
]]

export type State = { session: string?, step: number }

export type Step = {
	step: number,
	name: string,
	-- Até 3 campos personalizados (CustomField01..03), já como texto.
	fields: { string },
}

local StoreFunnel = {}

StoreFunnel.NAME = "Store"
StoreFunnel.STEP_NAMES = table.freeze({ "OpenStore", "ViewOffer", "Purchase" })

-- Ofertas que contam como "ver item" (abas com algo à venda e categorias da loja).
StoreFunnel.OFFERS = table.freeze({
	shop = true,
	season = true,
	chests = true,
	robux = true,
	odds = true,
	flashlight = true,
	uniform = true,
	filter = true,
	title = true,
} :: { [string]: boolean })

function StoreFunnel.new(): State
	return { session = nil, step = 0 }
end

local function advance(state: State, step: number, fields: { string }): { Step }
	if not state.session or state.step >= step then
		return {}
	end
	state.step = step
	return { { step = step, name = StoreFunnel.STEP_NAMES[step], fields = fields } }
end

-- Abriu a loja: começa uma sessão nova com `sessionId`.
function StoreFunnel.open(state: State, sessionId: string): { Step }
	state.session = sessionId
	state.step = 0
	return advance(state, 1, {})
end

function StoreFunnel.view(state: State, offer: string): { Step }
	if not StoreFunnel.OFFERS[offer] then
		return {}
	end
	return advance(state, 2, { `Offer - {offer}` })
end

-- `kind` = item | chest | product | pass; `currency` = fichas | creditos | robux.
function StoreFunnel.purchase(state: State, kind: string, currency: string): { Step }
	return advance(state, 3, { `Kind - {kind}`, `Currency - {currency}` })
end

return StoreFunnel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="463">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">1</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Ponto de entrada ÚNICO do servidor. Não crie outros Scripts de servidor:
	adicione um Service em ./Services e registre-o na lista abaixo.
]]

local Loader = require("@game/ReplicatedStorage/Shared/Loader")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")

local log = Logger.new("Server")

-- Todos os remotes existem antes de qualquer Service rodar.
Remotes.setupServer()

-- A ordem importa: Init e Start são chamados exatamente nesta ordem.
-- { any }: cada Service tem campos próprios; o Loader valida Name/Init/Start em runtime.
local services: { any } = {
	require("./Services/PlayerDataService"),
	require("./Services/TelemetryService"),
	require("./Services/StoreService"),
	require("./Services/WorldService"),
	require("./Services/PlayerStateService"),
	require("./Services/PresenceService"),
	require("./Services/LobbyService"),
	require("./Services/CreatureService"),
	require("./Services/PropService"),
	require("./Services/CosmeticService"),
	require("./Services/CollectibleService"),
	require("./Services/RoundService"),
	require("./Services/RewardService"),
	require("./Services/PerkService"),
	require("./Services/CoinService"),
	require("./Services/DebugService"), -- só age no Studio
}

-- O runtime coop reutiliza o estado corporal por jogador quando o polish está presente.
local roundRuntime: any = require("./Services/RoundService")
if type(roundRuntime.setPlayerAdapter) == "function" then
	for _, service in services do
		if service.Name == "PlayerStateService" then
			roundRuntime.setPlayerAdapter(service)
		end
	end
end

local count = Loader.boot(services, { label = "Server" })
log.info("boot OK (%d services)", count)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="464">
        <Properties>
          <string name="Name">Net</string>
        </Properties>
        <Item class="ModuleScript" referent="465">
          <Properties>
            <string name="Name">ServerNet</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Único jeito de tratar remotes no servidor. Cada handler ganha:
	  1. rate limit por jogador (token bucket),
	  2. validação de TODOS os argumentos (Guard) — argumentos a mais são rejeitados,
	  3. pcall no handler: erro interno não vaza para o cliente.

	RemoteFunction responde sempre com Types.Result:
		{ ok = true, data = ... }  ou  { ok = false, error = "rate_limited" | "invalid_arguments" | "internal_error" }

	O servidor é autoritativo: o handler decide tudo; o cliente só pede.
]]

local Players = game:GetService("Players")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local RateLimiter = require("@game/ReplicatedStorage/Shared/Net/RateLimiter")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Types = require("@game/ReplicatedStorage/Shared/Types")

export type HandlerOptions = {
	-- Um validador por argumento, na ordem. Lista vazia = o remote não aceita argumentos.
	args: { Guard.Validator },
	-- Padrão: Config.Net.DefaultRateLimit.
	rateLimit: { capacity: number, refillPerSecond: number }?,
}

local log = Logger.new("ServerNet")
local limiters: { RateLimiter.RateLimiter } = {}
local registered: { [string]: boolean } = {}

Players.PlayerRemoving:Connect(function(player: Player)
	for _, limiter in limiters do
		limiter.reset(player.UserId)
	end
end)

local function prepare(name: string, options: HandlerOptions)
	if registered[name] then
		error(`[ServerNet] handler for "{name}" already registered`, 3)
	end
	registered[name] = true
	local rate = options.rateLimit or Config.Net.DefaultRateLimit
	local limiter = RateLimiter.new({ capacity = rate.capacity, refillPerSecond = rate.refillPerSecond })
	table.insert(limiters, limiter)
	return limiter, Guard.args(options.args)
end

local ServerNet = {}

-- Adaptadores de modo podem oferecer fallback sem registrar o mesmo handler duas vezes.
function ServerNet.isRegistered(name: string): boolean
	return registered[name] == true
end

-- RemoteFunction (cliente -> servidor com resposta).
function ServerNet.onInvoke<T>(name: string, options: HandlerOptions, handler: (player: Player, ...any) -> T)
	local remote = Remotes.serverFunction(name)
	local limiter, validate = prepare(name, options)

	remote.OnServerInvoke = function(player: Player, ...: any): Types.Result<T>
		if not limiter.allow(player.UserId) then
			log.debug("%s rate limited for %s", name, player.Name)
			return { ok = false, error = "rate_limited" }
		end
		local valid, reason = validate(table.pack(...))
		if not valid then
			log.warn("rejected %s from %s: %s", name, player.Name, reason or "?")
			return { ok = false, error = "invalid_arguments" }
		end
		local success, result = pcall(handler, player, ...)
		if not success then
			log.error("handler %s failed for %s: %s", name, player.Name, tostring(result))
			return { ok = false, error = "internal_error" }
		end
		return { ok = true, data = result }
	end
end

-- RemoteEvent (cliente -> servidor, sem resposta). Chamadas inválidas são descartadas.
function ServerNet.onEvent(name: string, options: HandlerOptions, handler: (player: Player, ...any) -> ())
	local remote = Remotes.serverEvent(name)
	local limiter, validate = prepare(name, options)

	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		if not limiter.allow(player.UserId) then
			log.debug("%s rate limited for %s", name, player.Name)
			return
		end
		local valid, reason = validate(table.pack(...))
		if not valid then
			log.warn("rejected %s from %s: %s", name, player.Name, reason or "?")
			return
		end
		local success, err = pcall(handler :: (Player, ...any) -> any, player, ...)
		if not success then
			log.error("handler %s failed for %s: %s", name, player.Name, tostring(err))
		end
	end)
end

return ServerNet
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="466">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="467">
          <Properties>
            <string name="Name">CoinService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Moedas da casa: a cada capítulo (Seed + Stage da campanha) o servidor espalha moedas douradas
	e uma gema roxa (CoinPlan). Quem passa perto pega: Fichas + XP na hora (StoreService.awardCoin).
	O servidor decide a coleta pela posição do personagem; o cliente só anima (CoinController).

	Efeito no cliente via atributos do jogador: CoinPickupSerial (contador), CoinPickupValue, CoinPickupAt.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local CoinPlan = require("../Game/CoinPlan")
local StoreService = require("./StoreService")

local log = Logger.new("CoinService")
local C = Config.Coins

local CoinService = {
	Name = "CoinService",
	Tag = "HouseCoin",
}

local folder: Folder? = nil
local live: { [BasePart]: boolean } = {}
local currentKey = ""
local collected = 0

local function clear()
	for coin in live do
		coin:Destroy()
	end
	table.clear(live)
end

local function makeCoin(parent: Instance, spec: CoinPlan.Coin): BasePart
	local part = Instance.new("Part")
	part.Name = spec.id
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Metal
	if spec.gem then
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(1.8, 1.8, 1.8)
		part.Color = Color3.fromRGB(200, 110, 255)
		local light = Instance.new("PointLight")
		light.Color = part.Color
		light.Range = 12
		light.Brightness = 0.35
		light.Parent = part
	else
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(0.35, 2, 2)
		part.Color = Color3.fromRGB(255, 200, 40)
	end
	-- Cilindro em pé: o eixo X do Roblox vira o eixo da moeda; gira no Y para "olhar" pros lados.
	part.CFrame = CFrame.new(spec.x, spec.y, spec.z) * CFrame.Angles(0, 0, 0)
	part:SetAttribute("Value", if spec.gem then C.GemValue else C.Value)
	part:SetAttribute("Xp", if spec.gem then C.GemXp else C.Xp)
	part:SetAttribute("Gem", spec.gem)
	CollectionService:AddTag(part, CoinService.Tag)
	part.Parent = parent
	return part
end

local function spawnCoins(seed: number, stage: number)
	clear()
	local parent = folder
	if not parent then
		return
	end
	local plan = CoinPlan.create(seed + stage * 104729, C.PerRoom, C.YardCoins)
	for _, spec in plan do
		live[makeCoin(parent, spec)] = true
	end
	log.info("spawned %d coins (stage %d)", #plan, stage)
end

local function collect(player: Player, coin: BasePart)
	if not live[coin] then
		return
	end
	live[coin] = nil
	local value = (coin:GetAttribute("Value") :: number?) or C.Value
	local xp = (coin:GetAttribute("Xp") :: number?) or C.Xp
	local position = coin.Position
	local gem = coin:GetAttribute("Gem") == true
	coin:Destroy()
	collected += 1
	player:SetAttribute("CoinPickupValue", value)
	player:SetAttribute("CoinPickupAt", position)
	player:SetAttribute("CoinPickupGem", gem)
	player:SetAttribute("CoinPickupSerial", ((player:GetAttribute("CoinPickupSerial") :: number?) or 0) + 1)
	task.spawn(StoreService.awardCoin, player, value, xp)
end

local function tick()
	if next(live) == nil then
		return
	end
	local radius = C.PickupRadius
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("CampaignStatus") ~= "Active" then
			continue
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
			continue
		end
		local position = root.Position
		for coin in live do
			local offset = coin.Position - position
			if math.abs(offset.Y) < 5 and Vector3.new(offset.X, 0, offset.Z).Magnitude < radius then
				collect(player, coin)
			end
		end
	end
end

function CoinService.Start()
	if not C.Enabled or not Config.House.Enabled then
		return
	end
	local container = Instance.new("Folder")
	container.Name = "HouseCoins"
	container.Parent = workspace
	folder = container
	task.spawn(function()
		local state = ReplicatedStorage:WaitForChild("CampaignState", 60)
		if not state then
			log.warn("no CampaignState; coins disabled")
			return
		end
		local function refresh()
			local phase = state:GetAttribute("Phase")
			local seed = (state:GetAttribute("Seed") :: number?) or 0
			local stage = (state:GetAttribute("Stage") :: number?) or 0
			if phase == "Lobby" or stage <= 0 then
				currentKey = ""
				clear()
				return
			end
			local key = `{seed}:{stage}`
			if phase == "Playing" and key ~= currentKey then
				currentKey = key
				spawnCoins(seed, stage)
			end
		end
		for _, name in { "Phase", "Seed", "Stage" } do
			state:GetAttributeChangedSignal(name):Connect(refresh)
		end
		refresh()
	end)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.1 then
			elapsed = 0
			tick()
		end
	end)
end

-- Moedas ainda no mapa e total pego desde o início do servidor (testes e depuração).
function CoinService.status(): (number, number)
	local count = 0
	for _ in live do
		count += 1
	end
	return count, collected
end

return CoinService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="468">
          <Properties>
            <string name="Name">CollectibleService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CollectibleService: fitas VHS colecionáveis (12, em Shared/Game/StoreCatalog.Tapes).

	- Uma fita aparece a cada partida (no solo) ou a cada estágio (campanha), num ponto sorteado
	  longe dos jogadores. O ponto é achado por raycast de cima para baixo: a fita fica sobre o
	  que houver ali (piso, mesa, caixote), sem depender da posição exata dos móveis.
	- Escolhe a fita que MENOS jogadores presentes têm (empate: sorteio). Todos já têm todas: não aparece.
	- Quem pega (mire + E, id "tape") dá a fita para a EQUIPE inteira: cooperação, não disputa.
	  Cada membro ganha também XP de temporada; Fichas/XP e o analytics vêm de StoreService.awardTape.
	  Os runtimes da rodada encaminham o id "tape" para CollectibleService.collect.
	- Validação no servidor: fase Playing, membro ativo, vivo, distância e linha de visão.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Types = require("@game/ReplicatedStorage/Shared/Types")
local StoreService = require("./StoreService")

local log = Logger.new("CollectibleService")
local TAPE_ID = "tape"
local REACH = 7
local MIN_PLAYER_DISTANCE = 24

-- Pontos candidatos (x, z) no meio das salas, longe das paredes (a altura vem do raycast).
local SPOTS: { { number } } = {
	{ 1.5, -8.5 }, -- recepção
	{ -16, -12 }, -- escritório
	{ -33, -19.5 }, -- corredor
	{ 38, -11 }, -- bombas
	{ -10, -32 }, -- gerador
	{ 12, -42 }, -- depósito
	{ -60, -10 }, -- oficina
	{ -50, -40 }, -- oficina (fundo)
	{ -60, -70 }, -- galeria de cabos
	{ -30, -60 }, -- sala de controle
	{ -6, -70 }, -- sala de controle (fundo)
	{ 14, -60 }, -- arquivo técnico
	{ 32, -72 }, -- arquivo técnico (fundo)
	{ 60, -40 }, -- pátio de transformadores
}

local current: BasePart? = nil
local currentTape: string? = nil
local spawnedFor = ""
local rng = Random.new()

local function clear()
	local model = if current then current.Parent else nil
	if model then
		model:Destroy()
	end
	current = nil
	currentTape = nil
end

local function exclusions(): { Instance }
	local list: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, name in { "Vigia", "VigiaVisual" } do
		local model = workspace:FindFirstChild(name)
		if model then
			table.insert(list, model)
		end
	end
	return list
end

local function farFromPlayers(position: Vector3): boolean
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and (character:GetPivot().Position - position).Magnitude < MIN_PLAYER_DISTANCE then
			return false
		end
	end
	return true
end

-- Ponto de apoio: raycast de cima para baixo; precisa ser superfície horizontal e baixa.
local function findSpot(): CFrame?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclusions()
	params.RespectCanCollide = true
	local order = {}
	for i = 1, #SPOTS do
		order[i] = i
	end
	for i = #order, 2, -1 do
		local j = rng:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	for _, index in order do
		local spot = SPOTS[index]
		local hit = workspace:Raycast(Vector3.new(spot[1], 10.5, spot[2]), Vector3.new(0, -12, 0), params)
		if hit and hit.Normal.Y > 0.8 and hit.Position.Y < 6 and farFromPlayers(hit.Position) then
			return CFrame.new(hit.Position + Vector3.new(0, 0.09, 0))
				* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		end
	end
	return nil
end

-- Fita que menos jogadores presentes têm (nil se todos já têm todas).
local function chooseTape(): string?
	local best: { string } = {}
	local bestMissing = 0
	for _, tape in StoreCatalog.Tapes do
		local missing = 0
		for _, player in Players:GetPlayers() do
			if not StoreService.ownedTapes(player)[tape.id] then
				missing += 1
			end
		end
		if missing > bestMissing then
			best = { tape.id }
			bestMissing = missing
		elseif missing == bestMissing and missing > 0 then
			table.insert(best, tape.id)
		end
	end
	if #best == 0 then
		return nil
	end
	return best[rng:NextInteger(1, #best)]
end

local function build(at: CFrame, tapeId: string): BasePart
	local model = Instance.new("Model")
	model.Name = "VhsTape"
	local case = Instance.new("Part")
	case.Name = "Case"
	case.Size = Vector3.new(0.9, 0.16, 0.55)
	case.CFrame = at
	case.Color = Color3.fromRGB(18, 18, 20)
	case.Material = Enum.Material.SmoothPlastic
	case.Reflectance = 0.15
	case.Anchored = true
	case.CanCollide = false
	case.CastShadow = false
	case.Parent = model
	local label = case:Clone()
	label.Name = "Label"
	label.Size = Vector3.new(0.6, 0.02, 0.3)
	label.CFrame = at * CFrame.new(0, 0.09, 0)
	label.Color = Color3.fromRGB(220, 214, 196)
	label.Reflectance = 0
	label.CanQuery = false
	label.Parent = model
	local rec = case:Clone()
	rec.Name = "Rec"
	rec.Size = Vector3.new(0.08, 0.03, 0.08)
	rec.CFrame = at * CFrame.new(0.36, 0.09, -0.18)
	rec.Color = Color3.fromRGB(255, 50, 40)
	rec.Material = Enum.Material.Neon
	rec.Reflectance = 0
	rec.CanQuery = false
	rec.Parent = model
	case:SetAttribute(Tags.Attr.InteractId, TAPE_ID)
	case:SetAttribute(Tags.Attr.InteractPrompt, Text.Prompts.Tape)
	case:SetAttribute(Tags.Attr.InteractDistance, REACH)
	case:SetAttribute(Tags.Attr.InteractEnabled, true)
	case:SetAttribute("Tape", tapeId)
	CollectionService:AddTag(case, Tags.Interactable)
	model.PrimaryPart = case
	model.Parent = workspace
	return case
end

local function spawnTape()
	clear()
	local tapeId = chooseTape()
	if not tapeId then
		return
	end
	local at = findSpot()
	if not at then
		log.warn("no free spot for a tape this round")
		return
	end
	current = build(at, tapeId)
	currentTape = tapeId
	log.info("tape %s placed at (%d, %d, %d)", tapeId, at.Position.X, at.Position.Y, at.Position.Z)
end

local function canReach(character: Model, part: BasePart): boolean
	local head = character:FindFirstChild("Head")
	local origin = if head and head:IsA("BasePart") then head.Position else character:GetPivot().Position
	if (origin - part.Position).Magnitude > REACH + Config.Game.InteractTolerance then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local hit = workspace:Raycast(origin, part.Position - origin, params)
	return hit == nil
		or hit.Instance:IsDescendantOf(part.Parent :: Instance)
		or (hit.Position - part.Position).Magnitude < 1
end

local CollectibleService = {
	Name = "CollectibleService",
	TAPE_ID = TAPE_ID,
}

function CollectibleService.Start()
	GameState.observe(function(snapshot, changed)
		if snapshot.phase == "Playing" and (changed == "Phase" or changed == nil) then
			-- Uma fita por partida (RoundId) e por estágio da campanha.
			local state = game:GetService("ReplicatedStorage"):FindFirstChild("CampaignState")
			local stage = if state then (state:GetAttribute("Stage") :: number?) or 0 else 0
			local key = `{snapshot.roundId}:{stage}`
			if key ~= spawnedFor then
				spawnedFor = key
				task.defer(spawnTape)
			end
		elseif
			changed == "Phase" and (snapshot.phase == "Intro" or snapshot.phase == "Won" or snapshot.phase == "Lost")
		then
			clear()
		end
	end)
end

-- Encaminhado pelos runtimes (solo e campanha) quando o id é "tape".
function CollectibleService.collect(player: Player): Types.InteractResponse
	local part = current
	local tapeId = currentTape
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local status = player:GetAttribute("CampaignStatus")
	if GameState.get("Phase") ~= "Playing" or (status ~= nil and status ~= "Active") then
		return { accepted = false, message = "not_available" }
	end
	if not part or not tapeId or not character or not humanoid or humanoid.Health <= 0 then
		return { accepted = false, message = "not_available" }
	end
	if not canReach(character, part) then
		return { accepted = false, message = "too_far" }
	end
	clear()
	for _, member in Players:GetPlayers() do
		StoreService.awardTape(member, tapeId, player.DisplayName)
	end
	log.info("%s found %s for the team", player.Name, tapeId)
	return { accepted = true, message = "tape_found", kind = "Tape" }
end

-- Depuração: posição e id da fita atual.
function CollectibleService.debugState(): { [string]: any }
	return {
		tape = currentTape,
		position = if current then current.Position else nil,
	}
end

return CollectibleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="469">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CosmeticService: aplica no personagem (servidor -> todos veem) a farda e o título equipados.

	Farda: troca a roupa clássica do avatar (Shirt/Pants e roupas em camadas) pelas cores da
	farda (BodyColors) e acrescenta capacete ou quepe e faixa refletiva, em peças sem colisão
	soldadas ao corpo. Chapéus, cabelo e rosto do avatar são mantidos (identidade do jogador).
	Título: placa sobre a cabeça (BillboardGui "TitleTag"); o cliente só mostra fora da ação.

	Lanterna e filtro são locais (CosmeticController, no cliente), lendo os atributos Equip*.
	Puramente visual: nenhuma colisão, hitbox ou velocidade muda.
]]

local Players = game:GetService("Players")

local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local PixelText = require("@game/ReplicatedStorage/Shared/Game/PixelText")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local StoreService = require("./StoreService")

local log = Logger.new("CosmeticService")
local FOLDER = "S9Cosmetics"
-- Última combinação aplicada por personagem (evita refazer peças a cada mudança de moeda).
local applied: { [Model]: string } = {}

-- Roupas em camadas (avatar) que a farda substitui.
local CLOTHING: { [Enum.AccessoryType]: boolean } = {
	[Enum.AccessoryType.TShirt] = true,
	[Enum.AccessoryType.Shirt] = true,
	[Enum.AccessoryType.Pants] = true,
	[Enum.AccessoryType.Jacket] = true,
	[Enum.AccessoryType.Sweater] = true,
	[Enum.AccessoryType.Shorts] = true,
	[Enum.AccessoryType.DressSkirt] = true,
}

local function rgb(c: StoreCatalog.RGB?): Color3?
	if not c then
		return nil
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function attach(folder: Instance, base: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CFrame = base.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function bodyPart(character: Model, names: { string }): BasePart?
	for _, name in names do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local function applyUniform(character: Model, folder: Instance, item: StoreCatalog.Item)
	for _, child in character:GetChildren() do
		local classic = child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic")
		if classic or (child:IsA("Accessory") and CLOTHING[child.AccessoryType]) then
			child:Destroy()
		end
	end
	local shirt = rgb(item.shirt) or Color3.fromRGB(46, 58, 84)
	local pants = rgb(item.pants) or shirt
	local colors = character:FindFirstChildOfClass("BodyColors")
	if not colors then
		local created = Instance.new("BodyColors")
		created.Parent = character
		colors = created
	end
	assert(colors, "body colors")
	colors.TorsoColor3 = shirt
	colors.LeftArmColor3 = shirt
	colors.RightArmColor3 = shirt
	colors.LeftLegColor3 = pants
	colors.RightLegColor3 = pants

	local head = bodyPart(character, { "Head" })
	if head then
		local top = head.Size.Y / 2
		local helmet = rgb(item.helmet)
		if helmet then
			attach(folder, head, "Helmet", Vector3.new(1.3, 0.5, 1.35), CFrame.new(0, top + 0.05, 0), helmet)
			attach(folder, head, "Brim", Vector3.new(1.45, 0.08, 1.55), CFrame.new(0, top - 0.17, -0.05), helmet)
		elseif item.cap then
			local cap = shirt:Lerp(Color3.new(0, 0, 0), 0.25)
			attach(folder, head, "Cap", Vector3.new(1.25, 0.32, 1.3), CFrame.new(0, top, 0), cap)
			attach(folder, head, "Visor", Vector3.new(1.0, 0.07, 0.55), CFrame.new(0, top - 0.12, -0.75), cap)
			local badge = rgb(item.stripe)
			if badge then
				attach(folder, head, "Badge", Vector3.new(0.3, 0.2, 0.05), CFrame.new(0, top + 0.02, -0.66), badge)
			end
		end
	end
	local stripe = rgb(item.stripe)
	local torso = bodyPart(character, { "UpperTorso", "Torso" })
	if stripe and torso then
		local size = torso.Size
		attach(
			folder,
			torso,
			"Stripe",
			Vector3.new(size.X + 0.04, 0.14, size.Z + 0.04),
			CFrame.new(0, -size.Y * 0.18, 0),
			stripe
		)
	end
	for _, legName in { "LeftLowerLeg", "RightLowerLeg" } do
		local leg = bodyPart(character, { legName })
		if stripe and leg then
			attach(
				folder,
				leg,
				"LegStripe",
				Vector3.new(leg.Size.X + 0.04, 0.1, leg.Size.Z + 0.04),
				CFrame.new(0, leg.Size.Y * 0.1, 0),
				stripe
			)
		end
	end
end

local function applyTitle(character: Model, folder: Instance, item: StoreCatalog.Item)
	local head = bodyPart(character, { "Head" })
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "TitleTag"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(220, 24)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 45
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Arcade
	label.TextScaled = true
	label.Text = PixelText.normalize(item.name)
	label.TextColor3 = rgb(item.color) or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Parent = gui
	gui.Parent = folder
end

local function apply(player: Player, force: boolean?)
	local character = player.Character
	if not character then
		return
	end
	local signature = StoreService.equipped(player, "uniform") .. "|" .. StoreService.equipped(player, "title")
	if not force and applied[character] == signature and character:FindFirstChild(FOLDER) then
		return
	end
	applied[character] = signature
	character.Destroying:Once(function()
		applied[character] = nil
	end)
	local old = character:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	folder.Parent = character
	local uniform = StoreCatalog.ItemById[StoreService.equipped(player, "uniform")]
	local title = StoreCatalog.ItemById[StoreService.equipped(player, "title")]
	local ok, err = pcall(function()
		if uniform then
			applyUniform(character, folder, uniform)
		end
		if title then
			applyTitle(character, folder, title)
		end
	end)
	if not ok then
		log.warn("cosmetics failed for %s: %s", player.Name, tostring(err))
	end
end

local function watch(player: Player)
	player.CharacterAppearanceLoaded:Connect(function()
		apply(player, true)
	end)
	if player.Character then
		task.defer(apply, player, true)
	end
end

local CosmeticService = {
	Name = "CosmeticService",
}

function CosmeticService.Start()
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	-- Equipou outra farda/título: reaplica na hora.
	StoreService.onChanged(function(player: Player)
		apply(player)
	end)
end

function CosmeticService.apply(player: Player)
	apply(player, true)
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="470">
          <Properties>
            <string name="Name">CreatureService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CreatureService: O Vigia no servidor (autoritativo).

	- O corpo no servidor é só uma peça invisível "Root" (ancorada, sem colisão) movida de forma
	  cinemática ao longo de waypoints do PathfindingService. Simulação e captura acontecem aqui.
	- O visual (modelo low poly em stop-motion) é montado no cliente e segue esta Root.
	- Decisões vêm do CreatureBrain (puro); aqui só calculamos percepção e executamos comandos.
]]

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")

local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local CreatureBrain = require("../Game/CreatureBrain")
local ForestThreat = require("@game/ReplicatedStorage/Shared/Game/ForestThreat")
local HideRules = require("../Game/HideRules")
local Layout = require("../World/Layout")
local WorldService = require("./WorldService")

type Target = {
	player: Player,
	character: Model,
	root: BasePart,
	eye: Vector3,
}

local log = Logger.new("CreatureService")
local C = Config.Creature
local HEIGHT = C.Height
local HIDDEN = CFrame.new(0, -400, 0)
local UP = Vector3.yAxis

local model: Model? = nil
local root: BasePart? = nil
local brain = CreatureBrain.new()
local active = false
local frozen = false
local hunt = false
local token = 0
local captureCallbacks: { (Player) -> () } = {}

-- Percepção auxiliar
local pendingNoise: Vector3? = nil
local lastStalkAt = 0
local lastSeenFlag = false
local lastSeenAt = -math.huge
local seenPlayers: { [number]: number } = {}
-- Tempo que ele está perto do armário com o jogador respirando (HideRules.exposure).
local exposure = 0
-- Trégua (checkpoint): parado até este instante.
local holdUntil = 0
local nextBangAt = 0
local feintUntil = 0
local nextFeintAt = 0
local feintDestination: Vector3? = nil

-- Movimento
local waypoints: { Vector3 } = {}
local waypointIndex = 1
local moveSpeed = 0
local destination: Vector3? = nil
local arrived = true
local pathBusy = false
local lastPathAt = -math.huge
local pauseUntil = 0
local currentMode: CreatureBrain.Mode = "Dormant"
local patrolOrder: { number } = {}
local patrolCursor = 0
local rng = Random.new()

local function getRoot(): BasePart
	assert(root, "[CreatureService] used before Init")
	return root
end

local function feet(): Vector3
	return getRoot().Position - UP * (HEIGHT / 2)
end

local function setAttributes(mode: string)
	local r = getRoot()
	r:SetAttribute(Tags.Attr.CreatureMode, mode)
	r:SetAttribute(Tags.Attr.CreatureActive, active)
	if mode ~= "Chase" and mode ~= "Capture" then
		r:SetAttribute(Tags.Attr.ThreatTargetUserId, 0)
	end
end

local function placeAt(position: Vector3, look: Vector3?)
	local center = Vector3.new(position.X, position.Y + HEIGHT / 2, position.Z)
	local direction = look or Vector3.new(0, 0, -1)
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 1e-3 then
		direction = Vector3.new(0, 0, -1)
	end
	getRoot().CFrame = CFrame.lookAt(center, center + direction.Unit)
end

local function vec(p: Layout.Point): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function findTarget(): Target?
	local best: Target? = nil
	local bestDistance = math.huge
	local origin = feet()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local campaignStatus = player:GetAttribute("CampaignStatus")
		local campaignActive = campaignStatus == nil or campaignStatus == "Active"
		local grace = player:GetAttribute("CampaignGraceUntil")
		local protected = type(grace) == "number" and workspace:GetServerTimeNow() < grace
		if
			campaignActive
			and not protected
			and character
			and humanoid
			and humanoid.Health > 0
			and hrp
			and hrp:IsA("BasePart")
		then
			local head = character:FindFirstChild("Head")
			local eye = if head and head:IsA("BasePart") then head.Position else hrp.Position + UP * 1.5
			local distance = (hrp.Position - origin).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				best = { player = player, character = character, root = hrp, eye = eye }
			end
		end
	end
	return best
end

local function lineOfSight(target: Target): boolean
	local eye = feet() + UP * (HEIGHT - 0.7)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { target.character }
	if model then
		table.insert(exclude, model)
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(eye, target.eye - eye, params)
	return result == nil
end

-- Jogador escondido num armário: só é "visto" se o Vigia viu entrar ou o ouviu respirar.
local function perceiveHidden(target: Target, now: number): CreatureBrain.Perception
	local player = target.player
	local origin = feet()
	local at = player:GetAttribute("HiddenAt")
	local spot = if typeof(at) == "Vector3" then at else target.root.Position
	local spotFeet = Vector3.new(spot.X, spot.Y, spot.Z)
	local distance = (spotFeet - origin).Magnitude
	-- Lanterna acesa dentro do armário vaza pelas frestas: conta como respirar.
	local quiet = player:GetAttribute("HoldBreath") == true and player:GetAttribute(Tags.Attr.Flashlight) ~= true
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Exclude
	ray.FilterDescendantsInstances = { target.character, getRoot().Parent :: Instance }
	local blocked = workspace:Raycast(origin + UP * 3, spotFeet + UP * 3 - (origin + UP * 3), ray) ~= nil
	exposure = HideRules.exposure(exposure, if blocked then math.huge else distance, quiet, C.BrainInterval)
	local seen = player:GetAttribute("HiddenSeen") == true
	if
		not seen
		and HideRules.found({
			sawEntry = false,
			creatureActive = active,
			distance = distance,
			holdingBreath = quiet,
			exposedTime = exposure,
			captureRange = C.CaptureRange,
		})
	then
		seen = true
		player:SetAttribute("HiddenSeen", true)
		getRoot():SetAttribute("Alert", now)
		log.info("heard %s breathing inside the locker", player.Name)
	end
	local noise = pendingNoise
	pendingNoise = nil
	if seen then
		lastSeenAt = now
		return {
			now = now,
			canSee = true,
			lineOfSight = true,
			distance = distance,
			targetPos = spotFeet,
			noisePos = nil,
			hunt = hunt and not Config.House.Enabled,
			arrived = arrived,
		}
	end
	-- Não sabe onde ele está: segue o último rastro / barulho (o arquejo atrai até o armário).
	return {
		now = now,
		canSee = false,
		lineOfSight = false,
		distance = distance,
		targetPos = nil,
		noisePos = noise,
		hunt = hunt and not Config.House.Enabled,
		arrived = arrived,
	}
end

local function perceive(target: Target?, now: number): CreatureBrain.Perception
	if target == nil then
		return { now = now, canSee = false, lineOfSight = false, hunt = false, arrived = arrived }
	end
	local hiddenId = target.player:GetAttribute("Hidden")
	if type(hiddenId) == "string" and hiddenId ~= "" then
		return perceiveHidden(target, now)
	end
	exposure = 0
	local origin = feet()
	local toTarget = target.root.Position - (origin + UP * 3)
	local distance = toTarget.Magnitude
	local los = distance < 80 and lineOfSight(target)

	local flashlight = target.player:GetAttribute(Tags.Attr.Flashlight) == true
	-- Agachado ele enxerga menos (alcance e o "sentido" de perto).
	local crouch = if target.player:GetAttribute("Stance") == "Crouch" then Config.Player.CrouchSightFactor else 1
	local forest = WorldService.get().root:GetAttribute("ForestActive") == true
	local range = (if flashlight then C.SightRangeFlashlight else C.SightRange) * crouch * (if forest then 1.16 else 1)
	local forward = getRoot().CFrame.LookVector
	local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
	local inFov = flat.Magnitude < 1e-3
		or math.deg(math.acos(math.clamp(forward:Dot(flat.Unit), -1, 1))) <= C.SightFov / 2
	local canSee = los and distance <= range and (inFov or distance <= C.CloseSenseRange * crouch)
	if canSee then
		seenPlayers[target.player.UserId] = now
		lastSeenAt = now
	end

	local targetFeet = target.root.Position - UP * 3
	local noise = pendingNoise
	pendingNoise = nil

	if
		not Config.House.Enabled
		and brain.fuses >= C.StalkFromFuses
		and brain.mode == "Patrol"
		and now - lastStalkAt >= C.StalkInterval
	then
		lastStalkAt = now
		noise = targetFeet + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
	end

	return {
		now = now,
		canSee = canSee,
		lineOfSight = los,
		distance = distance,
		targetPos = targetFeet,
		noisePos = noise,
		hunt = hunt and not Config.House.Enabled,
		arrived = arrived,
	}
end

local function computePath(target: Vector3)
	if pathBusy then
		return
	end
	pathBusy = true
	local myToken = token
	local start = feet()
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = C.AgentRadius,
			AgentHeight = C.AgentHeight,
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = 4,
			Costs = { Door = 2 },
		})
		local ok, err = pcall(function()
			path:ComputeAsync(start, target)
		end)
		pathBusy = false
		if myToken ~= token then
			return
		end
		lastPathAt = os.clock()
		if ok and path.Status == Enum.PathStatus.Success then
			local points = {}
			for _, waypoint in path:GetWaypoints() do
				table.insert(points, waypoint.Position)
			end
			waypoints = points
			waypointIndex = math.min(2, #points)
			arrived = #points == 0
		else
			if not ok then
				log.debug("path error: %s", tostring(err))
			end
			waypoints = {}
			arrived = true
		end
	end)
end

local function stopMoving()
	waypoints = {}
	destination = nil
	moveSpeed = 0
end

local function nextPatrolNode(): Vector3
	local nodes = WorldService.patrolNodes()
	if patrolCursor >= #patrolOrder then
		patrolOrder = {}
		for i = 1, #nodes do
			table.insert(patrolOrder, i)
		end
		for i = #patrolOrder, 2, -1 do
			local j = rng:NextInteger(1, i)
			patrolOrder[i], patrolOrder[j] = patrolOrder[j], patrolOrder[i]
		end
		patrolCursor = 0
	end
	patrolCursor += 1
	return vec(nodes[patrolOrder[patrolCursor]])
end

-- urgent (perseguição): recalcula a rota a cada RepathInterval; senão só quando o destino muda.
local function goTo(target: Vector3, speed: number, urgent: boolean)
	moveSpeed = speed
	local changed = destination == nil or (destination - target).Magnitude > 2
	destination = target
	if urgent then
		if os.clock() - lastPathAt >= C.RepathInterval then
			arrived = false
			computePath(target)
		end
	elseif changed then
		arrived = false
		computePath(target)
	end
end

local function fireCapture(player: Player)
	for _, callback in captureCallbacks do
		task.spawn(callback, player)
	end
end

local function brainTick()
	if not active or frozen then
		return
	end
	local now = os.clock()
	if now < holdUntil then
		setAttributes("Search")
		return
	end
	local target = findTarget()
	local perception = perceive(target, now)
	if
		brain.mode == "Search"
		and now >= brain.searchUntil
		and now >= nextFeintAt
		and not perception.canSee
		and not perception.noisePos
		and rng:NextNumber() < Config.House.FalseExitChance
	then
		feintUntil, nextFeintAt = now + 6, now + Config.House.FalseExitCooldown
		feintDestination = nextPatrolNode()
	end
	local command = CreatureBrain.step(brain, perception)
	command.speed = ForestThreat.speed(
		tonumber(WorldService.get().root:GetAttribute("HouseChapter")) or 0,
		command.mode,
		command.speed
	)
	if feintUntil > now and not perception.canSee and not perception.noisePos then
		command = { mode = "Investigate", target = feintDestination, speed = 5 }
	else
		feintUntil = 0
	end
	getRoot():SetAttribute("FalseExit", feintUntil > now)
	if command.mode == "Chase" or command.event == "capture" then
		getRoot():SetAttribute(Tags.Attr.ThreatTargetUserId, if target then target.player.UserId else 0)
	end

	if command.event == "capture" and target then
		frozen = true
		stopMoving()
		setAttributes("Capture")
		placeAt(feet(), target.root.Position - feet())
		log.info("captured %s", target.player.Name)
		fireCapture(target.player)
		return
	end
	if command.event then
		log.debug("event %s", command.event)
	end
	lastSeenFlag = perception.canSee

	if command.mode == "Patrol" then
		if currentMode ~= "Patrol" or arrived or destination == nil then
			goTo(nextPatrolNode(), command.speed, false)
		else
			moveSpeed = command.speed
		end
	elseif command.mode == "Chase" and command.target then
		-- Muito perto e à vista: vai direto (sem esperar o pathfinding).
		if perception.lineOfSight and perception.distance and perception.distance < 9 then
			destination = command.target
			waypoints = { command.target }
			waypointIndex = 1
			moveSpeed = command.speed
			arrived = false
		else
			goTo(command.target, command.speed, true)
		end
	elseif command.mode == "Investigate" and command.target then
		goTo(command.target, command.speed, false)
	else
		stopMoving()
	end

	currentMode = command.mode
	setAttributes(command.mode)
end

local function move(dt: number)
	if not active or frozen then
		return
	end
	local now = os.clock()
	local r = getRoot()
	if now < holdUntil then
		return
	end

	-- Porta trancada: bate com força e desiste (o pathfinding já contorna).
	local lockedDoor = WorldService.lockedDoorNear(feet(), C.DoorOpenRange)
	if lockedDoor and (currentMode == "Chase" or currentMode == "Investigate") and now >= nextBangAt then
		nextBangAt = now + 5
		WorldService.bangDoor(lockedDoor)
		pauseUntil = now + 1.2
	end

	-- Arromba portas fechadas no caminho.
	local door = WorldService.closedDoorNear(feet(), C.DoorOpenRange)
	if door and (currentMode == "Chase" or currentMode == "Investigate" or currentMode == "Patrol") then
		WorldService.forceOpenDoor(door)
		pauseUntil = now + C.DoorOpenPause
	end
	if now < pauseUntil then
		return
	end

	if currentMode == "Search" then
		r.CFrame = r.CFrame * CFrame.Angles(0, math.sin(now * 1.3) * dt * 1.6, 0)
		return
	end

	local waypoint: Vector3? = waypoints[waypointIndex]
	if waypoint == nil or moveSpeed <= 0 then
		return
	end
	local position = feet()
	local delta = Vector3.new(waypoint.X - position.X, 0, waypoint.Z - position.Z)
	local distance = delta.Magnitude
	if distance < 0.6 then
		waypointIndex += 1
		if waypointIndex > #waypoints then
			arrived = true
			waypoints = {}
		end
		return
	end
	local step = math.min(distance, moveSpeed * dt)
	local nextPosition = position + delta.Unit * step
	nextPosition =
		Vector3.new(nextPosition.X, position.Y + (waypoint.Y - position.Y) * math.min(1, dt * 8), nextPosition.Z)
	local look = r.CFrame.LookVector:Lerp(delta.Unit, math.min(1, dt * 9))
	placeAt(nextPosition, look)
end

local CreatureService = {
	Name = "CreatureService",
}

function CreatureService.Init()
	local m = Instance.new("Model")
	m.Name = Tags.CreatureModel
	local r = Instance.new("Part")
	r.Name = Tags.CreatureRoot
	r.Size = Vector3.new(2, HEIGHT, 1.4)
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.Transparency = 1
	r.CastShadow = false
	r.CFrame = HIDDEN
	r.Parent = m
	m.PrimaryPart = r
	m.Parent = workspace
	model = m
	root = r
	setAttributes("Dormant")
end

function CreatureService.Start()
	task.spawn(function()
		while true do
			task.wait(C.BrainInterval)
			local ok, err = pcall(brainTick :: () -> any)
			if not ok then
				log.error("brain tick failed: %s", tostring(err))
			end
		end
	end)
	RunService.Heartbeat:Connect(move)
end

-- Volta ao estado inicial (escondido e dormente).
function CreatureService.reset()
	token += 1
	patrolOrder, patrolCursor = {}, 0
	brain = CreatureBrain.new()
	active = false
	frozen = false
	hunt = false
	pendingNoise = nil
	lastSeenFlag = false
	lastSeenAt = -math.huge
	table.clear(seenPlayers)
	exposure = 0
	holdUntil = 0
	nextBangAt, feintUntil, nextFeintAt = 0, 0, 0
	arrived = true
	pathBusy = false
	pauseUntil = 0
	currentMode = "Dormant"
	stopMoving()
	getRoot().CFrame = HIDDEN
	setAttributes("Dormant")
end

-- Acorda no ponto de surgimento mais distante do jogador (ou em `at`).
function CreatureService.activate(at: Vector3?)
	if active then
		return
	end
	local spawnAt = at
	if spawnAt == nil then
		local target = findTarget()
		local reference = if target then target.root.Position else Vector3.zero
		local best, bestDistance = nil, -1
		for _, p in WorldService.creatureSpawns() do
			local position = vec(p)
			local distance = (position - reference).Magnitude
			if distance > bestDistance then
				best, bestDistance = position, distance
			end
		end
		spawnAt = best
	end
	assert(spawnAt, "no spawn point")
	placeAt(spawnAt, nil)
	active = true
	lastStalkAt = os.clock()
	CreatureBrain.activate(brain)
	currentMode = "Patrol"
	setAttributes("Patrol")
	log.info("awakened at (%d, %d)", spawnAt.X, spawnAt.Z)
end

function CreatureService.setFuses(count: number)
	brain.fuses = count
end

function CreatureService.setHunt(on: boolean)
	hunt = on
end

-- Barulho em `position` (ouvido se estiver dentro de `radius`).
function CreatureService.makeNoise(position: Vector3, radius: number)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excluded: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(excluded, player.Character)
		end
	end
	if model then
		table.insert(excluded, model)
	end
	params.FilterDescendantsInstances = excluded
	local origin = feet() + UP * 3
	local blocked = workspace:Raycast(origin, position + UP * 2 - origin, params) ~= nil
	local audible = radius * (if blocked then 0.2 else 1)
	if active and not frozen and (position - feet()).Magnitude <= audible then
		pendingNoise = position
	end
end

function CreatureService.silhouette()
	active, frozen = true, true
	placeAt(Vector3.new(26, 16, 8), Vector3.new(0, 0, 1))
	setAttributes("Search")
end
function CreatureService.endingPose()
	active, frozen = true, true
	placeAt(Vector3.new(0, 0, 58), Vector3.new(0, 0, 1))
	setAttributes("Search")
end
function CreatureService.freeze()
	frozen = true
	stopMoving()
end

-- Depuração: congela/descongela sem mudar o resto do estado.
function CreatureService.setFrozen(value: boolean)
	frozen = value
	if value then
		stopMoving()
	end
end

-- Trégua: fica parado olhando em volta por `seconds` (continuar do checkpoint).
function CreatureService.holdOff(seconds: number)
	holdUntil = os.clock() + seconds
end

-- Segundos desde a última vez que viu o jogador (esconderijo: "viu entrar?").
function CreatureService.sawEntry(player: Player): boolean
	return os.clock() - (seenPlayers[player.UserId] or -math.huge) < Config.Hide.SawEntryWindow
end
function CreatureService.secondsSinceSeen(): number
	return os.clock() - lastSeenAt
end

function CreatureService.isChasing(): boolean
	return active and currentMode == "Chase"
end

function CreatureService.onCapture(callback: (Player) -> ())
	table.insert(captureCallbacks, callback)
end

function CreatureService.isActive(): boolean
	return active
end

function CreatureService.state(): { [string]: any }
	return {
		active = active,
		frozen = frozen,
		hunt = hunt and not Config.House.Enabled,
		mode = brain.mode,
		fuses = brain.fuses,
		position = feet(),
		waypoints = #waypoints,
		seeing = lastSeenFlag,
		sinceSeen = os.clock() - lastSeenAt,
		exposure = exposure,
		holdOff = math.max(0, holdUntil - os.clock()),
	}
end

-- Teleporte para depuração/testes (não usado no jogo normal).
function CreatureService.debugPlace(position: Vector3)
	placeAt(position, nil)
	stopMoving()
	arrived = true
end

return CreatureService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="471">
          <Properties>
            <string name="Name">DebugService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DebugService: ponte de depuração SÓ NO STUDIO (não existe em servidor ao vivo).

	Por quê: o `execute_luau` do MCP roda em outra VM; um `require` lá cria uma cópia nova dos
	módulos e não enxerga o estado real do jogo. Uma BindableFunction atravessa essa fronteira.

	Uso (MCP, execute_luau, datamodel_type = "Server"):
		local bridge = game:GetService("ServerStorage").DebugBridge
		return bridge:Invoke("state")
		bridge:Invoke("placeCreature", Vector3.new(0, 0, -22))
		bridge:Invoke("freezeCreature", true)

	Comandos: state | awaken | freezeCreature(bool) | placeCreature(Vector3) | teleport(Vector3) | restart
	          checkpoint | grant("fuses"|"insert"|"breakers"|"key") | setBattery(0..1) | fall(id) | holdOff(s)
	          storeGrant(fichas, creditos) | endRound("Won"|"Lost") | tape | seasonXp(xp) | analytics
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local CollectibleService = require("./CollectibleService")
local CreatureService = require("./CreatureService")
local PlayerStateService = require("./PlayerStateService")
local PropService = require("./PropService")
local RoundService = require("./RoundService")
local StoreService = require("./StoreService")
local TelemetryService = require("./TelemetryService")
local WorldService = require("./WorldService")

local log = Logger.new("DebugService")

local function encode(value: any): any
	if typeof(value) == "Vector3" then
		return string.format("%.1f,%.1f,%.1f", value.X, value.Y, value.Z)
	elseif type(value) == "table" then
		local out = {}
		for key, item in value do
			out[key] = encode(item)
		end
		return out
	end
	return value
end

local commands: { [string]: (...any) -> any } = {
	forestChapter = function(chapter: number)
		return (RoundService :: any).debugForest(chapter)
	end,
	lightingPower = function(on: boolean)
		WorldService.setPower(on)
		return "ok"
	end,
	state = function()
		local players = {}
		for _, player in Players:GetPlayers() do
			players[player.Name] = PlayerStateService.snapshot(player)
		end
		return HttpService:JSONEncode(encode({
			round = RoundService.snapshot(),
			creature = CreatureService.state(),
			players = players,
		}))
	end,
	awaken = function()
		CreatureService.activate(nil)
		return "ok"
	end,
	freezeCreature = function(value: boolean)
		CreatureService.setFrozen(value)
		return "ok"
	end,
	placeCreature = function(position: Vector3)
		CreatureService.debugPlace(position)
		return "ok"
	end,
	teleport = function(position: Vector3)
		for _, player in Players:GetPlayers() do
			local character = player.Character
			if character then
				character:PivotTo(CFrame.new(position))
				PlayerStateService.markTeleported(player)
			end
		end
		return "ok"
	end,
	checkpoint = function()
		-- RoundService pode ser o runtime da campanha (Codex); estes comandos são do modo solo.
		(RoundService :: any).continueFromCheckpoint()
		return "ok"
	end,
	grant = function(what: string)
		(RoundService :: any).debugGrant(what, Players:GetPlayers()[1])
		return "ok"
	end,
	setBattery = function(value: number)
		for _, player in Players:GetPlayers() do
			PlayerStateService.addBattery(player, value - PlayerStateService.battery(player))
		end
		return "ok"
	end,
	fall = function(id: string)
		return PropService.debugFall(id)
	end,
	storeGrant = function(fichas: number, creditos: number)
		for _, player in Players:GetPlayers() do
			StoreService.debugGrant(player, fichas or 0, creditos or 0)
		end
		return "ok"
	end,
	endRound = function(result: string)
		local player = Players:GetPlayers()[1]
		if player then
			if result == "Won" then
				(RoundService :: any).win(player)
			else
				(RoundService :: any).lose(player)
			end
		end
		return "ok"
	end,
	seasonXp = function(amount: number)
		for _, player in Players:GetPlayers() do
			StoreService.debugSeasonXp(player, amount or 0)
		end
		return "ok"
	end,
	-- Últimos eventos de analytics (no Studio nada vai para a Roblox; fica só aqui).
	analytics = function()
		return HttpService:JSONEncode(TelemetryService.history())
	end,
	tape = function()
		return HttpService:JSONEncode(encode(CollectibleService.debugState()))
	end,
	holdOff = function(seconds: number)
		CreatureService.holdOff(seconds)
		return "ok"
	end,
	restart = function()
		RoundService.restart()
		return "ok"
	end,
}

local DebugService = {
	Name = "DebugService",
}

function DebugService.Init()
	if not RunService:IsStudio() then
		return
	end
	local bridge = Instance.new("BindableFunction")
	bridge.Name = "DebugBridge"
	bridge.OnInvoke = function(command: string, ...: any): any
		local handler = commands[command]
		if not handler then
			return `unknown command "{command}"`
		end
		log.debug("debug command %s", command)
		return handler(...)
	end
	bridge.Parent = ServerStorage
end

return DebugService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="472">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LobbyService: lista de servidores do menu inicial e entrada em outro servidor ou no de um amigo.

	- Cada servidor publica um registro curto (Shared/Game/ServerList) num MemoryStore SortedMap a cada
	  ServerList.REFRESH s, com expiração (servidor que cai some sozinho) e apaga o próprio ao fechar.
	- Remote "Lobby" (RemoteFunction, ação, argumento?):
	    "servers"         lista ordenada (sem o próprio servidor) + resumo deste servidor;
	    "join", jobId     teleporta se o registro existir, estiver vivo e com vaga;
	    "friend", userId  teleporta para o servidor do amigo (o servidor confere a amizade e onde ele está;
	                      o cliente nunca escolhe um JobId arbitrário).
	- Studio ou lugar não publicado: sem MemoryStore nem teleporte. A lista traz só este servidor e os
	  pedidos de entrada respondem "lobby_studio" (nada é publicado nem chamado fora do Studio).
]]

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local ServerList = require("@game/ReplicatedStorage/Shared/Game/ServerList")
local ServerNet = require("../Net/ServerNet")

local log = Logger.new("LobbyService")
local MAP_NAME = "S9Servers"

local map: MemoryStoreSortedMap? = nil
local online = false

local LobbyService = {
	Name = "LobbyService",
}

local function now(): number
	return os.time()
end

-- Registro deste servidor (o mesmo formato que os outros leem).
local function selfEntry(): ServerList.Entry
	local campaign = ReplicatedStorage:FindFirstChild("CampaignState")
	local mode = if campaign then campaign:GetAttribute("GameMode") else nil
	return {
		job = if game.JobId ~= "" then game.JobId else "studio",
		players = #Players:GetPlayers(),
		max = Config.Campaign.maxPlayers,
		mode = if mode == "Story" or mode == "Standard" then mode else "",
		phase = if campaign then tostring(campaign:GetAttribute("Phase") or "Lobby") else "Lobby",
		stage = if campaign then tonumber(campaign:GetAttribute("Stage")) or 0 else 0,
		updated = now(),
	}
end

local function publishSelf()
	local sorted = map
	if not online or not sorted then
		return
	end
	local entry = selfEntry()
	local ok, err = pcall(function()
		sorted:SetAsync(game.JobId, {
			players = entry.players,
			max = entry.max,
			mode = entry.mode,
			phase = entry.phase,
			stage = entry.stage,
			updated = entry.updated,
		}, ServerList.TTL)
	end)
	if not ok then
		log.warn("server registry write failed: %s", tostring(err))
	end
end

local function readAll(): { ServerList.Entry }
	local entries: { ServerList.Entry } = {}
	local sorted = map
	if not online or not sorted then
		return entries
	end
	local ok, items = pcall(function()
		return sorted:GetRangeAsync(Enum.SortDirection.Ascending, 100)
	end)
	if not ok or type(items) ~= "table" then
		log.warn("server registry read failed: %s", tostring(items))
		return entries
	end
	for _, item in items do
		local entry = ServerList.decode(item.value, item.key)
		if entry then
			table.insert(entries, entry)
		end
	end
	return entries
end

local function teleport(player: Player, jobId: string): (boolean, string)
	local options = Instance.new("TeleportOptions")
	options.ServerInstanceId = jobId
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, { player }, options)
	end)
	if not ok then
		log.warn("teleport of %s failed: %s", player.Name, tostring(err))
		return false, "lobby_teleport_failed"
	end
	return true, "lobby_teleporting"
end

local function handle(player: Player, action: string, arg: string?): { [string]: any }
	if action == "servers" then
		local list = ServerList.sorted(readAll(), game.JobId, now())
		return { ok = true, online = online, current = selfEntry(), servers = list }
	end
	if not online then
		return { ok = false, message = "lobby_studio" }
	end
	if action == "join" and arg then
		if not ServerList.validJob(arg) then
			return { ok = false, message = "server_gone" }
		end
		for _, entry in readAll() do
			if entry.job == arg then
				local joinable, reason = ServerList.joinable(entry, game.JobId, now())
				if not joinable then
					return { ok = false, message = reason or "server_gone" }
				end
				local ok, message = teleport(player, arg)
				return { ok = ok, message = message }
			end
		end
		return { ok = false, message = "server_gone" }
	elseif action == "friend" and arg then
		local friendId = tonumber(arg)
		if not friendId or friendId <= 0 then
			return { ok = false, message = "friend_offline" }
		end
		local isFriend = false
		pcall(function()
			isFriend = player:IsFriendsWithAsync(friendId)
		end)
		if not isFriend then
			return { ok = false, message = "friend_not_friend" }
		end
		local ok, _, _, placeId, jobId = pcall(function()
			return TeleportService:GetPlayerPlaceInstanceAsync(friendId)
		end)
		if not ok or placeId ~= game.PlaceId or type(jobId) ~= "string" or jobId == "" then
			return { ok = false, message = "friend_offline" }
		end
		if jobId == game.JobId then
			return { ok = false, message = "server_self" }
		end
		local teleported, message = teleport(player, jobId)
		return { ok = teleported, message = message }
	end
	return { ok = false, message = "lobby_unknown" }
end

function LobbyService.Start()
	online = game.GameId ~= 0 and game.JobId ~= "" and not RunService:IsStudio()
	if online then
		local ok, result = pcall(function()
			return MemoryStoreService:GetSortedMap(MAP_NAME)
		end)
		if ok then
			map = result
		else
			online = false
			log.warn("memory store unavailable: %s", tostring(result))
		end
	end
	ServerNet.onInvoke("Lobby", {
		args = {
			Guard.literal("servers", "join", "friend"),
			Guard.optional(Guard.string({ maxLength = 40, pattern = "^[%w%-]+$" })),
		},
		rateLimit = { capacity = 4, refillPerSecond = 0.5 },
	}, handle)
	if online then
		task.spawn(function()
			while true do
				publishSelf()
				task.wait(ServerList.REFRESH)
			end
		end)
		game:BindToClose(function()
			local sorted = map
			if sorted then
				pcall(function()
					sorted:RemoveAsync(game.JobId)
				end)
			end
		end)
	end
	log.info("server list %s", if online then "online" else "offline (Studio/unpublished)")
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="473">
          <Properties>
            <string name="Name">PerkService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PerkService: aplica na partida os consumíveis de uso automático (kit) comprados na loja.
	Regras e preços em Shared/Game/Perks; estoque e kit nos dados (StoreService).

	  Pilha Extra     no começo de cada etapa (ou da missão solo) arma uma pilha reserva (atributo
	                  SpareBattery) em quem tem no kit; o PlayerStateService a coloca quando a lanterna apaga.
	  Segunda Chance  na campanha, quem é pego com ela no kit levanta sozinho depois de
	                  Perks.SECOND_CHANCE_DELAY s (uma por etapa). O CampaignRuntime chama secondChance().

	As melhorias permanentes não passam por aqui: cada sistema lê o atributo Perk<Id> publicado pelo
	StoreService (bateria: PlayerStateService; barulho: CreatureService; resgate: CampaignRuntime;
	fôlego: CharacterController no cliente).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local StoreService = require("./StoreService")

local log = Logger.new("PerkService")
-- Etapa em que cada consumível já foi usado por jogador (uma vez por etapa).
local usedAt: { [Player]: { [string]: string } } = {}
-- Espera o renascimento/congelamento do começo de etapa antes de somar a pilha.
local BATTERY_DELAY = 4

local PerkService = {
	Name = "PerkService",
}

-- Identifica a etapa atual: campanha (id + etapa) ou rodada solo.
local function stageKey(): string
	local campaign = ReplicatedStorage:FindFirstChild("CampaignState")
	if campaign and GameState.get("CampaignActive") then
		return `c{GameState.get("RoundId")}:{campaign:GetAttribute("Stage")}`
	end
	return `s{GameState.get("RoundId")}`
end

local function markUsed(player: Player, id: string, key: string): boolean
	local used = usedAt[player] or {}
	usedAt[player] = used
	if used[id] == key then
		return false
	end
	used[id] = key
	return true
end

local function giveExtraBattery(key: string)
	for _, player in Players:GetPlayers() do
		local status = player:GetAttribute("CampaignStatus")
		if (status == nil or status == "Active") and StoreService.inLoadout(player, "pilha_extra") then
			-- Uma reserva por vez: quem ainda tem a da etapa anterior não gasta outra.
			if
				player:GetAttribute("SpareBattery") ~= true
				and markUsed(player, "pilha_extra", key)
				and StoreService.consume(player, "pilha_extra")
			then
				player:SetAttribute("SpareBattery", true)
				log.info("%s armed a spare battery", player.Name)
			end
		end
	end
end

--[[
	Chamado pelo CampaignRuntime logo depois de alguém ser pego. Com Segunda Chance no kit (e ainda
	não usada nesta etapa), gasta uma e agenda `revive` (o runtime valida e levanta o jogador).
]]
function PerkService.secondChance(player: Player, revive: () -> ()): boolean
	if not StoreService.inLoadout(player, "segunda_chance") then
		return false
	end
	if not markUsed(player, "segunda_chance", stageKey()) then
		return false
	end
	if not StoreService.consume(player, "segunda_chance") then
		return false
	end
	player:SetAttribute("SecondChanceAt", workspace:GetServerTimeNow() + Perks.SECOND_CHANCE_DELAY)
	log.info("%s second chance in %ds", player.Name, Perks.SECOND_CHANCE_DELAY)
	task.delay(Perks.SECOND_CHANCE_DELAY, revive)
	return true
end

function PerkService.Start()
	GameState.observe(function(snapshot, changed)
		-- Começo de etapa: a fase entra em Playing (campanha: a cada etapa; solo: depois da cartela).
		if changed == "Phase" and snapshot.phase == "Playing" then
			local key = stageKey()
			task.delay(BATTERY_DELAY, function()
				if GameState.get("Phase") == "Playing" and stageKey() == key then
					giveExtraBattery(key)
				end
			end)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		usedAt[player] = nil
	end)
end

return PerkService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="474">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlayerDataService: carrega, mantém em memória e salva os dados de cada jogador.

	- Retry com backoff em toda chamada de DataStore (Util/Retry).
	- Autosave periódico (Config.Data.AutosaveInterval).
	- Salva ao sair (PlayerRemoving) e no desligamento (BindToClose), esperando os saves pendentes.
	- Modo mock automático no Studio quando não há acesso às APIs (ou a place não é publicada).
	  Em servidor ao vivo NUNCA usa mock: falha de load = kick (evita sobrescrever dados reais).
	- No Studio em modo real, usa um DataStore separado (sufixo "_Studio").

	API:
		PlayerDataService.get(player)                 -> PlayerData? (tabela viva; não guarde referência)
		PlayerDataService.waitFor(player, timeout?)   -> PlayerData? (yield)
		PlayerDataService.update(player, mutator)     -> boolean
		PlayerDataService.save(player)                -> boolean (yield)
		PlayerDataService.getMode()                   -> ("real" | "mock", motivo)

	Trava de sessão (Server/Data/SessionLock): o load reserva os dados para este servidor
	(UpdateAsync); o save nunca sobrescreve a trava válida de OUTRO servidor (reconexão rápida);
	o autosave renova a trava e a saída do jogador a libera. Necessário com compras em Robux.
	Ver docs/ARCHITECTURE.md#playerdata.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Retry = require("@game/ReplicatedStorage/Shared/Util/Retry")
local TableUtil = require("@game/ReplicatedStorage/Shared/Util/TableUtil")
local Types = require("@game/ReplicatedStorage/Shared/Types")
local MockDataStore = require("../Data/MockDataStore")
local PlayerDataSchema = require("../Data/PlayerDataSchema")
local SessionLock = require("../Data/SessionLock")

type Store = MockDataStore.Store

type Profile = {
	key: string,
	data: Types.PlayerData,
}

local log = Logger.new("PlayerDataService")

local mode: Types.DataMode = "mock"
local modeReason = "not initialized"
local store: Store? = nil
local profiles: { [Player]: Profile } = {}
local pendingSaves = 0
local shuttingDown = false

local function storeName(): string
	if RunService:IsStudio() then
		return Config.Data.StoreName .. "_Studio"
	end
	return Config.Data.StoreName
end

local function chooseMode(): (Types.DataMode, string)
	if not RunService:IsStudio() then
		return "real", "live server"
	end
	local studioMode = Config.Data.StudioMode
	if studioMode == "mock" then
		return "mock", "Config.Data.StudioMode = mock"
	end
	if game.GameId == 0 then
		if studioMode == "real" then
			error("[PlayerDataService] StudioMode is 'real' but the place is not published")
		end
		return "mock", "place not published (GameId = 0)"
	end
	local ok, err = pcall(function()
		DataStoreService:GetDataStore(storeName()):GetAsync("__probe")
	end)
	if ok then
		return "real", "Studio has API access"
	end
	if studioMode == "real" then
		error(`[PlayerDataService] StudioMode is 'real' but DataStore is unavailable: {err}`)
	end
	return "mock", `no API access: {err}`
end

local function getStore(): Store
	assert(store, "[PlayerDataService] used before Init")
	return store
end

local function retryOptions(label: string): Retry.Options
	return {
		attempts = Config.Data.RetryAttempts,
		baseDelay = Config.Data.RetryBaseDelay,
		maxDelay = 10,
		onRetry = function(attempt: number, err: string, delay: number)
			log.warn("%s failed (attempt %d), retrying in %.1fs: %s", label, attempt, delay, err)
		end,
	}
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- `release` = jogador saindo: grava sem trava (outro servidor pode assumir na hora).
local function saveProfile(player: Player, profile: Profile, release: boolean?): boolean
	local snapshot = TableUtil.deepCopy(profile.data)
	local userId = player.UserId
	local job = jobId()
	local blocked = false
	snapshot.sessionLock = if release then nil else SessionLock.make(job, os.time())
	pendingSaves += 1
	local ok, _, err = Retry.run(function()
		blocked = false
		return getStore():UpdateAsync(profile.key, function(current: any)
			local lock = if type(current) == "table" then current.sessionLock else nil
			if not SessionLock.canTake(lock, job, os.time()) then
				-- Outro servidor assumiu este jogador (reconexão): não sobrescrever.
				blocked = true
				return nil
			end
			-- userIds associa a chave ao jogador (pedidos de remoção de dados / GDPR).
			return snapshot, { userId }
		end)
	end, retryOptions(`save {profile.key}`))
	pendingSaves -= 1
	if blocked then
		log.warn("save skipped for %s: session lock held by another server", player.Name)
		return false
	end
	if ok then
		log.debug("saved %s", player.Name)
		player:SetAttribute("HousePreferencesSaveMode", mode)
		player:SetAttribute("HousePreferencesSaved", HttpService:JSONEncode(snapshot.house.preferences))
	else
		log.error("save failed for %s: %s", player.Name, err or "?")
	end
	return ok
end

-- Lê os dados e reserva a sessão. Espera um pouco se outro servidor ainda segura a trava
-- (ex.: ainda salvando a saída anterior); depois de `Attempts`, assume (servidor antigo caiu).
local function acquire(key: string): (boolean, any, string?)
	local job = jobId()
	for attempt = 1, SessionLock.Attempts do
		local force = attempt == SessionLock.Attempts
		local taken = false
		local loaded: any = nil
		local ok, _, err = Retry.run(function()
			return getStore():UpdateAsync(key, function(current: any)
				local lock = if type(current) == "table" then current.sessionLock else nil
				if not force and not SessionLock.canTake(lock, job, os.time()) then
					return nil
				end
				local value = if type(current) == "table" then current else {}
				value.sessionLock = SessionLock.make(job, os.time())
				taken = true
				loaded = value
				return value
			end)
		end, retryOptions(`load {key}`))
		if not ok then
			return false, nil, err
		end
		if taken then
			if force then
				log.warn("took over a stale session lock for %s", key)
			end
			return true, loaded, nil
		end
		task.wait(SessionLock.RetryDelay)
	end
	return false, nil, "session lock busy"
end

local function loadProfile(player: Player)
	local key = `Player_{player.UserId}`
	local ok, raw, err = acquire(key)

	if player.Parent == nil then
		return -- saiu durante o load; nada mudou, nada a salvar
	end
	if not ok then
		log.error("load failed for %s: %s", player.Name, err or "?")
		if Config.Data.KickOnLoadFailure then
			player:Kick("Could not load your data. Please rejoin in a moment.")
		end
		return
	end

	local data = PlayerDataSchema.migrate(raw)
	local now = os.time()
	if data.firstJoin == 0 then
		data.firstJoin = now
	end
	data.lastJoin = now
	data.sessions += 1
	profiles[player] = { key = key, data = data }
	log.info("loaded %s (mode=%s, sessions=%d)", player.Name, mode, data.sessions)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	profiles[player] = nil
	saveProfile(player, profile, true)
end

local function onShutdown()
	shuttingDown = true
	for player, profile in profiles do
		profiles[player] = nil
		task.spawn(saveProfile, player, profile, true)
	end
	local deadline = os.clock() + Config.Data.ShutdownTimeout
	while pendingSaves > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
	if pendingSaves > 0 then
		log.error("shutdown with %d saves still pending", pendingSaves)
	end
end

local function autosaveLoop()
	while not shuttingDown do
		task.wait(Config.Data.AutosaveInterval)
		for player, profile in profiles do
			task.spawn(saveProfile, player, profile)
		end
	end
end

local PlayerDataService = {
	Name = "PlayerDataService",
}

function PlayerDataService.Init()
	mode, modeReason = chooseMode()
	if mode == "real" then
		store = DataStoreService:GetDataStore(storeName()) :: any
	else
		store = MockDataStore.new()
	end
	log.info("mode=%s (%s)", mode, modeReason)
end

function PlayerDataService.Start()
	Players.PlayerAdded:Connect(loadProfile)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end
	game:BindToClose(onShutdown)
	task.spawn(autosaveLoop)
end

function PlayerDataService.get(player: Player): Types.PlayerData?
	local profile = profiles[player]
	return if profile then profile.data else nil
end

function PlayerDataService.waitFor(player: Player, timeout: number?): Types.PlayerData?
	local deadline = os.clock() + (timeout or 10)
	while profiles[player] == nil and player.Parent ~= nil and os.clock() < deadline do
		task.wait(0.1)
	end
	return PlayerDataService.get(player)
end

-- Altera os dados do jogador. Retorna false se os dados ainda não foram carregados.
function PlayerDataService.update(player: Player, mutator: (data: Types.PlayerData) -> ()): boolean
	local profile = profiles[player]
	if profile == nil then
		return false
	end
	mutator(profile.data)
	return true
end

function PlayerDataService.save(player: Player): boolean
	local profile = profiles[player]
	if profile == nil then
		return false
	end
	return saveProfile(player, profile)
end

function PlayerDataService.getMode(): (Types.DataMode, string)
	return mode, modeReason
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="475">
          <Properties>
            <string name="Name">PlayerStateService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlayerStateService: estado do CORPO do jogador no servidor (autoritativo).

	- Postura (remote SetStance): agachar baixa o corpo (HipHeight) e a velocidade; levantar só
	  com espaço acima da cabeça (mesma checagem do cliente, feita de novo aqui).
	- Lanterna com bateria (remote SetFlashlight): o cliente pede, o servidor decide pela carga
	  (BatteryModel). Publica a carga no atributo "Battery" (só quando muda o bastante).
	- Esconderijo: entrar/sair do armário (pedido via Interact, tratado pelo RoundService) e
	  segurar a respiração (remote SetHoldBreath), com arquejo forçado que faz barulho.
	- Validação de velocidade: mede o deslocamento real e devolve o jogador à última posição
	  válida se passar do limite da postura por tempo demais (PlayerRules).

	Atributos no Player (replicam para o cliente; o CreatureService lê os do esconderijo):
	  Stance, Battery, Flashlight, Hidden (id ou ""), HiddenAt (Vector3), HiddenSeen (bool),
	  HideEye (CFrame), HoldBreath (bool), Gasps (contador)
]]

local Players = game:GetService("Players")

local BatteryModel = require("@game/ReplicatedStorage/Shared/Game/BatteryModel")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Oxygen = require("../Game/Oxygen")
local CreatureService: any = nil
local PlayerRules = require("../Game/PlayerRules")
local ServerNet = require("../Net/ServerNet")

type Stance = PlayerRules.Stance

type PlayerState = {
	stance: Stance,
	battery: BatteryModel.State,
	wantsLight: boolean,
	publishedBattery: number,
	breath: PlayerRules.Breath,
	oxygen: Oxygen.State,
	breathNoiseAt: number,
	movementNoiseAt: number,
	hidden: string?,
	hideExit: CFrame?,
	lastExitAt: number,
	speedCheck: PlayerRules.SpeedCheck,
	lastPosition: Vector3?,
	lastValid: CFrame?,
	gasps: number,
}

local P = Config.Player
local TICK = 0.2
local log = Logger.new("PlayerStateService")

local states: { [Player]: PlayerState } = {}
local noiseHandler: ((position: Vector3, radius: number) -> ())? = nil

local function newState(): PlayerState
	return {
		stance = "Stand",
		battery = BatteryModel.new(),
		wantsLight = true,
		publishedBattery = -1,
		breath = PlayerRules.newBreath(),
		oxygen = Oxygen.new(),
		breathNoiseAt = 0,
		movementNoiseAt = 0,
		hidden = nil,
		hideExit = nil,
		lastExitAt = -math.huge,
		speedCheck = PlayerRules.newSpeedCheck(),
		lastPosition = nil,
		lastValid = nil,
		gasps = 0,
	}
end

local function stateOf(player: Player): PlayerState
	local state = states[player]
	if not state then
		state = newState()
		states[player] = state
	end
	return state
end

local function parts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return character, if root and root:IsA("BasePart") then root else nil, humanoid
end

local function isPlaying(): boolean
	return GameState.get("Phase") == "Playing"
end

local function standHipHeight(character: Model, humanoid: Humanoid): number
	local stored = character:GetAttribute("StandHipHeight")
	if type(stored) == "number" then
		return stored
	end
	character:SetAttribute("StandHipHeight", humanoid.HipHeight)
	return humanoid.HipHeight
end

local function publishLight(player: Player, state: PlayerState)
	player:SetAttribute(Tags.Attr.Flashlight, state.battery.on)
end

local function publishBattery(player: Player, state: PlayerState, force: boolean?)
	local charge = math.floor(state.battery.charge * 200 + 0.5) / 200
	if force or math.abs(charge - state.publishedBattery) >= 0.005 then
		state.publishedBattery = charge
		player:SetAttribute("Battery", charge)
	end
end

-- Há espaço para levantar? (topo da cabeça agachado ~ raiz + 2.3; precisa de CrouchDrop + folga)
local function canStand(character: Model, root: BasePart): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.RespectCanCollide = true
	params.CollisionGroup = root.CollisionGroup
	local height = P.CrouchDrop + P.StandClearance
	local center = root.Position + Vector3.new(0, 2.3 + height / 2, 0)
	return #workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(1.6, height, 1.2), params) == 0
end

local function applyStance(player: Player, state: PlayerState, stance: Stance)
	local character, _, humanoid = parts(player)
	if not character or not humanoid then
		return
	end
	local stand = standHipHeight(character, humanoid)
	state.stance = stance
	humanoid.HipHeight = if stance == "Crouch" then math.max(0.25, stand - P.CrouchDrop) else stand
	humanoid.WalkSpeed = PlayerRules.walkSpeed(stance)
	humanoid.JumpHeight = if stance == "Crouch" then 0 else P.JumpHeight
	player:SetAttribute("Stance", stance)
end

local function setStance(player: Player, stance: Stance)
	local state = stateOf(player)
	local character, root, humanoid = parts(player)
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if state.hidden or not isPlaying() or state.stance == stance then
		-- Responde com o estado atual (o cliente corrige a previsão).
		player:SetAttribute("Stance", state.stance)
		return
	end
	if stance == "Stand" and not canStand(character, root) then
		player:SetAttribute("Stance", state.stance)
		return
	end
	applyStance(player, state, stance)
end

local function setFlashlight(player: Player, on: boolean)
	local state = stateOf(player)
	if Config.House.Enabled and player:GetAttribute("HasFlashlight") ~= true then
		on = false
	end
	state.wantsLight = on
	BatteryModel.setOn(state.battery, on)
	publishLight(player, state)
end

local function setHoldBreath(player: Player, hold: boolean)
	local state = stateOf(player)
	local _, _, humanoid = parts(player)
	if
		hold
		and (
			not isPlaying()
			or player:GetAttribute("CampaignStatus") ~= "Active"
			or not humanoid
			or humanoid.Health <= 0
		)
	then
		return
	end
	Oxygen.request(state.oxygen, hold, os.clock())
	player:SetAttribute("HoldBreath", state.oxygen.holding)
end

local function validateSpeed(player: Player, state: PlayerState, now: number)
	local character, root, humanoid = parts(player)
	if not character or not root or not humanoid or root.Anchored or state.hidden or not isPlaying() then
		state.lastPosition = nil
		return
	end
	local position = root.Position
	local last = state.lastPosition
	state.lastPosition = position
	if not last then
		state.lastValid = root.CFrame
		return
	end
	local delta = position - last
	local speed = Vector3.new(delta.X, 0, delta.Z).Magnitude / TICK
	local verdict = PlayerRules.checkSpeed(state.speedCheck, speed, PlayerRules.maxSpeed(state.stance), now)
	if verdict == "ok" then
		state.lastValid = root.CFrame
	elseif verdict == "correct" and state.lastValid then
		log.warn("speed check: %s moved %.1f studs/s (stance %s); correcting", player.Name, speed, state.stance)
		character:PivotTo(state.lastValid)
		state.lastPosition = nil
	end
end

local function tick()
	local now = os.clock()
	for player, state in states do
		if player.Parent == nil then
			continue
		end
		-- Melhoria "Bateria de Lítio" (nível publicado pelo StoreService): a carga dura mais.
		local level = tonumber(player:GetAttribute("PerkBateria")) or 0
		if BatteryModel.step(state.battery, TICK, 1 / Perks.factor("bateria", level)) then
			-- Pilha reserva (consumível Pilha Extra, armado pelo PerkService): entra sozinha.
			if player:GetAttribute("SpareBattery") == true then
				player:SetAttribute("SpareBattery", false)
				BatteryModel.addPickup(state.battery, Perks.EXTRA_BATTERY)
				if state.wantsLight then
					BatteryModel.setOn(
						state.battery,
						not Config.House.Enabled or player:GetAttribute("HasFlashlight") == true
					)
				end
				log.info("%s spare battery kicked in", player.Name)
			else
				log.info("%s flashlight died (battery empty)", player.Name)
			end
			publishLight(player, state)
			publishBattery(player, state, true)
		end
		publishBattery(player, state)

		local _, root, humanoid = parts(player)
		local active = isPlaying()
			and player:GetAttribute("CampaignStatus") == "Active"
			and humanoid
			and humanoid.Health > 0
		if not active then
			Oxygen.request(state.oxygen, false, now)
		end
		if active and Oxygen.step(state.oxygen, TICK, now) then
			player:SetAttribute("DeathCause", "oxygen")
			if humanoid then
				humanoid.Health = 0
			end
		end
		player:SetAttribute("Oxygen", math.floor(state.oxygen.value))
		player:SetAttribute("HoldBreath", state.oxygen.holding)
		local creature = CreatureService and CreatureService.state()
		local distance = if creature
				and creature.active
				and root
			then (root.Position - creature.position).Magnitude
			else math.huge
		local intensity = if distance < 18 then 1 elseif distance < 35 then 0.7 elseif distance < 65 then 0.3 else 0
		player:SetAttribute("BreathIntensity", if state.oxygen.holding then 0 else intensity)
		if active and root and not state.oxygen.holding and intensity >= 0.7 and now >= state.breathNoiseAt then
			state.breathNoiseAt = now + 1.2
			if noiseHandler then
				noiseHandler(root.Position, 18)
			end
		end
		if active and root and not state.hidden and now >= state.movementNoiseAt then
			local velocity = root.AssemblyLinearVelocity
			local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			if speed > 1 then
				state.movementNoiseAt = now + 0.4
				local radius = if state.stance == "Crouch" then 3 elseif speed > P.WalkSpeed + 2 then 35 else 8
				local factor =
					math.max(0.5, Perks.factor("silencio", tonumber(player:GetAttribute("PerkSilencio")) or 0))
				if noiseHandler then
					noiseHandler(root.Position, radius * factor)
				end
			end
		end
		validateSpeed(player, state, now)
	end
end

local PlayerStateService = {
	Name = "PlayerStateService",
}

function PlayerStateService.Start()
	CreatureService = require("./CreatureService")
	ServerNet.onEvent("SetFlashlight", {
		args = { Guard.boolean() },
		rateLimit = { capacity = 10, refillPerSecond = 5 },
	}, setFlashlight)

	ServerNet.onEvent("SetStance", {
		args = { Guard.literal("Stand", "Crouch") },
		rateLimit = { capacity = 8, refillPerSecond = 4 },
	}, function(player: Player, stance: Stance)
		setStance(player, stance)
	end)

	ServerNet.onEvent("SetHoldBreath", {
		args = { Guard.boolean() },
		rateLimit = { capacity = 8, refillPerSecond = 4 },
	}, setHoldBreath)

	Players.PlayerRemoving:Connect(function(player: Player)
		states[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local ok, err = pcall(tick :: () -> any)
			if not ok then
				log.error("tick failed: %s", tostring(err))
			end
		end
	end)
end

-- Barulho do jogador (arquejo). O RoundService liga isto ao CreatureService.
function PlayerStateService.setNoiseHandler(handler: (position: Vector3, radius: number) -> ())
	noiseHandler = handler
end

-- Personagem novo (rodada ou checkpoint): de pé, visível, lanterna pedida, bateria dada.
function PlayerStateService.resetForSpawn(player: Player, battery: number?)
	local previous = states[player]
	local state = newState()
	if previous then
		state.gasps = previous.gasps
	end
	state.battery = BatteryModel.new(battery)
	states[player] = state
	local character, root, humanoid = parts(player)
	if character and humanoid then
		standHipHeight(character, humanoid)
	end
	applyStance(player, state, "Stand")
	BatteryModel.setOn(state.battery, not Config.House.Enabled or player:GetAttribute("HasFlashlight") == true)
	publishLight(player, state)
	publishBattery(player, state, true)
	player:SetAttribute("Hidden", "")
	player:SetAttribute("HiddenSeen", false)
	player:SetAttribute("HoldBreath", false)
	player:SetAttribute("Gasps", state.gasps)
	state.lastValid = if root then root.CFrame else nil
end

-- Teleporte legítimo (spawn, debug, sair do armário): não conta como velocidade.
function PlayerStateService.markTeleported(player: Player)
	local state = stateOf(player)
	state.lastPosition = nil
	state.speedCheck.overSince = nil
	local _, root = parts(player)
	state.lastValid = if root then root.CFrame else state.lastValid
end

function PlayerStateService.stance(player: Player): Stance
	return stateOf(player).stance
end

function PlayerStateService.isHidden(player: Player): boolean
	return stateOf(player).hidden ~= nil
end

function PlayerStateService.hiddenId(player: Player): string?
	return stateOf(player).hidden
end

function PlayerStateService.sinceExit(player: Player): number
	return os.clock() - stateOf(player).lastExitAt
end

--[[
	Entra no armário `id`: o corpo fica ancorado em `inside`, a câmera do cliente olha por `eye`
	(atributo HideEye) e sai em `exit`. `sawEntry` = o Vigia viu entrar.
]]
function PlayerStateService.enterHide(
	player: Player,
	id: string,
	inside: CFrame,
	eye: CFrame,
	exit: CFrame,
	front: Vector3,
	sawEntry: boolean
): boolean
	local state = stateOf(player)
	local character, root = parts(player)
	if not character or not root or state.hidden then
		return false
	end
	if state.stance ~= "Stand" then
		applyStance(player, state, "Stand")
	end
	state.hidden = id
	state.hideExit = exit
	Oxygen.request(state.oxygen, false, os.clock())
	root.Anchored = true
	character:PivotTo(inside)
	player:SetAttribute("HiddenAt", front)
	player:SetAttribute("HiddenSeen", sawEntry)
	player:SetAttribute("HideEye", eye)
	player:SetAttribute("HoldBreath", false)
	player:SetAttribute("Hidden", id)
	log.info("%s hid in %s (seen=%s)", player.Name, id, tostring(sawEntry))
	return true
end

function PlayerStateService.exitHide(player: Player): boolean
	local state = stateOf(player)
	local character, root = parts(player)
	if not state.hidden then
		return false
	end
	local exit = state.hideExit
	state.hidden = nil
	state.hideExit = nil
	state.lastExitAt = os.clock()
	Oxygen.request(state.oxygen, false, os.clock())
	if character and root then
		if exit then
			character:PivotTo(exit)
		end
		root.Anchored = not isPlaying()
	end
	player:SetAttribute("Hidden", "")
	player:SetAttribute("HiddenSeen", false)
	player:SetAttribute("HoldBreath", false)
	PlayerStateService.markTeleported(player)
	return true
end

function PlayerStateService.battery(player: Player): number
	return stateOf(player).battery.charge
end

function PlayerStateService.addBattery(player: Player, amount: number?)
	local state = stateOf(player)
	BatteryModel.addPickup(state.battery, amount)
	-- Se o jogador queria luz e ela tinha apagado, volta a acender.
	if state.wantsLight and not state.battery.on then
		BatteryModel.setOn(state.battery, not Config.House.Enabled or player:GetAttribute("HasFlashlight") == true)
		publishLight(player, state)
	end
	publishBattery(player, state, true)
end

function PlayerStateService.addOxygen(player: Player, amount: number): boolean
	local state = stateOf(player).oxygen
	if state.dead then
		return false
	end
	state.value = math.min(100, state.value + amount)
	return true
end
function PlayerStateService.grantFlashlight(player: Player)
	player:SetAttribute("HasFlashlight", true)
	setFlashlight(player, true)
end
function PlayerStateService.snapshot(player: Player): { [string]: any }
	local state = stateOf(player)
	return {
		stance = state.stance,
		battery = state.battery.charge,
		light = state.battery.on,
		hidden = state.hidden,
		holding = state.breath.holding,
	}
end

return PlayerStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="476">
          <Properties>
            <string name="Name">PresenceService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PresenceService: o "olhar" de cada jogador para os colegas verem (cabeça e lanterna apontando
	para onde ele olha). O cliente manda só o pitch da câmera (graus), quantizado e espaçado
	(CharacterPose.SEND_INTERVAL); aqui o valor é revalidado e vira o atributo "LookPitch" do Player.

	Puramente visual: nenhuma regra de jogo (visão do Vigia, interação, dano) lê este atributo.
	O yaw não precisa de rede: a rotação do HumanoidRootPart já replica.
]]

local Players = game:GetService("Players")

local CharacterPose = require("@game/ReplicatedStorage/Shared/Game/CharacterPose")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local ServerNet = require("../Net/ServerNet")

local ATTRIBUTE = "LookPitch"

local PresenceService = {
	Name = "PresenceService",
	ATTRIBUTE = ATTRIBUTE,
}

function PresenceService.Start()
	ServerNet.onEvent("SetLook", {
		args = { Guard.number({ min = -90, max = 90 }) },
		-- Cliente envia no máximo 8/s e só quando muda; folga para rajadas curtas.
		rateLimit = { capacity = 12, refillPerSecond = 9 },
	}, function(player: Player, pitch: number)
		player:SetAttribute(ATTRIBUTE, CharacterPose.quantizePitch(pitch))
	end)
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute(ATTRIBUTE, 0)
	end)
	for _, player in Players:GetPlayers() do
		player:SetAttribute(ATTRIBUTE, 0)
	end
end

return PresenceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="477">
          <Properties>
            <string name="Name">PropService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PropService: objetos que caem (balde, latas, garrafas, canos, extintor, caixa).

	Passar perto deles rápido (andando/correndo) derruba: física no servidor, som de impacto e
	BARULHO que atrai o Vigia. Agachado ou devagar não derruba. Limites contra spam:
	cada objeto cai uma vez por rodada (Cooldown entre quedas, se recolocado) e há um intervalo
	global entre barulhos (GlobalCooldown). Tudo volta ao lugar a cada rodada (reset).
]]

local Players = game:GetService("Players")

local Config = require("@game/ReplicatedStorage/Shared/Config")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local FeatureBuilder = require("../World/FeatureBuilder")
local CreatureService = require("./CreatureService")
local WorldService = require("./WorldService")

local F = Config.Fallables
local TICK = 0.1
local log = Logger.new("PropService")

local lastNoiseAt = -math.huge
local lastFallAt: { [string]: number } = {}
local generation = 0

local function fall(item: FeatureBuilder.FallableHandle, from: Vector3)
	local now = os.clock()
	item.fallen = true
	lastFallAt[item.id] = now
	item.model:SetAttribute("Fallen", true)
	local primary = item.primary
	primary.Anchored = false
	pcall(function()
		primary:SetNetworkOwner(nil)
	end)
	-- Empurrão na direção de queda (e para longe de quem esbarrou) + giro.
	local away = primary.Position - from
	away = Vector3.new(away.X, 0, away.Z)
	local direction = item.fall + (if away.Magnitude > 0.1 then away.Unit * 0.6 else Vector3.zero)
	local mass = primary.AssemblyMass
	primary:ApplyImpulse((direction.Unit * 9 + Vector3.new(0, 4, 0)) * mass)
	primary:ApplyAngularImpulse(Vector3.new(direction.Z, 0, -direction.X) * 6 * mass)

	local myGeneration = generation
	task.delay(0.35, function()
		if myGeneration ~= generation then
			return
		end
		item.sound:Play()
		if now - lastNoiseAt >= F.GlobalCooldown then
			lastNoiseAt = now
			local p = primary.Position
			CreatureService.makeNoise(Vector3.new(p.X, 0, p.Z), F.NoiseRadius)
			log.info("%s fell (noise)", item.id)
		end
	end)
	-- Depois de assentar, volta a ficar ancorado onde parou (sem física rolando para sempre).
	task.delay(F.ResetAfter, function()
		if myGeneration == generation and item.fallen then
			primary.Anchored = true
		end
	end)
end

local function tick()
	if GameState.get("Phase") ~= "Playing" then
		return
	end
	local now = os.clock()
	for _, item in WorldService.features().fallables do
		if item.fallen or now - (lastFallAt[item.id] or -math.huge) < F.Cooldown then
			continue
		end
		local position = item.primary.Position
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and not root.Anchored then
				local delta = root.Position - position
				local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				if flat <= F.TriggerRadius and math.abs(delta.Y) < 6 and speed >= F.TriggerSpeed then
					fall(item, root.Position)
					break
				end
			end
		end
	end
end

local PropService = {
	Name = "PropService",
}

function PropService.Start()
	task.spawn(function()
		while true do
			task.wait(TICK)
			local ok, err = pcall(tick :: () -> any)
			if not ok then
				log.error("tick failed: %s", tostring(err))
			end
		end
	end)
	-- Nova rodada (Intro): tudo de volta ao lugar.
	GameState.observe(function(snapshot, changed)
		if changed == "Phase" and snapshot.phase == "Intro" then
			PropService.reset()
		end
	end)
end

function PropService.reset()
	generation += 1
	lastNoiseAt = -math.huge
	table.clear(lastFallAt)
	for _, item in WorldService.features().fallables do
		item.fallen = false
		item.primary.Anchored = true
		item.primary.AssemblyLinearVelocity = Vector3.zero
		item.primary.AssemblyAngularVelocity = Vector3.zero
		for part, home in item.home do
			part.CFrame = home
		end
		item.model:SetAttribute("Fallen", false)
	end
end

-- Depuração: derruba um objeto pelo id.
function PropService.debugFall(id: string): boolean
	for _, item in WorldService.features().fallables do
		if item.id == id and not item.fallen then
			fall(item, item.primary.Position - item.fall)
			return true
		end
	end
	return false
end

return PropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="478">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RewardService: recompensa de fim de partida (Fichas + XP) para cada jogador.

	Não altera os runtimes da rodada: só observa o estado já replicado.
	  solo      GameState.Phase -> Won/Lost (fusíveis e disjuntores do GameState);
	  campanha  ReplicatedStorage.CampaignState (Phase Won/Lost, Stage, Roster com status e
	            contribuições de cada membro).
	Cada partida (GameState.RoundId) paga uma vez só. A tela de resultado do cliente recebe
	os números via StoreService.awardRun -> StoreNotice. O SKU de analytics diz modo e resultado
	(solo_won, solo_lost, campaign_won, campaign_lost): fonte de Fichas por tipo de partida.

	Modo história: cada capítulo vencido (CampaignState Phase -> Intermission ou Won com
	GameMode "Story") paga as recompensas de capítulo (Shared/Game/StoryRewards) a quem participou.
	"Sem quedas" = ninguém da equipe ficou Downed durante o capítulo (lido do Roster replicado).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local CampaignMode = require("../Campaign/CampaignMode")
local StoreService = require("./StoreService")

local log = Logger.new("RewardService")
local awarded: { [string]: boolean } = {}
-- História: capítulos já pagos (por rodada + capítulo) e se alguém caiu no capítulo atual.
local storyPaid: { [string]: boolean } = {}
local chapterHadDown = false

local function soloSummary(won: boolean): Economy.RunSummary
	return {
		won = won,
		escaped = won,
		stages = 0,
		fuses = GameState.get("FusesCollected") or 0,
		breakers = GameState.get("BreakersOn") == true,
		contributions = 0,
	}
end

local function campaignAwards(won: boolean)
	local state = ReplicatedStorage:FindFirstChild("CampaignState")
	if not state then
		return
	end
	local ok, roster = pcall(function()
		return HttpService:JSONDecode((state:GetAttribute("Roster") :: string?) or "[]")
	end)
	if not ok or type(roster) ~= "table" then
		return
	end
	local stage = (state:GetAttribute("Stage") :: number?) or 1
	local cleared = if won then stage else math.max(0, stage - 1)
	for _, member in roster do
		local player = Players:GetPlayerByUserId(member.id)
		if player then
			StoreService.awardRun(player, {
				won = won,
				escaped = won and member.status ~= "Downed",
				stages = cleared,
				fuses = 0,
				breakers = false,
				contributions = tonumber(member.contributions) or 0,
			}, if won then "campaign_won" else "campaign_lost")
		end
	end
end

local function onEnd(phase: string)
	local round = GameState.get("RoundId") or 0
	local key = `{round}:{phase}`
	if awarded[key] then
		return
	end
	awarded[key] = true
	local won = phase == "Won"
	if CampaignMode.enabled() then
		campaignAwards(won)
	else
		for _, player in Players:GetPlayers() do
			StoreService.awardRun(player, soloSummary(won), if won then "solo_won" else "solo_lost")
		end
	end
	log.info("round %d rewards paid (%s)", round, phase)
end

local function decodeRoster(state: Instance): { any }?
	local ok, roster = pcall(function()
		return HttpService:JSONDecode((state:GetAttribute("Roster") :: string?) or "[]")
	end)
	return if ok and type(roster) == "table" then roster else nil
end

local function payChapter(state: Instance)
	local chapter = tonumber(state:GetAttribute("Stage")) or 0
	local key = `{GameState.get("RoundId") or 0}:{chapter}`
	if chapter < 1 or storyPaid[key] then
		return
	end
	storyPaid[key] = true
	local roster = decodeRoster(state)
	if not roster then
		return
	end
	local flawless = not chapterHadDown
	for _, member in roster do
		local player = Players:GetPlayerByUserId(member.id)
		-- Quem só esperou o capítulo (entrou tarde) não recebe o capítulo.
		if player and member.status ~= "Waiting" then
			task.spawn(function()
				for _ = 1, 30 do
					if not player.Parent then
						return
					end
					if StoreService.awardStory(player, chapter, flawless) then
						return
					end
					task.wait(1)
				end
				log.warn("chapter reward unavailable: player=%s chapter=%d", player.Name, chapter)
			end)
		end
	end
	log.info("story chapter %d paid (flawless=%s)", chapter, tostring(flawless))
end

local function watchStory(state: Instance)
	local lastPhase = state:GetAttribute("Phase")
	state:GetAttributeChangedSignal("Roster"):Connect(function()
		local roster = decodeRoster(state)
		if roster and state:GetAttribute("Phase") == "Playing" then
			for _, member in roster do
				if member.status == "Downed" or member.deathCause == "oxygen" then
					chapterHadDown = true
				end
			end
		end
	end)
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = state:GetAttribute("Phase")
		if phase == "Playing" and lastPhase ~= "Playing" and lastPhase ~= "Extracting" then
			chapterHadDown = false
		end
		local story = state:GetAttribute("GameMode") == "Story"
		-- Só conta capítulo terminado jogando (a Continuação também passa Lost -> Intermission).
		local finished = lastPhase == "Playing" or lastPhase == "Extracting"
		if story and (phase == "Intermission" or phase == "Won") and finished then
			-- Deixa o runtime publicar Roster/Stage do mesmo quadro.
			task.defer(payChapter, state)
		end
		lastPhase = phase
	end)
end

local RewardService = {
	Name = "RewardService",
}

function RewardService.Start()
	task.spawn(function()
		local state = ReplicatedStorage:WaitForChild("CampaignState", 30)
		if state then
			watchStory(state)
		end
	end)
	GameState.observe(function(snapshot, changed)
		if changed == "Phase" and (snapshot.phase == "Won" or snapshot.phase == "Lost") then
			-- Deixa o runtime terminar de publicar Roster/Stage do mesmo quadro.
			task.defer(onEnd, snapshot.phase)
		end
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="479">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RoundService: dono da rodada (autoritativo).

	Fases: Loading -> Intro -> Playing -> Won | Lost -> (reiniciar tudo | continuar do checkpoint) -> Intro ...
	- Spawna o jogador em primeira pessoa (CharacterAutoLoads desligado: só nasce quando a rodada manda).
	- Trata os remotes Interact / RequestRestart via ServerNet (Guard + rate limit) e valida TODA
	  interação aqui: fase, existência, distância, linha de visão e se a ação é possível.
	  (SetFlashlight / SetStance / SetHoldBreath ficam no PlayerStateService.)
	- Objetivo: fusíveis -> quadro -> disjuntores na ordem -> energia (checkpoint) -> portão -> saída.
	- Publica o estado em ReplicatedStorage.GameState (atributos) para a UI.
]]

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")

local Config = require("@game/ReplicatedStorage/Shared/Config")
-- Um único dono da rodada; o runtime solo abaixo permanece disponível para regressão/polish.
if require("../Campaign/CampaignMode").enabled() then
	return require("../Campaign/CampaignRuntime") :: any
end
local GameState = require("@game/ReplicatedStorage/Shared/Game/GameState")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Types = require("@game/ReplicatedStorage/Shared/Types")
local BreakerPuzzle = require("../Game/BreakerPuzzle")
local Checkpoint = require("../Game/Checkpoint")
local HideRules = require("../Game/HideRules")
local Objectives = require("../Game/Objectives")
local RoundRules = require("../Game/RoundRules")
local ServerNet = require("../Net/ServerNet")
local CollectibleService = require("./CollectibleService")
local CreatureService = require("./CreatureService")
local PlayerStateService = require("./PlayerStateService")
local WorldService = require("./WorldService")

type Response = Types.InteractResponse

local log = Logger.new("RoundService")

local objectives: Objectives.State = Objectives.new(Config.Game.FusesTotal)
local breakers: BreakerPuzzle.State = BreakerPuzzle.new({ 1, 2, 3 })
local checkpoint: Checkpoint.Snapshot? = nil
local phase: RoundRules.Phase = "Loading"
local roundId = 0
local roundSeed = 0
local playingSince = 0
local awakened = false
local started = false
local lastBreakerErrorAt = -math.huge

local function publish()
	GameState.set("FusesTotal", objectives.total)
	GameState.set("FusesCollected", Objectives.collectedCount(objectives))
	GameState.set("FusesHeld", objectives.held)
	GameState.set("FusesInserted", objectives.inserted)
	GameState.set("PowerOn", objectives.powerOn)
	GameState.set("GateOpen", objectives.gateOpen)
	GameState.set("HasKey", objectives.hasKey)
	GameState.set("BreakersOn", objectives.breakersOn)
	GameState.set("Objective", Objectives.objectiveKey(objectives))
	GameState.set("CreatureActive", CreatureService.isActive())
	GameState.set("CheckpointReady", Checkpoint.isUsable(checkpoint))
end

local function setPhase(nextPhase: RoundRules.Phase): boolean
	if not RoundRules.canTransition(phase, nextPhase) then
		log.warn("invalid phase transition %s -> %s", phase, nextPhase)
		return false
	end
	log.info("phase %s -> %s (round %d)", phase, nextPhase, roundId)
	phase = nextPhase
	GameState.set("Phase", nextPhase)
	return true
end

local function characterParts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return character, if hrp and hrp:IsA("BasePart") then hrp else nil, humanoid
end

local function setFrozen(player: Player, frozen: boolean)
	local _, hrp = characterParts(player)
	if hrp and not PlayerStateService.isHidden(player) then
		hrp.Anchored = frozen
	end
end

-- Fim de rodada (uma vez só: só sai de Playing).
local function endRound(player: Player, result: "Won" | "Lost")
	if phase ~= "Playing" then
		return
	end
	-- Horário de fim ANTES da fase: o cliente monta a tela final ao ver a fase mudar.
	GameState.set("RoundEndedAt", workspace:GetServerTimeNow())
	setPhase(result)
	CreatureService.freeze()
	setFrozen(player, true)
	publish()
end

local function spawnPlayer(player: Player, at: CFrame, battery: number?)
	local myRound = roundId
	player:LoadCharacterAsync()
	if myRound ~= roundId then
		return
	end
	local character, _, humanoid = characterParts(player)
	if not character then
		return
	end
	character:PivotTo(at)
	if humanoid then
		humanoid.WalkSpeed = Config.Player.WalkSpeed
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = Config.Player.JumpHeight
		humanoid.Died:Connect(function()
			if phase == "Playing" and myRound == roundId then
				endRound(player, "Lost")
			end
		end)
	end
	PlayerStateService.resetForSpawn(player, battery)
	PlayerStateService.markTeleported(player)
	setFrozen(player, phase ~= "Playing")
end

local function awaken()
	if awakened then
		return
	end
	awakened = true
	CreatureService.activate(nil)
	publish()
end

local function noise(position: Vector3, radius: number)
	CreatureService.makeNoise(position - Vector3.yAxis * position.Y, radius)
end

-- Linha de visão cabeça -> objeto (aceita acertar o próprio objeto ou algo colado nele).
local function canReach(character: Model, item: WorldService.Interactable): boolean
	local head = character:FindFirstChild("Head")
	local origin = if head and head:IsA("BasePart")
		then head.Position
		else (character:GetPivot().Position + Vector3.yAxis * 1.5)
	local targetPosition = item.focus.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local hit = workspace:Raycast(origin, targetPosition - origin, params)
	if hit == nil then
		return true
	end
	if hit.Instance == item.focus or hit.Instance:IsDescendantOf(item.model) then
		return true
	end
	return (hit.Position - targetPosition).Magnitude <= 1.5
end

-- Checkpoint: gravado uma vez por rodada, quando a energia volta.
local function saveCheckpoint(player: Player?)
	if checkpoint and Checkpoint.isUsable(checkpoint) then
		return
	end
	local doors, locked = WorldService.doorSnapshot()
	checkpoint = Checkpoint.capture({
		objectives = objectives,
		doors = doors,
		locked = locked,
		battery = if player then PlayerStateService.battery(player) else Config.Battery.StartCharge,
		breakerOrder = breakers.order,
		taken = WorldService.takenSnapshot(),
	})
	log.info("checkpoint saved (round %d)", roundId)
end

local function powerOn(myRound: number, player: Player?)
	if myRound ~= roundId or phase ~= "Playing" then
		return
	end
	if Objectives.powerOn(objectives) then
		WorldService.setPower(true)
		WorldService.setInteractEnabled("panel", false)
		for i = 1, Config.Puzzle.Breakers do
			WorldService.setInteractEnabled(`breaker_{i}`, false)
		end
		awaken()
		CreatureService.setHunt(true)
		saveCheckpoint(player)
		publish()
		log.info("power restored")
	end
end

local function breakerMask(): { boolean }
	local mask = {}
	for i = 1, Config.Puzzle.Breakers do
		mask[i] = BreakerPuzzle.isUp(breakers, i)
	end
	return mask
end

local function pressBreaker(player: Player, id: string, position: Vector3): Response
	local index = tonumber(string.match(id, "%d+"))
	if not index then
		return { accepted = false, message = "unknown" }
	end
	local can, reason = Objectives.canUseBreakers(objectives)
	if not can then
		WorldService.breakerFeedback("denied")
		return { accepted = false, message = reason or "not_available", kind = "BreakerDenied" }
	end
	if os.clock() - lastBreakerErrorAt < Config.Puzzle.ErrorCooldown then
		return { accepted = false, message = "not_available" }
	end
	local result = BreakerPuzzle.press(breakers, index)
	if result == "already" then
		return { accepted = false, message = "not_available" }
	elseif result == "wrong" then
		lastBreakerErrorAt = os.clock()
		WorldService.breakerFeedback("wrong")
		local myRound = roundId
		task.delay(0.5, function()
			if myRound == roundId and not objectives.breakersOn then
				WorldService.setBreakers(breakerMask())
			end
		end)
		noise(position, Config.Puzzle.ErrorNoiseRadius)
		log.info("breaker wrong order (pressed %d)", index)
		return { accepted = false, message = "breaker_wrong", kind = "BreakerWrong" }
	elseif result == "solved" then
		WorldService.setBreakers(breakerMask())
		WorldService.breakerFeedback("solved")
		Objectives.solveBreakers(objectives)
		noise(position, 30)
		publish()
		task.delay(Config.Game.PowerOnDelay, powerOn, roundId, player)
		return { accepted = true, message = "breakers_done", kind = "BreakerSolved" }
	end
	WorldService.setBreakers(breakerMask())
	WorldService.breakerFeedback("ok")
	noise(position, 10)
	return { accepted = true, message = "breaker_ok", kind = "Breaker" }
end

local function useDoor(player: Player, id: string, action: string, position: Vector3): Response
	if WorldService.isLocked(id) then
		if objectives.hasKey and action ~= "alt" and Objectives.useKey(objectives, id) then
			WorldService.unlockDoor(id, player)
			noise(position, 8)
			publish()
			return { accepted = true, message = "door_unlocking", kind = "Unlock" }
		end
		WorldService.rattleDoor(id)
		noise(position, Config.Doors.RattleNoise)
		return { accepted = false, message = "door_locked", kind = "DoorLocked" }
	end
	if action == "alt" then
		if not WorldService.altDoor(id) then
			return { accepted = false, message = "not_available" }
		end
		noise(position, Config.Doors.CrackNoise)
		return { accepted = true, message = "door_cracked", kind = "Door" }
	end
	local ok, state = WorldService.useDoor(id)
	if not ok then
		return { accepted = false, message = "not_available" }
	end
	noise(position, Config.Doors.OpenNoise)
	return { accepted = true, message = if state == "open" then "door_opened" else "door_closed", kind = "Door" }
end

local function hide(player: Player, id: string, position: Vector3, alive: boolean): Response
	local locker = WorldService.locker(id)
	if not locker then
		return { accepted = false, message = "unknown" }
	end
	if PlayerStateService.hiddenId(player) == id then
		locker.occupant = nil
		PlayerStateService.exitHide(player)
		WorldService.swingLocker(id)
		noise(position, 8)
		return { accepted = true, message = "hide_exit", kind = "HideExit" }
	end
	local ok, reason = HideRules.canEnter({
		playing = phase == "Playing",
		alive = alive,
		occupied = locker.occupant ~= nil and locker.occupant ~= player,
		alreadyHidden = PlayerStateService.isHidden(player),
		sinceExit = PlayerStateService.sinceExit(player),
	})
	if not ok then
		return { accepted = false, message = reason or "not_available" }
	end
	local saw = HideRules.sawEntry(CreatureService.secondsSinceSeen(), CreatureService.isChasing())
	if not PlayerStateService.enterHide(player, id, locker.inside, locker.eye, locker.exit, locker.front, saw) then
		return { accepted = false, message = "not_available" }
	end
	locker.occupant = player
	WorldService.swingLocker(id)
	noise(position, 8)
	return { accepted = true, message = "hide_enter", kind = "Hide" }
end

local function interact(player: Player, id: string, action: string?): Response
	-- Fita VHS colecionável: validada e entregue à equipe pelo CollectibleService.
	if id == CollectibleService.TAPE_ID then
		return CollectibleService.collect(player)
	end
	local character, hrp, humanoid = characterParts(player)
	local item = WorldService.interactable(id)
	local distance = if hrp and item then (hrp.Position - item.focus.Position).Magnitude else math.huge
	local alive = humanoid ~= nil and humanoid.Health > 0
	local ok, reason = RoundRules.validateInteraction({
		phase = phase,
		exists = item ~= nil,
		enabled = item ~= nil and item.enabled,
		alive = alive,
		distance = distance,
		maxDistance = if item then item.maxDistance else 0,
		tolerance = Config.Game.InteractTolerance,
		lineOfSight = character ~= nil and item ~= nil and canReach(character, item),
	})
	if not ok or not item then
		return { accepted = false, message = reason or "unknown" }
	end
	-- Escondido, só dá para sair do armário.
	if PlayerStateService.isHidden(player) and item.kind ~= "Hide" then
		return { accepted = false, message = "not_available" }
	end
	local position = item.focus.Position
	local kind = item.kind

	if kind == "Fuse" then
		local collected, err = Objectives.collect(objectives, id)
		if not collected then
			return { accepted = false, message = err or "not_available" }
		end
		WorldService.setFuseCollected(id)
		CreatureService.setFuses(Objectives.collectedCount(objectives))
		if not awakened then
			task.delay(1.2, function()
				if phase == "Playing" then
					awaken()
				end
			end)
		end
		noise(position, 45)
		publish()
		return { accepted = true, message = "fuse_taken", kind = "Fuse" }
	elseif kind == "Panel" then
		local inserted, err = Objectives.insert(objectives)
		if inserted == 0 then
			return { accepted = false, message = err or "no_fuses" }
		end
		WorldService.setPanelFuses(objectives.inserted)
		noise(position, 30)
		publish()
		return {
			accepted = true,
			message = if Objectives.isPanelComplete(objectives) then "panel_ready" else "fuses_inserted",
			kind = "Panel",
		}
	elseif kind == "Breaker" then
		return pressBreaker(player, id, position)
	elseif kind == "Door" then
		return useDoor(player, id, action or "use", position)
	elseif kind == "Gate" then
		local opened, err = Objectives.openGate(objectives)
		if not opened then
			return { accepted = false, message = err or "not_available" }
		end
		WorldService.openGate()
		noise(position, 200)
		publish()
		return { accepted = true, message = "gate_opening", kind = "Gate" }
	elseif kind == "Note" then
		return { accepted = true, message = "", note = id, kind = "Note" }
	elseif kind == "Key" then
		local takenKey, err = Objectives.takeKey(objectives)
		if not takenKey then
			return { accepted = false, message = err or "not_available" }
		end
		WorldService.setTaken(id)
		publish()
		return { accepted = true, message = "key_taken", kind = "Key" }
	elseif kind == "Battery" then
		WorldService.setTaken(id)
		PlayerStateService.addBattery(player)
		return { accepted = true, message = "battery_taken", kind = "Battery" }
	elseif kind == "Hide" then
		return hide(player, id, position, alive)
	end
	return { accepted = false, message = "unknown" }
end

local function tick()
	if phase ~= "Playing" then
		return
	end
	for _, player in Players:GetPlayers() do
		local _, hrp = characterParts(player)
		if hrp then
			local position = hrp.Position
			if not objectives.enteredBuilding and WorldService.isInsideBuilding(position) then
				objectives.enteredBuilding = true
				publish()
			end
			if Objectives.canWin(objectives) and WorldService.isInExitZone(position) then
				endRound(player, "Won")
				return
			end
			if position.Y < -60 then
				hrp.CFrame = WorldService.spawnCFrame()
				PlayerStateService.markTeleported(player)
			end
		end
	end
	if not awakened and os.clock() - playingSince >= Config.Game.AwakenAfter then
		awaken()
	end
end

local function beginPlaying(myRound: number, delay: number)
	task.delay(delay, function()
		if myRound ~= roundId or phase ~= "Intro" then
			return
		end
		setPhase("Playing")
		playingSince = os.clock()
		GameState.set("RoundStartedAt", workspace:GetServerTimeNow())
		for _, player in Players:GetPlayers() do
			setFrozen(player, false)
		end
	end)
end

-- Fase atual -> Intro (reinício a partir das telas finais ou forçado pela depuração).
local function enterIntro()
	if phase ~= "Loading" and phase ~= "Won" and phase ~= "Lost" then
		-- Reinício forçado (depuração): volta por Lost para manter as transições válidas.
		phase = "Lost"
	end
	setPhase("Intro")
end

-- Começa (ou recomeça) a rodada do zero: mundo, criatura, objetivo, jogadores. Apaga o checkpoint.
local function restart()
	roundId += 1
	local myRound = roundId
	objectives = Objectives.new(Config.Game.FusesTotal)
	checkpoint = nil
	awakened = false
	lastBreakerErrorAt = -math.huge
	roundSeed = Config.Game.FuseSeed or (os.time() + roundId)
	local rng = Random.new(roundSeed)
	WorldService.resetRound(rng)
	breakers = BreakerPuzzle.new(BreakerPuzzle.shuffle(Config.Puzzle.Breakers, function(a: number, b: number): number
		return rng:NextInteger(a, b)
	end))
	local order = BreakerPuzzle.describe(breakers.order)
	WorldService.setProcedure(order)
	GameState.set("BreakerOrder", order)
	CreatureService.reset()
	enterIntro()
	GameState.set("FromCheckpoint", false)
	GameState.set("RoundId", roundId)
	GameState.set("RoundStartedAt", 0)
	GameState.set("RoundEndedAt", 0)
	publish()
	for _, player in Players:GetPlayers() do
		task.spawn(spawnPlayer, player, WorldService.spawnCFrame(), nil)
	end
	beginPlaying(myRound, Config.Game.IntroDuration)
end

-- Continua do checkpoint: mesmo sorteio da rodada, progresso/portas/itens do snapshot, Vigia em trégua.
local function continueFromCheckpoint()
	local snapshot = checkpoint
	if not snapshot or not Checkpoint.isUsable(snapshot) then
		restart()
		return
	end
	local data = Checkpoint.restore(snapshot)
	roundId += 1
	local myRound = roundId
	objectives = data.objectives
	lastBreakerErrorAt = -math.huge
	-- Mesmo sorteio da rodada: fusíveis, chave e pilhas nos mesmos lugares.
	WorldService.resetRound(Random.new(roundSeed))
	for fuseId in objectives.collected do
		WorldService.setFuseCollected(fuseId)
	end
	WorldService.setPanelFuses(objectives.inserted)
	WorldService.applyTaken(data.taken)
	WorldService.applyDoors(data.doors, data.locked)
	breakers = BreakerPuzzle.new(data.breakerOrder)
	breakers.progress = #breakers.order
	breakers.solved = true
	WorldService.setProcedure(BreakerPuzzle.describe(breakers.order))
	WorldService.setBreakers(breakerMask())
	WorldService.setPower(true)
	WorldService.setInteractEnabled("panel", false)
	for i = 1, Config.Puzzle.Breakers do
		WorldService.setInteractEnabled(`breaker_{i}`, false)
	end
	CreatureService.reset()
	CreatureService.setFuses(Objectives.collectedCount(objectives))
	awakened = false
	enterIntro()
	GameState.set("FromCheckpoint", true)
	GameState.set("RoundId", roundId)
	GameState.set("RoundStartedAt", 0)
	GameState.set("RoundEndedAt", 0)
	publish()
	for _, player in Players:GetPlayers() do
		task.spawn(spawnPlayer, player, WorldService.checkpointCFrame(), data.battery)
	end
	-- O Vigia acorda longe de quem voltou e espera a trégua antes de caçar.
	task.delay(0.6, function()
		if myRound ~= roundId then
			return
		end
		awaken()
		CreatureService.setHunt(true)
		CreatureService.holdOff(Config.Checkpoint.GraceTime + Config.Checkpoint.IntroDuration)
		publish()
	end)
	log.info("continuing from checkpoint (round %d)", roundId)
	beginPlaying(myRound, Config.Checkpoint.IntroDuration)
end

local RoundService = {
	Name = "RoundService",
}

function RoundService.Init()
	Players.CharacterAutoLoads = false
	StarterPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
	StarterPlayer.CameraMaxZoomDistance = 0.5
	StarterPlayer.CameraMinZoomDistance = 0.5
	GameState.serverCreate()
	CreatureService.onCapture(function(player: Player)
		endRound(player, "Lost")
	end)
	PlayerStateService.setNoiseHandler(noise)
end

function RoundService.Start()
	ServerNet.onInvoke("Interact", {
		args = {
			Guard.string({ maxLength = 32, pattern = "[%w_]+" }),
			Guard.optional(Guard.literal("use", "alt")),
		},
		rateLimit = { capacity = 6, refillPerSecond = 3 },
	}, interact)

	ServerNet.onInvoke("RequestRestart", {
		args = { Guard.optional(Guard.literal("full", "checkpoint")) },
		rateLimit = { capacity = 2, refillPerSecond = 0.5 },
	}, function(_player: Player, mode: string?): Response
		if not RoundRules.canRestart(phase) then
			return { accepted = false, message = "not_available" }
		end
		if mode == "checkpoint" and phase == "Lost" and Checkpoint.isUsable(checkpoint) then
			continueFromCheckpoint()
		else
			restart()
		end
		return { accepted = true, message = "" }
	end)

	local function onPlayer(player: Player)
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMaxZoomDistance = 0.5
		player.CameraMinZoomDistance = 0.5
		if not started then
			started = true
			restart()
		else
			task.spawn(spawnPlayer, player, WorldService.spawnCFrame(), nil)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end

	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(tick :: () -> any)
			if not ok then
				log.error("tick failed: %s", tostring(err))
			end
		end
	end)
end

function RoundService.restart()
	restart()
end

function RoundService.continueFromCheckpoint()
	continueFromCheckpoint()
end

function RoundService.lose(player: Player)
	endRound(player, "Lost")
end

function RoundService.win(player: Player)
	endRound(player, "Won")
end

function RoundService.getPhase(): RoundRules.Phase
	return phase
end

-- Depuração: pula etapas (só usado pelo DebugService no Studio).
function RoundService.debugGrant(what: string, player: Player?)
	if what == "fuses" then
		for id in WorldService.get().fuseModels do
			if Objectives.collect(objectives, id) then
				WorldService.setFuseCollected(id)
			end
		end
		CreatureService.setFuses(Objectives.collectedCount(objectives))
	elseif what == "insert" then
		Objectives.insert(objectives)
		WorldService.setPanelFuses(objectives.inserted)
	elseif what == "breakers" then
		breakers.progress = #breakers.order
		breakers.solved = true
		WorldService.setBreakers(breakerMask())
		if Objectives.solveBreakers(objectives) then
			powerOn(roundId, player)
		end
	elseif what == "key" then
		Objectives.takeKey(objectives)
	end
	publish()
end

function RoundService.snapshot(): { [string]: any }
	return {
		phase = phase,
		roundId = roundId,
		collected = Objectives.collectedCount(objectives),
		held = objectives.held,
		inserted = objectives.inserted,
		breakersOn = objectives.breakersOn,
		breakerOrder = BreakerPuzzle.describe(breakers.order),
		breakerProgress = breakers.progress,
		powerOn = objectives.powerOn,
		gateOpen = objectives.gateOpen,
		hasKey = objectives.hasKey,
		unlocked = objectives.unlocked,
		entered = objectives.enteredBuilding,
		awakened = awakened,
		checkpoint = Checkpoint.isUsable(checkpoint),
	}
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="480">
          <Properties>
            <string name="Name">StoreService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StoreService: loja, progressão, passe de temporada e compras com Robux (autoritativo).

	- Remote "Store" (ação, argumento?): diário, roleta, baús, compra com Fichas/Créditos,
	  equipar e pedir compra em Robux. Tudo validado aqui com as regras puras de Shared/Game/Economy.
	- Robux:
	  * Developer Products -> MarketplaceService.ProcessReceipt, idempotente pelo PurchaseId
	    (o recibo e o que ele concede ficam no MESMO registro do jogador, salvo antes de confirmar).
	  * Game Passes (VIP e o passe de cada temporada) -> UserOwnsGamePassAsync na entrada +
	    PromptGamePassPurchaseFinished.
	  * ID = 0 (ainda não criado no Creator Hub): no Studio a compra é SIMULADA (testes);
	    no servidor ao vivo o item responde "store_unavailable".
	- Passe de temporada (Shared/Game/Season): XP de temporada nas partidas, fitas e diário;
	  as recompensas das trilhas saem sozinhas ao subir de nível. Comprar a trilha paga entrega
	  na hora as recompensas pagas dos níveis já alcançados.
	- PolicyService: quem tem ArePaidRandomItemsRestricted não abre o baú pago (Créditos);
	  continua podendo comprar cada item diretamente (alternativa exigida pela política).
	- Analytics (TelemetryService): cada mudança de Fichas/Créditos vira evento de economia
	  (Server/Game/EconomyEvents) e cada compra fecha o funil da loja.
	- Publica o estado no próprio Player (atributos) para a UI: Fichas, Creditos, Xp, Level, Vip,
	  Owned (JSON), Tapes (JSON), Equip*, DailyStreak/DailyClaimable, SpinsLeft, StarterBought,
	  PaidRandomRestricted, SeasonId, SeasonXp, SeasonPremium, StoreReady.
	- Notificações de recompensa: remote "StoreNotice" (servidor -> cliente).
	- Vantagens pagas (Shared/Game/Perks): melhorias de 5 níveis (Fichas ou Créditos), consumíveis
	  (Segunda Chance, Pilha Extra, Continuação), kit de uso automático e bônus de tempo. Publica
	  Perks/Consumables/Loadout (JSON), Perk<Id> (nível, lido pelo jogo) e Boost*Until (os.time).
	- Modo história (Shared/Game/StoryRewards): awardStory no fim de cada capítulo; passe Arquivo do
	  Elias dobra as moedas e entrega 3 itens. Publica StoryProgress (JSON) e StoryPass.
]]

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local RunService = game:GetService("RunService")

local Economy = require("@game/ReplicatedStorage/Shared/Game/Economy")
local Perks = require("@game/ReplicatedStorage/Shared/Game/Perks")
local StoryRewards = require("@game/ReplicatedStorage/Shared/Game/StoryRewards")
local TaskRewards = require("@game/ReplicatedStorage/Shared/Game/TaskRewards")
local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Remotes = require("@game/ReplicatedStorage/Shared/Net/Remotes")
local Season = require("@game/ReplicatedStorage/Shared/Game/Season")
local SeasonCatalog = require("@game/ReplicatedStorage/Shared/Game/SeasonCatalog")
local StoreCatalog = require("@game/ReplicatedStorage/Shared/Game/StoreCatalog")
local Types = require("@game/ReplicatedStorage/Shared/Types")
local EconomyEvents = require("../Game/EconomyEvents")
local ServerNet = require("../Net/ServerNet")
local PlayerDataService = require("./PlayerDataService")
local TelemetryService = require("./TelemetryService")

export type StoreResponse = {
	ok: boolean,
	message: string,
	-- Resultado para a UI animar (item do baú, segmento da roleta, recompensa).
	item: string?,
	rarity: string?,
	duplicate: boolean?,
	refund: number?,
	segment: string?,
	granted: Economy.Granted?,
}

local log = Logger.new("StoreService")
local TX = EconomyEvents.Transaction
-- Fuso do "dia" do calendário e da roleta (Brasil, UTC-3): vira à meia-noite local.
local DAY_OFFSET = -3 * 3600

-- Game Passes que cada jogador tem nesta sessão (chave do produto -> true).
local passCache: { [Player]: { [string]: boolean } } = {}
local restrictedCache: { [Player]: boolean } = {}
local changedCallbacks: { (Player) -> () } = {}
local rng = Random.new()
-- Quem executa a Continuação (CampaignRuntime): valida a derrota e repete a etapa.
local continueHandler: ((Player) -> (boolean, string?))? = nil
-- Atributo de jogo de cada melhoria (lido por PlayerStateService, CreatureService, CampaignRuntime e cliente).
local PERK_ATTRIBUTES: { [string]: string } =
	{ bateria = "PerkBateria", folego = "PerkFolego", socorro = "PerkSocorro", silencio = "PerkSilencio" }

local function random(): number
	return rng:NextNumber()
end

local function today(): number
	return Economy.dayIndex(os.time() + DAY_OFFSET)
end

local function ownsPass(player: Player, key: string): boolean
	local passes = passCache[player]
	return passes ~= nil and passes[key] == true
end

local function setPass(player: Player, key: string)
	local passes = passCache[player] or {}
	passes[key] = true
	passCache[player] = passes
end

local function isVip(player: Player): boolean
	return ownsPass(player, "vip")
end

local function activeSeason(): SeasonCatalog.SeasonDef?
	return Season.current(os.time())
end

local function hasSeasonPass(player: Player, season: SeasonCatalog.SeasonDef): boolean
	return ownsPass(player, season.passKey)
end

-- Temporada à qual pertence o Game Pass `key` (nil = não é passe de temporada).
local function seasonOfPass(key: string): SeasonCatalog.SeasonDef?
	for _, season in SeasonCatalog.Seasons do
		if season.passKey == key then
			return season
		end
	end
	return nil
end

local function productById(id: number, kind: "product" | "pass"): StoreCatalog.Product?
	if id == 0 then
		return nil
	end
	for _, product in StoreCatalog.Products do
		if product.id == id and product.kind == kind then
			return product
		end
	end
	return nil
end

local function publish(player: Player)
	local data = PlayerDataService.get(player)
	if not data then
		return
	end
	local vip = isVip(player)
	local level = Economy.levelInfo(data.xp)
	local owned = {}
	for id in data.owned do
		table.insert(owned, id)
	end
	table.sort(owned)
	local tapes = {}
	for id in data.tapes do
		table.insert(tapes, id)
	end
	table.sort(tapes)
	local day = today()
	local claimable, streakDay = Economy.dailyState(data, day)
	local season = activeSeason()
	player:SetAttribute("Fichas", data.wallet.fichas)
	player:SetAttribute("Creditos", data.wallet.creditos)
	player:SetAttribute("Xp", data.xp)
	player:SetAttribute("Level", level)
	player:SetAttribute("Vip", vip)
	player:SetAttribute("PaidRandomRestricted", restrictedCache[player] ~= false)
	player:SetAttribute("Owned", HttpService:JSONEncode(owned))
	player:SetAttribute("Tapes", HttpService:JSONEncode(tapes))
	player:SetAttribute("DailyStreak", streakDay)
	player:SetAttribute("DailyClaimable", claimable)
	player:SetAttribute("SpinsLeft", Economy.spinsLeft(data, day, vip))
	player:SetAttribute("StarterBought", data.oncePurchases.pacote_inicial ~= nil)
	player:SetAttribute("KitBought", data.oncePurchases.kit_sobrevivente ~= nil)
	player:SetAttribute("EquipFlashlight", Economy.equipped(data, "flashlight", vip))
	player:SetAttribute("EquipUniform", Economy.equipped(data, "uniform", vip))
	player:SetAttribute("EquipFilter", Economy.equipped(data, "filter", vip))
	player:SetAttribute("Title", Economy.equipped(data, "title", vip))
	player:SetAttribute("SeasonId", if season then season.id else "")
	player:SetAttribute("SeasonXp", if season then Season.xpOf(data, season) else 0)
	player:SetAttribute("SeasonPremium", season ~= nil and hasSeasonPass(player, season))
	-- Vantagens e história.
	local levels: { [string]: number } = {}
	for _, perk in Perks.List do
		local perkLevel = Perks.level(data, perk.id)
		levels[perk.id] = perkLevel
		player:SetAttribute(PERK_ATTRIBUTES[perk.id], perkLevel)
	end
	local stock: { [string]: number } = {}
	local kit: { string } = {}
	for _, consumable in Perks.Consumables do
		stock[consumable.id] = Perks.count(data, consumable.id)
		if data.loadout[consumable.id] then
			table.insert(kit, consumable.id)
		end
	end
	player:SetAttribute("Perks", HttpService:JSONEncode(levels))
	player:SetAttribute("Consumables", HttpService:JSONEncode(stock))
	player:SetAttribute("Loadout", HttpService:JSONEncode(kit))
	player:SetAttribute("BoostFichasUntil", data.boosts.fichasUntil)
	player:SetAttribute("BoostXpUntil", data.boosts.xpUntil)
	local cleared: { number } = {}
	local flawless: { number } = {}
	for key in data.house.cleared do
		table.insert(cleared, tonumber(key) or 0)
	end
	for key in data.house.flawless do
		table.insert(flawless, tonumber(key) or 0)
	end
	player:SetAttribute("HousePreferences", HttpService:JSONEncode(data.house.preferences))
	player:SetAttribute("StoryProgress", HttpService:JSONEncode({ cleared = cleared, flawless = flawless }))
	player:SetAttribute("StoryPass", ownsPass(player, StoreCatalog.StoryPassKey))
	player:SetAttribute("StoreReady", true)
	for _, callback in changedCallbacks do
		task.spawn(callback, player)
	end
end

local function notify(player: Player, kind: string, granted: Economy.Granted?, extra: { [string]: any }?)
	local payload: { [string]: any } = { kind = kind }
	if granted then
		payload.fichas = granted.fichas
		payload.creditos = granted.creditos
		payload.xp = granted.xp
		payload.items = granted.items
		payload.levels = granted.levels
		payload.consumables = granted.consumables
	end
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	local ok, remote = pcall(Remotes.serverEvent, "StoreNotice")
	if ok then
		remote:FireClient(player, payload)
	end
end

-- Partes de analytics das trilhas da temporada (moedas que cada trilha entregou).
local function seasonChanges(result: Season.SeasonGranted?): { EconomyEvents.Change }
	if not result then
		return {}
	end
	return {
		{ transaction = TX.Season, sku = "season_free", granted = result.free },
		{ transaction = TX.Season, sku = "season_premium", granted = result.premium },
	}
end

-- Soma XP de temporada dentro de uma mutação (nil sem temporada ativa).
local function addSeasonXp(player: Player, data: Types.PlayerData, amount: number): Season.SeasonGranted?
	local season = activeSeason()
	if not season then
		return nil
	end
	return Season.addXp(data, season, amount, hasSeasonPass(player, season))
end

-- Aviso da temporada (nível novo ou recompensas das trilhas). Junta as duas trilhas no aviso.
local function notifySeason(player: Player, result: Season.SeasonGranted?, extra: { [string]: any }?)
	if not result or (#result.tiers == 0 and not Season.hasRewards(result)) then
		return
	end
	local items = table.clone(result.free.items)
	for _, id in result.premium.items do
		table.insert(items, id)
	end
	local payload: { [string]: any } = { tiers = result.tiers, items = items }
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	notify(player, "season", {
		fichas = result.free.fichas + result.premium.fichas,
		creditos = result.free.creditos + result.premium.creditos,
		xp = 0,
		items = items,
		refunds = {},
		levels = {},
	}, payload)
end

-- Entrega uma compra em Robux (recibo real ou simulado no Studio) e salva antes de confirmar.
local function deliver(player: Player, product: StoreCatalog.Product, purchaseId: string): boolean
	local result: Economy.Granted? = nil
	local repeated = false
	local events: { EconomyEvents.Event } = {}
	local updated = PlayerDataService.update(player, function(data: Types.PlayerData)
		local ok, message, granted = Economy.grantProduct(data, product, purchaseId, os.time())
		repeated = not ok and message == "already_granted"
		result = granted
		if granted then
			events = EconomyEvents.sources(granted, data.wallet, TX.IAP, product.key)
		end
	end)
	if not updated then
		return false
	end
	if repeated then
		return true -- recibo já entregue antes (Roblox reenviou): nada a conceder de novo
	end
	if not PlayerDataService.save(player) then
		-- O recibo e a concessão ficam juntos na memória: o próximo save grava os dois,
		-- e a reentrega deste recibo será reconhecida como já concedida.
		log.warn("purchase %s for %s granted but not saved yet", purchaseId, player.Name)
		return false
	end
	log.info("delivered %s to %s (%s)", product.key, player.Name, purchaseId)
	TelemetryService.economy(player, events)
	TelemetryService.purchased(player, "product", "robux")
	publish(player)
	notify(player, "purchase", result, { product = product.key })
	return true
end

-- Game Pass confirmado (compra real ou simulada): vale na hora; passe de temporada entrega
-- as recompensas pagas dos níveis já alcançados.
-- Passe da história: entrega os itens que faltarem (idempotente; vale também na entrada).
local function grantStoryPassItems(player: Player)
	PlayerDataService.update(player, function(data)
		for _, id in StoreCatalog.StoryPassItems do
			if not data.owned[id] then
				Economy.applyReward(data, { item = id })
			end
		end
	end)
end

local function grantPass(player: Player, product: StoreCatalog.Product)
	setPass(player, product.key)
	local season = activeSeason()
	local result: Season.SeasonGranted? = nil
	local events: { EconomyEvents.Event } = {}
	if season and season.passKey == product.key then
		PlayerDataService.update(player, function(data)
			result = Season.grantReached(data, season, true)
			events = EconomyEvents.build(data.wallet, seasonChanges(result))
		end)
	end
	if product.key == StoreCatalog.StoryPassKey then
		grantStoryPassItems(player)
	end
	log.info("pass %s active for %s", product.key, player.Name)
	TelemetryService.economy(player, events)
	TelemetryService.purchased(player, "pass", "robux")
	publish(player)
	notify(player, "purchase", nil, { product = product.key })
	notifySeason(player, result, { premium = true })
end

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productById(receipt.ProductId, "product")
	if not product then
		log.error("receipt for unknown product %s", tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not PlayerDataService.waitFor(player, 15) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if deliver(player, product, tostring(receipt.PurchaseId)) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function refreshPasses(player: Player)
	for _, product in StoreCatalog.Products do
		if product.kind == "pass" and product.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, product.id)
			end)
			if ok and owns == true then
				setPass(player, product.key)
			end
		end
	end
end

local function refreshPolicy(player: Player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if ok and type(info) == "table" then
		restrictedCache[player] = info.ArePaidRandomItemsRestricted == true
	else
		-- Sem resposta da política: por segurança, trata como restrito só para o baú pago.
		restrictedCache[player] = true
		log.warn("policy lookup failed for %s; paid random items disabled", player.Name)
	end
end

-- Entrada: põe os dados na temporada atual e entrega o que faltar (ex.: comprou a trilha paga
-- noutro servidor). Idempotente.
local function syncSeason(player: Player)
	local season = activeSeason()
	if not season then
		return
	end
	local result: Season.SeasonGranted? = nil
	local events: { EconomyEvents.Event } = {}
	PlayerDataService.update(player, function(data)
		result = Season.grantReached(data, season, hasSeasonPass(player, season))
		events = EconomyEvents.build(data.wallet, seasonChanges(result))
	end)
	TelemetryService.economy(player, events)
	notifySeason(player, result)
end

local function onPlayer(player: Player)
	refreshPolicy(player)
	refreshPasses(player)
	if PlayerDataService.waitFor(player, 30) then
		syncSeason(player)
		if ownsPass(player, StoreCatalog.StoryPassKey) then
			grantStoryPassItems(player)
		end
		publish(player)
	end
end

local function mutate(player: Player, mutator: (data: Types.PlayerData) -> StoreResponse): StoreResponse
	local response: StoreResponse = { ok = false, message = "store_loading" }
	local loaded = PlayerDataService.update(player, function(data)
		response = mutator(data)
	end)
	if not loaded then
		return { ok = false, message = "store_loading" }
	end
	if response.ok then
		publish(player)
	end
	return response
end

local function requestProduct(player: Player, key: string): StoreResponse
	local product = StoreCatalog.ProductByKey[key]
	if not product then
		return { ok = false, message = "store_unknown" }
	end
	local data = PlayerDataService.get(player)
	if not data then
		return { ok = false, message = "store_loading" }
	end
	if product.kind == "pass" and ownsPass(player, product.key) then
		return { ok = false, message = "store_owned" }
	end
	if product.once and data.oncePurchases[product.key] then
		return { ok = false, message = "store_owned" }
	end
	local passSeason = seasonOfPass(product.key)
	if passSeason and activeSeason() ~= passSeason then
		return { ok = false, message = "season_closed" }
	end
	if product.id == 0 then
		if not RunService:IsStudio() then
			return { ok = false, message = "store_unavailable" }
		end
		-- Studio: compra simulada (sem Robux), pelo mesmo caminho de entrega do recibo real.
		if product.kind == "pass" then
			grantPass(player, product)
			return { ok = true, message = "store_mock" }
		end
		local delivered = deliver(player, product, `studio-{HttpService:GenerateGUID(false)}`)
		return { ok = delivered, message = if delivered then "store_mock" else "store_error" }
	end
	if product.kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(player, product.id)
	else
		MarketplaceService:PromptProductPurchase(player, product.id)
	end
	return { ok = true, message = "store_prompted" }
end

local function handle(player: Player, action: string, arg: string?): StoreResponse
	local vip = isVip(player)
	local day = today()
	local events: { EconomyEvents.Event } = {}
	local purchase: { kind: string, currency: StoreCatalog.Currency }? = nil
	local seasonResult: Season.SeasonGranted? = nil
	local response: StoreResponse
	if action == "claim_daily" then
		response = mutate(player, function(data)
			local ok, err, streakDay, granted = Economy.claimDaily(data, day)
			if not ok or not granted then
				return { ok = false, message = err or "daily_claimed" }
			end
			seasonResult = addSeasonXp(player, data, SeasonCatalog.XpSources.daily)
			local changes: { EconomyEvents.Change } =
				{ { transaction = TX.TimedReward, sku = `daily_d{streakDay or 1}`, granted = granted } }
			for _, change in seasonChanges(seasonResult) do
				table.insert(changes, change)
			end
			events = EconomyEvents.build(data.wallet, changes)
			notify(player, "daily", granted, {
				day = streakDay,
				seasonXp = if seasonResult then seasonResult.xp else 0,
			})
			return { ok = true, message = "daily_ok", granted = granted }
		end)
	elseif action == "spin" then
		response = mutate(player, function(data)
			local ok, err, segment, granted = Economy.spin(data, day, vip, random)
			if not ok or not segment or not granted then
				return { ok = false, message = err or "spin_used" }
			end
			events = EconomyEvents.sources(granted, data.wallet, TX.TimedReward, `spin_{segment.id}`)
			return { ok = true, message = "spin_ok", segment = segment.id, granted = granted }
		end)
	elseif action == "open_chest" and arg then
		local restricted = restrictedCache[player] ~= false
		response = mutate(player, function(data)
			local ok, err, result = Economy.openChest(data, arg, random, restricted)
			if not ok or not result then
				return { ok = false, message = err or "store_error" }
			end
			local chest = StoreCatalog.ChestById[arg]
			events = EconomyEvents.build(data.wallet, {
				{
					transaction = TX.Shop,
					sku = chest.id,
					spend = { currency = chest.currency, amount = chest.price },
					granted = {
						fichas = result.refund,
						creditos = 0,
						xp = 0,
						items = {},
						refunds = if result.refund > 0 then { [result.item] = result.refund } else {},
						levels = {},
					},
				},
			})
			purchase = { kind = "chest", currency = chest.currency }
			log.info("%s opened %s -> %s (%s)", player.Name, arg, result.item, result.rarity)
			return {
				ok = true,
				message = "chest_ok",
				item = result.item,
				rarity = result.rarity,
				duplicate = result.duplicate,
				refund = result.refund,
			}
		end)
	elseif (action == "buy_fichas" or action == "buy_creditos") and arg then
		local currency: StoreCatalog.Currency = if action == "buy_fichas" then "fichas" else "creditos"
		response = mutate(player, function(data)
			local ok, err = Economy.buyItem(data, arg, currency, vip)
			if not ok then
				return { ok = false, message = err or "store_error" }
			end
			local price = Economy.price(StoreCatalog.ItemById[arg], currency) or 0
			events = EconomyEvents.sink(currency, price, data.wallet, TX.Shop, arg)
			purchase = { kind = "item", currency = currency }
			return { ok = true, message = "store_bought", item = arg }
		end)
	elseif action == "equip" and arg then
		response = mutate(player, function(data)
			local ok, err = Economy.equip(data, arg, vip)
			return { ok = ok, message = if ok then "store_equipped" else err or "store_error", item = arg }
		end)
	elseif (action == "upgrade_fichas" or action == "upgrade_creditos") and arg then
		local currency: Perks.Currency = if action == "upgrade_fichas" then "fichas" else "creditos"
		response = mutate(player, function(data)
			local price = Perks.nextCost(arg, Perks.level(data, arg), currency)
			local ok, err, level = Perks.upgrade(data, arg, currency)
			if not ok or not price then
				return { ok = false, message = err or "store_error" }
			end
			events = EconomyEvents.sink(currency, price, data.wallet, TX.Shop, `perk_{arg}_{level}`)
			purchase = { kind = "perk", currency = currency }
			log.info("%s upgraded %s to %d (%s)", player.Name, arg, level or 0, currency)
			return { ok = true, message = "perk_upgraded", item = arg }
		end)
	elseif (action == "consumable_fichas" or action == "consumable_creditos") and arg then
		local currency: Perks.Currency = if action == "consumable_fichas" then "fichas" else "creditos"
		response = mutate(player, function(data)
			local ok, err = Perks.buyConsumable(data, arg, currency)
			if not ok then
				return { ok = false, message = err or "store_error" }
			end
			local def = Perks.ConsumableById[arg]
			local price = (if currency == "fichas" then def.fichas else def.creditos) or 0
			events = EconomyEvents.sink(currency, price, data.wallet, TX.Shop, `consumable_{arg}`)
			purchase = { kind = "consumable", currency = currency }
			return { ok = true, message = "consumable_bought", item = arg }
		end)
	elseif (action == "loadout_on" or action == "loadout_off") and arg then
		response = mutate(player, function(data)
			local ok, err = Perks.setLoadout(data, arg, action == "loadout_on")
			return { ok = ok, message = if ok then "loadout_saved" else err or "store_error", item = arg }
		end)
	elseif action == "use_continue" then
		local data = PlayerDataService.get(player)
		if not data then
			return { ok = false, message = "store_loading" }
		end
		if Perks.count(data, "continuar") <= 0 then
			return { ok = false, message = "continue_none" }
		end
		local handler = continueHandler
		if not handler then
			return { ok = false, message = "continue_unavailable" }
		end
		local ok, reason = handler(player)
		if not ok then
			return { ok = false, message = reason or "continue_unavailable" }
		end
		-- A etapa já foi reaberta: gasta a unidade (se o save falhar, o próximo save grava).
		response = mutate(player, function(mutable)
			Perks.consume(mutable, "continuar")
			return { ok = true, message = "continue_used" }
		end)
		log.info("%s used a continue", player.Name)
	elseif action == "buy_product" and arg then
		return requestProduct(player, arg)
	else
		return { ok = false, message = "store_unknown" }
	end
	TelemetryService.economy(player, events)
	if purchase and response.ok then
		TelemetryService.purchased(player, purchase.kind, purchase.currency)
	end
	notifySeason(player, seasonResult)
	return response
end

local StoreService = {
	Name = "StoreService",
}

function StoreService.Start()
	ServerNet.onInvoke("Store", {
		args = {
			Guard.literal(
				"claim_daily",
				"spin",
				"open_chest",
				"buy_fichas",
				"buy_creditos",
				"equip",
				"buy_product",
				"upgrade_fichas",
				"upgrade_creditos",
				"consumable_fichas",
				"consumable_creditos",
				"loadout_on",
				"loadout_off",
				"use_continue"
			),
			Guard.optional(Guard.string({ maxLength = 32, pattern = "[%w_]+" })),
		},
		rateLimit = { capacity = 8, refillPerSecond = 3 },
	}, handle)

	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, passId: number, purchased: boolean)
			local product = productById(passId, "pass")
			if purchased and product and not ownsPass(player, product.key) then
				grantPass(player, product)
			end
		end
	)

	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player: Player)
		passCache[player] = nil
		restrictedCache[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
end

function StoreService.isVip(player: Player): boolean
	return isVip(player)
end

-- Item equipado (com fallback ao padrão).
function StoreService.equipped(player: Player, kind: StoreCatalog.ItemKind): string
	local data = PlayerDataService.get(player)
	if not data then
		return StoreCatalog.defaultFor(kind)
	end
	return Economy.equipped(data, kind, isVip(player))
end

--[[
	Fim de partida: aplica recompensa e XP de temporada e avisa o cliente (tela de resultado).
	`sku` = contexto para o analytics (RewardService: modo e resultado, ex. "campaign_won").
]]
-- Conclusão de estação: pagamento imediato, sem contar outra partida nem alterar o formato salvo.
function StoreService.awardTask(player: Player, contributed: boolean): Economy.Granted?
	local granted: Economy.Granted? = nil
	local events: { EconomyEvents.Event } = {}
	if
		not PlayerDataService.update(player, function(data)
			local reward = TaskRewards.reward(contributed)
			granted = Economy.applyReward(data, { fichas = reward.fichas, xp = reward.xp })
			events = EconomyEvents.build(
				data.wallet,
				{ { transaction = TX.Gameplay, sku = "campaign_task", granted = granted } }
			)
		end)
	then
		return nil
	end
	TelemetryService.economy(player, events)
	publish(player)
	notify(player, "task", granted, { contributed = contributed })
	return granted
end

-- Moeda pega na casa: paga na hora, sem aviso (o HUD anima a carteira). Retorna o que entrou.
function StoreService.awardCoin(player: Player, fichas: number, xp: number): Economy.Granted?
	local granted: Economy.Granted? = nil
	local events: { EconomyEvents.Event } = {}
	if
		not PlayerDataService.update(player, function(data)
			granted = Economy.applyReward(data, { fichas = fichas, xp = xp })
			events = EconomyEvents.build(
				data.wallet,
				{ { transaction = TX.Gameplay, sku = "house_coin", granted = granted } }
			)
		end)
	then
		return nil
	end
	TelemetryService.economy(player, events)
	publish(player)
	return granted
end

function StoreService.awardRun(player: Player, summary: Economy.RunSummary, sku: string?): Economy.Granted?
	local granted: Economy.Granted? = nil
	local seasonResult: Season.SeasonGranted? = nil
	local events: { EconomyEvents.Event } = {}
	local ok = PlayerDataService.update(player, function(data)
		local run = Economy.recordRun(data, summary, isVip(player), os.time())
		granted = run
		seasonResult = addSeasonXp(player, data, Season.runXp(summary))
		local changes: { EconomyEvents.Change } = { { transaction = TX.Gameplay, sku = sku or "run", granted = run } }
		for _, change in seasonChanges(seasonResult) do
			table.insert(changes, change)
		end
		events = EconomyEvents.build(data.wallet, changes)
	end)
	if not ok then
		return nil
	end
	TelemetryService.economy(player, events)
	publish(player)
	notify(player, "run", granted, {
		summary = summary,
		vip = isVip(player),
		seasonXp = if seasonResult then seasonResult.xp else 0,
	})
	notifySeason(player, seasonResult)
	return granted
end

-- Fita colecionável. Retorna true se era nova para o jogador. Toda fita achada pela equipe
-- dá XP de temporada (nova ou repetida); só a nova dá Fichas/XP da conta.
function StoreService.awardTape(player: Player, tapeId: string, finder: string?): boolean
	local isNew = false
	local granted: Economy.Granted? = nil
	local seasonResult: Season.SeasonGranted? = nil
	local events: { EconomyEvents.Event } = {}
	PlayerDataService.update(player, function(data)
		isNew, granted = Economy.addTape(data, tapeId, os.time(), isVip(player))
		seasonResult = addSeasonXp(player, data, SeasonCatalog.XpSources.tape)
		local changes = seasonChanges(seasonResult)
		if granted then
			table.insert(changes, 1, { transaction = TX.Gameplay, sku = "tape", granted = granted })
		end
		events = EconomyEvents.build(data.wallet, changes)
	end)
	TelemetryService.economy(player, events)
	publish(player)
	notify(player, "tape", granted, {
		tape = tapeId,
		new = isNew,
		finder = finder,
		seasonXp = if seasonResult then seasonResult.xp else 0,
	})
	notifySeason(player, seasonResult)
	return isNew
end

-- Fitas que o jogador já tem (para escolher qual fita aparece na partida).
function StoreService.ownedTapes(player: Player): { [string]: boolean }
	local data = PlayerDataService.get(player)
	local result = {}
	if data then
		for id in data.tapes do
			result[id] = true
		end
	end
	return result
end

-- Avisado quando o estado de um jogador muda (cosméticos reaplicam).
function StoreService.onChanged(callback: (Player) -> ())
	table.insert(changedCallbacks, callback)
end

-- ===================== Vantagens e história (jogo) =====================

function StoreService.perkLevel(player: Player, id: string): number
	local data = PlayerDataService.get(player)
	return if data then Perks.level(data, id) else 0
end

-- Consumível de kit pronto para uso automático?
function StoreService.inLoadout(player: Player, id: string): boolean
	local data = PlayerDataService.get(player)
	return data ~= nil and Perks.inLoadout(data, id)
end

-- Gasta uma unidade (uso automático na partida). false se não tinha.
function StoreService.consume(player: Player, id: string): boolean
	local used = false
	PlayerDataService.update(player, function(data)
		used = Perks.consume(data, id)
	end)
	if used then
		publish(player)
	end
	return used
end

-- CampaignRuntime registra quem repete a etapa (a validação da derrota fica com ele).
function StoreService.setContinueHandler(handler: (Player) -> (boolean, string?))
	continueHandler = handler
end

function StoreService.hasStoryPass(player: Player): boolean
	return ownsPass(player, StoreCatalog.StoryPassKey)
end

-- Fim de capítulo do modo história (RewardService). Avisa a tela de resultado.
function StoreService.awardStory(player: Player, chapter: number, flawless: boolean): StoryRewards.Outcome?
	local granted: Economy.Granted? = nil
	local outcome: StoryRewards.Outcome? = nil
	local events: { EconomyEvents.Event } = {}
	local pass = StoreService.hasStoryPass(player)
	PlayerDataService.update(player, function(data)
		granted, outcome = StoryRewards.award(data, chapter, flawless, pass, os.time())
		if granted then
			events = EconomyEvents.sources(granted, data.wallet, TX.Gameplay, `story_{chapter}`)
		end
	end)
	local result = outcome
	if not granted or not result then
		return nil
	end
	TelemetryService.economy(player, events)
	publish(player)
	notify(player, "story", granted, {
		chapter = chapter,
		first = result.first,
		flawless = result.flawless,
		completed = result.completed,
		pass = pass,
		consumables = granted.consumables,
	})
	return result
end

-- Depuração (DebugBridge): dá moedas sem compra (fora do analytics).
function StoreService.debugGrant(player: Player, fichas: number, creditos: number)
	PlayerDataService.update(player, function(data)
		Economy.applyReward(data, { fichas = fichas, creditos = creditos })
	end)
	publish(player)
end

-- Depuração (DebugBridge): XP de temporada sem jogar (as recompensas saem normalmente).
function StoreService.debugSeasonXp(player: Player, amount: number)
	local result: Season.SeasonGranted? = nil
	PlayerDataService.update(player, function(data)
		result = addSeasonXp(player, data, amount)
	end)
	publish(player)
	notifySeason(player, result)
end

return StoreService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="481">
          <Properties>
            <string name="Name">TelemetryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TelemetryService: analytics de economia e funil da loja (AnalyticsService da Roblox).

	- Economia: StoreService envia os eventos montados por Server/Game/EconomyEvents
	  (fontes e sumidouros de Fichas/Créditos, com saldo final, tipo de transação e SKU).
	- Funil "Store" (Server/Game/StoreFunnel): abrir loja -> ver oferta -> comprar.
	  O cliente avisa abrir/ver pelo remote "StoreTrack" (só telemetria: não muda nada no jogo);
	  a compra é marcada pelo próprio servidor quando dá certo.
	- A Roblox só aceita esses eventos de servidor PUBLICADO: no Studio nada é enviado, mas tudo
	  fica no histórico em memória (DebugBridge "analytics") para o QA conferir.
	- Falha do AnalyticsService nunca atrapalha o jogo (pcall).
]]

local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Guard = require("@game/ReplicatedStorage/Shared/Net/Guard")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local EconomyEvents = require("../Game/EconomyEvents")
local StoreFunnel = require("../Game/StoreFunnel")
local ServerNet = require("../Net/ServerNet")

local log = Logger.new("TelemetryService")
local HISTORY_SIZE = 80
local FIELD_KEYS = { "CustomField01", "CustomField02", "CustomField03" }

local live = not RunService:IsStudio()
local funnels: { [Player]: StoreFunnel.State } = {}
local history: { { [string]: any } } = {}

local function remember(entry: { [string]: any })
	entry.at = os.clock()
	table.insert(history, entry)
	if #history > HISTORY_SIZE then
		table.remove(history, 1)
	end
end

local function customFields(values: { string }): { [string]: string }?
	if #values == 0 then
		return nil
	end
	local fields = {}
	for index, value in values do
		local key = FIELD_KEYS[index]
		if key then
			fields[(Enum.AnalyticsCustomFieldKeys :: any)[key].Name] = value
		end
	end
	return fields
end

local function funnelOf(player: Player): StoreFunnel.State
	local state = funnels[player]
	if not state then
		state = StoreFunnel.new()
		funnels[player] = state
	end
	return state
end

local function sendSteps(player: Player, state: StoreFunnel.State, steps: { StoreFunnel.Step })
	for _, step in steps do
		remember({
			type = "funnel",
			player = player.Name,
			funnel = StoreFunnel.NAME,
			session = state.session,
			step = step.step,
			name = step.name,
			fields = step.fields,
		})
		if live then
			local ok, err = pcall(function()
				AnalyticsService:LogFunnelStepEvent(
					player,
					StoreFunnel.NAME,
					state.session :: string,
					step.step,
					step.name,
					customFields(step.fields) :: any
				)
			end)
			if not ok then
				log.debug("funnel event failed: %s", tostring(err))
			end
		end
	end
end

local TelemetryService = {
	Name = "TelemetryService",
}

-- Eventos de economia já montados (EconomyEvents). Lista vazia não faz nada.
function TelemetryService.economy(player: Player, events: { EconomyEvents.Event })
	for _, event in events do
		remember({
			type = "economy",
			player = player.Name,
			flow = event.flow,
			currency = EconomyEvents.CurrencyNames[event.currency],
			amount = event.amount,
			balance = event.balance,
			transaction = event.transaction,
			sku = event.sku,
		})
		if live then
			local ok, err = pcall(function()
				AnalyticsService:LogEconomyEvent(
					player,
					(Enum.AnalyticsEconomyFlowType :: any)[event.flow],
					EconomyEvents.CurrencyNames[event.currency],
					event.amount,
					event.balance,
					event.transaction,
					event.sku
				)
			end)
			if not ok then
				log.debug("economy event failed: %s", tostring(err))
			end
		end
	end
end

function TelemetryService.storeOpened(player: Player)
	local state = funnelOf(player)
	sendSteps(player, state, StoreFunnel.open(state, HttpService:GenerateGUID(false)))
end

function TelemetryService.offerViewed(player: Player, offer: string)
	local state = funnelOf(player)
	sendSteps(player, state, StoreFunnel.view(state, offer))
end

-- Compra concluída (chamada pelo StoreService). kind: item|chest|product|pass.
function TelemetryService.purchased(player: Player, kind: string, currency: string)
	local state = funnelOf(player)
	sendSteps(player, state, StoreFunnel.purchase(state, kind, currency))
end

-- Depuração: últimos eventos (mais novos no fim).
function TelemetryService.history(): { { [string]: any } }
	return table.clone(history)
end

function TelemetryService.Start()
	ServerNet.onEvent("StoreTrack", {
		args = {
			Guard.literal("open", "view"),
			Guard.optional(Guard.string({ maxLength = 24, pattern = "[%w_]+" })),
		},
		rateLimit = { capacity = 6, refillPerSecond = 1 },
	}, function(player: Player, event: string, offer: string?)
		if event == "open" then
			TelemetryService.storeOpened(player)
		elseif offer then
			TelemetryService.offerViewed(player, offer)
		end
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		funnels[player] = nil
	end)
end

return TelemetryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="482">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WorldService: dono do mundo físico. Constrói o mapa no boot (MapBuilder + FeatureBuilder),
	controla iluminação/energia, portas (aberta / fresta / fechada / trancada), portão, quadro,
	disjuntores, fusíveis, chave, pilhas e armários, e restaura tudo a cada rodada ou checkpoint.

	Só o servidor muda o mundo; o cliente lê (tags/atributos) e faz efeitos locais.
	As REGRAS (o que pode ou não) ficam no RoundService e em Server/Game; aqui só se aplica.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local LightingProfile = require("@game/ReplicatedStorage/Shared/Game/LightingProfile")
local PhysicsService = game:GetService("PhysicsService")

local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Logger = require("@game/ReplicatedStorage/Shared/Logger")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Build = require("../World/Build")
local ArtBuilder = require("../World/ArtBuilder")
local FeatureBuilder = require("../World/FeatureBuilder")
local Features = require("../World/Features")
local Layout = require("../World/Layout")
local MapBuilder = require("../World/MapBuilder")
local Palette = require("../World/Palette")
local ProceduralLayout = require("../World/ProceduralLayout")
local SectorBuilder = require("../World/SectorBuilder")

export type DoorState = "open" | "crack" | "closed"

-- Interagível do mapa original ou das novidades (kind como texto: Fuse, Door, Hide, Key...).
export type Interactable = FeatureBuilder.Interactable

local log = Logger.new("WorldService")

local HouseBuilder = require("../World/HouseBuilder")
local HouseScenery = require("../World/HouseScenery")
local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local HouseLevels = require("../Campaign/HouseLevelPlan")
local HouseLevelBuilder = require("../World/HouseLevelBuilder")
local HouseAccess = require("../World/HouseAccess")
local Forest = require("@game/ReplicatedStorage/Shared/Game/ForestCatalog")
local ForestBuilder = require("../World/ForestBuilder")
local houseStage = 0
local outdoorPatrol: { Layout.Point } = {}
local world: MapBuilder.World? = nil
local features: FeatureBuilder.Built? = nil
local fuseFolder: Instance? = nil
local powered = false
local doorStates: { [string]: DoorState } = {}
local doorTokens: { [string]: number } = {}
local locked: { [string]: boolean } = {}
local modifiers: { [string]: PathfindingModifier } = {}
local rattles: { [string]: Sound } = {}
local latches: { [string]: Sound } = {}
local bangs: { [string]: Sound } = {}
local taken: { [string]: boolean } = {}
local sparkCount = 0
local sectorPlan: ProceduralLayout.Plan? = nil

local function getWorld(): MapBuilder.World
	assert(world, "[WorldService] used before Init")
	return world
end

local function getFeatures(): FeatureBuilder.Built
	assert(features, "[WorldService] used before Init")
	return features
end

local function vec(p: Layout.Point): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

-- A base do template (Baseplate/SpawnLocation) é substituída pelo mapa do jogo.
local function removeTemplateWorld()
	for _, name in { "Baseplate", "SpawnLocation" } do
		local leftover = workspace:FindFirstChild(name)
		if leftover then
			leftover:Destroy()
		end
	end
end

local function applyLighting(power: boolean)
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("Clouds") then
			child:Destroy() -- a névoa clássica (Fog*) só funciona sem Atmosphere
		end
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.StarCount = 900
		sky.CelestialBodiesShown = true
		sky.MoonAngularSize = 9
		sky.Parent = Lighting
	end
	local visual = LightingProfile.World
	Lighting.ClockTime = visual.clock
	Lighting.Brightness = visual.brightness
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = visual.shadowSoftness
	Lighting.EnvironmentDiffuseScale = visual.diffuse
	Lighting.EnvironmentSpecularScale = visual.specular
	Lighting.ExposureCompensation = 0
	local function rgb(v: { number }): Color3
		return Color3.fromRGB(v[1], v[2], v[3])
	end
	Lighting.Ambient = rgb(if power then visual.ambientPower else visual.ambient)
	Lighting.OutdoorAmbient = rgb(visual.outdoor)
	Lighting.FogColor = rgb(if power then visual.fogPower else visual.fog)
	Lighting.FogStart = visual.fogStart
	Lighting.FogEnd = if power then visual.fogEndPower else visual.fogEnd
	Lighting:SetAttribute("S9PowerOn", power)
	-- Base para a névoa dinâmica do cliente (perigo encurta a névoa localmente).
	Lighting:SetAttribute("BaseFogEnd", Lighting.FogEnd)
end

local function lights(): { BasePart }
	local list = {}
	local root = getWorld().root
	for _, part in CollectionService:GetTagged(Tags.PowerLight) do
		if part:IsA("BasePart") and part:IsDescendantOf(root) then
			table.insert(list, part)
		end
	end
	return list
end

local function setLightPart(part: BasePart, on: boolean)
	local light = part:FindFirstChildWhichIsA("Light")
	if light then
		light.Enabled = on
	end
	local kind = part:GetAttribute(Tags.Attr.LightKind)
	if kind == "Lamp" then
		part.Color = if on then Palette.LampOn else Palette.LampOff
		part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	elseif kind == "Flood" then
		part.Color = if on then Palette.Sodium else Palette.LampOff
		part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

-- ===================== Portas =====================

local function doorPose(door: MapBuilder.DoorHandle, angle: number): CFrame
	return door.hinge * CFrame.Angles(0, angle, 0) * (door.hinge:Inverse() * door.closedCFrame)
end

local function angleFor(door: MapBuilder.DoorHandle, state: DoorState): number
	if state == "open" then
		return door.openAngle
	elseif state == "crack" then
		return door.openAngle * (Config.Doors.CrackAngle / 95)
	end
	return 0
end

local function currentAngle(door: MapBuilder.DoorHandle): number
	-- Ângulo atual a partir da peça (a animação pode ter sido interrompida).
	local relative = door.hinge:Inverse() * door.panel.CFrame
	local closedRelative = door.hinge:Inverse() * door.closedCFrame
	local a = relative.Position
	local b = closedRelative.Position
	local angle = math.atan2(b.Z, b.X) - math.atan2(a.Z, a.X)
	while angle > math.pi do
		angle -= 2 * math.pi
	end
	while angle < -math.pi do
		angle += 2 * math.pi
	end
	return angle
end

local function refreshDoorPrompt(door: MapBuilder.DoorHandle)
	local state = doorStates[door.id] or "closed"
	local panel = door.panel
	panel:SetAttribute("DoorState", state)
	panel:SetAttribute("Locked", locked[door.id] == true)
	if locked[door.id] then
		panel:SetAttribute(Tags.Attr.InteractPrompt, Text.Prompts.DoorLocked)
		panel:SetAttribute("InteractAlt", nil)
	elseif state == "open" then
		panel:SetAttribute(Tags.Attr.InteractPrompt, Text.Prompts.DoorClose)
		panel:SetAttribute("InteractAlt", Text.Prompts.DoorCrack)
	elseif state == "crack" then
		panel:SetAttribute(Tags.Attr.InteractPrompt, Text.Prompts.DoorOpen)
		panel:SetAttribute("InteractAlt", Text.Prompts.DoorShut)
	else
		panel:SetAttribute(Tags.Attr.InteractPrompt, Text.Prompts.DoorOpen)
		panel:SetAttribute("InteractAlt", Text.Prompts.DoorCrack)
	end
end

--[[
	Anima a porta com PESO: começa devagar, acelera e assenta (curva suave), mas sempre em passos
	de 12 quadros/s (stop-motion). O estado lógico muda na hora.
]]
local function animateDoor(door: MapBuilder.DoorHandle, state: DoorState, instant: boolean?)
	doorStates[door.id] = state
	door.isOpen = state == "open"
	refreshDoorPrompt(door)
	local target = angleFor(door, state)
	local token = (doorTokens[door.id] or 0) + 1
	doorTokens[door.id] = token
	if instant then
		door.panel.CFrame = doorPose(door, target)
		door.busy = false
		return
	end
	local from = currentAngle(door)
	local delta = target - from
	if math.abs(delta) < 1e-3 then
		return
	end
	door.busy = true
	local closing = state == "closed"
	local sound = door.sound
	sound.PlaybackSpeed = if state == "crack" then 1.25 else (if closing then 1.1 else 0.9)
	sound.Volume = Audio.Door.volume * (if state == "crack" then 0.45 else 1)
	sound:Play()
	local frames = math.max(3, math.ceil(math.abs(delta) / math.rad(10)))
	task.spawn(function()
		for i = 1, frames do
			if doorTokens[door.id] ~= token then
				return
			end
			local t = i / frames
			local eased = t * t * (3 - 2 * t)
			door.panel.CFrame = doorPose(door, from + delta * eased)
			task.wait(1 / 12)
		end
		if closing then
			local latch = latches[door.id]
			if latch then
				latch:Play()
			end
		end
		if doorTokens[door.id] == token then
			door.busy = false
		end
	end)
end

local function setLocked(door: MapBuilder.DoorHandle, value: boolean)
	locked[door.id] = value
	local modifier = modifiers[door.id]
	if modifier then
		-- Trancada: o pathfinding não atravessa (o Vigia contorna pela ampliação ou desiste).
		modifier.PassThrough = not value
	end
	door.panel:SetAttribute("LockState", if value then "locked" else "unlocked")
	refreshDoorPrompt(door)
end

-- Pequeno tranco na folha (tranca chacoalhando / pancada do outro lado).
local function twitch(door: MapBuilder.DoorHandle, strength: number)
	if door.busy then
		return
	end
	local base = door.panel.CFrame
	task.spawn(function()
		for i = 1, 4 do
			local offset = (if i % 2 == 1 then 1 else -1) * strength * (1 - i / 5)
			door.panel.CFrame = doorPose(door, angleFor(door, doorStates[door.id] or "closed") + math.rad(offset))
			task.wait(1 / 12)
		end
		if not door.busy then
			door.panel.CFrame = base
		end
	end)
end

-- ===================== Novidades (chave, pilhas, armários, disjuntores) =====================

local function setModelShown(model: Model, shown: boolean, home: Instance)
	model.Parent = if shown then home else nil
end

local function setFeatureEnabled(id: string, enabled: boolean)
	local item = getFeatures().interactables[id]
	if item then
		item.enabled = enabled
		item.focus:SetAttribute(Tags.Attr.InteractEnabled, enabled)
	end
end

local function pickupsFolder(): Instance
	local folder = getFeatures().root:FindFirstChild("Pickups")
	assert(folder, "Pickups folder")
	return folder
end

local WorldService = {
	Name = "WorldService",
}

function WorldService.Init()
	removeTemplateWorld()
	if not PhysicsService:IsCollisionGroupRegistered(MapBuilder.NAV_GROUP) then
		PhysicsService:RegisterCollisionGroup(MapBuilder.NAV_GROUP)
	end
	PhysicsService:CollisionGroupSetCollidable(MapBuilder.NAV_GROUP, "Default", false)
	local started = os.clock()
	if Config.House.Enabled then
		world, features = HouseBuilder.build(workspace)
	else
		world = MapBuilder.build(workspace)
		features = FeatureBuilder.build(getWorld().root)
		ArtBuilder.build(getWorld().root)
		WorldService.rebuildSector(ProceduralLayout.create(1, 1))
	end
	local built = getWorld()
	local pickups = built.root:FindFirstChild("Pickups")
	fuseFolder = if pickups then pickups:FindFirstChild("Fuses") else nil

	local doorsFolder = built.root:FindFirstChild("Doors")
	for id, door in built.doors do
		local region = doorsFolder and doorsFolder:FindFirstChild(`{id}_Path`)
		local modifier = region and region:FindFirstChildOfClass("PathfindingModifier")
		if modifier then
			modifiers[id] = modifier
		end
		rattles[id] =
			Build.sound(door.panel, "Rattle", Audio.DoorRattle.id, Audio.DoorRattle.volume, Audio.DoorRattle.speed)
		latches[id] = Build.sound(door.panel, "Latch", Audio.DoorLatch.id, Audio.DoorLatch.volume * 0.6, 1.1)
		bangs[id] = Build.sound(door.panel, "Bang", Audio.DoorBang.id, Audio.DoorBang.volume)
		bangs[id].RollOffMaxDistance = 120
	end

	applyLighting(false)
	if Config.House.Enabled then
		-- Terreno, floresta, quintal e decoração dos cômodos (só visual).
		HouseScenery.build(built.root)
	end
	local count = 0
	for _, d in built.root:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	log.info("world built: %d parts in %.0f ms", count, (os.clock() - started) * 1000)
end

function WorldService.get(): MapBuilder.World
	return getWorld()
end

function WorldService.features(): FeatureBuilder.Built
	return getFeatures()
end

function WorldService.rebuildSector(plan: ProceduralLayout.Plan)
	if Config.House.Enabled then
		return
	end
	SectorBuilder.build(getWorld().root, plan)
	sectorPlan = plan
end

function WorldService.patrolNodes(): { Layout.Point }
	if Config.House.Enabled and houseStage >= 6 then
		local points: { Layout.Point } = {}
		for _, room in Forest.Rooms do
			table.insert(points, { x = room.x, y = 0, z = room.z })
		end
		return points
	end
	if Config.House.Enabled then
		local points: { Layout.Point } = {}
		for _, point in outdoorPatrol do
			table.insert(points, point)
		end
		for _, room in House.Rooms do
			local accessible = room.y == 0 or (room.y > 0 and houseStage >= 3) or (room.y < 0 and houseStage >= 4)
			if accessible and room.id ~= "Exterior" then
				table.insert(points, { x = room.x, y = room.y, z = room.z })
			end
		end
		return points
	end
	local nodes = table.clone(Layout.PatrolNodes)
	if sectorPlan then
		for _, point in ProceduralLayout.patrolPoints(sectorPlan) do
			table.insert(nodes, point)
		end
	end
	return nodes
end

function WorldService.creatureSpawns(): { Layout.Point }
	if Config.House.Enabled then
		return WorldService.patrolNodes()
	end
	local nodes = table.clone(Layout.CreatureSpawns)
	if sectorPlan then
		for _, room in sectorPlan.rooms do
			table.insert(nodes, { x = room.x, y = 0, z = room.z })
		end
	end
	return nodes
end

function WorldService.spawnCFrame(): CFrame
	return getWorld().spawnCFrame
end

function WorldService.checkpointCFrame(): CFrame
	if Config.House.Enabled then
		return WorldService.spawnCFrame()
	end
	local spot = Features.CheckpointSpawn
	return CFrame.lookAt(vec(spot.position), vec(spot.lookAt))
end

function WorldService.interactable(id: string): Interactable?
	local item = getWorld().interactables[id]
	if item then
		return item :: any
	end
	return getFeatures().interactables[id]
end

function WorldService.setInteractEnabled(id: string, enabled: boolean)
	local item = getWorld().interactables[id]
	if item then
		item.enabled = enabled
		item.focus:SetAttribute(Tags.Attr.InteractEnabled, enabled)
		return
	end
	setFeatureEnabled(id, enabled)
end

-- Restaura o mundo para o início de uma rodada. `rng` sorteia fusíveis, chave e pilhas.
function WorldService.resetRound(rng: Random, plan: ProceduralLayout.Plan?)
	local w = getWorld()
	local f = getFeatures()
	if Config.House.Enabled then
		for _, locker in f.lockers do
			locker.occupant = nil
			locker.door.CFrame = locker.doorClosed
		end
		for _, door in w.doors do
			setLocked(door, false)
			door.busy = false
			animateDoor(door, "open", true)
		end
		w.gate.busy, w.gate.isOpen = false, false
		w.gate.model:PivotTo(w.gate.closedPivot)
		WorldService.setPower(false)
		return
	end
	WorldService.rebuildSector(plan or ProceduralLayout.create(rng:NextInteger(1, 2147483646), 1))
	for id, model in w.fuseModels do
		local spots = Layout.FuseSpots[id]
		local spot = spots[rng:NextInteger(1, #spots)]
		model.Parent = fuseFolder
		model:PivotTo(CFrame.new(vec(spot)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0))
		WorldService.setInteractEnabled(id, true)
	end
	table.clear(taken)
	for _, door in w.doors do
		door.busy = false
		local startsLocked = Features.LockedDoors[door.id] == true
		setLocked(door, startsLocked)
		animateDoor(door, if door.startsOpen and not startsLocked then "open" else "closed", true)
	end
	w.gate.busy = false
	w.gate.isOpen = false
	w.gate.model:PivotTo(w.gate.closedPivot)
	WorldService.setInteractEnabled("gate", true)
	WorldService.setInteractEnabled("panel", true)
	WorldService.setPanelFuses(0)

	-- Chave: uma posição por rodada.
	local keySpot = Features.KeySpots[rng:NextInteger(1, #Features.KeySpots)]
	for id, model in f.keys do
		local shown = id == keySpot.id
		setModelShown(model, shown, pickupsFolder())
		setFeatureEnabled(id, shown)
	end
	-- Pilhas: algumas posições por rodada.
	local chosen = Features.pick(Features.BatterySpots, Config.Battery.PickupsPerRound, function(a, b)
		return rng:NextInteger(a, b)
	end)
	local chosenIds: { [string]: boolean } = {}
	for _, spot in chosen do
		chosenIds[spot.id] = true
	end
	for id, model in f.batteries do
		setModelShown(model, chosenIds[id] == true, pickupsFolder())
		setFeatureEnabled(id, chosenIds[id] == true)
	end
	for _, locker in f.lockers do
		locker.occupant = nil
		locker.door.CFrame = locker.doorClosed
	end
	WorldService.setBreakers({ false, false, false })
	WorldService.setPower(false)
end

-- ----- Fusíveis, quadro, energia -----

function WorldService.setFuseCollected(id: string)
	local model = getWorld().fuseModels[id]
	if model then
		model.Parent = nil
	end
	WorldService.setInteractEnabled(id, false)
end

function WorldService.setPanelFuses(count: number)
	local panel = getWorld().panel
	for index, fuse in panel.slotFuses do
		fuse.Transparency = if index <= count then 0 else 1
	end
	if count > 0 then
		panel.switchSound:Play()
	end
	panel.focus:SetAttribute("Fuses", count)
end

function WorldService.setPower(on: boolean)
	powered = on
	local w = getWorld()
	for _, part in lights() do
		local kind = part:GetAttribute(Tags.Attr.LightKind)
		if kind == "Lamp" or kind == "Flood" or kind == "Beacon" then
			setLightPart(part, on)
		end
	end
	w.panel.status.Color = if on then Palette.PanelOn else Palette.PanelOff
	for _, buzz in w.buzz do
		if on then
			buzz:Play()
		else
			buzz:Stop()
		end
	end
	if on then
		w.panel.hum:Play()
		w.panel.switchSound:Play()
	else
		w.panel.hum:Stop()
	end
	applyLighting(on)
end

function WorldService.isPowered(): boolean
	return powered
end

-- ----- Disjuntores -----

-- Posição das alavancas (true = levantada) e lâmpadas (verde quando levantada).
function WorldService.setBreakers(up: { boolean })
	local b = getFeatures().breakers
	for i, lever in b.levers do
		local isUp = up[i] == true
		lever.CFrame = if isUp then b.up[i] else b.down[i]
		local lamp = b.lamps[i]
		lamp.Color = if isUp then Palette.PanelOn else Palette.LampOff
		lamp.Material = if isUp then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

-- Texto do procedimento na prancheta da parede (ordem da rodada).
function WorldService.setProcedure(order: string)
	local b = getFeatures().breakers
	b.diagram.Text = `RELIGAMENTO\n\n{order}`
	b.box:SetAttribute("Order", order)
end

-- Feedback físico: "ok" (clique seco), "wrong" (pancada + faíscas), "solved" (chave geral), "denied".
function WorldService.breakerFeedback(kind: "ok" | "wrong" | "solved" | "denied")
	local b = getFeatures().breakers
	if kind == "ok" then
		b.toggle.PlaybackSpeed = 0.8
		b.toggle:Play()
	elseif kind == "denied" then
		b.toggle.PlaybackSpeed = 0.55
		b.toggle:Play()
	elseif kind == "wrong" then
		b.toggle.PlaybackSpeed = 0.7
		b.toggle:Play()
		b.fail:Play()
		sparkCount += 1
		-- O cliente solta faíscas e pisca as lâmpadas em vermelho ao ver o contador mudar.
		b.box:SetAttribute("Spark", sparkCount)
		for _, lamp in b.lamps do
			lamp.Color = Palette.Emergency
			lamp.Material = Enum.Material.Neon
		end
	elseif kind == "solved" then
		b.solved:Play()
		b.box:SetAttribute("Solved", os.clock())
	end
end

-- ----- Chave e pilhas -----

function WorldService.setTaken(id: string)
	local f = getFeatures()
	taken[id] = true
	local model = f.keys[id] or f.batteries[id]
	if model then
		model.Parent = nil
	end
	setFeatureEnabled(id, false)
end

function WorldService.takenSnapshot(): { [string]: boolean }
	return table.clone(taken)
end

-- Checkpoint: itens pegos continuam pegos (os outros voltam como estavam na rodada).
function WorldService.applyTaken(snapshot: { [string]: boolean })
	for id in snapshot do
		WorldService.setTaken(id)
	end
end

-- ----- Armários -----

function WorldService.locker(id: string): FeatureBuilder.LockerHandle?
	return getFeatures().lockers[id]
end

-- Porta do armário abre e fecha (entrada/saída), em passos.
function WorldService.swingLocker(id: string)
	local locker = getFeatures().lockers[id]
	if not locker then
		return
	end
	locker.sound:Play()
	task.spawn(function()
		for _, angle in { 35, 70, 70, 30, 0 } do
			locker.door.CFrame = locker.hinge
				* CFrame.Angles(0, math.rad(-angle), 0)
				* (locker.hinge:Inverse() * locker.doorClosed)
			task.wait(1 / 12)
		end
		locker.door.CFrame = locker.doorClosed
	end)
end

-- ----- Portas -----

function WorldService.door(id: string): MapBuilder.DoorHandle?
	return getWorld().doors[id]
end

function WorldService.doorState(id: string): DoorState
	return doorStates[id] or "closed"
end

function WorldService.isLocked(id: string): boolean
	return locked[id] == true
end

-- Ação principal (E). Retorna (ok, estado novo).
function WorldService.useDoor(id: string): (boolean, DoorState)
	local door = getWorld().doors[id]
	if not door or locked[id] then
		return false, WorldService.doorState(id)
	end
	local nextState: DoorState = if doorStates[id] == "open" then "closed" else "open"
	animateDoor(door, nextState)
	return true, nextState
end

-- Ação alternativa (Q): entreabrir ou fechar a fresta.
function WorldService.altDoor(id: string): (boolean, DoorState)
	local door = getWorld().doors[id]
	if not door or locked[id] then
		return false, WorldService.doorState(id)
	end
	local nextState: DoorState = if doorStates[id] == "crack" then "closed" else "crack"
	animateDoor(door, nextState)
	return true, nextState
end

-- Compatível com a API antiga (abre/fecha).
function WorldService.toggleDoor(id: string): (boolean, boolean)
	local ok, state = WorldService.useDoor(id)
	return ok, state == "open"
end

function WorldService.rattleDoor(id: string)
	local door = getWorld().doors[id]
	if not door then
		return
	end
	local sound = rattles[id]
	if sound and not sound.IsPlaying then
		sound:Play()
	end
	twitch(door, 1.2)
end

-- Destranca com a chave: insere, gira, clique (UnlockTime s) e deixa entreaberta.
function WorldService.unlockDoor(id: string, player: Player): boolean
	local door = getWorld().doors[id]
	if not door or not locked[id] then
		return false
	end
	door.panel:SetAttribute("LockState", "unlocking")
	door.panel:SetAttribute("UnlockBy", player.UserId)
	task.spawn(function()
		local latch = latches[id]
		task.wait(0.35)
		if latch then
			latch.PlaybackSpeed = 1.6
			latch:Play()
		end
		task.wait(Config.Doors.UnlockTime - 0.35)
		if latch then
			latch.PlaybackSpeed = 1.1
		end
		setLocked(door, false)
		animateDoor(door, "crack")
	end)
	return true
end

-- Porta fechada (ou entreaberta) e destrancada perto de `position`: o Vigia empurra.
function WorldService.closedDoorNear(position: Vector3, range: number): MapBuilder.DoorHandle?
	for _, door in getWorld().doors do
		if not door.isOpen and not door.busy and not locked[door.id] then
			local delta = door.center - position
			if math.abs(delta.Y) < 10 and Vector3.new(delta.X, 0, delta.Z).Magnitude <= range then
				return door
			end
		end
	end
	return nil
end

-- Porta trancada perto de `position` (o Vigia bate e desiste).
function WorldService.lockedDoorNear(position: Vector3, range: number): MapBuilder.DoorHandle?
	for _, door in getWorld().doors do
		if locked[door.id] then
			local delta = door.center - position
			if math.abs(delta.Y) < 10 and Vector3.new(delta.X, 0, delta.Z).Magnitude <= range then
				return door
			end
		end
	end
	return nil
end

function WorldService.bangDoor(door: MapBuilder.DoorHandle)
	door.panel:SetAttribute("BangSerial", ((door.panel:GetAttribute("BangSerial") :: number?) or 0) + 1)
	local sound = bangs[door.id]
	if sound and not sound.IsPlaying then
		sound:Play()
	end
	twitch(door, 2.5)
end

function WorldService.forceOpenDoor(door: MapBuilder.DoorHandle)
	if not door.isOpen and not locked[door.id] then
		animateDoor(door, "open")
		door.sound.PlaybackSpeed = 0.75
	end
end

function WorldService.doorSnapshot(): ({ [string]: DoorState }, { [string]: boolean })
	return table.clone(doorStates), table.clone(locked)
end

function WorldService.applyDoors(states: { [string]: DoorState }, lockedStates: { [string]: boolean })
	for id, door in getWorld().doors do
		setLocked(door, lockedStates[id] == true)
		animateDoor(door, states[id] or "closed", true)
	end
end

-- ----- Portão -----

function WorldService.openGate(): boolean
	local gate = getWorld().gate
	if gate.isOpen or gate.busy then
		return false
	end
	gate.isOpen = true
	gate.busy = true
	WorldService.setInteractEnabled("gate", false)
	gate.sound:Play()
	task.spawn(function()
		local frames = Config.Visual.GateFrames
		for i = 1, frames do
			gate.model:PivotTo(gate.closedPivot:Lerp(gate.openPivot, i / frames))
			task.wait(0.3)
		end
		gate.busy = false
	end)
	return true
end

function WorldService.isInsideBuilding(position: Vector3): boolean
	if Config.House.Enabled then
		return math.abs(position.X) < 45
			and position.Z > -85
			and position.Z < 60
			and position.Y > -18
			and position.Y < 48
	end
	local inSector = sectorPlan ~= nil and ProceduralLayout.isIndoor(sectorPlan, position.X, position.Z)
	return (Layout.isIndoor(position.X, position.Z) or inSector) and position.Y < Layout.CEILING
end

function WorldService.isInExitZone(position: Vector3): boolean
	if Config.House.Enabled and houseStage >= 6 then
		return math.abs(position.X - Forest.Exit.x) < 11
			and math.abs(position.Z - Forest.Exit.z) < 8
			and position.Y > -1
			and position.Y < 10
	end
	if Config.House.Enabled then
		return math.abs(position.X) < 12
			and position.Z > 101
			and position.Z < 116
			and position.Y > -1
			and position.Y < 10
	end
	return Layout.inRect(Layout.ExitZone, position.X, position.Z)
end

function WorldService.setHouseStage(chapter: number, seed: number?, mode: string?)
	houseStage = chapter
	getWorld().root:SetAttribute("HouseChapter", chapter)
	getWorld().root:SetAttribute("ForestBlackout", false)
	ForestBuilder.clear(getWorld().root, getFeatures())
	getWorld().root:SetAttribute("ForestActive", chapter >= 6)
	if chapter >= 6 then
		WorldService.setHouseDestruction(false)
		ForestBuilder.build(getWorld().root, chapter, seed or 1, getFeatures())
		getWorld().spawnCFrame = CFrame.lookAt(Vector3.new(0, 3, 580), Vector3.new(0, 3, 640))
		return
	end
	local architecture = getWorld().root:FindFirstChild("Architecture")
	if architecture then
		for _, part in architecture:GetChildren() do
			if
				part:IsA("BasePart")
				and (string.find(part.Name, "Roof") or string.find(part.Name, "Facade") or part.Name == "RoomCeiling")
			then
				part.Transparency, part.CanCollide, part.CanQuery = 0, true, true
			end
		end
	end
	local gates = getWorld().root:FindFirstChild("MissionGates")
	if gates then
		for _, gate in gates:GetChildren() do
			if gate:IsA("BasePart") then
				local open = (gate.Name == "entry" and chapter == 1)
					or (gate.Name == "corridor" and chapter >= 2)
					or (gate.Name == "upstairs" and chapter >= 3)
					or (gate.Name == "basement" and chapter >= 4)
					or (gate.Name == "ritual" and chapter >= 5)
				gate.CanCollide, gate.CanQuery, gate.Transparency = not open, not open, if open then 1 else 0
				for _, child in gate:GetDescendants() do
					if child:IsA("SurfaceGui") then
						child.Enabled = not open
					end
				end
			end
		end
	end
	getWorld().spawnCFrame = CFrame.lookAt(Vector3.new(0, 3, if chapter == 1 then 77 else 2), Vector3.new(0, 3, -20))
	WorldService.setHouseDestruction(false)
	local level = HouseLevels.create(seed or 1, chapter, mode or "Story")
	HouseLevelBuilder.build(getWorld().root, level)
	outdoorPatrol = {}
	if level.outdoor then
		for _, spot in level.spots do
			table.insert(outdoorPatrol, { x = spot.x, y = spot.y, z = spot.z })
		end
		getWorld().spawnCFrame = CFrame.lookAt(Vector3.new(0, 3, 77), Vector3.new(0, 3, 0))
		local entry = gates and gates:FindFirstChild("entry")
		if entry and entry:IsA("BasePart") then
			entry.CanCollide, entry.CanQuery, entry.Transparency = false, false, 1
		end
	end
	HouseAccess.refresh(getWorld().root)
end
function WorldService.upperNoise()
	local source = Build.part(
		getWorld().root,
		"UpperKnock",
		Vector3.new(0.1, 0.1, 0.1),
		CFrame.new(26, 21, 9),
		Color3.new(0, 0, 0),
		{ transparency = 1, collide = false, query = false }
	)
	local knock = Build.sound(source, "Knock", Audio.DoorBang.id, 0.7)
	knock:Play()
	game:GetService("Debris"):AddItem(source, 5)
end
function WorldService.forestPressure(now: number, playing: boolean)
	if houseStage >= 6 then
		ForestBuilder.pressure(getWorld().root, now, houseStage, playing)
	end
end
function WorldService.houseEvent(event: string?)
	if not event then
		return
	end
	if string.sub(event, 1, 7) == "forest_" then
		local forest = getWorld().root:FindFirstChild("Forest")
		if forest then
			forest:SetAttribute("LastEvent", event)
			if event == "forest_blackout" or event == "forest_broadcast" or event == "forest_winch" then
				forest:SetAttribute("ForcedBlackoutUntil", workspace:GetServerTimeNow() + 7)
			end
		end
	end
	if event == "power" then
		WorldService.setPower(true)
	end
	local gates = getWorld().root:FindFirstChild("MissionGates")
	if gates and event == "destruction" then
		local entry = gates:FindFirstChild("entry")
		if entry and entry:IsA("BasePart") then
			entry.CanCollide, entry.CanQuery, entry.Transparency = false, false, 1
			for _, child in entry:GetDescendants() do
				if child:IsA("SurfaceGui") then
					child.Enabled = false
				end
			end
		end
	end
	local gate = gates and gates:FindFirstChild(event)
	if gate and gate:IsA("BasePart") then
		-- A primeira pessoa a entrar não pode trancar os colegas que ainda estão no jardim.
		local closing = false
		gate.CanCollide, gate.CanQuery, gate.Transparency = closing, closing, if closing then 0 else 1
		for _, child in gate:GetDescendants() do
			if child:IsA("SurfaceGui") then
				child.Enabled = false
			end
		end
	end
	HouseAccess.refresh(getWorld().root)
end
function WorldService.houseRuins()
	HouseLevelBuilder.ruins(getWorld().root)
	local architecture = getWorld().root:FindFirstChild("Architecture")
	if architecture then
		for _, part in architecture:GetChildren() do
			if
				part:IsA("BasePart")
				and (
					string.find(part.Name, "Roof")
					or string.find(part.Name, "Facade")
					or part.Name == "RoomCeiling"
					or part.Name == "EntrySide"
					or part.Name == "EntryLintel"
				)
			then
				part.Transparency = 1
				part.CanCollide, part.CanQuery = false, false
			end
		end
	end
	local ruins = Build.folder(getWorld().root, "Ruins")
	for _, x in { -21, 21 } do
		local beam = Build.block(
			ruins,
			"FallenBeam",
			Vector3.new(x, 0, 52),
			Vector3.new(16, 2, 3),
			x,
			Color3.fromRGB(43, 29, 23),
			{ collide = false, query = false }
		)
		local fire = Instance.new("Fire")
		fire.Size, fire.Heat, fire.Parent = 5, 2, beam
	end
	local glow = Build.block(
		ruins,
		"EndingLight",
		Vector3.new(0, 4, 65),
		Vector3.one,
		0,
		Color3.new(0, 0, 0),
		{ transparency = 1, collide = false, query = false }
	)
	Build.light(glow, "Ending", Color3.fromRGB(255, 148, 82), 30, 2, true)
end
function WorldService.setHouseDestruction(on: boolean)
	local w = getWorld()
	local old = w.root:FindFirstChild("Destruction")
	if old then
		old:Destroy()
	end
	if not on then
		return
	end
	local folder = Build.folder(w.root, "Destruction")
	-- Fogo/entulho sao cenicos nas alas; a espinha de fuga nao e bloqueada.
	for _, x in { -40, 40 } do
		for _, z in { -72, -40, -8 } do
			local ember = Build.block(
				folder,
				"BurningDebris",
				Vector3.new(x, 0, z),
				Vector3.new(3, 1, 3),
				20,
				Color3.fromRGB(85, 30, 20),
				{ collide = false, query = false }
			)
			local fire = Instance.new("Fire")
			fire.Size = 7
			fire.Heat = 4
			fire.Parent = ember
			Build.light(ember, "Emergency", Color3.fromRGB(235, 65, 25), 30, 1.5, true)
		end
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="483">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="484">
          <Properties>
            <string name="Name">ArtBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Camada de arte reprodutível. Todos os acréscimos são decorativos, sem colisão/visão física.
local CollectionService = game:GetService("CollectionService")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Build = require("./Build")
local Layout = require("./Layout")
local Palette = require("./Palette")
local ProceduralLayout = require("./ProceduralLayout")

local Art = {}
local V3 = Vector3.new
local DECOR = { collide = false, query = false, material = Enum.Material.Metal }

local function detail(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): BasePart
	local part = Build.part(parent, name, size, cf, color, DECOR)
	part.CanTouch = false
	return part
end

local function cabinet(parent: Instance, position: Vector3, yaw: number, label: string)
	local model = Build.model(parent, "Switchgear")
	local cf = CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0)
	local body = detail(model, "PaintedCabinet", V3(2.5, 6.4, 0.65), cf * CFrame.new(0, 3.2, 0), Palette.WallLowerCold)
	body:SetAttribute("SurfaceStyle", "paint")
	for _, x in { -0.95, 0.95 } do
		detail(model, "Hinge", V3(0.08, 5.8, 0.04), cf * CFrame.new(x, 3.3, -0.35), Palette.MetalDark)
	end
	for y = 1, 3 do
		detail(model, "Vent", V3(1.8, 0.08, 0.04), cf * CFrame.new(0, 1 + y * 0.19, -0.36), Palette.Black)
	end
	detail(model, "Handle", V3(0.12, 0.7, 0.12), cf * CFrame.new(0.8, 3.5, -0.4), Palette.Brass)
	local sign = Build.sign(
		model,
		"AssetPlate",
		(cf * CFrame.new(0, 5.5, -0.36)).Position,
		cf.LookVector,
		Vector2.new(2, 0.48),
		label,
		{ textColor = Palette.Paper, background = Palette.MetalDark, thickness = 0.02 }
	)
	sign.CanQuery = false
	-- Medidor com escala e ponteiro. A leitura é visual, sem interação nova.
	local face = detail(model, "MeterFace", V3(1.2, 0.85, 0.04), cf * CFrame.new(-0.25, 4.15, -0.36), Palette.Paper)
	face.Material = Enum.Material.SmoothPlastic
	for x = -2, 2 do
		detail(model, "Tick", V3(0.035, 0.14, 0.02), cf * CFrame.new(-0.25 + x * 0.2, 4.35, -0.39), Palette.Black)
	end
	detail(
		model,
		"Needle",
		V3(0.04, 0.4, 0.02),
		cf * CFrame.new(-0.35, 4.1, -0.4) * CFrame.Angles(0, 0, -0.5),
		Palette.Red
	)
end

local function dressRooms(root: Instance)
	for index, room in Layout.Rooms do
		if room.id == "Switchyard" then
			continue
		end
		local folder = Build.model(root, room.id)
		-- Condutos altos, fora da altura de portas e janelas e longe dos alvos da campanha.
		local x = room.x1 - 0.7
		local z = (room.z0 + room.z1) / 2
		local length = room.z1 - room.z0 - 2
		detail(folder, "Conduit", V3(0.12, 0.12, length), CFrame.new(x, 9.8, z), Palette.Metal)
		for _, endZ in { room.z0 + 1, room.z1 - 1 } do
			detail(folder, "Junction", V3(0.65, 0.6, 0.22), CFrame.new(x, 9.8, endZ), Palette.MetalDark)
		end
		local plaque = Build.sign(
			folder,
			"SectorPlate",
			V3(room.x0 + 0.57, 8, room.z0 + 2.7),
			Vector3.xAxis,
			Vector2.new(3.1, 0.9),
			string.format("S9 / %02d", index),
			{ textColor = Palette.Paper, background = Palette.WallLowerCold, thickness = 0.04 }
		)
		plaque.CanQuery = false
		-- Desgaste do rodapé em pequenos trechos, sem cobrir aberturas/placas existentes.
		for i = 1, 3 do
			local stain = detail(
				folder,
				"DampMark",
				V3(0.018, 0.3 + i * 0.17, 0.4 + i * 0.28),
				CFrame.new(room.x1 - 0.512, 0.35 + i * 0.08, room.z0 + 1.4 + i * 0.7),
				Palette.Trim
			)
			stain.Transparency = 0.35
		end
		local dust =
			detail(folder, "DustAnchor", V3(0.1, 0.1, 0.1), CFrame.new((room.x0 + room.x1) / 2, 8.3, z), Palette.Paper)
		dust.Transparency = 1
		CollectionService:AddTag(dust, "ArtDust")
	end
	cabinet(root, V3(-66.5, 0, -39), 90, "AUX / 09-04")
	cabinet(root, V3(-37.8, 0, -72), 90, "PROTEÇÃO / 132")
	cabinet(root, V3(36.8, 0, -69), -90, "LINHA / 09-02")
	-- Manchas de óleo junto às máquinas; nunca ocupam a rota com geometria de colisão.
	for index, p in { V3(-28, 0.012, -39), V3(15, 0.012, -8), V3(-63, 0.012, -9), V3(59, 0.012, -53) } do
		for i = 1, 3 do
			local patch = detail(
				root,
				"OilStain",
				V3(1.1 + i * 0.5, 0.01, 0.6 + i * 0.4),
				CFrame.new(p + V3(i * 0.3, i * 0.002, 0)) * CFrame.Angles(0, index + i, 0),
				Palette.MetalDark
			)
			patch.Transparency = 0.28
		end
	end
end

local function surfaceKind(part: BasePart): string?
	local explicit = part:GetAttribute("SurfaceStyle")
	if type(explicit) == "string" then
		return explicit
	end
	local name = part.Name
	if name:sub(1, 5) == "Wall_" then
		return "paint"
	elseif name == "Floor" then
		return "concrete"
	elseif name == "Tile" then
		return if (math.floor(part.Position.X) + math.floor(part.Position.Z)) % 12 == 0 then "tiles" else nil
	elseif name == "Body" and part.Parent then
		return if part.Parent.Name == "Crate" then "wood" elseif part.Parent.Name == "Cabinet" then "paint" else nil
	elseif name == "Top" and part.Parent and part.Parent.Name == "Desk" then
		return "wood"
	elseif name == "Tank" or name == "Engine" or name == "ControlConsole" or name == "PaintedCabinet" then
		return "rust"
	end
	return nil
end

function Art.build(world: Instance)
	local root = Build.folder(world, "ArtDetails")
	dressRooms(root)
	local surfaces = {}
	for _, object in world:GetDescendants() do
		if not object:IsA("BasePart") then
			continue
		end
		local kind = surfaceKind(object)
		if kind then
			object:SetAttribute("SurfaceStyle", kind)
			object.Material = if kind == "concrete" and object.Material == Enum.Material.DiamondPlate
				then Enum.Material.DiamondPlate
				elseif kind == "wood" then Enum.Material.Wood
				elseif kind == "concrete" then Enum.Material.Concrete
				elseif kind == "rust" then Enum.Material.Metal
				else Enum.Material.Concrete
			table.insert(surfaces, object)
		end
		if object.Name == "Screen" or object.Name == "DeadMonitor" then
			CollectionService:AddTag(object, "ArtScreen")
		end
	end
	-- Ordem independente da enumeração do engine, distribuída por posição; orçamento rígido.
	table.sort(surfaces, function(a: BasePart, b: BasePart)
		local ap, bp = a.Position, b.Position
		local function rank(part: BasePart): number
			if part.Name:sub(1, 5) ~= "Wall_" and part.Name ~= "Tile" then
				return -1
			end
			local p = part.Position
			return (math.floor(p.X * 4) * 137 + math.floor(p.Z * 4) * 269 + math.floor(p.Y * 4) * 53) % 1009
		end
		local ar, br = rank(a), rank(b)
		if ar ~= br then
			return ar < br
		end
		if ap.Z ~= bp.Z then
			return ap.Z < bp.Z
		end
		if ap.X ~= bp.X then
			return ap.X < bp.X
		end
		return ap.Y < bp.Y
	end)
	-- A ala reconstruída por rodada usa o mesmo atlas e respeita o orçamento global.
	for i = 1, math.min(#surfaces, Config.Art.SurfacePartLimit - ProceduralLayout.SurfaceBudget) do
		CollectionService:AddTag(surfaces[i], "ArtSurface")
	end
	root:SetAttribute("SurfaceCandidates", #surfaces)
end

return Art
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="485">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Helpers para montar o mundo com primitivas (Part/Wedge/Cylinder), placas com texto e luzes.
	Tudo nasce ancorado e com superfícies lisas. Geometria opaca sólida projeta sombra.
]]

local CollectionService = game:GetService("CollectionService")

local PixelText = require("@game/ReplicatedStorage/Shared/Game/PixelText")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")

export type PartOptions = {
	material: Enum.Material?,
	transparency: number?,
	collide: boolean?,
	query: boolean?,
	reflectance: number?,
	class: ("Part" | "WedgePart" | "CornerWedgePart")?,
}

export type SignOptions = {
	textColor: Color3,
	background: Color3?,
	backgroundTransparency: number?,
	font: Enum.Font?,
	-- true = texto emite luz (não depende da iluminação da cena).
	lit: boolean?,
	pixelsPerStud: number?,
	partColor: Color3?,
	thickness: number?,
}

local Build = {}

function Build.folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function Build.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	options: PartOptions?
): BasePart
	local opts: PartOptions = options or {}
	local part = Instance.new(opts.class or "Part") :: BasePart
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = opts.material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = opts.transparency or 0
	part.CastShadow = part.Transparency < 0.5 and opts.collide ~= false
	part.Reflectance = opts.reflectance or 0
	if opts.collide ~= nil then
		part.CanCollide = opts.collide
	end
	if opts.query ~= nil then
		part.CanQuery = opts.query
	end
	part.Parent = parent
	return part
end

-- Caixa alinhada aos eixos a partir dos cantos mínimo e máximo.
function Build.box(
	parent: Instance,
	name: string,
	min: Vector3,
	max: Vector3,
	color: Color3,
	options: PartOptions?
): BasePart
	local size = max - min
	return Build.part(parent, name, size, CFrame.new((min + max) / 2), color, options)
end

-- Caixa apoiada no chão: `base` é o centro da face de baixo; `yaw` em graus.
function Build.block(
	parent: Instance,
	name: string,
	base: Vector3,
	size: Vector3,
	yaw: number,
	color: Color3,
	options: PartOptions?
): BasePart
	local cframe = CFrame.new(base + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, math.rad(yaw), 0)
	return Build.part(parent, name, size, cframe, color, options)
end

-- Cilindro com o eixo na direção `axis`.
function Build.cylinder(
	parent: Instance,
	name: string,
	center: Vector3,
	axis: Vector3,
	length: number,
	diameter: number,
	color: Color3,
	options: PartOptions?
): BasePart
	local x = axis.Unit
	local helper = if math.abs(x.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis
	local z = x:Cross(helper).Unit
	local y = z:Cross(x).Unit
	local cframe = CFrame.fromMatrix(center, x, y)
	local part = Build.part(parent, name, Vector3.new(length, diameter, diameter), cframe, color, options);
	(part :: Part).Shape = Enum.PartType.Cylinder
	return part
end

-- Liga uma PointLight a uma peça e registra a tag/atributos para WorldService e cliente.
function Build.light(
	part: BasePart,
	kind: string,
	color: Color3,
	range: number,
	brightness: number,
	enabled: boolean,
	flicker: boolean?
): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Enabled = enabled
	light.Parent = part
	part:SetAttribute(Tags.Attr.LightKind, kind)
	part:SetAttribute(Tags.Attr.Flicker, flicker == true)
	part:SetAttribute("BaseBrightness", brightness)
	CollectionService:AddTag(part, Tags.PowerLight)
	return light
end

-- Placa com texto. `facing` é a direção para onde o texto olha (o leitor fica nesse lado).
function Build.sign(
	parent: Instance,
	name: string,
	position: Vector3,
	facing: Vector3,
	size: Vector2,
	text: string,
	options: SignOptions
): BasePart
	local thickness = options.thickness or 0.2
	local cframe = CFrame.lookAt(position, position + facing)
	local part = Build.part(
		parent,
		name,
		Vector3.new(size.X, size.Y, thickness),
		cframe,
		options.partColor or options.background or Color3.new(0, 0, 0),
		{ collide = false }
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = options.pixelsPerStud or 40
	gui.LightInfluence = if options.lit then 0 else 1
	gui.Brightness = if options.lit then 1.6 else 1
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = options.background or Color3.new(0, 0, 0)
	label.BackgroundTransparency = options.backgroundTransparency or (if options.background then 0 else 1)
	label.BorderSizePixel = 0
	label.Font = options.font or Enum.Font.Arcade
	label.TextColor3 = options.textColor
	label.TextScaled = true
	label.Text = if label.Font == Enum.Font.Arcade then PixelText.normalize(text) else text
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = label
	return part
end

-- Som 3D preso a uma peça (o servidor toca; replica para os clientes).
function Build.sound(part: Instance, name: string, id: string, volume: number, speed: number?, looped: boolean?): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = speed or 1
	sound.Looped = looped == true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = 80
	sound.Parent = part
	return sound
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="486">
          <Properties>
            <string name="Name">Expansion</string>
            <string name="Source"><![CDATA[--!strict
-- Alas técnicas: cenário estático, sem objetivos/remotes; usa as luzes e a energia do mundo existente.
local Build = require("./Build")
local Layout = require("./Layout")
local Palette = require("./Palette")
local Props = require("./Props")

local V3 = Vector3.new
local Expansion = {}

local function sign(parent: Instance, name: string, p: Vector3, facing: Vector3, text: string)
	Build.sign(parent, name, p, facing, Vector2.new(8, 1.6), text, {
		textColor = Palette.Hazard,
		background = Palette.Trim,
	})
end

local function fence(parent: Instance, a: Vector3, b: Vector3)
	local h = Layout.FenceHeight
	local length = (b - a).Magnitude
	local frame = CFrame.lookAt((a + b) / 2 + V3(0, h / 2, 0), b + V3(0, h / 2, 0))
	Build.part(parent, "TechnicalFence", V3(0.2, h, length), frame, Palette.Fence, {
		material = Enum.Material.Metal,
		transparency = 0.55,
	})
	for _, y in { -h / 2 + 0.4, h / 2 } do
		Build.part(parent, "FenceRail", V3(0.3, 0.3, length), frame * CFrame.new(0, y, 0), Palette.MetalDark)
	end
	local count = math.ceil(length / 6)
	for i = 0, count do
		Build.block(parent, "FencePost", a:Lerp(b, i / count), V3(0.4, h + 0.6, 0.4), 0, Palette.MetalDark)
	end
end

local function roofs(parent: Instance)
	for _, room in Layout.Rooms do
		if room.id == "Maintenance" or room.id == "CableGallery" or room.id == "Control" or room.id == "Archive" then
			Build.box(
				parent,
				`Roof_{room.id}`,
				V3(room.x0 - 0.5, Layout.CEILING, room.z0 - 0.5),
				V3(room.x1 + 0.5, Layout.CEILING + 1, room.z1 + 0.5),
				Palette.Ceiling
			)
		end
	end
end

local function workshop(parent: Instance)
	local room = Build.model(parent, "Workshop")
	Props.workbench(room, V3(-62, 0, -44), 0)
	Props.shelf(room, V3(-64.5, 0, -14), 90, 9)
	Props.locker(room, V3(-44, 0, -14), -90, 3)
	Props.bench(room, V3(-62, 0, -4), 0)
	Props.crate(room, V3(-64, 0, -36), 12, 3)
	Props.crate(room, V3(-44, 0, -35), -8, 3)
	-- Divisória interrompe a visão longa, mantendo um vão de oito studs no eixo de circulação.
	Build.box(room, "WorkshopDivider", V3(-68, 0, -30.5), V3(-58, 8, -29.5), Palette.WallLowerCold)
	Build.box(room, "WorkshopDivider", V3(-50, 0, -30.5), V3(-40, 8, -29.5), Palette.WallLowerCold)
	sign(room, "WorkshopEntry", V3(-54, 9.6, 0.6), Vector3.zAxis, "OFICINA / ACESSO TÉCNICO")
	sign(room, "WorkshopRoute", V3(-54, 9.5, -29.3), Vector3.zAxis, "^ CONTROLE / ARQUIVO")
	sign(room, "CoreReturn", V3(-40.6, 9.5, -22), -Vector3.xAxis, "CORREDOR / GERADOR")
	Props.pipe(room, V3(-65.5, 9.5, -48), V3(-65.5, 9.5, -2), 0.5, Palette.Rust, false)
end

local function gallery(parent: Instance)
	local room = Build.model(parent, "CableGallery")
	for _, x in { -65, -62 } do
		Props.pipe(room, V3(x, 9, -76), V3(x, 9, -52), 0.8, Palette.MetalDark, false)
	end
	for _, z in { -73, -55 } do
		Build.block(room, "CableReel", V3(-63, 0, z), V3(4, 3, 3), 0, Palette.WoodDark)
		Build.cylinder(room, "ReelCable", V3(-63, 1.5, z), Vector3.zAxis, 2.6, 2.4, Palette.Black)
	end
	sign(room, "GalleryLabel", V3(-54, 7, -77.4), Vector3.zAxis, "GALERIA DE CABOS\nSETOR 09-B")
	sign(room, "GalleryReturn", V3(-54, 9.6, -50.6), -Vector3.zAxis, "OFICINA / SAÍDA v")
end

local function control(parent: Instance)
	local room = Build.model(parent, "ControlRoom")
	-- Console baixo e monitores na parede; a passagem leste-oeste fica livre em z=-64.
	for _, x in { -32, -24, -16 } do
		Build.block(room, "ControlConsole", V3(x, 0, -74), V3(7.6, 3.2, 3), 0, Palette.MetalDark)
		Build.part(room, "DeadMonitor", V3(3.6, 2.2, 0.2), CFrame.new(x, 5, -76.8), Palette.Screen, { collide = false })
		for i = -1, 1 do
			Build.part(
				room,
				"ConsoleSwitch",
				V3(0.3, 0.12, 0.5),
				CFrame.new(x + i, 3.25, -73.5),
				Palette.Hazard,
				{ collide = false }
			)
		end
	end
	Props.chair(room, V3(-24, 0, -70), 0)
	Props.chair(room, V3(-16, 0, -70), 15, true)
	Props.cabinet(room, V3(-36, 0, -54), 0)
	Props.counter(room, V3(-12, 0, -55), 0, 8)
	Build.sign(
		room,
		"ElectricalDiagram",
		V3(-20, 7.5, -50.6),
		-Vector3.zAxis,
		Vector2.new(14, 2),
		"SUBESTAÇÃO 9\nLINHA A --- [09] --- LINHA B",
		{
			textColor = Palette.ExitGreen,
			background = Palette.Black,
		}
	)
	sign(room, "ControlLabel", V3(-32, 9.6, -49.4), Vector3.zAxis, "CONTROLE / GALERIA")
	sign(room, "ControlEast", V3(3.4, 9.5, -64), -Vector3.xAxis, "ARQUIVO / PÁTIO TÉCNICO")
end

local function archive(parent: Instance)
	local room = Build.model(parent, "TechnicalArchive")
	-- Duas ilhas afastadas da travessia central e da conexão sul com o depósito.
	for _, x in { 12, 28 } do
		Props.shelf(room, V3(if x == 28 then 34 else x, 0, -74), 0, 9)
		Props.cabinet(room, V3(x, 0, -54), 0)
	end
	Props.desk(room, V3(34, 0, -56), 0)
	Props.chair(room, V3(34, 0, -59), 0)
	sign(room, "ArchiveLabel", V3(24, 9.6, -49.4), Vector3.zAxis, "ARQUIVO / CONTROLE")
	sign(room, "ArchiveExit", V3(39.4, 9.5, -64), -Vector3.xAxis, "PÁTIO DE TRANSFORMADORES")
	Build.sign(
		room,
		"ArchiveWarning",
		V3(10, 6, -77.4),
		Vector3.zAxis,
		Vector2.new(10, 2),
		"REGISTROS DO TURNO\nNÃO REMOVER",
		{
			textColor = Palette.Black,
			background = Palette.Paper,
			font = Enum.Font.SpecialElite,
		}
	)
end

local function transformer(parent: Instance, x: number, z: number, index: number)
	local unit = Build.model(parent, `Transformer_{index}`)
	Build.block(unit, "ConcretePad", V3(x, 0, z), V3(9, 0.15, 9), 0, Palette.Concrete)
	Build.block(
		unit,
		"TransformerBody",
		V3(x, 0.15, z),
		V3(6, 5.2, 5),
		0,
		Palette.WallLowerCold,
		{ material = Enum.Material.Metal }
	)
	for i = -3, 3 do
		for _, side in { -1, 1 } do
			Build.block(
				unit,
				"CoolingFin",
				V3(x + side * 3.3, 0.5, z + i * 0.65),
				V3(0.6, 4.5, 0.2),
				0,
				Palette.MetalDark
			)
		end
	end
	for _, dx in { -1.8, 0, 1.8 } do
		Build.cylinder(unit, "Insulator", V3(x + dx, 6.1, z), Vector3.yAxis, 1.6, 0.7, Palette.Ceramic)
		Build.cylinder(unit, "Terminal", V3(x + dx, 7.2, z), Vector3.yAxis, 0.7, 0.22, Palette.Metal)
	end
	Build.sign(
		unit,
		"TransformerNumber",
		V3(x, 3.6, z + 2.65),
		Vector3.zAxis,
		Vector2.new(3, 1.6),
		`T-0{index}\nALTA TENSÃO`,
		{
			textColor = Palette.Black,
			background = Palette.Hazard,
		}
	)
end

local function switchyard(parent: Instance)
	local yard = Build.model(parent, "Switchyard")
	local bounds = Layout.Compound
	fence(yard, V3(bounds.x1, 0, bounds.z0), V3(bounds.x1, 0, 0))
	fence(yard, V3(40, 0, bounds.z0), V3(bounds.x1, 0, bounds.z0))
	transformer(yard, 65, -61, 1)
	transformer(yard, 47, -44, 2)
	transformer(yard, 65, -33, 3)
	transformer(yard, 47, -14, 4)
	for _, z in { -70, -30, -6 } do
		for _, x in { 43, 69 } do
			Build.block(yard, "GantryPillar", V3(x, 0, z), V3(0.7, 13, 0.7), 0, Palette.MetalDark)
		end
		Build.block(yard, "GantryBeam", V3(56, 12.5, z), V3(27, 0.6, 0.6), 0, Palette.MetalDark)
	end
	for _, x in { 51, 56, 61 } do
		Props.pipe(yard, V3(x, 12, -70), V3(x, 12, -6), 0.12, Palette.Black, false)
	end
	for _, z in { -70, -42, -10 } do
		local head = Props.floodLight(yard, V3(70, 0, z), V3(54, 0, z))
		Build.light(head, "Flood", Palette.Sodium, 26, 0.9, false)
	end
	local emergency = Props.emergencyLight(yard, V3(40.7, 8, -64))
	Build.light(emergency, "Emergency", Palette.Emergency, 15, 0.8, true)
	sign(yard, "YardLabel", V3(56, 10, -6), Vector3.zAxis, "PÁTIO TÉCNICO\nTRANSFORMADORES 01-04")
	sign(yard, "YardCoreReturn", V3(40.6, 9.6, -22), Vector3.xAxis, "CORREDOR / GERADOR")
	sign(yard, "YardArchive", V3(40.6, 9.6, -64), Vector3.xAxis, "ARQUIVO / CONTROLE")
end

function Expansion.build(parent: Instance)
	roofs(parent)
	workshop(parent)
	gallery(parent)
	control(parent)
	archive(parent)
	switchyard(parent)
	-- Marcação de circulação sem colisão; não cria uma nova mecânica de interação.
	for _, x in { -54, 56 } do
		for z = -62, 26, 8 do
			Build.block(
				parent,
				"RouteMark",
				V3(x, 0.015, z),
				V3(0.25, 0.02, 2.5),
				0,
				Palette.Hazard,
				{ collide = false }
			)
		end
	end
end

return Expansion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="487">
          <Properties>
            <string name="Name">FeatureBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Monta no mundo as novidades do polish (dados em Features.luau). Chamado pelo WorldService
	DEPOIS do MapBuilder.build, dentro de Workspace.Substation9.Features. Não mexe em paredes.

	Devolve handles para o WorldService/PropService: interagíveis novos (chave, pilhas, armários,
	disjuntores, procedimento), armários, disjuntores e objetos que caem.
]]

local CollectionService = game:GetService("CollectionService")

local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Build = require("./Build")
local Features = require("./Features")
local Layout = require("./Layout")
local Palette = require("./Palette")

export type Interactable = {
	id: string,
	kind: string,
	focus: BasePart,
	model: Instance,
	maxDistance: number,
	enabled: boolean,
}

export type LockerHandle = {
	id: string,
	model: Model,
	door: BasePart,
	doorClosed: CFrame,
	hinge: CFrame,
	inside: CFrame,
	eye: CFrame,
	exit: CFrame,
	front: Vector3,
	sound: Sound,
	occupant: Player?,
}

export type BreakerHandle = {
	box: BasePart,
	levers: { BasePart },
	down: { CFrame },
	up: { CFrame },
	lamps: { BasePart },
	toggle: Sound,
	fail: Sound,
	solved: Sound,
	diagram: TextLabel,
}

export type FallableHandle = {
	id: string,
	kind: string,
	model: Model,
	primary: BasePart,
	home: { [BasePart]: CFrame },
	fall: Vector3,
	fallen: boolean,
	sound: Sound,
}

export type Built = {
	root: Folder,
	interactables: { [string]: Interactable },
	keys: { [string]: Model },
	batteries: { [string]: Model },
	lockers: { [string]: LockerHandle },
	breakers: BreakerHandle,
	fallables: { FallableHandle },
	radio: BasePart,
}

local V3 = Vector3.new
local FeatureBuilder = {}

local function vec(p: Features.Point): Vector3
	return V3(p.x, p.y, p.z)
end

local function register(
	built: Built,
	id: string,
	kind: string,
	focus: BasePart,
	model: Instance,
	prompt: string,
	distance: number?
)
	local maxDistance = distance or Config.Game.InteractDistance
	focus:SetAttribute(Tags.Attr.InteractId, id)
	focus:SetAttribute(Tags.Attr.InteractPrompt, prompt)
	focus:SetAttribute(Tags.Attr.InteractDistance, maxDistance)
	focus:SetAttribute(Tags.Attr.InteractEnabled, true)
	CollectionService:AddTag(focus, Tags.Interactable)
	built.interactables[id] = {
		id = id,
		kind = kind,
		focus = focus,
		model = model,
		maxDistance = maxDistance,
		enabled = true,
	}
end

local function clip(part: Instance, name: string, clipName: string, speed: number?, looped: boolean?): Sound
	local c = Audio[clipName]
	assert(c, `[FeatureBuilder] unknown clip {clipName}`)
	local sound = Build.sound(part, name, c.id, c.volume, speed or c.speed, looped)
	if c.region then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(c.region[1], c.region[2])
	end
	return sound
end

-- Armário de metal oco com frestas na porta (o jogador cabe dentro, de pé).
local function buildLocker(built: Built, parent: Instance, spec: Features.Locker)
	local base = vec(spec.base)
	local front = vec(spec.front).Unit
	local frame = CFrame.lookAt(base, base + front)
	local W, H, D = 2.8, 7.4, 2.6
	local model = Build.model(parent, spec.id)
	local function local3(x: number, y: number, z: number): CFrame
		-- z negativo = para a frente (LookVector).
		return frame * CFrame.new(x, y, z)
	end
	local color = Palette.WallLowerCold
	local metal = { material = Enum.Material.Metal }
	Build.part(model, "Back", V3(W, H, 0.2), local3(0, H / 2, D / 2 - 0.1), color, metal)
	Build.part(model, "Left", V3(0.2, H, D), local3(-W / 2 + 0.1, H / 2, 0), color, metal)
	Build.part(model, "Right", V3(0.2, H, D), local3(W / 2 - 0.1, H / 2, 0), color, metal)
	Build.part(model, "Top", V3(W, 0.2, D), local3(0, H - 0.1, 0), color, metal)
	Build.part(model, "Floor", V3(W, 0.2, D), local3(0, 0.1, 0), Palette.MetalDark, metal)
	Build.part(model, "Label", V3(1.2, 0.35, 0.05), local3(0, H - 0.6, -D / 2 - 0.08), Palette.Paper, {
		collide = false,
	})

	-- Porta (folha que gira na dobradiça da esquerda). Frestas = vãos entre as faixas.
	local doorClosed = local3(0, H / 2, -D / 2 + 0.06)
	local door = Build.part(model, "Door", V3(W - 0.1, H - 0.1, 0.14), doorClosed, color, metal)
	door.Transparency = 1 -- a folha "lógica" fica invisível; as faixas abaixo formam a porta visível
	door.CanCollide = true
	-- Vãos (frestas) em 4.05-4.2, 4.45-4.65 (altura do olho) e 4.9-5.05.
	local slats: { { y0: number, y1: number } } = {
		{ y0 = 0.05, y1 = 4.05 },
		{ y0 = 4.2, y1 = 4.45 },
		{ y0 = 4.65, y1 = 4.9 },
		{ y0 = 5.05, y1 = 7.3 },
	}
	for _, s in slats do
		local h = s.y1 - s.y0
		local slat = Build.part(
			model,
			"Slat",
			V3(W - 0.1, h, 0.12),
			local3(0, s.y0 + h / 2, -D / 2 + 0.06),
			color,
			{ material = Enum.Material.Metal, collide = false }
		)
		slat.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = door
		weld.Part1 = slat
		weld.Parent = door
	end
	local handle = Build.part(
		model,
		"Handle",
		V3(0.12, 0.7, 0.12),
		local3(W / 2 - 0.4, 3.6, -D / 2 - 0.05),
		Palette.Metal,
		{ collide = false }
	)
	handle.Anchored = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = door
	weld.Part1 = handle
	weld.Parent = door
	-- As frestas deixam a luz de dentro para fora... e a de fora para dentro: escuro lá dentro.
	door.CanQuery = true

	local hinge = local3(-W / 2 + 0.1, H / 2, -D / 2 + 0.06)
	local inside = CFrame.lookAt(base + V3(0, 3.1, 0) + front * 0.1, base + V3(0, 3.1, 0) + front * 5)
	-- Olho perto da porta: as frestas viram faixas largas de visão.
	local eyePosition = base + V3(0, 4.55, 0) + front * 0.85
	built.lockers[spec.id] = {
		id = spec.id,
		model = model,
		door = door,
		doorClosed = doorClosed,
		hinge = hinge,
		inside = inside,
		eye = CFrame.lookAt(eyePosition, eyePosition + front),
		exit = CFrame.lookAt(base + front * (D / 2 + 1.8) + V3(0, 3.1, 0), base + front * 10 + V3(0, 3.1, 0)),
		front = base + front * (D / 2 + 0.8),
		sound = clip(door, "Latch", "LockerLatch"),
		occupant = nil,
	}
	register(built, spec.id, "Hide", door, model, Text.Prompts.Hide, 6)
end

local function buildKey(built: Built, parent: Instance, spot: Features.Spot)
	local p = vec(spot.position)
	local model = Build.model(parent, spot.id)
	-- Quadro de chaves na parede atrás (aponta para o lado do jogador).
	local standDir = (vec(spot.stand) - V3(p.X, 0, p.Z))
	local facing = V3(standDir.X, 0, standDir.Z).Unit
	local board = Build.part(
		model,
		"KeyBoard",
		V3(1.6, 1.3, 0.08),
		CFrame.lookAt(p - facing * 0.12 + V3(0, 0.15, 0), p - facing * 0.12 + V3(0, 0.15, 0) + facing),
		Palette.WoodDark,
		{ collide = false }
	)
	board.CanQuery = false
	local frame = CFrame.lookAt(p, p + facing)
	local bow = Build.part(model, "Bow", V3(0.32, 0.32, 0.06), frame * CFrame.new(0, 0.18, 0), Palette.Brass, {
		collide = false,
		material = Enum.Material.Metal,
	})
	Build.part(model, "Blade", V3(0.08, 0.5, 0.05), frame * CFrame.new(0, -0.18, 0), Palette.Brass, {
		collide = false,
		material = Enum.Material.Metal,
	})
	Build.part(model, "Tag", V3(0.34, 0.2, 0.02), frame * CFrame.new(0.28, 0.02, 0.01), Palette.Red, {
		collide = false,
	})
	model.PrimaryPart = bow
	built.keys[spot.id] = model
	register(built, spot.id, "Key", bow, model, Text.Prompts.Key, 7)
end

local function buildBattery(built: Built, parent: Instance, spot: Features.Spot)
	local p = vec(spot.position)
	local model = Build.model(parent, spot.id)
	local pack = Build.part(model, "Pack", V3(0.7, 0.18, 0.5), CFrame.new(p), Palette.Ceramic, { collide = false })
	for _, dx in { -0.16, 0.16 } do
		Build.cylinder(
			model,
			"Cell",
			p + V3(dx, 0.17, 0),
			Vector3.xAxis,
			0.55,
			0.22,
			Palette.Hazard,
			{ collide = false, material = Enum.Material.Metal }
		)
	end
	model.PrimaryPart = pack
	built.batteries[spot.id] = model
	register(built, spot.id, "Battery", pack, model, Text.Prompts.Battery, 7)
end

local function buildBreakers(built: Built, parent: Instance)
	local spec = Features.Breakers
	local center = vec(spec.box)
	local model = Build.model(parent, "Breakers")
	-- A caixa fica na parede norte (frente para +Z, sala do gerador).
	local facing = Vector3.zAxis
	local box = Build.part(model, "Box", V3(4.6, 3.4, 0.6), CFrame.new(center), Palette.Metal, {
		material = Enum.Material.Metal,
	})
	Build.part(model, "Frame", V3(4.9, 3.7, 0.4), CFrame.new(center - facing * 0.15), Palette.MetalDark)
	local sign = Build.sign(
		model,
		"Title",
		center + V3(0, 2.35, 0.32),
		facing,
		Vector2.new(4.6, 0.7),
		"DISJUNTORES",
		{ textColor = Palette.Black, background = Palette.Hazard }
	)
	sign.CanQuery = false
	local levers: { BasePart } = {}
	local down: { CFrame } = {}
	local up: { CFrame } = {}
	local lamps: { BasePart } = {}
	for i = 1, Config.Puzzle.Breakers do
		local x = center.X + (i - 2) * spec.spacing
		local pivot = CFrame.new(x, center.Y - 0.2, center.Z + 0.45)
		local downCFrame = pivot * CFrame.Angles(math.rad(35), 0, 0) * CFrame.new(0, -0.45, 0)
		local upCFrame = pivot * CFrame.Angles(math.rad(-35), 0, 0) * CFrame.new(0, 0.45, 0)
		local lever = Build.part(model, `Lever{i}`, V3(0.36, 1.1, 0.36), downCFrame, Palette.Red, {
			collide = false,
		})
		lever.CanQuery = true
		Build.part(
			model,
			"Slot",
			V3(0.5, 1.6, 0.06),
			CFrame.new(x, center.Y - 0.2, center.Z + 0.31),
			Palette.Black,
			{ collide = false }
		)
		local letter = Build.sign(
			model,
			"Letter",
			V3(x, center.Y - 1.35, center.Z + 0.32),
			facing,
			Vector2.new(0.6, 0.5),
			string.char(64 + i),
			{ textColor = Palette.Paper, background = Palette.Black }
		)
		letter.CanQuery = false
		local lamp = Build.part(
			model,
			`Lamp{i}`,
			V3(0.4, 0.4, 0.2),
			CFrame.new(x, center.Y + 1.15, center.Z + 0.36),
			Palette.LampOff,
			{ collide = false, material = Enum.Material.SmoothPlastic }
		)
		lamp.CanQuery = false
		table.insert(levers, lever)
		table.insert(down, downCFrame)
		table.insert(up, upCFrame)
		table.insert(lamps, lamp)
		register(
			built,
			`breaker_{i}`,
			"Breaker",
			lever,
			model,
			string.format(Text.Prompts.Breaker, string.char(64 + i)),
			6
		)
	end

	-- Procedimento (prancheta com a ordem da rodada). O texto vem do servidor a cada rodada.
	local noteSpec = Features.BreakerNote
	local np = vec(noteSpec.position)
	local clipboard = Build.part(model, noteSpec.id, V3(1.5, 2, 0.08), CFrame.new(np), Palette.WoodDark)
	local paper = Build.sign(
		model,
		"Procedure",
		np + V3(0, -0.1, 0.06),
		facing,
		Vector2.new(1.3, 1.6),
		"RELIGAMENTO",
		{ textColor = Palette.Black, background = Palette.Paper, font = Enum.Font.SpecialElite, pixelsPerStud = 60 }
	)
	paper.CanQuery = false
	local gui = paper:FindFirstChildOfClass("SurfaceGui")
	local label = gui and gui:FindFirstChildOfClass("TextLabel")
	assert(label, "procedure label")
	register(built, noteSpec.id, "Note", clipboard, clipboard, Text.Prompts.Procedure, 6)

	built.breakers = {
		box = box,
		levers = levers,
		down = down,
		up = up,
		lamps = lamps,
		toggle = clip(box, "Toggle", "BreakerToggle"),
		fail = clip(box, "Fail", "BreakerFail"),
		solved = clip(box, "Solved", "Switch", 0.85),
		diagram = label,
	}
end

-- Monta um objeto que cai (peças soldadas a uma peça principal, ancorada até cair).
local function buildFallable(built: Built, parent: Instance, spec: Features.Fallable)
	local p = vec(spec.position)
	local model = Build.model(parent, spec.id)
	local parts: { BasePart } = {}
	local function add(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): BasePart
		local part = Build.part(model, name, size, cframe, color, { material = material })
		table.insert(parts, part)
		return part
	end
	local primary: BasePart
	if spec.kind == "bucket" then
		primary = Build.cylinder(model, "Bucket", p + V3(0, 0.75, 0), Vector3.yAxis, 1.5, 1.3, Palette.Metal, {
			material = Enum.Material.Metal,
		})
		table.insert(parts, primary)
		add("Mop", V3(0.15, 4.2, 0.15), CFrame.new(p + V3(0.2, 2.6, 0)) * CFrame.Angles(0, 0, 0.25), Palette.WoodDark)
	elseif spec.kind == "cans" then
		primary = add("Can", V3(0.8, 1, 0.8), CFrame.new(p + V3(0, 0.5, 0)), Palette.Red, Enum.Material.Metal)
		add("Can", V3(0.8, 1, 0.8), CFrame.new(p + V3(0.85, 0.5, 0.1)), Palette.Hazard, Enum.Material.Metal)
		add("Can", V3(0.8, 1, 0.8), CFrame.new(p + V3(0.4, 1.5, 0.05)), Palette.Metal, Enum.Material.Metal)
	elseif spec.kind == "bottles" then
		primary = add("Crate", V3(1.6, 0.7, 1.2), CFrame.new(p + V3(0, 0.35, 0)), Palette.WoodDark)
		for i = 0, 3 do
			add(
				"Bottle",
				V3(0.25, 0.9, 0.25),
				CFrame.new(p + V3(-0.5 + i * 0.33, 1.15, (i % 2) * 0.3 - 0.15)),
				Palette.Screen,
				Enum.Material.Glass
			)
		end
	elseif spec.kind == "pipes" then
		primary =
			add("Pipe", V3(0.5, 7, 0.5), CFrame.new(p + V3(0, 3.4, 0.6)) * CFrame.Angles(0.18, 0, 0), Palette.Rust)
		add("Pipe", V3(0.5, 6.4, 0.5), CFrame.new(p + V3(0.7, 3.1, 0.6)) * CFrame.Angles(0.2, 0, 0.05), Palette.Rust)
		add(
			"Pipe",
			V3(0.4, 6.8, 0.4),
			CFrame.new(p + V3(-0.6, 3.3, 0.6)) * CFrame.Angles(0.17, 0, -0.04),
			Palette.Metal
		)
	elseif spec.kind == "extinguisher" then
		Build.part(model, "Bracket", V3(0.9, 0.3, 0.3), CFrame.new(p + V3(0, 1.6, -0.15)), Palette.MetalDark)
		primary = Build.cylinder(model, "Extinguisher", p + V3(0, 0.9, 0.15), Vector3.yAxis, 1.8, 0.6, Palette.Red, {
			material = Enum.Material.Metal,
		})
		table.insert(parts, primary)
		add("Nozzle", V3(0.2, 0.35, 0.2), CFrame.new(p + V3(0, 1.95, 0.15)), Palette.Black)
	else
		primary = add("Box", V3(1.5, 1.1, 1.1), CFrame.new(p + V3(0, 0.55, 0)), Palette.Gravel)
		add("Papers", V3(1.2, 0.3, 0.9), CFrame.new(p + V3(0, 1.25, 0)), Palette.Paper)
	end
	local home: { [BasePart]: CFrame } = {}
	for _, part in parts do
		home[part] = part.CFrame
		part.CanTouch = false
		if part ~= primary then
			part.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = primary
			w.Part1 = part
			w.Parent = primary
		end
	end
	model.PrimaryPart = primary
	model:SetAttribute("Fallen", false)
	table.insert(built.fallables, {
		id = spec.id,
		kind = spec.kind :: string,
		model = model,
		primary = primary,
		home = home,
		fall = vec(spec.fall),
		fallen = false,
		sound = clip(primary, "Impact", `Fall_{spec.kind}`),
	})
end

local function buildSurfaces(parent: Instance)
	for _, rect in Features.WoodFloors do
		-- Tábuas em faixas alternadas (madeira velha), 0.06 acima do piso.
		local width = 2
		local index = 0
		local x = rect.x0
		while x < rect.x1 - 0.01 do
			local x1 = math.min(rect.x1, x + width)
			local plank = Build.box(
				parent,
				"Floorboards",
				V3(x, 0, rect.z0),
				V3(x1, 0.06, rect.z1),
				if index % 2 == 0 then Palette.Wood else Palette.WoodDark,
				{ material = Enum.Material.WoodPlanks }
			)
			plank:SetAttribute("Surface", "wood")
			index += 1
			x = x1
		end
	end
	for i, p in Features.Puddles do
		local puddle = Build.part(
			parent,
			"Puddle",
			V3(p.sx, 0.04, p.sz),
			CFrame.new(p.x, 0.08, p.z) * CFrame.Angles(0, i * 0.7, 0),
			Palette.Screen,
			{ collide = false, reflectance = 0.35 }
		)
		puddle.CanQuery = false
	end
	for _, d in Features.Drips do
		local emitter = Build.part(
			parent,
			"Drip",
			V3(0.3, 0.3, 0.3),
			CFrame.new(d.x, d.y, d.z),
			Palette.MetalDark,
			{ collide = false }
		)
		emitter.Transparency = 1
		emitter.CanQuery = false
		local sound = clip(emitter, "Drips", "Drips", nil, true)
		sound.RollOffMaxDistance = 40
		sound.Playing = true
	end
end

-- Moldura, grade arrancada e cabos do vão baixo (a abertura em si é do Layout).
local function buildCrawl(parent: Instance)
	local c = Features.Crawl
	local x, z, w, top = c.wallX, c.centerZ, c.width, c.top
	local model = Build.model(parent, "CrawlDuct")
	for _, side in { -1, 1 } do
		Build.part(model, "Jamb", V3(1.2, top, 0.25), CFrame.new(x, top / 2, z + side * (w / 2 + 0.12)), Palette.Hazard)
	end
	Build.part(model, "Lintel", V3(1.2, 0.3, w + 0.5), CFrame.new(x, top + 0.15, z), Palette.Hazard)
	-- Grade caída no chão do lado do gerador.
	local grate = Build.part(
		model,
		"Grate",
		V3(0.15, 2.6, w - 0.4),
		CFrame.new(x - 2.2, 0.35, z + 0.3) * CFrame.Angles(0, 0, math.rad(80)),
		Palette.MetalDark,
		{ collide = false, material = Enum.Material.DiamondPlate }
	)
	grate.CanQuery = false
	-- Cabos pendurados no vão.
	for i = -1, 1 do
		Build.cylinder(
			model,
			"Cable",
			V3(x, top - 0.25, z + i * 0.9),
			Vector3.xAxis,
			1.4,
			0.18,
			Palette.Black,
			{ collide = false, query = false }
		)
	end
	for _, side in { -1, 1 } do
		local s = Build.sign(
			model,
			"CrawlSign",
			V3(x + side * 0.63, top + 0.9, z),
			V3(side, 0, 0),
			Vector2.new(2.8, 0.6),
			"DUTO DE CABOS",
			{ textColor = Palette.Black, background = Palette.Hazard, thickness = 0.05 }
		)
		s.CanQuery = false
	end
end

local function buildRadio(parent: Instance): BasePart
	local p = vec(Features.Radio)
	local model = Build.model(parent, "GuardRadio")
	local body = Build.part(model, "Radio", V3(1.1, 0.7, 0.45), CFrame.new(p + V3(0, 0.35, 0)), Palette.MetalDark)
	Build.part(model, "Antenna", V3(0.06, 1.1, 0.06), CFrame.new(p + V3(0.4, 1.2, 0)), Palette.Black, {
		collide = false,
	})
	local led = Build.part(model, "Led", V3(0.1, 0.1, 0.05), CFrame.new(p + V3(-0.35, 0.55, 0.23)), Palette.Red, {
		collide = false,
		material = Enum.Material.Neon,
	})
	led:SetAttribute("Indicator", "Blink")
	CollectionService:AddTag(led, "Indicator")
	return body
end

-- Ponteiros e LEDs animados pelo cliente (a 12 Hz, em passos).
local function buildIndicators(parent: Instance)
	local model = Build.model(parent, "Indicators")
	local function gauge(center: Vector3, facing: Vector3, kind: string)
		local frame = CFrame.lookAt(center, center + facing)
		Build.cylinder(model, "GaugeFace", center, facing, 0.06, 0.9, Palette.Paper, { collide = false, query = false })
		Build.cylinder(
			model,
			"GaugeRim",
			center - facing * 0.03,
			facing,
			0.08,
			1.05,
			Palette.MetalDark,
			{ collide = false, query = false }
		)
		local needle = Build.part(
			model,
			"Needle",
			V3(0.05, 0.38, 0.03),
			frame * CFrame.new(0, 0.15, -0.05),
			Palette.Red,
			{ collide = false, query = false }
		)
		needle:SetAttribute("Indicator", kind)
		needle:SetAttribute("Pivot", frame * CFrame.new(0, 0, -0.05))
		CollectionService:AddTag(needle, "Indicator")
	end
	-- Gerador (caixa de controle) e bomba 1.
	gauge(V3(-24.5, 6.1, -39.16), -Vector3.zAxis, "GaugeGenerator")
	gauge(V3(16.56, 4.2, -10), Vector3.xAxis, "GaugePump")
	-- LEDs de status ao lado do quadro: piscam em vermelho sem energia, verde com energia.
	for i = 1, 3 do
		local led = Build.part(
			model,
			"PanelLed",
			V3(0.18, 0.18, 0.06),
			CFrame.new(-13.4, 6.4 - i * 0.35, -48.67),
			Palette.Red,
			{ collide = false, query = false, material = Enum.Material.Neon }
		)
		led:SetAttribute("Indicator", "PanelLed")
		led:SetAttribute("Index", i)
		CollectionService:AddTag(led, "Indicator")
	end
end

-- Zonas (uma por sala do Layout): o cliente escolhe reverb e "onde estou" por elas.
local function buildZones(parent: Instance)
	local folder = Build.folder(parent, "Zones")
	for _, room in Layout.Rooms do
		local zone = Build.box(
			folder,
			room.id,
			V3(room.x0, 0, room.z0),
			V3(room.x1, Layout.CEILING, room.z1),
			Palette.Black,
			{ transparency = 1, collide = false, query = false }
		)
		zone.CanTouch = false
		zone:SetAttribute("Room", room.id)
		zone:SetAttribute("Reverb", Features.Reverb[room.id] or "Room")
	end
end

function FeatureBuilder.build(parent: Instance): Built
	local root = Build.folder(parent, "Features")
	local built: Built = {
		root = root,
		interactables = {},
		keys = {},
		batteries = {},
		lockers = {},
		breakers = nil :: any,
		fallables = {},
		radio = nil :: any,
	}
	local lockers = Build.folder(root, "Lockers")
	for _, spec in Features.Lockers do
		buildLocker(built, lockers, spec)
	end
	local pickups = Build.folder(root, "Pickups")
	for _, spot in Features.KeySpots do
		buildKey(built, pickups, spot)
	end
	for _, spot in Features.BatterySpots do
		buildBattery(built, pickups, spot)
	end
	buildBreakers(built, root)
	local fallables = Build.folder(root, "Fallables")
	for _, spec in Features.Fallables do
		buildFallable(built, fallables, spec)
	end
	buildSurfaces(Build.folder(root, "Surfaces"))
	buildCrawl(root)
	built.radio = buildRadio(root)
	buildIndicators(root)
	buildZones(root)
	return built
end

return FeatureBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="488">
          <Properties>
            <string name="Name">Features</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Dados puros das novidades do polish (testados no Lune). Montados pelo FeatureBuilder depois
	do MapBuilder; não mexem em paredes nem nos dados do Layout (ver LEIA_CLAUDE.md).

	Coordenadas no chão (y = 0) salvo indicação. `front` = direção para onde a frente do objeto olha.
]]

export type Point = { x: number, y: number, z: number }

export type Spot = {
	id: string,
	-- Centro do objeto.
	position: Point,
	-- Onde o jogador fica de pé para alcançar (teste de navegação).
	stand: Point,
}

export type Locker = {
	id: string,
	-- Centro da base (no chão).
	base: Point,
	front: Point,
	stand: Point,
}

export type Fallable = {
	id: string,
	kind: "bucket" | "cans" | "bottles" | "pipes" | "extinguisher" | "box",
	-- Base do objeto (onde ele está apoiado).
	position: Point,
	-- Para onde ele tomba (direção no plano).
	fall: Point,
}

export type Rect = { x0: number, x1: number, z0: number, z1: number }

local Features = {}

-- Portas que começam trancadas (a chave abre). O Depósito também tem acesso pela ampliação do
-- mapa (Arquivo Técnico), então a chave é um atalho e a missão nunca trava.
Features.LockedDoors = { door_storage = true } :: { [string]: boolean }

-- Chave do Depósito (uma das posições por rodada).
Features.KeySpots = {
	{ id = "key_office", position = { x = -35, y = 4.6, z = -0.8 }, stand = { x = -35, y = 0, z = -3.6 } },
	{ id = "key_lobby", position = { x = -11.25, y = 4.6, z = -16.4 }, stand = { x = -8.5, y = 0, z = -16.6 } },
} :: { Spot }

-- Pilhas para a lanterna (Config.Battery.PickupsPerRound sorteadas por rodada).
Features.BatterySpots = {
	{ id = "battery_lobby", position = { x = 2.5, y = 2.1, z = -2 }, stand = { x = 0, y = 0, z = -4 } },
	{ id = "battery_office", position = { x = -38.5, y = 5.2, z = -12.6 }, stand = { x = -35.5, y = 0, z = -12.6 } },
	{ id = "battery_pump", position = { x = 33.6, y = 3.38, z = -2.4 }, stand = { x = 33.6, y = 0, z = -6.5 } },
	{
		id = "battery_generator",
		position = { x = -35.6, y = 3.38, z = -29.4 },
		stand = { x = -33, y = 0, z = -32.5 },
	},
	{ id = "battery_storage", position = { x = 17.6, y = 3.06, z = -38 }, stand = { x = 17.6, y = 0, z = -35.4 } },
} :: { Spot }

-- Armários onde dá para se esconder.
Features.Lockers = {
	{
		id = "locker_storage",
		base = { x = 37.6, y = 0, z = -27.7 },
		front = { x = 0, y = 0, z = -1 },
		stand = { x = 37.6, y = 0, z = -31.5 },
	},
	{
		id = "locker_pump",
		base = { x = 31, y = 0, z = -16.3 },
		front = { x = 0, y = 0, z = 1 },
		stand = { x = 31, y = 0, z = -12.5 },
	},
	{
		id = "locker_generator",
		base = { x = -38.3, y = 0, z = -36 },
		front = { x = 1, y = 0, z = 0 },
		stand = { x = -34.5, y = 0, z = -36 },
	},
} :: { Locker }

-- Caixa de disjuntores (A, B, C) ao lado do quadro, e o procedimento com a ordem da rodada.
Features.Breakers = {
	box = { x = -9.5, y = 4.2, z = -49.15 },
	stand = { x = -9.5, y = 0, z = -45.5 },
	spacing = 1.5,
}
Features.BreakerNote = {
	id = "note_breakers",
	position = { x = -20.6, y = 4.7, z = -49.42 },
	stand = { x = -20.6, y = 0, z = -45.5 },
}

-- Rádio do vigia (chiado nos eventos de tensão).
Features.Radio = { x = -10.2, y = 3.4, z = -3.3 } :: Point

-- Objetos que caem quando o jogador passa rápido perto (agachado/devagar não derruba).
Features.Fallables = {
	{ id = "fall_bucket", kind = "bucket", position = { x = 19.8, y = 0, z = -14.6 }, fall = { x = 1, y = 0, z = 0 } },
	{ id = "fall_cans", kind = "cans", position = { x = 3.2, y = 2, z = -36 }, fall = { x = 1, y = 0, z = 0 } },
	{
		id = "fall_bottles",
		kind = "bottles",
		position = { x = -1.6, y = 0, z = -16.6 },
		fall = { x = 0, y = 0, z = 1 },
	},
	{ id = "fall_pipes", kind = "pipes", position = { x = -12, y = 0, z = -27.1 }, fall = { x = 0, y = 0, z = -1 } },
	{
		id = "fall_extinguisher",
		kind = "extinguisher",
		position = { x = 10, y = 2.6, z = -25.25 },
		fall = { x = 0, y = 0, z = 1 },
	},
	{ id = "fall_box", kind = "box", position = { x = -23.4, y = 3, z = -6.4 }, fall = { x = 0, y = 0, z = -1 } },
} :: { Fallable }

-- Poças (passos molhados). As duas da sala de bombas já existem no mapa (nome "Puddle").
Features.Puddles = {
	{ x = -33, y = 0, z = -33, sx = 3.2, sz = 2.4 },
	{ x = 25.5, y = 0, z = -21.4, sx = 2.6, sz = 2 },
	{ x = 9, y = 0, z = -45, sx = 3, sz = 2.2 },
	{ x = 8, y = 0, z = 20, sx = 4, sz = 3 },
	{ x = -12, y = 0, z = 12, sx = 3.4, sz = 2.6 },
}

-- Goteiras (som de pingos sobre as poças).
Features.Drips = {
	{ x = 20, y = 9.5, z = -13 },
	{ x = 25.5, y = 9.6, z = -21.4 },
	{ x = -33, y = 9.6, z = -33 },
}

-- Assoalho de madeira no escritório (passos de madeira).
Features.WoodFloors = {
	{ x0 = -39.5, x1 = -12.5, z0 = -17.5, z1 = -0.5 },
} :: { Rect }

-- Vão baixo para passar agachado entre a Sala do Gerador e o Depósito (o Vigia não cabe).
-- A abertura em si está no Layout (parede generatorStorage); aqui ficam moldura e grade.
Features.Crawl = {
	wallX = -4,
	centerZ = -47.4,
	width = 3.4,
	top = 3,
	standGenerator = { x = -7, y = 0, z = -47.4 } :: Point,
	standStorage = { x = -1, y = 0, z = -47.4 } :: Point,
}

-- Reverb por sala (Layout.Rooms); "Outside" para o resto.
Features.Reverb = {
	Lobby = "StoneRoom",
	Office = "Room",
	Pump = "Hangar",
	Corridor = "StoneCorridor",
	Generator = "Hangar",
	Storage = "Auditorium",
	Maintenance = "StoneRoom",
	CableGallery = "SewerPipe",
	Control = "Room",
	Archive = "CarpettedHallway",
	Switchyard = "Plain",
	Outside = "Plain",
} :: { [string]: string }

-- Checkpoint: onde o jogador volta (perto do quadro, de frente para a porta do gerador).
Features.CheckpointSpawn = {
	position = { x = -16, y = 3.2, z = -44 } :: Point,
	lookAt = { x = -21, y = 3.2, z = -26 } :: Point,
}

-- Sorteia `count` itens distintos de `list` (`nextInteger(a, b)` injetado).
function Features.pick<T>(list: { T }, count: number, nextInteger: (number, number) -> number): { T }
	local pool = table.clone(list)
	local result = {}
	for _ = 1, math.min(count, #pool) do
		local index = nextInteger(1, #pool)
		table.insert(result, pool[index])
		table.remove(pool, index)
	end
	return result
end

return Features
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="489">
          <Properties>
            <string name="Name">ForestBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Construção por capítulo: horizonte cenográfico amplo, trilhas livres e abrigos autoritativos.
local CollectionService = game:GetService("CollectionService")
local Forest = require("@game/ReplicatedStorage/Shared/Game/ForestCatalog")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local Build = require("./Build")
local FeatureBuilder = require("./FeatureBuilder")
local Layout = require("./ForestLayout")
local Threat = require("@game/ReplicatedStorage/Shared/Game/ForestThreat")
local Builder = {}
local wood = Color3.fromRGB(67, 54, 39)
local leaf = Color3.fromRGB(28, 53, 39)
local function block(
	parent: Instance,
	name: string,
	p: Vector3,
	size: Vector3,
	color: Color3,
	options: Build.PartOptions?
): BasePart
	local defaults = {
		material = if name == "Canvas" or name == "Bedroll"
			then Enum.Material.Fabric
			elseif name == "Roof" or name == "RadioShelterRoof" then Enum.Material.Slate
			elseif name == "TowerRing" then Enum.Material.Metal
			else Enum.Material.Wood,
	}
	return Build.block(parent, name, p, size, 0, color, options or defaults)
end
function Builder.clear(parent: Instance, features: FeatureBuilder.Built)
	for id in features.lockers do
		if string.sub(id, 1, 12) == "hide_Forest_" then
			features.lockers[id], features.interactables[id] = nil, nil
		end
	end
	local old = parent:FindFirstChild("Forest")
	if old then
		old:Destroy()
	end
end
function Builder.build(parent: Instance, chapter: number, seed: number, features: FeatureBuilder.Built): Folder
	Builder.clear(parent, features)
	local root = Build.folder(parent, "Forest")
	root:SetAttribute("Chapter", chapter)
	root:SetAttribute("HorrorForest", true)
	local rng = Random.new(seed + chapter * 104729)
	block(
		root,
		"ForestGround",
		Vector3.new(0, -2, 720),
		Vector3.new(2400, 2, 2400),
		Color3.fromRGB(38, 48, 34),
		{ material = Enum.Material.Grass }
	)
	-- A espinha central e ramais são largos para dois jogadores e para o pathfinding da criatura.
	block(
		root,
		"MainTrail",
		Vector3.new(0, 0.01, 720),
		Vector3.new(22, 0.08, 350),
		Color3.fromRGB(86, 73, 53),
		{ material = Enum.Material.Ground, collide = false }
	)
	local clearings = Layout.clearings(seed)
	local drawn: { [string]: boolean } = {}
	for _, r in clearings do
		if r.z1 - r.z0 > 35 then
			continue
		end
		local key = `{r.x0}/{r.x1}/{r.z0}/{r.z1}`
		if drawn[key] then
			continue
		end
		drawn[key] = true
		block(
			root,
			"BranchTrail",
			Vector3.new((r.x0 + r.x1) / 2, 0.07, (r.z0 + r.z1) / 2),
			Vector3.new(r.x1 - r.x0, 0.08, r.z1 - r.z0),
			Color3.fromRGB(78, 69, 51),
			{ material = Enum.Material.Ground, collide = false }
		)
	end
	local function tree(container: Instance, x: number, z: number, distant: boolean)
		local height = rng:NextNumber(29, 51)
		local trunk = block(
			container,
			"Trunk",
			Vector3.new(x, 0, z),
			Vector3.new(3, height, 3),
			wood,
			{ material = Enum.Material.Wood, collide = not distant, query = not distant }
		)
		trunk:SetAttribute("ForestTree", true)
		trunk:SetAttribute("NearTrail", not distant)
		for level = 1, 2 do
			local crown = block(
				container,
				"Canopy",
				Vector3.new(x, height - 7 + level * 4, z),
				Vector3.new(27 - level * 4, 13, 27 - level * 4),
				leaf,
				{ material = Enum.Material.Grass, collide = false, query = false }
			)
			crown.CFrame *= CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
			crown.CastShadow = true
		end
	end
	-- Subárvores pequenas são publicadas por lote; geração cede a thread para o Studio.
	for batch = 1, 8 do
		local grove = Instance.new("Folder")
		grove.Name = `Grove{batch}`
		if batch <= 4 then
			for row = 0, 7 do
				local z = 548 + ((batch - 1) * 8 + row) * 11
				for column = 0, 24 do
					local x = -132 + column * 11 + rng:NextNumber(-1.2, 1.2)
					local atZ = z + rng:NextNumber(-1.2, 1.2)
					if not Layout.reserved(x, atZ, clearings) then
						tree(grove, x, atZ, false)
					end
				end
			end
		else
			for _ = 1, 85 do
				local x = rng:NextNumber(-850, 850)
				local z = rng:NextNumber(300, 1250)
				if math.abs(x) > 164 or z < 520 or z > 930 then
					tree(grove, x, z, true)
				end
			end
		end
		grove.Parent = root
		task.wait()
	end
	-- Limites físicos com massas rochosas visíveis além deles, sem queda no vazio.
	for _, x in { -145, 145 } do
		block(root, "TreeLineBoundary", Vector3.new(x, 0, 720), Vector3.new(2, 70, 380), leaf, { transparency = 1 })
		for z = 550, 910, 24 do
			block(
				root,
				"RockRidge",
				Vector3.new(x + (if x < 0 then -9 else 9), 0, z),
				Vector3.new(19, rng:NextNumber(12, 25), 28),
				Color3.fromRGB(48, 55, 50),
				{ material = Enum.Material.Slate }
			)
		end
	end
	for _, z in { 535, 915 } do
		block(root, "TrailBoundary", Vector3.new(0, 0, z), Vector3.new(290, 70, 2), leaf, { transparency = 1 })
	end
	for z = 600, 840, 60 do
		local lamp = block(root, "TrailLantern", Vector3.new(12, 0, z), Vector3.new(0.7, 4, 0.7), wood)
		Build.light(lamp, "ForestGuide", Color3.fromRGB(192, 155, 100), 12, 0.3, true)
		-- Lanterna física e sua proteção: apenas visual, luz de orientação continua em todos os perfis.
		for _, side in { -1, 1 } do
			local cap = block(
				root,
				"LanternCap",
				Vector3.new(12, 3.3 + side * 0.55, z),
				Vector3.new(1.5, 0.18, 1.5),
				wood,
				{ material = Enum.Material.Metal, collide = false, query = false }
			)
			cap:SetAttribute("VisualDetail", true)
		end
		block(
			root,
			"LanternGlass",
			Vector3.new(12, 3, z),
			Vector3.new(0.9, 0.7, 0.9),
			Color3.fromRGB(223, 177, 103),
			{ material = Enum.Material.Glass, transparency = 0.22, collide = false, query = false }
		)
	end
	-- Marcas físicas continuam legíveis quando as lanternas do mundo apagam.
	for _, z in { 624, 682, 742, 812, 848 } do
		Build.sign(
			root,
			"RangerMark",
			Vector3.new(-11, 3.4, z),
			-Vector3.zAxis,
			Vector2.new(2.3, 1.1),
			if z == 848 then "ESTRADA ↑" else "TRILHA ↑",
			{ textColor = Color3.fromRGB(174, 159, 105), lit = true }
		)
	end
	local props = Build.folder(root, "RangerRemains")
	for _, z in { 608, 694, 774, 828 } do
		local stump = block(
			props,
			"SplitStump",
			Vector3.new(-15, 0, z),
			Vector3.new(4, 3, 4),
			wood,
			{ material = Enum.Material.Wood, collide = false, query = false }
		)
		stump.CFrame *= CFrame.Angles(0, math.rad(23), 0)
		block(
			props,
			"BrokenBark",
			Vector3.new(-16, 3, z),
			Vector3.new(1, 2, 0.5),
			wood,
			{ material = Enum.Material.Wood, collide = false, query = false }
		)
	end
	Build.sign(
		props,
		"Warning",
		Vector3.new(20, 5, 596),
		-Vector3.zAxis,
		Vector2.new(11, 3),
		"SE A MATA FICAR EM SILÊNCIO\nAPAGUE A LUZ. NÃO CORRA ATÉ O ABRIGO.",
		{ textColor = Color3.fromRGB(203, 188, 135), lit = true }
	)
	block(props, "CampTable", Vector3.new(-82, 0, 731), Vector3.new(11, 2.4, 5), wood)
	for i = 1, 4 do
		block(
			props,
			"EmptyPlate",
			Vector3.new(-87 + i * 2, 2.4, 731),
			Vector3.new(1.3, 0.1, 1.3),
			Color3.fromRGB(134, 137, 118),
			{ material = Enum.Material.Metal, collide = false, query = false }
		)
	end
	Build.sign(
		props,
		"RangerWarning",
		Vector3.new(-77, 5, 740),
		Vector3.zAxis,
		Vector2.new(12, 3),
		"POSTO 09 / ÚLTIMA EQUIPE: 6\nRECEBIDOS NA ESTRADA: 0",
		{ textColor = Color3.fromRGB(188, 171, 120) }
	)
	Build.sign(
		root,
		"ChapterBoard",
		Vector3.new(-22, 6, 610),
		-Vector3.zAxis,
		Vector2.new(14, 3),
		Forest.Chapters[chapter - 5].title,
		{ textColor = Color3.fromRGB(226, 193, 130), lit = true }
	)
	for index, spot in Forest.Hides do
		local id = `hide_Forest_{index}`
		local p = Vector3.new(spot.x, 0, spot.z)
		local model = Build.model(root, id)
		for _, dx in { -2.5, 2.5 } do
			block(
				model,
				"Side",
				p + Vector3.new(dx, 0, 0),
				Vector3.new(0.5, 9, 5),
				wood,
				{ material = Enum.Material.Wood }
			)
		end
		block(model, "Back", p + Vector3.new(0, 0, -2.5), Vector3.new(5, 9, 0.5), wood)
		block(model, "Roof", p + Vector3.new(0, 9, 0), Vector3.new(6, 0.5, 6), wood)
		local door = block(model, "HideDoor", p + Vector3.new(0, 0, 2.5), Vector3.new(5, 9, 0.3), wood)
		door:SetAttribute(Tags.Attr.InteractId, id)
		door:SetAttribute(Tags.Attr.InteractPrompt, "ESCONDER NO ABRIGO")
		door:SetAttribute(Tags.Attr.InteractEnabled, true)
		door:SetAttribute(Tags.Attr.InteractDistance, 8)
		CollectionService:AddTag(door, Tags.Interactable)
		local front = p + Vector3.new(0, 0, 6)
		features.lockers[id] = {
			id = id,
			model = model,
			door = door,
			doorClosed = door.CFrame,
			hinge = CFrame.new(p),
			inside = CFrame.new(p + Vector3.new(0, 3, 0)),
			eye = CFrame.lookAt(p + Vector3.new(0, 5.5, 2.7), p + Vector3.new(0, 5.5, 10)),
			exit = CFrame.new(front + Vector3.new(0, 3, 0)),
			front = front,
			sound = Build.sound(door, "Creak", Audio.DoorBang.id, 0.35),
			occupant = nil,
		}
		features.interactables[id] =
			{ id = id, kind = "Hide", focus = door, model = model, maxDistance = 8, enabled = true }
	end
	if chapter == 6 then
		for _, x in { -80, 80 } do
			local log = block(
				root,
				"FallenTree",
				Vector3.new(x, 0, 700),
				Vector3.new(8, 8, 36),
				wood,
				{ material = Enum.Material.Wood }
			)
			log.CFrame *= CFrame.Angles(0, math.rad(35), 0)
		end
	else
		for _, z in { 660, 800 } do
			local tent = Build.model(root, "AbandonedTent")
			for _, side in { -1, 1 } do
				local panel = block(
					tent,
					"Canvas",
					Vector3.new(-80 + side * 4, 0, z),
					Vector3.new(0.5, 13, 20),
					Color3.fromRGB(95, 94, 62)
				)
				panel.CFrame *= CFrame.Angles(0, 0, math.rad(side * 32))
			end
			block(tent, "Bedroll", Vector3.new(-80, 0, z), Vector3.new(5, 0.7, 10), wood)
		end
		for _, x in { 65, 95 } do
			block(root, "RadioShelterPost", Vector3.new(x, 0, 760), Vector3.new(2, 18, 2), wood)
		end
		block(root, "RadioShelterRoof", Vector3.new(80, 18, 760), Vector3.new(36, 1, 30), wood)
	end
	if chapter == 8 then
		for _, dx in { -8, 8 } do
			for _, dz in { -8, 8 } do
				block(
					root,
					"TowerLeg",
					Vector3.new(82 + dx, 0, 700 + dz),
					Vector3.new(2, 70, 2),
					Color3.fromRGB(84, 91, 85),
					{ material = Enum.Material.Metal }
				)
			end
		end
		for y = 12, 66, 12 do
			block(root, "TowerRing", Vector3.new(82, y, 700), Vector3.new(20, 1, 20), wood)
		end
		local beacon = block(
			root,
			"TowerBeacon",
			Vector3.new(82, 72, 700),
			Vector3.new(3, 3, 3),
			Color3.fromRGB(240, 68, 47),
			{ material = Enum.Material.Neon }
		)
		Build.light(beacon, "Exit", Color3.fromRGB(255, 100, 60), 45, 1, true)
		block(
			root,
			"RescueRoad",
			Vector3.new(0, 0.1, 876),
			Vector3.new(270, 0.2, 24),
			Color3.fromRGB(57, 59, 55),
			{ material = Enum.Material.Asphalt }
		)
		local van = Build.model(root, "RescueVan")
		block(van, "Body", Vector3.new(0, 2, 886), Vector3.new(12, 8, 17), Color3.fromRGB(179, 184, 159))
		block(van, "Windshield", Vector3.new(0, 7, 877.3), Vector3.new(10, 3, 0.3), Color3.fromRGB(35, 50, 51))
		for _, x in { -6, 6 } do
			for _, z in { 880, 891 } do
				Build.cylinder(van, "Wheel", Vector3.new(x, 2, z), Vector3.xAxis, 1.5, 4, Color3.fromRGB(20, 23, 20))
			end
		end
		local safe = block(
			root,
			"RescueBeacon",
			Vector3.new(0, 0, 870),
			Vector3.new(2, 9, 2),
			Color3.fromRGB(102, 222, 148),
			{ material = Enum.Material.Neon, collide = false }
		)
		Build.light(safe, "Exit", Color3.fromRGB(130, 255, 181), 45, 1.6, true)
		Build.sign(
			root,
			"RescueSign",
			Vector3.new(0, 12, 870),
			-Vector3.zAxis,
			Vector2.new(20, 3),
			"RESGATE / REÚNAM-SE AQUI",
			{ textColor = Color3.fromRGB(152, 255, 193), lit = true }
		)
	end
	return root
end
function Builder.pressure(parent: Instance, now: number, chapter: number, playing: boolean)
	local forest = parent:FindFirstChild("Forest")
	if not forest then
		return
	end
	local forced = tonumber(forest:GetAttribute("ForcedBlackoutUntil")) or 0
	local dark = playing and (Threat.dark(now, chapter) or now < forced)
	if forest:GetAttribute("Blackout") == dark then
		return
	end
	forest:SetAttribute("Blackout", dark)
	parent:SetAttribute("ForestBlackout", dark)
	for _, part in forest:GetChildren() do
		if part:GetAttribute(Tags.Attr.LightKind) == "ForestGuide" then
			local light = part:FindFirstChildWhichIsA("PointLight")
			if light then
				light.Enabled = not dark
			end
		end
	end
end
return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="490">
          <Properties>
            <string name="Name">ForestLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Rotas mínimas, comuns ao gerador e ao QA; a mata pode ocupar todo o espaço restante.
local Forest = require("@game/ReplicatedStorage/Shared/Game/ForestCatalog")
local Plan = require("../Campaign/ForestPlan")
local Layout = {}
export type Rect = { x0: number, x1: number, z0: number, z1: number }
function Layout.clearings(seed: number): { Rect }
	local out: { Rect } = {
		{ x0 = -12, x1 = 12, z0 = 540, z1 = 918 },
		{ x0 = -143, x1 = 143, z0 = 858, z1 = 908 },
		{ x0 = -32, x1 = 30, z0 = 590, z1 = 614 },
	}
	for chapter = 6, 8 do
		for _, mode in { "Story", "Standard" } do
			for _, spec in Plan.create(seed, chapter, 6, mode).activities do
				if spec.kind ~= "hide" and spec.kind ~= "breath" then
					table.insert(out, {
						x0 = math.min(0, spec.x) - 8,
						x1 = math.max(0, spec.x) + 8,
						z0 = spec.z - 3,
						z1 = spec.z + 13,
					})
				end
			end
		end
	end
	for _, p in Forest.Hides do
		table.insert(out, {
			x0 = math.min(0, p.x) - 8,
			x1 = math.max(0, p.x) + 8,
			z0 = p.z - 5,
			z1 = p.z + 14,
		})
	end
	-- Barracas, posto e torre existem fora das estações e não podem conter troncos.
	table.insert(out, { x0 = -95, x1 = -65, z0 = 644, z1 = 818 })
	table.insert(out, { x0 = 63, x1 = 102, z0 = 684, z1 = 784 })
	return out
end
function Layout.reserved(x: number, z: number, clearings: { Rect }): boolean
	for _, r in clearings do
		if x >= r.x0 and x <= r.x1 and z >= r.z0 and z <= r.z1 then
			return true
		end
	end
	return false
end
return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="491">
          <Properties>
            <string name="Name">HouseAccess</string>
            <string name="Source"><![CDATA[--!strict
-- Barreira física acompanha a missão: a regra do servidor e a geometria usam os mesmos eventos.
local Build = require("./Build")
local Envelope = require("@game/ReplicatedStorage/Shared/Game/HouseEnvelope")
local Access = {}
local V3 = Vector3.new
local wood = Color3.fromRGB(86, 65, 54)
function Access.build(root: Instance)
	local old = root:FindFirstChild("ProgressionBarriers")
	if old then
		old:Destroy()
	end
	local folder = Build.folder(root, "ProgressionBarriers")
	-- A base antiga deixava frestas de 2–4 studs junto às fachadas e um recorte inteiro
	-- ao lado do vestíbulo. Solo espesso elimina também a visão lateral para o vazio.
	for _, rect in Envelope.Ground do
		Build.box(
			folder,
			"EstateSoil",
			V3(rect.x0, -18, rect.z0),
			V3(rect.x1, -0.08, rect.z1),
			Color3.fromRGB(36, 48, 34),
			{ material = Enum.Material.Grass }
		)
	end
	local function barrier(name: string, base: Vector3, size: Vector3)
		local part = Build.block(folder, name, base, size, 0, wood, { material = Enum.Material.WoodPlanks })
		part:SetAttribute("MissionBarrier", name)
		return part
	end
	barrier("corridor", V3(0, 0, -52), V3(88, 16, 0.7))
	barrier("ritual", V3(0, -16, -52), V3(88, 16, 0.7))
	-- Tampa sólida do vão: não é possível cair no porão antes de obter a passagem.
	barrier("basement", V3(-16, -0.5, 38), V3(12, 0.5, 32))
	-- Escadas bloqueadas recebem um volume sólido. Pular nas laterais não contorna a missão.
	barrier("upstairs", V3(16, 0, 38), V3(11, 16, 34))
	barrier("upstairs", V3(32, 16, 38), V3(11, 16, 34))
	-- Perímetro completo e cerca do portão: o único acesso à saída é a abertura real.
	for _, side in { -1, 1 } do
		barrier("Boundary", V3(side * 108, -1, 7), V3(1, 10, 250))
		barrier("Boundary", V3(side * 58.5, 0, 98), V3(99, 10, 1))
		local limit = barrier("BoundaryCap", V3(side * 108, 9, 7), V3(1, 16, 250))
		limit.Transparency, limit.CanQuery = 1, false
	end
	barrier("Boundary", V3(0, -1, -118), V3(216, 10, 1))
	barrier("Boundary", V3(0, -1, 132), V3(216, 10, 1))
	for _, z in { -118, 132 } do
		local limit = barrier("BoundaryCap", V3(0, 9, z), V3(216, 16, 1))
		limit.Transparency, limit.CanQuery = 1, false
	end
	Build.block(
		folder,
		"FrontCourtGround",
		V3(0, -1, 81),
		V3(216, 1, 34),
		0,
		Color3.fromRGB(42, 55, 43),
		{ material = Enum.Material.Grass }
	)
	Build.block(
		folder,
		"ExitGround",
		V3(0, -1, 115),
		V3(216, 1, 34),
		0,
		Color3.fromRGB(42, 55, 43),
		{ material = Enum.Material.Grass }
	)
end
function Access.refresh(root: Instance)
	local barriers, gates = root:FindFirstChild("ProgressionBarriers"), root:FindFirstChild("MissionGates")
	if not barriers or not gates then
		return
	end
	for _, part in barriers:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		local gate = gates:FindFirstChild(part.Name)
		if gate and gate:IsA("BasePart") then
			local open = not gate.CanCollide
			part.CanCollide, part.CanQuery, part.Transparency = not open, not open, if open then 1 else 0
		end
	end
end
return Access
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="492">
          <Properties>
            <string name="Name">HouseArchitecture</string>
            <string name="Source"><![CDATA[--!strict
-- Fechamentos e acabamentos; colisão fica na estrutura, detalhes nunca bloqueiam o caminho.
local Layout = require("@game/ReplicatedStorage/Shared/Game/HouseLayout")
local Build = require("./Build")
local Architecture = {}
local V3 = Vector3.new
local wood = Color3.fromRGB(78, 57, 43)
local trim = Color3.fromRGB(156, 131, 94)
local plaster = Color3.fromRGB(125, 119, 110)
local decor = { collide = false, query = false, material = Enum.Material.Wood }

local function piece(parent: Instance, name: string, base: Vector3, size: Vector3, color: Color3, solid: boolean?)
	local part = Build.block(parent, name, base, size, 0, color, if solid then nil else decor)
	if name == "CorridorPendant" or name == "StairPendant" or name == "LandingSconce" then
		part.Material = Enum.Material.Metal
		local glass = Build.cylinder(
			parent,
			"FixtureGlass",
			part.Position - V3(0, 0.22, 0),
			Vector3.yAxis,
			0.16,
			math.max(size.X, size.Z) * 0.75,
			Color3.fromRGB(217, 177, 117),
			{ material = Enum.Material.Neon, collide = false, query = false }
		)
		glass:SetAttribute("VisualDetail", true)
	end
	return part
end
local function plaque(parent: Instance, position: Vector3, facing: Vector3, text: string)
	Build.sign(parent, "Wayfinding", position, facing, Vector2.new(9, 1.5), text, {
		textColor = Color3.fromRGB(224, 205, 158),
		background = wood,
		font = Enum.Font.SpecialElite,
	})
end
function Architecture.build(structure: Instance, dressing: Instance)
	for _, y in Layout.Floors do
		for _, rect in Layout.decks(y) do
			local slab = Build.box(
				structure,
				"StairDeck",
				V3(rect.x0, y - 1, rect.z0),
				V3(rect.x1, y, rect.z1),
				wood,
				{ material = if y < 0 then Enum.Material.Slate else Enum.Material.WoodPlanks }
			)
			slab:SetAttribute("FloorLevel", y)
		end
		local hole = Layout.opening(y)
		if hole then
			-- Guarda-corpo de verdade ao lado do vão; bocas da escada ficam livres.
			for _, x in { hole.x0, hole.x1 } do
				piece(structure, "LandingGuard", V3(x, y, 38), V3(0.35, 3.5, 32), wood, true)
				piece(dressing, "Handrail", V3(x, y + 3.5, 38), V3(0.6, 0.25, 32), trim)
			end
		end
		for _, x in { -23.4, 44.4 } do
			piece(dressing, "Skirting", V3(x, y, 38), V3(0.18, 1, 51), wood)
			piece(dressing, "Cornice", V3(x, y + 14.8, 38), V3(0.35, 0.4, 51), trim)
		end
		local names = if y < 0
			then "PORÃO / RITUAL"
			elseif y == 0 then "TÉRREO / BIBLIOTECA"
			elseif y == 16 then "QUARTOS / ESCRITÓRIO"
			else "SÓTÃO / MEMÓRIAS"
		plaque(dressing, V3(0, y + 8.5, 62.9), -Vector3.zAxis, names)
		plaque(dressing, V3(0, y + 8.5, 13.1), Vector3.zAxis, "CORREDOR CENTRAL")
		for _, z in { 16, 59 } do
			local lamp = piece(dressing, "LandingSconce", V3(-22.8, y + 7, z), V3(0.5, 1.4, 0.8), trim)
			Build.light(lamp, "Street", Color3.fromRGB(255, 213, 160), 26, 0.55, true)
		end
		-- Rodapé, lambri e friso seguem as aberturas reais, sem atravessar portas.
		for _, side in { -1, 1 } do
			for row = 1, 3 do
				local z = 28 - row * 32
				for _, dz in { -10.5, 10.5 } do
					piece(dressing, "Wainscot", V3(side * 7.42, y, z + dz), V3(0.16, 3.5, 10.8), wood)
					piece(dressing, "ChairRail", V3(side * 7.3, y + 3.5, z + dz), V3(0.25, 0.18, 10.8), trim)
					-- Painéis baixos afastados da parede; não interceptam portas, colisões ou raycasts.
					for _, inset in { -3.6, 0, 3.6 } do
						local panel = piece(
							dressing,
							"WainscotPanel",
							V3(side * 7.26, y + 0.4, z + dz + inset),
							V3(0.12, 2.6, 3.1),
							wood:Lerp(trim, 0.12)
						)
						panel:SetAttribute("VisualDetail", true)
					end
				end
				for _, dz in { -5.15, 5.15 } do
					piece(dressing, "DoorCasing", V3(side * 7.35, y, z + dz), V3(0.3, 11.6, 0.3), trim)
				end
				piece(dressing, "DoorCasing", V3(side * 7.35, y + 11.5, z), V3(0.3, 0.3, 10.6), trim)
			end
		end
		for _, z in { -9, -41, -73 } do
			piece(dressing, "CeilingBeam", V3(0, y + 14.5, z), V3(16, 0.4, 0.6), wood)
			local lamp = piece(dressing, "CorridorPendant", V3(0, y + 12.6, z), V3(1.4, 0.35, 1.4), trim)
			Build.light(lamp, "Street", Color3.fromRGB(245, 211, 170), 24, 0.5, true)
		end
	end
	-- O subsolo também tem paredes externas: terreno não substitui fundação.
	for _, x in { -24, 45 } do
		Build.block(
			structure,
			"StairFacade",
			V3(x, -16, 38),
			V3(1, 63, 52),
			0,
			plaster,
			{ material = Enum.Material.Plaster }
		)
	end
	Build.block(
		structure,
		"FoundationFacade",
		V3(10.5, -16, 64),
		V3(70, 16, 1),
		0,
		plaster,
		{ material = Enum.Material.Brick }
	)
	Build.block(
		structure,
		"BasementFrontFacade",
		V3(-34, -16, 12),
		V3(20, 16, 1),
		0,
		plaster,
		{ material = Enum.Material.Brick }
	)
	Build.block(
		structure,
		"CorridorRoof",
		V3(0, 47, -36),
		V3(16, 1, 98),
		0,
		plaster,
		{ material = Enum.Material.Plaster }
	)
	-- Espelhos baixos: a malha visual acompanha a rampa contínua de colisão.
	for _, stair in Layout.Stairs do
		local lamp =
			piece(dressing, "StairPendant", V3(stair.x, (stair.y0 + stair.y1) / 2 + 7, 38), V3(1.4, 0.4, 1.4), trim)
		Build.light(lamp, "Street", Color3.fromRGB(246, 212, 165), 24, 0.75, true)
		for step = 0, 31 do
			local t = (step + 0.5) / 32
			local z = stair.z0 + (stair.z1 - stair.z0) * t
			local y = stair.y0 + (stair.y1 - stair.y0) * t
			piece(dressing, "StairTread", V3(stair.x, y + 0.08, z), V3(9.8, 0.08, 0.85), wood)
			for _, side in { -1, 1 } do
				if step % 4 == 0 then
					piece(dressing, "StairBaluster", V3(stair.x + side * 5.1, y, z), V3(0.18, 3.1, 0.18), trim)
				end
			end
		end
	end
end
return Architecture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="493">
          <Properties>
            <string name="Name">HouseBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Mansão autoral de quatro níveis: corredores contínuos, quartos e escadaria em retornos.
local CollectionService = game:GetService("CollectionService")
local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local Build = require("./Build")
local MapBuilder = require("./MapBuilder")
local FeatureBuilder = require("./FeatureBuilder")
local Architecture = require("./HouseArchitecture")
local Layout = require("@game/ReplicatedStorage/Shared/Game/HouseLayout")
local Television = require("./HouseTelevision")
local Access = require("./HouseAccess")
local Builder = {}
local wood = Color3.fromRGB(75, 48, 32)
local plaster = Color3.fromRGB(104, 94, 76)
local dark = Color3.fromRGB(30, 25, 24)
local gold = Color3.fromRGB(203, 163, 79)
local function block(
	parent: Instance,
	name: string,
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	color: Color3
): BasePart
	local masonry = name == "Facade"
		or name == "DoorWall"
		or name == "DoorLintel"
		or name == "RoomPartition"
		or name == "RoomCeiling"
		or name == "RearWall"
		or name == "EntrySide"
		or name == "EntryLintel"
	local ground = name == "ForestGround" or name == "Garden" or name == "SideGarden" or name == "BackGarden"
	return Build.block(parent, name, Vector3.new(x, y, z), Vector3.new(sx, sy, sz), 0, color, {
		material = if masonry
			then Enum.Material.Plaster
			elseif ground then Enum.Material.Ground
			elseif name == "PowerPanel" or name == "PowerLamp" then Enum.Material.Metal
			else Enum.Material.WoodPlanks,
	})
end
local function sound(parent: Instance, name: string): Sound
	return Build.sound(parent, name, Audio.Door.id, 0.4)
end
local function sign(parent: Instance, text: string, position: Vector3, facing: Vector3?)
	Build.sign(
		parent,
		"Plaque",
		position,
		facing or Vector3.zAxis,
		Vector2.new(8, 1.2),
		text,
		{ textColor = gold, background = dark, lit = true, font = Enum.Font.SpecialElite }
	)
end
local function tag(part: BasePart, id: string, prompt: string)
	part:SetAttribute(Tags.Attr.InteractId, id)
	part:SetAttribute(Tags.Attr.InteractPrompt, prompt)
	part:SetAttribute(Tags.Attr.InteractDistance, 8)
	part:SetAttribute(Tags.Attr.InteractEnabled, true)
	CollectionService:AddTag(part, Tags.Interactable)
end
local function ramp(parent: Instance, name: string, x: number, fromZ: number, toZ: number, fromY: number, toY: number)
	local from, to = Vector3.new(x, fromY, fromZ), Vector3.new(x, toY, toZ)
	local direction = to - from
	local part = Build.part(
		parent,
		name,
		Vector3.new(10, 1, direction.Magnitude + 2),
		CFrame.lookAt((from + to) / 2 - Vector3.yAxis * 0.5, to - Vector3.yAxis * 0.5),
		wood,
		{ material = Enum.Material.WoodPlanks }
	)
	part:SetAttribute("StairRoute", name)
	-- Corrimões ficam fora do corredor do agente.
	for _, side in { -1, 1 } do
		-- Os balaústres são visuais; a proteção contínua impede cair entre eles ao agachar.
		Build.part(
			parent,
			"StairGuard",
			Vector3.new(0.25, 3.4, direction.Magnitude),
			part.CFrame * CFrame.new(side * 5.1, 1.6, 0),
			dark,
			{ transparency = 1, query = false }
		)
		Build.part(
			parent,
			"Railing",
			Vector3.new(0.3, 0.3, direction.Magnitude),
			part.CFrame * CFrame.new(side * 5.1, 3.2, 0),
			dark
		)
	end
end
function Builder.build(parent: Instance): (MapBuilder.World, FeatureBuilder.Built)
	local old = parent:FindFirstChild(Tags.WorldFolder)
	if old then
		old:Destroy()
	end
	local root = Build.folder(parent, Tags.WorldFolder)
	local structure = Build.folder(root, "Architecture")
	local props = Build.folder(root, "Furnishings")
	local doors = Build.folder(root, "Doors")
	local gates = Build.folder(root, "MissionGates")
	local featureRoot = Build.folder(root, "Features")
	Build.folder(featureRoot, "Pickups")
	block(structure, "ForestGround", 0, -18, 5, 230, 1, 230, Color3.fromRGB(28, 38, 29))
	-- O jardim fica no nível zero; o porão ocupa somente a projeção da casa.
	block(structure, "Garden", 0, -1, 96, 140, 1, 64, Color3.fromRGB(31, 43, 32))
	for _, x in { -76, 76 } do
		block(structure, "SideGarden", x, -1, -14, 60, 1, 190, dark)
	end
	block(structure, "BackGarden", 0, -1, -102, 140, 1, 34, dark)
	for _, y in { -16, 0, 16, 32 } do
		block(structure, "CorridorFloor", 0, y - 1, -36, 16, 1, 98, wood)
		for _, side in { -1, 1 } do
			block(structure, "Facade", side * 44, y, -36, 1, 16, 98, plaster)
			for row = 1, 3 do
				local z = 28 - row * 32
				block(structure, "RoomFloor", side * 26, y - 1, z, 36, 1, 32, wood)
				-- Abertura de dez studs; lintel em 11,5 deixa o agente alto passar.
				for _, offset in { -10.5, 10.5 } do
					block(structure, "DoorWall", side * 8, y, z + offset, 1, 16, 11, plaster)
				end
				block(structure, "DoorLintel", side * 8, y + 11.5, z, 1, 4.5, 10, plaster)
				block(structure, "RoomPartition", side * 26, y, z - 16, 36, 16, 1, plaster)
				-- Tetos dos quartos; o corredor/escadaria não recebe piso que corte as rampas.
				block(structure, "RoomCeiling", side * 26, y + 15, z, 36, 0.5, 32, plaster)
			end
		end
		block(structure, "RearWall", 0, y, -85, 89, 16, 1, plaster)
	end
	for _, stair in Layout.Stairs do
		ramp(structure, stair.name, stair.x, stair.z0, stair.z1, stair.y0, stair.y1)
	end
	Architecture.build(structure, props)
	Television.build(props)
	block(structure, "StairRoof", 10.5, 47, 38, 70, 1, 53, dark)
	block(structure, "HouseRoof", 0, 48, -36, 94, 1, 106, dark)
	for _, side in { -1, 1 } do
		for _, y in { 0, 16, 32 } do
			local x = side * 26
			block(structure, "FacadeSill", x, y, 12, 36, 5, 1, plaster)
			block(structure, "FacadeTop", x, y + 11, 12, 36, 4, 1, plaster)
			for _, offset in { -12.5, 12.5 } do
				block(structure, "WindowSide", x + offset, y + 5, 12, 11, 6, 1, plaster)
			end
			local window = block(structure, "WindowGlass", x, y + 5, 12, 14, 6, 0.3, Color3.fromRGB(62, 82, 83))
			window.Material, window.Transparency = Enum.Material.Glass, 0.55
			block(props, "WindowMullion", x, y + 5, 12.2, 0.3, 6, 0.4, wood)
		end
	end
	sign(root, "TUNG TUNG SAHUR / THE CURSED HOUSE", Vector3.new(8, 35, 65))
	for i = 1, 28 do
		local x = if i % 2 == 0 then -67 - i % 4 * 8 else 67 + i % 4 * 8
		local z = -105 + i * 8
		block(props, "TreeTrunk", x, 0, z, 3, 22 + i % 4, 3, wood)
		local leaves = block(props, "TreeCrown", x, 18, z, 15, 12, 15, Color3.fromRGB(18, 30, 23))
		leaves.Material = Enum.Material.Grass
	end
	local function gate(name: string, x: number, y: number, z: number, sx: number, sz: number)
		local panel = block(gates, name, x, y, z, sx, 11, sz, dark)
		sign(panel, "PASSAGEM SELADA", panel.Position + Vector3.new(0, 3, 1))
	end
	gate("entry", 0, 0, 64, 12, 1)
	block(structure, "EntrySide", -15, 0, 64, 18, 47, 1, plaster)
	block(structure, "EntrySide", 25.5, 0, 64, 39, 47, 1, plaster)
	block(structure, "EntryLintel", 0, 11.5, 64, 12, 35.5, 1, plaster)
	gate("corridor", 0, 0, -52, 16, 1)
	gate("upstairs", 16, 0, 23, 10, 1)
	gate("basement", -16, -16, 23, 10, 1)
	gate("ritual", 0, -16, -52, 16, 1)
	Access.build(root)
	local interactables: { [string]: MapBuilder.Interactable } = {}
	local doorHandles: { [string]: MapBuilder.DoorHandle } = {}
	local lockers: { [string]: FeatureBuilder.LockerHandle } = {}
	local featureItems: { [string]: FeatureBuilder.Interactable } = {}
	for index, room in House.Rooms do
		if room.id == "Exterior" or room.id == "Hall" then
			continue
		end
		local center = Vector3.new(room.x, room.y, room.z)
		sign(
			props,
			room.title,
			Vector3.new(if room.x < 0 then -7.35 else 7.35, room.y + 9, room.z + 9),
			if room.x < 0 then Vector3.xAxis else -Vector3.xAxis
		)
		local lamp = block(props, "Candle", room.x, room.y + 7, room.z - 12, 0.35, 1, 0.35, gold)
		Build.light(lamp, "Street", Color3.fromRGB(255, 188, 105), 31, 0.85, true, false)
		local light = block(props, "PowerLamp", room.x + 3, room.y + 12, room.z, 1, 0.25, 1, gold)
		Build.light(light, "Lamp", Color3.fromRGB(255, 209, 138), 27, 0.8, false, true)
		local tablePart = block(props, "AntiqueTable", room.x, room.y, room.z - 11, 9, 2.5, 3, wood)
		tablePart.Material = Enum.Material.Wood
		if room.id == "Library" or string.find(room.id, "Attic") then
			for n = 1, 5 do
				block(props, "Bookshelf", room.x - 10 + n * 4, room.y, room.z - 14, 3, 8, 1.3, wood)
			end
		elseif room.id == "Bedroom" or room.id == "Child" then
			block(props, "Bed", room.x + 9, room.y + 2, room.z - 8, 7, 1, 11, Color3.fromRGB(102, 62, 59))
		elseif room.id == "Ritual" then
			Build.cylinder(
				props,
				"RitualCircle",
				center + Vector3.new(0, 0.06, 0),
				Vector3.yAxis,
				0.1,
				16,
				Color3.fromRGB(104, 27, 28),
				{ collide = false }
			)
		end
		-- Portas normais abrem pelo mesmo WorldService; não há outro dono de interação.
		local doorId = `house_door_{index}`
		local doorCenter = Vector3.new(if room.x < 0 then -8 else 8, room.y + 5.5, room.z)
		local doorPanel = Build.part(doors, doorId, Vector3.new(0.5, 11, 9), CFrame.new(doorCenter), wood)
		doorPanel.Material = Enum.Material.Wood
		local hinge = CFrame.new(doorCenter + Vector3.new(0, 0, -4.5))
		local closed = doorPanel.CFrame
		local openAngle = math.rad(if room.x < 0 then -95 else 95)
		local opened = hinge * CFrame.Angles(0, openAngle, 0) * (hinge:Inverse() * closed)
		local passage = Instance.new("PathfindingModifier")
		passage.Label, passage.PassThrough, passage.Parent = "Door", true, doorPanel
		doorPanel.CFrame = opened
		tag(doorPanel, doorId, "ABRIR / FECHAR PORTA")
		doorHandles[doorId] = {
			id = doorId,
			panel = doorPanel,
			center = doorCenter,
			hinge = hinge,
			closedCFrame = closed,
			openCFrame = opened,
			openAngle = openAngle,
			isOpen = true,
			startsOpen = true,
			busy = false,
			sound = sound(doorPanel, "Creak"),
		}
		interactables[doorId] =
			{ id = doorId, kind = "Door", focus = doorPanel, model = doorPanel, maxDistance = 8, enabled = true }
		-- Armário com corpo opaco; a câmera olha por uma fresta, sem expor o personagem.
		local id = `hide_{room.id}`
		local cabinet = Build.model(featureRoot, id)
		local p = center + Vector3.new(if room.x < 0 then -11 else 11, 0, 7)
		for _, dx in { -2, 2 } do
			block(cabinet, "Side", p.X + dx, p.Y, p.Z, 0.5, 8, 3, wood)
		end
		block(cabinet, "Back", p.X, p.Y, p.Z - 1.5, 4, 8, 0.5, wood)
		block(cabinet, "Top", p.X, p.Y + 8, p.Z, 4.5, 0.5, 3.5, wood)
		local door = block(cabinet, "HideDoor", p.X, p.Y, p.Z + 1.5, 4, 8, 0.35, wood)
		tag(
			door,
			id,
			if room.id == "Bedroom" or room.id == "Child" then "ESCONDER JUNTO À CAMA" else "ESCONDER NO ARMÁRIO"
		)
		local front = p + Vector3.new(0, 0, 4)
		lockers[id] = {
			id = id,
			model = cabinet,
			door = door,
			doorClosed = door.CFrame,
			hinge = CFrame.new(p),
			inside = CFrame.new(p + Vector3.new(0, 3, 0)),
			eye = CFrame.lookAt(p + Vector3.new(0, 5.5, 1.8), p + Vector3.new(0, 5.5, 8)),
			exit = CFrame.new(front + Vector3.new(0, 3, 0)),
			front = front,
			sound = sound(door, "Creak"),
			occupant = nil,
		}
		if room.id == "Bedroom" or room.id == "Child" or room.id == "Tunnel" then
			for _, child in cabinet:GetChildren() do
				if child ~= door then
					child:Destroy()
				end
			end
			local compartment = room.id == "Tunnel"
			block(cabinet, if compartment then "ChestLid" else "BedCover", p.X, p.Y + 3, p.Z, 8, 0.7, 6, wood)
			for _, dx in { -3.7, 3.7 } do
				block(cabinet, "Leg", p.X + dx, p.Y, p.Z, 0.5, 3.5, 5, wood)
			end
			block(cabinet, "Back", p.X, p.Y, p.Z - 3, 8, 3.5, 0.5, wood)
			door.Size, door.CFrame, door.Transparency, door.CanCollide =
				Vector3.new(5, 1, 0.3), CFrame.new(p + Vector3.new(0, 1.5, 3)), 0.8, false
			tag(door, id, if compartment then "ENTRAR NO COMPARTIMENTO" else "ESCONDER SOB A CAMA")
			local locker = lockers[id]
			locker.inside = CFrame.new(p + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
			locker.eye = CFrame.lookAt(p + Vector3.new(0, 1.7, 3.2), p + Vector3.new(0, 1.7, 8))
			locker.doorClosed = door.CFrame
		end
		featureItems[id] = { id = id, kind = "Hide", focus = door, model = cabinet, maxDistance = 8, enabled = true }
	end
	local gateModel = Build.model(root, "ForestGate")
	local gatePanel = block(gateModel, "Gate", 0, 0, 98, 18, 10, 1, dark)
	gateModel.PrimaryPart = gatePanel
	local gatePivot = gateModel:GetPivot()
	local beacon = block(root, "ExitBeacon", 11, 0, 98, 1, 8, 1, gold)
	Build.light(beacon, "Exit", Color3.fromRGB(90, 210, 130), 28, 1, true)
	sign(root, "SAÍDA / FLORESTA", Vector3.new(0, 10, 98))
	local utility = Build.folder(root, "Utility")
	local panel = block(utility, "PowerPanel", 36, 0, -80, 3, 4, 1, dark)
	local labelPart = Build.sign(
		utility,
		"Diagram",
		Vector3.new(36, 6, -80),
		Vector3.zAxis,
		Vector2.new(5, 2),
		"ENERGIA PARCIAL",
		{ textColor = gold }
	)
	local label = labelPart:FindFirstChildWhichIsA("TextLabel", true) :: TextLabel
	local world: MapBuilder.World = {
		root = root,
		interactables = interactables,
		fuseModels = {},
		doors = doorHandles,
		gate = {
			model = gateModel,
			closedPivot = gatePivot,
			openPivot = gatePivot + Vector3.new(0, 12, 0),
			isOpen = false,
			busy = false,
			sound = sound(gatePanel, "Gate"),
			beacon = beacon,
		},
		panel = {
			focus = panel,
			slotFuses = {},
			status = panel,
			switchSound = sound(panel, "Switch"),
			hum = sound(panel, "Hum"),
		},
		buzz = {},
		spawnCFrame = CFrame.lookAt(Vector3.new(0, 3, 77), Vector3.new(0, 3, 0)),
	}
	local features: FeatureBuilder.Built = {
		root = featureRoot,
		interactables = featureItems,
		keys = {},
		batteries = {},
		lockers = lockers,
		fallables = {},
		radio = panel,
		breakers = {
			box = panel,
			levers = {},
			down = {},
			up = {},
			lamps = {},
			diagram = label,
			toggle = sound(panel, "Toggle"),
			fail = sound(panel, "Fail"),
			solved = sound(panel, "Solved"),
		},
	}
	return world, features
end
return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="494">
          <Properties>
            <string name="Name">HouseExterior</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Fachada, telhado, varanda e jardim da mansão (lote 5 do ambiente). Só visual:
	- casca externa fina por fora das paredes: reboco PBR, soco de tijolo, cunhais de pedra, faixas e cornija;
	- janelas falsas com caixilho 3D, venezianas, frontão e luz quente (ou escura) por trás;
	- telhado do GeneratedEstate (testeira, cumeeira, chaminés, letreiro no frontão), refeito a cada nível;
	- muro de tijolo no perímetro (só a aparência das barreiras), cerca de ferro, caminho de pedra,
	  varanda, postes vitorianos, abóboras e um cemitério pequeno longe dos pavilhões.
	Nada daqui colide, recebe raycast ou toque; colisões, nomes e posições existentes não mudam.
	Final em ruínas: casca e telhado somem junto com as paredes; o jardim fica.
]]

local Build = require("./Build")
local Materials = require("./HouseMaterials")
local Props = require("./HouseProps")

local Exterior = {}

local V3 = Vector3.new
local rgb = Color3.fromRGB
local UP = Vector3.yAxis

local STUCCO: Materials.Finish =
	{ variant = "MansionPlaster", material = Enum.Material.Plaster, color = rgb(206, 196, 182) }
local DECK: Materials.Finish =
	{ variant = "MansionFloorPlanks", material = Enum.Material.WoodPlanks, color = rgb(150, 132, 118) }
local TRIM = Materials.Wood
local BRICK = rgb(96, 62, 52)
local BRICK_DARK = rgb(78, 50, 44)
local STONE = rgb(118, 114, 106)
local SLATE = rgb(50, 52, 60)
local IRON = rgb(30, 28, 32)
local WARM = rgb(255, 190, 120)
local SHUTTER = rgb(44, 56, 52)
local CURTAIN = rgb(78, 26, 30)
local LEAVES = rgb(34, 56, 38)
local PLINTH = 3.2

-- Peça decorativa: sem colisão, raycast nem toque.
local function deco(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	class: ("Part" | "WedgePart")?
): BasePart
	local part = Build.part(parent, name, size, cframe, color, {
		material = material or Enum.Material.SmoothPlastic,
		collide = false,
		query = false,
		class = class,
	})
	part.CanTouch = false
	return part
end

local function rod(
	parent: Instance,
	name: string,
	center: Vector3,
	axis: Vector3,
	length: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	local part = Build.cylinder(parent, name, center, axis, length, diameter, color, {
		material = material or Enum.Material.Metal,
		collide = false,
		query = false,
	})
	part.CanTouch = false
	return part
end

local function finish(part: BasePart, f: Materials.Finish): BasePart
	Materials.apply(part, f)
	return part
end

-- Esfera esticada (gomos de abóbora, copas): a forma Ball do Roblox é sempre redonda.
local function ellipsoid(part: BasePart): BasePart
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

--[[
	Fonte de luz invisível e sempre acesa. Não é registrada no WorldFxController: o teste de visibilidade
	dele (feito para luz de um cômodo não vazar para outro) apagava lanternas atrás de pilares e beirais.
]]
local function lamp(parent: Instance, at: Vector3, range: number, brightness: number)
	local part = deco(parent, "ExteriorLamp", V3(0.3, 0.3, 0.3), CFrame.new(at), WARM)
	part.Transparency = 1
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Shadows = WARM, range, brightness, false
	light.Parent = part
	return part
end

-- Luz de jardim no chão apontada para a fachada (lua não basta para ler a arquitetura à noite).
local function uplight(parent: Instance, at: Vector3, target: Vector3)
	local part = deco(parent, "FacadeUplight", V3(0.8, 0.3, 0.8), CFrame.lookAt(at, target), IRON, Enum.Material.Metal)
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Front
	light.Color, light.Range, light.Brightness, light.Angle, light.Shadows = rgb(170, 186, 220), 46, 0.75, 70, false
	light.Parent = part
end

-- Triângulo no plano da parede (frontões): duas cunhas com o lado alto no meio.
local function gable(
	parent: Instance,
	name: string,
	base: Vector3,
	normal: Vector3,
	width: number,
	height: number,
	depth: number
)
	local right = UP:Cross(normal).Unit
	for _, side in { -1, 1 } do
		local z = -right * side
		local center = base + right * side * width / 4 + UP * height / 2
		local cframe = CFrame.fromMatrix(center, UP:Cross(z), UP, z)
		finish(deco(parent, name, V3(depth, height, width / 2), cframe, TRIM.color, TRIM.material, "WedgePart"), TRIM)
	end
end

--[[ Casca externa ]]

type Face = { from: Vector2, to: Vector2, normal: Vector3, top: number, bands: boolean, holes: { { number } } }

-- Faces externas (contorno do teste EstateGround). Furos: {u0, u1, y0, y1} ao longo da face.
local FACES: { Face } = {
	-- Frente do vestíbulo, com a porta.
	{
		from = Vector2.new(-24.5, 64.5),
		to = Vector2.new(45.5, 64.5),
		normal = Vector3.zAxis,
		top = 47,
		bands = true,
		holes = { { 18.5, 30.5, -1, 11.5 } },
	},
	{
		from = Vector2.new(45.5, 64.5),
		to = Vector2.new(45.5, 12),
		normal = Vector3.xAxis,
		top = 47,
		bands = true,
		holes = {},
	},
	{
		from = Vector2.new(-24.5, 12.5),
		to = Vector2.new(-24.5, 64.5),
		normal = -Vector3.xAxis,
		top = 47,
		bands = true,
		holes = {},
	},
	-- Laterais dos cômodos: as faixas já vêm do GeneratedEstate (ExteriorCornice).
	{
		from = Vector2.new(44.5, 12.5),
		to = Vector2.new(44.5, -85.5),
		normal = Vector3.xAxis,
		top = 48,
		bands = false,
		holes = {},
	},
	{
		from = Vector2.new(-44.5, -85.5),
		to = Vector2.new(-44.5, 12.5),
		normal = -Vector3.xAxis,
		top = 48,
		bands = false,
		holes = {},
	},
	{
		from = Vector2.new(44.5, -85.5),
		to = Vector2.new(-44.5, -85.5),
		normal = -Vector3.zAxis,
		top = 48,
		bands = true,
		holes = {},
	},
	-- Frente da ala oeste, com as janelas reais dos cômodos.
	{
		from = Vector2.new(-44.5, 12.5),
		to = Vector2.new(-24.5, 12.5),
		normal = Vector3.zAxis,
		top = 48,
		bands = true,
		holes = { { 11.5, 20.5, 5, 11 }, { 11.5, 20.5, 21, 27 }, { 11.5, 20.5, 37, 43 } },
	},
}

-- Retângulo menos furos (sem sobreposição entre furos): faixas verticais, cada uma recortada na altura.
local function pieces(u0: number, u1: number, y0: number, y1: number, holes: { { number } }): { { number } }
	local cuts = { u0, u1 }
	for _, hole in holes do
		table.insert(cuts, math.clamp(hole[1], u0, u1))
		table.insert(cuts, math.clamp(hole[2], u0, u1))
	end
	table.sort(cuts)
	local out = {}
	for i = 1, #cuts - 1 do
		local a, b = cuts[i], cuts[i + 1]
		if b - a < 0.01 then
			continue
		end
		local spans = {}
		for _, hole in holes do
			if hole[1] < b - 0.01 and hole[2] > a + 0.01 then
				table.insert(spans, { math.max(hole[3], y0), math.min(hole[4], y1) })
			end
		end
		table.sort(spans, function(p, q)
			return p[1] < q[1]
		end)
		local y = y0
		for _, span in spans do
			if span[1] > y + 0.01 then
				table.insert(out, { a, b, y, span[1] })
			end
			y = math.max(y, span[2])
		end
		if y1 > y + 0.01 then
			table.insert(out, { a, b, y, y1 })
		end
	end
	return out
end

local function plate(
	parent: Instance,
	name: string,
	face: Face,
	rect: { number },
	depth: number,
	color: Color3,
	material: Enum.Material
): BasePart
	local origin = V3(face.from.X, 0, face.from.Y)
	local right = (V3(face.to.X, 0, face.to.Y) - origin).Unit
	local u, y = (rect[1] + rect[2]) / 2, (rect[3] + rect[4]) / 2
	local center = origin + right * u + UP * y + face.normal * depth / 2
	return deco(
		parent,
		name,
		V3(rect[2] - rect[1], rect[4] - rect[3], depth),
		CFrame.lookAt(center, center + face.normal),
		color,
		material
	)
end

local function shell(folder: Instance)
	for _, face in FACES do
		local length = (face.to - face.from).Magnitude
		for _, rect in pieces(0, length, PLINTH, face.top, face.holes) do
			finish(plate(folder, "FacadeStucco", face, rect, 0.06, STUCCO.color, STUCCO.material), STUCCO)
		end
		for _, rect in pieces(0, length, 0, PLINTH, face.holes) do
			plate(folder, "FacadePlinth", face, rect, 0.3, BRICK, Enum.Material.Brick)
		end
		for _, rect in pieces(0, length, PLINTH, PLINTH + 0.35, face.holes) do
			plate(folder, "FacadePlinthCap", face, rect, 0.42, STONE, Enum.Material.Slate)
		end
		if face.bands then
			for _, y in { 16, 32 } do
				for _, rect in pieces(0, length, y - 0.3, y + 0.3, face.holes) do
					finish(plate(folder, "FacadeBand", face, rect, 0.36, TRIM.color, TRIM.material), TRIM)
				end
			end
			-- Cornija em dois degraus sob o beiral.
			finish(
				plate(
					folder,
					"FacadeCornice",
					face,
					{ 0, length, face.top - 1.1, face.top - 0.2 },
					0.5,
					TRIM.color,
					TRIM.material
				),
				TRIM
			)
			finish(
				plate(
					folder,
					"FacadeCornice",
					face,
					{ 0, length, face.top - 0.4, face.top },
					0.85,
					TRIM.color,
					TRIM.material
				),
				TRIM
			)
		end
	end
	-- Cunhais de pedra alternados nas quinas externas.
	local corners = {
		{ -44.5, -85.5, -1, -1, 48 },
		{ 44.5, -85.5, 1, -1, 48 },
		{ -44.5, 12.5, -1, 1, 48 },
		{ -24.5, 64.5, -1, 1, 47 },
		{ 45.5, 64.5, 1, 1, 47 },
	}
	for _, c in corners do
		local cx, cz, sx, sz, top = c[1], c[2], c[3], c[4], c[5]
		local index = 0
		for y = PLINTH + 0.45, top - 2.6, 2.1 do
			local a = if index % 2 == 0 then 2.6 else 1.7
			index += 1
			deco(
				folder,
				"FacadeQuoin",
				V3(a + 0.18, 1.85, a + 0.18),
				CFrame.new(cx + sx * (0.18 - a) / 2, y + 0.925, cz + sz * (0.18 - a) / 2),
				STONE,
				Enum.Material.Slate
			)
		end
	end
end

--[[ Janelas ]]

local function facadeWindow(folder: Instance, center: Vector3, normal: Vector3, lit: boolean, pediment: boolean)
	local right = UP:Cross(normal).Unit
	local w, h = 6.1, 7.2
	local out = center + normal * 0.06
	local model = Props.place(folder, "WindowSet", out, normal, 0.8, "wall")
	if model then
		for _, part in model:GetDescendants() do
			if part.Name == "Curtains" or part.Name == "Rod" then
				part:Destroy()
			elseif part.Name == "Glass" and part:IsA("BasePart") then
				-- Vidro mais claro que o de dentro: a luz do cômodo aparece da rua.
				part.Transparency = 0.7
			end
		end
	else
		deco(
			folder,
			"FacadeWindowFrame",
			V3(w, h, 0.4),
			CFrame.lookAt(out + normal * 0.2, out + normal),
			TRIM.color,
			Enum.Material.Wood
		)
	end
	-- Interior: luz quente com cortinas, ou um quarto escuro.
	local back = out + normal * 0.08
	local glow = deco(
		folder,
		"FacadeWindowGlow",
		V3(w - 1.1, h - 1, 0.05),
		CFrame.lookAt(back, back + normal),
		if lit then rgb(190, 120, 60) else rgb(14, 16, 22),
		if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
	)
	glow.CastShadow = false
	if lit then
		for _, side in { -1, 1 } do
			local at = back + normal * 0.04 + right * side * (w / 2 - 1.15)
			deco(
				folder,
				"FacadeCurtain",
				V3(1.1, h - 1, 0.04),
				CFrame.lookAt(at, at + normal),
				CURTAIN,
				Enum.Material.Fabric
			)
		end
	end
	for _, side in { -1, 1 } do
		local at = out + normal * 0.12 + right * side * (w / 2 + 1.05)
		local shutter = deco(
			folder,
			"FacadeShutter",
			V3(1.9, h - 0.4, 0.18),
			CFrame.lookAt(at, at + normal),
			SHUTTER,
			Enum.Material.Wood
		)
		-- Ripas da veneziana.
		for row = -1, 1 do
			deco(
				folder,
				"FacadeShutterSlat",
				V3(1.5, 0.12, 0.08),
				shutter.CFrame * CFrame.new(0, row * 2, -0.12),
				SHUTTER:Lerp(Color3.new(0, 0, 0), 0.35),
				Enum.Material.Wood
			)
		end
	end
	local sill = out + normal * 0.45 - UP * (h / 2 + 0.25)
	deco(folder, "FacadeSill", V3(w + 1.2, 0.4, 0.9), CFrame.lookAt(sill, sill + normal), STONE, Enum.Material.Slate)
	local head = out + normal * 0.3 + UP * (h / 2 + 0.3)
	finish(
		deco(folder, "FacadeHead", V3(w + 1.4, 0.5, 0.6), CFrame.lookAt(head, head + normal), TRIM.color, TRIM.material),
		TRIM
	)
	if pediment then
		gable(folder, "FacadePediment", head + UP * 0.25 + normal * 0.05, normal, w + 1.6, 1.5, 0.45)
	end
end

local function windows(folder: Instance)
	local count = 0
	-- Algumas janelas escuras quebram a repetição (casa grande, nem todos os cômodos acesos).
	local function lit(): boolean
		count += 1
		return (count * 7) % 10 < 6
	end
	local ROWS = { 7.5, 23.5, 40.2 }
	-- Frente: colunas simétricas em torno do frontão (x = 10,5); térreo livre na porta e na varanda.
	for row, y in ROWS do
		for _, x in { -15.5, -2.5, 10.5, 23.5, 36.5 } do
			if row == 1 and (x == -2.5 or x == 10.5) then
				continue
			end
			facadeWindow(folder, V3(x, y, 64.5), Vector3.zAxis, lit(), row > 1)
		end
	end
	for _, y in ROWS do
		for _, z in { 26, 50 } do
			facadeWindow(folder, V3(45.5, y, z), Vector3.xAxis, lit(), true)
			facadeWindow(folder, V3(-24.5, y, z), -Vector3.xAxis, lit(), true)
		end
		for _, z in { -14, -46, -78 } do
			facadeWindow(folder, V3(44.5, y, z), Vector3.xAxis, lit(), true)
			facadeWindow(folder, V3(-44.5, y, z), -Vector3.xAxis, lit(), true)
		end
		for _, x in { -34, -18, 18, 34 } do
			facadeWindow(folder, V3(x, y, -85.5), -Vector3.zAxis, lit(), true)
		end
		-- Ala oeste: janela real do cômodo (vidro na parede); só peitoril e verga por fora.
		local sill = V3(-28.75, y - 3.25, 12.95)
		deco(folder, "FacadeSill", V3(9.2, 0.4, 0.9), CFrame.new(sill), STONE, Enum.Material.Slate)
		finish(
			deco(folder, "FacadeHead", V3(9.2, 0.5, 0.6), CFrame.new(-28.75, y + 3.3, 12.8), TRIM.color, TRIM.material),
			TRIM
		)
	end
end

--[[ Entrada e varanda (fixas) ]]

local function entrance(shellFolder: Instance, yard: Instance)
	-- Lanternas de parede ao lado da porta.
	for _, x in { -8.5, 8.5 } do
		local wall = V3(x, 7.4, 64.56)
		deco(
			shellFolder,
			"FacadeLanternPlate",
			V3(0.9, 1.4, 0.12),
			CFrame.new(wall + V3(0, 0, 0.06)),
			IRON,
			Enum.Material.Metal
		)
		deco(
			shellFolder,
			"FacadeLanternArm",
			V3(0.16, 0.16, 1.1),
			CFrame.new(wall + V3(0, 0, 0.6)),
			IRON,
			Enum.Material.Metal
		)
		if not Props.place(shellFolder, "Lantern", wall + V3(0, -0.85, 1.15), Vector3.zAxis, 1.55, "floor") then
			deco(
				shellFolder,
				"FacadeLanternGlass",
				V3(0.9, 1.4, 0.9),
				CFrame.new(wall + V3(0, 0, 1.15)),
				WARM,
				Enum.Material.Neon
			)
		end
		lamp(shellFolder, wall + V3(0, 0.2, 1.6), 22, 1.2)
	end
	-- Piso da varanda, degrau e capacho.
	finish(deco(yard, "PorchDeck", V3(34, 0.12, 13.5), CFrame.new(0, 0.06, 71.25), DECK.color, DECK.material), DECK)
	deco(yard, "PorchStep", V3(34.4, 0.3, 0.7), CFrame.new(0, 0.15, 78.2), STONE, Enum.Material.Slate)
	deco(yard, "PorchDoormat", V3(8, 0.05, 3.2), CFrame.new(0, 0.145, 66.4), rgb(84, 40, 40), Enum.Material.Fabric)
	Props.place(yard, "RockingChair", V3(-12.5, 0.12, 67.6), V3(0.45, 0, 1), 1, "floor")
	for _, spot in { { -21, 70, -20 }, { 30, 70, 30 }, { 7, 86, 10.5 } } do
		uplight(yard, V3(spot[1], 0.2, spot[2]), V3(spot[3], 30, 64.5))
	end
	-- Sebes baixas junto à fachada (não colidem: a rota do jardim fica igual).
	for _, hedge in { { -20.75, 7 }, { 31.2, 27.6 } } do
		local part =
			deco(yard, "Hedge", V3(hedge[2], 2.6, 2.2), CFrame.new(hedge[1], 1.3, 66), LEAVES, Enum.Material.LeafyGrass)
		part.CastShadow = false
	end
end

--[[ Telhado e terreno do GeneratedEstate (refeitos a cada nível) ]]

local function flat(v: Vector3): Vector3
	return V3(v.X, 0, v.Z).Unit
end

local function roofTrim(folder: Instance, part: BasePart)
	local cframe, size = part.CFrame, part.Size
	local a, b = cframe * V3(size.X / 2, 0, 0), cframe * V3(-size.X / 2, 0, 0)
	local low, high = if a.Y < b.Y then a else b, if a.Y < b.Y then b else a
	local look = flat(cframe.LookVector)
	local fascia = low - UP * 0.4
	finish(
		deco(
			folder,
			"RoofFascia",
			V3(0.35, 1.3, size.Z + 0.4),
			CFrame.lookAt(fascia, fascia + look),
			TRIM.color,
			TRIM.material
		),
		TRIM
	)
	-- Uma cumeeira por par de águas (só na água que sobe para +X).
	if high.X > part.Position.X then
		rod(
			folder,
			"RoofRidge",
			high + UP * 0.35,
			look,
			size.Z + 0.6,
			1.1,
			SLATE:Lerp(Color3.new(0, 0, 0), 0.25),
			Enum.Material.Slate
		)
		for _, side in { -1, 1 } do
			local tip = high + look * side * (size.Z / 2 + 0.2) + UP * 0.9
			rod(folder, "RoofFinial", tip + UP * 0.8, UP, 1.8, 0.22, IRON)
			local ball =
				deco(folder, "RoofFinial", V3(0.6, 0.6, 0.6), CFrame.new(tip + UP * 1.75), IRON, Enum.Material.Metal);
			(ball :: Part).Shape = Enum.PartType.Ball
		end
	end
end

local function chimney(folder: Instance, part: BasePart)
	part.Material, part.Color = Enum.Material.Brick, BRICK
	local top = part.Position + UP * part.Size.Y / 2
	-- Faixa de tijolo saliente e dois potes de barro sobre o capitel.
	deco(
		folder,
		"RoofChimneyBand",
		V3(part.Size.X + 0.4, 0.5, part.Size.Z + 0.4),
		CFrame.new(top - UP * 1.6),
		BRICK_DARK,
		Enum.Material.Brick
	)
	for _, dx in { -1.1, 1.1 } do
		rod(folder, "RoofChimneyPot", top + V3(dx, 1.5, 0), UP, 1.7, 1.1, rgb(140, 82, 62), Enum.Material.Concrete)
	end
end

local function ironFence(folder: Instance, part: BasePart)
	local size = part.Size
	local along = if size.X > size.Z then part.CFrame.RightVector else part.CFrame.LookVector
	local length = math.max(size.X, size.Z)
	local base = part.Position - UP * size.Y / 2
	local start = base - along * length / 2
	local bars = math.floor(length / 1.6)
	for i = 0, bars do
		local at = start + along * (i * length / bars)
		local post = i % 9 == 0
		local width = if post then 0.55 else 0.2
		deco(folder, "IronFenceBar", V3(width, 4.4, width), CFrame.new(at + UP * 2.2), IRON, Enum.Material.Metal)
		local tip = deco(
			folder,
			"IronFenceTip",
			V3(0.32, 0.32, 0.2),
			CFrame.lookAt(at + UP * 4.5, at + UP * 4.5 + along:Cross(UP)) * CFrame.Angles(0, 0, math.rad(45)),
			IRON,
			Enum.Material.Metal
		)
		if post then
			tip.Size = V3(0.6, 0.6, 0.6);
			(tip :: Part).Shape = Enum.PartType.Ball
		end
	end
	for _, y in { 0.7, 3.7 } do
		local mid = base + UP * y
		deco(
			folder,
			"IronFenceRail",
			V3(0.18, 0.18, length),
			CFrame.lookAt(mid, mid + along),
			IRON,
			Enum.Material.Metal
		)
	end
end

local function porchRoof(folder: Instance, part: BasePart)
	local p, size = part.Position, part.Size
	local top, bottom = p.Y + size.Y / 2, p.Y - size.Y / 2
	deco(
		folder,
		"PorchRoofCap",
		V3(size.X + 0.6, 0.3, size.Z + 0.6),
		CFrame.new(p.X, top + 0.15, p.Z),
		SLATE,
		Enum.Material.Slate
	)
	local front = p.Z + size.Z / 2 + 0.2
	finish(
		deco(
			folder,
			"PorchRoofFascia",
			V3(size.X + 0.8, 1.3, 0.35),
			CFrame.new(p.X, p.Y - 0.1, front),
			TRIM.color,
			TRIM.material
		),
		TRIM
	)
	for _, side in { -1, 1 } do
		local x = p.X + side * (size.X / 2 + 0.2)
		finish(
			deco(
				folder,
				"PorchRoofFascia",
				V3(0.35, 1.3, size.Z + 0.4),
				CFrame.new(x, p.Y - 0.1, p.Z),
				TRIM.color,
				TRIM.material
			),
			TRIM
		)
	end
	-- Lanterna pendurada no meio da varanda.
	local hang = V3(p.X, bottom, p.Z + 2)
	rod(folder, "PorchLanternChain", hang - UP * 0.6, UP, 1.2, 0.12, IRON)
	if not Props.place(folder, "Lantern", hang - UP * 1.2, Vector3.zAxis, 1.9, "ceiling") then
		deco(folder, "PorchLanternGlass", V3(0.9, 1.4, 0.9), CFrame.new(hang - UP * 2), WARM, Enum.Material.Neon)
	end
	lamp(folder, hang - UP * 2.3, 26, 1.2)
end

local function pillar(folder: Instance, part: BasePart)
	finish(part, TRIM)
	local p, size = part.Position, part.Size
	local bottom = p.Y - size.Y / 2
	deco(folder, "PorchPillarBase", V3(2.3, 1.4, 2.3), CFrame.new(p.X, bottom + 0.7, p.Z), STONE, Enum.Material.Slate)
	finish(
		rod(folder, "PorchPillarShaft", V3(p.X, p.Y + 0.4, p.Z), UP, size.Y - 2.4, 1.8, TRIM.color, TRIM.material),
		TRIM
	)
	for _, y in { bottom + 2.2, p.Y + size.Y / 2 - 1.6 } do
		finish(rod(folder, "PorchPillarRing", V3(p.X, y, p.Z), UP, 0.35, 2.1, TRIM.color, TRIM.material), TRIM)
	end
	finish(
		deco(
			folder,
			"PorchPillarCapital",
			V3(2.2, 0.6, 2.2),
			CFrame.new(p.X, p.Y + size.Y / 2 - 0.3, p.Z),
			TRIM.color,
			TRIM.material
		),
		TRIM
	)
end

local function hide(container: Instance?, on: boolean)
	if not container then
		return
	end
	for _, item in container:GetDescendants() do
		if item:IsA("BasePart") then
			if on then
				if item:GetAttribute("ShellTransparency") == nil then
					item:SetAttribute("ShellTransparency", item.Transparency)
				end
				item.Transparency = 1
			else
				local saved = item:GetAttribute("ShellTransparency")
				if type(saved) == "number" then
					item.Transparency = saved
				end
			end
		elseif item:IsA("Light") then
			item.Enabled = not on
		elseif item:IsA("SurfaceGui") then
			(item :: SurfaceGui).Enabled = not on
		end
	end
end

-- Tijolo e ardósia PBR (lote 6). Com textura, Color só tinge: fica claro para não escurecer o mapa.
local ROOF_NAMES = { EstatePitchedRoof = true, FoyerPitchedRoof = true, PorchRoofCap = true, PavilionRoof = true }

local function pbr(container: Instance?)
	if not container then
		return
	end
	for _, part in container:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		if part.Material == Enum.Material.Brick and part.MaterialVariant == "" then
			part.MaterialVariant = "GardenBrick"
			part.Color = if part.Color == BRICK_DARK then rgb(176, 164, 158) else rgb(214, 204, 198)
		elseif ROOF_NAMES[part.Name] then
			part.Material, part.MaterialVariant, part.Color = Enum.Material.Slate, "RoofSlate", rgb(150, 150, 158)
		end
	end
end

local ESTATE_WOOD = {
	ExteriorCornice = true,
	PavilionColumn = true,
	LookoutFloor = true,
	LookoutGuard = true,
	GardenStairGuard = true,
	CourtArch = true,
	CourtArchColumn = true,
	CourtBench = true,
	PottingBench = true,
	PavilionLantern = true,
}

local function dressEstate(root: Instance)
	local estate = root:FindFirstChild("GeneratedEstate")
	if not estate or estate:FindFirstChild("RoofDress") then
		return
	end
	local roof = Build.folder(estate, "RoofDress")
	local ground = Build.folder(estate, "EstateDress")
	for _, part in estate:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		local name = part.Name
		if name == "EstatePitchedRoof" or name == "FoyerPitchedRoof" then
			part.Color = SLATE
			roofTrim(roof, part)
		elseif name == "EstateGable" then
			finish(part, STUCCO)
		elseif name == "Chimney" then
			chimney(roof, part)
		elseif name == "ChimneyCap" or name == "GardenStairRamp" then
			part.Material, part.Color = Enum.Material.Slate, STONE
		elseif ESTATE_WOOD[name] then
			-- Cornijas, pavilhões, mirante e pátio dos fundos na mesma nogueira da casa.
			finish(part, TRIM)
		elseif name == "FacadePilaster" or name == "SideWindowFrame" or name == "SideWindowInset" then
			-- Substituídos pelos cunhais e janelas da casca externa.
			part.Transparency = 1
		elseif name == "EstateGround" then
			part.Material, part.Color = Enum.Material.Grass, rgb(40, 56, 40)
		elseif name == "GardenWalk" or name == "FrontWalk" or name == "RearCourt" then
			part.Material, part.Color = Enum.Material.Cobblestone, rgb(96, 92, 86)
		elseif name == "EstateFence" or name == "RearFence" then
			part.Material, part.Color = Enum.Material.WoodPlanks, rgb(58, 44, 38)
		elseif name == "FrontFence" then
			-- A colisão continua na peça original; só a aparência vira grade de ferro.
			part.Transparency = 1
			ironFence(ground, part)
		elseif name == "PorchCanopy" then
			finish(part, TRIM)
			porchRoof(roof, part)
		elseif name == "PorchPillar" then
			pillar(ground, part)
		end
	end
	-- Frontão da frente: óculo aceso e o letreiro do jogo.
	local oculus = V3(10.5, 59.3, 66.45)
	finish(rod(roof, "GableOculus", oculus, Vector3.zAxis, 0.4, 4.2, TRIM.color, TRIM.material), TRIM)
	local pane = rod(
		roof,
		"GableOculusGlow",
		oculus + V3(0, 0, 0.05),
		Vector3.zAxis,
		0.4,
		3.3,
		rgb(190, 120, 60),
		Enum.Material.Neon
	)
	pane.CastShadow = false
	local title =
		Build.sign(roof, "BigTitle", V3(10.5, 52.4, 66.5), Vector3.zAxis, Vector2.new(22, 4.2), "TUNG TUNG SAHUR", {
			textColor = rgb(233, 202, 147),
			background = rgb(38, 30, 26),
			lit = true,
			font = Enum.Font.SpecialElite,
		})
	title.CanQuery, title.CanTouch = false, false
	pbr(estate)
	if root:FindFirstChild("Ruins") then
		hide(roof, true)
	end
end

--[[ Muro do perímetro (aparência das barreiras Boundary) ]]

local function boundary(root: Instance, folder: Instance)
	local barriers = root:FindFirstChild("ProgressionBarriers")
	if not barriers then
		return
	end
	for _, part in barriers:GetChildren() do
		if not part:IsA("BasePart") or part.Name ~= "Boundary" then
			continue
		end
		part.Material, part.Color = Enum.Material.Brick, BRICK
		local size = part.Size
		local along = if size.X > size.Z then Vector3.xAxis else Vector3.zAxis
		local length = math.max(size.X, size.Z)
		local thick = math.min(size.X, size.Z)
		local top = part.Position + UP * size.Y / 2
		deco(
			folder,
			"WallCoping",
			if along == Vector3.xAxis then V3(length + 0.4, 0.5, thick + 0.8) else V3(thick + 0.8, 0.5, length + 0.4),
			CFrame.new(top + UP * 0.25),
			STONE,
			Enum.Material.Slate
		)
		local piers = math.max(1, math.floor(length / 16))
		for i = 0, piers do
			local at = part.Position - along * length / 2 + along * (i * length / piers)
			local bottom = at.Y - size.Y / 2
			local pier = deco(
				folder,
				"WallPier",
				V3(thick + 1.4, size.Y + 1.2, thick + 1.4),
				CFrame.new(at.X, bottom + (size.Y + 1.2) / 2, at.Z),
				BRICK_DARK,
				Enum.Material.Brick
			)
			pier.CastShadow = false
			deco(
				folder,
				"WallPierCap",
				V3(thick + 2, 0.5, thick + 2),
				CFrame.new(at.X, bottom + size.Y + 1.45, at.Z),
				STONE,
				Enum.Material.Slate
			)
		end
	end
end

--[[ Jardim ]]

local function lampPost(folder: Instance, at: Vector3)
	local model = Build.model(folder, "LampPost")
	deco(model, "LampBase", V3(1.7, 1, 1.7), CFrame.new(at + UP * 0.5), IRON, Enum.Material.Metal)
	rod(model, "LampPlinth", at + UP * 1.6, UP, 1.2, 1.1, IRON)
	rod(model, "Pole", at + UP * 5.6, UP, 7.6, 0.42, IRON)
	for _, y in { 2.5, 8.8 } do
		rod(model, "LampCollar", at + UP * y, UP, 0.3, 0.75, IRON)
	end
	deco(model, "LampCrossbar", V3(2.4, 0.16, 0.16), CFrame.new(at + UP * 8.4), IRON, Enum.Material.Metal)
	if not Props.place(model, "Lantern", at + UP * 9.35, Vector3.zAxis, 2.3, "floor") then
		deco(model, "Lamp", V3(1, 1.4, 1), CFrame.new(at + UP * 10.1), WARM, Enum.Material.Neon)
	end
	lamp(model, at + UP * 10.6, 28, 1.2)
end

local function pumpkin(folder: Instance, at: Vector3, size: number, face: Vector3?)
	local model = Build.model(folder, "Pumpkin")
	local center = at + UP * size * 0.34
	local orange = rgb(206, 92, 26)
	ellipsoid(
		deco(
			model,
			"PumpkinCore",
			V3(size * 0.7, size * 0.62, size * 0.7),
			CFrame.new(center),
			orange,
			Enum.Material.SmoothPlastic
		)
	)
	-- Oito gomos em volta, um pouco irregulares.
	for i = 0, 7 do
		local angle = i / 8 * math.pi * 2
		local dir = V3(math.cos(angle), 0, math.sin(angle))
		local lobe = deco(
			model,
			"PumpkinLobe",
			V3(size * 0.4, size * (0.66 + (i % 3) * 0.02), size * 0.6),
			CFrame.lookAt(center + dir * size * 0.22, center + dir * size),
			orange:Lerp(rgb(150, 56, 18), (i % 2) * 0.22),
			Enum.Material.SmoothPlastic
		)
		ellipsoid(lobe)
	end
	rod(
		model,
		"PumpkinStem",
		center + UP * size * 0.36,
		V3(0.2, 1, 0.1),
		size * 0.3,
		size * 0.12,
		rgb(74, 82, 44),
		Enum.Material.Wood
	)
	if face then
		-- Rosto entalhado aceso (placa transparente: SurfaceGui não desenha bem em superfícies curvas).
		local spot = center + face * size * 0.53
		local carving =
			deco(model, "PumpkinFace", V3(size * 0.75, size * 0.55, 0.05), CFrame.lookAt(spot, spot + face), orange)
		carving.Transparency = 1
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.LightInfluence = 0
		gui.Brightness = 2
		gui.CanvasSize = Vector2.new(100, 80)
		gui.Parent = carving
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "▲ ▲\n◡"
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = rgb(255, 196, 90)
		label.Parent = gui
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness, light.Shadows = rgb(255, 150, 60), 10, 0.7, false
		light.Parent = carving
	end
end

local GRAVE_TEXT = { "R.I.P.", "TUM\nTUM", "AQUI JAZ\nUM TUM", "1912", "R.I.P.", "TUM\nTUM" }

local function grave(folder: Instance, at: Vector3, yaw: number, kind: number, text: string)
	local model = Build.model(folder, "Gravestone")
	local base = CFrame.new(at) * CFrame.Angles(0, math.rad(yaw), 0)
	local tilt = base * CFrame.Angles(math.rad((yaw % 5) - 2), 0, math.rad((yaw % 7) - 3))
	local stone = rgb(104, 104, 100)
	deco(
		model,
		"GraveBase",
		V3(3.4, 0.5, 1.6),
		base * CFrame.new(0, 0.25, 0),
		stone:Lerp(Color3.new(0, 0, 0), 0.2),
		Enum.Material.Slate
	)
	local front: BasePart
	if kind == 1 then
		front = deco(model, "GraveSlab", V3(2.6, 3, 0.55), tilt * CFrame.new(0, 2, 0), stone, Enum.Material.Slate)
		rod(
			model,
			"GraveArch",
			(tilt * CFrame.new(0, 3.5, 0)).Position,
			tilt.LookVector,
			0.55,
			2.6,
			stone,
			Enum.Material.Slate
		)
	elseif kind == 2 then
		front = deco(model, "GraveCross", V3(0.7, 4.4, 0.55), tilt * CFrame.new(0, 2.7, 0), stone, Enum.Material.Slate)
		deco(model, "GraveCross", V3(2.6, 0.7, 0.55), tilt * CFrame.new(0, 3.5, 0), stone, Enum.Material.Slate)
	else
		front = deco(model, "GraveObelisk", V3(1.3, 4, 1.3), tilt * CFrame.new(0, 2.5, 0), stone, Enum.Material.Slate)
		deco(
			model,
			"GraveObeliskCap",
			V3(0.9, 0.9, 0.9),
			tilt * CFrame.new(0, 4.7, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
			stone,
			Enum.Material.Slate
		)
	end
	-- Musgo na base.
	deco(
		model,
		"GraveMoss",
		V3(2.2, 0.08, 1.2),
		base * CFrame.new(0.3, 0.52, 0.1),
		rgb(52, 74, 44),
		Enum.Material.LeafyGrass
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 1
	gui.CanvasSize = Vector2.new(120, 140)
	gui.Parent = front
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, if kind == 2 then 0.3 else 0.6)
	label.Position = UDim2.fromScale(0, if kind == 2 then 0.05 else 0.15)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.SpecialElite
	label.TextColor3 = rgb(54, 52, 50)
	label.Parent = gui
end

local function yard(folder: Instance)
	-- Caminho de pedra da varanda até a saída da floresta, com meio-fio.
	deco(
		folder,
		"StonePath",
		V3(8, 0.06, 53.5),
		CFrame.new(0, 0.03, 104.75),
		rgb(98, 94, 88),
		Enum.Material.Cobblestone
	)
	for _, x in { -4.3, 4.3 } do
		deco(folder, "PathEdge", V3(0.6, 0.22, 53.5), CFrame.new(x, 0.11, 104.75), STONE, Enum.Material.Slate)
	end
	for _, spot in { V3(-11, 0, 84), V3(11, 0, 84), V3(-14, 0, 112), V3(14, 0, 112), V3(-14, 0, 124), V3(14, 0, 124) } do
		lampPost(folder, spot)
	end
	-- Abóboras: acesas ao longo do caminho, um grupinho em cada pilar da varanda.
	for _, z in { 82, 90 } do
		for _, x in { -6, 6 } do
			pumpkin(folder, V3(x, 0, z), 2.4, V3(-math.sign(x), 0, 0))
		end
	end
	for _, x in { -1, 1 } do
		pumpkin(folder, V3(x * 11.6, 0.12, 76.2), 2.2, Vector3.zAxis)
		pumpkin(folder, V3(x * 12.9, 0.12, 77), 1.4, nil)
	end
	-- Cemitério pequeno no jardim oeste, longe dos pavilhões e da trilha.
	local index = 0
	for row = 0, 2 do
		for col = 0, 1 do
			index += 1
			-- Lápides viradas para o caminho do jardim (leste), cada uma um pouco torta.
			grave(
				folder,
				V3(-101 + col * 6, 0, 56 + row * 8),
				-90 + (index * 7) % 15 - 7,
				(index % 3) + 1,
				GRAVE_TEXT[index]
			)
		end
	end
	lampPost(folder, V3(-89, 0, 62))
end

-- Esconde a casca e o telhado no final em ruínas (o jardim continua) e devolve tudo como era.
local function ruins(root: Instance, shellFolder: Instance, on: boolean)
	local estate = root:FindFirstChild("GeneratedEstate")
	hide(shellFolder, on)
	hide(estate and estate:FindFirstChild("RoofDress"), on)
end

function Exterior.build(root: Instance)
	local shellFolder = Build.folder(root, "ExteriorShell")
	local yardFolder = Build.folder(root, "ExteriorYard")
	shell(shellFolder)
	windows(shellFolder)
	entrance(shellFolder, yardFolder)
	boundary(root, yardFolder)
	yard(yardFolder)
	dressEstate(root)
	pbr(shellFolder)
	pbr(yardFolder)
	pbr(root:FindFirstChild("ProgressionBarriers"))
	pbr(root:FindFirstChild("GatePillars"))
	root.ChildAdded:Connect(function(child)
		if child.Name == "GeneratedEstate" then
			-- O nível monta o GeneratedEstate inteiro na mesma execução; vestir depois que terminar.
			task.defer(dressEstate, root)
		elseif child.Name == "Ruins" then
			ruins(root, shellFolder, true)
		end
	end)
	root.ChildRemoved:Connect(function(child)
		if child.Name == "Ruins" then
			ruins(root, shellFolder, false)
		end
	end)
end

return Exterior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="495">
          <Properties>
            <string name="Name">HouseFinish</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Acabamento arquitetônico da mansão (só visual), montado depois do HouseScenery:
	- forros e sancas no corredor e no hall, passadeiras, lambris com almofadas e rodapés;
	- almofadas e maçanetas nas portas (soldadas ao painel, que continua sendo o mesmo objeto interativo);
	- guarda-corpos maciços vestidos com almofadas e pilares.
	Móveis e luminárias com modelos 3D ficam em HouseProps; materiais PBR em HouseMaterials.

	Regras: nada colide, nada recebe raycast, nada fica entre a porta de entrada, o corredor e as escadas.
	Planta, tamanhos e nomes da arquitetura não mudam (HouseLayout/HouseCatalog continuam a referência).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Layout = require("@game/ReplicatedStorage/Shared/Game/HouseLayout")
local Build = require("./Build")

local Finish = {}

local V3 = Vector3.new
local rgb = Color3.fromRGB
local UP = Vector3.yAxis

local CEILING = rgb(146, 136, 121)
local WOOD = rgb(70, 45, 32)
local WOOD_LIGHT = rgb(92, 61, 42)
local TRIM = rgb(150, 122, 86)
local BRASS = rgb(168, 132, 70)
local RUNNER = rgb(92, 30, 34)
local RUNNER_EDGE = rgb(40, 18, 20)

local function deco(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	detail: boolean?
): BasePart
	local part = Build.part(parent, name, size, cframe, color, {
		material = material or Enum.Material.Wood,
		collide = false,
		query = false,
	})
	part.CanTouch = false
	if detail then
		part:SetAttribute("VisualDetail", true)
	end
	return part
end

-- Faixa ao longo de uma parede: `from`/`to` no pé da parede, `normal` aponta para dentro do cômodo.
local function wallRun(parent: Instance, from: Vector3, to: Vector3, normal: Vector3, panels: boolean)
	local span = to - from
	local length = span.Magnitude
	local along = span.Unit
	local middle = (from + to) / 2
	local function strip(name: string, bottom: number, height: number, depth: number, out: number, color: Color3)
		local center = middle + UP * (bottom + height / 2) + normal * (out + depth / 2)
		return deco(parent, name, V3(length, height, depth), CFrame.fromMatrix(center, along, UP), color)
	end
	strip("FinishWainscot", 0, 3.6, 0.1, 0, WOOD)
	strip("FinishSkirting", 0, 0.8, 0.12, 0.1, WOOD:Lerp(rgb(0, 0, 0), 0.25))
	strip("FinishChairRail", 3.5, 0.22, 0.2, 0.1, TRIM)
	if not panels then
		return
	end
	local count = math.max(1, math.floor(length / 3.4))
	local step = length / count
	for index = 1, count do
		local center = from + along * (step * (index - 0.5)) + UP * 2.2 + normal * 0.13
		deco(
			parent,
			"FinishPanel",
			V3(step - 0.6, 2.2, 0.06),
			CFrame.fromMatrix(center, along, UP),
			WOOD_LIGHT,
			nil,
			true
		)
	end
end

-- Porta vitoriana 3D (Assets/MansionProps/MansionDoor) envolvendo o painel; soldada, acompanha a animação.
-- O painel continua sendo a peça de colisão, prompt, som e PathfindingModifier.
local function doorModel(panel: BasePart): boolean
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local library = assets and assets:FindFirstChild("MansionProps")
	local template = library and library:FindFirstChild("MansionDoor")
	if not template or not template:IsA("Model") then
		return false
	end
	local model = template:Clone()
	-- Malha: largura em X, espessura em Z. Painel: largura em Z, espessura em X. Centros alinhados.
	model:PivotTo(panel.CFrame * CFrame.Angles(0, -math.pi / 2, 0))
	local box = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + (panel.Position - box.Position))
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored, part.Massless = false, true
			part.CanCollide, part.CanQuery, part.CanTouch = false, false, false
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = panel, part, part
		end
	end
	model.Parent = panel
	return true
end

-- Painéis em relevo e maçanetas nas duas faces; soldados ao painel, acompanham a animação da porta.
local function dressDoor(panel: BasePart)
	if doorModel(panel) then
		return
	end
	local function attach(
		name: string,
		size: Vector3,
		offset: CFrame,
		color: Color3,
		material: Enum.Material,
		shape: Enum.PartType?
	)
		local part = deco(panel, name, size, panel.CFrame * offset, color, material, true)
		if shape then
			(part :: Part).Shape = shape
		end
		part.Anchored, part.Massless = false, true
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = panel, part, part
	end
	local half = panel.Size.X / 2
	for _, side in { -1, 1 } do
		attach(
			"DoorPanelUpper",
			V3(0.06, 3.4, panel.Size.Z - 2),
			CFrame.new(side * (half + 0.03), 2.6, 0),
			WOOD_LIGHT,
			Enum.Material.Wood
		)
		attach(
			"DoorPanelLower",
			V3(0.06, 4.6, panel.Size.Z - 2),
			CFrame.new(side * (half + 0.03), -2.3, 0),
			WOOD_LIGHT,
			Enum.Material.Wood
		)
		attach(
			"DoorKnob",
			V3(0.42, 0.42, 0.42),
			CFrame.new(side * (half + 0.22), -0.4, panel.Size.Z / 2 - 0.9),
			BRASS,
			Enum.Material.Metal,
			Enum.PartType.Ball
		)
	end
end

-- Guarda-corpo maciço dos vãos: almofadas nas duas faces e pilares nas pontas (a peça de colisão fica igual).
local function dressGuard(parent: Instance, guard: BasePart)
	local size, cf = guard.Size, guard.CFrame
	local count = math.max(1, math.floor(size.Z / 3.6))
	local step = size.Z / count
	for _, side in { -1, 1 } do
		for index = 1, count do
			local z = -size.Z / 2 + step * (index - 0.5)
			deco(
				parent,
				"GuardPanel",
				V3(0.05, size.Y - 1.2, step - 0.6),
				cf * CFrame.new(side * (size.X / 2 + 0.025), -0.1, z),
				WOOD_LIGHT,
				nil,
				true
			)
		end
	end
	for _, z in { -size.Z / 2, size.Z / 2 } do
		deco(parent, "GuardNewel", V3(0.8, size.Y + 0.8, 0.8), cf * CFrame.new(0, 0.4, z), WOOD)
		deco(parent, "GuardNewelCap", V3(1, 0.3, 1), cf * CFrame.new(0, size.Y / 2 + 0.95, z), TRIM)
	end
end

local function runner(parent: Instance, name: string, center: Vector3, length: number)
	deco(
		parent,
		name .. "Edge",
		V3(7, 0.05, length + 1),
		CFrame.new(center + UP * 0.025),
		RUNNER_EDGE,
		Enum.Material.Fabric
	)
	deco(parent, name, V3(5.8, 0.07, length), CFrame.new(center + UP * 0.035), RUNNER, Enum.Material.Fabric)
end

local function corridor(parent: Instance, y: number)
	local length = 96.5
	local centerZ = -36.25
	deco(
		parent,
		"CorridorCeilingPanel",
		V3(15, 0.1, length),
		CFrame.new(0, y + 14.94, centerZ),
		CEILING,
		Enum.Material.Plaster
	)
	for _, side in { -1, 1 } do
		deco(parent, "CorridorCrown", V3(0.3, 0.45, length), CFrame.new(side * 7.32, y + 14.6, centerZ), TRIM)
	end
	if y >= 0 then
		runner(parent, "CorridorRunner", V3(0, y, -36), 93)
	end
end

local function foyerCeiling(parent: Instance, y: number)
	local above: { Layout.Rect } = if y >= 32 then { table.clone(Layout.Bounds) } else Layout.decks(y + 16)
	for _, rect in above do
		local size = V3(rect.x1 - rect.x0 - 1, 0.1, rect.z1 - rect.z0 - 1)
		local center = V3((rect.x0 + rect.x1) / 2, y + 14.94, (rect.z0 + rect.z1) / 2)
		deco(parent, "FoyerCeilingPanel", size, CFrame.new(center), CEILING, Enum.Material.Plaster)
	end
	-- Medalhão de gesso onde pende o lustre.
	local medallion = deco(
		parent,
		"FinishMedallion",
		V3(0.12, 3.6, 3.6),
		CFrame.new(0, y + 14.83, 40),
		CEILING,
		Enum.Material.Plaster
	)
	medallion.CFrame *= CFrame.Angles(0, 0, math.rad(90))
	local disc = medallion :: Part
	disc.Shape = Enum.PartType.Cylinder
end

local function foyerWalls(parent: Instance, y: number)
	local ground = y == 0
	local b = Layout.Bounds
	local west, east, front = b.x0 + 0.5, b.x1 - 0.5, b.z1 - 0.5
	-- Parede da frente (entrada só no térreo) e laterais da caixa da escada.
	if ground then
		wallRun(parent, V3(west, y, front), V3(-6.3, y, front), -Vector3.zAxis, true)
		wallRun(parent, V3(6.3, y, front), V3(east, y, front), -Vector3.zAxis, true)
	else
		wallRun(parent, V3(west, y, front), V3(east, y, front), -Vector3.zAxis, false)
	end
	wallRun(parent, V3(west, y, b.z0 + 0.5), V3(west, y, front), Vector3.xAxis, ground)
	wallRun(parent, V3(east, y, b.z0 + 0.5), V3(east, y, front), -Vector3.xAxis, ground)
	-- Fundo do hall: frente dos cômodos (abaixo das janelas), dos dois lados do corredor.
	wallRun(parent, V3(west, y, 12.5), V3(-8.5, y, 12.5), Vector3.zAxis, ground)
	wallRun(parent, V3(8.5, y, 12.5), V3(east, y, 12.5), Vector3.zAxis, ground)
	if y > 0 then
		runner(parent, "HallRunner", V3(0, y, 37), 45)
	end
end

--[[
	Escada bloqueada pela missão: o volume de colisão (HouseAccess, "upstairs") continua o mesmo, só fica
	invisível. Nas duas pontas de cada lance entra uma barricada de tábuas pregadas com placa; ela aparece
	enquanto o volume colide e some junto quando a missão libera a escada.
]]
local BOARDS = rgb(118, 94, 72)

local function barricade(parent: Instance, base: Vector3, facing: Vector3, width: number): { BasePart }
	local items: { BasePart } = {}
	local frame = CFrame.lookAt(base, base + facing)
	local function board(name: string, size: Vector3, offset: CFrame, color: Color3)
		table.insert(items, deco(parent, name, size, frame * offset, color, Enum.Material.WoodPlanks))
	end
	for _, side in { -1, 1 } do
		board("BarricadePost", V3(0.6, 7.4, 0.6), CFrame.new(side * (width / 2 - 0.3), 3.7, 0), WOOD)
	end
	for index, y in { 1.4, 3.1, 4.9, 6.5 } do
		local tilt = math.rad(if index % 2 == 0 then 7 else -5)
		board("BarricadeBoard", V3(width + 1.2, 0.85, 0.22), CFrame.new(0, y, -0.4) * CFrame.Angles(0, 0, tilt), BOARDS)
	end
	-- X de tábuas por cima: lê como "interditado" de longe.
	for _, angle in { 38, -38 } do
		board(
			"BarricadeBoard",
			V3(math.sqrt(width * width + 36), 0.8, 0.22),
			CFrame.new(0, 3.8, -0.65) * CFrame.Angles(0, 0, math.rad(angle)),
			BOARDS:Lerp(WOOD, 0.3)
		)
	end
	local sign = Build.sign(
		parent,
		"BarricadeSign",
		(frame * CFrame.new(0, 5.6, -0.85)).Position,
		facing,
		Vector2.new(4.4, 1.1),
		"INTERDITADO",
		{
			textColor = rgb(232, 214, 180),
			background = rgb(70, 26, 22),
			font = Enum.Font.SpecialElite,
		}
	)
	sign.CanCollide, sign.CanQuery, sign.CanTouch = false, false, false
	table.insert(items, sign)
	return items
end

local function stairBarriers(root: Instance, folder: Instance)
	local barriers = root:FindFirstChild("ProgressionBarriers")
	local architecture = root:FindFirstChild("Architecture")
	if not barriers or not architecture then
		return
	end
	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Include
	rays.FilterDescendantsInstances = { architecture }
	for _, part in barriers:GetChildren() do
		if not part:IsA("BasePart") or part.Name ~= "upstairs" then
			continue
		end
		local items: { BasePart } = {}
		for _, side in { -1, 1 } do
			local z = part.Position.Z + side * (part.Size.Z / 2 - 0.4)
			local top = part.Position.Y + part.Size.Y / 2
			local hit = workspace:Raycast(V3(part.Position.X, top, z), V3(0, -(part.Size.Y + 2), 0), rays)
			local floor = if hit then hit.Position.Y else part.Position.Y - part.Size.Y / 2
			for _, item in barricade(folder, V3(part.Position.X, floor, z), V3(0, 0, side), part.Size.X - 0.6) do
				table.insert(items, item)
			end
		end
		local function sync()
			if part.Transparency ~= 1 then
				part.Transparency = 1
			end
			for _, item in items do
				item.Transparency = if part.CanCollide then 0 else 1
				local gui = item:FindFirstChildWhichIsA("SurfaceGui")
				if gui then
					gui.Enabled = part.CanCollide
				end
			end
		end
		part:GetPropertyChangedSignal("CanCollide"):Connect(sync)
		part:GetPropertyChangedSignal("Transparency"):Connect(sync)
		sync()
	end
end

function Finish.build(root: Instance)
	local old = root:FindFirstChild("Finish")
	if old then
		old:Destroy()
	end
	local folder = Build.folder(root, "Finish")
	for _, y in Layout.Floors do
		corridor(folder, y)
		foyerCeiling(folder, y)
		if y >= 0 then
			foyerWalls(folder, y)
		end
	end
	-- Forro dos cômodos logo abaixo do teto (o piso de cima e o teto antigo coincidem e piscam).
	-- Os cômodos do 1º andar no fundo (z = -68) ficam sem forro: a escada de serviço pode abrir esse teto.
	for _, y in Layout.Floors do
		for _, side in { -1, 1 } do
			for row = 1, 3 do
				local z = 28 - row * 32
				if not (y == 16 and z == -68) then
					deco(
						folder,
						"RoomCeilingPanel",
						V3(35, 0.1, 31),
						CFrame.new(side * 26, y + 14.94, z),
						CEILING,
						Enum.Material.Plaster
					)
				end
			end
		end
	end
	-- Entrada: passadeira até o corredor e capacho.
	runner(folder, "HallRunner", V3(0, 0, 37.5), 47)
	deco(folder, "HallDoormat", V3(8, 0.09, 2.6), CFrame.new(0, 0.045, 62), rgb(66, 54, 40), Enum.Material.Fabric)
	-- Final em ruínas (WorldService.houseRuins): tetos e fachadas somem; forros e revestimentos acompanham.
	local OPEN_IN_RUINS = {
		CorridorCeilingPanel = true,
		FoyerCeilingPanel = true,
		RoomCeilingPanel = true,
		FinishMedallion = true,
		WallpaperSkin = true,
	}
	local function ruins(on: boolean)
		for _, part in folder:GetDescendants() do
			if part:IsA("BasePart") and OPEN_IN_RUINS[part.Name] then
				part.Transparency = if on then 1 else 0
			end
		end
	end
	root.ChildAdded:Connect(function(child)
		if child.Name == "Ruins" then
			ruins(true)
		end
	end)
	root.ChildRemoved:Connect(function(child)
		if child.Name == "Ruins" then
			ruins(false)
		end
	end)
	local architecture = root:FindFirstChild("Architecture")
	if architecture then
		for _, part in architecture:GetChildren() do
			if part:IsA("BasePart") and part.Name == "LandingGuard" then
				dressGuard(folder, part)
			end
		end
	end
	local doors = root:FindFirstChild("Doors")
	if doors then
		for _, panel in doors:GetChildren() do
			if panel:IsA("BasePart") and string.sub(panel.Name, 1, 11) == "house_door_" then
				dressDoor(panel)
			end
		end
	end
	stairBarriers(root, folder)
end

return Finish
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="496">
          <Properties>
            <string name="Name">HouseFurniture</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Móveis temáticos por cômodo (só visual). Tudo encostado nas paredes externas/frontal do cômodo,
	longe da porta (lado do corredor) e do armário de esconder, sem colisão e invisível para raycasts:
	não muda rotas do Tung Tung, prompts nem testes de navegação.

	Sistema local de cada cômodo: `out` aponta para a fachada (parede externa), `z` cresce para a frente.
]]

local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Build = require("./Build")

local Furniture = {}

local rgb = Color3.fromRGB
local WOOD = rgb(140, 92, 58)
local WOOD_DARK = rgb(96, 62, 42)
local FABRIC = { rgb(170, 60, 90), rgb(60, 110, 170), rgb(80, 150, 100), rgb(150, 90, 180) }

type Place = (name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material?) -> BasePart

local function placer(parent: Instance, room: House.Room): Place
	local side = if room.x < 0 then -1 else 1
	local floor = room.y - 0.5
	return function(name, size, offset, color, material)
		-- offset.X: distância a partir do centro rumo à fachada; offset.Y: altura da base; offset.Z: frente/trás.
		local center = Vector3.new(room.x + side * offset.X, floor + offset.Y + size.Y / 2, room.z + offset.Z)
		local part = Build.part(parent, name, size, CFrame.new(center), color, {
			material = material or (if string.find(name, "Pillow") or string.find(name, "Cover")
				then Enum.Material.Fabric
				elseif string.find(name, "Lamp") or string.find(name, "Handle") then Enum.Material.Metal
				else Enum.Material.Wood),
			collide = false,
			query = false,
		})
		part.CanTouch = false
		return part
	end
end

local function lampStand(put: Place, x: number, z: number, color: Color3)
	put("LampPole", Vector3.new(0.3, 5, 0.3), Vector3.new(x, 0, z), rgb(60, 50, 70), Enum.Material.Metal)
	local shade = put(
		"LampShade",
		Vector3.new(1.8, 1.4, 1.8),
		Vector3.new(x, 5, z),
		color:Lerp(rgb(224, 197, 150), 0.65),
		Enum.Material.Fabric
	)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 16
	light.Brightness = 0.6
	light.Parent = shade
end

local function sofa(put: Place, x: number, z: number, color: Color3)
	put("SofaSeat", Vector3.new(3, 1.4, 8), Vector3.new(x, 0, z), color, Enum.Material.Fabric)
	put("SofaBack", Vector3.new(1, 3, 8), Vector3.new(x + 1.5, 0, z), color, Enum.Material.Fabric)
	for _, dz in { -4.2, 4.2 } do
		put(
			"SofaArm",
			Vector3.new(3, 2.2, 0.8),
			Vector3.new(x, 0, z + dz),
			color:Lerp(rgb(0, 0, 0), 0.15),
			Enum.Material.Fabric
		)
	end
end

local function shelf(put: Place, x: number, z: number, length: number)
	put("Shelf", Vector3.new(1.4, 8, length), Vector3.new(x, 0, z), WOOD_DARK, Enum.Material.Wood)
	local rng = Random.new(math.floor(x * 31 + z * 7))
	for row = 0, 2 do
		local cursor = -length / 2 + 0.4
		while cursor < length / 2 - 0.6 do
			local width = rng:NextNumber(0.4, 0.8)
			local height = rng:NextNumber(1.3, 2)
			put(
				"Book",
				Vector3.new(1, height, width),
				Vector3.new(x - 0.3, 0.6 + row * 2.5, z + cursor + width / 2),
				FABRIC[rng:NextInteger(1, #FABRIC)],
				Enum.Material.SmoothPlastic
			)
			cursor += width + 0.05
		end
	end
end

local function crate(put: Place, x: number, z: number, size: number, y: number?)
	put("Crate", Vector3.new(size, size, size), Vector3.new(x, y or 0, z), rgb(160, 120, 70), Enum.Material.WoodPlanks)
end

local function candle(put: Place, x: number, z: number, y: number?)
	local base = y or 0
	put("Candle", Vector3.new(0.4, 1.2, 0.4), Vector3.new(x, base, z), rgb(250, 240, 220))
	local flame =
		put("Flame", Vector3.new(0.25, 0.4, 0.25), Vector3.new(x, base + 1.2, z), rgb(255, 180, 60), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 170, 80)
	light.Range = 8
	light.Brightness = 0.7
	light.Parent = flame
end

local function plant(put: Place, x: number, z: number)
	put("Pot", Vector3.new(1.6, 1.4, 1.6), Vector3.new(x, 0, z), rgb(190, 100, 70), Enum.Material.Brick)
	local leaves =
		put("Leaves", Vector3.new(2.6, 2.6, 2.6), Vector3.new(x, 1.2, z), rgb(70, 150, 80), Enum.Material.Grass)
	local shape = leaves :: Part
	shape.Shape = Enum.PartType.Ball
end

-- Cada conjunto ocupa a faixa junto à fachada (x 12..17) e a parede da frente (z 10..15),
-- deixando livres a porta (x -18..-12) e o armário (x 9..13, z 5..9).
local SETS: { [string]: (put: Place, color: Color3) -> () } = {
	Living = function(put, color)
		sofa(put, 15, -6, color)
		put("Fireplace", Vector3.new(2, 6, 7), Vector3.new(16.5, 0, 3), rgb(150, 70, 60), Enum.Material.Brick)
		local fire =
			put("Fire", Vector3.new(1, 1.6, 3.6), Vector3.new(15.8, 0.4, 3), rgb(255, 140, 40), Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Color = rgb(255, 150, 70)
		light.Range = 18
		light.Brightness = 1
		light.Parent = fire
		lampStand(put, 15, -12, rgb(255, 220, 150))
		plant(put, -2, 14)
	end,
	Kitchen = function(put)
		put("Counter", Vector3.new(3, 3.4, 14), Vector3.new(15.5, 0, -4), rgb(230, 225, 240), Enum.Material.Marble)
		put("Stove", Vector3.new(3, 3.6, 4), Vector3.new(15.5, 0, 5), rgb(60, 60, 70), Enum.Material.Metal)
		put(
			"Fridge",
			Vector3.new(3, 7.5, 3.4),
			Vector3.new(15.5, 0, -13.5),
			rgb(200, 236, 230),
			Enum.Material.SmoothPlastic
		)
		put("Pot", Vector3.new(1.4, 1, 1.4), Vector3.new(15.5, 3.6, 5), rgb(180, 60, 50), Enum.Material.Metal)
		put("Fruit", Vector3.new(0.8, 0.8, 0.8), Vector3.new(15.2, 3.4, -6), rgb(255, 80, 60))
		put("Fruit", Vector3.new(0.8, 0.8, 0.8), Vector3.new(15.6, 3.4, -5), rgb(255, 210, 60))
	end,
	Dining = function(put, color)
		put("DiningTable", Vector3.new(5, 3, 12), Vector3.new(13, 0, -1), WOOD, Enum.Material.Wood)
		for _, dz in { -4, 0, 4 } do
			put("Chair", Vector3.new(1.6, 2, 1.6), Vector3.new(16.2, 0, -1 + dz), color, Enum.Material.Fabric)
			put("ChairBack", Vector3.new(0.4, 2.4, 1.6), Vector3.new(17, 2, -1 + dz), WOOD_DARK, Enum.Material.Wood)
		end
		candle(put, 13, -3, 3)
		candle(put, 13, 1, 3)
	end,
	Bath = function(put)
		put("Tub", Vector3.new(4, 2.4, 8), Vector3.new(15, 0, -6), rgb(240, 245, 255), Enum.Material.SmoothPlastic)
		put("Water", Vector3.new(3.2, 0.2, 7), Vector3.new(15, 2, -6), rgb(110, 200, 255), Enum.Material.Glass)
		put("Sink", Vector3.new(2.4, 3, 2.4), Vector3.new(16, 0, 5), rgb(240, 245, 255), Enum.Material.SmoothPlastic)
		put("Mirror", Vector3.new(0.2, 3, 2.4), Vector3.new(17.4, 4.5, 5), rgb(200, 230, 255), Enum.Material.Glass)
		put("Duck", Vector3.new(0.8, 0.8, 0.8), Vector3.new(14.8, 2.2, -8), rgb(255, 220, 40))
	end,
	Library = function(put)
		shelf(put, 16.5, -6, 12)
		shelf(put, 16.5, 4, 6)
		put("ReadingChair", Vector3.new(3, 2.6, 3), Vector3.new(13, 0, -14), rgb(120, 50, 70), Enum.Material.Fabric)
		lampStand(put, 16, 13, rgb(180, 220, 255))
	end,
	Machine = function(put)
		for index = 0, 2 do
			put(
				"Machine",
				Vector3.new(3, 5, 4),
				Vector3.new(15.5, 0, -10 + index * 6),
				rgb(90, 100, 120),
				Enum.Material.DiamondPlate
			)
			put(
				"Gauge",
				Vector3.new(0.3, 0.9, 0.9),
				Vector3.new(14, 3.4, -10 + index * 6),
				rgb(120, 255, 140),
				Enum.Material.Neon
			)
		end
		put("Pipe", Vector3.new(1, 1, 30), Vector3.new(16.8, 9, 0), rgb(150, 110, 80), Enum.Material.Metal)
	end,
	Bedroom = function(put, color)
		put("Wardrobe", Vector3.new(2.6, 8, 5), Vector3.new(16, 0, 13), WOOD, Enum.Material.Wood)
		put("Nightstand", Vector3.new(2, 2.4, 2), Vector3.new(16, 0, -14), WOOD_DARK, Enum.Material.Wood)
		lampStand(put, 16, -14, color)
	end,
	Child = function(put, color)
		for index = 0, 4 do
			put(
				"ToyBlock",
				Vector3.new(1.4, 1.4, 1.4),
				Vector3.new(14 + index % 2, math.floor(index / 2) * 1.4, -12 + index),
				FABRIC[(index % #FABRIC) + 1]
			)
		end
		local ballPart = put("ToyBall", Vector3.new(2, 2, 2), Vector3.new(4, 0, 13), rgb(255, 90, 90))
		local shape = ballPart :: Part
		shape.Shape = Enum.PartType.Ball
		put("TeddyBody", Vector3.new(1.8, 2, 1.4), Vector3.new(16, 0, 2), rgb(170, 110, 70), Enum.Material.Fabric)
		put("TeddyHead", Vector3.new(1.4, 1.4, 1.2), Vector3.new(16, 2, 2), rgb(180, 120, 80), Enum.Material.Fabric)
		put("Rocking", Vector3.new(3, 2.4, 1.2), Vector3.new(15, 0, 13), color, Enum.Material.Wood)
	end,
	Office = function(put)
		put("Desk", Vector3.new(4, 3, 9), Vector3.new(14.5, 0, -4), WOOD, Enum.Material.Wood)
		put("Paper", Vector3.new(1.4, 0.05, 1.8), Vector3.new(14, 3, -6), rgb(250, 246, 230))
		put("OfficeChair", Vector3.new(2.2, 2.2, 2.2), Vector3.new(11, 0, -4), rgb(50, 50, 60), Enum.Material.Fabric)
		lampStand(put, 16, 5, rgb(255, 230, 170))
		shelf(put, 16.5, 12, 5)
	end,
	Locked = function(put)
		for index = 0, 3 do
			crate(put, 15, -12 + index * 4, 2.6)
		end
		put("Chains", Vector3.new(0.4, 6, 0.4), Vector3.new(16, 3, 6), rgb(120, 120, 130), Enum.Material.Metal)
	end,
	Attic = function(put)
		crate(put, 15, -10, 3)
		crate(put, 15, -10, 2, 3)
		crate(put, 15.5, 12, 3)
		put("Trunk", Vector3.new(3, 2.4, 5), Vector3.new(15, 0, 0), rgb(110, 60, 50), Enum.Material.Wood)
	end,
	Basement = function(put)
		for index = 0, 2 do
			local barrel = put(
				"Barrel",
				Vector3.new(3.2, 3.2, 3.2),
				Vector3.new(15, 0, -12 + index * 4),
				rgb(120, 80, 50),
				Enum.Material.Wood
			)
			barrel.CFrame = barrel.CFrame * CFrame.Angles(0, 0, math.rad(90))
			local shape = barrel :: Part
			shape.Shape = Enum.PartType.Cylinder
		end
		crate(put, 15, 13, 3)
	end,
	Ritual = function(put)
		for index = 0, 7 do
			local angle = (index + 0.5) / 8 * math.pi * 2
			candle(put, 0 + math.cos(angle) * 8.5, math.sin(angle) * 8.5)
		end
	end,
}
SETS.AtticClock = SETS.Attic
SETS.AtticBook = SETS.Library
SETS.AtticPhoto = SETS.Attic
SETS.Symbols = SETS.Basement
SETS.Safe = SETS.Locked
SETS.Tunnel = SETS.Basement
SETS.Mechanism = SETS.Machine

function Furniture.build(parent: Instance)
	local folder = Build.folder(parent, "Furniture")
	for index, room in House.Rooms do
		local set = SETS[room.id]
		if set then
			set(placer(folder, room), FABRIC[(index % #FABRIC) + 1])
		end
	end
end

return Furniture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="497">
          <Properties>
            <string name="Name">HouseGround</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Chão PBR e mato alto do jardim e da floresta (lote 6 do ambiente). Só visual:
	- grama, terra batida e areia com texturas Poly Haven (MaterialVariant) nas peças de chão existentes;
	- touceiras 3D de mato (cartões com transparência) em manchas, nunca em caminhos, pisos ou construções.
	O mato não colide, não recebe raycast nem toque e tem o atributo VisualDetail: o WorldFxController
	esconde o que está longe conforme a qualidade escolhida (48/90/145 studs), então pesa pouco no celular.
	A floresta dos capítulos 6–8 é refeita a cada capítulo; o chão dela é vestido de novo quando aparece.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Build = require("./Build")

local Ground = {}

local V3 = Vector3.new
local rgb = Color3.fromRGB
local SEED = 66021

type Skin = { variant: string, material: Enum.Material, color: Color3 }

-- Com textura, Color só tinge: valores claros mantêm o detalhe do Poly Haven à noite.
local LAWN: Skin = { variant = "GardenLawn", material = Enum.Material.Grass, color = rgb(168, 176, 158) }
local FOREST: Skin = { variant = "ForestFloor", material = Enum.Material.Grass, color = rgb(150, 150, 140) }
local DIRT: Skin = { variant = "DirtTrail", material = Enum.Material.Ground, color = rgb(178, 168, 158) }
local SAND: Skin = { variant = "SandPath", material = Enum.Material.Sand, color = rgb(186, 176, 160) }

local function skin(part: BasePart, look: Skin)
	part.Material = look.material
	part.MaterialVariant = look.variant
	part.Color = look.color
end

local LAWN_PARTS = {
	Garden = true,
	SideGarden = true,
	BackGarden = true,
	FrontCourtGround = true,
	ExitGround = true,
	EstateGround = true,
	EstateSoil = true,
}

--[[ Mato ]]

local GRASS = { "TallGrassClump", "TallGrassA", "TallGrassB", "TallGrassA" }

local function library(): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	return assets and assets:FindFirstChild("MansionProps")
end

local function tuft(folder: Instance, source: Instance, name: string, at: Vector3, scale: number, yaw: number)
	local template = source:FindFirstChild(name)
	if not template or not template:IsA("Model") then
		return
	end
	local model = template:Clone()
	model:ScaleTo(model:GetScale() * scale)
	model:PivotTo(CFrame.new(at) * CFrame.Angles(0, yaw, 0))
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
			part.CastShadow = false
			part:SetAttribute("VisualDetail", true)
		end
	end
	model.Parent = folder
end

-- Manchas de mato: algumas touceiras juntas parecem natural; espalhar uma por uma parece plantado.
local function patches(
	folder: Instance,
	rng: Random,
	count: number,
	pick: (Random) -> Vector3?,
	blocked: (number, number) -> boolean,
	y: number
)
	local source = library()
	if not source then
		return
	end
	for _ = 1, count do
		local center = pick(rng)
		if not center then
			continue
		end
		for index = 1, rng:NextInteger(3, 6) do
			local angle = rng:NextNumber(0, math.pi * 2)
			local radius = rng:NextNumber(0, 3.4)
			local x, z = center.X + math.cos(angle) * radius, center.Z + math.sin(angle) * radius
			if not blocked(x, z) then
				local name = GRASS[(index + rng:NextInteger(0, 3)) % #GRASS + 1]
				tuft(folder, source, name, V3(x, y, z), rng:NextNumber(1.7, 2.9), rng:NextNumber(0, math.pi * 2))
			end
		end
	end
end

local function rect(x: number, z: number, x0: number, x1: number, z0: number, z1: number): boolean
	return x > x0 and x < x1 and z > z0 and z < z1
end

-- Jardim: nada sobre a casa, varanda, caminhos, pátio, pavilhões, mirante ou túmulos.
local function gardenBlocked(x: number, z: number): boolean
	local ax = math.abs(x)
	return rect(x, z, -47, 48, -88, 79) -- casa, varanda e degrau
		or (ax < 7 and z > 60) -- caminho de pedra até a floresta
		or (ax < 80 and z > 70 and z < 82) -- passeio da frente e cerca
		or (ax > 51 and ax < 65) -- passeio lateral
		or rect(ax, z, 59, 93, 7, 41) -- pavilhões
		or rect(ax, z, 59, 93, -61, -27)
		or rect(ax, z, 83, 105, -5, 51) -- mirante e escada (o lado muda com o nível)
		or rect(ax, z, -1, 55, -119, -85) -- pátio dos fundos
		or rect(x, z, -104, -91, 50, 74) -- lápides
		or ax > 105 -- muro
		or z < -116
		or z > 130
end

local GARDEN_AREAS = {
	{ -104, -66, -112, 76 }, -- jardim oeste
	{ 66, 104, -112, 76 }, -- jardim leste
	{ -104, -48, 83, 96 }, -- pátio da frente, junto ao muro
	{ 48, 104, 83, 96 },
	{ -46, -9, 83, 96 },
	{ 9, 46, 83, 96 },
	{ -104, -56, -114, -88 }, -- fundos
	{ 56, 104, -114, -88 },
	{ -104, -12, 100, 128 }, -- saída para a floresta
	{ 12, 104, 100, 128 },
}

local function garden(root: Instance)
	local folder = Build.folder(root, "GardenGrass")
	local rng = Random.new(SEED)
	local total = 0
	for _, area in GARDEN_AREAS do
		total += (area[2] - area[1]) * (area[4] - area[3])
	end
	-- Uma mancha a cada ~170 studs² de gramado livre.
	for _, area in GARDEN_AREAS do
		local share = (area[2] - area[1]) * (area[4] - area[3]) / total
		patches(folder, rng, math.max(2, math.floor(share * 30 + 0.5)), function(r: Random): Vector3?
			local x, z = r:NextNumber(area[1], area[2]), r:NextNumber(area[3], area[4])
			return if gardenBlocked(x, z) then nil else V3(x, 0, z)
		end, gardenBlocked, 0)
	end
end

--[[
	Terrain com a grama 3D do Roblox (Terrain.Decoration, ligada no place por places/world/Workspace/Terrain.model.json).
	O topo fica 0,1 stud acima do chão de peças: a colisão das peças continua igual, e o motor desenha
	e otimiza os tufos (somem sozinhos em qualidade gráfica baixa). Caminhos e pisos viram terreno do material certo.
]]
local TOP = 0.1
local DEPTH = 4

local function fill(t: Terrain, x0: number, x1: number, z0: number, z1: number, material: Enum.Material)
	t:FillBlock(CFrame.new((x0 + x1) / 2, TOP - DEPTH / 2, (z0 + z1) / 2), V3(x1 - x0, DEPTH, z1 - z0), material)
end

local function terrainColors(t: Terrain)
	t:SetMaterialColor(Enum.Material.Grass, rgb(84, 110, 62))
	t:SetMaterialColor(Enum.Material.LeafyGrass, rgb(70, 96, 54))
	t:SetMaterialColor(Enum.Material.Ground, rgb(96, 78, 58))
	t:SetMaterialColor(Enum.Material.Sand, rgb(150, 132, 104))
	t:SetMaterialColor(Enum.Material.Cobblestone, rgb(112, 108, 100))
	t:SetMaterialColor(Enum.Material.Slate, rgb(100, 98, 96))
end

local function lawnTerrain()
	local t = workspace.Terrain
	terrainColors(t)
	local far = 200
	-- Tudo fora da casa (com 1 stud de folga das paredes, para o terreno nunca vazar para o porão).
	fill(t, -far, far, 65.5, far, Enum.Material.Grass)
	fill(t, -far, far, -far, -86.5, Enum.Material.Grass)
	fill(t, -far, -45.5, -86.5, 65.5, Enum.Material.Grass)
	fill(t, 46.5, far, -86.5, 65.5, Enum.Material.Grass)
	fill(t, -45.5, -25.5, 13.5, 65.5, Enum.Material.Grass)
	-- Manchas de grama mais escura e folhosa quebram a repetição do gramado.
	local rng = Random.new(SEED + 7)
	for _ = 1, 26 do
		local x, z = rng:NextNumber(-100, 100), rng:NextNumber(-112, 126)
		if not gardenBlocked(x, z) then
			local r = rng:NextNumber(4, 9)
			fill(t, x - r, x + r, z - r * 0.7, z + r * 0.7, Enum.Material.LeafyGrass)
		end
	end
	-- Pisos do jardim (mesmas medidas do HouseLevelBuilder e do caminho da HouseExterior).
	for _, side in { -1, 1 } do
		fill(t, side * 58 - 5, side * 58 + 5, -120, 80, Enum.Material.Sand)
		local x0, x1 = if side < 0 then -78 else 0, if side < 0 then 0 else 78
		fill(t, x0, x1, 71.5, 80.5, Enum.Material.Cobblestone)
		for _, z in { 24, -44 } do
			fill(t, side * 76 - 14, side * 76 + 14, z - 14, z + 14, Enum.Material.Slate)
		end
	end
	fill(t, -53, 53, -117, -87, Enum.Material.Cobblestone)
	fill(t, -4, 4, 78, 131.5, Enum.Material.Cobblestone)
	fill(t, -17, 17, 65.5, 78, Enum.Material.Ground) -- sob o deck da varanda
end

local forestPainted = false

local function forestTerrain(trails: { BasePart })
	local t = workspace.Terrain
	terrainColors(t)
	-- A área jogável e uma folga cobertas pela névoa; além disso o chão de peças continua.
	if not forestPainted then
		forestPainted = true
		t:FillBlock(CFrame.new(0, TOP - DEPTH / 2, 720), V3(420, DEPTH, 440), Enum.Material.Grass)
	else
		t:ReplaceMaterial(
			Region3.new(V3(-210, TOP - DEPTH, 500), V3(210, TOP, 940)):ExpandToGrid(4),
			4,
			Enum.Material.Sand,
			Enum.Material.Grass
		)
	end
	for _, trail in trails do
		-- Trilha principal de terra batida; ramais de areia (mudam a cada capítulo).
		local material = if trail.Name == "MainTrail" then Enum.Material.Ground else Enum.Material.Sand
		t:FillBlock(
			CFrame.new(trail.Position.X, TOP - DEPTH / 2, trail.Position.Z) * trail.CFrame.Rotation,
			V3(trail.Size.X, DEPTH, trail.Size.Z),
			material
		)
	end
end

--[[ Floresta dos capítulos 6–8 ]]

--[[
	Pinheiros 3D (tronco com casca + galhos em cartões do atlas fir_tree_01, ~190 triângulos) no lugar das
	árvores-bloco. O tronco-bloco continua lá, invisível, com a mesma colisão e o mesmo raycast;
	as copas-bloco (sem colisão) só ficam invisíveis. Mesmo modelo repetido: o motor desenha em lote.
]]
local FIRS = { { name = "ForestFirA", height = 55 }, { name = "ForestFirB", height = 44 } }

local function firs(forest: Instance)
	local source = library()
	if not source or not source:FindFirstChild("ForestFirA") then
		return
	end
	local folder = Build.folder(forest, "ForestFirs")
	local rng = Random.new(SEED + 31)
	local placed = 0
	for _, part in forest:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		if part.Name == "Canopy" then
			part.Transparency = 1
			part.CastShadow = false
		elseif part.Name == "Trunk" and part:GetAttribute("ForestTree") == true then
			local pick = FIRS[rng:NextInteger(1, #FIRS)]
			local template = source:FindFirstChild(pick.name)
			if not template or not template:IsA("Model") then
				continue
			end
			part.Transparency = 1
			part.CastShadow = false
			local model = template:Clone()
			model:ScaleTo(model:GetScale() * part.Size.Y / pick.height * rng:NextNumber(1, 1.12))
			local base = part.Position - Vector3.yAxis * part.Size.Y / 2
			model:PivotTo(CFrame.new(base) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
			model.Parent = folder
			placed += 1
			if placed % 150 == 0 then
				task.wait()
			end
		end
	end
end

local function dressForest(forest: Instance)
	if forest:FindFirstChild("ForestGrass") then
		return
	end
	local trails: { BasePart } = {}
	local trunks: { Vector3 } = {}
	for _, part in forest:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		if part.Name == "ForestGround" then
			skin(part, FOREST)
		elseif part.Name == "MainTrail" then
			skin(part, DIRT)
			table.insert(trails, part)
		elseif part.Name == "BranchTrail" then
			-- Ramais de areia batida: o caminho principal continua de terra e fica fácil de seguir.
			skin(part, SAND)
			table.insert(trails, part)
		elseif part.Name == "Trunk" then
			table.insert(trunks, part.Position)
		end
	end
	local main = forest:FindFirstChild("MainTrail")
	if not main or not main:IsA("BasePart") then
		return
	end
	forestTerrain(trails)
	firs(forest)
	local function blocked(x: number, z: number): boolean
		for _, trail in trails do
			local offset = trail.CFrame:PointToObjectSpace(V3(x, trail.Position.Y, z))
			if math.abs(offset.X) < trail.Size.X / 2 + 1.5 and math.abs(offset.Z) < trail.Size.Z / 2 + 1.5 then
				return true
			end
		end
		for _, trunk in trunks do
			if (V3(trunk.X, 0, trunk.Z) - V3(x, 0, z)).Magnitude < 2.6 then
				return true
			end
		end
		return false
	end
	local folder = Build.folder(forest, "ForestGrass")
	local rng = Random.new(SEED + (tonumber(forest:GetAttribute("Chapter")) or 0))
	local top = TOP
	local z0, z1 = main.Position.Z - main.Size.Z / 2, main.Position.Z + main.Size.Z / 2
	-- Touceiras altas só como destaque: a grama do Terrain cobre o chão; mais perto das bordas da trilha.
	patches(folder, rng, 44, function(r: Random): Vector3?
		local side = if r:NextNumber() < 0.5 then -1 else 1
		local x = main.Position.X + side * (main.Size.X / 2 + 2 + r:NextNumber() ^ 1.8 * 40)
		local z = r:NextNumber(z0, z1)
		return if blocked(x, z) then nil else V3(x, top - 0.08, z)
	end, blocked, top - 0.08)
end

function Ground.build(root: Instance)
	for _, part in root:GetDescendants() do
		if part:IsA("BasePart") and LAWN_PARTS[part.Name] and part.Material == Enum.Material.Grass then
			skin(part, LAWN)
		end
	end
	lawnTerrain()
	garden(root)
	local function estate(folder: Instance)
		for _, part in folder:GetChildren() do
			if part:IsA("BasePart") then
				if part.Name == "EstateGround" then
					skin(part, LAWN)
				elseif part.Name == "GardenWalk" then
					-- Passeio lateral de areia batida.
					skin(part, SAND)
				end
			end
		end
	end
	local current = root:FindFirstChild("GeneratedEstate")
	if current then
		estate(current)
	end
	local forest = root:FindFirstChild("Forest")
	if forest then
		dressForest(forest)
	end
	root.ChildAdded:Connect(function(child)
		-- Os dois são montados inteiros na mesma execução; vestir depois que terminar.
		if child.Name == "GeneratedEstate" then
			task.defer(estate, child)
		elseif child.Name == "Forest" then
			-- A floresta publica árvores em lotes; espera os troncos para não plantar mato dentro deles.
			task.delay(2, function()
				if child.Parent then
					dressForest(child)
				end
			end)
		end
	end)
end

return Ground
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="498">
          <Properties>
            <string name="Name">HouseLevelBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Complemento reversível: não muda os arquivos da mansão nem seus IDs de portas/trancas.
local Build = require("./Build")
local Levels = require("../Campaign/HouseLevelPlan")
local Builder = {}
local V3 = Vector3.new
local stone = Color3.fromRGB(99, 105, 109)
local trim = Color3.fromRGB(204, 183, 138)
local wood = Color3.fromRGB(79, 58, 46)
local roof = Color3.fromRGB(55, 48, 69)
local function piece(parent: Instance, name: string, base: Vector3, size: Vector3, color: Color3, solid: boolean?)
	return Build.block(parent, name, base, size, 0, color, {
		collide = solid == true,
		query = solid == true,
		material = if name == "PavilionFloor" or name == "GardenStairTread"
			then Enum.Material.Slate
			elseif name == "ClayPot" then Enum.Material.Brick
			elseif name == "Herbs" then Enum.Material.Grass
			elseif name == "PavilionRoof" then Enum.Material.Slate
			else Enum.Material.Wood,
	})
end
local function sign(parent: Instance, p: Vector3, text: string)
	Build.sign(
		parent,
		"EstateSign",
		p,
		Vector3.zAxis,
		Vector2.new(10, 2),
		text,
		{ textColor = trim, background = wood, lit = true }
	)
end
local function pavilion(parent: Instance, x: number, z: number, title: string, glass: boolean)
	-- O centro e a aproximação de cada tarefa ficam livres; os móveis ocupam as bordas.
	piece(parent, "PavilionFloor", V3(x, -1, z), V3(28, 1, 28), stone, true)
	for _, dx in { -12, 12 } do
		for _, dz in { -12, 12 } do
			piece(parent, "PavilionColumn", V3(x + dx, 0, z + dz), V3(0.7, 12, 0.7), trim, true)
		end
		if glass then
			local wall =
				piece(parent, "GreenhouseGlass", V3(x + dx, 0, z), V3(0.2, 10, 22), Color3.fromRGB(119, 157, 151))
			wall.Material, wall.Transparency = Enum.Material.Glass, 0.7
		end
		for row = 1, 3 do
			local benchZ = z - 8 + row * 4
			piece(parent, "PottingBench", V3(x + dx * 0.72, 0, benchZ), V3(3, 2.6, 2.4), wood)
			piece(parent, "ClayPot", V3(x + dx * 0.72, 2.6, benchZ), V3(1.5, 1.2, 1.5), Color3.fromRGB(139, 91, 66))
			piece(parent, "Herbs", V3(x + dx * 0.72, 3.8, benchZ), V3(2, 1.4, 2), Color3.fromRGB(54, 83, 58))
		end
	end
	piece(parent, "PavilionRoof", V3(x, 12, z), V3(30, 0.7, 30), roof, true)
	local lantern = piece(parent, "PavilionLantern", V3(x, 8, z + 10), V3(0.5, 0.7, 0.5), trim)
	Build.light(lantern, "Street", Color3.fromRGB(255, 202, 137), 22, 0.55, true, false)
	sign(parent, V3(x, 9, z + 12), title)
end
local function stairs(parent: Instance, side: number)
	local x = side * 94
	local from, to = V3(x, 0, 0), V3(x, 8, 24)
	local cf = CFrame.lookAt((from + to) / 2 - V3(0, 0.5, 0), to - V3(0, 0.5, 0))
	Build.part(parent, "GardenStairRamp", V3(10, 1, (to - from).Magnitude + 1), cf, stone)
	for i = 1, 16 do
		local p = from:Lerp(to, i / 16)
		piece(parent, "GardenStairTread", p - V3(0, 0.14, 0), V3(10, 0.16, 1.5), trim)
	end
	piece(parent, "LookoutFloor", V3(x, 7, 36), V3(18, 1, 24), wood, true)
	for _, dx in { -8.5, 8.5 } do
		piece(parent, "LookoutGuard", V3(x + dx, 8, 36), V3(0.4, 3.5, 24), trim, true)
	end
	piece(parent, "LookoutGuard", V3(x, 8, 48), V3(18, 3.5, 0.4), trim, true)
	for _, dx in { -5.2, 5.2 } do
		Build.part(parent, "GardenStairGuard", V3(0.3, 3.5, (to - from).Magnitude), cf * CFrame.new(dx, 2, 0), trim)
	end
	sign(parent, V3(x, 12.5, 47.5), "MIRANTE / A CASA OBSERVA")
end
local function suppress(part: BasePart)
	if part:GetAttribute("LevelOriginalTransparency") == nil then
		part:SetAttribute("LevelOriginalTransparency", part.Transparency)
		part:SetAttribute("LevelOriginalCollide", part.CanCollide)
		part:SetAttribute("LevelOriginalQuery", part.CanQuery)
	end
	part.Transparency, part.CanCollide, part.CanQuery = 1, false, false
end
local function serviceStairs(parent: Instance, side: number)
	local x = side * 26
	local from, to = V3(x, 16, -80), V3(x, 32, -54)
	local cf = CFrame.lookAt((from + to) / 2 - V3(0, 0.5, 0), to - V3(0, 0.5, 0))
	Build.part(parent, "ServiceStairRamp", V3(10, 1, (to - from).Magnitude + 1.5), cf, wood)
	for _, dx in { -5.2, 5.2 } do
		Build.part(parent, "ServiceStairGuard", V3(0.3, 3.5, (to - from).Magnitude), cf * CFrame.new(dx, 2, 0), trim)
	end
	for i = 1, 26 do
		piece(parent, "ServiceStairTread", from:Lerp(to, i / 26) - V3(0, 0.15, 0), V3(10, 0.16, 1), trim)
	end
	-- Recorte só no cômodo superior vago, depois de a campanha liberar o andar.
	for _, dx in { -12, 12 } do
		piece(parent, "ServiceStairFloor", V3(x + dx, 31, -68), V3(12, 1, 32), wood, true)
	end
	for _, z in { -83, -53 } do
		piece(parent, "ServiceStairLanding", V3(x, 31, z), V3(12, 1, 2), wood, true)
	end
	for _, dx in { -6, 6 } do
		piece(parent, "ServiceStairLandingGuard", V3(x + dx, 32, -68), V3(0.3, 3.5, 28), trim, true)
	end
	sign(parent, V3(x, 25, -51.3), "ESCADA DE SERVIÇO / SÓTÃO")
end
function Builder.build(root: Instance, level: Levels.Level)
	local previous = root:FindFirstChild("GeneratedEstate")
	if previous then
		previous:Destroy()
	end
	local out = Build.folder(root, "GeneratedEstate")
	root:SetAttribute("LevelEnvironment", if level.outdoor then "Exterior" else "Interior")
	root:SetAttribute("LevelTheme", level.theme)
	-- Anel contínuo de caminhada: sem lacunas, sem invadir a projeção do porão.
	for _, side in { -1, 1 } do
		piece(out, "EstateFence", V3(side * 106, 0, -20), V3(0.5, 4, 198), wood, true)
		piece(out, "FrontFence", V3(side * 77, 0, 80), V3(58, 4, 0.5), wood, true)
		piece(out, "EstateGround", V3(side * 77, -1, -20), V3(58, 1, 200), Color3.fromRGB(47, 62, 46), true)
		piece(out, "GardenWalk", V3(side * 58, -0.03, -20), V3(10, 0.03, 200), stone)
		piece(out, "FrontWalk", V3(side * 39, -0.03, 76), V3(78, 0.03, 9), stone)
		pavilion(out, side * 76, 24, if side < 0 then "JARDIM DE INVERNO" else "ESTUFA", side > 0)
		pavilion(out, side * 76, -44, if side < 0 then "PAVILHÃO DAS MEMÓRIAS" else "OFICINA DO JARDINEIRO", false)
	end
	piece(out, "RearCourt", V3(0, -1, -102), V3(106, 1, 30), stone, true)
	piece(out, "RearFence", V3(0, 0, -117), V3(212, 4, 0.5), wood, true)
	for _, side in { -1, 1 } do
		piece(out, "CourtArchColumn", V3(side * 34, 0, -112), V3(1, 14, 1), trim, true)
		piece(out, "CourtBench", V3(side * 34, 0, -106), V3(9, 2, 3), wood)
	end
	piece(out, "CourtArch", V3(0, 14, -112), V3(70, 1, 2), trim)
	sign(out, V3(0, 10, -112), "O RELÓGIO PAROU. A CASA, NÃO.")
	stairs(out, level.stairSide)
	-- Silhueta de telhado, cornijas, varanda e chaminés, vistas de todos os lados.
	local angle = math.atan(20 / 48)
	for _, side in { -1, 1 } do
		Build.part(
			out,
			"EstatePitchedRoof",
			V3(53, 0.8, 108),
			CFrame.new(side * 24, 58, -36) * CFrame.Angles(0, 0, -side * angle),
			roof,
			{ material = Enum.Material.Slate }
		)
		for _, z in { -90, 18 } do
			Build.part(
				out,
				"EstateGable",
				V3(0.6, 20, 48),
				CFrame.new(side * 24, 58, z) * CFrame.Angles(0, -side * math.pi / 2, 0),
				Color3.fromRGB(113, 100, 122),
				{ class = "WedgePart", material = Enum.Material.Plaster }
			)
		end
		Build.part(
			out,
			"FoyerPitchedRoof",
			V3(39, 0.8, 57),
			CFrame.new(10.5 + side * 17.5, 56, 38) * CFrame.Angles(0, 0, -side * math.atan(16 / 35)),
			roof,
			{ material = Enum.Material.Slate }
		)
		Build.part(
			out,
			"EstateGable",
			V3(0.6, 16, 35),
			CFrame.new(10.5 + side * 17.5, 56, 66) * CFrame.Angles(0, -side * math.pi / 2, 0),
			Color3.fromRGB(113, 100, 122),
			{ class = "WedgePart", material = Enum.Material.Plaster }
		)
		piece(out, "Chimney", V3(side * 29, 58, -62), V3(5, 16, 5), stone)
		piece(out, "ChimneyCap", V3(side * 29, 74, -62), V3(6, 0.6, 6), trim)
		for _, z in { -84, 10 } do
			piece(out, "FacadePilaster", V3(side * 44.65, 0, z), V3(1, 48, 1.4), trim)
		end
		for _, y in { 0, 16, 32, 47 } do
			piece(out, "ExteriorCornice", V3(side * 44.7, y, -36), V3(0.8, 0.7, 100), trim)
		end
		for _, z in { -78, -46, -14 } do
			for _, y in { 16, 32 } do
				piece(out, "SideWindowFrame", V3(side * 44.65, y + 4, z), V3(0.3, 7, 5), trim)
				piece(
					out,
					"SideWindowInset",
					V3(side * 44.9, y + 4.4, z),
					V3(0.2, 6.2, 4.2),
					Color3.fromRGB(94, 113, 116)
				)
			end
		end
		piece(out, "PorchPillar", V3(side * 14, 0, 74), V3(1.2, 12, 1.2), trim, true)
	end
	piece(out, "PorchCanopy", V3(0, 12, 70), V3(34, 1, 16), roof, true)
	local arch = root:FindFirstChild("Architecture")
	if not arch then
		return
	end
	for _, wall in arch:GetChildren() do
		if not wall:IsA("BasePart") then
			continue
		end
		-- Restaura primeiro: reiniciar ou voltar à História nunca acumula buracos.
		if wall:GetAttribute("LevelOriginalTransparency") ~= nil then
			wall.Transparency = wall:GetAttribute("LevelOriginalTransparency") :: number
			wall.CanCollide = wall:GetAttribute("LevelOriginalCollide") :: boolean
			wall.CanQuery = wall:GetAttribute("LevelOriginalQuery") :: boolean
		end
		if
			level.serviceStair
			and math.abs(wall.Position.X - level.stairSide * 26) < 0.1
			and math.abs(wall.Position.Z + 68) < 0.1
			and (
				(wall.Name == "RoomFloor" and math.abs(wall.Position.Y - 31.5) < 0.1)
				or (wall.Name == "RoomCeiling" and math.abs(wall.Position.Y - 31.25) < 0.1)
			)
		then
			suppress(wall)
		end
		if wall.Name ~= "RoomPartition" then
			continue
		end
		for _, opening in level.passages do
			if
				math.abs(wall.Position.X - opening.x) > 0.1
				or math.abs(wall.Position.Z - opening.z) > 0.1
				or math.abs(wall.Position.Y - (opening.y + 8)) > 0.1
			then
				continue
			end
			suppress(wall)
			local rest = (wall.Size.X - opening.width) / 2
			for _, side in { -1, 1 } do
				local p = piece(
					out,
					"ConnectedRoomWall",
					V3(opening.x + side * (opening.width + rest) / 2, opening.y, opening.z),
					V3(rest, wall.Size.Y, wall.Size.Z),
					wall.Color,
					true
				)
				p.Material, p.MaterialVariant = wall.Material, wall.MaterialVariant
			end
			local lintel = piece(
				out,
				"PassageLintel",
				V3(opening.x, opening.y + 11, opening.z),
				V3(opening.width, 5, wall.Size.Z),
				wall.Color,
				true
			)
			lintel.Material, lintel.MaterialVariant = wall.Material, wall.MaterialVariant
		end
	end
	if level.serviceStair then
		serviceStairs(out, level.stairSide)
	end
end
function Builder.ruins(root: Instance)
	local generated = root:FindFirstChild("GeneratedEstate")
	if not generated then
		return
	end
	for _, part in generated:GetChildren() do
		if
			part:IsA("BasePart")
			and (
				part.Name == "EstatePitchedRoof"
				or part.Name == "ExteriorCornice"
				or part.Name == "Chimney"
				or part.Name == "ChimneyCap"
				or part.Name == "PorchCanopy"
				or part.Name == "EstateGable"
				or part.Name == "FoyerPitchedRoof"
			)
		then
			part.Transparency, part.CanCollide, part.CanQuery = 1, false, false
		end
	end
end
return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="499">
          <Properties>
            <string name="Name">HouseMaterials</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Materiais PBR da mansão (MaterialVariant em MaterialService, texturas CC0 do Poly Haven).
	Só troca aparência: Material/MaterialVariant/Color. Tamanho, posição, colisão e nomes não mudam.
	Paredes externas recebem um revestimento interno fino (sem colisão) para o papel de parede
	não aparecer do lado de fora; o porão continua de tijolo.
]]

local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Build = require("./Build")

local Materials = {}

local V3 = Vector3.new
local rgb = Color3.fromRGB

export type Finish = { variant: string, material: Enum.Material, color: Color3 }

local WALLPAPER: Finish = { variant = "MansionWallpaper", material = Enum.Material.Plaster, color = rgb(236, 230, 220) }
local PLANKS: Finish =
	{ variant = "MansionFloorPlanks", material = Enum.Material.WoodPlanks, color = rgb(214, 202, 190) }
local STONE: Finish = { variant = "", material = Enum.Material.Slate, color = rgb(74, 70, 64) }
local ATTIC: Finish =
	{ variant = "MansionFloorPlanks", material = Enum.Material.WoodPlanks, color = rgb(170, 150, 132) }
local PLASTER: Finish = { variant = "MansionPlaster", material = Enum.Material.Plaster, color = rgb(226, 214, 196) }
local WOOD: Finish = { variant = "MansionDarkWood", material = Enum.Material.Wood, color = rgb(200, 196, 192) }
local WOOD_LIGHT: Finish = { variant = "MansionDarkWood", material = Enum.Material.Wood, color = rgb(255, 250, 244) }
local RUNNER: Finish = { variant = "MansionRunner", material = Enum.Material.Fabric, color = rgb(196, 168, 176) }
local LEATHER: Finish = { variant = "MansionLeather", material = Enum.Material.Leather, color = rgb(190, 150, 140) }

Materials.Wallpaper = WALLPAPER
Materials.Wood = WOOD

-- Paredes com as duas faces dentro da casa.
local INTERIOR_WALLS = {
	DoorWall = true,
	DoorLintel = true,
	RoomPartition = true,
	ConnectedRoomWall = true,
	PassageLintel = true,
	FacadeSill = true,
	FacadeTop = true,
	WindowSide = true,
}
local FLOORS = {
	CorridorFloor = true,
	RoomFloor = true,
	StairDeck = true,
	ReturnWalkway = true,
	SouthLanding = true,
	NorthLanding = true,
	MainStairs = true,
	AtticStairs = true,
}
local CEILINGS = { RoomCeiling = true, CorridorCeilingPanel = true, FoyerCeilingPanel = true, RoomCeilingPanel = true }
local WOOD_NAMES = {
	Wainscot = true,
	DoorCasing = true,
	Skirting = true,
	Cornice = true,
	CeilingBeam = true,
	Handrail = true,
	Railing = true,
	StairTread = true,
	StairBaluster = true,
	LandingGuard = true,
	FinishWainscot = true,
	FinishSkirting = true,
	FinishChairRail = true,
	CorridorCrown = true,
	GuardNewel = true,
	ConsoleApron = true,
	ConsoleLeg = true,
	BenchBack = true,
	BenchLeg = true,
	ClockPlinth = true,
	ClockHood = true,
	AntiqueTable = true,
}
-- Armários e esconderijos (Features): só a aparência muda; porta, prompt e tags ficam iguais.
local HIDE_NAMES =
	{ Side = true, Back = true, Top = true, HideDoor = true, ChestLid = true, BedCover = true, Leg = true }
local WOOD_LIGHT_NAMES = {
	WainscotPanel = true,
	ChairRail = true,
	FinishPanel = true,
	GuardPanel = true,
	DoorPanelUpper = true,
	DoorPanelLower = true,
	ConsoleTop = true,
	BenchSeat = true,
	ClockCase = true,
}

function Materials.apply(part: BasePart, finish: Finish)
	part.Material = finish.material
	part.MaterialVariant = finish.variant
	part.Color = finish.color
end

-- Cozinha e banheiro: ladrilho xadrez de mármore gasto (Poly Haven floor_tiles_06).
local TILES: Finish = { variant = "MansionTiles", material = Enum.Material.Slate, color = rgb(214, 206, 196) }
local TILED: { Vector3 } = {}
for _, room in House.Rooms do
	if room.id == "Kitchen" or room.id == "Bath" then
		table.insert(TILED, Vector3.new(room.x, room.y, room.z))
	end
end

local function tiled(position: Vector3): boolean
	for _, center in TILED do
		local d = position - center
		if math.abs(d.X) < 18 and math.abs(d.Z) < 16 and math.abs(d.Y) < 1.5 then
			return true
		end
	end
	return false
end

-- Sala de máquinas (térreo, fundo à direita): reboco cru, sem papel de parede.
local function utility(position: Vector3): boolean
	return position.X > 8.6 and position.Z < -52.4 and position.Y > -0.5 and position.Y < 15.5
end

local function classify(part: BasePart): Finish?
	local name = part.Name
	local basement = part.Position.Y < -0.5
	if INTERIOR_WALLS[name] then
		-- Sótão (nível 32) é tábua crua, sem papel de parede.
		return if basement
			then nil
			elseif part.Position.Y > 31 then ATTIC
			elseif name ~= "DoorWall" and name ~= "DoorLintel" and utility(part.Position) then PLASTER
			else WALLPAPER
	elseif FLOORS[name] then
		-- Porão e sala de máquinas: lajota de pedra em vez de tábua.
		if utility(part.Position + Vector3.yAxis) then
			return STONE
		elseif name == "RoomFloor" and tiled(part.Position) then
			return TILES
		end
		return if basement then (if name == "CorridorFloor" or name == "RoomFloor" then STONE else nil) else PLANKS
	elseif CEILINGS[name] then
		return PLASTER
	elseif WOOD_NAMES[name] or string.sub(name, 1, 11) == "house_door_" then
		return WOOD
	elseif WOOD_LIGHT_NAMES[name] then
		return WOOD_LIGHT
	elseif name == "HallRunner" or name == "CorridorRunner" then
		return RUNNER
	elseif name == "BenchCushion" then
		return LEATHER
	end
	return nil
end

-- Revestimento interno das paredes que também são fachada (um trecho por cômodo).
local function skins(parent: Instance)
	local function skin(center: Vector3, size: Vector3)
		local part = Build.part(parent, "WallpaperSkin", size, CFrame.new(center), WALLPAPER.color, {
			collide = false,
			query = false,
		})
		part.CanTouch = false
		Materials.apply(part, if center.Y > 31 then ATTIC elseif utility(center) then PLASTER else WALLPAPER)
	end
	for _, y in { 0, 16, 32 } do
		local mid = y + 7.5
		for _, side in { -1, 1 } do
			-- Fachadas laterais dos cômodos (x = ±44), uma por fileira.
			for row = 1, 3 do
				skin(V3(side * 43.47, mid, 28 - row * 32), V3(0.04, 15, 32))
			end
			-- Fundo da casa (z = -85), metade de cada lado.
			skin(V3(side * 22, mid, -84.47), V3(43, 15, 0.04))
		end
		-- Laterais da caixa da escada (x = -24 e 45).
		skin(V3(-23.47, mid, 38), V3(0.04, 15, 51))
		skin(V3(44.47, mid, 38), V3(0.04, 15, 51))
		-- Frente do hall (z = 64), com o vão da porta no térreo.
		if y == 0 then
			skin(V3(-14.75, mid, 63.47), V3(17.5, 15, 0.04))
			skin(V3(25.25, mid, 63.47), V3(38.5, 15, 0.04))
			skin(V3(0, 13.25, 63.47), V3(12, 3.5, 0.04))
		else
			skin(V3(10.5, mid, 63.47), V3(68, 15, 0.04))
		end
	end
end

local function paint(container: Instance?)
	if not container then
		return
	end
	for _, part in container:GetDescendants() do
		if part:IsA("BasePart") then
			local finish = classify(part)
			if finish then
				Materials.apply(part, finish)
			end
		end
	end
end

function Materials.build(root: Instance)
	local finish = root:FindFirstChild("Finish")
	if finish then
		skins(finish)
	end
	for _, name in { "Architecture", "Furnishings", "Doors", "Finish", "GeneratedEstate" } do
		paint(root:FindFirstChild(name))
	end
	local features = root:FindFirstChild("Features")
	if features then
		for _, part in features:GetDescendants() do
			-- A porta do esconderijo debaixo da cama é quase transparente e fica como está.
			if part:IsA("BasePart") and HIDE_NAMES[part.Name] and part.Transparency < 0.5 then
				-- A cama-esconderijo ganha colcha de jacquard; o resto é nogueira.
				Materials.apply(part, if part.Name == "BedCover" then RUNNER else WOOD)
			end
		end
	end
end

return Materials
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="500">
          <Properties>
            <string name="Name">HouseProps</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Móveis e luminárias com modelos 3D (ReplicatedStorage.Assets.MansionProps, Poly Haven CC0,
	otimizados no Blender; fontes em docs/environment/ASSET_SOURCES.md).
	Só visual: MeshParts ancoradas, sem colisão, sem raycast, sem toque. As luzes ficam em peças
	invisíveis com Build.light, para o WorldFxController controlar sombra e visibilidade.
	Sem a biblioteca (place de Script Sync sem o .rbxm), nada é criado e o jogo segue igual.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Build = require("./Build")

local Props = {}

local V3 = Vector3.new
local rgb = Color3.fromRGB
local UP = Vector3.yAxis
local WARM = rgb(255, 196, 132)
local FURNITURE = 1.25

-- floor: centro da base; back: meio da aresta de trás da base (móvel encostado na parede);
-- wall: centro da face de trás; ceiling: centro do topo.
export type Anchor = "floor" | "back" | "wall" | "ceiling"

local function library(): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	return assets and assets:FindFirstChild("MansionProps")
end

--[[
	Coloca um modelo: `at` é o centro da base (floor), da face de trás (wall) ou do topo (ceiling);
	`facing` é para onde a frente do móvel olha. `scale` multiplica a escala da biblioteca.
]]
function Props.place(
	parent: Instance,
	name: string,
	at: Vector3,
	facing: Vector3,
	scale: number?,
	anchor: Anchor?
): Model?
	local source = library()
	local template = source and source:FindFirstChild(name)
	if not template or not template:IsA("Model") then
		return nil
	end
	local model = template:Clone()
	-- A casa é maior que o tamanho real (portas de 11 studs, cômodos de 36 x 32): móveis de chão
	-- crescem 25% para ficarem proporcionais à arquitetura e ao personagem.
	local factor = (scale or 1) * (if anchor == "floor" or anchor == "back" or anchor == nil then FURNITURE else 1)
	if factor ~= 1 then
		model:ScaleTo(model:GetScale() * factor)
	end
	model:PivotTo(CFrame.lookAt(Vector3.zero, facing.Unit))
	local box, size = model:GetBoundingBox()
	local look = box.LookVector
	-- Peças de parede ficam 0,1 stud à frente do revestimento (a tela fica no fundo da moldura).
	local reference = if anchor == "wall"
		then box.Position - look * (size.Z / 2 + 0.1)
		elseif anchor == "ceiling" then box.Position + UP * (size.Y / 2)
		elseif anchor == "back" then box.Position - look * (size.Z / 2 + 0.1) - UP * (size.Y / 2)
		else box.Position - UP * (size.Y / 2)
	model:PivotTo(model:GetPivot() + (at - reference))
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
		end
	end
	model.Parent = parent
	return model
end

-- Topo do modelo (para apoiar objetos em cima).
local function top(model: Model?): number
	if not model then
		return 0
	end
	local box, size = model:GetBoundingBox()
	return box.Position.Y + size.Y / 2
end

-- Fonte de luz invisível; o modelo dá a forma, esta peça dá a luz.
local function glow(parent: Instance, name: string, at: Vector3, range: number, brightness: number, flicker: boolean?)
	local part = Build.part(parent, name, V3(0.3, 0.3, 0.3), CFrame.new(at), WARM, {
		transparency = 1,
		collide = false,
		query = false,
	})
	part.CanTouch = false
	Build.light(part, "Street", WARM, range, brightness, true, flicker)
	return part
end

local function hall(folder: Instance)
	local west, east, front = -Vector3.xAxis, -Vector3.xAxis, -Vector3.zAxis
	-- Lustre de velas sob o medalhão; patamares com versões menores.
	Props.place(folder, "Chandelier", V3(0, 14.85, 40), front, 1.05, "ceiling")
	glow(folder, "HallChandelier", V3(0, 12, 40), 34, 0.75, true)
	for _, y in { 16, 32 } do
		Props.place(folder, "Chandelier", V3(0, y + 14.85, 40), front, 0.75, "ceiling")
		glow(folder, "HallChandelier", V3(0, y + 12.6, 40), 26, 0.55, true)
	end
	-- Entrada: arandelas e, à direita, aparador com espelho e lamparina.
	for _, x in { -8.5, 8.5 } do
		Props.place(folder, "Sconce", V3(x, 7.2, 63.5), front, 2.2, "wall")
		glow(folder, "HallSconce", V3(x, 6.9, 62.6), 16, 0.45)
	end
	local console = Props.place(folder, "Console", V3(15, 0, 62.4), front, 1, "floor")
	Props.place(folder, "Mirror", V3(15, 6.9, 63.5), front, 1.45, "wall")
	Props.place(folder, "Lantern", V3(12.8, top(console), 62.4), front, 1.7, "floor")
	glow(folder, "Candle", V3(12.8, top(console) + 0.9, 62.2), 13, 0.55, true)
	Props.place(folder, "FrameOval", V3(-15, 7.4, 63.5), front, 2.1, "wall")
	-- Canto leste, atrás da escada: relógio parado às 03:12, sofá, criado-mudo, poltrona e quadros.
	Props.place(folder, "GrandfatherClock", V3(43.6, 0, 30), west, 1, "floor")
	Props.place(folder, "Sofa", V3(44.4, 0, 44.5), west, 1.3, "back")
	local stand = Props.place(folder, "Nightstand", V3(44.4, 0, 52.5), west, 1, "back")
	Props.place(folder, "Lantern", V3(42.8, top(stand), 52.5), west, 1.3, "floor")
	glow(folder, "HallLampShade", V3(42.8, top(stand) + 1, 52.5), 20, 0.6, true)
	Props.place(folder, "Armchair", V3(40.6, 0, 22.5), V3(-1, 0, 0.45), 1, "floor")
	Props.place(folder, "PersianRug", V3(36, 0.02, 45), west, 0.75, "floor")
	Props.place(folder, "FrameRococo", V3(44.5, 7.6, 21), east, 1.55, "wall")
	Props.place(folder, "FrameLandscape", V3(44.5, 7.9, 45.5), east, 2.2, "wall")
	for _, z in { 26.5, 33.5 } do
		Props.place(folder, "Sconce", V3(44.5, 7.4, z), east, 2, "wall")
		glow(folder, "HallSconce", V3(43.7, 7.1, z), 18, 0.45)
	end
end

local FRAMES = { "FrameRococo", "FrameLandscape", "FrameOval" }

local function corridors(folder: Instance)
	-- Um quadro por cômodo, no trecho de parede sem a placa do cômodo.
	for _, y in { 0, 16, 32 } do
		for _, side in { -1, 1 } do
			for row = 1, 3 do
				local z = 28 - row * 32 - 10.5
				local name = FRAMES[(row + (if side > 0 then 1 else 0) + y // 16) % #FRAMES + 1]
				Props.place(folder, name, V3(side * 7.5, y + 7.2, z), V3(-side, 0, 0), 1.6, "wall")
			end
		end
	end
end

--[[
	Cômodos. Sistema local: `ox` cresce da porta (−18) para a fachada (+18); `oz` é o eixo Z do mundo.
	O centro (|ox| < 9) é das tarefas, (ox 9..13, oz 4..12) é do esconderijo: os móveis ficam nas paredes.
	Caixas antigas que colidem (estantes, camas) ficam como colisão invisível, com o modelo por cima.
]]
type RoomRef = { id: string, x: number, y: number, z: number }

local function inRoom(part: BasePart, room: RoomRef): boolean
	local p = part.Position
	return math.abs(p.X - room.x) < 18 and math.abs(p.Z - room.z) < 16 and p.Y > room.y - 1 and p.Y < room.y + 15
end

-- Esconde a peça antiga sem mexer em colisão, consulta ou luz (a luz continua na peça).
local function conceal(root: Instance, room: RoomRef, names: { [string]: boolean })
	for _, folderName in { "Furniture", "Furnishings", "Dressing" } do
		local folder = root:FindFirstChild(folderName)
		if folder then
			for _, part in folder:GetDescendants() do
				if part:IsA("BasePart") and names[part.Name] and inRoom(part, room) then
					part.Transparency, part.CastShadow = 1, false
					part:SetAttribute("VisualReplaced", true)
				end
			end
		end
	end
end

local function roomFrame(room: RoomRef)
	local side = if room.x < 0 then -1 else 1
	local function at(ox: number, oz: number, dy: number?): Vector3
		return V3(room.x + side * ox, room.y + (dy or 0), room.z + oz)
	end
	return at, V3(-side, 0, 0), side
end

--[[
	Planta de cada cômodo (sistema local: `ox` da porta −18 à fachada +18, `oz` = eixo Z do mundo).
	Zonas que ficam livres:
	- porta (ox < −10, |oz| < 6) e tarefas no centro (|ox| < 8, oz −6..9);
	- esconderijo e a frente dele (ox 8..14, oz 4..12);
	- meio das divisórias que a campanha pode abrir (|ox| < 13 junto de oz ±16; só onde a parede é divisória).
	Os móveis vão para a parede da fachada (faixa ox 14..17.5), para os trechos da parede da porta,
	para a parede da frente (fileira 1, abaixo da janela do hall) e para a parede do fundo (fileira 3).
]]
type Wall = "facade" | "door" | "front" | "rear"

local function has(name: string): boolean
	local source = library()
	return source ~= nil and source:FindFirstChild(name) ~= nil
end

-- Móvel encostado numa parede: `along` é a posição ao longo da parede (oz na fachada/porta, ox na frente/fundo).
local function against(folder: Instance, room: RoomRef, name: string, wall: Wall, along: number, scale: number?): Model?
	local side = if room.x < 0 then -1 else 1
	local inward = V3(-side, 0, 0)
	local at: Vector3, facing: Vector3
	if wall == "facade" then
		at, facing = V3(room.x + side * 17.5, room.y, room.z + along), inward
	elseif wall == "door" then
		at, facing = V3(room.x - side * 17.5, room.y, room.z + along), -inward
	elseif wall == "front" then
		at, facing = V3(room.x + side * along, room.y, room.z + 15.5), -Vector3.zAxis
	else
		at, facing = V3(room.x + side * along, room.y, room.z - 15.5), Vector3.zAxis
	end
	return Props.place(folder, name, at, facing, scale, "back")
end

local function lampOn(folder: Instance, room: RoomRef, wall: Wall, along: number)
	local stand = against(folder, room, "Nightstand", wall, along, 1)
	if not stand then
		return
	end
	local box = stand:GetBoundingBox()
	local spot = V3(box.Position.X, top(stand), box.Position.Z)
	Props.place(folder, "Lantern", spot, box.LookVector, 1.4, "floor")
	glow(folder, "LampShade", spot + UP, 18, 0.55, true)
end

-- Janela com cortinas na fachada, no lugar do quadro liso de oz −6 (o de oz +6 vira moldura 3D).
-- Cômodos com móveis altos nessa parede (estantes, caldeiras, bancada) ficam sem janela.
local NO_WINDOW = { Kitchen = true, Bath = true, Library = true, AtticBook = true, Machine = true }
local function window(folder: Instance, room: RoomRef)
	if room.y < 0 or NO_WINDOW[room.id] then
		return
	end
	local side = if room.x < 0 then -1 else 1
	local oz = if room.id == "Living" then -11.5 else -9.5
	Props.place(folder, "WindowSet", V3(room.x + side * 17.5, room.y + 7.2, room.z + oz), V3(-side, 0, 0), 1, "wall")
end

local ROOMS: { [string]: (folder: Instance, root: Instance, room: RoomRef) -> () } = {}

ROOMS.Living = function(folder, root, room)
	local at = roomFrame(room)
	conceal(root, room, {
		SofaSeat = true,
		SofaBack = true,
		SofaArm = true,
		LampPole = true,
		LampShade = true,
		Pot = true,
		Leaves = true,
		Fireplace = true,
		Fire = true,
	})
	-- Lareira na parede interna (a do corredor), longe do guarda-roupa da fachada; sofá na fachada
	-- de frente para o fogo e poltronas viradas para a lareira (a luz do fogo antigo continua acesa).
	local fireplace = against(folder, room, "Fireplace", "door", 10.3, 1.05)
	glow(folder, "Fire", at(-16, 10.3, 1.2), 24, 1, true)
	if fireplace then
		local box = fireplace:GetBoundingBox()
		local mantel = V3(box.Position.X, top(fireplace), box.Position.Z)
		Props.place(folder, "MantelClock", mantel, box.LookVector, 1.1, "floor")
		for _, dz in { -3, 3 } do
			Props.place(folder, "Candelabra", mantel + V3(0, 0, dz), box.LookVector, 0.55, "floor")
		end
	end
	against(folder, room, "Sofa", "facade", -1.5, 1.45)
	Props.place(folder, "Armchair", at(-8.6, 10.5, 0), V3(-1, 0, -0.15), 1.05, "floor")
	Props.place(folder, "Armchair", at(10.5, -11.5, 0), V3(-1, 0, 0.6), 1.05, "floor")
	lampOn(folder, room, "facade", -14.3)
	against(folder, room, "Cabinet", "door", -11, 1)
	against(folder, room, "Bookshelf", "facade", 12.6, 1)
	local console = against(folder, room, "Console", "front", 0, 0.95)
	if console then
		local box = console:GetBoundingBox()
		Props.place(
			folder,
			"BrassCandle",
			V3(box.Position.X - 1.5, top(console), box.Position.Z),
			box.LookVector,
			1.2,
			"floor"
		)
	end
end

ROOMS.Kitchen = function(folder, root, room)
	local at = roomFrame(room)
	conceal(root, room, { Counter = true, Stove = true, Fridge = true, Pot = true, Fruit = true })
	-- Bancada contínua na fachada e fogão de ferro no fim; geladeira-baú e mesa junto da porta.
	-- Fogão no canto e bancada até a beira do esconderijo (o guarda-roupa fica em oz 5..9).
	for index = 0, 2 do
		against(folder, room, "KitchenCounter", "facade", -5.8 + index * 4.5, 1)
	end
	local stove = against(folder, room, "WoodStove", "facade", -11.8, 0.85)
	if stove then
		local box = stove:GetBoundingBox()
		Props.place(folder, "EnamelPot", V3(box.Position.X, top(stove), box.Position.Z), box.LookVector, 1.4, "floor")
	end
	against(folder, room, "Icebox", "door", -11, 0.95)
	local center = at(-11.5, 11.5, 0)
	Props.place(folder, "RoundTable", center, V3(1, 0, 0), 0.95, "floor")
	Props.place(folder, "GothicChair", center + V3(0, 0, -4.2), V3(0, 0, 1), 0.75, "floor")
	Props.place(folder, "GothicChair", center + V3(0, 0, 4), V3(0, 0, -1), 0.75, "floor")
	for _, ox in { -6, 0, 6 } do
		against(folder, room, "PaintedCabinet", "front", ox, 0.9)
	end
end

ROOMS.Dining = function(folder, root, room)
	local at = roomFrame(room)
	conceal(root, room, { DiningTable = true, Chair = true, ChairBack = true, Candle = true, Flame = true })
	-- Mesa com quatro cadeiras na metade da fachada, longe das passagens e do esconderijo.
	local center = at(13.5, -6, 0)
	local dining = Props.place(folder, "RoundTable", center, V3(1, 0, 0), 1.15, "floor")
	for _, offset in { V3(0, 0, -5), V3(0, 0, 5), V3(5.2, 0, 0), V3(-5.2, 0, 0) } do
		local spot = center + offset
		if math.abs(spot.X - room.x) < 17 then
			Props.place(folder, "GothicChair", spot, -offset, 0.8, "floor")
		end
	end
	if dining then
		Props.place(folder, "Candelabra", V3(center.X, top(dining), center.Z), V3(1, 0, 0), 0.75, "floor")
	end
	glow(folder, "Candle", center + V3(0, 6, 0), 26, 0.9, true)
	against(folder, room, "Cabinet", "door", -11, 1.05)
	against(folder, room, "Console", "door", 11, 1)
end

ROOMS.Bath = function(folder, root, room)
	local at = roomFrame(room)
	conceal(root, room, { Tub = true, Water = true, Sink = true, Mirror = true, Duck = true })
	local tub = against(folder, room, "Bathtub", "facade", -9.5, 1)
	if tub then
		local box, size = tub:GetBoundingBox()
		Props.place(folder, "RubberDuck", box.Position + V3(0, size.Y / 2 - 0.2, 2), box.LookVector, 1.3, "floor")
	end
	against(folder, room, "PedestalSink", "door", 11, 0.85)
	local side = if room.x < 0 then -1 else 1
	Props.place(folder, "Mirror", V3(room.x - side * 17.5, room.y + 7.5, room.z + 11), V3(side, 0, 0), 1.6, "wall")
	against(folder, room, "PaintedCabinet", "door", -11, 0.8)
	Props.place(folder, "WoodenLantern", at(16.3, 2, 0), V3(-side, 0, 0), 1.3, "floor")
end

local SHELF_BLOCKS = { Bookshelf = true }
local LIBRARY_PIECES = { Shelf = true, Book = true, ReadingChair = true, LampPole = true, LampShade = true }

local function rearShelves(folder: Instance, root: Instance, room: RoomRef)
	-- Estantes por cima das caixas de colisão do fundo (as caixas continuam lá).
	conceal(root, room, SHELF_BLOCKS)
	for _, ox in { -9.6, -3.2, 3.2, 9.6 } do
		against(folder, room, "Bookshelf", "rear", ox, 1)
	end
end

ROOMS.Library = function(folder, root, room)
	if not has("Bookshelf") then
		return
	end
	rearShelves(folder, root, room)
	conceal(root, room, LIBRARY_PIECES)
	for _, oz in { -12.5, -6.2, 0.1 } do
		against(folder, room, "Bookshelf", "facade", oz, 1)
	end
	local at = roomFrame(room)
	Props.place(folder, "Armchair", at(14.5, 13, 0), V3(-1, 0, -0.5), 1.05, "floor")
	lampOn(folder, room, "facade", 6)
	against(folder, room, "Cabinet", "door", -11, 1)
	local console = against(folder, room, "Console", "door", 11, 1)
	if console then
		local box = console:GetBoundingBox()
		Props.place(
			folder,
			"Candelabra",
			V3(box.Position.X, top(console), box.Position.Z),
			box.LookVector,
			0.6,
			"floor"
		)
	end
end

local function bedroom(folder: Instance, root: Instance, room: RoomRef, bed: string, scale: number)
	if not has(bed) then
		return
	end
	conceal(root, room, { Bed = true, Nightstand = true, LampPole = true, LampShade = true, Wardrobe = true })
	-- Cama no lugar da cama antiga (a colisão antiga continua), cabeceira para a divisória.
	local side = if room.x < 0 then -1 else 1
	Props.place(folder, bed, V3(room.x + 9, room.y, room.z - 8), Vector3.zAxis, scale, "floor")
	lampOn(folder, room, "door", -14)
	against(folder, room, "Cabinet", "facade", 13.2, 0.9)
	local dresser = against(folder, room, "Console", "door", 11, 0.95)
	Props.place(folder, "Mirror", V3(room.x - side * 17.5, room.y + 7.6, room.z + 11), V3(side, 0, 0), 1.5, "wall")
	if dresser then
		local box = dresser:GetBoundingBox()
		Props.place(
			folder,
			"BrassCandle",
			V3(box.Position.X, top(dresser), box.Position.Z + 1.5),
			box.LookVector,
			1.2,
			"floor"
		)
	end
end

ROOMS.Bedroom = function(folder, root, room)
	bedroom(folder, root, room, "GothicBed", 1.15)
	against(folder, room, "TreasureChest", "facade", -2, 0.9)
end

ROOMS.Child = function(folder, root, room)
	bedroom(folder, root, room, "IronBed", 1.2)
	conceal(root, room, { ToyBlock = true, ToyBall = true, TeddyBody = true, TeddyHead = true, Rocking = true })
	local at = roomFrame(room)
	Props.place(folder, "RockingChair", at(14, -2, 0), V3(-1, 0, 0.4), 1.05, "floor")
	against(folder, room, "SeaChest", "facade", 3.5, 0.9)
	Props.place(folder, "RubberDuck", at(-13, 5.5, 0), V3(1, 0, 0.3), 1.6, "floor")
	Props.place(folder, "Suitcase", at(15.6, -14.2, 0), V3(-1, 0, 0), 1, "floor")
end

ROOMS.Office = function(folder, root, room)
	if not has("GothicChair") then
		return
	end
	conceal(root, room, { Desk = true, Paper = true, OfficeChair = true, Shelf = true, Book = true })
	local at = roomFrame(room)
	local desk = against(folder, room, "Console", "facade", -2, 1.05)
	Props.place(folder, "GothicChair", at(12.2, -2, 0), V3(1, 0, 0), 0.8, "floor")
	if desk then
		local box = desk:GetBoundingBox()
		Props.place(
			folder,
			"MantelClock",
			V3(box.Position.X, top(desk), box.Position.Z - 2),
			box.LookVector,
			1.1,
			"floor"
		)
		Props.place(folder, "PipeLamp", V3(box.Position.X, top(desk), box.Position.Z + 2), box.LookVector, 1.3, "floor")
		glow(folder, "LampShade", V3(box.Position.X, top(desk) + 1.6, box.Position.Z + 2), 16, 0.55)
	end
	against(folder, room, "Bookshelf", "door", -11, 1)
	against(folder, room, "Bookshelf", "door", 11, 1)
	lampOn(folder, room, "facade", 13.5)
end

local STORAGE = { Crate = true, Trunk = true, Barrel = true, Chains = true }

-- Depósitos (sala trancada, sótãos, porão): baús e caixas nas paredes, nada no centro.
local function storage(folder: Instance, root: Instance, room: RoomRef, basement: boolean)
	conceal(root, room, STORAGE)
	local at = roomFrame(room)
	against(folder, room, "TreasureChest", "facade", -12.5, 1)
	against(folder, room, if basement then "Barrel" else "SeaChest", "facade", -7.5, 1)
	against(folder, room, "Crate", "facade", -1.5, 1.2)
	Props.place(folder, "Crate", at(16, -1.5, 1.9), V3(-1, 0, 0.2), 1, "floor")
	against(folder, room, if basement then "Barrel" else "Suitcase", "door", -11, 1)
	against(folder, room, "Crate", "door", 11, 1.3)
	Props.place(folder, if basement then "Barrel" else "Suitcase", at(-15.5, 13.5, 0), V3(1, 0, 0.5), 1, "floor")
	local lantern = at(15.6, 13.5, 0)
	Props.place(folder, "WoodenLantern", lantern, V3(-1, 0, 0), 1.3, "floor")
	glow(folder, "Candle", lantern + V3(0, 1.5, 0), 18, 0.55, true)
	if basement then
		Props.place(folder, "BrokenBarrel", at(13.5, -11, 0), V3(-1, 0, 0.3), 0.6, "floor")
	end
end

ROOMS.Locked = function(folder, root, room)
	storage(folder, root, room, false)
end

local function attic(folder: Instance, root: Instance, room: RoomRef)
	storage(folder, root, room, false)
	local at = roomFrame(room)
	Props.place(folder, "RockingChair", at(-13, 11, 0), V3(1, 0, -0.5), 1.05, "floor")
	against(folder, room, "DayBed", "door", -11.5, 0.85)
end

ROOMS.Attic = attic
ROOMS.AtticPhoto = attic
ROOMS.AtticClock = function(folder, root, room)
	storage(folder, root, room, false)
	against(folder, room, "GrandfatherClock", "door", -13, 1)
	against(folder, room, "GrandfatherClock", "door", -8.5, 0.9)
	against(folder, room, "GrandfatherClock", "door", 9, 0.95)
end
ROOMS.AtticBook = function(folder, root, room)
	ROOMS.Library(folder, root, room)
end

ROOMS.Basement = function(folder, root, room)
	storage(folder, root, room, true)
end
ROOMS.Symbols = ROOMS.Basement
ROOMS.Safe = ROOMS.Basement
ROOMS.Tunnel = ROOMS.Basement

local function machinery(folder: Instance, root: Instance, room: RoomRef)
	conceal(root, room, { Machine = true, Gauge = true, Pipe = true })
	local at = roomFrame(room)
	against(folder, room, "Boiler", "facade", -9.5, 1.35)
	against(folder, room, "Boiler", "facade", -0.3, 1.1)
	for _, ox in { -8, 0, 8 } do
		against(folder, room, "PipeRun", "rear", ox, 1.1)
	end
	against(folder, room, "Crate", "door", -11, 1.2)
	local crate = against(folder, room, "Crate", "door", 11, 1.2)
	if crate then
		local box = crate:GetBoundingBox()
		Props.place(folder, "PipeLamp", V3(box.Position.X, top(crate), box.Position.Z), box.LookVector, 1.4, "floor")
		glow(folder, "LampShade", V3(box.Position.X, top(crate) + 1.6, box.Position.Z), 18, 0.6, true)
	end
	Props.place(folder, "Barrel", at(15.5, 13.5, 0), V3(-1, 0, 0), 1, "floor")
end

ROOMS.Machine = machinery
ROOMS.Mechanism = machinery

ROOMS.Ritual = function(folder, root, room)
	conceal(root, room, { Candle = true, Flame = true })
	-- Velas de latão no círculo e candelabros nos cantos (as luzes antigas continuam acesas).
	for index = 0, 7 do
		local angle = (index + 0.5) / 8 * math.pi * 2
		Props.place(
			folder,
			"BrassCandle",
			V3(room.x + math.cos(angle) * 8.5, room.y, room.z + math.sin(angle) * 8.5),
			V3(0, 0, 1),
			1.2,
			"floor"
		)
	end
	local at = roomFrame(room)
	for _, oz in { -13.5, 13.5 } do
		Props.place(folder, "Candelabra", at(15.8, oz, 0), V3(-1, 0, 0), 1.1, "floor")
		glow(folder, "Candle", at(15.8, oz, 4), 16, 0.6, true)
	end
	for _, ox in { -9.6, 9.6 } do
		against(folder, room, "Bookshelf", "rear", ox, 1)
	end
end

-- Em todos os cômodos: tapete persa no centro, mesa baixa no lugar da mesa antiga, janela na fachada
-- e guarda-roupa por cima do armário-esconderijo (a porta interativa continua a mesma, invisível).
--[[
	O modelo do guarda-roupa é uma peça só. Para a porta abrir junto com o esconderijo, uma folha de porta
	fica soldada à HideDoor (que o WorldService.swingLocker gira) e, atrás dela, um fundo escuro aparece
	quando ela abre. A folha fica atrás da câmera de quem está escondido (olho 0,1 stud à frente da porta).
]]
local function wardrobeDoor(folder: Instance, door: BasePart)
	local frontZ = door.Size.Z / 2
	local function piece(name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material): BasePart
		local part = Build.part(folder, name, size, door.CFrame * CFrame.new(offset), color, {
			material = material,
			collide = false,
			query = false,
		})
		part.CanTouch = false
		return part
	end
	piece(
		"WardrobeInterior",
		V3(door.Size.X - 0.1, door.Size.Y - 0.1, 0.02),
		V3(0, 0, frontZ + 0.02),
		rgb(16, 12, 10),
		Enum.Material.SmoothPlastic
	)
	local leaf = piece(
		"WardrobeLeaf",
		V3(door.Size.X, door.Size.Y, 0.06),
		V3(0, 0, frontZ + 0.09),
		rgb(200, 196, 192),
		Enum.Material.Wood
	)
	leaf.MaterialVariant = "MansionDarkWood"
	local parts = { leaf }
	-- Duas almofadas rebaixadas e a maçaneta de latão.
	for _, y in { -door.Size.Y * 0.22, door.Size.Y * 0.22 } do
		local inset = piece(
			"WardrobeLeafPanel",
			V3(door.Size.X * 0.7, door.Size.Y * 0.36, 0.03),
			V3(0, y, frontZ + 0.135),
			rgb(150, 140, 132),
			Enum.Material.Wood
		)
		inset.MaterialVariant = "MansionDarkWood"
		table.insert(parts, inset)
	end
	local knob = piece(
		"WardrobeKnob",
		V3(0.22, 0.22, 0.18),
		V3(door.Size.X * 0.36, 0, frontZ + 0.21),
		rgb(168, 132, 70),
		Enum.Material.Metal
	)
	table.insert(parts, knob)
	for _, part in parts do
		part.Anchored, part.Massless = false, true
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = door, part
		weld.Parent = part
	end
end

local function common(folder: Instance, root: Instance, room: RoomRef)
	local basement = room.y < 0
	conceal(root, room, { Rug = true, AntiqueTable = true, Cord = true })
	if not basement and room.id ~= "Bath" and room.id ~= "Kitchen" and room.id ~= "Machine" then
		Props.place(folder, "PersianRug", V3(room.x, room.y + 0.02, room.z + 1), Vector3.zAxis, 0.8, "floor")
	end
	Props.place(folder, "LowTable", V3(room.x, room.y, room.z - 11), Vector3.zAxis, 0.8, "floor")
	window(folder, room)
	local features = root:FindFirstChild("Features")
	local cabinet = features and features:FindFirstChild(`hide_{room.id}`)
	local door = cabinet and cabinet:FindFirstChild("HideDoor")
	if cabinet and door and door:IsA("BasePart") and door.Transparency < 0.5 and has("Wardrobe") then
		-- A fresta da câmera fica 0,1 stud à frente da porta: a frente do guarda-roupa fica no mesmo plano.
		local front = door.Position + V3(0, -door.Size.Y / 2, door.Size.Z / 2)
		local model = Props.place(folder, "Wardrobe", front, Vector3.zAxis, 0.85, "floor")
		if model then
			local box, size = model:GetBoundingBox()
			model:PivotTo(model:GetPivot() + V3(0, 0, front.Z - (box.Position.Z + size.Z / 2)))
			for _, part in cabinet:GetChildren() do
				if part:IsA("BasePart") then
					part.Transparency = 1
				end
			end
			wardrobeDoor(folder, door)
		end
	end
end

-- Luz noturna: a esfera neon vira uma lamparina pendurada (a luz continua na peça antiga).
local function nightLights(folder: Instance, root: Instance)
	local dressing = root:FindFirstChild("Dressing")
	if not dressing then
		return
	end
	for _, orb in dressing:GetChildren() do
		if orb:IsA("BasePart") and orb.Name == "NightLight" then
			if Props.place(folder, "Lantern", orb.Position + UP * 1.2, -Vector3.zAxis, 1.9, "ceiling") then
				orb.Transparency = 1
				orb:SetAttribute("VisualReplaced", true)
				-- A esfera neon iluminava o cômodo pelo brilho; a lamparina ganha luz própria.
				glow(folder, "HallChandelier", orb.Position - UP * 0.4, 34, 0.8, true)
			end
		elseif orb:IsA("BasePart") and orb.Name == "PictureFrame" then
			-- Centros dos cômodos em z = −4, −36, −68: o quadro de trás (oz −6) cede o lugar à janela.
			local roomZ = -4 - 32 * math.round((-4 - orb.Position.Z) / 32)
			-- No porão (tijolo) não há quadros.
			local behind = orb.Position.Z < roomZ or orb.Position.Y < 0
			local inward = Vector3.new(-math.sign(orb.Position.X), 0, 0)
			local wall = orb.Position - inward * (orb.Size.X / 2)
			local name = FRAMES[math.floor(math.abs(orb.Position.Z)) % #FRAMES + 1]
			if behind or Props.place(folder, name, wall, inward, 1.7, "wall") then
				orb.Transparency = 1
				for _, sibling in dressing:GetChildren() do
					if sibling:IsA("BasePart") and sibling.Name == "Picture" and sibling.Position == orb.Position then
						sibling.Transparency = 1
					end
				end
			end
		end
	end
end

function Props.build(root: Instance)
	local old = root:FindFirstChild("Props")
	if old then
		old:Destroy()
	end
	if not library() then
		return
	end
	local folder = Build.folder(root, "Props")
	hall(folder)
	corridors(folder)
	for _, room in House.Rooms do
		if room.id == "Exterior" or room.id == "Hall" then
			continue
		end
		common(folder, root, room)
		local dress = ROOMS[room.id]
		if dress then
			dress(folder, root, room)
		end
	end
	nightLights(folder, root)
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="501">
          <Properties>
            <string name="Name">HouseScenery</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Cenário da casa do Tung Tung, montado depois do HouseBuilder (só visual, sem regras de jogo):
	- Terreno: gramado ao redor da casa, colinas no horizonte, pedras e uma trilha de terra até o portão.
	- Floresta: árvores arredondadas em tons de verde/azulado, arbustos e cogumelos que brilham.
	- Clima "assustador divertido": abóboras acesas, postes com luz quente, vaga-lumes, lápides fofas.
	- Casa repintada (lilás, telhado roxo, janelas acesas) e luzes noturnas coloridas em cada cômodo.

	Regras de convivência com a navegação (testes HouseNavigation):
	- Nada colide dentro da casa (tapetes, quadros e luzes têm CanCollide = false e CanQuery = false).
	- Fora da casa, obstáculos ficam longe da trilha central (|x| < 22) e da saída (z 90..130).
	- O terreno nunca entra na projeção da casa (inclusive o porão).
]]

local House = require("@game/ReplicatedStorage/Shared/Game/HouseCatalog")
local Build = require("./Build")
local Exterior = require("./HouseExterior")
local Furniture = require("./HouseFurniture")
local Ground = require("./HouseGround")
local Finish = require("./HouseFinish")
local Materials = require("./HouseMaterials")
local Props = require("./HouseProps")

local Scenery = {}

local rgb = Color3.fromRGB
local SEED = 90312

-- Projeção da casa (com folga): o terreno não entra aqui.
local HOUSE_MIN = Vector2.new(-48, -88)
local HOUSE_MAX = Vector2.new(48, 68)
-- Área livre de obstáculos: trilha da entrada até a saída da floresta.
local PATH_HALF_WIDTH = 22
local EXIT_Z = Vector2.new(60, 135)

local GRASS = rgb(61, 88, 64)
local WALL = rgb(133, 126, 117)
local WALL_DARK = rgb(112, 111, 105)
local ROOF = rgb(55, 58, 69)
local TRIM = rgb(183, 161, 119)
local FLOOR = rgb(92, 67, 49)
local WINDOW = rgb(206, 166, 112)

local WALL_NAMES = {
	Facade = true,
	DoorWall = true,
	RoomPartition = true,
	RearWall = true,
	StairFacade = true,
	EntrySide = true,
	EntryLintel = true,
	DoorLintel = true,
	WindowSide = true,
}
local TRIM_NAMES = { FacadeSill = true, FacadeTop = true }
local FLOOR_NAMES = {
	CorridorFloor = true,
	ReturnWalkway = true,
	SouthLanding = true,
	NorthLanding = true,
	RoomFloor = true,
}
local GROUND_NAMES = { Garden = true, SideGarden = true, BackGarden = true }

local function inside(x: number, z: number, margin: number): boolean
	return x > HOUSE_MIN.X - margin
		and x < HOUSE_MAX.X + margin
		and z > HOUSE_MIN.Y - margin
		and z < HOUSE_MAX.Y + margin
end

local function onPath(x: number, z: number): boolean
	return math.abs(x) < PATH_HALF_WIDTH and z > EXIT_Z.X and z < EXIT_Z.Y
end

local function decor(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
)
	local part = Build.part(parent, name, size, cframe, color, {
		material = material or Enum.Material.SmoothPlastic,
		collide = false,
		query = false,
	})
	part.CanTouch = false
	return part
end

local function ball(
	parent: Instance,
	name: string,
	center: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?
)
	local part = decor(parent, name, Vector3.new(diameter, diameter, diameter), CFrame.new(center), color, material)
	local sphere = part :: Part
	sphere.Shape = Enum.PartType.Ball
	return part
end

local function glow(part: BasePart, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = part
	return light
end

-- Repinta a arquitetura existente sem mudar tamanho, posição ou colisão.
local function restyle(root: Instance)
	for _, part in root:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		if WALL_NAMES[part.Name] then
			part.Color = if part.Name == "RoomPartition" then WALL_DARK else WALL
			part.Material = if part.Position.Y < 0 then Enum.Material.Brick else Enum.Material.Plaster
		elseif TRIM_NAMES[part.Name] then
			part.Color = TRIM
			part.Material = Enum.Material.Wood
		elseif FLOOR_NAMES[part.Name] then
			part.Color = FLOOR
		elseif part.Name == "RoomCeiling" then
			part.Material = Enum.Material.Plaster
		elseif part.Name == "HouseRoof" or part.Name == "StairRoof" then
			part.Color = ROOF
			part.Material = Enum.Material.Slate
		elseif part.Name == "WindowGlass" then
			-- Janelas acesas por dentro: a casa "chama" o jogador de longe.
			part.Color = WINDOW
			part.Material = Enum.Material.Glass
			part.Transparency = 0.3
		elseif GROUND_NAMES[part.Name] then
			part.Color = GRASS
			part.Material = Enum.Material.Grass
		elseif part.Name == "ForestGround" then
			part.Transparency = 1
		elseif part.Name == "Plaque" then
			local text = part:FindFirstChildWhichIsA("TextLabel", true)
			if text then
				text.Font = Enum.Font.SpecialElite
				text.TextColor3 = rgb(255, 214, 80)
				text.BackgroundColor3 = rgb(42, 34, 29)
			end
			part.Color = rgb(42, 34, 29)
		elseif part.Name == "TreeTrunk" or part.Name == "TreeCrown" then
			-- As árvores-caixa antigas dão lugar às árvores novas (mesmo lugar, mesmo tronco).
			part:Destroy()
		end
	end
end

local function terrain()
	local t = workspace.Terrain
	t:Clear()
	t:SetMaterialColor(Enum.Material.Grass, GRASS)
	t:SetMaterialColor(Enum.Material.LeafyGrass, rgb(62, 112, 76))
	t:SetMaterialColor(Enum.Material.Ground, rgb(108, 82, 58))
	t:SetMaterialColor(Enum.Material.Rock, rgb(104, 100, 120))
	local top, depth = -0.7, 8
	local y = top - depth / 2
	local extent = 230
	-- Quatro placas em volta da projeção da casa (nada de terreno dentro do porão).
	local slabs = {
		{ Vector2.new(-extent, HOUSE_MAX.Y), Vector2.new(extent, extent) },
		{ Vector2.new(-extent, -extent), Vector2.new(extent, HOUSE_MIN.Y) },
		{ Vector2.new(-extent, HOUSE_MIN.Y), Vector2.new(HOUSE_MIN.X, HOUSE_MAX.Y) },
		{ Vector2.new(HOUSE_MAX.X, HOUSE_MIN.Y), Vector2.new(extent, HOUSE_MAX.Y) },
	}
	for _, slab in slabs do
		local min, max = slab[1], slab[2]
		local size = Vector3.new(max.X - min.X, depth, max.Y - min.Y)
		local center = Vector3.new((min.X + max.X) / 2, y, (min.Y + max.Y) / 2)
		t:FillBlock(CFrame.new(center), size, Enum.Material.Grass)
	end
	-- Trilha de terra da chegada até a floresta.
	t:FillBlock(CFrame.new(0, top - 1.9, 104), Vector3.new(14, 4, 76), Enum.Material.Ground)
	local rng = Random.new(SEED)
	-- Colinas no horizonte: escondem a borda do mundo e emolduram a casa.
	for index = 1, 46 do
		local angle = (index / 46) * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local radius = rng:NextNumber(185, 215)
		local center = Vector3.new(math.cos(angle) * radius, rng:NextNumber(-22, -8), 10 + math.sin(angle) * radius)
		t:FillBall(
			center,
			rng:NextNumber(30, 46),
			if index % 3 == 0 then Enum.Material.LeafyGrass else Enum.Material.Grass
		)
	end
	-- Pedras espalhadas fora da área de jogo.
	for _ = 1, 26 do
		local x, z = rng:NextNumber(-170, 170), rng:NextNumber(-160, 180)
		if not inside(x, z, 20) and not onPath(x, z) and (math.abs(x) > 112 or z > 134 or z < -124) then
			t:FillBall(Vector3.new(x, top, z), rng:NextNumber(2.5, 5), Enum.Material.Rock)
		end
	end
end

-- Folhagem noturna, escura e pouco saturada (silhueta contra o céu, sem cara de brinquedo).
local LEAF_COLORS = { rgb(38, 64, 48), rgb(46, 74, 54), rgb(34, 58, 60), rgb(52, 70, 44) }
local BARK = rgb(64, 50, 42)

-- Construções do GeneratedEstate e cemitério nos jardins laterais: nenhuma árvore nasce dentro delas.
local OCCUPIED = {
	{ 60, 92, 8, 40 }, -- pavilhões leste/oeste (espelhados em x)
	{ 60, 92, -60, -28 },
	{ 83, 105, -4, 50 }, -- mirante e escada do jardim (o lado muda com o nível)
	{ -106, -88, 50, 78 }, -- cemitério (só oeste)
}

local function occupied(x: number, z: number): boolean
	for index, rect in OCCUPIED do
		local px = if index <= 3 then math.abs(x) else x
		if px > rect[1] and px < rect[2] and z > rect[3] and z < rect[4] then
			return true
		end
	end
	-- Cerca da frente (z = 80) e trilha do jardim.
	return math.abs(z - 80) < 4
end

local function tree(parent: Instance, position: Vector3, height: number, rng: Random)
	local model = Build.model(parent, "Tree")
	local trunk = Build.cylinder(
		model,
		"Trunk",
		position + Vector3.new(0, height / 2, 0),
		Vector3.yAxis,
		height,
		2.6,
		BARK,
		{ material = Enum.Material.Wood }
	)
	trunk.CanQuery = false
	local color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)]
	local crown = position + Vector3.new(0, height, 0)
	ball(model, "Crown", crown, rng:NextNumber(12, 16), color, Enum.Material.LeafyGrass)
	for _ = 1, 3 do
		local offset = Vector3.new(rng:NextNumber(-5, 5), rng:NextNumber(-3, 3), rng:NextNumber(-5, 5))
		ball(
			model,
			"Crown",
			crown + offset,
			rng:NextNumber(7, 11),
			color:Lerp(rgb(14, 24, 20), 0.2),
			Enum.Material.LeafyGrass
		)
	end
end

-- Árvore seca de galhos retorcidos (jardim da casa). Só o tronco colide, como as árvores antigas.
local function deadTree(parent: Instance, position: Vector3, height: number, rng: Random)
	local model = Build.model(parent, "Tree")
	local trunk = Build.cylinder(
		model,
		"Trunk",
		position + Vector3.new(0, height / 2, 0),
		Vector3.yAxis,
		height,
		2.2,
		BARK,
		{ material = Enum.Material.Wood }
	)
	trunk.CanQuery = false
	local function branch(from: Vector3, direction: Vector3, length: number, diameter: number, depth: number)
		local tip = from + direction * length
		local part = Build.cylinder(model, "Branch", (from + tip) / 2, direction, length, diameter, BARK, {
			material = Enum.Material.Wood,
			collide = false,
			query = false,
		})
		part.CanTouch = false
		if depth <= 0 then
			return
		end
		for _ = 1, 2 do
			local bend = Vector3.new(rng:NextNumber(-0.8, 0.8), rng:NextNumber(0.1, 0.7), rng:NextNumber(-0.8, 0.8))
			branch(tip, (direction + bend).Unit, length * 0.62, diameter * 0.6, depth - 1)
		end
	end
	for index = 1, 4 do
		local angle = index * math.pi / 2 + rng:NextNumber(-0.5, 0.5)
		local out = Vector3.new(math.cos(angle), rng:NextNumber(0.5, 1.1), math.sin(angle)).Unit
		branch(position + Vector3.yAxis * height * rng:NextNumber(0.55, 0.95), out, height * 0.32, 1.1, 1)
	end
end

local function forest(parent: Instance)
	-- Não pode se chamar "Forest": ForestBuilder.clear apaga essa pasta a cada capítulo.
	local folder = Build.folder(parent, "GardenTrees")
	local rng = Random.new(SEED + 1)
	-- Mesmos lugares das árvores antigas do jardim lateral, sem as que caíam dentro dos pavilhões.
	for i = 1, 28 do
		local x = if i % 2 == 0 then -67 - i % 4 * 8 else 67 + i % 4 * 8
		local z = -105 + i * 8
		if not occupied(x, z) then
			if i % 3 == 0 then
				tree(folder, Vector3.new(x, -0.5, z), 20 + i % 4 * 2, rng)
			else
				deadTree(folder, Vector3.new(x, -0.5, z), 18 + i % 4 * 2, rng)
			end
		end
	end
	-- Floresta externa, além dos jardins.
	local placed = 0
	while placed < 70 do
		local x, z = rng:NextNumber(-175, 175), rng:NextNumber(-165, 185)
		local outside = math.abs(x) > 112 or z > 134 or z < -124
		if outside and not inside(x, z, 24) and not onPath(x, z) then
			tree(folder, Vector3.new(x, -0.7, z), rng:NextNumber(18, 30), rng)
			placed += 1
		end
	end
	-- Arbustos e cogumelos que brilham (pontos de cor no escuro).
	for _ = 1, 40 do
		local x, z = rng:NextNumber(-104, 104), rng:NextNumber(-116, 126)
		if not inside(x, z, 6) and not onPath(x, z) and not occupied(x, z) then
			if rng:NextNumber() < 0.6 then
				ball(
					folder,
					"Bush",
					Vector3.new(x, 0.6, z),
					rng:NextNumber(3, 5),
					LEAF_COLORS[rng:NextInteger(1, 4)],
					Enum.Material.Grass
				)
			else
				local hue = if rng:NextNumber() < 0.5 then rgb(120, 255, 210) else rgb(255, 120, 230)
				local cap = decor(
					folder,
					"GlowShroom",
					Vector3.new(1.6, 0.7, 1.6),
					CFrame.new(x, 1.2, z),
					hue,
					Enum.Material.Neon
				)
				local capShape = cap :: Part
				capShape.Shape = Enum.PartType.Cylinder
				cap.CFrame = CFrame.new(x, 1.2, z) * CFrame.Angles(0, 0, math.rad(90))
				decor(folder, "Stem", Vector3.new(0.5, 1, 0.5), CFrame.new(x, 0.4, z), rgb(236, 226, 210))
			end
		end
	end
end

local function fireflies(parent: Instance, center: Vector3, spread: Vector3)
	local anchor = decor(parent, "Fireflies", spread, CFrame.new(center), rgb(0, 0, 0))
	anchor.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter:SetAttribute("VisualOptional", true)
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	emitter.Rate = 7
	emitter.Lifetime = NumberRange.new(4, 7)
	emitter.Speed = NumberRange.new(0.3, 1)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Color = ColorSequence.new(rgb(230, 255, 120))
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, 0.22),
		NumberSequenceKeypoint.new(0.8, 0.22),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = anchor
end

local function exterior(parent: Instance)
	local folder = Build.folder(parent, "Yard")
	-- Fachada, varanda, caminho, postes, abóboras e lápides ficam em HouseExterior.
	fireflies(folder, Vector3.new(0, 4, 100), Vector3.new(60, 6, 50))
	fireflies(folder, Vector3.new(-80, 4, 0), Vector3.new(30, 6, 160))
	fireflies(folder, Vector3.new(80, 4, 0), Vector3.new(30, 6, 160))
end

-- Portão da floresta: grades de ferro dentro do mesmo Model (sobem junto quando o portão abre)
-- e pilares de pedra fixos. A placa original continua sendo a colisão, só que invisível.
local function forestGate(root: Instance)
	local model = root:FindFirstChild("ForestGate")
	local panel = model and model:FindFirstChild("Gate")
	if not model or not panel or not panel:IsA("BasePart") then
		return
	end
	panel.Transparency = 1
	local base = panel.CFrame
	local iron = rgb(46, 40, 58)
	for step = -8, 8, 1.6 do
		decor(model, "GateBar", Vector3.new(0.35, 10, 0.35), base * CFrame.new(step, 0, 0), iron, Enum.Material.Metal)
		decor(
			model,
			"GateSpike",
			Vector3.new(0.5, 0.8, 0.5),
			base * CFrame.new(step, 5.3, 0),
			rgb(255, 200, 70),
			Enum.Material.Metal
		)
	end
	for _, y in { -3.5, 3.5 } do
		decor(model, "GateRail", Vector3.new(18, 0.5, 0.5), base * CFrame.new(0, y, 0), iron, Enum.Material.Metal)
	end
	local folder = Build.folder(root, "GatePillars")
	for _, x in { -12.5, 12.5 } do
		local pillar =
			Build.part(folder, "GatePillar", Vector3.new(3, 13, 3), base * CFrame.new(x, 1.5, 0), rgb(96, 62, 52), {
				material = Enum.Material.Brick,
			})
		pillar.CanQuery = false
		-- Capitel de pedra e lanterna de ferro no topo (a luz continua na esfera, agora invisível).
		decor(
			folder,
			"GatePillarCap",
			Vector3.new(3.8, 0.7, 3.8),
			pillar.CFrame * CFrame.new(0, 6.85, 0),
			rgb(118, 114, 106),
			Enum.Material.Slate
		)
		local orb = decor(
			folder,
			"GateLamp",
			Vector3.new(1.6, 1.6, 1.6),
			pillar.CFrame * CFrame.new(0, 8.6, 0),
			rgb(219, 182, 124),
			Enum.Material.Neon
		)
		local orbShape = orb :: Part
		orbShape.Shape = Enum.PartType.Ball
		if
			Props.place(
				folder,
				"Lantern",
				(pillar.CFrame * CFrame.new(0, 7.2, 0)).Position,
				base.LookVector,
				2.2,
				"floor"
			)
		then
			orb.Transparency = 1
		end
		glow(orb, rgb(235, 193, 133), 18, 0.65)
	end
end

local NIGHT_COLORS = { rgb(148, 178, 207), rgb(193, 152, 154), rgb(153, 184, 161), rgb(221, 187, 137) }
local RUG_COLORS = { rgb(160, 52, 72), rgb(52, 88, 150), rgb(64, 120, 84), rgb(130, 76, 150) }

local function interior(parent: Instance)
	local folder = Build.folder(parent, "Dressing")
	for index, room in House.Rooms do
		if room.id == "Exterior" or room.id == "Hall" then
			continue
		end
		local floor = room.y - 0.45
		local side = if room.x < 0 then -1 else 1
		-- Tapete no meio do cômodo.
		decor(
			folder,
			"Rug",
			Vector3.new(14, 0.08, 10),
			CFrame.new(room.x + side * 2, floor, room.z + 1),
			RUG_COLORS[(index % #RUG_COLORS) + 1],
			Enum.Material.Fabric
		)
		-- Quadros na parede do fundo do cômodo (lado oposto à porta).
		for slot = -1, 1, 2 do
			local frame = decor(
				folder,
				"PictureFrame",
				Vector3.new(0.3, 3.4, 2.8),
				CFrame.new(room.x + side * 17.3, room.y + 7, room.z + slot * 6),
				rgb(196, 150, 70),
				Enum.Material.Wood
			)
			decor(
				folder,
				"Picture",
				Vector3.new(0.32, 2.6, 2),
				frame.CFrame,
				NIGHT_COLORS[((index + slot) % #NIGHT_COLORS) + 1]:Lerp(rgb(40, 30, 60), 0.5),
				Enum.Material.SmoothPlastic
			)
		end
		-- Luz noturna colorida: o cômodo é legível mesmo sem energia (sem tela preta).
		local color = NIGHT_COLORS[(index % #NIGHT_COLORS) + 1]
		local hang = Vector3.new(room.x + side * 3, room.y + 12, room.z + 3)
		decor(folder, "Cord", Vector3.new(0.1, 2.5, 0.1), CFrame.new(hang + Vector3.new(0, 1.9, 0)), rgb(40, 34, 50))
		local orb = decor(folder, "NightLight", Vector3.new(1.4, 1.4, 1.4), CFrame.new(hang), color, Enum.Material.Neon)
		local orbShape = orb :: Part
		orbShape.Shape = Enum.PartType.Ball
		glow(orb, color:Lerp(rgb(235, 216, 188), 0.65), 23, 0.35)
	end
end

function Scenery.build(root: Instance)
	restyle(root)
	terrain()
	forest(root)
	exterior(root)
	forestGate(root)
	interior(root)
	Furniture.build(root)
	Finish.build(root)
	Props.build(root)
	Materials.build(root)
	Exterior.build(root)
	Ground.build(root)
	local sky = game:GetService("Lighting"):FindFirstChildOfClass("Sky")
	if sky then
		sky.MoonAngularSize = 18
		sky.StarCount = 3000
	end
end

return Scenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="502">
          <Properties>
            <string name="Name">HouseTaskProps</string>
            <string name="Source"><![CDATA[--!strict
-- Silhuetas reconhecíveis para pistas/objetos. Detalhes não roubam o raycast do alvo.
local Build = require("./Build")
local Props = {}
local V3 = Vector3.new
local brass = Color3.fromRGB(190, 153, 78)
local paper = Color3.fromRGB(204, 190, 147)
local dark = Color3.fromRGB(46, 43, 46)
local function part(parent: Instance, name: string, p: Vector3, size: Vector3, color: Color3)
	local metal = string.find(name, "Key")
		or string.find(name, "Cap")
		or string.find(name, "Flashlight")
		or name == "FuseCabinet"
	local ceramic = string.find(name, "Fuse") or name == "PorcelainMask"
	return Build.block(parent, name, p, size, 0, color, {
		collide = false,
		query = false,
		material = if metal
			then Enum.Material.Metal
			elseif ceramic then Enum.Material.Marble
			else Enum.Material.SmoothPlastic,
	})
end
function Props.build(parent: Instance, p: Vector3, item: string?, kind: string)
	local center = p + V3(0, 1.8, 0)
	if item == "forest_battery" then
		part(parent, "RescueBattery", center, V3(2.7, 1.8, 1.6), dark)
		for _, side in { -1, 1 } do
			part(parent, "BatteryTerminal", center + V3(side * 0.8, 1.8, 0), V3(0.35, 0.4, 0.35), brass)
		end
	elseif item == "forest_antenna" then
		part(parent, "Antenna", center, V3(4.5, 0.2, 0.2), brass)
		for i = 1, 4 do
			part(parent, "AntennaBar", center + V3(-2.5 + i, 0, 0), V3(0.15, 0.15, 2.5), dark)
		end
	elseif item == "forest_crank" then
		Build.cylinder(
			parent,
			"WinchWheel",
			center + V3(0, 0.2, 0),
			Vector3.yAxis,
			0.3,
			2.3,
			brass,
			{ collide = false, query = false }
		)
		part(parent, "CrankHandle", center + V3(0.8, 0.4, 0), V3(0.3, 0.7, 0.3), dark)
	elseif item == "forest_tape" then
		part(parent, "GuardCassette", center, V3(3, 0.4, 1.8), dark)
		for _, side in { -1, 1 } do
			Build.cylinder(
				parent,
				"TapeReel",
				center + V3(side * 0.7, 0.45, 0),
				Vector3.yAxis,
				0.1,
				0.7,
				paper,
				{ collide = false, query = false }
			)
		end
	elseif item == "forest_map" then
		part(parent, "TornMap", center, V3(3.3, 0.15, 2.7), paper)
		for i = 1, 3 do
			part(parent, "MapTrail", center + V3(-1.4 + i * 0.65, 0.16, 0), V3(0.14, 0.03, 1.7), dark)
		end
	elseif kind == "puzzle" and p.Z > 500 then
		part(parent, "RadioReceiver", center + V3(0, 0, -0.8), V3(7, 2.5, 1.5), dark)
		part(parent, "FrequencyDial", center + V3(0, 1.2, 0), V3(5.5, 0.6, 0.2), paper)
	elseif item and string.find(item, "key", 1, true) then
		part(parent, "KeyShaft", center + V3(0, 0, 0.9), V3(0.25, 0.2, 2), brass)
		part(parent, "KeyTooth", center + V3(0.3, 0, 1.6), V3(0.7, 0.2, 0.3), brass)
	elseif kind == "repair" then
		part(parent, "FuseCabinet", p + V3(0, 1, -0.8), V3(7, 3, 0.5), dark)
		for i = 1, 3 do
			part(parent, "CeramicFuse", center + V3((i - 2) * 1.8, 0, 0), V3(0.5, 1.7, 0.5), paper)
		end
	elseif item == "clock" then
		Build.cylinder(
			parent,
			"ClockFace",
			center + V3(0, 1, -0.3),
			Vector3.zAxis,
			0.4,
			3,
			paper,
			{ collide = false, query = false }
		)
		part(parent, "ClockHand", center + V3(0, 0.2, 0), V3(0.12, 1.1, 0.12), dark)
		part(parent, "ClockHand", center + V3(0, 1, 0), V3(0.9, 0.12, 0.12), dark)
	elseif item == "photo" then
		part(parent, "PhotoFrame", center, V3(3, 2.6, 0.25), brass)
		part(parent, "PhotoPaper", center + V3(0, 0.2, 0.2), V3(2.6, 2.2, 0.12), paper)
		for i = -1, 1 do
			part(parent, "FamilySilhouette", center + V3(i * 0.7, 0.4, 0.36), V3(0.5, 1.2, 0.1), dark)
		end
	elseif item == "mask" then
		part(parent, "PorcelainMask", center, V3(2.5, 3, 0.6), paper)
		for _, side in { -1, 1 } do
			part(parent, "MaskEye", center + V3(side * 0.65, 1.7, 0.6), V3(0.5, 0.35, 0.12), dark)
		end
	elseif kind == "clue" then
		part(parent, "OpenBookLeft", center + V3(-0.9, 0, 0), V3(1.8, 0.2, 2.6), paper)
		part(parent, "OpenBookRight", center + V3(0.9, 0, 0), V3(1.8, 0.2, 2.6), paper)
	elseif item == "artifact" then
		local gem = part(parent, "HouseHeart", center + V3(0, 0.6, 0), V3(2, 2, 2), Color3.fromRGB(137, 63, 70))
		gem.CFrame *= CFrame.Angles(0, 0, math.rad(45))
	elseif item and string.find(item, "fuse", 1, true) then
		part(parent, "FuseBody", center, V3(2.4, 0.7, 0.7), paper)
		for _, side in { -1, 1 } do
			part(parent, "FuseCap", center + V3(side, 0, 0), V3(0.4, 0.7, 0.7), brass)
		end
	elseif item == "flashlight" then
		part(parent, "FlashlightBody", center, V3(2.8, 0.7, 0.8), dark)
		part(parent, "FlashlightLens", center + V3(1.2, 0, 0), V3(0.3, 1.1, 1.2), brass)
	end
end
return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="503">
          <Properties>
            <string name="Name">HouseTelevision</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Build = require("./Build")
local Television = {}
function Television.build(parent: Instance)
	local model = Build.model(parent, "Television")
	local options = { material = Enum.Material.Wood, collide = false, query = false }
	local function box(name: string, center: Vector3, size: Vector3, color: Color3)
		return Build.part(model, name, size, CFrame.new(center), color, options)
	end
	box("Cabinet", Vector3.new(-35, 2, -17), Vector3.new(7, 4, 2.8), Color3.fromRGB(66, 47, 36))
	box("CrtBody", Vector3.new(-35, 5.3, -17), Vector3.new(6.4, 3.6, 2.5), Color3.fromRGB(38, 36, 34))
	local screen = Build.sign(
		model,
		"BroadcastScreen",
		Vector3.new(-35.5, 5.3, -15.7),
		Vector3.zAxis,
		Vector2.new(4.5, 2.7),
		"CANAL 03\nSEM SINAL",
		{
			textColor = Color3.fromRGB(162, 205, 178),
			background = Color3.fromRGB(12, 24, 21),
			font = Enum.Font.Code,
			lit = true,
			pixelsPerStud = 90,
		}
	)
	screen.CanQuery = false
	local gui = screen:FindFirstChildOfClass("SurfaceGui")
	assert(gui, "Missing television surface")
	gui.Brightness = 0.8
	local scan = Instance.new("Frame")
	scan.Name, scan.BorderSizePixel = "Scan", 0
	scan.Size = UDim2.fromScale(1, 0.025)
	scan.BackgroundColor3, scan.BackgroundTransparency = Color3.fromRGB(160, 210, 175), 0.88
	scan.Parent = gui
	for _, y in { 4.6, 5.8 } do
		Build.cylinder(
			model,
			"Tuner",
			Vector3.new(-32.6, y, -15.6),
			Vector3.zAxis,
			0.3,
			0.5,
			Color3.fromRGB(154, 137, 104),
			{ collide = false, query = false }
		)
	end
	CollectionService:AddTag(screen, "HouseTelevision")
	Build.light(screen, "Street", Color3.fromRGB(143, 190, 165), 10, 0.25, true)
end
return Television
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="504">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Planta da Subestação 9 — só dados (testados no Lune). O MapBuilder transforma isto em peças.
	Diagrama abaixo: núcleo original. Alas e circuito completo: docs/MAP_EXPANSION.md.

	Eixos: X = leste(+)/oeste(-); Z = sul(+)/norte(-); piso interno e pátio com topo em y = 0.

	      N (-Z)
	  +------------------+----------------------+   z = -50
	  |  SALA DO GERADOR |       DEPÓSITO        |
	  |   (quadro)       |      (fusível)        |
	  +------[porta]-----+---------[porta]-------+   z = -26
	  |                  CORREDOR                |
	  +--[porta]---+-----[  ]-----+---[  ]-------+   z = -18
	  | ESCRITÓRIO [  ] RECEPÇÃO [  ]   BOMBAS   |
	  | (fusível)  |             |   (fusível)   |
	  +------------+----[  ]-----+---------------+   z = 0   (fachada)
	  |                  PÁTIO  (início)         |
	  +-------------------[portão]---------------+   z = 44  (cerca)
	  x=-40       x=-12        x=4             x=40
]]

export type Rect = { x0: number, x1: number, z0: number, z1: number }
export type Point = { x: number, y: number, z: number }
export type Opening = { center: number, width: number, bottom: number, top: number }
export type Wall = {
	id: string,
	-- "X": parede ao longo de X em z = at;  "Z": parede ao longo de Z em x = at.
	axis: "X" | "Z",
	at: number,
	from: number,
	to: number,
	exterior: boolean,
	openings: { Opening },
}
export type Door = {
	id: string,
	wall: string,
	center: number,
	width: number,
	-- Lado da dobradiça (true = lado de menor coordenada na parede).
	hingeAtMin: boolean,
	-- Para que lado abre: +1 = +Z (paredes "X") / +X (paredes "Z"); -1 = o contrário.
	side: number,
	-- Começa aberta?
	open: boolean,
}
export type Room = Rect & { id: string, label: string }

local CEILING = 11
local DOOR_TOP = 9
local DOOR_WIDTH = 6
local WINDOW: Opening = { center = 0, width = 5, bottom = 3.5, top = 7 }

local function door(center: number): Opening
	return { center = center, width = DOOR_WIDTH, bottom = 0, top = DOOR_TOP }
end

local function window(center: number): Opening
	return { center = center, width = WINDOW.width, bottom = WINDOW.bottom, top = WINDOW.top }
end

local Layout = {}

Layout.CEILING = CEILING
Layout.DOOR_TOP = DOOR_TOP
Layout.WALL_THICKNESS = 1
-- Faixa inferior mais escura das paredes (rodapé alto).
Layout.BAND_HEIGHT = 3.2

Layout.Building = { x0 = -40, x1 = 40, z0 = -50, z1 = 0 } :: Rect
-- Building continua sendo o núcleo original; Compound inclui as alas e o pátio técnico.
Layout.Compound = { x0 = -68, x1 = 72, z0 = -78, z1 = 44 } :: Rect
Layout.Courtyard = { x0 = -68, x1 = 72, z0 = 0, z1 = 44 } :: Rect

Layout.Rooms = {
	{ id = "Lobby", label = "RECEPÇÃO", x0 = -12, x1 = 4, z0 = -18, z1 = 0 },
	{ id = "Office", label = "ESCRITÓRIO", x0 = -40, x1 = -12, z0 = -18, z1 = 0 },
	{ id = "Pump", label = "BOMBAS", x0 = 4, x1 = 40, z0 = -18, z1 = 0 },
	{ id = "Corridor", label = "CORREDOR", x0 = -40, x1 = 40, z0 = -26, z1 = -18 },
	{ id = "Generator", label = "SALA DO GERADOR", x0 = -40, x1 = -4, z0 = -50, z1 = -26 },
	{ id = "Storage", label = "DEPÓSITO", x0 = -4, x1 = 40, z0 = -50, z1 = -26 },
	{ id = "Maintenance", label = "OFICINA", x0 = -68, x1 = -40, z0 = -50, z1 = 0 },
	{ id = "CableGallery", label = "GALERIA DE CABOS", x0 = -68, x1 = -40, z0 = -78, z1 = -50 },
	{ id = "Control", label = "SALA DE CONTROLE", x0 = -40, x1 = 4, z0 = -78, z1 = -50 },
	{ id = "Archive", label = "ARQUIVO TÉCNICO", x0 = 4, x1 = 40, z0 = -78, z1 = -50 },
	{ id = "Switchyard", label = "PÁTIO DE TRANSFORMADORES", x0 = 40, x1 = 72, z0 = -78, z1 = 0 },
} :: { Room }

Layout.Walls = {
	{
		id = "south",
		axis = "X",
		at = 0,
		from = -40,
		to = 40,
		exterior = true,
		openings = { window(-26), door(-4), window(14), window(30) },
	},
	{ id = "north", axis = "X", at = -50, from = -40, to = 40, exterior = false, openings = { door(-32), door(24) } },
	{ id = "west", axis = "Z", at = -40, from = -50, to = 0, exterior = false, openings = { door(-22), door(-4) } },
	{ id = "east", axis = "Z", at = 40, from = -50, to = 0, exterior = true, openings = { door(-22), door(-8) } },
	{ id = "annexWest", axis = "Z", at = -68, from = -78, to = 0, exterior = true, openings = {} },
	{ id = "annexSouth", axis = "X", at = 0, from = -68, to = -40, exterior = true, openings = { door(-54) } },
	{
		id = "annexNorth",
		axis = "X",
		at = -78,
		from = -68,
		to = 40,
		exterior = true,
		openings = {
			{ center = -6, width = 10, bottom = 0, top = DOOR_TOP },
			{ center = 22, width = 10, bottom = 0, top = DOOR_TOP },
		},
	},
	{ id = "gallerySouth", axis = "X", at = -50, from = -68, to = -40, exterior = false, openings = { door(-54) } },
	{ id = "controlWest", axis = "Z", at = -40, from = -78, to = -50, exterior = false, openings = { door(-64) } },
	{ id = "archiveWest", axis = "Z", at = 4, from = -78, to = -50, exterior = false, openings = { door(-64) } },
	{ id = "archiveEast", axis = "Z", at = 40, from = -78, to = -50, exterior = true, openings = { door(-64) } },
	{
		id = "southRow",
		axis = "X",
		at = -18,
		from = -40,
		to = 40,
		exterior = false,
		openings = { door(-27), door(-4), door(23) },
	},
	{
		id = "northRow",
		axis = "X",
		at = -26,
		from = -40,
		to = 40,
		exterior = false,
		openings = { door(-21), door(17) },
	},
	{
		id = "officeLobby",
		axis = "Z",
		at = -12,
		from = -18,
		to = 0,
		exterior = false,
		openings = { { center = -9, width = 5, bottom = 0, top = DOOR_TOP } },
	},
	{
		id = "lobbyPump",
		axis = "Z",
		at = 4,
		from = -18,
		to = 0,
		exterior = false,
		openings = { { center = -9, width = 5, bottom = 0, top = DOOR_TOP } },
	},
	-- Vão baixo de cabos (só agachado; o Vigia não cabe). Moldura em World/FeatureBuilder (Features.Crawl).
	{
		id = "generatorStorage",
		axis = "Z",
		at = -4,
		from = -50,
		to = -26,
		exterior = false,
		openings = { { center = -47.4, width = 3.4, bottom = 0, top = 3 } },
	},
} :: { Wall }

-- Portas com folha (o resto das aberturas é vão livre).
Layout.Doors = {
	{
		id = "door_office",
		wall = "southRow",
		center = -27,
		width = DOOR_WIDTH,
		hingeAtMin = true,
		side = 1,
		open = false,
	},
	{
		id = "door_generator",
		wall = "northRow",
		center = -21,
		width = DOOR_WIDTH,
		hingeAtMin = false,
		side = -1,
		open = false,
	},
	{
		id = "door_storage",
		wall = "northRow",
		center = 17,
		width = DOOR_WIDTH,
		hingeAtMin = true,
		side = -1,
		open = true,
	},
} :: { Door }

-- Portão elétrico na cerca do pátio (abre deslizando para +X).
Layout.Gate = { x = 0, z = 44, width = 12, height = 8 }
Layout.FenceHeight = 8

-- Passar daqui com o portão aberto = vitória.
Layout.ExitZone = { x0 = -6, x1 = 6, z0 = 46, z1 = 64 } :: Rect

-- Início: no pátio, perto da van, olhando para a porta da recepção.
Layout.Spawn = { position = { x = 14, y = 3.2, z = 34 } :: Point, lookAt = { x = -4, y = 3.2, z = 0 } :: Point }

-- Dois pontos possíveis por fusível (sorteado a cada rodada). y = altura do centro do fusível.
Layout.FuseSpots = {
	fuse_pump = {
		{ x = 35, y = 3.45, z = -3 }, -- bancada
		{ x = 9, y = 2.25, z = -15 }, -- caixote ao lado da bomba
	},
	fuse_office = {
		{ x = -29.8, y = 3.25, z = -7.6 }, -- mesa (ao lado do monitor)
		{ x = -38.5, y = 5.25, z = -15 }, -- topo do arquivo
	},
	fuse_storage = {
		{ x = 31, y = 4.65, z = -46 }, -- prateleira alta
		{ x = 6, y = 3.25, z = -34 }, -- pilha de caixotes
	},
} :: { [string]: { Point } }

-- Onde ficar de pé para pegar cada fusível (mesmo índice de FuseSpots; no chão, livre de móveis).
Layout.FuseStands = {
	fuse_pump = { { x = 35, y = 0, z = -6.5 }, { x = 9, y = 0, z = -11.5 } },
	fuse_office = { { x = -29.8, y = 0, z = -3.2 }, { x = -35, y = 0, z = -15 } },
	fuse_storage = { { x = 31, y = 0, z = -42 }, { x = 9.5, y = 0, z = -31 } },
} :: { [string]: { Point } }

-- Onde ficar de pé para usar o quadro, o portão e ler os bilhetes.
Layout.Stands = {
	panel = { x = -16, y = 0, z = -46 },
	gate = { x = 0, y = 0, z = 40 },
	note_order = { x = -8.5, y = 0, z = -7 },
	note_office = { x = -19.8, y = 0, z = -3.5 },
	note_storage = { x = 24, y = 0, z = -33 },
} :: { [string]: Point }

-- Quadro de força (centro da caixa) na parede norte da sala do gerador.
Layout.Panel = { x = -16, y = 4.5, z = -49.1 } :: Point

-- Bilhetes (centro do papel).
Layout.Notes = {
	note_order = { x = -8.5, y = 3.43, z = -3.5 }, -- balcão da recepção
	note_office = { x = -19.8, y = 3.03, z = -7.4 }, -- segunda mesa
	note_storage = { x = 24, y = 2.03, z = -30 }, -- caixote perto da porta
} :: { [string]: Point }

-- Rota de patrulha (no chão).
Layout.PatrolNodes = {
	{ x = -34, y = 0, z = -22 },
	{ x = -8, y = 0, z = -22 },
	{ x = 8, y = 0, z = -22 },
	{ x = 34, y = 0, z = -22 },
	{ x = -4, y = 0, z = -10 },
	{ x = -26, y = 0, z = -11 },
	{ x = 20, y = 0, z = -4 },
	{ x = 24, y = 0, z = -42 },
	{ x = 34, y = 0, z = -31 },
	{ x = -14, y = 0, z = -34 },
	{ x = -34, y = 0, z = -30 },
	{ x = -54, y = 0, z = -22 },
	{ x = -54, y = 0, z = -64 },
	{ x = -20, y = 0, z = -64 },
	{ x = 24, y = 0, z = -64 },
	{ x = 56, y = 0, z = -64 },
	{ x = 56, y = 0, z = -22 },
} :: { Point }

-- Onde ele aparece ao acordar (o mais longe do jogador).
Layout.CreatureSpawns = {
	{ x = 36, y = 0, z = -40 },
	{ x = -36, y = 0, z = -46 },
	{ x = 37, y = 0, z = -14 },
	{ x = -36, y = 0, z = -3 },
} :: { Point }

-- Luminárias de teto (acendem com a energia).
Layout.Lamps = {
	{ x = -4, y = 10.6, z = -9 },
	{ x = -26, y = 10.6, z = -9 },
	{ x = 14, y = 10.6, z = -5 },
	{ x = 32, y = 10.6, z = -12 },
	{ x = -30, y = 10.6, z = -22 },
	{ x = -6, y = 10.6, z = -22 },
	{ x = 18, y = 10.6, z = -22 },
	{ x = 36, y = 10.6, z = -22 },
	{ x = 8, y = 10.6, z = -38 },
	{ x = 28, y = 10.6, z = -38 },
	{ x = -22, y = 10.6, z = -38 },
	{ x = -54, y = 10.6, z = -12 },
	{ x = -54, y = 10.6, z = -38 },
	{ x = -54, y = 10.6, z = -64 },
	{ x = -24, y = 10.6, z = -64 },
	{ x = -4, y = 10.6, z = -64 },
	{ x = 24, y = 10.6, z = -64 },
} :: { Point }

-- Luzes de emergência vermelhas (bateria: acesas desde o início, para orientação).
Layout.EmergencyLights = {
	{ x = -8.5, y = 8.5, z = -17.3 },
	{ x = -39.3, y = 8, z = -22 },
	{ x = 39.3, y = 8, z = -22 },
	{ x = -11, y = 7.5, z = -49.3 },
	{ x = 0, y = 8.5, z = -26.7 },
	{ x = -67.3, y = 8.5, z = -22 },
	{ x = -54, y = 8.5, z = -77.3 },
	{ x = -20, y = 8.5, z = -77.3 },
	{ x = 24, y = 8.5, z = -77.3 },
} :: { Point }

function Layout.roomAt(x: number, z: number): Room?
	for _, room in Layout.Rooms do
		if x >= room.x0 and x <= room.x1 and z >= room.z0 and z <= room.z1 then
			return room
		end
	end
	return nil
end

function Layout.inRect(rect: Rect, x: number, z: number): boolean
	return x >= rect.x0 and x <= rect.x1 and z >= rect.z0 and z <= rect.z1
end

function Layout.isIndoor(x: number, z: number): boolean
	local room = Layout.roomAt(x, z)
	return room ~= nil and room.id ~= "Switchyard"
end

function Layout.wallById(id: string): Wall?
	for _, wall in Layout.Walls do
		if wall.id == id then
			return wall
		end
	end
	return nil
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="505">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Constrói a Subestação 9 inteira a partir de Layout.luau, no servidor, a cada boot.
	Nada do mapa vive só na place: apagar a pasta Workspace.Substation9 e rodar de novo recria tudo.

	Devolve um `World` com os handles que o WorldService usa (interagíveis, portas, portão, quadro).
]]

local CollectionService = game:GetService("CollectionService")

local Audio = require("@game/ReplicatedStorage/Shared/Game/Audio")
local Config = require("@game/ReplicatedStorage/Shared/Config")
local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
local Text = require("@game/ReplicatedStorage/Shared/Game/Text")
local Build = require("./Build")
local Expansion = require("./Expansion")
local Layout = require("./Layout")
local Palette = require("./Palette")
local Props = require("./Props")
local ProceduralLayout = require("./ProceduralLayout")
local WallMath = require("./WallMath")

export type Kind = "Fuse" | "Panel" | "Door" | "Gate" | "Note"

export type Interactable = {
	id: string,
	kind: Kind,
	focus: BasePart,
	model: Instance,
	maxDistance: number,
	enabled: boolean,
}

export type DoorHandle = {
	id: string,
	panel: BasePart,
	closedCFrame: CFrame,
	openCFrame: CFrame,
	hinge: CFrame,
	openAngle: number,
	isOpen: boolean,
	startsOpen: boolean,
	busy: boolean,
	center: Vector3,
	sound: Sound,
}

export type GateHandle = {
	model: Model,
	closedPivot: CFrame,
	openPivot: CFrame,
	isOpen: boolean,
	busy: boolean,
	sound: Sound,
	beacon: BasePart,
}

export type PanelHandle = {
	focus: BasePart,
	slotFuses: { BasePart },
	status: BasePart,
	switchSound: Sound,
	hum: Sound,
}

local MapBuilder = {}

-- Grupo de colisão das regiões de navegação (registrado pelo WorldService antes do build).
MapBuilder.NAV_GROUP = "NavOnly"

export type World = {
	root: Folder,
	interactables: { [string]: Interactable },
	fuseModels: { [string]: Model },
	doors: { [string]: DoorHandle },
	gate: GateHandle,
	panel: PanelHandle,
	buzz: { Sound },
	spawnCFrame: CFrame,
}

local V3 = Vector3.new
local CEILING = Layout.CEILING
local HALF = Layout.WALL_THICKNESS / 2

local function vec(p: Layout.Point): Vector3
	return V3(p.x, p.y, p.z)
end

local function register(world: World, id: string, kind: Kind, focus: BasePart, model: Instance, prompt: string)
	local distance = Config.Game.InteractDistance
	focus:SetAttribute(Tags.Attr.InteractId, id)
	focus:SetAttribute(Tags.Attr.InteractPrompt, prompt)
	focus:SetAttribute(Tags.Attr.InteractDistance, distance)
	focus:SetAttribute(Tags.Attr.InteractEnabled, true)
	CollectionService:AddTag(focus, Tags.Interactable)
	world.interactables[id] = {
		id = id,
		kind = kind,
		focus = focus,
		model = model,
		maxDistance = distance,
		enabled = true,
	}
end

-- Cores da parede conforme a sala de cada lado (frias no gerador/depósito, quentes no resto).
local function wallColors(x: number, z: number, exteriorSide: boolean): (Color3, Color3)
	if exteriorSide then
		return Palette.FacadeLower, Palette.Facade
	end
	local room = Layout.roomAt(x, z)
	if room and (room.id == "Generator" or room.id == "Storage") then
		return Palette.WallLowerCold, Palette.WallUpperCold
	end
	return Palette.WallLower, Palette.WallUpper
end

local function buildWall(parent: Instance, wall: Layout.Wall)
	local extend = if wall.exterior then HALF else 0
	local segments = WallMath.solidSegments(wall.from - extend, wall.to + extend, 0, CEILING, wall.openings)
	local lower, upper = WallMath.splitBands(segments, Layout.BAND_HEIGHT)

	-- Lado "+": +Z (paredes X) ou +X (paredes Z). Cada lado vira uma "pele" de meia espessura.
	for _, side in { 1, -1 } do
		local exteriorSide = false
		if wall.exterior then
			if wall.axis == "X" then
				exteriorSide = (side == 1 and wall.at >= Layout.Building.z1)
					or (side == -1 and wall.at <= Layout.Building.z0)
			else
				exteriorSide = (side == 1 and wall.at >= Layout.Building.x1)
					or (side == -1 and wall.at <= Layout.Building.x0)
			end
		end
		local offset = side * HALF / 2
		for bandIndex, band in { lower, upper } do
			for _, s in band do
				local mid = (s.a + s.b) / 2
				local sampleX = if wall.axis == "X" then mid else wall.at + side
				local sampleZ = if wall.axis == "X" then wall.at + side else mid
				local lowColor, highColor = wallColors(sampleX, sampleZ, exteriorSide)
				local color = if bandIndex == 1 then lowColor else highColor
				local material = if exteriorSide then Enum.Material.Concrete else Enum.Material.SmoothPlastic
				local min, max
				if wall.axis == "X" then
					min = V3(s.a, s.y0, wall.at + offset - HALF / 2)
					max = V3(s.b, s.y1, wall.at + offset + HALF / 2)
				else
					min = V3(wall.at + offset - HALF / 2, s.y0, s.a)
					max = V3(wall.at + offset + HALF / 2, s.y1, s.b)
				end
				Build.box(parent, `Wall_{wall.id}`, min, max, color, { material = material })
			end
		end
	end

	-- Grades nas janelas.
	for _, opening in wall.openings do
		if opening.bottom > 0 then
			for i = -2, 2 do
				local along = opening.center + i * opening.width / 5
				local center = if wall.axis == "X"
					then V3(along, (opening.bottom + opening.top) / 2, wall.at)
					else V3(wall.at, (opening.bottom + opening.top) / 2, along)
				Build.cylinder(
					parent,
					"Bar",
					center,
					Vector3.yAxis,
					opening.top - opening.bottom,
					0.15,
					Palette.MetalDark
				)
			end
		end
	end
end

-- Piso em xadrez alinhado à grade global (padrão contínuo entre salas).
local function tiles(parent: Instance, rect: Layout.Rect, size: number, a: Color3, b: Color3)
	local gx0 = math.floor(rect.x0 / size)
	local gx1 = math.ceil(rect.x1 / size) - 1
	local gz0 = math.floor(rect.z0 / size)
	local gz1 = math.ceil(rect.z1 / size) - 1
	for gx = gx0, gx1 do
		for gz = gz0, gz1 do
			local x0 = math.max(rect.x0, gx * size)
			local x1 = math.min(rect.x1, (gx + 1) * size)
			local z0 = math.max(rect.z0, gz * size)
			local z1 = math.min(rect.z1, (gz + 1) * size)
			if x1 > x0 and z1 > z0 then
				local color = if (gx + gz) % 2 == 0 then a else b
				Build.box(parent, "Tile", V3(x0, -1, z0), V3(x1, 0, z1), color)
			end
		end
	end
end

local function inner(rect: Layout.Rect): Layout.Rect
	return { x0 = rect.x0 + HALF, x1 = rect.x1 - HALF, z0 = rect.z0 + HALF, z1 = rect.z1 - HALF }
end

local function buildFloors(parent: Instance)
	for _, room in Layout.Rooms do
		local r = inner(room)
		if room.id == "Lobby" or room.id == "Office" then
			tiles(parent, r, 4, Palette.TileA, Palette.TileB)
		elseif room.id == "Corridor" then
			tiles(parent, r, 4, Palette.CorridorA, Palette.CorridorB)
		elseif room.id == "Generator" then
			Build.box(parent, "Floor", V3(r.x0, -1, r.z0), V3(r.x1, 0, r.z1), Palette.MetalFloor, {
				material = Enum.Material.DiamondPlate,
			})
		else
			Build.box(parent, "Floor", V3(r.x0, -1, r.z0), V3(r.x1, 0, r.z1), Palette.Concrete, {
				material = Enum.Material.Concrete,
			})
		end
	end
	-- Soleiras nas portas (cobrem o vão entre os pisos das salas).
	for _, wall in Layout.Walls do
		for _, opening in wall.openings do
			if opening.bottom == 0 then
				local w = opening.width / 2
				if wall.axis == "X" then
					Build.box(
						parent,
						"Threshold",
						V3(opening.center - w, -1, wall.at - HALF),
						V3(opening.center + w, 0, wall.at + HALF),
						Palette.MetalDark
					)
				else
					Build.box(
						parent,
						"Threshold",
						V3(wall.at - HALF, -1, opening.center - w),
						V3(wall.at + HALF, 0, opening.center + w),
						Palette.MetalDark
					)
				end
			end
		end
	end
	-- Laje do teto/telhado + platibanda.
	local b = Layout.Building
	Build.box(
		parent,
		"Roof",
		V3(b.x0 - HALF, CEILING, b.z0 - HALF),
		V3(b.x1 + HALF, CEILING + 1, b.z1 + HALF),
		Palette.Ceiling
	)
	Build.box(
		parent,
		"Parapet",
		V3(b.x0 - HALF, CEILING + 1, b.z1 - 0.2),
		V3(b.x1 + HALF, CEILING + 1.8, b.z1 + HALF),
		Palette.Trim
	)
	Build.box(
		parent,
		"Parapet",
		V3(b.x0 - HALF, CEILING + 1, b.z0 - HALF),
		V3(b.x1 + HALF, CEILING + 1.8, b.z0 + 0.2),
		Palette.Trim
	)
	Build.box(parent, "Parapet", V3(b.x0 - HALF, CEILING + 1, b.z0), V3(b.x0 + 0.2, CEILING + 1.8, b.z1), Palette.Trim)
	Build.box(parent, "Parapet", V3(b.x1 - 0.2, CEILING + 1, b.z0), V3(b.x1 + HALF, CEILING + 1.8, b.z1), Palette.Trim)
end

local function buildDoor(world: World, parent: Instance, spec: Layout.Door)
	local wall = Layout.wallById(spec.wall)
	assert(wall and wall.axis == "X", `[MapBuilder] door {spec.id} needs an X-axis wall`)
	local height = Layout.DOOR_TOP - 0.15
	local width = spec.width - 0.2
	local closed = CFrame.new(spec.center, height / 2, wall.at)
	local hingeX = if spec.hingeAtMin then spec.center - spec.width / 2 else spec.center + spec.width / 2
	local hinge = CFrame.new(hingeX, height / 2, wall.at)
	local angle = math.rad(95) * spec.side * (if spec.hingeAtMin then -1 else 1)
	local open = hinge * CFrame.Angles(0, angle, 0) * (hinge:Inverse() * closed)

	local panel = Build.part(parent, spec.id, V3(width, height, 0.35), closed, Palette.WallLowerCold, {
		material = Enum.Material.Metal,
	})
	-- Visor e maçaneta (soldados na folha para acompanhar o giro).
	local window = Build.part(parent, "DoorWindow", V3(1.4, 1.6, 0.4), closed * CFrame.new(0, 1.8, 0), Palette.Screen, {
		collide = false,
		reflectance = 0.15,
	})
	local handle = Build.part(
		parent,
		"DoorHandle",
		V3(0.5, 0.2, 0.6),
		closed * CFrame.new((if spec.hingeAtMin then 1 else -1) * (width / 2 - 0.5), -0.6, 0),
		Palette.Metal,
		{ collide = false }
	)
	for _, piece in { window, handle } do
		piece.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = panel
		weld.Part1 = piece
		weld.Parent = panel
	end

	-- Região "atravessável" para o pathfinding: o Vigia planeja passar e abre a porta ao chegar.
	-- PassThrough exige CanQuery = true (testado); o grupo NavOnly não colide com Default,
	-- então raycasts comuns (visão, interação) ignoram esta peça invisível.
	local region = Build.part(parent, `{spec.id}_Path`, V3(spec.width, Layout.DOOR_TOP, 1.6), closed, Palette.Black, {
		transparency = 1,
		collide = false,
		query = true,
	})
	region.CanTouch = false
	region.CollisionGroup = MapBuilder.NAV_GROUP
	local modifier = Instance.new("PathfindingModifier")
	modifier.Label = "Door"
	modifier.PassThrough = true
	modifier.Parent = region

	local handleData: DoorHandle = {
		id = spec.id,
		panel = panel,
		closedCFrame = closed,
		openCFrame = open,
		hinge = hinge,
		openAngle = angle,
		isOpen = false,
		startsOpen = spec.open,
		busy = false,
		center = closed.Position,
		sound = Build.sound(panel, "Squeak", Audio.Door.id, Audio.Door.volume),
	}
	world.doors[spec.id] = handleData
	register(world, spec.id, "Door", panel, panel, Text.Prompts.DoorOpen)
end

local function buildRooms(parent: Instance)
	-- RECEPÇÃO
	-- Recepção: centro livre (passagem entre pátio, corredor, escritório e bombas).
	Props.counter(parent, V3(-8.5, 0, -3.5), 0, 5)
	Props.chair(parent, V3(2.5, 0, -2), 90)
	Props.chair(parent, V3(2.5, 0, -14.5), 90)
	Props.bench(parent, V3(-10.6, 0, -14.6), 90)
	Build.cylinder(parent, "Pot", V3(-10.5, 1, -1.5), Vector3.yAxis, 2, 1.6, Palette.Rust)
	Build.part(
		parent,
		"DeadPlant",
		V3(0.4, 3, 0.4),
		CFrame.new(-10.5, 3.2, -1.5) * CFrame.Angles(0, 0, 0.3),
		Palette.Trunk
	)
	Build.sign(
		parent,
		"Board",
		V3(-11.45, 5.5, -13),
		Vector3.xAxis,
		Vector2.new(5, 3),
		"AVISOS\nPLANTÃO 24H\nNÃO DESLIGUE O RÁDIO",
		{
			textColor = Palette.Black,
			background = Palette.Paper,
			font = Enum.Font.SpecialElite,
		}
	)

	-- ESCRITÓRIO
	Props.desk(parent, V3(-31, 0, -7), 0)
	Props.desk(parent, V3(-21, 0, -7), 0)
	Props.chair(parent, V3(-31, 0, -9.6), 0)
	Props.chair(parent, V3(-21, 0, -9.6), 0)
	Props.chair(parent, V3(-15.5, 0, -15.5), 70, true)
	Props.cabinet(parent, V3(-38.5, 0, -15), 90)
	Props.cabinet(parent, V3(-38.5, 0, -12.6), 90)
	Build.sign(
		parent,
		"Roster",
		V3(-39.45, 5.5, -6),
		Vector3.xAxis,
		Vector2.new(6, 3.2),
		"ESCALA - TURNO NOITE\nSEG  ADEMIR\nTER  ADEMIR\nQUA  ADEMIR\nQUI  ADEMIR",
		{ textColor = Palette.MetalDark, background = Palette.Ceramic, font = Enum.Font.SpecialElite }
	)

	-- BOMBAS
	Props.pumpTank(parent, V3(14, 0, -10), 7, 5)
	Props.pumpTank(parent, V3(26, 0, -10), 7, 5)
	Props.workbench(parent, V3(35, 0, -3), 0)
	Props.crate(parent, V3(9, 0, -15), 0, 2)
	Props.crate(parent, V3(37, 0, -15), 15, 3)
	Props.pipe(parent, V3(4.5, 9.4, -16.5), V3(39.5, 9.4, -16.5), 1)
	Props.pipe(parent, V3(4.5, 8.4, -1.5), V3(26, 8.4, -1.5), 0.7, Palette.MetalDark)
	Props.pipe(parent, V3(20, 0, -16.5), V3(20, 9.4, -16.5), 0.8)
	for _, x in { 18, 22 } do
		Build.part(
			parent,
			"Puddle",
			V3(3, 0.04, 2.2),
			CFrame.new(x, 0.02, -13) * CFrame.Angles(0, x, 0),
			Palette.Screen,
			{
				collide = false,
				reflectance = 0.35,
			}
		)
	end

	-- CORREDOR: artéria principal, sem obstáculos (só decoração sem colisão no teto/paredes).
	Props.pipe(parent, V3(-39.5, 10, -25), V3(39.5, 10, -25), 0.6, Palette.MetalDark)
	Build.sign(
		parent,
		"Directions",
		V3(-4, 6, -25.45),
		Vector3.zAxis,
		Vector2.new(9, 1.3),
		"< GERADOR      DEPÓSITO >",
		{
			textColor = Palette.Hazard,
			background = Palette.Black,
		}
	)

	-- SALA DO GERADOR
	Props.generator(parent, V3(-28, 0, -40), 0)
	for i = 0, 7 do
		Build.box(
			parent,
			"Hazard",
			V3(-34 + i * 1.5, 0, -44.6),
			V3(-33.25 + i * 1.5, 0.03, -43.6),
			if i % 2 == 0 then Palette.Hazard else Palette.Black,
			{ collide = false }
		)
	end
	Props.pipe(parent, V3(-22.5, 0.2, -40), V3(-16, 0.2, -40), 0.5, Palette.Black, false)
	Props.pipe(parent, V3(-16, 0.2, -40), V3(-16, 0.2, -48.6), 0.5, Palette.Black, false)
	for _, p in { V3(-37, 0, -29), V3(-35.6, 0, -29.4), V3(-37.2, 0, -31) } do
		Build.cylinder(parent, "Drum", p + V3(0, 1.6, 0), Vector3.yAxis, 3.2, 2, Palette.Red)
	end

	-- DEPÓSITO
	Props.shelf(parent, V3(31, 0, -46), 0, 8)
	Props.shelf(parent, V3(15, 0, -46), 0, 8)
	Props.shelf(parent, V3(31, 0, -38), 0, 8)
	Props.shelf(parent, V3(15, 0, -38), 0, 8)
	Props.crate(parent, V3(6, 0, -34), 10, 3)
	Props.crate(parent, V3(3, 0, -36), -15, 2)
	Props.crate(parent, V3(24, 0, -30), 0, 2) -- longe da porta aberta do depósito
	Props.locker(parent, V3(-2.3, 0, -42), 90, 3)
	Props.locker(parent, V3(-2.3, 0, -32), 90, 2)
	Build.sign(parent, "Graffiti", V3(30, 5, -26.56), -Vector3.zAxis, Vector2.new(10, 2.6), "ELE SEGUE A LUZ", {
		textColor = Palette.Red,
		font = Enum.Font.PermanentMarker,
		partColor = Palette.WallUpperCold,
		thickness = 0.05,
	})
end

local function buildLights(world: World, parent: Instance)
	for index, p in Layout.Lamps do
		local tube = Props.lampFixture(parent, vec(p))
		Build.light(tube, "Lamp", Palette.Fluorescent, 20, 1.1, false)
		if index == 1 or index == 6 or index == 10 then
			table.insert(world.buzz, Build.sound(tube, "Buzz", Audio.LampBuzz.id, Audio.LampBuzz.volume, 1, true))
		end
	end
	for index, p in Layout.EmergencyLights do
		local box = Props.emergencyLight(parent, vec(p))
		Build.light(box, "Emergency", Palette.Emergency, 13, 0.9, true, index == 1)
	end
	-- Placa de saída acesa (orientação) dentro da recepção.
	local exit = Build.sign(parent, "ExitSign", V3(-4, 9.7, -0.75), -Vector3.zAxis, Vector2.new(3, 1), "SAÍDA", {
		textColor = Palette.ExitLight,
		background = Color3.fromRGB(8, 34, 16),
		lit = true,
	})
	Build.light(exit, "Exit", Palette.ExitLight, 7, 0.5, true)
end

local function buildSigns(parent: Instance)
	Build.sign(parent, "FacadeSign", V3(-4, 10, 0.35), Vector3.zAxis, Vector2.new(14, 1.8), Text.Title, {
		textColor = Palette.Ceramic,
		background = Color3.fromRGB(26, 28, 26),
	})
	Build.sign(parent, "Danger", V3(22, 5.2, 0.35), Vector3.zAxis, Vector2.new(3.2, 2.4), "PERIGO\nALTA TENSÃO", {
		textColor = Palette.Black,
		background = Palette.Hazard,
	})
	Build.sign(parent, "Danger", V3(-14, 5.2, 0.35), Vector3.zAxis, Vector2.new(3.2, 2.4), "ACESSO\nRESTRITO", {
		textColor = Palette.Ceramic,
		background = Palette.Red,
	})
	-- Placas acima das portas, viradas para o corredor.
	local labels = {
		{ x = -27, z = -18.55, face = -1, text = "ESCRITÓRIO" },
		{ x = -4, z = -18.55, face = -1, text = "RECEPÇÃO / SAÍDA" },
		{ x = 23, z = -18.55, face = -1, text = "BOMBAS" },
		{ x = -21, z = -25.45, face = 1, text = "SALA DO GERADOR" },
		{ x = 17, z = -25.45, face = 1, text = "DEPÓSITO" },
	}
	for _, label in labels do
		Build.sign(
			parent,
			"RoomLabel",
			V3(label.x, 9.95, label.z),
			Vector3.zAxis * label.face,
			Vector2.new(6, 0.9),
			label.text,
			{ textColor = Palette.Ceramic, background = Palette.Trim }
		)
	end
	-- Na recepção, apontando o corredor.
	Build.sign(
		parent,
		"LobbyArrow",
		V3(-4, 9.95, -17.45),
		Vector3.zAxis,
		Vector2.new(6, 0.9),
		"^ GERADOR / DEPÓSITO",
		{
			textColor = Palette.Hazard,
			background = Palette.Trim,
		}
	)
	Build.sign(parent, "PanelLabel", V3(-16, 7.6, -49.42), Vector3.zAxis, Vector2.new(5, 0.8), "QUADRO PRINCIPAL", {
		textColor = Palette.Hazard,
		background = Palette.Black,
	})
end

local function buildPanel(world: World, parent: Instance)
	local p = vec(Layout.Panel)
	local model = Build.model(parent, "MainPanel")
	local box =
		Build.part(model, "Box", V3(4, 5, 0.8), CFrame.new(p), Palette.Metal, { material = Enum.Material.Metal })
	Build.part(model, "Frame", V3(4.3, 5.3, 0.6), CFrame.new(p + V3(0, 0, -0.15)), Palette.MetalDark)
	local slots: { BasePart } = {}
	for i = 1, Config.Game.FusesTotal do
		local x = p.X + (i - 2) * 1.2
		Build.part(
			model,
			"Socket",
			V3(0.8, 1.6, 0.1),
			CFrame.new(x, p.Y + 0.2, p.Z + 0.42),
			Palette.Black,
			{ collide = false }
		)
		local fuse =
			Build.cylinder(model, "SlotFuse", V3(x, p.Y + 0.2, p.Z + 0.5), Vector3.yAxis, 1.1, 0.45, Palette.Ceramic, {
				collide = false,
				transparency = 1,
			})
		table.insert(slots, fuse)
	end
	local status = Build.part(model, "Status", V3(0.6, 0.6, 0.2), CFrame.new(p + V3(0, 1.8, 0.45)), Palette.PanelOff, {
		material = Enum.Material.Neon,
		collide = false,
	})
	Build.part(
		model,
		"Lever",
		V3(0.3, 1.4, 0.3),
		CFrame.new(p + V3(1.6, -1.2, 0.6)) * CFrame.Angles(0.5, 0, 0),
		Palette.Red,
		{
			collide = false,
		}
	)
	world.panel = {
		focus = box,
		slotFuses = slots,
		status = status,
		switchSound = Build.sound(box, "Switch", Audio.Switch.id, Audio.Switch.volume),
		hum = Build.sound(box, "Hum", Audio.GeneratorHum.id, Audio.GeneratorHum.volume, 1, true),
	}
	register(world, "panel", "Panel", box, model, Text.Prompts.Panel)
end

local function buildCourtyard(world: World, parent: Instance)
	local c = Layout.Courtyard
	-- Chão: mato escuro em volta, asfalto no pátio e na estrada.
	Build.box(
		parent,
		"Ground",
		V3(-160, -2, ProceduralLayout.Bounds.z0 - 30),
		V3(160, -0.05, 180),
		Palette.Grass,
		{ material = Enum.Material.Ground }
	)
	Build.box(
		parent,
		"Yard",
		V3(c.x0, -1, c.z0),
		V3(c.x1, 0, c.z1),
		Palette.Asphalt,
		{ material = Enum.Material.Asphalt }
	)
	Build.box(parent, "Road", V3(-6, -1, c.z1), V3(6, 0, 170), Palette.Asphalt, { material = Enum.Material.Asphalt })
	Build.box(parent, "Gravel", V3(-40, -0.98, 0), V3(40, 0.02, 3), Palette.Gravel, { material = Enum.Material.Pebble })

	Props.van(parent, V3(26, 0, 26), 0)
	Props.booth(parent, V3(-28, 0, 37), 180)
	Build.cylinder(parent, "Drum", V3(-34, 1.6, 20), Vector3.yAxis, 3.2, 2, Palette.Rust)

	local street = Props.streetLamp(parent, V3(34, 0, 38))
	Build.light(street, "Street", Palette.Sodium, 26, 1.3, true, true)
	for _, x in { -30, 30 } do
		local head = Props.floodLight(parent, V3(x, 0, 8), V3(x * 0.5, 3, 0))
		Build.light(head, "Flood", Palette.Sodium, 34, 1.2, false)
	end

	-- Cerca: laterais e frente (com o vão do portão).
	local h = Layout.FenceHeight
	local gate = Layout.Gate
	local function fenceRun(a: Vector3, b: Vector3)
		local delta = b - a
		local length = delta.Magnitude
		local cframe = CFrame.lookAt((a + b) / 2 + V3(0, h / 2, 0), (b + V3(0, h / 2, 0)))
		Build.part(parent, "FenceMesh", V3(0.15, h, length), cframe, Palette.Fence, {
			transparency = 0.55,
			material = Enum.Material.Metal,
		})
		Build.part(parent, "FenceRail", V3(0.3, 0.3, length), cframe * CFrame.new(0, h / 2, 0), Palette.MetalDark)
		local posts = math.max(1, math.floor(length / 6))
		for i = 0, posts do
			local p = a:Lerp(b, i / posts)
			Build.block(parent, "FencePost", p, V3(0.4, h + 0.6, 0.4), 0, Palette.MetalDark)
		end
	end
	fenceRun(V3(c.x0, 0, c.z0), V3(c.x0, 0, c.z1))
	fenceRun(V3(c.x1, 0, c.z0), V3(c.x1, 0, c.z1))
	fenceRun(V3(c.x0, 0, c.z1), V3(gate.x - gate.width / 2, 0, c.z1))
	fenceRun(V3(gate.x + gate.width / 2, 0, c.z1), V3(c.x1, 0, c.z1))

	-- Portão elétrico deslizante.
	local gateModel = Build.model(parent, "Gate")
	local gz = gate.z - 0.6
	local mesh = Build.part(
		gateModel,
		"Mesh",
		V3(gate.width, gate.height, 0.2),
		CFrame.new(gate.x, gate.height / 2, gz),
		Palette.Fence,
		{
			transparency = 0.35,
			material = Enum.Material.DiamondPlate,
		}
	)
	for _, dy in { 0.3, gate.height - 0.3 } do
		local bar = Build.part(gateModel, "Bar", V3(gate.width, 0.35, 0.35), CFrame.new(gate.x, dy, gz), Palette.Hazard)
		bar.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = mesh
		weld.Part1 = bar
		weld.Parent = mesh
	end
	gateModel.PrimaryPart = mesh
	for _, x in { gate.x - gate.width / 2 - 0.4, gate.x + gate.width / 2 + 0.4 } do
		Build.block(parent, "GatePost", V3(x, 0, gate.z), V3(0.8, gate.height + 1, 0.8), 0, Palette.Hazard)
	end
	local motor = Build.block(
		parent,
		"GateMotor",
		V3(gate.x + gate.width / 2 + 1.6, 0, gate.z - 1.2),
		V3(1.6, 1.4, 1.2),
		0,
		Palette.MetalDark
	)
	local beacon = Build.part(
		parent,
		"Beacon",
		V3(0.7, 0.7, 0.7),
		CFrame.new(gate.x + gate.width / 2 + 0.4, gate.height + 1.4, gate.z),
		Palette.Red,
		{
			material = Enum.Material.Neon,
		}
	)
	Build.light(beacon, "Beacon", Palette.Emergency, 14, 1.4, false)
	Build.sign(
		parent,
		"GateSign",
		V3(gate.x + gate.width / 2 + 0.4, 5, gate.z - 0.45),
		-Vector3.zAxis,
		Vector2.new(2.4, 1.2),
		"PORTÃO\nELÉTRICO",
		{
			textColor = Palette.Black,
			background = Palette.Hazard,
		}
	)
	world.gate = {
		model = gateModel,
		closedPivot = gateModel:GetPivot(),
		openPivot = gateModel:GetPivot() * CFrame.new(gate.width + 0.8, 0, 0),
		isOpen = false,
		busy = false,
		sound = Build.sound(motor, "Motor", Audio.Door.id, 0.9, 0.55),
		beacon = beacon,
	}
	register(world, "gate", "Gate", mesh, gateModel, Text.Prompts.Gate)

	-- Mata em volta (determinístico).
	local rng = Random.new(9)
	local placed = 0
	while placed < 60 do
		local x = rng:NextNumber(-135, 125)
		local z = rng:NextNumber(ProceduralLayout.Bounds.z0 - 25, 130)
		local bounds = Layout.Compound
		local insideCompound = x > bounds.x0 - 5 and x < bounds.x1 + 5 and z > bounds.z0 - 5 and z < bounds.z1 + 4
		local north = ProceduralLayout.Bounds
		local insideSector = x > north.x0 - 8 and x < north.x1 + 8 and z > north.z0 - 8 and z < north.z1 + 5
		local onRoad = math.abs(x) < 10 and z > c.z1
		if not insideCompound and not insideSector and not onRoad then
			Props.tree(parent, V3(x, 0, z), rng:NextNumber(14, 24), rng)
			placed += 1
		end
	end
	-- Fim da estrada (a névoa esconde): ninguém anda para sempre.
	Build.box(parent, "RoadBlock", V3(-12, 0, 76), V3(12, 12, 77), Palette.Black, { transparency = 1 })
end

local function buildPickups(world: World, parent: Instance)
	local fuseFolder = Build.folder(parent, "Fuses")
	for id, spots in Layout.FuseSpots do
		local model, body = Props.fuse(fuseFolder, id, vec(spots[1]))
		world.fuseModels[id] = model
		register(world, id, "Fuse", body, model, Text.Prompts.Fuse)
	end
	local yaws = { note_order = 12, note_office = -20, note_storage = 35 }
	for id, p in Layout.Notes do
		local paper = Props.note(parent, id, vec(p), yaws[id] or 0)
		register(world, id, "Note", paper, paper, Text.Prompts.Note)
	end
end

function MapBuilder.build(parent: Instance): World
	local existing = parent:FindFirstChild(Tags.WorldFolder)
	if existing then
		existing:Destroy()
	end
	local root = Build.folder(parent, Tags.WorldFolder)
	local spawn = Layout.Spawn
	local world: World = {
		root = root,
		interactables = {},
		fuseModels = {},
		doors = {},
		gate = nil :: any,
		panel = nil :: any,
		buzz = {},
		spawnCFrame = CFrame.lookAt(vec(spawn.position), vec(spawn.lookAt)),
	}

	local structure = Build.folder(root, "Structure")
	for _, wall in Layout.Walls do
		buildWall(structure, wall)
	end
	buildFloors(structure)

	local doors = Build.folder(root, "Doors")
	for _, spec in Layout.Doors do
		buildDoor(world, doors, spec)
	end

	buildRooms(Build.folder(root, "Props"))
	buildLights(world, Build.folder(root, "Lights"))
	buildSigns(Build.folder(root, "Signs"))
	buildPanel(world, root)
	buildCourtyard(world, Build.folder(root, "Exterior"))
	Expansion.build(Build.folder(root, "Expansion"))
	buildPickups(world, Build.folder(root, "Pickups"))
	return world
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="506">
          <Properties>
            <string name="Name">Palette</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Paleta curta (estética PS1): poucos tons por família, saturação baixa, acentos raros
	(amarelo de perigo, vermelho de emergência, verde de saída). Mude aqui para reestilizar o mapa.
]]

local rgb = Color3.fromRGB

local Palette = {
	-- Paredes internas (faixa de cima / faixa de baixo)
	WallUpper = rgb(104, 100, 88),
	WallLower = rgb(60, 68, 62),
	WallUpperCold = rgb(86, 94, 98), -- gerador / depósito
	WallLowerCold = rgb(48, 54, 58),
	-- Fachada
	Facade = rgb(112, 106, 94),
	FacadeLower = rgb(66, 64, 58),
	Ceiling = rgb(42, 42, 40),
	Trim = rgb(34, 34, 32),

	-- Pisos
	TileA = rgb(80, 78, 68),
	TileB = rgb(56, 56, 50),
	CorridorA = rgb(86, 78, 60),
	CorridorB = rgb(62, 58, 46),
	Concrete = rgb(70, 70, 66),
	MetalFloor = rgb(64, 68, 70),

	-- Materiais de props
	Metal = rgb(62, 68, 72),
	MetalDark = rgb(36, 40, 44),
	Rust = rgb(96, 60, 40),
	Wood = rgb(88, 64, 44),
	WoodDark = rgb(56, 40, 30),
	Paper = rgb(212, 204, 178),
	Fabric = rgb(52, 58, 68),
	Ceramic = rgb(222, 216, 198),
	Screen = rgb(18, 26, 22),

	-- Acentos
	Hazard = rgb(186, 150, 40),
	Black = rgb(16, 16, 16),
	Red = rgb(140, 32, 28),
	ExitGreen = rgb(40, 160, 80),
	FuseGlow = rgb(255, 150, 60),
	Brass = rgb(176, 140, 64),
	Uniform = rgb(40, 46, 58), -- farda do vigia
	UniformDark = rgb(26, 30, 38),
	Skin = rgb(150, 118, 96),
	Hair = rgb(54, 50, 46),

	-- Exterior
	Asphalt = rgb(34, 36, 38),
	Grass = rgb(28, 36, 26),
	Gravel = rgb(52, 50, 46),
	Foliage = rgb(22, 34, 24),
	FoliageDark = rgb(16, 26, 18),
	Trunk = rgb(42, 32, 24),
	Fence = rgb(70, 74, 72),
	VanBody = rgb(168, 162, 146),

	-- Luzes
	LampOff = rgb(70, 72, 70),
	LampOn = rgb(214, 236, 226),
	Fluorescent = rgb(205, 232, 222),
	Emergency = rgb(255, 64, 52),
	Sodium = rgb(255, 172, 104),
	ExitLight = rgb(90, 255, 140),
	PanelOff = rgb(120, 24, 20),
	PanelOn = rgb(70, 255, 120),

	-- Atmosfera
	-- Névoa um pouco mais clara que os objetos: recorta silhuetas (truque clássico de PS1).
	Fog = rgb(30, 34, 44),
	FogPower = rgb(36, 32, 34),
	Ambient = rgb(16, 16, 20),
	AmbientPower = rgb(34, 32, 32),
	-- Luar: o pátio fica escuro, mas cerca/árvores/fachada leem como silhuetas (orientação).
	OutdoorAmbient = rgb(64, 72, 92),
}

return table.freeze(Palette)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="507">
          <Properties>
            <string name="Name">ProceduralLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Pavilhões separados por galerias; pátios e anel externo fazem parte da circulação real.
local Random = require("../Campaign/SeededRandom")

export type Room = { cell: number, kind: string, x: number, z: number, turn: number }
export type Link = { a: number, b: number }
export type Plan = { seed: number, stage: number, rooms: { Room }, links: { Link } }
export type Passage = { id: string, x0: number, x1: number, z0: number, z1: number, covered: boolean }

local Layout = {}
Layout.Columns = 3
Layout.Rows = 3
Layout.CellSize = 44
Layout.RoomSize = 28
Layout.Bounds = table.freeze({ x0 = -96, x1 = 72, z0 = -232, z1 = -78 })
Layout.Entrances = table.freeze({ 2, 3 }) -- linha sul: controle e arquivo
Layout.DoorWidth = 10
Layout.SurfaceBudget = 16
Layout.ExteriorZones = table.freeze({
	{ id = "ServiceYard", x0 = -96, x1 = -64, z0 = -232, z1 = -78, covered = false },
	{ id = "LoadingYard", x0 = -64, x1 = 72, z0 = -232, z1 = -212, covered = false },
	{ id = "UtilityWalk", x0 = 52, x1 = 72, z0 = -212, z1 = -78, covered = false },
})
Layout.Kinds = table.freeze({
	"RelayHall",
	"Cooling",
	"BatteryBank",
	"Radio",
	"MachineShop",
	"Inspection",
	"CableDepot",
	"Turbine",
	"WaterTreatment",
})

function Layout.center(cell: number): (number, number)
	local column = (cell - 1) % Layout.Columns
	local row = math.floor((cell - 1) / Layout.Columns)
	return -50 + column * Layout.CellSize, -110 - row * Layout.CellSize
end

-- Os vãos antigos continuam no controle e no arquivo; a galeria distribui o acesso aos pavilhões.
function Layout.entranceX(cell: number): number
	assert(table.find(Layout.Entrances, cell), "Invalid sector entrance")
	return if cell == 2 then -6 else 22
end

function Layout.isOutdoorRoom(room: Room): boolean
	return room.kind == "Cooling" or room.kind == "WaterTreatment"
end

function Layout.passages(plan: Plan): { Passage }
	local passages: { Passage } = {
		{ id = "AccessGallery", x0 = -64, x1 = 52, z0 = -96, z1 = -78, covered = true },
	}
	local half, width = Layout.RoomSize / 2, Layout.DoorWidth / 2
	for _, link in plan.links do
		local a, b = plan.rooms[link.a], plan.rooms[link.b]
		local horizontal = a.z == b.z
		table.insert(passages, {
			id = `Passage_{link.a}_{link.b}`,
			x0 = if horizontal then math.min(a.x, b.x) + half else a.x - width,
			x1 = if horizontal then math.max(a.x, b.x) - half else a.x + width,
			z0 = if horizontal then a.z - width else math.min(a.z, b.z) + half,
			z1 = if horizontal then a.z + width else math.max(a.z, b.z) - half,
			covered = not Layout.isOutdoorRoom(a) and not Layout.isOutdoorRoom(b),
		})
	end
	return passages
end

function Layout.isIndoor(plan: Plan, x: number, z: number): boolean
	local half = Layout.RoomSize / 2
	for _, room in plan.rooms do
		if math.abs(x - room.x) <= half and math.abs(z - room.z) <= half then
			return not Layout.isOutdoorRoom(room)
		end
	end
	for _, passage in Layout.passages(plan) do
		if passage.covered and x >= passage.x0 and x <= passage.x1 and z >= passage.z0 and z <= passage.z1 then
			return true
		end
	end
	return false
end

function Layout.patrolPoints(plan: Plan): { { x: number, y: number, z: number } }
	local points = {}
	for _, room in plan.rooms do
		table.insert(points, { x = room.x, y = 0, z = room.z })
	end
	for _, passage in Layout.passages(plan) do
		table.insert(points, { x = (passage.x0 + passage.x1) / 2, y = 0, z = (passage.z0 + passage.z1) / 2 })
	end
	for _, z in { -110, -154, -198 } do
		table.insert(points, { x = -82, y = 0, z = z })
		table.insert(points, { x = 62, y = 0, z = z })
	end
	for _, x in { -82, -50, -6, 38, 62 } do
		table.insert(points, { x = x, y = 0, z = -222 })
	end
	return points
end

function Layout.edges(): { Link }
	local edges: { Link } = {}
	for cell = 1, Layout.Columns * Layout.Rows do
		if cell % Layout.Columns ~= 0 then
			table.insert(edges, { a = cell, b = cell + 1 })
		end
		if cell <= Layout.Columns * (Layout.Rows - 1) then
			table.insert(edges, { a = cell, b = cell + Layout.Columns })
		end
	end
	return edges
end

function Layout.create(seed: number, stage: number): Plan
	assert(stage % 1 == 0 and stage >= 1 and stage <= 3, "Invalid map stage")
	local rng = Random.new(seed + stage * 104729)
	local kinds = rng.shuffle(Layout.Kinds)
	local rooms: { Room } = {}
	for cell, kind in kinds do
		local x, z = Layout.center(cell)
		table.insert(rooms, { cell = cell, kind = kind, x = x, z = z, turn = rng.integer(0, 3) })
	end
	local parents: { number } = {}
	for cell = 1, #rooms do
		parents[cell] = cell
	end
	local function root(cell: number): number
		while parents[cell] ~= cell do
			cell = parents[cell]
		end
		return cell
	end
	local links: { Link } = {}
	local spare: { Link } = {}
	for _, edge in rng.shuffle(Layout.edges()) do
		local a, b = root(edge.a), root(edge.b)
		if a ~= b then
			parents[b] = a
			table.insert(links, edge)
		else
			table.insert(spare, edge)
		end
	end
	-- Uma a três conexões adicionais: nunca gera um labirinto de becos sem alternativa.
	for index = 1, rng.integer(1, 3) do
		table.insert(links, spare[index])
	end
	table.sort(links, function(a, b)
		return a.a < b.a or (a.a == b.a and a.b < b.b)
	end)
	return { seed = seed, stage = stage, rooms = rooms, links = links }
end

function Layout.connected(plan: Plan, a: number, b: number): boolean
	for _, link in plan.links do
		if (link.a == a and link.b == b) or (link.b == a and link.a == b) then
			return true
		end
	end
	return false
end

function Layout.validate(plan: Plan): (boolean, string?)
	if #plan.rooms ~= #Layout.Kinds or #plan.links < 9 or #plan.links > 11 then
		return false, "invalid_map_size"
	end
	local seen: { [string]: boolean } = {}
	for cell, room in plan.rooms do
		local x, z = Layout.center(cell)
		if room.cell ~= cell or room.x ~= x or room.z ~= z then
			return false, "invalid_cell"
		end
		if not table.find(Layout.Kinds, room.kind) or seen[room.kind] then
			return false, "invalid_room_kind"
		end
		if room.turn % 1 ~= 0 or room.turn < 0 or room.turn > 3 then
			return false, "invalid_dressing"
		end
		seen[room.kind] = true
	end
	local allowed: { [string]: boolean } = {}
	for _, edge in Layout.edges() do
		allowed[`{edge.a}:{edge.b}`] = true
	end
	table.clear(seen)
	for _, link in plan.links do
		local key = `{link.a}:{link.b}`
		if not allowed[key] or seen[key] then
			return false, "invalid_map_link"
		end
		seen[key] = true
	end
	local reached: { [number]: boolean } = { [Layout.Entrances[1]] = true }
	local changed = true
	while changed do
		changed = false
		for _, link in plan.links do
			if reached[link.a] ~= reached[link.b] and (reached[link.a] or reached[link.b]) then
				reached[link.a], reached[link.b], changed = true, true, true
			end
		end
	end
	for cell = 1, #plan.rooms do
		if not reached[cell] then
			return false, "unreachable_map_room"
		end
	end
	return true, nil
end

function Layout.slots(plan: Plan): { { id: string, room: string, x: number, z: number } }
	local slots = {}
	for _, room in plan.rooms do
		-- Quadrante sudeste reservado ao terminal e à dupla do relé; nunca recebe props.
		table.insert(slots, { id = `sector_{room.cell}`, room = room.kind, x = room.x + 7, z = room.z + 7 })
	end
	return slots
end

-- Próxima sala em direção à entrada mais próxima; 0 significa saída para o núcleo antigo.
function Layout.returnRoutes(plan: Plan): { [number]: number }
	local routes: { [number]: number } = {}
	local queue = table.clone(Layout.Entrances)
	for _, cell in queue do
		routes[cell] = 0
	end
	local cursor = 1
	while cursor <= #queue do
		local cell = queue[cursor]
		cursor += 1
		for _, edge in plan.links do
			local other = if edge.a == cell then edge.b elseif edge.b == cell then edge.a else nil
			if other and routes[other] == nil then
				routes[other] = cell
				table.insert(queue, other)
			end
		end
	end
	return routes
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="508">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Props low poly feitos só com primitivas. Cada função recebe a posição da base (no chão)
	e um giro (yaw, graus). Nada aqui tem script nem dependência externa.
]]

local Build = require("./Build")
local Palette = require("./Palette")

local Props = {}

local V3 = Vector3.new
local DETAIL = { collide = false, query = false, material = Enum.Material.Metal }

-- Converte um offset local (relativo à base girada) em posição de mundo.
local function at(base: Vector3, yaw: number, offset: Vector3): Vector3
	return (CFrame.new(base) * CFrame.Angles(0, math.rad(yaw), 0)):PointToWorldSpace(offset)
end

-- CFrame de uma peça: base girada pelo yaw e deslocada pelo offset local.
local function rotated(base: Vector3, yaw: number, offset: Vector3): CFrame
	return CFrame.new(base) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.new(offset)
end

local function piece(
	parent: Instance,
	name: string,
	base: Vector3,
	yaw: number,
	offset: Vector3,
	size: Vector3,
	color: Color3,
	options: Build.PartOptions?
): BasePart
	return Build.part(parent, name, size, rotated(base, yaw, offset), color, options)
end

-- Mesa de escritório: tampo em y = 3.
function Props.desk(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Desk")
	piece(model, "Top", base, yaw, V3(0, 2.85, 0), V3(6, 0.3, 3), Palette.Wood)
	for _, x in { -2.7, 2.7 } do
		piece(model, "Side", base, yaw, V3(x, 1.35, 0), V3(0.3, 2.7, 2.8), Palette.WoodDark)
	end
	piece(model, "Drawers", base, yaw, V3(1.6, 1.6, 0.2), V3(2, 2.2, 2.4), Palette.WoodDark)
	-- Monitor CRT
	piece(model, "CRT", base, yaw, V3(-1.2, 3.75, 0.4), V3(1.6, 1.5, 1.4), Palette.VanBody)
	piece(model, "Screen", base, yaw, V3(-1.2, 3.8, -0.31), V3(1.25, 1.05, 0.05), Palette.Screen, { collide = false })
	-- Teclado, disquetes e papelada fora dos pontos de coleta sobre as mesas.
	piece(model, "Keyboard", base, yaw, V3(-1.2, 3.04, -0.85), V3(1.75, 0.12, 0.65), Palette.MetalDark, DETAIL)
	for i = 1, 3 do
		piece(
			model,
			"Keys",
			base,
			yaw,
			V3(-1.2, 3.11, -1.08 + i * 0.14),
			V3(1.45, 0.025, 0.045),
			Palette.VanBody,
			DETAIL
		)
	end
	for i = 1, 2 do
		piece(
			model,
			"Folder",
			base,
			yaw + i * 3,
			V3(1.5, 3.02 + i * 0.025, 0.65),
			V3(1.1, 0.025, 0.75),
			Palette.Paper,
			DETAIL
		)
	end
	piece(model, "Diskette", base, yaw, V3(0.2, 3.04, 0.9), V3(0.44, 0.06, 0.48), Palette.WallLowerCold, DETAIL)
	return model
end

function Props.chair(parent: Instance, base: Vector3, yaw: number, fallen: boolean?)
	local model = Build.model(parent, "Chair")
	local tilt = if fallen then CFrame.Angles(math.rad(85), 0, 0) else CFrame.identity
	local origin = CFrame.new(base) * CFrame.Angles(0, math.rad(yaw), 0) * tilt
	local function p(name: string, offset: Vector3, size: Vector3, color: Color3)
		Build.part(model, name, size, origin * CFrame.new(offset), color)
	end
	p("Seat", V3(0, 1.8, 0), V3(1.8, 0.25, 1.8), Palette.Fabric)
	p("Back", V3(0, 2.9, 0.8), V3(1.8, 2, 0.2), Palette.Fabric)
	p("Leg", V3(0, 0.9, 0), V3(0.25, 1.8, 0.25), Palette.MetalDark)
	p("Base", V3(0, 0.1, 0), V3(1.4, 0.2, 1.4), Palette.MetalDark)
	return model
end

-- Arquivo de aço: topo em y = 5.
function Props.cabinet(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Cabinet")
	piece(model, "Body", base, yaw, V3(0, 2.5, 0), V3(2, 5, 2), Palette.Metal)
	for i = 0, 3 do
		piece(model, "Drawer", base, yaw, V3(0, 0.75 + i * 1.2, -1.01), V3(1.7, 0.08, 0.05), Palette.MetalDark)
		piece(model, "Handle", base, yaw, V3(0, 1.1 + i * 1.2, -1.05), V3(0.6, 0.12, 0.08), Palette.MetalDark)
		piece(
			model,
			"LabelHolder",
			base,
			yaw,
			V3(0, 1.45 + i * 1.2, -1.025),
			V3(0.56, 0.18, 0.025),
			Palette.Paper,
			DETAIL
		)
	end
	return model
end

-- Caixote de madeira (cubo de lado `s`).
function Props.crate(parent: Instance, base: Vector3, yaw: number, s: number)
	local model = Build.model(parent, "Crate")
	piece(model, "Body", base, yaw, V3(0, s / 2, 0), V3(s, s, s), Palette.Wood)
	piece(model, "Band", base, yaw, V3(0, s / 2, 0), V3(s + 0.06, s * 0.18, s + 0.06), Palette.WoodDark)
	for _, sign in { -1, 1 } do
		piece(
			model,
			"Batten",
			base,
			yaw,
			V3(sign * s * 0.32, s / 2, -s / 2 - 0.04),
			V3(s * 0.12, s, 0.05),
			Palette.WoodDark,
			DETAIL
		)
	end
	piece(
		model,
		"ShippingLabel",
		base,
		yaw,
		V3(0, s * 0.7, -s / 2 - 0.07),
		V3(s * 0.28, s * 0.16, 0.02),
		Palette.Paper,
		DETAIL
	)
	return model
end

-- Estante com 3 prateleiras (tampos em y = 1.4, 2.9, 4.4), largura ao longo do X local.
function Props.shelf(parent: Instance, base: Vector3, yaw: number, width: number)
	local model = Build.model(parent, "Shelf")
	for _, x in { -width / 2 + 0.15, width / 2 - 0.15 } do
		for _, z in { -0.85, 0.85 } do
			piece(model, "Post", base, yaw, V3(x, 3, z), V3(0.25, 6, 0.25), Palette.MetalDark)
		end
	end
	for _, y in { 1.3, 2.8, 4.3, 5.8 } do
		piece(model, "Board", base, yaw, V3(0, y, 0), V3(width, 0.2, 2), Palette.Metal)
	end
	-- Caixas de papelão
	local boxes = { { -2.2, 1.4, 1.2 }, { 0.4, 1.4, 1.6 }, { -1, 2.9, 1.3 }, { 2.4, 4.4, 1.1 } }
	for _, b in boxes do
		if math.abs(b[1]) + b[3] / 2 < width / 2 then
			piece(model, "Box", base, yaw, V3(b[1], b[2] + b[3] / 2, 0), V3(b[3], b[3], 1.4), Palette.Gravel)
		end
	end
	return model
end

function Props.locker(parent: Instance, base: Vector3, yaw: number, count: number)
	local model = Build.model(parent, "Lockers")
	for i = 0, count - 1 do
		local x = (i - (count - 1) / 2) * 1.6
		piece(model, "Locker", base, yaw, V3(x, 3.2, 0), V3(1.5, 6.4, 1.5), Palette.WallLowerCold)
		piece(model, "Vent", base, yaw, V3(x, 5.6, -0.76), V3(1, 0.5, 0.05), Palette.MetalDark)
		piece(model, "Handle", base, yaw, V3(x + 0.5, 3.2, -0.78), V3(0.12, 0.6, 0.08), Palette.Metal)
	end
	return model
end

-- Balcão da recepção (comprimento ao longo do X local): tampo em y = 3.4.
function Props.counter(parent: Instance, base: Vector3, yaw: number, length: number)
	local model = Build.model(parent, "Counter")
	piece(model, "Front", base, yaw, V3(0, 1.6, 0), V3(length, 3.2, 1.6), Palette.WoodDark)
	piece(model, "Top", base, yaw, V3(0, 3.3, 0), V3(length + 0.4, 0.2, 2), Palette.Wood)
	piece(model, "Phone", base, yaw, V3(length / 2 - 1, 3.55, 0.2), V3(0.9, 0.3, 0.6), Palette.MetalDark)
	return model
end

function Props.bench(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Bench")
	piece(model, "Seat", base, yaw, V3(0, 1.6, 0), V3(6, 0.3, 1.4), Palette.Wood)
	for _, x in { -2.6, 2.6 } do
		piece(model, "Leg", base, yaw, V3(x, 0.75, 0), V3(0.3, 1.5, 1.2), Palette.MetalDark)
	end
	return model
end

-- Bancada de trabalho: tampo em y = 3.2.
function Props.workbench(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Workbench")
	piece(model, "Top", base, yaw, V3(0, 3.05, 0), V3(8, 0.3, 2.6), Palette.WoodDark)
	for _, x in { -3.7, 3.7 } do
		piece(model, "Leg", base, yaw, V3(x, 1.45, 0), V3(0.4, 2.9, 2.4), Palette.MetalDark)
	end
	piece(model, "Shelf", base, yaw, V3(0, 0.9, 0), V3(7, 0.2, 2.2), Palette.Metal)
	piece(model, "Vise", base, yaw, V3(-3, 3.5, 0.6), V3(0.8, 0.6, 0.6), Palette.Red)
	piece(model, "Toolbox", base, yaw, V3(2.6, 3.6, -0.4), V3(1.6, 0.8, 0.8), Palette.Red)
	piece(model, "Pegboard", base, yaw, V3(0, 5.5, 1.2), V3(7, 3, 0.2), Palette.WoodDark)
	return model
end

-- Tanque de bomba (cilindro vertical) com tubos.
function Props.pumpTank(parent: Instance, base: Vector3, height: number, diameter: number)
	local model = Build.model(parent, "PumpTank")
	Build.cylinder(model, "Tank", base + V3(0, height / 2, 0), Vector3.yAxis, height, diameter, Palette.Metal, {
		material = Enum.Material.Metal,
	})
	Build.cylinder(model, "Cap", base + V3(0, height + 0.25, 0), Vector3.yAxis, 0.5, diameter * 0.7, Palette.MetalDark)
	Build.cylinder(model, "Band", base + V3(0, height * 0.35, 0), Vector3.yAxis, 0.4, diameter + 0.1, Palette.Hazard)
	Build.cylinder(
		model,
		"Riser",
		base + V3(0, height + (11 - height) / 2, 0),
		Vector3.yAxis,
		11 - height,
		0.8,
		Palette.Rust
	)
	Build.cylinder(model, "Valve", base + V3(diameter / 2 + 0.3, 2.5, 0), Vector3.xAxis, 0.2, 1.4, Palette.Red)
	return model
end

-- Tubo reto entre dois pontos (`solid = false` para cabos no chão: não viram obstáculo).
function Props.pipe(parent: Instance, a: Vector3, b: Vector3, diameter: number, color: Color3?, solid: boolean?)
	local delta = b - a
	return Build.cylinder(parent, "Pipe", (a + b) / 2, delta, delta.Magnitude, diameter, color or Palette.Rust, {
		collide = solid ~= false,
	})
end

-- Gerador a diesel grande.
function Props.generator(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Generator")
	piece(model, "Skid", base, yaw, V3(0, 0.3, 0), V3(11, 0.6, 6.4), Palette.MetalDark)
	piece(model, "Body", base, yaw, V3(0.5, 3, 0), V3(9, 4.8, 5.2), Palette.Hazard, { material = Enum.Material.Metal })
	piece(model, "Engine", base, yaw, V3(-4.2, 2.4, 0), V3(2, 3.6, 4), Palette.MetalDark)
	for i = -3, 3 do
		piece(model, "Grille", base, yaw, V3(i * 1.1 + 0.5, 3, -2.62), V3(0.25, 3.6, 0.05), Palette.MetalDark)
	end
	piece(model, "ControlBox", base, yaw, V3(3.5, 6, 1.5), V3(2, 1.6, 1.2), Palette.Metal)
	Build.cylinder(model, "Exhaust", at(base, yaw, V3(-3, 8.5, 1.5)), Vector3.yAxis, 5, 0.9, Palette.Rust)
	for _, x in { -3.2, 3.2 } do
		for _, z in { -2.3, 2.3 } do
			piece(model, "Bolt", base, yaw, V3(x, 0.62, z), V3(0.22, 0.1, 0.22), Palette.Brass, DETAIL)
		end
	end
	piece(model, "MakerPlate", base, yaw, V3(3.5, 3.8, -2.65), V3(1.4, 0.65, 0.035), Palette.Paper, DETAIL)
	return model
end

-- Luminária de teto: devolve a peça que leva a luz.
function Props.lampFixture(parent: Instance, position: Vector3): BasePart
	local model = Build.model(parent, "Lamp")
	Build.part(model, "Housing", V3(4, 0.3, 1.2), CFrame.new(position + V3(0, 0.25, 0)), Palette.MetalDark)
	local tube =
		Build.part(model, "Tube", V3(3.6, 0.2, 0.8), CFrame.new(position), Palette.LampOff, { collide = false })
	return tube
end

-- Luz de emergência (caixinha vermelha na parede).
function Props.emergencyLight(parent: Instance, position: Vector3): BasePart
	local box = Build.part(parent, "Emergency", V3(1, 0.5, 0.5), CFrame.new(position), Palette.Emergency, {
		material = Enum.Material.Neon,
		collide = false,
	})
	return box
end

-- Fusível cerâmico: devolve o modelo e a peça foco (corpo).
function Props.fuse(parent: Instance, name: string, position: Vector3): (Model, BasePart)
	local model = Build.model(parent, name)
	local body = Build.cylinder(model, "Body", position, Vector3.xAxis, 1.1, 0.45, Palette.Ceramic, {
		collide = false,
	})
	for _, dx in { -0.6, 0.6 } do
		Build.cylinder(model, "Cap", position + V3(dx, 0, 0), Vector3.xAxis, 0.18, 0.5, Palette.Metal, {
			collide = false,
			material = Enum.Material.Metal,
		})
	end
	Build.cylinder(model, "Glow", position, Vector3.xAxis, 0.12, 0.47, Palette.FuseGlow, {
		collide = false,
		material = Enum.Material.Neon,
	})
	model.PrimaryPart = body
	return model, body
end

-- Bilhete de papel deitado.
function Props.note(parent: Instance, name: string, position: Vector3, yaw: number): BasePart
	local paper = Build.part(
		parent,
		name,
		V3(1.3, 0.05, 1.7),
		CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0),
		Palette.Paper,
		{ collide = false }
	)
	-- "Linhas" escritas
	for i = 0, 4 do
		Build.part(
			parent,
			"Ink",
			V3(0.9 - (i % 2) * 0.25, 0.01, 0.06),
			paper.CFrame * CFrame.new(-0.05, 0.03, -0.55 + i * 0.25),
			Palette.Black,
			{ collide = false, query = false }
		)
	end
	return paper
end

-- Pinheiro em blocos (tronco + camadas giradas 45°).
function Props.tree(parent: Instance, base: Vector3, height: number, rng: Random)
	local model = Build.model(parent, "Tree")
	Build.block(model, "Trunk", base, V3(1.2, height * 0.45, 1.2), 0, Palette.Trunk)
	local layers = 4
	for i = 1, layers do
		local t = (i - 1) / (layers - 1)
		local width = (1 - t * 0.75) * height * 0.42
		local y = height * (0.3 + t * 0.55)
		Build.part(
			model,
			"Foliage",
			V3(width, height * 0.22, width),
			CFrame.new(base + V3(0, y, 0)) * CFrame.Angles(0, math.rad(45 * i + rng:NextNumber(-10, 10)), 0),
			if i % 2 == 0 then Palette.Foliage else Palette.FoliageDark
		)
	end
	return model
end

-- Van de serviço abandonada (a frente aponta para -Z local).
function Props.van(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Van")
	piece(model, "Body", base, yaw, V3(0, 3.6, 1), V3(5.6, 5, 9), Palette.VanBody)
	piece(model, "Cab", base, yaw, V3(0, 2.9, -4.5), V3(5.6, 3.6, 2.4), Palette.VanBody)
	piece(model, "Hood", base, yaw, V3(0, 2.2, -6.1), V3(5.4, 1.6, 1.2), Palette.VanBody)
	piece(model, "Windshield", base, yaw, V3(0, 4.1, -5.65), V3(5, 1.6, 0.1), Palette.Screen, { reflectance = 0.2 })
	piece(model, "Stripe", base, yaw, V3(0, 3.4, 1), V3(5.7, 0.5, 9.05), Palette.Red)
	for _, x in { -2.7, 2.7 } do
		for _, z in { -4.6, 3.6 } do
			Build.cylinder(model, "Wheel", at(base, yaw, V3(x, 1.2, z)), Vector3.xAxis, 0.8, 2.4, Palette.Black)
		end
	end
	piece(model, "Bumper", base, yaw, V3(0, 1.4, -6.8), V3(5.8, 0.6, 0.4), Palette.MetalDark)
	return model
end

-- Guarita do vigia.
function Props.booth(parent: Instance, base: Vector3, yaw: number)
	local model = Build.model(parent, "Booth")
	piece(model, "Floor", base, yaw, V3(0, 0.25, 0), V3(6, 0.5, 6), Palette.Concrete)
	piece(model, "Back", base, yaw, V3(0, 4, 2.8), V3(6, 7, 0.4), Palette.Facade)
	piece(model, "Left", base, yaw, V3(-2.8, 4, 0), V3(0.4, 7, 6), Palette.Facade)
	piece(model, "Right", base, yaw, V3(2.8, 4, 0.9), V3(0.4, 7, 4.2), Palette.Facade)
	piece(model, "FrontLow", base, yaw, V3(0, 2, -2.8), V3(6, 3.5, 0.4), Palette.Facade)
	piece(model, "Roof", base, yaw, V3(0, 7.7, 0), V3(7, 0.5, 7), Palette.Trim)
	piece(model, "Desk", base, yaw, V3(0, 2.6, -2.2), V3(5, 0.3, 1), Palette.Wood)
	return model
end

-- Poste com luminária de rua (devolve a cabeça, onde vai a luz).
function Props.streetLamp(parent: Instance, base: Vector3): BasePart
	local model = Build.model(parent, "StreetLamp")
	Build.block(model, "Pole", base, V3(0.5, 12, 0.5), 0, Palette.MetalDark)
	Build.part(model, "Arm", V3(0.3, 0.3, 3), CFrame.new(base + V3(0, 11.8, -1.4)), Palette.MetalDark)
	local head = Build.part(model, "Head", V3(1.2, 0.4, 1.8), CFrame.new(base + V3(0, 11.5, -2.8)), Palette.Sodium, {
		material = Enum.Material.Neon,
	})
	return head
end

-- Refletor em poste (devolve a cabeça, que recebe uma SpotLight).
function Props.floodLight(parent: Instance, base: Vector3, target: Vector3): BasePart
	local model = Build.model(parent, "FloodLight")
	Build.block(model, "Pole", base, V3(0.5, 10, 0.5), 0, Palette.MetalDark)
	local headPos = base + V3(0, 10.4, 0)
	local head = Build.part(model, "Head", V3(2, 1.2, 0.8), CFrame.lookAt(headPos, target), Palette.LampOff)
	return head
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="509">
          <Properties>
            <string name="Name">SectorBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Ala modular física. O eixo de dez studs e o quadrante do terminal ficam livres de equipamentos.
local CollectionService = game:GetService("CollectionService")
local Catalog = require("@game/ReplicatedStorage/Shared/Game/CampaignCatalog")
local Build = require("./Build")
local Layout = require("./ProceduralLayout")
local Palette = require("./Palette")
local Props = require("./Props")
local Exterior = require("./SectorExterior")

local Builder = {}
local V3 = Vector3.new
local HALF = Layout.RoomSize / 2
local HEIGHT = 11
local DECOR = { collide = false, query = false, material = Enum.Material.Metal }

local function surface(part: BasePart, style: string)
	part:SetAttribute("SurfaceStyle", style)
	CollectionService:AddTag(part, "ArtSurface")
end

local function sign(parent: Instance, p: Vector3, facing: Vector3, text: string, size: Vector2?)
	local part = Build.sign(parent, "SectorSign", p, facing, size or Vector2.new(8, 1.2), text, {
		textColor = Palette.Paper,
		background = Palette.WallLowerCold,
		lit = true,
		thickness = 0.04,
	})
	part.CanQuery = false
end

local function wall(parent: Instance, a: Vector3, b: Vector3, opening: boolean, outdoor: boolean?)
	local length = (b - a).Magnitude
	local horizontal = math.abs(b.X - a.X) > 1
	local function segment(offset: number, width: number, bottom: number, top: number)
		local center = (a + b) / 2 + (b - a).Unit * offset
		local size = if horizontal then V3(width, top - bottom, 1) else V3(1, top - bottom, width)
		local part = Build.part(
			parent,
			"Wall_Sector",
			size,
			CFrame.new(center + V3(0, (top + bottom) / 2, 0)),
			if bottom == 0 then Palette.WallLowerCold else Palette.WallUpperCold,
			{ material = Enum.Material.Concrete }
		)
		part:SetAttribute("SectorWall", true)
		if outdoor then
			part.Material = Enum.Material.Metal
			part.Transparency = 0.55
			part.CastShadow = false
		end
	end
	if opening then
		local side = (length - Layout.DoorWidth) / 2
		for _, direction in { -1, 1 } do
			local offset = direction * (Layout.DoorWidth / 2 + side / 2)
			segment(offset, side, 0, 3.2)
			segment(offset, side, 3.2, HEIGHT)
		end
		segment(0, Layout.DoorWidth, 9, HEIGHT)
		local threshold = Build.block(
			parent,
			"Threshold",
			(a + b) / 2 + V3(0, 0.015, 0),
			if horizontal then V3(Layout.DoorWidth, 0.025, 0.7) else V3(0.7, 0.025, Layout.DoorWidth),
			0,
			Palette.Hazard,
			{ collide = false, query = false }
		)
		threshold.Material = Enum.Material.Metal
	else
		segment(0, length, 0, 3.2)
		segment(0, length, 3.2, HEIGHT)
	end
end

-- Peças locais; todas cabem numa área 8x8, fora do cruzamento e da estação de atividade.
local function equipment(parent: Instance, kind: string, frame: CFrame)
	local model = Build.model(parent, "Equipment")
	local function block(name: string, p: Vector3, size: Vector3, color: Color3): BasePart
		return Build.block(model, name, p, size, 0, color, { material = Enum.Material.Metal })
	end
	if kind == "Cooling" or kind == "WaterTreatment" then
		for _, x in { -1.6, 1.6 } do
			Props.pumpTank(model, V3(x, 0, 0), if kind == "Cooling" then 6 else 4.8, 2.5)
		end
		Props.pipe(model, V3(-3, 7.6, 0), V3(3, 7.6, 0), 0.5, Palette.Rust, false)
		block("ValveBox", V3(0, 0, 2.5), V3(1.8, 1.4, 1), Palette.MetalDark)
	elseif kind == "RelayHall" or kind == "BatteryBank" then
		block("Rack", V3(0, 0, 0), V3(6, 6.4, 2), Palette.WallLowerCold)
		for row = 1, 3 do
			for column = -1, 1 do
				block("Cell", V3(column * 1.7, row * 1.5 - 0.7, 1.05), V3(1.3, 1, 0.5), Palette.MetalDark)
				block("Terminal", V3(column * 1.7, row * 1.5 + 0.35, 1.2), V3(0.22, 0.2, 0.3), Palette.Brass)
			end
		end
	elseif kind == "Radio" then
		block("Console", V3(0, 0, 0), V3(6, 3.2, 3), Palette.WallLowerCold)
		for _, x in { -1.7, 1.7 } do
			block("Radio", V3(x, 3.2, 0), V3(2.6, 1.7, 1.8), Palette.Metal)
			for y = 1, 3 do
				Build.block(
					model,
					"SpeakerGrille",
					V3(x, 3.4 + y * 0.3, 0.94),
					V3(1.5, 0.08, 0.04),
					0,
					Palette.Black,
					DECOR
				)
			end
		end
		local screen =
			Build.part(model, "Screen", V3(1.3, 0.7, 0.05), CFrame.new(-1.7, 4.3, -0.94), Palette.Screen, DECOR)
		CollectionService:AddTag(screen, "ArtScreen")
	elseif kind == "MachineShop" then
		block("LatheBase", V3(0, 0, 0), V3(6, 2.3, 3), Palette.WallLowerCold)
		Build.cylinder(model, "LatheSpindle", V3(0, 3.3, 0), Vector3.xAxis, 5, 1.7, Palette.Metal)
		for _, x in { -2.5, 2.5 } do
			block("LatheHead", V3(x, 2.3, 0), V3(1, 2.3, 2.5), Palette.MetalDark)
		end
	elseif kind == "Inspection" then
		Props.workbench(model, Vector3.zero, 0)
		block("TestInstrument", V3(0, 3.2, 0), V3(1.8, 1.3, 1.3), Palette.Ceramic)
	elseif kind == "CableDepot" then
		for _, x in { -1.7, 1.7 } do
			Build.cylinder(model, "ReelCable", V3(x, 1.7, 0), Vector3.zAxis, 2, 2.8, Palette.Black)
			for _, z in { -1.1, 1.1 } do
				Build.cylinder(model, "ReelSide", V3(x, 1.7, z), Vector3.zAxis, 0.25, 3.4, Palette.WoodDark)
			end
		end
	elseif kind == "Turbine" then
		block("TurbineBed", V3(0, 0, 0), V3(7, 0.6, 5), Palette.Concrete)
		Build.cylinder(model, "TurbineBody", V3(0, 3, 0), Vector3.xAxis, 6, 4, Palette.Metal)
		for x = -2, 2 do
			Build.cylinder(model, "CoolingRing", V3(x, 3, 0), Vector3.xAxis, 0.15, 4.3, Palette.MetalDark)
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CFrame = frame * part.CFrame
			if part.Name == "Rack" or part.Name == "Console" or part.Name == "TurbineBody" then
				surface(part, "rust")
			end
		end
	end
end

local function dressing(parent: Instance, room: Layout.Room)
	local center = V3(room.x, 0, room.z)
	local corners = { V3(-9, 0, -9), V3(9, 0, -9), V3(-9, 0, 9) }
	local corner = room.turn % #corners + 1
	equipment(parent, room.kind, CFrame.new(center + corners[corner]) * CFrame.Angles(0, room.turn * math.pi / 2, 0))
	Props.crate(parent, center + corners[corner % #corners + 1], room.turn * 90, 3)
	-- Bandeja e tubos altos reforçam a direção das passagens sem ocupar a altura do Vigia.
	Build.block(parent, "CableTray", center + V3(0, 10, 0), V3(2, 0.2, 26), 0, Palette.MetalDark, DECOR)
	Props.pipe(parent, center + V3(-3, 9.7, -13), center + V3(-3, 9.7, 13), 0.18, Palette.Rust, false)
	local lamp = Build.block(parent, "SectorLamp", center + V3(0, 9.6, 0), V3(4, 0.25, 0.7), 0, Palette.LampOff, DECOR)
	Build.light(lamp, "Lamp", Palette.Fluorescent, 24, 1.1, false, room.cell % 4 == 0)
	local emergency =
		Build.block(parent, "Emergency", center + V3(-12.8, 7.5, 0), V3(0.4, 0.6, 1), 0, Palette.Red, DECOR)
	Build.light(emergency, "Emergency", Palette.Emergency, 15, 0.65, true)
	local dust = Build.part(
		parent,
		"DustAnchor",
		V3(0.1, 0.1, 0.1),
		CFrame.new(center + V3(0, 7, 0)),
		Palette.Paper,
		{ collide = false, query = false, transparency = 1 }
	)
	CollectionService:AddTag(dust, "ArtDust")
	sign(
		parent,
		center + V3(8, 7, 13.4),
		-Vector3.zAxis,
		string.format("N-%02d / %s", room.cell, Catalog.RoomNames[room.kind]),
		Vector2.new(10, 1.8)
	)
	-- Marcações de circulação deixam legíveis os cruzamentos sob a iluminação de emergência.
	for _, offset in { -8, 8 } do
		Build.block(
			parent,
			"RouteMark",
			center + V3(0, 0.02, offset),
			V3(0.2, 0.02, 3),
			0,
			Palette.Hazard,
			{ collide = false, query = false }
		)
	end
end

local function passage(parent: Instance, spec: Layout.Passage)
	local model = Build.model(parent, spec.id)
	model:SetAttribute("Covered", spec.covered)
	local x, z = (spec.x0 + spec.x1) / 2, (spec.z0 + spec.z1) / 2
	local sx, sz = spec.x1 - spec.x0, spec.z1 - spec.z0
	Build.block(model, "PassageFloor", V3(x, -1, z), V3(sx, 1, sz), 0, Palette.MetalFloor, {
		material = Enum.Material.DiamondPlate,
	})
	if spec.covered then
		Build.block(model, "PassageRoof", V3(x, HEIGHT, z), V3(sx + 0.5, 0.5, sz + 0.5), 0, Palette.Ceiling)
	end
	if spec.id == "AccessGallery" then
		-- Fecha só os intervalos entre pavilhões, sem paredes cruzando os três acessos.
		for _, gapX in { -28, 16 } do
			wall(model, V3(gapX - 8, 0, spec.z0), V3(gapX + 8, 0, spec.z0), false)
		end
		for _, lx in { -50, -6, 38 } do
			local lamp = Build.block(model, "GalleryLamp", V3(lx, 9.8, z), V3(4, 0.2, 0.7), 0, Palette.LampOff, DECOR)
			Build.light(lamp, "Lamp", Palette.Fluorescent, 26, 1, false)
		end
		sign(model, V3(-60, 8.5, -87), Vector3.xAxis, "< VIA EXTERNA / MANUTENÇÃO")
		sign(model, V3(48, 8.5, -87), -Vector3.xAxis, "TUBULAÇÕES / PÁTIO NORTE >")
	else
		local horizontal = sx > sz
		local height = if spec.covered then HEIGHT else 1.2
		for _, side in { -1, 1 } do
			Build.block(
				model,
				if spec.covered then "PassageWall" else "WalkwayRail",
				V3(x + (if horizontal then 0 else side * sx / 2), 0, z + (if horizontal then side * sz / 2 else 0)),
				if horizontal then V3(sx, height, 0.4) else V3(0.4, height, sz),
				0,
				Palette.WallLowerCold
			)
		end
		Build.block(
			model,
			"OverheadTray",
			V3(x, 9.8, z),
			if horizontal then V3(sx, 0.2, 1) else V3(1, 0.2, sz),
			0,
			Palette.MetalDark,
			DECOR
		)
		local lamp = Build.block(model, "PassageLamp", V3(x, 8.5, z), V3(0.6, 0.3, 0.6), 0, Palette.Red, DECOR)
		Build.light(lamp, "Emergency", Palette.Emergency, 16, 0.45, true)
	end
end

function Builder.build(parent: Instance, plan: Layout.Plan): Folder
	local valid, reason = Layout.validate(plan)
	assert(valid, `[SectorBuilder] invalid layout: {reason}`)
	local root = Instance.new("Folder")
	root.Name = "ProceduralSector"
	root:SetAttribute("Seed", plan.seed)
	root:SetAttribute("Stage", plan.stage)
	local structure = Build.folder(root, "Structure")
	for _, room in plan.rooms do
		local model = Build.model(root, `Cell_{room.cell}`)
		model:SetAttribute("RoomKind", room.kind)
		model:SetAttribute("Cell", room.cell)
		local center = V3(room.x, 0, room.z)
		local floor = Build.block(
			model,
			"Floor_Sector",
			center - Vector3.yAxis,
			V3(Layout.RoomSize, 1, Layout.RoomSize),
			0,
			Palette.Concrete,
			{ material = Enum.Material.Concrete }
		)
		surface(floor, "concrete")
		local outdoor = Layout.isOutdoorRoom(room)
		model:SetAttribute("Outdoor", outdoor)
		if not outdoor then
			Build.block(model, "Roof_Sector", center + V3(0, HEIGHT, 0), V3(28.5, 1, 28.5), 0, Palette.Ceiling)
		end
		dressing(model, room)
		local x0, x1 = room.x - HALF, room.x + HALF
		local z0, z1 = room.z - HALF, room.z + HALF
		wall(
			structure,
			V3(x0, 0, z0),
			V3(x0, 0, z1),
			room.cell % 3 == 1 or Layout.connected(plan, room.cell, room.cell - 1),
			outdoor
		)
		wall(
			structure,
			V3(x1, 0, z0),
			V3(x1, 0, z1),
			room.cell % 3 == 0 or Layout.connected(plan, room.cell, room.cell + 1),
			outdoor
		)
		wall(
			structure,
			V3(x0, 0, z0),
			V3(x1, 0, z0),
			room.cell == 8 or Layout.connected(plan, room.cell, room.cell + 3),
			outdoor
		)
		wall(
			structure,
			V3(x0, 0, z1),
			V3(x1, 0, z1),
			room.cell <= 3 or Layout.connected(plan, room.cell, room.cell - 3),
			outdoor
		)
	end
	for _, spec in Layout.passages(plan) do
		passage(structure, spec)
	end
	Exterior.build(root)
	local returns = Layout.returnRoutes(plan)
	for _, link in plan.links do
		local a, b = plan.rooms[link.a], plan.rooms[link.b]
		local midpoint = V3((a.x + b.x) / 2, 9.6, (a.z + b.z) / 2)
		local toward = V3(b.x - a.x, 0, b.z - a.z).Unit
		sign(
			structure,
			midpoint - toward * 0.58,
			-toward,
			Catalog.RoomNames[b.kind] .. (if returns[a.cell] == b.cell then " / SAÍDA" else "")
		)
		sign(
			structure,
			midpoint + toward * 0.58,
			toward,
			Catalog.RoomNames[a.kind] .. (if returns[b.cell] == a.cell then " / SAÍDA" else "")
		)
	end
	for _, cell in Layout.Entrances do
		local room = plan.rooms[cell]
		local x = Layout.entranceX(cell)
		sign(root, V3(x, 9.5, -77.4), Vector3.zAxis, "GALERIA NORTE / " .. Catalog.RoomNames[room.kind])
		sign(root, V3(x, 9.5, -78.6), -Vector3.zAxis, "RETORNO / SAÍDA SUL")
	end
	-- Diretório físico acompanha a distribuição real a cada rodada.
	local lines = { "ALA NORTE / PLANTA DO TURNO", `TURNO {plan.stage} / LOTE {plan.seed}` }
	for _, room in plan.rooms do
		table.insert(lines, string.format("N-%02d / %s", room.cell, Catalog.RoomNames[room.kind]))
	end
	table.insert(lines, "v CONTROLE / ARQUIVO / SAÍDA v")
	-- Parede sul do controle: o diretório não pode ficar atrás dos monitores da parede norte.
	sign(root, V3(-3, 6.4, -50.6), -Vector3.zAxis, table.concat(lines, "\n"), Vector2.new(10, 6.5))
	-- Troca atômica: a ala anterior só sai após a nova geometria estar pronta.
	local previous = parent:FindFirstChild(root.Name)
	if previous then
		previous:Destroy()
	end
	root.Parent = parent
	return root
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="510">
          <Properties>
            <string name="Name">SectorExterior</string>
            <string name="Source"><![CDATA[--!strict
-- Anel externo utilizável: carga ao norte, manutenção a oeste e tubulações a leste.
local Build = require("./Build")
local Layout = require("./ProceduralLayout")
local Palette = require("./Palette")
local Props = require("./Props")

local Exterior = {}
local V3 = Vector3.new
local DECOR = { collide = false, query = false, material = Enum.Material.Metal }

local function fence(parent: Instance, a: Vector3, b: Vector3)
	local height = 10 -- Acima do teto da van + salto normal: o cenário não vira atalho sobre a cerca.
	local length = (b - a).Magnitude
	local frame = CFrame.lookAt((a + b) / 2 + V3(0, height / 2, 0), b + V3(0, height / 2, 0))
	Build.part(parent, "PerimeterFence", V3(0.2, height, length), frame, Palette.Fence, {
		material = Enum.Material.Metal,
		transparency = 0.55,
	})
	Build.part(parent, "FenceTop", V3(0.3, 0.3, length), frame * CFrame.new(0, height / 2, 0), Palette.MetalDark)
	local count = math.ceil(length / 12)
	for i = 0, count do
		Build.block(parent, "FencePost", a:Lerp(b, i / count), V3(0.4, height + 0.5, 0.4), 0, Palette.MetalDark)
	end
end

local function sign(parent: Instance, position: Vector3, facing: Vector3, text: string)
	local part = Build.sign(parent, "ExteriorSign", position, facing, Vector2.new(9, 1.8), text, {
		textColor = Palette.Paper,
		background = Palette.WallLowerCold,
		lit = true,
	})
	part.CanQuery = false
end

function Exterior.build(parent: Instance)
	local root = Build.folder(parent, "ExteriorLoop")
	for _, zone in Layout.ExteriorZones do
		local floor = Build.box(root, zone.id, V3(zone.x0, -1, zone.z0), V3(zone.x1, 0, zone.z1), Palette.Gravel, {
			material = Enum.Material.Pebble,
		})
		floor:SetAttribute("OutdoorArea", zone.id)
	end
	local b = Layout.Bounds
	fence(root, V3(b.x0, 0, b.z1), V3(b.x0, 0, b.z0))
	fence(root, V3(b.x0, 0, b.z0), V3(b.x1, 0, b.z0))
	fence(root, V3(b.x1, 0, b.z0), V3(b.x1, 0, b.z1))
	-- Encontra as cercas/paredes antigas; o portão frontal continua sendo a única saída.
	fence(root, V3(b.x0, 0, b.z1), V3(-68, 0, b.z1))
	fence(root, V3(40, 0, b.z1), V3(b.x1, 0, b.z1))

	local loading = Build.model(root, "LoadingDock")
	Build.block(loading, "DockPad", V3(-34, 0, -229), V3(32, 0.18, 5), 0, Palette.Concrete)
	for _, x in { -45, -35, -25 } do
		Props.crate(loading, V3(x, 0.18, -229), 0, 3)
		Build.block(loading, "DockBollard", V3(x, 0, -225.5), V3(0.4, 2, 0.4), 0, Palette.Hazard)
	end
	Build.block(loading, "LoadingCanopy", V3(-34, 10.8, -228), V3(34, 0.4, 7), 0, Palette.MetalDark)
	for _, x in { -50, -18 } do
		Build.block(loading, "CanopyPost", V3(x, 0, -230.5), V3(0.5, 11, 0.5), 0, Palette.MetalDark)
	end
	sign(loading, V3(-34, 8.7, -224.4), Vector3.zAxis, "RECEBIMENTO / DOCA 09")
	Props.van(root, V3(20, 0, -228), 90)
	-- Equipamentos ficam nas bordas; o eixo x=-82 permanece livre para a perseguição.
	for _, z in { -121, -165, -209 } do
		Props.pumpTank(root, V3(-91, 0, z), 6, 4)
		Build.block(root, "Drain", V3(-67, 0.015, z), V3(1.5, 0.03, 7), 0, Palette.MetalDark, DECOR)
	end
	for _, z in { -115, -159, -203 } do
		Build.block(root, "PipeSupport", V3(69, 0, z), V3(0.6, 10, 0.6), 0, Palette.MetalDark)
	end
	for _, x in { 67, 69 } do
		Props.pipe(root, V3(x, 10, -209), V3(x, 10, -97), 0.5, Palette.Rust, false)
	end
	for _, point in { V3(-93, 0, -90), V3(-93, 0, -180), V3(69, 0, -90), V3(69, 0, -218) } do
		local lamp = Props.streetLamp(root, point)
		Build.light(lamp, "Street", Palette.Sodium, 30, 0.85, true)
	end
	for _, x in { -82, 62 } do
		for z = -214, -94, 16 do
			Build.block(root, "ExteriorRouteMark", V3(x - 5, 0.015, z), V3(0.2, 0.02, 4), 0, Palette.Hazard, DECOR)
		end
	end
	for _, point in { V3(-73, 0.01, -138), V3(58, 0.01, -181), V3(-2, 0.01, -217) } do
		Build.block(root, "RainPuddle", point, V3(5, 0.02, 3), 12, Palette.Black, {
			collide = false,
			query = false,
			material = Enum.Material.SmoothPlastic,
			reflectance = 0.25,
		})
	end
	sign(root, V3(-94.5, 7, -100), Vector3.xAxis, "VIA DE SERVIÇO / ^ DOCA")
	sign(root, V3(70.5, 7, -100), -Vector3.xAxis, "TUBULAÇÕES / ^ PÁTIO NORTE")
	sign(root, V3(-82, 7, -79), -Vector3.zAxis, "GALERIA / SAÍDA >")
	sign(root, V3(62, 7, -79), -Vector3.zAxis, "< GALERIA / SAÍDA")
end

return Exterior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="511">
          <Properties>
            <string name="Name">WallMath</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Geometria pura de paredes com aberturas (portas e janelas). Testado no Lune.

	Uma parede vai de `from` a `to` ao longo do seu eixo e de y0 a y1 na altura.
	Cada abertura retira um retângulo [center ± width/2] x [bottom, top].
	O resultado são retângulos sólidos { a, b, y0, y1 } no espaço da parede.
]]

export type Opening = { center: number, width: number, bottom: number, top: number }
export type Segment = { a: number, b: number, y0: number, y1: number }

local EPSILON = 1e-6

local WallMath = {}

function WallMath.solidSegments(from: number, to: number, y0: number, y1: number, openings: { Opening }): { Segment }
	local sorted = table.clone(openings)
	table.sort(sorted, function(left, right)
		return left.center < right.center
	end)

	local segments: { Segment } = {}
	local function add(a: number, b: number, low: number, high: number)
		if b - a > EPSILON and high - low > EPSILON then
			table.insert(segments, { a = a, b = b, y0 = low, y1 = high })
		end
	end

	local cursor = from
	for _, opening in sorted do
		local oa = math.max(from, opening.center - opening.width / 2)
		local ob = math.min(to, opening.center + opening.width / 2)
		add(cursor, oa, y0, y1)
		add(oa, ob, y0, math.min(y1, opening.bottom)) -- peitoril (janelas)
		add(oa, ob, math.max(y0, opening.top), y1) -- verga acima da abertura
		cursor = math.max(cursor, ob)
	end
	add(cursor, to, y0, y1)
	return segments
end

-- Divide segmentos na altura `split` (faixa inferior / superior com cores diferentes).
function WallMath.splitBands(segments: { Segment }, split: number): ({ Segment }, { Segment })
	local lower: { Segment } = {}
	local upper: { Segment } = {}
	for _, s in segments do
		if s.y1 <= split + EPSILON then
			table.insert(lower, s)
		elseif s.y0 >= split - EPSILON then
			table.insert(upper, s)
		else
			table.insert(lower, { a = s.a, b = s.b, y0 = s.y0, y1 = split })
			table.insert(upper, { a = s.a, b = s.b, y0 = split, y1 = s.y1 })
		end
	end
	return lower, upper
end

-- Área total (útil para testes: sólido + aberturas = parede inteira).
function WallMath.area(segments: { Segment }): number
	local total = 0
	for _, s in segments do
		total += (s.b - s.a) * (s.y1 - s.y0)
	end
	return total
end

return WallMath
]]></string>
          </Properties>
        </Item>
      </Item>
