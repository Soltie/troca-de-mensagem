        <Item class="ModuleScript" referent="383">
          <Properties>
            <string name="Name">BatteryModel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Bateria da lanterna (pura, testada no Lune). O servidor simula uma por jogador e publica a
	carga no atributo do Player; o cliente só mostra (LEDs na lanterna) e pede para ligar/desligar.

	- Ligada: gasta DrainPerSecond. Ao zerar, desliga sozinha.
	- Desligada: a pilha "descansa" e recupera devagar até RechargeCap. Assim a missão nunca trava
	  por falta de luz: no pior caso, espere no escuro uns segundos.
	- Pilhas encontradas no mapa somam PickupAmount (até 100%).
]]

local Config = require("../Config")

export type State = {
	charge: number,
	on: boolean,
}

local B = Config.Battery

local BatteryModel = {}

BatteryModel.LEDS = 4

function BatteryModel.new(charge: number?): State
	return { charge = math.clamp(charge or B.StartCharge, 0, 1), on = false }
end

function BatteryModel.canTurnOn(state: State): boolean
	return state.charge >= B.MinToTurnOn
end

-- Pede ligar/desligar. Retorna o estado final (pode recusar ligar sem carga).
function BatteryModel.setOn(state: State, want: boolean): boolean
	if want and not BatteryModel.canTurnOn(state) then
		state.on = false
		return false
	end
	state.on = want
	return state.on
end

-- Avança `dt` segundos. Retorna true se a lanterna apagou sozinha agora (carga zerou).
-- `drainFactor` < 1 = pilha que dura mais (melhoria "Bateria de Lítio", Shared/Game/Perks).
function BatteryModel.step(state: State, dt: number, drainFactor: number?): boolean
	if dt <= 0 then
		return false
	end
	if state.on then
		local factor = math.clamp(drainFactor or 1, 0.1, 1)
		state.charge = math.max(0, state.charge - B.DrainPerSecond * factor * dt)
		if state.charge <= 0 then
			state.on = false
			return true
		end
	elseif state.charge < B.RechargeCap then
		state.charge = math.min(B.RechargeCap, state.charge + B.RechargePerSecond * dt)
	end
	return false
end

function BatteryModel.addPickup(state: State, amount: number?)
	state.charge = math.clamp(state.charge + (amount or B.PickupAmount), 0, 1)
end

-- Quantos LEDs acesos (0..4) para a carga.
function BatteryModel.leds(charge: number): number
	if charge <= 0 then
		return 0
	end
	return math.clamp(math.ceil(charge * BatteryModel.LEDS - 1e-6), 1, BatteryModel.LEDS)
end

function BatteryModel.isLow(charge: number): boolean
	return charge <= B.LowLevel
end

-- Fator de brilho da luz: cheio acima do nível baixo, cai até 35% perto do zero.
function BatteryModel.brightness(charge: number): number
	if charge >= B.LowLevel then
		return 1
	end
	return 0.35 + 0.65 * math.clamp(charge / B.LowLevel, 0, 1)
end

-- Segundos até a pilha descansada voltar a RechargeCap partindo de `charge` (desligada).
function BatteryModel.secondsToRecover(charge: number): number
	if charge >= B.RechargeCap then
		return 0
	end
	return (B.RechargeCap - charge) / B.RechargePerSecond
end

return BatteryModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="384">
          <Properties>
            <string name="Name">CampaignCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- Conteúdo da campanha; os pontos foram escolhidos fora dos corredores e dos objetivos legados.
local TableUtil = require("../Util/TableUtil")

export type Slot = { id: string, room: string, x: number, z: number }
export type Link = { id: string, a: string, b: string, x: number, z: number, axis: string, optional: boolean }

local Catalog = {
	RoomNames = {
		RelayHall = "SALA DE RELÉS",
		Cooling = "RESFRIAMENTO",
		BatteryBank = "BANCO DE BATERIAS",
		Radio = "COMUNICAÇÕES",
		MachineShop = "USINAGEM",
		Inspection = "INSPEÇÃO",
		CableDepot = "ALMOXARIFADO DE CABOS",
		Turbine = "TURBINA AUXILIAR",
		WaterTreatment = "TRATAMENTO DE ÁGUA",
		Lobby = "RECEPÇÃO",
		Office = "ESCRITÓRIO",
		Pump = "BOMBAS",
		Generator = "GERADOR",
		Storage = "DEPÓSITO",
		Maintenance = "OFICINA",
		CableGallery = "GALERIA",
		Control = "CONTROLE",
		Archive = "ARQUIVO",
		Switchyard = "PÁTIO TÉCNICO",
	},
	KindNames = { repair = "REPARO", sequence = "SEQUÊNCIA", relay = "RELÉ COOPERATIVO" },
	Stages = {
		{ id = "reconnect", title = "RECONEXÃO", kinds = { "repair", "sequence" }, threat = "watcher" },
		{ id = "synchronize", title = "SINCRONIZAÇÃO", kinds = { "relay", "sequence", "repair" }, threat = "echo" },
		{ id = "evacuate", title = "EVACUAÇÃO", kinds = { "relay", "repair", "sequence" }, threat = "blackout" },
	},
	Roles = {
		{ id = "technician", title = "MESTRE DAS FERRAMENTAS", description = "Conserta as máquinas mais rápido." },
		{ id = "medic", title = "SALVA-AMIGOS", description = "Levanta os amigos caídos mais rápido." },
		{ id = "scout", title = "OLHO DE ÁGUIA", description = "Sente os objetivos por perto (veja no guia H)." },
		{ id = "operator", title = "GUARDIÃO", description = "Segura os botões de dupla por mais tempo." },
	},
	Threats = {
		watcher = { title = "TUNG TUNG SAHUR", description = "Anda pela casa e corre atrás da luz." },
		echo = { title = "ECO", description = "Barulhos chamam o Tung Tung." },
		blackout = { title = "APAGÃO", description = "As luzes piscam e apagam de vez em quando." },
	},
	Slots = {
		{ id = "lobby", room = "Lobby", x = -4, z = -12 },
		{ id = "office", room = "Office", x = -25, z = -13 },
		{ id = "pump", room = "Pump", x = 30, z = -16 },
		{ id = "generator", room = "Generator", x = -10, z = -32 },
		{ id = "storage", room = "Storage", x = 24, z = -36.2 },
		{ id = "workshop_south", room = "Maintenance", x = -59, z = -10 },
		{ id = "workshop_north", room = "Maintenance", x = -59, z = -40 },
		{ id = "gallery", room = "CableGallery", x = -48, z = -71 },
		{ id = "control", room = "Control", x = -8, z = -68 },
		{ id = "archive", room = "Archive", x = 20, z = -69 },
		{ id = "yard_north", room = "Switchyard", x = 56, z = -54 },
		{ id = "yard_south", room = "Switchyard", x = 62, z = -18 },
	} :: { Slot },
	Links = {
		{ id = "entry", a = "Courtyard", b = "Lobby", x = -4, z = 0, axis = "X", optional = false },
		{ id = "lobby_office", a = "Lobby", b = "Office", x = -12, z = -9, axis = "Z", optional = false },
		{ id = "lobby_pump", a = "Lobby", b = "Pump", x = 4, z = -9, axis = "Z", optional = false },
		{ id = "lobby_corridor", a = "Lobby", b = "Corridor", x = -4, z = -18, axis = "X", optional = false },
		{ id = "office_corridor", a = "Office", b = "Corridor", x = -27, z = -18, axis = "X", optional = false },
		{ id = "pump_corridor", a = "Pump", b = "Corridor", x = 23, z = -18, axis = "X", optional = false },
		{ id = "generator_corridor", a = "Generator", b = "Corridor", x = -21, z = -26, axis = "X", optional = false },
		{ id = "storage_corridor", a = "Storage", b = "Corridor", x = 17, z = -26, axis = "X", optional = false },
		{ id = "workshop_entry", a = "Courtyard", b = "Maintenance", x = -54, z = 0, axis = "X", optional = false },
		{ id = "yard_entry", a = "Courtyard", b = "Switchyard", x = 56, z = 0, axis = "X", optional = false },
		{ id = "workshop_corridor", a = "Maintenance", b = "Corridor", x = -40, z = -22, axis = "Z", optional = false },
		{ id = "yard_corridor", a = "Switchyard", b = "Corridor", x = 40, z = -22, axis = "Z", optional = false },
		{
			id = "workshop_gallery",
			a = "Maintenance",
			b = "CableGallery",
			x = -54,
			z = -50,
			axis = "X",
			optional = false,
		},
		{ id = "gallery_control", a = "CableGallery", b = "Control", x = -40, z = -64, axis = "Z", optional = false },
		{ id = "control_archive", a = "Control", b = "Archive", x = 4, z = -64, axis = "Z", optional = false },
		{ id = "archive_yard", a = "Archive", b = "Switchyard", x = 40, z = -64, axis = "Z", optional = false },
		{ id = "office_workshop", a = "Office", b = "Maintenance", x = -40, z = -4, axis = "Z", optional = true },
		{ id = "pump_yard", a = "Pump", b = "Switchyard", x = 40, z = -8, axis = "Z", optional = true },
		{ id = "generator_control", a = "Generator", b = "Control", x = -32, z = -50, axis = "X", optional = true },
		{ id = "storage_archive", a = "Storage", b = "Archive", x = 24, z = -50, axis = "X", optional = true },
	} :: { Link },
}

local House = require("./HouseCatalog")
local roomNames: { [string]: string } = Catalog.RoomNames
for _, room in House.Rooms do
	roomNames[room.id] = room.title
end
return TableUtil.deepFreeze(Catalog)
]]></string>
