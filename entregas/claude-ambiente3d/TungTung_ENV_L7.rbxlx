        <Item class="ModuleScript" referent="397">
          <Properties>
            <string name="Name">HouseLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Contrato único dos pisos da escadaria: só o vão da escada que chega fica aberto.
local Layout = {}
export type Rect = { x0: number, x1: number, z0: number, z1: number }
Layout.Floors = { -16, 0, 16, 32 }
Layout.Bounds = { x0 = -24, x1 = 45, z0 = 12, z1 = 64 }
Layout.Stairs = {
	{ name = "BasementStairs", x = -16, z0 = 22, z1 = 54, y0 = -16, y1 = 0 },
	{ name = "MainStairs", x = 16, z0 = 22, z1 = 54, y0 = 0, y1 = 16 },
	{ name = "AtticStairs", x = 32, z0 = 54, z1 = 22, y0 = 16, y1 = 32 },
}
function Layout.opening(y: number): Rect?
	for _, stair in Layout.Stairs do
		if stair.y1 == y then
			return { x0 = stair.x - 6, x1 = stair.x + 6, z0 = 22, z1 = 54 }
		end
	end
	return nil
end
function Layout.decks(y: number): { Rect }
	local b, hole = Layout.Bounds, Layout.opening(y)
	if not hole then
		return { table.clone(b) }
	end
	return {
		{ x0 = b.x0, x1 = b.x1, z0 = b.z0, z1 = hole.z0 },
		{ x0 = b.x0, x1 = b.x1, z0 = hole.z1, z1 = b.z1 },
		{ x0 = b.x0, x1 = hole.x0, z0 = hole.z0, z1 = hole.z1 },
		{ x0 = hole.x1, x1 = b.x1, z0 = hole.z0, z1 = hole.z1 },
	}
end
return table.freeze(Layout)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="398">
          <Properties>
            <string name="Name">HousePreferences</string>
            <string name="Source"><![CDATA[--!strict
local Preferences = {}
Preferences.Keys = {
	"bob",
	"tilt",
	"shake",
	"fov",
	"flashes",
	"retro",
	"vhs",
	"haptics",
	"master",
	"music",
	"effects",
	"breathing",
	"ambient",
	"shaders",
	"quality",
}
-- Mantém o transporte numérico existente. Qualidade: 0 auto, 0.25 baixa, 0.5 média, 1 alta.
function Preferences.valid(key: string, value: any): boolean
	if type(value) ~= "number" or value ~= value or value < 0 or value > 1 then
		return false
	end
	if key == "quality" then
		return value == 0 or value == 0.25 or value == 0.5 or value == 1
	elseif key == "shaders" then
		return value == 0 or value == 1
	end
	return table.find(Preferences.Keys, key) ~= nil
end
function Preferences.sanitize(raw: any): { [string]: number }
	local out: { [string]: number } = {}
	if type(raw) ~= "table" then
		return out
	end
	for _, key in Preferences.Keys do
		local value = raw[key]
		if Preferences.valid(key, value) then
			out[key] = value
		end
	end
	return out
end
function Preferences.category(clip: string): string
	if string.sub(clip, 1, 5) == "Music" then
		return "music"
	end
	if string.sub(clip, 1, 6) == "Breath" or clip == "Gasp" then
		return "breathing"
	end
	if string.sub(clip, 1, 3) == "Amb" or clip == "WindInterior" or clip == "Machinery" then
		return "ambient"
	end
	return "effects"
end
return table.freeze(Preferences)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="399">
          <Properties>
            <string name="Name">HouseProgression</string>
            <string name="Source"><![CDATA[--!strict
-- Dependências públicas, sem códigos: História guiada; Desafio permite dividir tarefas entre colegas.
local Progress = {}
local groups: { { { number } } } = {
	{ {}, { 1 }, { 2 }, { 2 }, { 2 }, { 3, 4, 5 }, { 6 } },
	{ {}, {}, {}, { 1, 2, 3 }, { 4 }, { 5 }, { 6 } },
	{ {}, {}, {}, {}, { 1, 2, 3, 4 } },
	{ {}, { 1 }, {}, { 2, 3 }, { 4 }, { 5 } },
	{ {}, { 1 }, { 1 }, { 1 }, { 2, 3, 4 } },
}
function Progress.dependencies(mode: string?, chapter: number, index: number): { number }
	if mode == "Standard" and chapter <= 5 then
		return table.clone(groups[chapter][index])
	end
	return if index > 1 then { index - 1 } else {}
end
function Progress.ready(mode: string?, chapter: number, index: number, solved: (number) -> boolean): boolean
	for _, dependency in Progress.dependencies(mode, chapter, index) do
		if not solved(dependency) then
			return false
		end
	end
	return true
end
return table.freeze(Progress)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="400">
          <Properties>
            <string name="Name">InteractionPresentation</string>
            <string name="Source"><![CDATA[--!strict
local Rules = {}

function Rules.allowed(phase: string, status: string?): boolean
	return phase == "Playing" and (status == nil or status == "Active")
end

function Rules.prompt(prompt: string, alt: string?, locked: boolean, hasKey: boolean, campaign: boolean): string
	if locked and not campaign then
		return if hasKey then "[E] DESTRANCAR" else "[E] TRANCADA"
	end
	return `[E] {prompt}` .. (if alt and not campaign then `\n[Q] {alt}` else "")
end

function Rules.pickup(kind: string?): boolean
	return kind == "Fuse" or kind == "Key" or kind == "Battery" or kind == "Tape"
end

return table.freeze(Rules)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="401">
          <Properties>
            <string name="Name">LightingProfile</string>
            <string name="Source"><![CDATA[--!strict
-- Direção de luz/pós, sem APIs do engine: valores e orçamentos verificáveis no Lune.
local Config = require("../Config")
local Profile = {}
export type RGB = { number }
export type Grade = { tint: RGB, contrast: number, saturation: number, brightness: number }

-- Lua fria e pontos quentes: preserva as cores dos brinquedos sem iluminar todos os cantos.
Profile.World = {
	clock = 0.3,
	brightness = 1.05,
	ambient = { 19, 22, 32 },
	ambientPower = { 27, 28, 36 },
	-- Sob o telhado: preenchimento quente e baixo, para nenhum cômodo virar tela preta sem energia.
	ambientIndoor = { 44, 37, 34 },
	ambientIndoorPower = { 54, 46, 40 },
	outdoor = { 65, 74, 100 },
	fog = { 30, 36, 51 },
	fogPower = { 35, 40, 53 },
	fogStart = 24,
	fogEnd = 190,
	fogEndPower = 210,
	shadowSoftness = 0.3,
	diffuse = 0.14,
	specular = 0.22,
}
Profile.Bloom = { intensity = 0.1, size = 10, threshold = 1.9 }
Profile.Flashlight = { brightness = 2.7, spill = 0.11, angle = 40 }
Profile.Forest = {
	ambient = { 21, 28, 36 },
	outdoor = { 49, 63, 81 },
	fog = { 17, 25, 33 },
	fogStart = 14,
	fogScale = 0.62,
	exposure = -0.04,
}
Profile.ShadowBudget = 2 -- mais a lanterna própria; colegas nunca ganham sombras
Profile.ShadowDistance = 60
Profile.TransitionRate = 1.8

function Profile.grade(indoor: number, power: number): Grade
	local inside = math.clamp(indoor, 0, 1)
	local on = math.clamp(power, 0, 1)
	-- Cor local continua reconhecível; energia aquece só o interior.
	return {
		tint = { 240 + inside * on * 12, 246 + inside * on * 2, 255 - inside * on * 18 },
		contrast = 0.075 + inside * 0.025,
		saturation = -0.035 - inside * 0.025,
		brightness = 0.005,
	}
end

-- Ambiente final: noite fria lá fora, preenchimento quente dentro de casa, mata por cima de tudo.
function Profile.ambient(indoor: number, power: number, forest: number): RGB
	local inside = math.clamp(indoor, 0, 1)
	local on = math.clamp(power, 0, 1)
	local wild = math.clamp(forest, 0, 1)
	local out = {}
	for i = 1, 3 do
		local night = Profile.World.ambient[i] + (Profile.World.ambientPower[i] - Profile.World.ambient[i]) * on
		local house = Profile.World.ambientIndoor[i]
			+ (Profile.World.ambientIndoorPower[i] - Profile.World.ambientIndoor[i]) * on
		local base = night + (house - night) * inside
		out[i] = base + (Profile.Forest.ambient[i] - base) * wild
	end
	return out
end

function Profile.exposure(indoor: number, power: number): number
	return 0.08 + math.clamp(indoor, 0, 1) * (0.08 - 0.06 * math.clamp(power, 0, 1))
end

-- Luz decorativa não deve preencher salas vizinhas nem competir com a lanterna.
-- Nomes desconhecidos (pistas, moedas e efeitos de missão) conservam seus valores.
function Profile.fixture(name: string, brightness: number, range: number): (number, number)
	if name == "NightLight" then
		return brightness * 0.55, math.min(range, 18)
	elseif name == "Candle" then
		return brightness * 0.8, math.min(range, 22)
	elseif name == "LampShade" then
		return brightness, math.min(range, 14)
	end
	return brightness, range
end

function Profile.fogEnd(base: number, danger: number): number
	return base + (math.min(base, Config.Effects.DangerFogEnd) - base) * math.clamp(danger, 0, 1)
end

function Profile.approach(current: number, target: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-Profile.TransitionRate * math.max(0, dt)))
end

-- Falha rara, com identidade estável por luminária; sem ruído aleatório a cada quadro.
function Profile.flicker(now: number, seed: number, marked: boolean, flashes: boolean): number
	if not flashes then
		return 1
	end
	local phase = (now + seed * 0.371) % 7.3
	if marked and phase < 0.09 then
		return 0.48
	end
	return 0.98 + 0.02 * math.sin(now * 3.1 + seed)
end

function Profile.shadowBudget(quality: number): number
	-- 0 = automático. Não força a qualidade escolhida pelo jogador.
	return if quality > 0 and quality <= 3 then 0 else Profile.ShadowBudget
end

export type Candidate = { id: string, distance: number, range: number, enabled: boolean }
function Profile.selectShadows(candidates: { Candidate }, budget: number): { [string]: boolean }
	local near = {}
	for _, candidate in candidates do
		if candidate.enabled and candidate.distance <= math.min(Profile.ShadowDistance, candidate.range + 12) then
			table.insert(near, candidate)
		end
	end
	table.sort(near, function(a, b)
		if a.distance == b.distance then
			return a.id < b.id
		end
		return a.distance < b.distance
	end)
	local chosen = {}
	for i = 1, math.min(math.max(0, math.floor(budget)), #near) do
		chosen[near[i].id] = true
	end
	return chosen
end
return table.freeze(Profile)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="402">
          <Properties>
            <string name="Name">Perks</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Vantagens de jogo pagas (decisão do humano, 16/10/2026: monetização com vantagem).

	Melhorias permanentes (5 níveis cada), compradas com Fichas (jogando) ou Créditos (Robux):
	  bateria   a lanterna dura mais (gasto ÷ 1 + 15%/nível);
	  folego    mais corrida (fôlego e recarga × 1 + 15%/nível);
	  socorro   resgata colegas mais rápido (tempo × 1 - 10%/nível);
	  silencio  passos correndo fazem menos barulho para o Vigia (raio × 1 - 8%/nível).
	Consumíveis (estoque na conta):
	  segunda_chance  levanta sozinho 3 s depois de ser pego (co-op), se estiver no kit;
	  pilha_extra     pilha reserva da etapa: quando a lanterna apagar, entra sozinha (+60%), se no kit;
	  continuar       a equipe repete a etapa perdida em vez de voltar ao menu (botão na derrota).
	Bônus de tempo (produto Robux): Fichas ×2 e/ou XP ×2 nas recompensas de partida.

	Limites de projeto: nenhuma vantagem deixa o jogador invencível ou tira o Vigia do jogo, e o
	jogo continua ganhável sem pagar. Puro: o servidor aplica (StoreService, PerkService,
	PlayerStateService, CampaignRuntime, CreatureService); o cliente lê os atributos para exibir
	(e para o fôlego, que já é local).
]]

local Types = require("../Types")

type Data = Types.PlayerData

export type Currency = "fichas" | "creditos"
export type PerkId = "bateria" | "folego" | "socorro" | "silencio"
export type ConsumableId = "segunda_chance" | "pilha_extra" | "continuar"
export type BoostKind = "fichas" | "xp"

export type Perk = {
	id: PerkId,
	name: string,
	description: string,
	-- Efeito por nível (fração) e sentido: +1 aumenta, -1 reduz.
	step: number,
	sign: number,
	-- Preço de cada nível (índice = nível que será comprado).
	fichas: { number },
	creditos: { number },
}

export type Consumable = {
	id: ConsumableId,
	name: string,
	description: string,
	-- Quantas unidades cada compra entrega e o preço do pacote (nil = só por Robux).
	bundle: number,
	fichas: number?,
	creditos: number?,
	-- Pode ficar "no kit" (uso automático) ou é usado por botão.
	loadout: boolean,
}

local MAX_LEVEL = 5
local MAX_STOCK = 99

local Perks = {}

Perks.MAX_LEVEL = MAX_LEVEL
Perks.MAX_STOCK = MAX_STOCK
-- Segunda Chance: segundos caído antes de levantar sozinho.
Perks.SECOND_CHANCE_DELAY = 3
-- Pilha Extra: carga da pilha reserva (entra quando a lanterna apaga).
Perks.EXTRA_BATTERY = 0.6
Perks.BOOST_MULTIPLIER = 2

local PERK_LIST: { Perk } = {
	{
		id = "bateria",
		name = "BATERIA DE LÍTIO",
		description = "A lanterna dura mais.",
		step = 0.15,
		sign = 1,
		fichas = { 300, 600, 1000, 1600, 2500 },
		creditos = { 60, 120, 200, 320, 500 },
	},
	{
		id = "folego",
		name = "FÔLEGO DE MARATONA",
		description = "Corre por mais tempo e recupera mais rápido.",
		step = 0.15,
		sign = 1,
		fichas = { 300, 600, 1000, 1600, 2500 },
		creditos = { 60, 120, 200, 320, 500 },
	},
	{
		id = "socorro",
		name = "MÃOS DE SOCORRISTA",
		description = "Resgata colegas mais rápido.",
		step = 0.1,
		sign = -1,
		fichas = { 250, 500, 850, 1300, 2000 },
		creditos = { 50, 100, 170, 260, 400 },
	},
	{
		id = "silencio",
		name = "PASSOS LEVES",
		description = "Correr faz menos barulho para o Tung Tung.",
		step = 0.08,
		sign = -1,
		fichas = { 350, 700, 1150, 1800, 2800 },
		creditos = { 70, 140, 230, 360, 560 },
	},
}

local CONSUMABLE_LIST: { Consumable } = {
	{
		id = "segunda_chance",
		name = "SEGUNDA CHANCE",
		description = "Levanta sozinho 3 s depois de ser pego. Uma por etapa.",
		bundle = 1,
		fichas = 900,
		creditos = 60,
		loadout = true,
	},
	{
		id = "pilha_extra",
		name = "PILHA EXTRA",
		description = "Pilha reserva: quando a lanterna apagar, entra sozinha (+60%). Uma por etapa.",
		bundle = 3,
		fichas = 300,
		creditos = 30,
		loadout = true,
	},
	{
		id = "continuar",
		name = "CONTINUAÇÃO",
		description = "Depois de uma derrota, o time volta na hora, sem esperar a contagem.",
		bundle = 1,
		fichas = nil,
		creditos = 120,
		loadout = false,
	},
}

Perks.List = table.freeze(PERK_LIST)
Perks.Consumables = table.freeze(CONSUMABLE_LIST)
Perks.ById = {} :: { [string]: Perk }
Perks.ConsumableById = {} :: { [string]: Consumable }
for _, perk in PERK_LIST do
	Perks.ById[perk.id] = perk
end
for _, consumable in CONSUMABLE_LIST do
	Perks.ConsumableById[consumable.id] = consumable
end

-- ===================== Leitura (cliente e servidor) =====================

function Perks.level(data: Data, id: string): number
	local value = data.perks[id]
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, MAX_LEVEL)
end

-- Multiplicador do efeito no nível (ex.: bateria 5 -> 1.75; socorro 5 -> 0.5).
function Perks.factor(id: string, level: number): number
	local perk = Perks.ById[id]
	if not perk then
		return 1
	end
	local l = math.clamp(math.floor(level), 0, MAX_LEVEL)
	return 1 + perk.sign * perk.step * l
end

-- Preço do PRÓXIMO nível (nil = no máximo).
function Perks.nextCost(id: string, level: number, currency: Currency): number?
	local perk = Perks.ById[id]
	if not perk or level >= MAX_LEVEL then
		return nil
	end
	local list = if currency == "fichas" then perk.fichas else perk.creditos
	return list[level + 1]
end

function Perks.count(data: Data, id: string): number
	local value = data.consumables[id]
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, MAX_STOCK)
end

function Perks.inLoadout(data: Data, id: string): boolean
	return data.loadout[id] == true and Perks.count(data, id) > 0
end

function Perks.boostActive(data: Data, kind: BoostKind, now: number): boolean
	local untilTime = if kind == "fichas" then data.boosts.fichasUntil else data.boosts.xpUntil
	return type(untilTime) == "number" and untilTime > now
end

-- Multiplicadores de Fichas e XP das recompensas de partida.
function Perks.runMultipliers(data: Data, now: number): (number, number)
	return if Perks.boostActive(data, "fichas", now) then Perks.BOOST_MULTIPLIER else 1,
		if Perks.boostActive(data, "xp", now) then Perks.BOOST_MULTIPLIER else 1
end

-- ===================== Escrita (só servidor) =====================

function Perks.upgrade(data: Data, id: string, currency: Currency): (boolean, string?, number?)
	local perk = Perks.ById[id]
	if not perk then
		return false, "store_unknown", nil
	end
	local level = Perks.level(data, id)
	local price = Perks.nextCost(id, level, currency)
	if not price then
		return false, "perk_max", nil
	end
	if data.wallet[currency] < price then
		return false, "store_poor", nil
	end
	data.wallet[currency] -= price
	data.perks[id] = level + 1
	return true, nil, level + 1
end

-- Soma unidades ao estoque (compras e produtos Robux). Retorna quanto entrou de fato.
function Perks.add(data: Data, id: string, amount: number): number
	if not Perks.ConsumableById[id] or amount ~= amount or amount <= 0 then
		return 0
	end
	local before = Perks.count(data, id)
	local after = math.min(MAX_STOCK, before + math.floor(amount))
	data.consumables[id] = after
	return after - before
end

function Perks.buyConsumable(data: Data, id: string, currency: Currency): (boolean, string?)
	local consumable = Perks.ConsumableById[id]
	if not consumable then
		return false, "store_unknown"
	end
	local price = if currency == "fichas" then consumable.fichas else consumable.creditos
	if not price then
		return false, "store_no_price"
	end
	if Perks.count(data, id) + consumable.bundle > MAX_STOCK then
		return false, "perk_stock_full"
	end
	if data.wallet[currency] < price then
		return false, "store_poor"
	end
	data.wallet[currency] -= price
	Perks.add(data, id, consumable.bundle)
	return true, nil
end

-- Gasta uma unidade. false se não tem.
function Perks.consume(data: Data, id: string): boolean
	local count = Perks.count(data, id)
	if count <= 0 then
		return false
	end
	data.consumables[id] = count - 1
	return true
end

-- Liga/desliga o uso automático (só consumíveis de kit).
function Perks.setLoadout(data: Data, id: string, on: boolean): (boolean, string?)
	local consumable = Perks.ConsumableById[id]
	if not consumable or not consumable.loadout then
		return false, "store_unknown"
	end
	if on then
		data.loadout[id] = true
	else
		data.loadout[id] = nil
	end
	return true, nil
end

-- Bônus de tempo: soma minutos a partir de agora (ou do fim do bônus ainda ativo).
function Perks.addBoost(data: Data, kind: BoostKind, minutes: number, now: number)
	if minutes ~= minutes or minutes <= 0 then
		return
	end
	local field = if kind == "fichas" then "fichasUntil" else "xpUntil"
	local current = (data.boosts :: any)[field]
	local base = if type(current) == "number" and current > now then current else now;
	(data.boosts :: any)[field] = base + math.floor(minutes * 60)
end

return table.freeze(Perks)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="403">
          <Properties>
            <string name="Name">PixelText</string>
            <string name="Source"><![CDATA[--!strict
--[[
	A fonte pixel (Enum.Font.Arcade) só tem maiúsculas acentuadas para Ã e Ç; É, Í, Ó, Ú etc.
	saem como minúsculas (testado no Studio). Para textos em Arcade, trocamos essas letras pela
	versão sem acento — como muitos jogos de PS1 faziam. Puro: testável no Lune.
]]

local MAP: { [string]: string } = {
	["Á"] = "A",
	["À"] = "A",
	["Â"] = "A",
	["É"] = "E",
	["Ê"] = "E",
	["Í"] = "I",
	["Ó"] = "O",
	["Ô"] = "O",
	["Õ"] = "O",
	["Ú"] = "U",
	["Ü"] = "U",
}

local PixelText = {}

function PixelText.normalize(text: string): string
	-- Com tabela, caracteres fora do MAP ficam como estão.
	local out = string.gsub(text, utf8.charpattern, MAP)
	return out
end

return PixelText
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="404">
          <Properties>
            <string name="Name">PlayerGuide</string>
            <string name="Source"><![CDATA[--!strict
-- Apresentação pura: usa só o progresso publicado, nunca revela a solução das sequências.
-- Textos curtos e diretos, pensados para crianças lerem no meio da ação.
local Catalog = require("./CampaignCatalog")
local House = require("./HouseCatalog")

export type Activity = {
	id: string,
	room: string,
	kind: string,
	title: string?,
	solved: boolean,
	progress: number,
	available: boolean?,
	required: number?,
	relayUntil: number?,
	x: number?,
	z: number?,
}
local Guide = {}
function Guide.roomName(id: string): string
	for _, room in House.Rooms do
		if room.id == id then
			return room.title
		end
	end
	for _, room in require("./ForestCatalog").Rooms do
		if room.id == id then
			return room.title
		end
	end
	return Catalog.RoomNames[id] or id
end

function Guide.current(tasks: { Activity }): (Activity?, number)
	for index, activity in tasks do
		if not activity.solved and activity.available ~= false then
			return activity, index
		end
	end
	return nil, 0
end

function Guide.instruction(activity: Activity, now: number, activePlayers: number?): string
	if activity.kind == "collect" then
		return "Siga o marcador, encontre o objeto e aperte E para pegar. Vale para o time todo!"
	elseif activity.kind == "clue" then
		return "Chegue perto da pista e aperte E para ler. Ela ensina o próximo desafio."
	elseif activity.kind == "explore" then
		return "Siga a seta amarela até o ponto indicado."
	elseif activity.kind == "hide" then
		return "Entre no armário ou abrigo com E. Cabe só uma pessoa em cada esconderijo."
	elseif activity.kind == "breath" then
		return "No esconderijo, segure Espaço ou Z por 2 segundos. Solte antes de zerar o ar. E sai."
	elseif activity.kind == "puzzle" then
		return `Aperte E nos símbolos na ordem da pista: {activity.progress}/{activity.required or 4}. Errou? Os acertos ficam salvos.`
	elseif activity.kind == "activate" then
		return "Vá até o mecanismo brilhante e aperte E. O time já tem tudo o que precisa!"
	elseif activity.kind == "repair" then
		local actions = { "desligar", "trocar o fusível", "ligar de novo" }
		return `Aperte E no botão aceso {activity.progress + 1} ({actions[activity.progress + 1] or "pronto"}). Progresso: {activity.progress}/3.`
	elseif activity.kind == "sequence" then
		return `Olhe a ordem na placa e aperte E nos botões numerados. {activity.progress}/3 certos.`
	elseif activity.kind == "relay" then
		if activePlayers == 1 then
			return "Você é o último de pé: aperte E duas vezes no mesmo botão, rapidinho!"
		end
		local remaining = math.max(0, math.ceil((activity.relayUntil or 0) - now))
		if activity.progress > 0 and remaining > 0 then
			return `Chame um amigo! Ele precisa apertar E neste mesmo botão em {remaining}s.`
		end
		return "Trabalho em dupla: um aperta E e o amigo confirma no mesmo botão logo depois."
	end
	return "Chegue perto do objetivo brilhante e aperte E."
end

function Guide.objective(phase: string, status: string?, activity: Activity?): (string, string)
	if phase == "Briefing" then
		return "Prepare-se!", "A aventura começa em instantes. Fique junto do seu time."
	elseif phase == "Won" then
		return "Vocês escaparam!", "A equipe volta ao lobby após a cena final. Vocês podem escolher outra aventura."
	elseif phase == "Lost" then
		return "O Tung Tung pegou o time!",
			"Sem problema: vocês voltam no começo deste capítulo em instantes, de graça."
	elseif phase == "Intermission" then
		return "Capítulo concluído!", "Respire fundo. Amigos que caíram voltam no próximo capítulo."
	elseif status == "Downed" then
		return "Você caiu!", "Espere um amigo chegar perto e apertar E em você."
	elseif status == "Escaped" then
		return "Você está a salvo!", "Torça pelo seu time: a partida acaba quando todos escaparem."
	elseif status == "Waiting" then
		return "Você entra no próximo capítulo", "Use as setas para assistir aos amigos enquanto isso."
	elseif phase == "Extracting" then
		return "FUJA PARA O PORTÃO!", "O portão abriu! Ajude quem caiu e corra para a floresta."
	elseif activity then
		return activity.title or `Concluir {Catalog.KindNames[activity.kind] or "desafio"}`,
			`Vá até {Guide.roomName(activity.room)}.`
	end
	return "Preparando o próximo capítulo", "Só um instante..."
end

Guide.StageTips = {
	"Capítulo 1: pegue a lanterna, ache as três chaves e abra a biblioteca.",
	"Capítulo 2: religue a energia e aprenda a se esconder no armário.",
	"Capítulo 3: encontre as quatro lembranças. O livro mostra os símbolos.",
	"Capítulo 4: siga as pistas para abrir o cofre e recuperar o coração.",
	"Capítulo 5: use o artefato, ative o ritual e fuja antes do tempo acabar!",
}
table.insert(Guide.StageTips, "Capítulo 6: siga a trilha, pegue o mapa e se esconda das pancadas.")
table.insert(Guide.StageTips, "Capítulo 7: encontre o fusível, conserte o rádio e abra a trilha da torre.")
table.insert(Guide.StageTips, "Capítulo 8: ligue a torre, chame o resgate e corra para o farol verde!")
Guide.SurvivalTips = {
	"Ouviu TUM TUM TUM? Apague a lanterna (F) e se esconda!",
	"Shift corre, mas cansa e faz barulho. C agacha e deixa você mais silencioso.",
	"Amigo caiu? Chegue perto, mire nele e aperte E para ajudar.",
	"Moedas brilhantes valem Fichas! Pegue todas que encontrar.",
	"Portas abrem com E. Siga a seta amarela para não se perder.",
}

return table.freeze(Guide)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="405">
          <Properties>
            <string name="Name">Presentation</string>
            <string name="Source"><![CDATA[--!strict
-- Curvas puras: o mesmo ritmo em qualquer FPS e sem estender o relógio do servidor.
local Presentation = {}

function Presentation.ease(alpha: number): number
	local t = math.clamp(alpha, 0, 1)
	return t * t * (3 - 2 * t)
end

function Presentation.shade(elapsed: number, duration: number): number
	if duration <= 0 then
		return 0
	end
	local edge = math.min(0.38, duration / 3)
	return math.max(1 - Presentation.ease(elapsed / edge), 1 - Presentation.ease((duration - elapsed) / edge))
end

function Presentation.cut(alpha: number, duration: number, incoming: boolean, outgoing: boolean): number
	local edge = math.min(0.12, duration / 4)
	local time = math.clamp(alpha, 0, 1) * duration
	return math.max(
		if incoming then 1 - Presentation.ease(time / edge) else 0,
		if outgoing then 1 - Presentation.ease((duration - time) / edge) else 0
	)
end

return table.freeze(Presentation)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="406">
          <Properties>
            <string name="Name">Season</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Regras puras do passe de temporada (testadas no Lune). Dados em ./SeasonCatalog.
	Só o SERVIDOR chama as funções que alteram dados; o cliente usa as de leitura para exibir.

	`premium` = o jogador tem o Game Pass da temporada (o servidor confere com a Roblox).
	Entrega idempotente: cada nível de cada trilha é marcado em data.season.free/premium,
	então chamar grantReached de novo nunca dá a mesma recompensa duas vezes.
]]

local Economy = require("./Economy")
local SeasonCatalog = require("./SeasonCatalog")
local StoreCatalog = require("./StoreCatalog")
local Types = require("../Types")

type Data = Types.PlayerData
type SeasonDef = SeasonCatalog.SeasonDef
type Track = SeasonCatalog.Track

export type SeasonGranted = {
	-- XP de temporada somado agora.
	xp: number,
	-- Níveis alcançados agora (para o aviso).
	tiers: { number },
	-- O que cada trilha entregou (moedas e itens), separado para o analytics.
	free: Economy.Granted,
	premium: Economy.Granted,
}

local SECONDS_PER_DAY = 86400

local Season = {}

local function emptyGranted(): Economy.Granted
	return { fichas = 0, creditos = 0, xp = 0, items = {}, refunds = {}, levels = {} }
end

local function emptyResult(): SeasonGranted
	return { xp = 0, tiers = {}, free = emptyGranted(), premium = emptyGranted() }
end

-- ===================== Leitura =====================

-- Temporada ativa no instante `now` (os.time), ou nil entre temporadas.
function Season.current(now: number): SeasonDef?
	for _, season in SeasonCatalog.Seasons do
		if now >= season.startsAt and now < season.endsAt then
			return season
		end
	end
	return nil
end

-- Dias inteiros que faltam (arredondado para cima; 0 quando acabou).
function Season.daysLeft(season: SeasonDef, now: number): number
	return math.max(0, math.ceil((season.endsAt - now) / SECONDS_PER_DAY))
end

function Season.maxTier(season: SeasonDef): number
	return #season.tiers
end

-- Nível alcançado (começa no 1, com 0 XP), XP dentro do nível e XP do nível.
-- No último nível a barra fica cheia (into = need).
function Season.tierInfo(season: SeasonDef, xp: number): (number, number, number)
	local need = season.xpPerTier
	local tier = math.floor(math.max(0, xp) / need) + 1
	if tier >= #season.tiers then
		return #season.tiers, need, need
	end
	return tier, math.max(0, xp) - (tier - 1) * need, need
end

function Season.reward(season: SeasonDef, tier: number, track: Track): StoreCatalog.Reward?
	local entry = season.tiers[tier]
	if not entry then
		return nil
	end
	return if track == "free" then entry.free else entry.premium
end

-- XP de temporada da partida (mesmo resumo da recompensa da conta).
function Season.runXp(summary: Economy.RunSummary): number
	local X = SeasonCatalog.XpSources
	local xp = X.participation + X.perStage * summary.stages + X.perFuse * summary.fuses
	if summary.breakers then
		xp += X.breakers
	end
	if summary.won or summary.escaped then
		xp += X.escaped
	end
	return xp + X.perContribution * math.clamp(summary.contributions, 0, X.contributionCap)
end

-- XP de temporada que o jogador tem NESTA temporada (dados de outra temporada valem 0).
function Season.xpOf(data: Data, season: SeasonDef): number
	return if data.season.id == season.id then data.season.xp else 0
end

function Season.isGranted(data: Data, season: SeasonDef, tier: number, track: Track): boolean
	if data.season.id ~= season.id then
		return false
	end
	local marks = if track == "free" then data.season.free else data.season.premium
	return marks[tostring(tier)] == true
end

-- ===================== Escrita (só servidor) =====================

-- Passa os dados para a temporada `season`; outra temporada zera XP e entregas. true = zerou.
function Season.sync(data: Data, season: SeasonDef): boolean
	if data.season.id == season.id then
		return false
	end
	data.season = { id = season.id, xp = 0, free = {}, premium = {} }
	return true
end

-- Entrega toda recompensa de nível alcançado que ainda não foi entregue (paga só com `premium`).
function Season.grantReached(data: Data, season: SeasonDef, premium: boolean, into: SeasonGranted?): SeasonGranted
	local result = into or emptyResult()
	Season.sync(data, season)
	local reached = Season.tierInfo(season, data.season.xp)
	for tier = 1, reached do
		local key = tostring(tier)
		local entry = season.tiers[tier]
		if not data.season.free[key] then
			data.season.free[key] = true
			if entry.free then
				Economy.applyReward(data, entry.free, result.free)
			end
		end
		if premium and not data.season.premium[key] then
			data.season.premium[key] = true
			if entry.premium then
				Economy.applyReward(data, entry.premium, result.premium)
			end
		end
	end
	return result
end

-- Soma XP de temporada e entrega o que os níveis novos liberarem.
function Season.addXp(data: Data, season: SeasonDef, amount: number, premium: boolean): SeasonGranted
	Season.sync(data, season)
	local result = emptyResult()
	local before = Season.tierInfo(season, data.season.xp)
	if amount > 0 then
		data.season.xp += math.floor(amount)
		result.xp = math.floor(amount)
	end
	local after = Season.tierInfo(season, data.season.xp)
	for tier = before + 1, after do
		table.insert(result.tiers, tier)
	end
	return Season.grantReached(data, season, premium, result)
end

-- Algo foi entregue? (para decidir se vale avisar o cliente)
function Season.hasRewards(result: SeasonGranted): boolean
	for _, granted in { result.free, result.premium } do
		if granted.fichas > 0 or granted.creditos > 0 or #granted.items > 0 then
			return true
		end
	end
	return false
end

return Season
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="407">
          <Properties>
            <string name="Name">SeasonCatalog</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Passe de temporada "Turno Extra" (dados puros, compartilhados; testados no Lune).
	Regras em ./Season; política e valores em docs/MONETIZATION.md.

	- Cada temporada tem 30 níveis com duas trilhas: GRÁTIS (todos) e PAGA (Game Pass próprio da
	  temporada, `passKey` em StoreCatalog.Products). Os cosméticos ficam em StoreCatalog.Items com
	  source = "season" (só saem das trilhas: nem loja nem baú).
	- XP de temporada é separado do XP da conta: vem das partidas, das fitas e do diário (XpSources).
	  Pagar não acelera o XP; a trilha paga só libera recompensas (nada compra vantagem no jogo).
	- Recompensas são entregues sozinhas ao alcançar o nível. Quem compra a trilha paga no meio da
	  temporada recebe na hora as recompensas pagas dos níveis já alcançados.
	- Datas em os.time (UTC). O "dia" do jogo vira à meia-noite de Brasília (UTC-3).
	  Nova temporada = nova entrada em Seasons (id novo), itens novos e um Game Pass novo.
]]

local StoreCatalog = require("./StoreCatalog")

type Reward = StoreCatalog.Reward

export type Track = "free" | "premium"

export type Tier = {
	free: Reward?,
	premium: Reward?,
}

export type SeasonDef = {
	id: string,
	number: number,
	name: string,
	tagline: string,
	-- Início (inclusive) e fim (exclusive), em os.time UTC.
	startsAt: number,
	endsAt: number,
	-- Chave do Game Pass da trilha paga em StoreCatalog.Products.
	passKey: string,
	-- XP de temporada para subir cada nível (constante: o progresso é fácil de ler).
	xpPerTier: number,
	tiers: { Tier },
}

local SeasonCatalog = {}

SeasonCatalog.TRACKS = { "free", "premium" } :: { Track }

-- XP de temporada por fonte (sem multiplicador VIP: o passe vale igual para todos).
SeasonCatalog.XpSources = {
	participation = 40,
	perStage = 30,
	perFuse = 10,
	breakers = 20,
	escaped = 60,
	perContribution = 4,
	contributionCap = 15,
	tape = 50,
	daily = 40,
}

SeasonCatalog.Seasons = {
	{
		id = "s1",
		number = 1,
		name = "NOITE EXTRA",
		tagline = "A casa do Tung Tung guarda novos segredos. Cada partida conta!",
		-- 15/10/2026 00:00 a 01/12/2026 00:00 (horário de Brasília).
		startsAt = 1792033200,
		endsAt = 1796094000,
		passKey = "turno_extra_s1",
		xpPerTier = 400,
		tiers = {
			{ free = { fichas = 100 }, premium = { item = "farda_hora_extra" } },
			{ free = { fichas = 50 }, premium = { fichas = 100 } },
			{ free = { fichas = 50 }, premium = { creditos = 30 } },
			{ free = { fichas = 75 }, premium = { fichas = 150 } },
			{ free = { item = "titulo_hora_extra" }, premium = { item = "lanterna_ponto" } },
			{ free = { fichas = 75 }, premium = { fichas = 150 } },
			{ free = { fichas = 75 }, premium = { creditos = 30 } },
			{ free = { fichas = 100 }, premium = { fichas = 200 } },
			{ free = { fichas = 100 }, premium = { fichas = 200 } },
			{ free = { item = "lanterna_plantao" }, premium = { item = "filtro_ponto" } },
			{ free = { fichas = 100 }, premium = { creditos = 30 } },
			{ free = { fichas = 100 }, premium = { fichas = 250 } },
			{ free = { fichas = 125 }, premium = { fichas = 250 } },
			{ free = { fichas = 125 }, premium = { creditos = 30 } },
			{ free = { creditos = 15 }, premium = { item = "titulo_insone" } },
			{ free = { fichas = 125 }, premium = { fichas = 300 } },
			{ free = { fichas = 150 }, premium = { fichas = 300 } },
			{ free = { fichas = 150 }, premium = { creditos = 30 } },
			{ free = { fichas = 150 }, premium = { fichas = 300 } },
			{ free = { item = "filtro_madrugada" }, premium = { item = "farda_madrugada" } },
			{ free = { fichas = 150 }, premium = { fichas = 350 } },
			{ free = { fichas = 175 }, premium = { creditos = 30 } },
			{ free = { fichas = 175 }, premium = { fichas = 350 } },
			{ free = { fichas = 175 }, premium = { fichas = 350 } },
			{ free = { creditos = 25 }, premium = { item = "lanterna_tres" } },
			{ free = { fichas = 200 }, premium = { creditos = 30 } },
			{ free = { fichas = 200 }, premium = { fichas = 400 } },
			{ free = { fichas = 200 }, premium = { fichas = 400 } },
			{ free = { fichas = 250 }, premium = { fichas = 500 } },
			{ free = { item = "titulo_turno_extra" }, premium = { item = "titulo_dono_madrugada", creditos = 90 } },
		},
	},
} :: { SeasonDef }

SeasonCatalog.SeasonById = {} :: { [string]: SeasonDef }
for _, season in SeasonCatalog.Seasons do
	SeasonCatalog.SeasonById[season.id] = season
end

return SeasonCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="408">
          <Properties>
            <string name="Name">ServerList</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lista de servidores do menu (puro). Cada servidor publica um registro curto no MemoryStore
	(LobbyService); aqui ficam o formato, a validação do que vem de fora e a ordem de exibição.

	Ordem: servidores no lobby com vaga primeiro (dá para escolher o modo junto), depois partidas em
	andamento com vaga (a pessoa entra como espera e joga a próxima etapa), por mais jogadores.
]]

export type Entry = {
	job: string,
	players: number,
	max: number,
	-- "Story" | "Standard" | "" (ainda votando)
	mode: string,
	-- Fase da campanha (Lobby, Playing, Intermission, Extracting, Won, Lost)
	phase: string,
	stage: number,
	updated: number,
}

local ServerList = {}

-- Registros mais velhos que isso são servidores que caíram sem se apagar.
ServerList.TTL = 90
ServerList.REFRESH = 20
ServerList.MAX_ROWS = 20

-- JobId da Roblox (GUID, 36 caracteres).
function ServerList.validJob(job: unknown): boolean
	return type(job) == "string" and #job == 36 and string.match(job, "^[%x%-]+$") ~= nil
end

local PHASES = { Lobby = true, Playing = true, Intermission = true, Extracting = true, Won = true, Lost = true }

-- Valida um registro vindo do MemoryStore (nunca confie no formato).
function ServerList.decode(raw: unknown, job: string): Entry?
	if type(raw) ~= "table" or not ServerList.validJob(job) then
		return nil
	end
	local r = raw :: { [string]: any }
	local players, max, stage, updated = r.players, r.max, r.stage, r.updated
	if type(players) ~= "number" or type(max) ~= "number" or type(updated) ~= "number" then
		return nil
	end
	if players ~= players or max ~= max or players < 0 or max < 1 or max > 50 then
		return nil
	end
	local phase = if type(r.phase) == "string" and PHASES[r.phase] then r.phase else "Lobby"
	local mode = if r.mode == "Story" or r.mode == "Standard" then r.mode else ""
	return {
		job = job,
		players = math.floor(math.min(players, max)),
		max = math.floor(max),
		mode = mode,
		phase = phase,
		stage = if type(stage) == "number" and stage == stage then math.clamp(math.floor(stage), 0, 9) else 0,
		updated = updated,
	}
end

function ServerList.alive(entry: Entry, now: number): boolean
	return now - entry.updated <= ServerList.TTL
end

-- Dá para entrar? (vivo, com vaga, não é o próprio servidor, partida não terminando)
function ServerList.joinable(entry: Entry, selfJob: string, now: number): (boolean, string?)
	if entry.job == selfJob then
		return false, "server_self"
	end
	if not ServerList.alive(entry, now) then
		return false, "server_gone"
	end
	if entry.players >= entry.max then
		return false, "server_full"
	end
	return true, nil
end

local function rank(entry: Entry): number
	if entry.phase == "Lobby" then
		return 0
	elseif entry.phase == "Won" or entry.phase == "Lost" then
		return 2
	end
	return 1
end

-- Só servidores vivos; o próprio fica de fora. Lobby com vaga primeiro, depois mais cheios.
function ServerList.sorted(entries: { Entry }, selfJob: string, now: number): { Entry }
	local list: { Entry } = {}
	for _, entry in entries do
		if entry.job ~= selfJob and ServerList.alive(entry, now) then
			table.insert(list, entry)
		end
	end
	table.sort(list, function(a, b)
		local fullA, fullB = a.players >= a.max, b.players >= b.max
		if fullA ~= fullB then
			return not fullA
		end
		local ra, rb = rank(a), rank(b)
		if ra ~= rb then
			return ra < rb
		end
		if a.players ~= b.players then
			return a.players > b.players
		end
		return a.job < b.job
	end)
	while #list > ServerList.MAX_ROWS do
		table.remove(list)
	end
	return list
end

return table.freeze(ServerList)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="409">
          <Properties>
            <string name="Name">SpectatorRules</string>
            <string name="Source"><![CDATA[--!strict
-- Só membros fora de jogo acompanham colegas. Derrubados mantêm a visão do próprio resgate.
local Rules = {}

function Rules.allowed(phase: string, status: string?): boolean
	return (phase == "Playing" or phase == "Extracting") and (status == "Waiting" or status == "Escaped")
end

-- IDs ordenados tornam troca/desconexão determinísticas, incluindo IDs negativos do Studio.
function Rules.choose(ids: { number }, current: number?, direction: number): number?
	if #ids == 0 then
		return nil
	end
	local sorted = table.clone(ids)
	table.sort(sorted)
	local index = if current then table.find(sorted, current) else nil
	if not index then
		return sorted[1]
	end
	return sorted[((index - 1 + direction) % #sorted) + 1]
end

return table.freeze(Rules)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="410">
          <Properties>
            <string name="Name">StoreCatalog</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Catálogo da loja e da progressão (dados puros, compartilhados; testados no Lune).
	O servidor é a única autoridade: o cliente só usa estes dados para MOSTRAR preços, chances e
	recompensas. Política de monetização: docs/MONETIZATION.md.

	Princípios:
	- Só cosméticos e conveniência de coleção: nada compra vantagem contra o Vigia (jogo cooperativo).
	- Fichas = moeda ganha jogando (nunca vendida). Créditos = moeda comprada com Robux.
	- Baú pago com Créditos é "item aleatório pago": chances em % antes da compra (somam 100%),
	  bloqueado para quem a PolicyService restringe (alternativa: compra direta de cada item).
	- Cores ficam como {r, g, b} (0..255): este módulo roda também no Lune, sem Color3.
]]

export type Currency = "fichas" | "creditos"
export type Rarity = "common" | "rare" | "epic" | "legendary" | "exclusive"
export type ItemKind = "flashlight" | "uniform" | "filter" | "title"
-- De onde o item vem: padrão (todos têm), loja/baús, nível, coleção de fitas, VIP, Pacote Inicial,
-- passe de temporada (trilhas em SeasonCatalog), capítulos do modo história (StoryRewards) ou o
-- passe da história (Arquivo do Elias).
export type Source =
	"default"
	| "store"
	| "level"
	| "tapes"
	| "vip"
	| "starter"
	| "escape"
	| "season"
	| "story"
	| "storypass"
export type RGB = { number }

export type Item = {
	id: string,
	kind: ItemKind,
	name: string,
	rarity: Rarity,
	source: Source,
	-- Compra direta (opcional por moeda).
	fichas: number?,
	creditos: number?,
	-- Aparência (por tipo).
	body: RGB?,
	head: RGB?,
	beam: RGB?,
	material: string?,
	shirt: RGB?,
	pants: RGB?,
	helmet: RGB?,
	stripe: RGB?,
	cap: boolean?,
	tint: RGB?,
	saturation: number?,
	contrast: number?,
	brightness: number?,
	color: RGB?,
}

export type Chest = {
	id: string,
	name: string,
	currency: Currency,
	price: number,
	-- Chance por raridade, em pontos percentuais (somam 100).
	odds: { [Rarity]: number },
	-- true = comprado (direta ou indiretamente) com Robux: regras de itens aleatórios pagos.
	paidRandom: boolean,
}

export type Reward = {
	fichas: number?,
	creditos: number?,
	xp: number?,
	item: string?,
	-- Consumíveis (Shared/Game/Perks) -> unidades.
	consumables: { [string]: number }?,
	-- Bônus de tempo em minutos (Fichas ×2 e/ou XP ×2); só produtos (precisa do relógio).
	boost: { fichas: number?, xp: number? }?,
}

export type SpinSegment = { id: string, label: string, weight: number, reward: Reward }

export type Product = {
	key: string,
	kind: "product" | "pass",
	name: string,
	description: string,
	-- ID do Developer Product / Game Pass no Creator Hub. 0 = ainda não criado
	-- (no Studio a compra é simulada; no servidor ao vivo o item fica indisponível).
	id: number,
	-- Preço sugerido em Robux (informativo; o preço real é o do Creator Hub).
	robux: number,
	grant: Reward,
	-- Só pode ser comprado uma vez por conta (registrado nos dados).
	once: boolean?,
}

export type Tape = { id: string, title: string, line: string }

local StoreCatalog = {}

local CURRENCIES: { Currency } = { "fichas", "creditos" }
local KINDS: { ItemKind } = { "flashlight", "uniform", "filter", "title" }
StoreCatalog.CURRENCIES = CURRENCIES
StoreCatalog.KINDS = KINDS

StoreCatalog.Rarities = {
	common = { label = "COMUM", color = { 160, 160, 150 }, refund = 50, order = 1 },
	rare = { label = "RARO", color = { 70, 140, 230 }, refund = 120, order = 2 },
	epic = { label = "ÉPICO", color = { 170, 80, 230 }, refund = 300, order = 3 },
	legendary = { label = "LENDÁRIO", color = { 240, 180, 50 }, refund = 800, order = 4 },
	exclusive = { label = "EXCLUSIVO", color = { 230, 70, 60 }, refund = 0, order = 5 },
}

-- Item padrão de cada tipo (todos possuem; equipado na conta nova).
StoreCatalog.Defaults = {
	flashlight = "lanterna_padrao",
	uniform = "farda_padrao",
	filter = "filtro_padrao",
	title = "titulo_estagiario",
}

function StoreCatalog.defaultFor(kind: ItemKind): string
	return (StoreCatalog.Defaults :: any)[kind]
end

local function item(def: Item): Item
	return def
end

StoreCatalog.Items = {
	-- ===== Lanternas (só o dono vê, na mão) =====
