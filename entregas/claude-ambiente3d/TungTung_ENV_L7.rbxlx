        <Item class="ModuleScript" referent="411">
          <Properties>
            <string name="Name">StoreView</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Apresentação da loja (puro, testado no Lune): só LÊ os catálogos para explicar cada item na UI.
	Nada aqui decide posse, preço ou concessão — isso é do StoreService.

	  state       equipado / adquirido / à venda / bloqueado (a partir dos atributos publicados)
	  howToGet    como conseguir o item, com o número real (nível, fitas, capítulo, nível do passe)
	  kindNote    quem vê / onde aparece o cosmético
	  prices      opções de compra direta e quanto falta de cada moeda
]]

local SeasonCatalog = require("./SeasonCatalog")
local StoreCatalog = require("./StoreCatalog")
local StoryRewards = require("./StoryRewards")

type Item = StoreCatalog.Item

export type ItemState = "equipped" | "owned" | "buyable" | "locked"
export type PriceOption = {
	currency: StoreCatalog.Currency,
	price: number,
	affordable: boolean,
	missing: number,
}

local StoreView = {}

local KIND_NOTES: { [StoreCatalog.ItemKind]: string } = {
	flashlight = "LANTERNA · SÓ VOCÊ VÊ, NA SUA MÃO.",
	uniform = "FARDA · SEUS COLEGAS VEEM NO SEU PERSONAGEM.",
	filter = "FILTRO · MUDA AS CORES DA SUA TELA.",
	title = "TÍTULO · APARECE AO LADO DO SEU NOME.",
}

function StoreView.kindNote(kind: StoreCatalog.ItemKind): string
	return KIND_NOTES[kind] or ""
end

function StoreView.isOwned(item: Item, owned: { [string]: boolean }, vip: boolean): boolean
	if item.source == "default" then
		return true
	end
	if item.source == "vip" then
		return vip
	end
	return owned[item.id] == true
end

function StoreView.state(item: Item, owned: { [string]: boolean }, equippedId: string, vip: boolean): ItemState
	if StoreView.isOwned(item, owned, vip) then
		return if equippedId == item.id then "equipped" else "owned"
	end
	if item.source == "store" and (item.fichas ~= nil or item.creditos ~= nil) then
		return "buyable"
	end
	return "locked"
end

local function levelOf(itemId: string): number?
	for level, reward in StoreCatalog.LevelMilestones do
		if reward.item == itemId then
			return level
		end
	end
	return nil
end

local function tapesFor(itemId: string): number?
	for amount, reward in StoreCatalog.TapeMilestones do
		if reward.item == itemId then
			return amount
		end
	end
	return nil
end

local function seasonTier(itemId: string): (number?, string?)
	for _, season in SeasonCatalog.Seasons do
		for index, tier in season.tiers do
			if tier.free and tier.free.item == itemId then
				return index, "GRÁTIS"
			end
			if tier.premium and tier.premium.item == itemId then
				return index, "PREMIUM"
			end
		end
	end
	return nil, nil
end

local function storyChapter(itemId: string): number?
	for chapter, def in StoryRewards.Chapters do
		if def.first.item == itemId then
			return chapter
		end
	end
	return nil
end

-- Texto curto e verdadeiro sobre como conseguir o item (usa os catálogos reais).
function StoreView.howToGet(item: Item): string
	local source = item.source
	if source == "default" then
		return "ITEM PADRÃO: TODO MUNDO JÁ TEM."
	elseif source == "store" then
		return "COMPRE AQUI NA LOJA OU GANHE NOS BAÚS."
	elseif source == "level" then
		local level = levelOf(item.id)
		return if level then `RECOMPENSA AO CHEGAR NO NÍVEL {level}.` else "RECOMPENSA DE NÍVEL."
	elseif source == "tapes" then
		local amount = tapesFor(item.id)
		return if amount then `JUNTE {amount} FITAS VHS ESCONDIDAS NA CASA.` else "COLEÇÃO DE FITAS VHS."
	elseif source == "vip" then
		return "EXCLUSIVO DE QUEM TEM O VIP."
	elseif source == "starter" then
		return "VEM NO PACOTE INICIAL."
	elseif source == "escape" then
		return "FUJA DA CASA PELA PRIMEIRA VEZ."
	elseif source == "season" then
		local tier, track = seasonTier(item.id)
		return if tier then `PASSE DA TEMPORADA · NÍVEL {tier} ({track}).` else "PASSE DA TEMPORADA."
	elseif source == "story" then
		if item.id == StoryRewards.CompletionItem then
			return `VENÇA OS {#StoryRewards.Chapters} CAPÍTULOS DO MODO HISTÓRIA.`
		end
		local chapter = storyChapter(item.id)
		return if chapter then `VENÇA O CAPÍTULO {chapter} DO MODO HISTÓRIA.` else "MODO HISTÓRIA."
	elseif source == "storypass" then
		return "VEM NO PASSE DA HISTÓRIA (ARQUIVO DO ELIAS)."
	end
	return ""
end

-- Opções de compra direta (só itens da loja), em ordem Fichas → Créditos.
function StoreView.prices(item: Item, fichas: number, creditos: number): { PriceOption }
	local options: { PriceOption } = {}
	if item.source ~= "store" then
		return options
	end
	if item.fichas then
		table.insert(options, {
			currency = "fichas",
			price = item.fichas,
			affordable = fichas >= item.fichas,
			missing = math.max(0, item.fichas - fichas),
		})
	end
	if item.creditos then
		table.insert(options, {
			currency = "creditos",
			price = item.creditos,
			affordable = creditos >= item.creditos,
			missing = math.max(0, item.creditos - creditos),
		})
	end
	return options
end

-- Aplica um filtro (brilho, contraste, saturação e tinta, como o ColorCorrection) numa cor 0..255.
-- Usado na prévia dos filtros: a cena é desenhada já com as cores corrigidas.
function StoreView.grade(color: StoreCatalog.RGB, filter: Item): StoreCatalog.RGB
	local brightness = filter.brightness or 0
	local contrast = filter.contrast or 0
	local saturation = filter.saturation or 0
	local tint = filter.tint or { 255, 255, 255 }
	local channels = {}
	for index = 1, 3 do
		local value = color[index] / 255 + brightness
		channels[index] = (value - 0.5) * (1 + contrast) + 0.5
	end
	local luminance = channels[1] * 0.299 + channels[2] * 0.587 + channels[3] * 0.114
	local out = {}
	for index = 1, 3 do
		local value = luminance + (channels[index] - luminance) * (1 + saturation)
		value *= tint[index] / 255
		out[index] = math.floor(math.clamp(value, 0, 1) * 255 + 0.5)
	end
	return out
end

-- Roleta: cada fatia ocupa um ângulo PROPORCIONAL ao peso (o que a criança vê = a chance real).
-- Retorna { start, finish, percent } em graus, começando no topo (0°) e girando no sentido horário.
function StoreView.spinArcs(segments: { StoreCatalog.SpinSegment }): { { number } }
	local total = 0
	for _, segment in segments do
		total += segment.weight
	end
	local arcs = {}
	local angle = 0
	for _, segment in segments do
		local size = if total > 0 then segment.weight / total * 360 else 0
		table.insert(arcs, { angle, angle + size, if total > 0 then segment.weight / total * 100 else 0 })
		angle += size
	end
	return arcs
end

-- Rotação final da roda para o ponteiro (no topo) parar dentro da fatia `index`.
-- `fraction` (0..1) escolhe o ponto da fatia, longe das bordas; `turns` voltas completas antes.
function StoreView.spinRotation(arcs: { { number } }, index: number, fraction: number, turns: number): number
	local arc = arcs[index]
	if not arc then
		return 0
	end
	local inside = arc[1] + (arc[2] - arc[1]) * (0.15 + 0.7 * math.clamp(fraction, 0, 1))
	return turns * 360 + (360 - inside)
end

-- Itens de um tipo em ordem de raridade e nome (mesma ordem da loja antiga).
function StoreView.itemsOfKind(kind: StoreCatalog.ItemKind): { Item }
	local list = {}
	for _, entry in StoreCatalog.Items do
		if entry.kind == kind then
			table.insert(list, entry)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = StoreCatalog.Rarities[a.rarity].order, StoreCatalog.Rarities[b.rarity].order
		return if ra == rb then a.name < b.name else ra < rb
	end)
	return list
end

return StoreView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="412">
          <Properties>
            <string name="Name">StoryCatalog</string>
            <string name="Source"><![CDATA[--!strict
local House = require("./HouseCatalog")
local TableUtil = require("../Util/TableUtil")
local Shots = require("./CinematicShots")
export type Chapter = House.Chapter
local Broadcast = require("./HouseBroadcast")
local function point(x: number, y: number, z: number): Shots.Vec
	return { x = x, y = y, z = z }
end
local function beat(label: string, a: Shots.Vec, b: Shots.Vec, look: Shots.Vec): Shots.Shot
	return {
		label = label,
		from = a,
		to = b,
		lookFrom = look,
		lookTo = look,
		duration = 4,
		fov = 54,
		ease = "inOut",
		handheld = 0.08,
		cut = "hard",
	}
end
local frames = {
	{
		beat("A PORTA SE FECHOU", point(0, 6, 9), point(0, 6, 3), point(0, 5, -28)),
		beat("A FITA", point(-29, 6, -9), point(-31, 5.5, -11), point(-35.5, 5.3, -15.7)),
	},
	{
		beat("CANAL 03 / O CHAMADO", point(-29, 6, -9), point(-31, 5.5, -11), point(-35.5, 5.3, -15.7)),
		beat("NINGUÉM RESPONDE", point(0, 6, -27), point(0, 6, -33), point(0, 6, -70)),
	},
	{
		beat("SÓTÃO / 03:12", point(0, 38, 7), point(0, 37, 0), point(0, 37, -35)),
		beat("AS LEMBRANÇAS", point(-20, 38, -25), point(-22, 37, -29), point(-34, 36, -39)),
	},
	{
		beat("SOB A CASA", point(0, -10, -8), point(0, -10, -17), point(0, -11, -46)),
		beat("O QUE FOI LEVADO", point(-20, -10, -26), point(-22, -10, -29), point(-31, -12, -39)),
	},
	{
		beat("O CORAÇÃO", point(-20, -10, -58), point(-22, -10, -61), point(-26, -13, -68)),
		beat("A ÚLTIMA SAÍDA", point(0, -10, -42), point(0, -10, -36), point(0, -11, 0)),
	},
}
local scenes: { Shots.Sequence } = {}
for index, label in { "A CASA FICOU PARA TRÁS", "UMA VOZ NO CHIADO", "O ÚLTIMO SINAL" } do
	table.insert(frames, {
		beat(label, point(0, 12, 586), point(0, 10, 610), point(0, 7, 700)),
		beat(
			if index == 3 then "ANTES DO AMANHECER" else "NÃO SIGAM AS VOZES",
			point(-55, 9, 725),
			point(-45, 8, 740),
			point(if index == 3 then 82 else 38, if index == 3 then 40 else 5, 760)
		),
	})
end
for index, chapter in House.Chapters do
	table.insert(scenes, {
		name = `StoryHouse{index}`,
		shots = frames[index],
		captions = Broadcast[index],
		title = string.format("CAPÍTULO %02d", index),
		subtitle = string.match(chapter.title, "·%s*(.+)") or chapter.subtitle,
	})
end
return TableUtil.deepFreeze({
	Title = "TUNG TUNG SAHUR: THE CURSED HOUSE",
	MapSeed = 90312,
	SceneSeconds = 8,
	Chapters = House.Chapters,
	Scenes = scenes,
	SceneLines = Broadcast,
	Ending = "Vocês fugiram da casa e da floresta.\nTung Tung Sahur e Crocodilo Armadilho estão procurando vocês.\nPRÓXIMO JOGO: A MANSÃO DO ARMADILHO.",
})
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="413">
          <Properties>
            <string name="Name">StoryRewards</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Recompensas do modo história (O Último Turno). Puro: o RewardService aplica no fim de cada capítulo.

	Por capítulo:
	  first     1ª vitória da conta (grande; capítulos 2 e 3 trazem cosmético exclusivo);
	  again     repetições (menor, mantém o modo valendo a pena);
	  flawless  1ª vitória sem ninguém da equipe ser pego (Créditos + consumível).
	Os 3 capítulos vencidos dão o título "O Último Turno". O passe Arquivo do Elias dobra Fichas, XP e
	Créditos dos capítulos (itens e consumíveis não dobram).
]]

local Economy = require("./Economy")
local StoreCatalog = require("./StoreCatalog")
local Types = require("../Types")

type Data = Types.PlayerData
type Reward = StoreCatalog.Reward

export type ChapterReward = { first: Reward, again: Reward, flawless: Reward }
export type Outcome = { first: boolean, flawless: boolean, completed: boolean }

local StoryRewards = {}

StoryRewards.Chapters = table.freeze({
	{
		first = { fichas = 400, creditos = 20, xp = 300 },
		again = { fichas = 120, xp = 120 },
		flawless = { creditos = 30, consumables = { pilha_extra = 2 } },
	},
	{
		first = { fichas = 550, creditos = 30, xp = 400, item = "farda_ronda" },
		again = { fichas = 150, xp = 150 },
		flawless = { creditos = 40, consumables = { segunda_chance = 1 } },
	},
	{
		first = { fichas = 800, creditos = 50, xp = 600, item = "lanterna_elias" },
		again = { fichas = 200, xp = 200 },
		flawless = { creditos = 60, consumables = { continuar = 1 } },
	},
	{ first = { fichas = 450, xp = 350 }, again = { fichas = 100, xp = 100 }, flawless = { creditos = 20 } },
	{ first = { fichas = 600, xp = 450 }, again = { fichas = 150, xp = 150 }, flawless = { creditos = 30 } },
	{ first = { fichas = 350, xp = 250 }, again = { fichas = 100, xp = 100 }, flawless = { creditos = 20 } },
	{ first = { fichas = 450, xp = 350 }, again = { fichas = 100, xp = 100 }, flawless = { creditos = 20 } },
	{ first = { fichas = 600, xp = 450 }, again = { fichas = 150, xp = 150 }, flawless = { creditos = 30 } },
} :: { ChapterReward })

StoryRewards.CompletionItem = "titulo_ultimo_turno"
StoryRewards.PassMultiplier = 2

local function scaled(reward: Reward, multiplier: number): Reward
	local copy = table.clone(reward)
	if copy.fichas then
		copy.fichas = math.floor(copy.fichas * multiplier + 0.5)
	end
	if copy.xp then
		copy.xp = math.floor(copy.xp * multiplier + 0.5)
	end
	if copy.creditos then
		copy.creditos = math.floor(copy.creditos * multiplier + 0.5)
	end
	return copy
end

function StoryRewards.cleared(data: Data, chapter: number): boolean
	return data.house.cleared[tostring(chapter)] ~= nil
end

-- Quantos capítulos a conta já venceu (para o menu).
function StoryRewards.clearedCount(data: Data): number
	local count = 0
	for chapter = 1, #StoryRewards.Chapters do
		if StoryRewards.cleared(data, chapter) then
			count += 1
		end
	end
	return count
end

-- O que a próxima vitória deste capítulo vale (para o menu): "first" ou "again".
function StoryRewards.preview(data: Data, chapter: number, hasPass: boolean?): (string, Reward?)
	local def = StoryRewards.Chapters[chapter]
	if not def then
		return "none", nil
	end
	local multiplier = if hasPass then StoryRewards.PassMultiplier else 1
	if StoryRewards.cleared(data, chapter) then
		return "again", scaled(def.again, multiplier)
	end
	return "first", scaled(def.first, multiplier)
end

--[[
	Capítulo vencido. `flawless` = ninguém da equipe foi pego no capítulo.
	Retorna (concedido, desfecho) ou (nil, nil) para capítulo inexistente.
]]
function StoryRewards.award(
	data: Data,
	chapter: number,
	flawless: boolean,
	hasPass: boolean?,
	now: number
): (Economy.Granted?, Outcome?)
	local def = StoryRewards.Chapters[chapter]
	if not def then
		return nil, nil
	end
	local key = tostring(chapter)
	local multiplier = if hasPass then StoryRewards.PassMultiplier else 1
	local first = data.house.cleared[key] == nil
	local granted = Economy.applyReward(data, scaled(if first then def.first else def.again, multiplier))
	if first then
		data.house.cleared[key] = now
	end
	local firstFlawless = flawless and data.house.flawless[key] == nil
	if firstFlawless then
		data.house.flawless[key] = now
		Economy.applyReward(data, scaled(def.flawless, multiplier), granted)
	end
	local completed = false
	if StoryRewards.clearedCount(data) >= #StoryRewards.Chapters and not data.owned[StoryRewards.CompletionItem] then
		Economy.applyReward(data, { item = StoryRewards.CompletionItem }, granted)
		completed = true
	end
	return granted, { first = first, flawless = firstFlawless, completed = completed }
end

return table.freeze(StoryRewards)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="414">
          <Properties>
            <string name="Name">SurfacePatterns</string>
            <string name="Source"><![CDATA[--!strict
-- Máscaras autorais repetíveis de desgaste. Pixels RGBA locais; nenhuma imagem externa ou upload.
local Patterns = {}
Patterns.Size = 32
Patterns.Kinds = { "paint", "concrete", "rust", "wood", "tiles" }

local function noise(x: number, y: number, seed: number): number
	return ((x * 137 + y * 269 + seed * 53) * (x * 17 + y * 31 + 7)) % 251
end

function Patterns.pixels(kind: string, seed: number): buffer
	assert(table.find(Patterns.Kinds, kind), "unknown surface pattern")
	local size = Patterns.Size
	local pixels = buffer.create(size * size * 4)
	for y = 0, size - 1 do
		for x = 0, size - 1 do
			local fine = noise(x, y, seed)
			local coarse = noise(math.floor(x / 4), math.floor(y / 4), seed + 11)
			local r, g, b, alpha = 28, 30, 25, 0
			if kind == "paint" then
				-- Ilhas de tinta descascada e pequenos poros; sem borda artificial no tile.
				if coarse < 26 and fine < 160 then
					r, g, b, alpha = 139, 133, 113, 45 + fine % 35
				elseif fine < 40 then
					alpha = 90
				end
			elseif kind == "concrete" then
				local tone = 65 + fine % 65
				r, g, b, alpha = tone, tone, tone - 5, 20 + coarse % 65
				if (x + math.floor(y / 4)) % 29 == 0 then
					r, g, b, alpha = 23, 25, 23, 115
				end
			elseif kind == "rust" then
				r, g, b = 95 + fine % 42, 48 + fine % 20, 24
				alpha = if coarse < 100 then 70 + fine % 90 else 8
				if x % 13 == 0 and fine < 130 then
					r, g, b, alpha = 185, 176, 145, 90
				end
			elseif kind == "wood" then
				r, g, b = 31, 20, 12
				alpha = if (y + math.floor(x / 8)) % 7 == 0 then 110 else fine % 24
			elseif kind == "tiles" then
				r, g, b, alpha = 24, 26, 22, if x % 16 == 0 or y % 16 == 0 then 160 else fine % 36
			end
			local offset = (y * size + x) * 4
			buffer.writeu8(pixels, offset, r)
			buffer.writeu8(pixels, offset + 1, g)
			buffer.writeu8(pixels, offset + 2, b)
			buffer.writeu8(pixels, offset + 3, alpha)
		end
	end
	return pixels
end

return table.freeze(Patterns)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="415">
          <Properties>
            <string name="Name">Tags</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nomes de tags (CollectionService) e atributos usados entre servidor e cliente.
	Centralizados aqui para nenhum dos lados digitar strings soltas.
]]

local Tags = {
	-- Peça "foco" de algo interagível (fusível, quadro, porta, portão, bilhete).
	Interactable = "Interactable",
	-- Luz controlada pela energia / efeitos (PointLight ou SpotLight dentro da peça).
	PowerLight = "PowerLight",

	Attr = {
		-- Interagíveis
		InteractId = "InteractId",
		InteractPrompt = "InteractPrompt",
		InteractDistance = "InteractDistance",
		InteractEnabled = "InteractEnabled",
		-- Luzes: "Lamp" | "Emergency" | "Flood" | "Beacon" | "Street" | "Exit"
		LightKind = "LightKind",
		-- true = o cliente faz a luz piscar em passos.
		Flicker = "Flicker",
		-- Jogador: lanterna ligada (o servidor grava a partir do remote SetFlashlight).
		Flashlight = "Flashlight",
		-- Criatura (na peça Root): modo atual do cérebro e se está ativa.
		CreatureMode = "Mode",
		CreatureActive = "Active",
		ThreatTargetUserId = "ThreatTargetUserId",
	},

	-- Nomes de instâncias criadas pelo servidor no Workspace.
	WorldFolder = "CursedHouse",
	CreatureModel = "Vigia",
	CreatureRoot = "Root",
}

return table.freeze(Tags)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="416">
          <Properties>
            <string name="Name">TaskRewards</string>
            <string name="Source"><![CDATA[--!strict
-- Recompensa fixa e pública: a equipe avança junta; cada colaborador recebe o mesmo bônus.
local TaskRewards = {}
export type Reward = { fichas: number, xp: number }
export type Ledger = { [string]: { [number]: boolean } }

function TaskRewards.reward(contributed: boolean): Reward
	return { fichas = if contributed then 20 else 12, xp = if contributed then 40 else 24 }
end

-- O adaptador não pode ceder execução. Falha de perfil não consome o direito ao pagamento.
-- A chave identifica campanha/etapa/estação e permanece igual ao usar Continuação.
function TaskRewards.claim(ledger: Ledger, key: string, id: number, grant: () -> boolean): boolean
	local paid = ledger[key] or {}
	ledger[key] = paid
	if paid[id] then
		return false
	end
	paid[id] = true
	if not grant() then
		paid[id] = nil
		return false
	end
	return true
end

return table.freeze(TaskRewards)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="417">
          <Properties>
            <string name="Name">TensionDirector</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Diretor de tensão (puro, testado no Lune). Decide QUANDO acontece um evento de clima e QUAL;
	o TensionController (cliente) executa. Todos os eventos são de apresentação local: nenhum
	muda a simulação do servidor (o Vigia de verdade é sempre autoritativo no servidor).

	Estados explícitos:
	  Anticipation  Vigia longe ou dormindo: avisos sutis, espaçados.
	  Tension       Vigia perto, investigando ou medo alto: avisos mais frequentes.
	  Chase         perseguição: o diretor não solta nada (a perseguição já é o susto).
	  Recovery      calmaria depois da perseguição: nada por RecoveryTime segundos.

	Regras: um evento por vez (busyUntil), intervalo mínimo por estado, recarga por evento,
	filtros por sala, medo e progresso da missão. Cada decisão vai para `log` (debug).
]]

local Config = require("../Config")

export type DirectorState = "Anticipation" | "Tension" | "Chase" | "Recovery"

-- Um de ORDER ("flicker", "distant_steps", "radio_static", "vibrate", "whisper", "false_alarm",
-- "silhouette", "door_twitch", "object_shift", "eyes").
export type EventName = string

export type Context = {
	now: number,
	playing: boolean,
	creatureActive: boolean,
	creatureMode: string,
	creatureDistance: number,
	fear: number,
	darkness: number,
	-- Id da sala (Layout.Rooms) ou "Outside".
	zone: string,
	-- Fusíveis coletados + 1 se a energia voltou (0..4).
	progress: number,
	hidden: boolean,
}

export type Decision = {
	state: DirectorState,
	changed: boolean,
	event: EventName?,
	-- O evento pede silêncio antes (o controller abafa o som por SilenceBefore).
	silence: boolean,
}

export type EventSpec = {
	cooldown: number,
	weight: number,
	duration: number,
	states: { [string]: boolean },
	minFear: number?,
	minProgress: number?,
	requiresActive: boolean?,
	maxDistance: number?,
	requiresDark: boolean?,
	silence: boolean?,
	zones: { [string]: boolean }?,
}

export type Director = {
	state: DirectorState,
	stateSince: number,
	lastEventAt: number,
	busyUntil: number,
	cooldowns: { [string]: number },
	log: { string },
	random: () -> number,
}

local T = Config.Tension
local LOG_SIZE = 40

local BOTH = { Anticipation = true, Tension = true }
local CALM = { Anticipation = true }

-- Salas com corredores longos/escuros (Layout.Rooms; inclui as da ampliação do mapa).
local LONG_VIEWS = {
	Corridor = true,
	Storage = true,
	Generator = true,
	Pump = true,
	Outside = true,
	CableGallery = true,
	Archive = true,
	Maintenance = true,
	Switchyard = true,
}
local HAS_DOORS = {
	Corridor = true,
	Office = true,
	Generator = true,
	Storage = true,
	Lobby = true,
}

local EVENTS: { [string]: EventSpec } = {
	-- Lâmpadas instáveis (aviso clássico de que algo vem).
	flicker = { cooldown = 22, weight = 3, duration = 1.4, states = BOTH },
	-- Passos pesados longe, atrás de paredes.
	distant_steps = { cooldown = 34, weight = 2, duration = 3, states = BOTH },
	-- Chiado de rádio (o rádio do vigia).
	radio_static = { cooldown = 45, weight = 2, duration = 2.6, states = BOTH },
	-- Objetos vibrando: só com o Vigia realmente perto.
	vibrate = {
		cooldown = 28,
		weight = 3,
		duration = 1.6,
		states = { Tension = true },
		requiresActive = true,
		maxDistance = 30,
	},
	whisper = { cooldown = 55, weight = 1, duration = 4, states = BOTH, minFear = 0.3 },
	-- Alarme falso: silêncio, rosnado distante, luz falha... e nada.
	false_alarm = {
		cooldown = 85,
		weight = 1,
		duration = 3,
		states = CALM,
		minProgress = 1,
		silence = true,
	},
	-- Alucinações (nunca afetam o jogo de verdade).
	silhouette = {
		cooldown = 75,
		weight = 1,
		duration = 1.6,
		states = BOTH,
		minFear = 0.4,
		minProgress = 1,
		silence = true,
		zones = LONG_VIEWS,
	},
	door_twitch = { cooldown = 60, weight = 1, duration = 1.2, states = BOTH, minFear = 0.25, zones = HAS_DOORS },
	object_shift = { cooldown = 70, weight = 1, duration = 1.2, states = CALM, minFear = 0.2 },
	eyes = {
		cooldown = 95,
		weight = 1,
		duration = 2.2,
		states = BOTH,
		minFear = 0.35,
		minProgress = 1,
		requiresDark = true,
		silence = true,
		zones = LONG_VIEWS,
	},
}

-- Ordem fixa (sorteio determinístico com o mesmo gerador).
local ORDER: { string } = {
	"flicker",
	"distant_steps",
	"radio_static",
	"vibrate",
	"whisper",
	"false_alarm",
	"silhouette",
	"door_twitch",
	"object_shift",
	"eyes",
}

local TensionDirector = {}

TensionDirector.EVENTS = EVENTS
TensionDirector.ORDER = ORDER

function TensionDirector.new(random: (() -> number)?, now: number?): Director
	return {
		state = "Anticipation" :: DirectorState,
		stateSince = now or 0,
		lastEventAt = now or 0,
		busyUntil = 0,
		cooldowns = {},
		log = {},
		random = random or function()
			return math.random()
		end,
	}
end

local function record(d: Director, now: number, text: string)
	table.insert(d.log, string.format("%7.1f %s", now, text))
	if #d.log > LOG_SIZE then
		table.remove(d.log, 1)
	end
end

local function desiredState(d: Director, ctx: Context): DirectorState
	if ctx.creatureMode == "Chase" or ctx.creatureMode == "Capture" then
		return "Chase"
	end
	if d.state == "Chase" then
		return "Recovery"
	end
	if d.state == "Recovery" and ctx.now - d.stateSince < T.RecoveryTime then
		return "Recovery"
	end
	if
		ctx.creatureActive
		and (
			ctx.creatureDistance <= T.TensionRange
			or ctx.creatureMode == "Investigate"
			or ctx.creatureMode == "Search"
		)
	then
		return "Tension"
	end
	if ctx.fear >= 0.5 then
		return "Tension"
	end
	return "Anticipation"
end

-- O evento pode acontecer agora, neste contexto?
function TensionDirector.eligible(d: Director, name: EventName, ctx: Context): boolean
	local spec = EVENTS[name]
	if not spec.states[d.state] then
		return false
	end
	if ctx.now < (d.cooldowns[name] or -math.huge) then
		return false
	end
	if spec.minFear and ctx.fear < spec.minFear then
		return false
	end
	if spec.minProgress and ctx.progress < spec.minProgress then
		return false
	end
	if spec.requiresActive and not ctx.creatureActive then
		return false
	end
	if spec.maxDistance and ctx.creatureDistance > spec.maxDistance then
		return false
	end
	if spec.requiresDark and ctx.darkness < 0.6 then
		return false
	end
	if spec.zones and not spec.zones[ctx.zone] then
		return false
	end
	return true
end

-- Intervalo mínimo entre eventos no estado atual (diminui um pouco com o progresso).
function TensionDirector.gap(d: Director, progress: number): number
	local base = if d.state == "Tension" then T.GapTension else T.GapAnticipation
	return base / (1 + math.max(progress, 0) * 0.15)
end

function TensionDirector.step(d: Director, ctx: Context, dt: number): Decision
	local nextState: DirectorState = desiredState(d, ctx)
	local changed = false
	if nextState ~= d.state then
		record(d, ctx.now, `state {d.state} -> {nextState}`)
		d.state = nextState :: DirectorState
		d.stateSince = ctx.now
		changed = true
	end
	local decision: Decision = { state = d.state, changed = changed, event = nil, silence = false }

	if not ctx.playing or ctx.hidden or d.state == "Chase" or d.state == "Recovery" then
		return decision
	end
	if ctx.now < d.busyUntil or ctx.now - d.lastEventAt < TensionDirector.gap(d, ctx.progress) then
		return decision
	end
	local rate = T.ChancePerSecond * (1 + ctx.progress * 0.2)
	if d.random() >= 1 - math.exp(-rate * math.max(dt, 0)) then
		return decision
	end

	local total = 0
	local pool: { EventName } = {}
	for _, name in ORDER do
		if TensionDirector.eligible(d, name, ctx) then
			table.insert(pool, name)
			total += EVENTS[name].weight
		end
	end
	if total <= 0 then
		return decision
	end
	local roll = d.random() * total
	local chosen = pool[#pool]
	for _, name in pool do
		roll -= EVENTS[name].weight
		if roll < 0 then
			chosen = name
			break
		end
	end

	local spec = EVENTS[chosen]
	local silence = spec.silence == true
	d.lastEventAt = ctx.now
	d.cooldowns[chosen] = ctx.now + spec.cooldown
	d.busyUntil = ctx.now + spec.duration + (if silence then T.SilenceBefore else 0)
	record(
		d,
		ctx.now,
		string.format(
			"event %s (%s, zone %s, fear %.2f, progress %d)",
			chosen,
			d.state,
			ctx.zone,
			ctx.fear,
			ctx.progress
		)
	)
	decision.event = chosen
	decision.silence = silence
	return decision
end

-- Registra algo que aconteceu fora do diretor (ex.: despertar, captura) e segura sustos por `hold` s.
function TensionDirector.notify(d: Director, now: number, text: string, hold: number?)
	record(d, now, text)
	if hold then
		d.busyUntil = math.max(d.busyUntil, now + hold)
	end
end

function TensionDirector.reset(d: Director, now: number)
	d.state = "Anticipation" :: DirectorState
	d.stateSince = now
	d.lastEventAt = now
	d.busyUntil = 0
	table.clear(d.cooldowns)
	record(d, now, "reset")
end

return TensionDirector
]]></string>
          </Properties>
        </Item>
