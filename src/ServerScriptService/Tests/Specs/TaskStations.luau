--!strict
local TestKit = require("../TestKit")
return {
	name = "TaskStations",
	robloxOnly = true,
	run = function(t)
		local Builder = require("@game/ServerScriptService/Server/Campaign/ActivityBuilder")
		local Session = require("@game/ServerScriptService/Server/Campaign/CoopSession")
		local Config = require("@game/ReplicatedStorage/Shared/Config")
		local Tags = require("@game/ReplicatedStorage/Shared/Game/Tags")
		local function fixture(mode: string, stage: number, run: (any, any) -> ())
			local root = Instance.new("Folder")
			local state = Session.new(90312, Config.Campaign, mode)
			Session.join(state, 1)
			Session.join(state, 2)
			state.stage = stage - 1
			Session.beginStage(state)
			local ok, reason = pcall(function()
				local built = Builder.build(root, state.plan :: any, 9)
				run(built, state)
			end)
			root:Destroy()
			assert(ok, tostring(reason))
		end
		t.it("builds distinct repair components and updates the next action after technician assistance", function()
			fixture("Standard", 1, function(built, state)
				local id = (state.plan :: any).activities[1].id
				t.expect(built.targets[`{id}_3`] ~= nil).toBe(true)
				Session.act(state, 1, id, 1, 0)
				Builder.refresh(built, state.tasks, 0, 2)
				t.expect(string.find(built.labels[id].Text, "TESTAR ENERGIA", 1, true) ~= nil).toBe(true)
				t.expect(built.targets[`{id}_3`].focus:GetAttribute(Tags.Attr.InteractPrompt)).toBe("TESTAR ENERGIA")
				Session.act(state, 2, id, 3, 1)
				Builder.refresh(built, state.tasks, 1, 2)
				t.expect(built.targets[`{id}_3`].focus:GetAttribute(Tags.Attr.InteractEnabled)).toBe(false)
			end)
		end)
		t.it("shows relay countdown, expiry, and a clear fallback for the last survivor", function()
			fixture("Standard", 2, function(built, state)
				local id = (state.plan :: any).activities[1].id
				Session.act(state, 1, id, 1, 0)
				Builder.refresh(built, state.tasks, 1, 2)
				t.expect(string.find(built.labels[id].Text, "COLEGA:", 1, true) ~= nil).toBe(true)
				Session.tick(state, 50)
				Builder.refresh(built, state.tasks, 50, 1)
				t.expect(string.find(built.labels[id].Text, "ULTIMO ATIVO", 1, true) ~= nil).toBe(true)
				t.expect(built.targets[`{id}_1`].focus:GetAttribute(Tags.Attr.InteractPrompt))
					.toBe("ARMAR RELE SOZINHO")
			end)
		end)
		t.it("keeps future story stations locked and preserves sequence progress after mistakes", function()
			fixture("Story", 1, function(built, state)
				Builder.refresh(built, state.tasks, 0, 2)
				t.expect(built.targets.task_2_1.focus:GetAttribute(Tags.Attr.InteractEnabled)).toBe(false)
				Session.act(state, 1, "task_1", 1, 0)
				Session.act(state, 1, "task_1", 3, 1)
				Builder.refresh(built, state.tasks, 1, 2)
				t.expect(built.targets.task_2_1.focus:GetAttribute(Tags.Attr.InteractEnabled)).toBe(true)
				local order = state.tasks.task_2.spec.order
				Session.act(state, 2, "task_2", order[1], 2)
				Session.act(state, 2, "task_2", order[1], 3)
				Builder.refresh(built, state.tasks, 3, 2)
				t.expect(state.tasks.task_2.progress).toBe(1)
			end)
		end)
	end,
} :: TestKit.Spec
